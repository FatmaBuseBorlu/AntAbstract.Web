@using AntAbstract.Application.DTOs.Review
@model List<ReviewAssignmentDto>
@* Şimdilik model boş gelebilir, null check yapacağız *@

@{
    ViewData["Title"] = "Sertifikalarım";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-certificate text-success me-2"></i> Sertifika Arşivi</h5>
            <span class="badge bg-success bg-opacity-10 text-success">Toplam: 3 Adet</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="py-3 px-4 text-muted small fw-bold">Bildiri Başlığı</th>
                        <th class="py-3 text-muted small fw-bold">Kongre</th>
                        <th class="py-3 text-muted small fw-bold">Tamamlanma Tarihi</th>
                        <th class="py-3 px-4 text-end text-muted small fw-bold">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="px-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3 text-primary"><i class="fas fa-file-alt"></i></div>
                                <div>
                                    <span class="d-block fw-bold text-dark">Yapay Zeka Etiği Üzerine Analiz</span>
                                    <small class="text-muted">#REF-00000025</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary bg-opacity-10 text-secondary border">AI Summit 2025</span></td>
                        <td>12 Ocak 2026</td>
                        <td class="text-end px-4">
                            <a href="#" class="btn btn-outline-success btn-sm rounded-pill fw-bold shadow-sm">
                                <i class="fas fa-download me-1"></i> İndir
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="px-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3 text-primary"><i class="fas fa-file-alt"></i></div>
                                <div>
                                    <span class="d-block fw-bold text-dark">Blokzincir ve Lojistik Yönetimi</span>
                                    <small class="text-muted">#REF-00000018</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-secondary bg-opacity-10 text-secondary border">Tech Istanbul</span></td>
                        <td>05 Aralık 2025</td>
                        <td class="text-end px-4">
                            <a href="#" class="btn btn-outline-success btn-sm rounded-pill fw-bold shadow-sm">
                                <i class="fas fa-download me-1"></i> İndir
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

@using AntAbstract.Web.Models.ViewModels.Admin.Reports
@model ReportsIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">
    <h3 class="fw-bold mb-4">@Model.ConferenceName - @Localizer["GeneralReportSuffix"]</h3>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card bg-success text-white border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75">@Localizer["TotalRevenueTitle"]</h6>
                    <h2 class="fw-bold">@Model.TotalRevenue.ToString("C")</h2>
                    <small>@Model.TotalRegistrations @Localizer["RegisteredParticipantsText"]</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-primary text-white border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75">@Localizer["TotalSubmissionsTitle"]</h6>
                    <h2 class="fw-bold">@Model.TotalSubmissions</h2>
                    <small>@Localizer["AllUploadedAbstractsText"]</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75">@Localizer["AcceptedTitle"]</h6>
                    <h2 class="fw-bold">@Model.AcceptedSubmissions</h2>
                    <small>@Localizer["IncludedInProgramText"]</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-dark border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-uppercase opacity-75">@Localizer["UnderReviewTitle"]</h6>
                    <h2 class="fw-bold">@Model.PendingSubmissions</h2>
                    <small>@Localizer["WaitingReviewerOrDecisionText"]</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold">@Localizer["SubmissionStatusDistributionTitle"]</div>
                <div class="card-body">
                    <canvas id="submissionChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labelAccepted = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelAccepted"].Value));
    const labelRejected = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelRejected"].Value));
    const labelPending = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelPending"].Value));

    document.addEventListener("DOMContentLoaded", function() {
        var ctx = document.getElementById('submissionChart').getContext('2d');
        var myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: [labelAccepted, labelRejected, labelPending],
                datasets: [{
                    data: [@Model.AcceptedSubmissions, @Model.RejectedSubmissions, @Model.PendingSubmissions],
                    backgroundColor: ['#198754', '#dc3545', '#ffc107'],
                    borderWidth: 1
                }]
            },
            options: { responsive: true }
        });
    });
</script>
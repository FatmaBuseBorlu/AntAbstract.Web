        font-weight: 950;
        white-space: nowrap;
    }

    .attendance-status-badge.waiting {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .attendance-status-badge.completed {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
    }

    .attendance-certificate-btn {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: 999px;
        padding: 0 0.95rem;
        background: linear-gradient(135deg, #16a34a, #00aeef);
        color: #ffffff;
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 950;
        box-shadow: 0 10px 24px rgba(22, 163, 74, 0.20);
    }

    .attendance-certificate-btn:hover {

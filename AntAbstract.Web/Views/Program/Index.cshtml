        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
    }

    .program-conference-pill {

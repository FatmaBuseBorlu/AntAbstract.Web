        max-width: 360px;
        flex: 1;
    }

    .attendance-progress-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.5rem;
        color: #334155;
        font-size: 0.8rem;
        font-weight: 900;
    }

    .attendance-progress {
        height: 12px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .attendance-progress-bar {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        background: linear-gradient(135deg, #22c55e, #00aeef);
        transition: width 0.3s ease;
    }

    .attendance-status-badge {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 1.2rem 1.35rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.05);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
    }

    .attendance-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 280px;
        flex: 1;
    }

    .attendance-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        border-radius: 18px;
        background: rgba(34, 197, 94, 0.12);
        color: #16a34a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .attendance-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .attendance-text {

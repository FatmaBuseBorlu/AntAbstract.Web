    }

    .program-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .program-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .program-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.10);
        color: #00aeef;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .program-stat-value {
        color: #0f172a;
        font-size: 1.3rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .program-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
    }

    .program-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .program-tab-btn {
        min-height: 44px;
        border-radius: 999px;
        border: 1px solid #dbe4ef;
        background: #ffffff;
        color: #64748b;
        padding: 0 1rem;
        font-weight: 900;
        transition: all 0.2s ease;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    }

    .program-tab-btn:hover {
        color: #0d6efd;
        transform: translateY(-1px);
    }

    .program-tab-btn.active {
        border-color: transparent;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        box-shadow: 0 12px 28px rgba(0, 174, 239, 0.24);
    }

    .program-day-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

    .program-day-header {
        padding: 1.1rem 1.35rem;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .program-day-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        margin: 0;
    }

    .program-day-title i {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: rgba(0, 174, 239, 0.10);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .program-day-count {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        padding: 0 0.85rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .program-session-list {

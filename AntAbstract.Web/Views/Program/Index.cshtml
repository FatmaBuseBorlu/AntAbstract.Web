@model IEnumerable<AntAbstract.Domain.Entities.Session>

@using System
@using System.Globalization
@using System.Linq
@using AntAbstract.Domain.Entities

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var sessions = Model?.ToList() ?? new List<Session>();

    var groups = sessions
        .OrderBy(x => x.SessionDate)
        .ThenBy(x => x.StartTime)
        .ThenBy(x => x.SortOrder)
        .GroupBy(x => x.SessionDate.Date)
        .ToList();

    var slug = ViewBag.Slug as string ?? "";
    var conferenceName = ViewBag.ConferenceName as string ?? "";

    var conferenceId = ViewBag.ConferenceId is Guid viewConferenceId
        ? viewConferenceId
        : Guid.Empty;

    var canTrackAttendance = ViewBag.CanTrackAttendance is bool canTrack && canTrack;

    var attendanceJoinUrl = ViewBag.AttendanceJoinUrl as string
        ?? (!string.IsNullOrWhiteSpace(slug) ? $"/{slug}/Attendance/Join" : "");

    var attendancePingUrl = ViewBag.AttendancePingUrl as string
        ?? (!string.IsNullOrWhiteSpace(slug) ? $"/{slug}/Attendance/Ping" : "");

    var attendanceTotalSeconds = ViewBag.AttendanceTotalSeconds is int totalSeconds
        ? totalSeconds
        : 0;

    var attendanceRequiredSeconds = ViewBag.AttendanceRequiredSeconds is int requiredSeconds && requiredSeconds > 0
        ? requiredSeconds
        : 600;

    var attendanceCompleted = ViewBag.AttendanceCompleted is bool completed && completed;

    var attendanceProgress = attendanceRequiredSeconds <= 0
        ? 0
        : Math.Min(100, (int)Math.Round((attendanceTotalSeconds * 100.0) / attendanceRequiredSeconds));

    var certificatesUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Certificates"
        : $"/{slug}/Certificates";

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string L(string key, string tr, string en)
    {
        var value = Localizer[key].Value;

        if (string.Equals(value, key, StringComparison.OrdinalIgnoreCase))
        {
            return isEnglish ? en : tr;
        }

        return value;
    }

    string GetSessionTitle(Session session)
    {
        if (isEnglish && !string.IsNullOrWhiteSpace(session.TitleEn))
        {
            return session.TitleEn;
        }

        return session.Title;
    }

    string? GetSessionDescription(Session session)
    {
        if (isEnglish && !string.IsNullOrWhiteSpace(session.DescriptionEn))
        {
            return session.DescriptionEn;
        }

        return session.Description;
    }

    string? GetPresentationTitle(Session session)
    {
        if (isEnglish && !string.IsNullOrWhiteSpace(session.PresentationTitleEn))
        {
            return session.PresentationTitleEn;
        }

        return session.PresentationTitle;
    }

    string GetAuthorName(Submission submission)
    {
        var authorName = $"{submission.Author?.FirstName} {submission.Author?.LastName}".Trim();

        if (string.IsNullOrWhiteSpace(authorName))
        {
            return L("AuthorNotSpecified", "Yazar belirtilmedi", "Author not specified");
        }

        return authorName;
    }

    string FormatDuration(int seconds)
    {
        if (seconds < 0)
        {
            seconds = 0;
        }

        var minutes = seconds / 60;
        var remainingSeconds = seconds % 60;

        if (minutes <= 0)
        {
            return $"{remainingSeconds} sn";
        }

        return $"{minutes} dk {remainingSeconds:D2} sn";
    }
}

<style>
    .program-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);

    }

    .program-session-item {
        display: grid;
        grid-template-columns: 155px minmax(0, 1fr);
        gap: 1rem;
        padding: 1rem;
        border-radius: 20px;
        transition: all 0.2s ease;
        border: 1px solid transparent;

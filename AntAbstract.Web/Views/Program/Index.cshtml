    .program-time-box {
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(0, 174, 239, 0.10), rgba(13, 110, 253, 0.08));
        border: 1px solid rgba(0, 174, 239, 0.16);
        padding: 0.9rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .program-time {
        color: #0d6efd;
        font-size: 0.98rem;
        font-weight: 900;
        line-height: 1.2;
    }

    .program-time-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 800;
        margin-top: 0.35rem;
    }

    .program-session-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        line-height: 1.35;
        margin-bottom: 0.4rem;
    }

    .program-session-desc {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        line-height: 1.45;
        margin-bottom: 0.65rem;
    }

    .program-meta-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

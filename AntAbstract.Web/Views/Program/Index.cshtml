    }

    .program-meta {
        min-height: 31px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        border-radius: 999px;
        padding: 0 0.75rem;
        font-size: 0.76rem;
        font-weight: 850;
    }

    .program-meta i {
        color: #00aeef;
    }

    .presentation-list {
        margin-top: 0.85rem;
        border-top: 1px dashed #e2e8f0;
        padding-top: 0.85rem;
    }

    .presentation-item {
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 0.85rem;
        margin-bottom: 0.65rem;
    }

    .presentation-item:last-child {
        margin-bottom: 0;
    }

    .presentation-title {
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 900;
        line-height: 1.35;
        margin-bottom: 0.35rem;
    }

    .presentation-author {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .empty-program-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .empty-program-icon {
        width: 116px;
        height: 116px;
        border-radius: 999px;
        background: #f8fafc;
        color: #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 3.6rem;
        margin-bottom: 1.2rem;
    }

    .empty-program-title {
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .empty-program-text {
        color: #64748b;
        font-size: 0.92rem;
        font-weight: 650;
        max-width: 560px;
        margin: 0 auto;
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }

        .program-stats {
            grid-template-columns: 1fr;
        }

        .program-session-item {
            grid-template-columns: 1fr;
        }

        .attendance-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .attendance-progress-area {
            width: 100%;
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .program-page { padding: 1.5rem 1rem 3rem; }
        .program-title { font-size: 1.45rem; }
        .program-day-header { flex-direction: column; align-items: flex-start; }
        .attendance-left { flex-direction: column; align-items: flex-start; min-width: 100%; }
    }

    @@media (max-width: 575px) {
        .program-page { padding: 1rem .75rem 2rem; }
        .program-hero { flex-direction: column; align-items: flex-start; gap: .75rem; padding: 1rem; border-radius: 14px; }
        .program-hero-left { flex-direction: column; gap: .5rem; }
        .program-hero-icon { width: 42px; height: 42px; font-size: 1.1rem; border-radius: 12px; }
        .program-title { font-size: 1.2rem; }
        .program-session-card { padding: 1rem; border-radius: 14px; }
        .session-time-badge, .session-location-badge { font-size: .72rem; }
        .session-presentations { gap: .5rem; }
        .session-presentation-item { padding: .6rem .75rem; }
        .attendance-card { padding: 1rem; }
        .attendance-progress-bar-wrap { height: 10px; }
    }
</style>

<div class="program-page">

    <form id="attendanceAntiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-calendar-days"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("PageHeading", "", "Congress Program")
                </h3>

                <p class="program-lead">
                    @L(
                        "PageLead",
                        "Kongre oturumlarını, sunum saatlerini ve programa alınan bildirileri buradan takip edebilirsiniz.",
                        "You can follow congress sessions, presentation times and scheduled abstracts here."
                    )
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(conferenceName))
        {
            <div class="program-conference-pill">
                <i class="fas fa-calendar-check text-primary"></i>
                <span>@conferenceName</span>
            </div>
        }
    </div>

    @if (canTrackAttendance && conferenceId != Guid.Empty)
    {
        <div class="attendance-card"
             id="attendanceTracker"
             data-completed="@(attendanceCompleted ? "true" : "false")">

            <div class="attendance-left">
                <div class="attendance-icon">
                    <i class="fas fa-user-clock"></i>
                </div>

                <div>
                    <div class="attendance-title">
                        @L("AttendanceTrackingTitle", "Online Katılım Takibi", "Online Attendance Tracking")
                    </div>

                    <p class="attendance-text" id="attendanceMessage">
                        @(attendanceCompleted
                            ? L("AttendanceAlreadyCompletedText", "Katılım süreniz tamamlandı. Sertifika koşullarınız sağlandıysa belgeniz Sertifikalarım ekranında görünür.", "Your attendance time is completed. If certificate requirements are met, your certificate will appear on My Certificates.")
                            : L("AttendanceTrackingText", "Bu sayfada kaldığınız süre boyunca online katılım süreniz takip edilir.", "Your online attendance time is tracked while you stay on this page."))
                    </p>
                </div>
            </div>

            <div class="attendance-progress-area">
                <div class="attendance-progress-top">
                    <span id="attendanceTimeText">
                        @FormatDuration(attendanceTotalSeconds) / @FormatDuration(attendanceRequiredSeconds)
                    </span>

                    <span class="attendance-status-badge @(attendanceCompleted ? "completed" : "waiting")"
                          id="attendanceStatusBadge">
                        <i class="fas @(attendanceCompleted ? "fa-check-circle" : "fa-clock")"></i>
                        <span>
                            @(attendanceCompleted
                                ? L("AttendanceCompletedBadge", "Tamamlandı", "Completed")
                                : L("AttendanceWaitingBadge", "Takip Ediliyor", "Tracking"))
                        </span>
                    </span>
                </div>

                <div class="attendance-progress">
                    <div class="attendance-progress-bar"
                         id="attendanceProgressBar"
                         style="width:@attendanceProgress%">
                    </div>
                </div>
            </div>

            <a href="@certificatesUrl" class="attendance-certificate-btn">
                <i class="fas fa-certificate"></i>
                @L("GoToCertificatesButton", "Sertifikalarım", "My Certificates")
            </a>
        </div>
    }

    <div class="program-stats">
        <div class="program-stat-card">
            <div class="program-stat-icon stat-blue">
                <i class="fas fa-calendar-alt"></i>
            </div>

            <div>
                <div class="program-stat-value">
                    @sessions.Count
                </div>

                <div class="program-stat-label">
                    @L("Stat_TotalSessions", "Toplam Oturum", "Total Sessions")
                </div>
            </div>
        </div>

        <div class="program-stat-card">
            <div class="program-stat-icon stat-cyan">
                <i class="fas fa-calendar-day"></i>
            </div>

            <div>
                <div class="program-stat-value">
                    @groups.Count
                </div>

                <div class="program-stat-label">
                    @L("Stat_TotalDays", "Program Günü", "Program Days")
                </div>
            </div>
        </div>

        <div class="program-stat-card">
            <div class="program-stat-icon stat-green">
                <i class="fas fa-file-lines"></i>
            </div>

            <div>
                <div class="program-stat-value">
                    @sessions.Sum(x => x.Submissions?.Count ?? 0)
                </div>

                <div class="program-stat-label">
                    @L("Stat_TotalPresentations", "Programa Ekli Bildiri", "Scheduled Abstracts")
                </div>
            </div>
        </div>
    </div>

    @if (!sessions.Any())
    {
        <div class="empty-program-card">
            <div class="empty-program-icon">
                <i class="fas fa-calendar-xmark"></i>
            </div>

            <h5 class="empty-program-title">
                @L("EmptyTitle", "Program henüz yayınlanmadı", "Program has not been published yet")
            </h5>

            <p class="empty-program-text">
                @L(
                    "EmptyProgramText",
                    "Bu kongre için henüz aktif program oturumu oluşturulmamış.",
                    "No active program sessions have been created for this congress yet."
                )
            </p>
        </div>
    }
    else
    {
        <ul class="nav program-tabs" id="program-tabs" role="tablist">
            @for (int i = 0; i < groups.Count; i++)
            {
                var group = groups[i];

                <li class="nav-item" role="presentation">
                    <button class="program-tab-btn @(i == 0 ? "active" : "")"
                            id="tab-@i"
                            data-bs-toggle="pill"
                            data-bs-target="#content-@i"
                            type="button"
                            role="tab"
                            aria-controls="content-@i"
                            aria-selected="@(i == 0 ? "true" : "false")">
                        @group.Key.ToString("dd MMMM dddd", CultureInfo.CurrentUICulture)
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content" id="program-tabs-content">
            @for (int i = 0; i < groups.Count; i++)
            {
                var group = groups[i];

                <div class="tab-pane fade @(i == 0 ? "show active" : "")"
                     id="content-@i"
                     role="tabpanel"
                     aria-labelledby="tab-@i">

                    <div class="program-day-card">
                        <div class="program-day-header">
                            <h5 class="program-day-title">
                                <i class="fas fa-calendar-day"></i>
                                @group.Key.ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                            </h5>

                            <span class="program-day-count">
                                @group.Count() @L("SessionCountText", "oturum", "sessions")
                            </span>
                        </div>

                        <div class="program-session-list">
                            @foreach (var session in group.OrderBy(s => s.StartTime).ThenBy(s => s.SortOrder))
                            {
                                var sessionTitle = GetSessionTitle(session);
                                var sessionDescription = GetSessionDescription(session);
                                var presentationTitle = GetPresentationTitle(session);
                                var submissionCount = session.Submissions?.Count ?? 0;

                                <div class="program-session-item">
                                    <div class="program-time-box">
                                        <div class="program-time">
                                            @session.StartTime.ToString(@"hh\:mm") - @session.EndTime.ToString(@"hh\:mm")
                                        </div>

                                        <div class="program-time-label">
                                            @L("TimeRangeLabel", "Oturum Saati", "Session Time")
                                        </div>
                                    </div>

                                    <div>
                                        <h5 class="program-session-title">
                                            @sessionTitle
                                        </h5>

                                        @if (!string.IsNullOrWhiteSpace(sessionDescription))
                                        {
                                            <div class="program-session-desc">
                                                @sessionDescription
                                            </div>
                                        }

                                        <div class="program-meta-list">
                                            <span class="program-meta">
                                                <i class="fas fa-location-dot"></i>
                                                @(string.IsNullOrWhiteSpace(session.Location)
                                                    ? L("LocationNotSpecified", "Konum belirtilmedi", "Location not specified")
                                                    : session.Location)
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(session.SpeakerName))
                                            {
                                                <span class="program-meta">
                                                    <i class="fas fa-microphone"></i>
                                                    @session.SpeakerName
                                                </span>
                                            }

                                            <span class="program-meta">
                                                <i class="fas fa-file-lines"></i>
                                                @submissionCount @L("SubmissionText", "bildiri", "abstracts")
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(session.LiveStreamUrl))
                                            {
                                                <a href="@session.LiveStreamUrl" target="_blank"
                                                   class="program-meta text-decoration-none text-danger fw-bold">
                                                    <i class="fas fa-video"></i>
                                                    @(session.LiveStreamPlatform ?? "Canlı Yayın")
                                                </a>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(presentationTitle))
                                        {
                                            <div class="presentation-item">
                                                <div class="presentation-title">
                                                    @presentationTitle
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(session.SpeakerName))
                                                {
                                                    <div class="presentation-author">
                                                        <i class="fas fa-user-circle"></i>
                                                        @session.SpeakerName
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (session.Submissions != null && session.Submissions.Any())
                                        {
                                            <div class="presentation-list">
                                                @foreach (var submission in session.Submissions.OrderBy(x => x.Title))
                                                {
                                                    <div class="presentation-item">
                                                        <div class="presentation-title">
                                                            @submission.Title
                                                        </div>

                                                        <div class="presentation-author">
                                                            <i class="fas fa-user-circle"></i>
                                                            @GetAuthorName(submission)
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (string.IsNullOrWhiteSpace(presentationTitle))
                                        {
                                            <div class="program-session-desc mb-0">
                                                @L(
                                                    "DetailsComingSoonText",
                                                    "Oturum detayları yakında eklenecektir.",
                                                    "Session details will be added soon."
                                                )
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const canTrackAttendance = @(canTrackAttendance.ToString().ToLowerInvariant());
            const conferenceId = "@conferenceId";
            const joinUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(attendanceJoinUrl));
            const pingUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(attendancePingUrl));

            const completedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AttendanceCompletedBadge", "Tamamlandı", "Completed")));
            const trackingText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AttendanceWaitingBadge", "Takip Ediliyor", "Tracking")));
            const completedMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AttendanceCompletedMessage", "Katılım süreniz tamamlandı. Sertifika koşullarınız sağlandıysa belgeniz Sertifikalarım ekranında görünür.", "Your attendance time is completed. If certificate requirements are met, your certificate will appear on My Certificates.")));
            const errorPrefix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AttendanceErrorPrefix", "Katılım takibi başlatılamadı:", "Attendance tracking could not start:")));

            const tracker = document.getElementById("attendanceTracker");

            if (!canTrackAttendance || !tracker || !conferenceId || conferenceId === "00000000-0000-0000-0000-000000000000") {
                return;
            }

            const tokenInput = document.querySelector('#attendanceAntiForgeryForm input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";

            const timeText = document.getElementById("attendanceTimeText");
            const progressBar = document.getElementById("attendanceProgressBar");
            const statusBadge = document.getElementById("attendanceStatusBadge");
            const messageBox = document.getElementById("attendanceMessage");

            let isCompleted = tracker.dataset.completed === "true";
            let pingTimer = null;

            function formatDuration(seconds) {
                seconds = Math.max(0, parseInt(seconds || 0));

                const minutes = Math.floor(seconds / 60);
                const remainingSeconds = seconds % 60;

                if (minutes <= 0) {
                    return remainingSeconds + " sn";
                }

                return minutes + " dk " + String(remainingSeconds).padStart(2, "0") + " sn";
            }

            function updateAttendanceUi(data) {
                if (!data) {
                    return;
                }

                const totalSeconds = parseInt(data.totalSeconds || 0);
                const requiredSeconds = parseInt(data.requiredSeconds || 600);
                const progress = requiredSeconds <= 0
                    ? 0
                    : Math.min(100, Math.round((totalSeconds * 100) / requiredSeconds));

                if (timeText) {
                    timeText.innerText = formatDuration(totalSeconds) + " / " + formatDuration(requiredSeconds);
                }

                if (progressBar) {
                    progressBar.style.width = progress + "%";
                }

                isCompleted = data.completed === true;

                if (statusBadge) {
                    statusBadge.classList.toggle("completed", isCompleted);
                    statusBadge.classList.toggle("waiting", !isCompleted);

                    statusBadge.innerHTML = isCompleted
                        ? '<i class="fas fa-check-circle"></i><span>' + completedText + '</span>'
                        : '<i class="fas fa-clock"></i><span>' + trackingText + '</span>';
                }

                if (isCompleted && messageBox) {
                    messageBox.innerText = completedMessage;
                }

                if (isCompleted && pingTimer) {
                    clearInterval(pingTimer);
                    pingTimer = null;
                }
            }

            async function postAttendance(url) {
                const formData = new URLSearchParams();

                formData.append("conferenceId", conferenceId);

                if (token) {
                    formData.append("__RequestVerificationToken", token);
                }

                const response = await fetch(url, {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                        "RequestVerificationToken": token
                    },
                    body: formData.toString()
                });

                const data = await response.json().catch(function () {
                    return {
                        ok: false,
                        message: response.statusText
                    };
                });

                if (!response.ok || data.ok === false) {
                    throw new Error(data.message || response.statusText);
                }

                return data;
            }

            async function joinAttendance() {
                try {
                    const data = await postAttendance(joinUrl);
                    updateAttendanceUi(data);

                    if (!isCompleted) {
                        startPingTimer();
                    }
                } catch (error) {
                    if (messageBox) {
                        messageBox.innerText = errorPrefix + " " + error.message;
                    }
                }
            }

            async function pingAttendance() {
                if (isCompleted || document.visibilityState !== "visible") {
                    return;
                }

                try {
                    const data = await postAttendance(pingUrl);
                    updateAttendanceUi(data);
                } catch (error) {
                    if (messageBox) {
                        messageBox.innerText = errorPrefix + " " + error.message;
                    }
                }
            }

            function startPingTimer() {
                if (pingTimer) {
                    clearInterval(pingTimer);
                }

                pingTimer = setInterval(pingAttendance, 30000);
            }

            joinAttendance();

            document.addEventListener("visibilitychange", function () {
                if (document.visibilityState === "visible" && !isCompleted) {
                    pingAttendance();
                }
            });
        });
    </script>
}
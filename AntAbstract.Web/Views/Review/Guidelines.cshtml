@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Routing
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";
    var conferenceTitle = Context.Session.GetString("SelectedConferenceTitle") ?? "";

    var criteria = new[]
    {
        new
        {
            Icon = "fas fa-lightbulb",
            ColorClass = "criteria-blue",
            Title = L("Criterion1Title", "Özgünlük ve Katkı"),
            Text = L("Criterion1Text", "Çalışmanın literatüre, uygulamaya veya ilgili alana sağladığı yenilik ve katkı değerlendirilmelidir.")
        },
        new
        {
            Icon = "fas fa-flask",
            ColorClass = "criteria-green",
            Title = L("Criterion2Title", "Yöntem ve Bilimsel Tutarlılık"),
            Text = L("Criterion2Text", "Kullanılan yöntem, veri, analiz ve sonuçların bilimsel açıdan tutarlı olup olmadığı incelenmelidir.")
        },
        new
        {
            Icon = "fas fa-pen-nib",
            ColorClass = "criteria-purple",
            Title = L("Criterion3Title", "Anlatım ve Yazım Kalitesi"),
            Text = L("Criterion3Text", "Bildiri dili, akademik anlatım, düzen, açıklık ve kaynak gösterimi açısından değerlendirilmelidir.")
        },
        new
        {
            Icon = "fas fa-balance-scale",
            ColorClass = "criteria-orange",
            Title = L("Criterion4Title", "Etik Uygunluk"),
            Text = L("Criterion4Text", "Çalışmanın etik ilkelere, akademik dürüstlüğe ve tarafsız değerlendirme kurallarına uygunluğu dikkate alınmalıdır.")
        }
    };
}

<style>
    .review-guide-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 780px;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .program-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .program-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
        border: none;
    }

    .program-hero-btn-primary {
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.18);
    }

    .program-hero-btn-primary:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.26);
        text-decoration: none;
    }

    .guide-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
        margin-bottom: 1.4rem;
    }

    .guide-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .guide-card-title {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0 0 0.25rem;
        display: flex;
        align-items: center;
    }

    .guide-card-title i {
        color: #00aeef;
    }

    .guide-card-subtitle {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.55;
        margin-bottom: 0;
    }

    .guide-card-body {
        padding: 1.35rem;
    }

    .principle-box {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        background: rgba(0, 174, 239, 0.08);
        border: 1px solid rgba(0, 174, 239, 0.16);
        border-radius: 22px;
        padding: 1rem 1.1rem;
        color: #475569;
        font-size: 0.92rem;
        font-weight: 650;
        line-height: 1.75;
    }

    .principle-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 16px;
        background: #ffffff;
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        font-size: 1.1rem;
    }

    .principle-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 0.18rem;
    }

    .criteria-card {
        height: 100%;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.15rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.035);
        transition: all 0.2s ease;
    }

    .criteria-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.075);
    }

    .criteria-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: 0.9rem;
    }

    .criteria-blue {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
    }

    .criteria-green {
        background: rgba(22, 163, 74, 0.11);
        color: #16a34a;
    }

    .criteria-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .criteria-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .criteria-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 0.45rem;
    }

    .criteria-text {
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 650;
        line-height: 1.65;
        margin-bottom: 0;
    }

    .decision-guide {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .decision-item {
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1rem;
        background: #ffffff;
        min-height: 150px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.03);
    }

    .decision-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 950;
        margin-bottom: 0.8rem;
    }

    .decision-accept {
        background: rgba(22, 163, 74, 0.11);
        color: #15803d;
        border: 1px solid rgba(22, 163, 74, 0.18);
    }

    .decision-minor,
    .decision-major {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
        border: 1px solid rgba(245, 158, 11, 0.18);
    }

    .decision-reject {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.18);
    }

    .decision-text {
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 650;
        line-height: 1.6;
        margin-bottom: 0;
    }

    .ethics-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .ethics-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 0.9rem 1rem;
        color: #475569;
        font-size: 0.88rem;
        font-weight: 700;
        line-height: 1.55;
    }

    .ethics-item i {
        color: #00aeef;
        margin-top: 0.18rem;
    }

    .support-box {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        background: rgba(245, 158, 11, 0.10);
        border: 1px solid rgba(245, 158, 11, 0.20);
        border-radius: 22px;
        padding: 1rem 1.1rem;
        color: #475569;
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.65;
    }

    .support-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 16px;
        background: #ffffff;
        color: #f59e0b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
    }

    .coming-soon-box {
        margin-top: 1.4rem;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 1rem;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 750;
        line-height: 1.6;
    }

    @@media (max-width: 991.98px) {
        .decision-guide,
        .ethics-list {
            grid-template-columns: 1fr;
        }

        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .review-guide-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-title {
            font-size: 1.45rem;
        }

        .support-box,
        .principle-box {
            align-items: flex-start;
            flex-direction: column;
        }

        .program-hero-btn {
            width: 100%;
        }
    }
</style>

<div class="review-guide-page">

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-book-reader"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("HeroTitle", "Hakem Rehberi")
                </h3>

                <p class="program-lead">
                    @L("HeroDescription", "Değerlendirme sürecinde dikkat edilmesi gereken temel ilkeleri, puanlama yaklaşımını ve karar önerilerini bu sayfadan inceleyebilirsiniz.")
                </p>
            </div>
        </div>

        <div class="program-hero-actions">
            @if (!string.IsNullOrWhiteSpace(conferenceTitle))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-calendar-check"></i>
                    <span>@conferenceTitle</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(slug))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-link"></i>
                    <span>/@slug</span>
                </div>
            }

            <button class="program-hero-btn program-hero-btn-primary" type="button" onclick="window.print()">
                <i class="fas fa-file-pdf"></i>
                @L("DownloadPdfButton", "PDF Rehberi İndir")
            </button>
        </div>
    </div>

    <div class="guide-card">
        <div class="guide-card-header">
            <h5 class="guide-card-title">
                <i class="fas fa-balance-scale me-2"></i>
                @L("Section1Title", "Temel Değerlendirme İlkeleri")
            </h5>

            <p class="guide-card-subtitle">
                @L("Section1Subtitle", "Hakemlik süreci tarafsız, gizli ve bilimsel bir değerlendirme yaklaşımı gerektirir.")
            </p>
        </div>

        <div class="guide-card-body">
            <div class="principle-box">
                <div class="principle-icon">
                    <i class="fas fa-user-shield"></i>
                </div>

                <div>
                    <div class="principle-title">
                        @L("ConfidentialityText", "Gizlilik ve tarafsızlık")
                    </div>

                    <div>
                        @L("Section1Text_Part1", "Değerlendirme sürecinde size sunulan bildiri içerikleri gizlidir.")
                        <strong>@L("Section1Text_Strong", "Bildiri dosyaları, yazar bilgileri ve değerlendirme notları üçüncü kişilerle paylaşılmamalıdır.")</strong>
                        @L("Section1Text_Part2", "Çıkar çatışması olduğunu düşündüğünüz durumlarda değerlendirme görevini iade etmeniz beklenir.")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="guide-card">
        <div class="guide-card-header">
            <h5 class="guide-card-title">
                <i class="fas fa-clipboard-list me-2"></i>
                @L("Section2Title", "Değerlendirme Kriterleri")
            </h5>

            <p class="guide-card-subtitle">
                @L("Section2Subtitle", "Bir bildiriyi değerlendirirken aşağıdaki ana başlıkları dikkate alabilirsiniz.")
            </p>
        </div>

        <div class="guide-card-body">
            <div class="row g-3">
                @foreach (var criterion in criteria)
                {
                    <div class="col-md-6">
                        <div class="criteria-card">
                            <div class="criteria-icon @criterion.ColorClass">
                                <i class="@criterion.Icon"></i>
                            </div>

                            <h6 class="criteria-title">
                                @criterion.Title
                            </h6>

                            <p class="criteria-text">
                                @criterion.Text
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="guide-card">
        <div class="guide-card-header">
            <h5 class="guide-card-title">
                <i class="fas fa-gavel me-2"></i>
                @L("DecisionGuideTitle", "Karar Önerileri")
            </h5>

            <p class="guide-card-subtitle">
                @L("DecisionGuideSubtitle", "Değerlendirme sonucunda vereceğiniz karar önerisi aşağıdaki anlamlara gelir.")
            </p>
        </div>

        <div class="guide-card-body">
            <div class="decision-guide">
                <div class="decision-item">
                    <span class="decision-badge decision-accept">
                        <i class="fas fa-check-circle"></i>
                        @L("DecisionAccept", "Kabul")
                    </span>

                    <p class="decision-text">
                        @L("DecisionAcceptText", "Bildiri mevcut haliyle bilimsel programa dahil edilebilir.")
                    </p>
                </div>

                <div class="decision-item">
                    <span class="decision-badge decision-minor">
                        <i class="fas fa-edit"></i>
                        @L("DecisionMinorRevision", "Küçük Revizyon")
                    </span>

                    <p class="decision-text">
                        @L("DecisionMinorRevisionText", "Bildiri küçük düzeltmelerle kabul edilebilir duruma gelebilir.")
                    </p>
                </div>

                <div class="decision-item">
                    <span class="decision-badge decision-major">
                        <i class="fas fa-sync-alt"></i>
                        @L("DecisionMajorRevision", "Büyük Revizyon")
                    </span>

                    <p class="decision-text">
                        @L("DecisionMajorRevisionText", "Bildiri kapsamlı düzeltme gerektirir; yeniden değerlendirme gerekebilir.")
                    </p>
                </div>

                <div class="decision-item">
                    <span class="decision-badge decision-reject">
                        <i class="fas fa-times-circle"></i>
                        @L("DecisionReject", "Ret")
                    </span>

                    <p class="decision-text">
                        @L("DecisionRejectText", "Bildiri bilimsel programa dahil edilmek için yeterli görülmeyebilir.")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="guide-card">
        <div class="guide-card-header">
            <h5 class="guide-card-title">
                <i class="fas fa-user-shield me-2"></i>
                @L("EthicsTitle", "Etik ve Gizlilik Kuralları")
            </h5>

            <p class="guide-card-subtitle">
                @L("EthicsSubtitle", "Hakemlik sürecinde aşağıdaki kurallara dikkat edilmelidir.")
            </p>
        </div>

        <div class="guide-card-body">
            <ul class="ethics-list">
                <li class="ethics-item">
                    <i class="fas fa-check-circle"></i>
                    <span>@L("EthicsItem1", "Bildiri içeriğini üçüncü kişilerle paylaşmayınız.")</span>
                </li>

                <li class="ethics-item">
                    <i class="fas fa-check-circle"></i>
                    <span>@L("EthicsItem2", "Yazarla doğrudan iletişime geçmeyiniz.")</span>
                </li>

                <li class="ethics-item">
                    <i class="fas fa-check-circle"></i>
                    <span>@L("EthicsItem3", "Çıkar çatışması varsa görevi iade ediniz.")</span>
                </li>

                <li class="ethics-item">
                    <i class="fas fa-check-circle"></i>
                    <span>@L("EthicsItem4", "Yorumlarınızı yapıcı ve akademik bir dille yazınız.")</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="support-box">
        <div class="support-icon">
            <i class="fas fa-circle-info"></i>
        </div>

        <div>
            <strong>@L("SupportTitle", "Ek bilgi")</strong>
            <div>
                @L("SupportText", "Değerlendirme sürecinde sorun yaşarsanız kongre yönetimiyle iletişime geçebilirsiniz.")
            </div>
        </div>
    </div>

    <div class="coming-soon-box">
        <i class="fas fa-print me-2 text-primary"></i>
        @L("PrintHint", "Bu sayfayı tarayıcı yazdırma özelliğiyle PDF olarak kaydedebilirsiniz.")
    </div>
</div>
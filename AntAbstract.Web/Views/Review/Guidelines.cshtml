@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-primary bg-gradient p-5 text-white text-center">
                    <i class="fas fa-book-reader fa-4x mb-3 opacity-75"></i>
                    <h2 class="fw-bold">@Localizer["HeroTitle"]</h2>
                    <p class="opacity-75">@Localizer["HeroDescription"]</p>
                    <button class="btn btn-light text-primary rounded-pill px-4 fw-bold mt-3 shadow-sm">
                        <i class="fas fa-file-pdf me-2"></i> @Localizer["DownloadPdfButton"]
                    </button>
                </div>

                <div class="card-body p-5">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="fas fa-balance-scale text-primary me-2"></i> @Localizer["Section1Title"]
                    </h5>
                    <p class="text-muted mb-4" style="line-height: 1.7;">
                        @Localizer["Section1Text_Part1"] <strong>@Localizer["ConfidentialityText"]</strong> @Localizer["Section1Text_Part2"]
                    </p>

                    <h5 class="fw-bold text-dark mb-3">
                        <i class="fas fa-clipboard-list text-primary me-2"></i> @Localizer["Section2Title"]
                    </h5>

                    <div class="row g-3 mb-5">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-dark">@Localizer["Criterion1Title"]</h6>
                                <p class="small text-muted mb-0">@Localizer["Criterion1Text"]</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-dark">@Localizer["Criterion2Title"]</h6>
                                <p class="small text-muted mb-0">@Localizer["Criterion2Text"]</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-dark">@Localizer["Criterion3Title"]</h6>
                                <p class="small text-muted mb-0">@Localizer["Criterion3Text"]</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-dark">@Localizer["Criterion4Title"]</h6>
                                <p class="small text-muted mb-0">@Localizer["Criterion4Text"]</p>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 rounded-3 d-flex align-items-center">
                        <i class="fas fa-envelope fs-4 me-3"></i>
                        <div>
                            @Localizer["SupportText_Part1"] <strong>editor@antabstract.com</strong> @Localizer["SupportText_Part2"]
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model AntAbstract.Application.DTOs.Review.ReviewAssignmentDto

@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Routing
@using System

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var loc = Localizer.GetString(key);
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    var slug = ViewBag.Slug as string
        ?? Context.GetRouteValue("slug")?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Index"
        : $"/{slug}/Review/Index";

    var evaluatePostUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Evaluate"
        : $"/{slug}/Review/Evaluate";

    var certificateUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Review/DownloadCertificate/{Model.Id}"
        : $"/{slug}/Review/DownloadCertificate/{Model.Id}";

    var isReviewed = Model.IsReviewed;
    var currentScore = Model.Score ?? 85;
    var currentRecommendation = Model.Recommendation ?? "";
    var currentComment = Model.CommentsToAuthor ?? "";
}

<style>
    .review-evaluate-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 1.25rem 1.5rem 4rem;
    }

    .evaluate-hero {
        background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.20), transparent 34%), linear-gradient(135deg, #ffffff 0%, #fffaf2 100%);
        border: 1px solid #f1e4cf;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.055);
        margin-bottom: 1.5rem;
    }

    .evaluate-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 280px;
        flex: 1;
    }

    .evaluate-hero-icon {
        width: 66px;
        height: 66px;
        min-width: 66px;
        border-radius: 24px;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 16px 32px rgba(249, 115, 22, 0.22);
    }

    .evaluate-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .evaluate-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 1.75rem;
        font-weight: 950;
        letter-spacing: -0.045em;
        line-height: 1.15;
    }

    .evaluate-description {
        margin: 0;
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        line-height: 1.6;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .back-btn,
    .certificate-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1rem;
    }

    .submission-info-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.065);
        overflow: hidden;
    }

    .submission-info-header {
        padding: 1.45rem 1.55rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .submission-ref-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1rem;
    }

    .ref-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
        font-size: 0.75rem;
        font-weight: 950;
    }

    .conference-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        max-width: 100%;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        border: 1px solid rgba(13, 110, 253, 0.14);
        font-size: 0.75rem;
        font-weight: 950;
    }

    .conference-badge span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .reviewed-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        background: rgba(22, 163, 74, 0.10);
        color: #15803d;
        border: 1px solid rgba(22, 163, 74, 0.18);
        font-size: 0.75rem;
        font-weight: 950;
    }

    .pending-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
        border: 1px solid rgba(245, 158, 11, 0.18);
        font-size: 0.75rem;
        font-weight: 950;
    }

    .submission-title {
        color: #0f172a;
        font-weight: 950;
        letter-spacing: -0.035em;
        line-height: 1.35;
        margin-bottom: 0;
    }

    .submission-info-body {
        padding: 1.55rem;
    }

    .section-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.75rem;
    }

    .abstract-box {
        background: #f8fafc;
        border-left: 5px solid #00aeef;
        padding: 1.25rem;
        border-radius: 16px;
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.75;
        font-weight: 600;
        white-space: pre-line;
    }

    .file-card {
        height: 100%;
        padding: 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .file-card:hover {
        border-color: rgba(0, 174, 239, 0.35);
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.075);
        transform: translateY(-2px);
        text-decoration: none;
    }

    .file-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        background: rgba(239, 68, 68, 0.10);
        color: #ef4444;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .file-name {
        color: #0f172a;
        font-weight: 900;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-helper {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 700;
    }

    .evaluation-card {
        background: #ffffff;
        border-radius: 28px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.07);
        border: 1px solid #e2e8f0;
        position: sticky;
        top: 100px;
        overflow: hidden;
    }

    .evaluation-header {
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        border-bottom: 1px solid #e2e8f0;
        padding: 1.35rem 1.45rem;
    }

    .evaluation-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .evaluation-subtitle {
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 650;
        margin-bottom: 0;
    }

    .evaluation-body {
        padding: 1.45rem;
    }

    .score-display {
        font-size: 2.7rem;
        font-weight: 950;
        color: #00aeef;
        text-align: center;
        display: block;
        margin-bottom: 0.75rem;
        line-height: 1;
    }

    .range {
        width: 100%;
        cursor: pointer;
    }

    .decision-option {
        display: none;
    }

    .decision-label {
        display: block;
        padding: 0.95rem 0.75rem;
        border: 2px solid #e2e8f0;
        border-radius: 18px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        font-weight: 900;
        color: #64748b;
        min-height: 92px;
    }

    .decision-label i {
        display: block;
        font-size: 1.45rem;
        margin-bottom: 0.5rem;
    }

    .decision-label:hover {
        background-color: #f8fafc;
        border-color: #cbd5e1;
    }

    .decision-option:checked + .decision-label {
        background-color: #e0f2fe;
        border-color: #00aeef;
        color: #00aeef;
        box-shadow: 0 4px 10px rgba(0, 174, 239, 0.2);
    }

    .decision-option[value="Reject"]:checked + .decision-label {
        background-color: #fee2e2;
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
    }

    .decision-option[value="MinorRevision"]:checked + .decision-label,
    .decision-option[value="MajorRevision"]:checked + .decision-label {
        background-color: rgba(245, 158, 11, 0.12);
        border-color: #f59e0b;
        color: #b45309;
        box-shadow: 0 4px 10px rgba(245, 158, 11, 0.18);
    }

    .review-textarea {
        border-radius: 18px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        resize: vertical;
        min-height: 160px;
        font-weight: 600;
        color: #334155;
    }

    .review-textarea:focus {
        border-color: #00aeef;
        background: #ffffff;
        box-shadow: 0 0 0 0.2rem rgba(0, 174, 239, 0.10);
    }

    .readonly-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 1rem;
        color: #475569;
        font-weight: 650;
        line-height: 1.7;
        white-space: pre-line;
    }

    .submit-btn {
        min-height: 52px;
        border-radius: 999px;
        font-weight: 950;
        box-shadow: 0 14px 30px rgba(0, 174, 239, 0.25);
    }

    .info-alert {
        border: none;
        border-radius: 18px;
        font-weight: 700;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.045);
    }

    @@media (max-width: 991.98px) {
        .evaluation-card {
            position: static;
        }
    }

    @@media (max-width: 768px) {
        .review-evaluate-page {
            padding: 1rem 1rem 3rem;
        }

        .evaluate-hero-left {
            flex-direction: column;
            align-items: flex-start;
            min-width: 100%;
        }

        .hero-actions,
        .back-btn,
        .certificate-btn {
            width: 100%;
        }

        .evaluate-title {
            font-size: 1.45rem;
        }
    }
</style>

<div class="review-evaluate-page">

    <div class="evaluate-hero">
        <div class="evaluate-hero-left">
            <div class="evaluate-hero-icon">
                <i class="fas fa-clipboard-check"></i>
            </div>

            <div>
                <div class="evaluate-kicker">
                    @L("HeaderKicker", "Hakem Değerlendirme")
                </div>

                <h1 class="evaluate-title">
                    @(isReviewed
                        ? L("ReviewedPageHeading", "Değerlendirme Detayı")
                        : L("PageHeading", ""))
                </h1>

                <p class="evaluate-description">
                    @(isReviewed
                        ? L("ReviewedPageLead", "Tamamladığınız değerlendirme raporunun detaylarını buradan görüntüleyebilirsiniz.")
                        : L("PageLead", "Size atanmış bildiriyi inceleyerek değerlendirme puanınızı ve karar önerinizi gönderiniz."))
                </p>
            </div>
        </div>

        <div class="hero-actions">
            @if (isReviewed)
            {
                <a href="@certificateUrl"
                   target="_blank"
                   class="btn btn-outline-warning certificate-btn">
                    <i class="fas fa-certificate"></i>
                    @L("CertificateButton", "Sertifika")
                </a>
            }

            <a href="@backUrl" class="btn btn-outline-secondary back-btn">
                <i class="fas fa-arrow-left"></i>
                @L("BackToListButton", "Görevlerime Dön")
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-7">
            <div class="submission-info-card mb-4">

                <div class="submission-info-header">
                    <div class="submission-ref-row">
                        <span class="ref-badge">
                            <i class="fas fa-hashtag"></i>
                            REF-@Model.Id.ToString("D8")
                        </span>

                        <span class="conference-badge" title="@Model.ConferenceName">
                            <i class="fas fa-calendar-check"></i>
                            <span>@L("ConferenceLabel", "Kongre"): @Model.ConferenceName</span>
                        </span>

                        @if (isReviewed)
                        {
                            <span class="reviewed-badge">
                                <i class="fas fa-check-circle"></i>
                                @L("ReviewedBadge", "Tamamlandı")
                            </span>
                        }
                        else
                        {
                            <span class="pending-badge">
                                <i class="fas fa-clock"></i>
                                @L("PendingBadge", "Bekliyor")
                            </span>
                        }
                    </div>

                    <h4 class="submission-title">
                        @Model.SubmissionTitle
                    </h4>
                </div>

                <div class="submission-info-body">
                    <h6 class="section-label">
                        @L("AbstractTitle", "Bildiri Özeti")
                    </h6>

                    <div class="abstract-box mb-5">
                        @Model.SubmissionAbstract
                    </div>

                    <h6 class="section-label">
                        @L("AttachedFilesTitle", "Ek Dosyalar")
                    </h6>

                    @if (Model.Files != null && Model.Files.Any())
                    {
                        <div class="row g-3">
                            @foreach (var file in Model.Files)
                            {
                                <div class="col-md-6">
                                    <a href="/download/submission/@file.Id" target="_blank" class="file-card">
                                        <div class="file-icon">
                                            <i class="fas fa-file-pdf"></i>
                                        </div>

                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="file-name" title="@file.FileName">
                                                @file.FileName
                                            </div>

                                            <div class="file-helper">
                                                @L("ClickToViewText", "Görüntüle / indir")
                                            </div>
                                        </div>

                                        <i class="fas fa-download text-muted ms-2"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning info-alert bg-warning bg-opacity-10 text-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @L("NoDownloadableFileText", "Bu bildiriye ait indirilebilir dosya bulunmuyor.")
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="evaluation-card">
                <div class="evaluation-header">
                    <h5 class="evaluation-title">
                        <i class="fas fa-gavel text-primary me-2"></i>
                        @(isReviewed
                            ? L("ReviewedDecisionTitle", "ilen Değerlendirme")
                            : L("ReviewerDecisionTitle", "Hakem Kararı"))
                    </h5>

                    <p class="evaluation-subtitle">
                        @(isReviewed
                            ? L("ReviewedDecisionSubtitle", "Bu değerlendirme tamamlanmıştır. Bilgiler yalnızca görüntülenir.")
                            : L("ReviewerDecisionSubtitle", "ınızı, karar önerinizi ve yazara iletilecek notunuzu giriniz."))
                    </p>
                </div>

                <div class="evaluation-body">




                    @if (isReviewed)
                    {
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-3">
                                @L("OverallScoreLabel", "Genel ")
                            </label>

                            <span class="score-display">@currentScore</span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-2">
                                @L("DecisionLabel", "Karar Önerisi")
                            </label>

                            <div class="readonly-box">
                                @switch (currentRecommendation)
                                {
                                    case "Accept":
                                        <span>
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            @L("AcceptLabel", "Kabul")
                                        </span>
                                        break;

                                    case "Reject":
                                        <span>
                                            <i class="fas fa-times-circle text-danger me-2"></i>
                                            @L("RejectLabel", "Ret")
                                        </span>
                                        break;

                                    case "MinorRevision":
                                        <span>
                                            <i class="fas fa-edit text-warning me-2"></i>
                                            @L("MinorRevisionLabel", "Küçük Revizyon")
                                        </span>
                                        break;

                                    case "MajorRevision":
                                        <span>
                                            <i class="fas fa-sync-alt text-warning me-2"></i>
                                            @L("MajorRevisionLabel", "Büyük Revizyon")
                                        </span>
                                        break;

                                    default:
                                        <span>@(string.IsNullOrWhiteSpace(currentRecommendation) ? "-" : currentRecommendation)</span>
                                        break;
                                }
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-2">
                                @L("NotesToAuthorLabel", "Yazara Not")
                            </label>

                            <div class="readonly-box">
                                @(string.IsNullOrWhiteSpace(currentComment)
                                    ? L("NoCommentText", "Yorum bulunmuyor.")
                                    : currentComment)
                            </div>
                        </div>
                    }
                    else
                    {
                        <form action="@evaluatePostUrl" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="ReviewAssignmentId" value="@Model.Id" />

                            <!-- Alt Kriter ları -->
                            <div class="mb-4">
                                <label class="form-label fw-bold text-muted small text-uppercase mb-3">
                                    Alt Kriter ları <small class="fw-normal text-muted">(isteğe bağlı, 0–100)</small>
                                </label>
                                @{
                                    var customCriteria = ViewBag.CustomCriteria as List<AntAbstract.Domain.Entities.ReviewCriterion>;
                                    var hasCustom = customCriteria != null && customCriteria.Count > 0;
                                }
                                <div class="row g-3">
                                @if (hasCustom)
                                {
                                    // Konferansa özel kriterler
                                    foreach (var crit in customCriteria!)
                                    {
                                        var fieldId = $"crit_{crit.Id:N}";
                                        <div class="col-md-6">
                                            <div class="p-3 border rounded-3 bg-light">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="small fw-semibold">
                                                        <i class="fas fa-star me-1 text-warning"></i>@crit.Name
                                                        @if (crit.Weight > 1)
                                                        {
                                                            <span class="badge bg-primary ms-1">×@crit.Weight</span>
                                                        }
                                                    </span>
                                                    <span class="badge bg-secondary" id="@(fieldId)Val">0</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(crit.Description))
                                                {
                                                    <p class="text-muted" style="font-size:11px;margin-bottom:4px">@crit.Description</p>
                                                }
                                                <input type="range" class="form-range custom-crit-range"
                                                       name="CustomCriteria[@crit.Id]"
                                                       id="@fieldId"
                                                       data-weight="@crit.Weight"
                                                       min="0" max="100" value="0"
                                                       oninput="document.getElementById('@(fieldId)Val').textContent=this.value; autoCalcScore();" />
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    // Standart 4 kriter (fallback)
                                    var subCriteria = new[]
                                    {
                                        ("ScoreOriginality",  Localizer.GetString("Originality").Value,    "fas fa-lightbulb"),
                                        ("ScoreMethodology",  Localizer.GetString("Methodology").Value,  "fas fa-flask"),
                                        ("ScorePresentation", Localizer.GetString("Presentation").Value, "fas fa-align-left"),
                                        ("ScoreRelevance",    Localizer.GetString("Relevance").Value, "fas fa-bullseye")
                                    };
                                    foreach (var (fieldName, label, icon) in subCriteria)
                                    {
                                        <div class="col-md-6">
                                            <div class="p-3 border rounded-3 bg-light">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="small fw-semibold">
                                                        <i class="@icon me-1 text-primary"></i>@label
                                                    </span>
                                                    <span class="badge bg-secondary" id="@(fieldName)Val">0</span>
                                                </div>
                                                <input type="range" class="form-range"
                                                       name="@fieldName" id="@fieldName"
                                                       min="0" max="100" value="0"
                                                       oninput="document.getElementById('@(fieldName)Val').textContent=this.value; autoCalcScore();" />
                                            </div>
                                        </div>
                                    }
                                }
                                </div>
                                <div class="form-text mt-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    
                                </div>
                            </div>

                            <!-- Genel  -->
                            <div class="mb-5 text-center">
                                <label class="form-label fw-bold text-muted small text-uppercase mb-3">
                                    @L("OverallScoreLabel", "Genel ")
                                </label>

                                <span id="scoreValue" class="score-display">@currentScore</span>

                                <input type="range"
                                       class="form-range range"
                                       name="Score"
                                       id="scoreRange"
                                       min="0"
                                       max="100"
                                       value="@currentScore"
                                       oninput="updateScore(this.value)" />

                                <div class="d-flex justify-content-between text-muted small px-1">
                                    <span>0 (@L("WeakText", "Zayıf"))</span>
                                    <span>100 (@L("ExcellentText", "Mükemmel"))</span>
                                </div>
                            </div>

                            <div class="mb-5">
                                <label class="form-label fw-bold text-muted small text-uppercase mb-3">
                                    @L("DecisionLabel", "Karar Önerisi")
                                </label>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <input type="radio"
                                               class="decision-option"
                                               name="Recommendation"
                                               id="rec_accept"
                                               value="Accept"
                                               required />

                                        <label class="decision-label" for="rec_accept">
                                            <i class="fas fa-check-circle"></i>
                                            @L("AcceptLabel", "Kabul")
                                        </label>
                                    </div>

                                    <div class="col-6">
                                        <input type="radio"
                                               class="decision-option"
                                               name="Recommendation"
                                               id="rec_reject"
                                               value="Reject" />

                                        <label class="decision-label" for="rec_reject">
                                            <i class="fas fa-times-circle"></i>
                                            @L("RejectLabel", "Ret")
                                        </label>
                                    </div>

                                    <div class="col-6">
                                        <input type="radio"
                                               class="decision-option"
                                               name="Recommendation"
                                               id="rec_minor"
                                               value="MinorRevision" />

                                        <label class="decision-label" for="rec_minor">
                                            <i class="fas fa-edit"></i>
                                            @L("MinorRevisionLabel", "Küçük Revizyon")
                                        </label>
                                    </div>

                                    <div class="col-6">
                                        <input type="radio"
                                               class="decision-option"
                                               name="Recommendation"
                                               id="rec_major"
                                               value="MajorRevision" />

                                        <label class="decision-label" for="rec_major">
                                            <i class="fas fa-sync-alt"></i>
                                            @L("MajorRevisionLabel", "Büyük Revizyon")
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-muted small text-uppercase">
                                    @L("NotesToAuthorLabel", "Yazara Not")
                                </label>

                                <textarea name="CommentsToAuthor"
                                          class="form-control review-textarea"
                                          rows="6"
                                          placeholder="@L("NotesPlaceholder", "Yazara iletilecek değerlendirme notunuzu yazınız.")"
                                          required>@currentComment</textarea>
                            </div>

                            <div class="d-grid">
                                <button type="submit"
                                        class="btn btn-primary py-3 submit-btn"
                                        onclick="return confirmEvaluation();">
                                    <i class="fas fa-paper-plane me-2"></i>
                                    @L("CompleteReportButton", "Değerlendirmeyi ")
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const confirmSubmitMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("ConfirmSubmitMessage", "Değerlendirmeyi göndermek istediğinize emin misiniz? Bu işlemden sonra rapor tamamlandı olarak işaretlenir.")));

        function updateScore(val) {
            const scoreDisplay = document.getElementById('scoreValue');

            if (!scoreDisplay) {
                return;
            }

            scoreDisplay.innerText = val;

            if (val < 50) {
                scoreDisplay.style.color = '#ef4444';
            } else if (val < 70) {
                scoreDisplay.style.color = '#f59e0b';
            } else {
                scoreDisplay.style.color = '#00aeef';
            }
        }

        function confirmEvaluation() {
            return confirm(confirmSubmitMessage);
        }

        function autoCalcScore() {
            const customInputs = document.querySelectorAll('.custom-crit-range');
            let avg = 0;
            if (customInputs.length > 0) {
                // Ağırlıklı ortalama: her kriterin data-weight değeri kullanılır
                let weightedSum = 0;
                let totalWeight = 0;
                customInputs.forEach(input => {
                    const val = parseInt(input.value || '0');
                    const weight = parseInt(input.dataset.weight || '1');
                    if (val > 0) {
                        weightedSum += val * weight;
                        totalWeight += weight;
                    }
                });
                if (totalWeight === 0) return;
                avg = Math.round(weightedSum / totalWeight);
            } else {
                // Standart 4 alan: basit ortalama
                const fields = ['ScoreOriginality', 'ScoreMethodology', 'ScorePresentation', 'ScoreRelevance'];
                const values = fields.map(f => parseInt(document.getElementById(f)?.value || '0'));
                const nonZero = values.filter(v => v > 0);
                if (nonZero.length === 0) return;
                avg = Math.round(nonZero.reduce((a, b) => a + b, 0) / nonZero.length);
            }
            const slider = document.getElementById('scoreRange');
            if (slider) {
                slider.value = avg;
                updateScore(avg);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateScore(@currentScore);
        });
    </script>
}
@model AntAbstract.Application.DTOs.Review.ReviewAssignmentDto

@{
    ViewData["Title"] = "Bildiri Değerlendir";
    Layout = "_LayoutDashboard";
}

<style>
    .submission-info-card {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: none;
        overflow: hidden;
    }

    .abstract-box {
        background-color: #f8fafc;
        border-left: 4px solid #00aeef;
        padding: 20px;
        border-radius: 8px;
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.7;
    }

    .evaluation-card {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f1f5f9;
        position: sticky;
        top: 100px;
    }

    .decision-option {
        display: none;
    }

    .decision-label {
        display: block;
        padding: 15px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        font-weight: 600;
        color: #64748b;
    }

        .decision-label:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
        }

    .decision-option:checked + .decision-label {
        background-color: #e0f2fe;
        border-color: #00aeef;
        color: #00aeef;
        box-shadow: 0 4px 10px rgba(0, 174, 239, 0.2);
    }

    .decision-option[value="Reject"]:checked + .decision-label {
        background-color: #fee2e2;
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
    }

    .range-wrap {
        position: relative;
        margin: 0 auto 1rem;
    }

    .range {
        width: 100%;
        cursor: pointer;
    }

    .score-display {
        font-size: 2.5rem;
        font-weight: 800;
        color: #00aeef;
        text-align: center;
        display: block;
        margin-bottom: 10px;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Bildiri Değerlendirme</h4>
            <p class="text-muted small mb-0">Lütfen çalışmayı objektif kriterlere göre değerlendiriniz.</p>
        </div>
        <a href="@Url.Action("Index", "Review")" class="btn btn-outline-secondary rounded-pill px-4 btn-sm fw-bold">
            <i class="fas fa-arrow-left me-2"></i> Listeye Dön
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-7">
            <div class="submission-info-card p-4 p-md-5 mb-4">

                <span class="badge bg-light text-primary border mb-3">#REF-@Model.Id.ToString("D8")</span>

                <h4 class="fw-bold text-dark mb-4">@Model.SubmissionTitle</h4>

                <h6 class="text-uppercase text-muted small fw-bold mb-2 ls-1">Özet Metni</h6>
                <div class="abstract-box mb-5">
                    @Model.SubmissionAbstract
                </div>

                <h6 class="text-uppercase text-muted small fw-bold mb-3 ls-1">Ekli Dosyalar</h6>
                @if (Model.Files != null && Model.Files.Any())
                {
                    <div class="row g-3">
                        @foreach (var file in Model.Files)
                        {
                            <div class="col-md-6">
                                <a href="@file.FilePath" target="_blank" class="text-decoration-none">
                                    <div class="p-3 border rounded-3 bg-light d-flex align-items-center hover-shadow transition">
                                        <div class="bg-white p-2 rounded shadow-sm me-3 text-danger">
                                            <i class="fas fa-file-pdf fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate">@file.FileName</div>
                                            <small class="text-muted">Görüntülemek için tıklayın</small>
                                        </div>
                                        <i class="fas fa-download text-muted ms-2"></i>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning border-0 small bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i> Bu bildiride indirilebilir dosya bulunmamaktadır.
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="evaluation-card">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold m-0"><i class="fas fa-gavel text-primary me-2"></i> Hakem Kararı</h5>
                </div>

                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                            <i class="fas fa-times-circle me-2"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="Evaluate" method="post">
                        <input type="hidden" name="ReviewAssignmentId" value="@Model.Id" />

                        <div class="mb-5 text-center">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-3">Genel Puan (0-100)</label>

                            <span id="scoreValue" class="score-display">85</span>

                            <input type="range" class="form-range range" name="Score" id="scoreRange" min="0" max="100" value="85" oninput="updateScore(this.value)">
                            <div class="d-flex justify-content-between text-muted small px-1">
                                <span>0 (Zayıf)</span>
                                <span>100 (Mükemmel)</span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-3">Kararınız</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_accept" value="Accept" required>
                                    <label class="decision-label" for="rec_accept">
                                        <i class="fas fa-check-circle d-block fs-4 mb-2"></i> Kabul
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_reject" value="Reject">
                                    <label class="decision-label" for="rec_reject">
                                        <i class="fas fa-times-circle d-block fs-4 mb-2"></i> Red
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_minor" value="MinorRevision">
                                    <label class="decision-label" for="rec_minor">
                                        <i class="fas fa-edit d-block fs-4 mb-2"></i> Küçük Düzeltme
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_major" value="MajorRevision">
                                    <label class="decision-label" for="rec_major">
                                        <i class="fas fa-sync-alt d-block fs-4 mb-2"></i> Büyük Düzeltme
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Yazara Notlar</label>
                            <textarea name="CommentsToAuthor" class="form-control bg-light" rows="6"
                                      placeholder="Çalışmanın güçlü ve zayıf yönlerini, varsa düzeltme taleplerinizi buraya yazınız..."
                                      style="border-radius: 12px; border: 1px solid #e2e8f0; resize: none;" required></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-3 fw-bold rounded-pill shadow-lg" onclick="return confirm('Bu değerlendirmeyi göndermek istediğinize emin misiniz?');">
                                <i class="fas fa-paper-plane me-2"></i> Raporu Tamamla
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function updateScore(val) {
        document.getElementById('scoreValue').innerText = val;

        var scoreDisplay = document.getElementById('scoreValue');
        if(val < 50) scoreDisplay.style.color = '#ef4444';
        else if(val < 70) scoreDisplay.style.color = '#f59e0b';
        else scoreDisplay.style.color = '#00aeef';
    }
</script>
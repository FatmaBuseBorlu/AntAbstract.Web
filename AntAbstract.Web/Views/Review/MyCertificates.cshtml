@model AntAbstract.Application.DTOs.Review.ReviewAssignmentDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@Localizer["PageTitle"] - @Model.SubmissionTitle</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        body {
            background: #525659;
            margin: 0;
            padding: 0;
            font-family: 'Roboto', sans-serif;
            display: flex;
            justify-content: center;
            padding-top: 40px;
            padding-bottom: 40px;
        }

        .certificate-container {
            width: 297mm;
            height: 210mm;
            background: #fff;
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            padding: 15mm;
            box-sizing: border-box;
            background-image: url('https://www.transparenttextures.com/patterns/cream-paper.png');
        }

        .border-pattern {
            position: absolute;
            top: 10mm;
            left: 10mm;
            right: 10mm;
            bottom: 10mm;
            border: 2px solid #1e293b;
            padding: 5px;
        }

        .border-inner {
            border: 1px solid #c0a062;
            height: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .corner {
            position: absolute;
            width: 40px;
            height: 40px;
            border-color: #c0a062;
            border-style: solid;
        }

        .tl {
            top: -1px;
            left: -1px;
            border-width: 4px 0 0 4px;
        }

        .tr {
            top: -1px;
            right: -1px;
            border-width: 4px 4px 0 0;
        }

        .bl {
            bottom: -1px;
            left: -1px;
            border-width: 0 0 4px 4px;
        }

        .br {
            bottom: -1px;
            right: -1px;
            border-width: 0 4px 4px 0;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            color: #1e293b;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            margin-top: 0;
        }

        .subtitle {
            font-size: 1.2rem;
            color: #c0a062;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .content-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #444;
            max-width: 80%;
            margin-bottom: 40px;
        }

        .highlight {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1.8rem;
            color: #000;
            display: block;
            margin: 20px 0;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
        }

        .congress-name {
            font-weight: bold;
            color: #00aeef;
        }

        .signatures {
            display: flex;
            justify-content: space-around;
            width: 80%;
            margin-top: 40px;
        }

        .sig-block {
            text-align: center;
        }

        .sig-line {
            width: 200px;
            border-top: 1px solid #333;
            margin-bottom: 10px;
            margin-top: 40px;
        }

        .sig-name {
            font-weight: bold;
        }

        .sig-title {
            font-size: 0.8rem;
            color: #666;
            font-style: italic;
        }

        @@media print {
            body {
                background: none;
                padding: 0;
            }

            .certificate-container {
                box-shadow: none;
                width: 100%;
                height: 100%;
                page-break-after: always;
            }

            @@page {
                size: A4 landscape;
                margin: 0;
            }
        }

        .seal {
            position: absolute;
            bottom: 40px;
            width: 120px;
            height: 120px;
            border: 3px solid #c0a062;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #c0a062;
            font-weight: bold;
            opacity: 0.3;
            transform: rotate(-15deg);
            font-family: 'Playfair Display', serif;
            font-size: 0.9rem;
            text-align: center;
            pointer-events: none;
        }
    </style>
</head>
<body>

    <div class="certificate-container">
        <div class="border-pattern">
            <div class="border-inner">
                <div class="corner tl"></div><div class="corner tr"></div>
                <div class="corner bl"></div><div class="corner br"></div>

                <div style="margin-top: 30px;">
                    <img src="/images/logo.png" alt="@Localizer["LogoAlt"]" style="height: 50px; margin-bottom: 20px; opacity: 0.8;" onerror="this.style.display='none'">
                </div>

                <h1>@Localizer["CertificateTitle"]</h1>
                <div class="subtitle">@Localizer["CertificateSubtitle"]</div>

                <div class="content-text">
                    @Localizer["ContentTextPart1"]
                    <span class="highlight">@(ViewBag.ReviewerName ?? Localizer["ReviewerFallbackName"].Value)</span>

                    <span class="congress-name">@Model.ConferenceName</span>
                    @Localizer["ContentTextPart2"]
                    <strong>"@Model.SubmissionTitle"</strong>
                    @Localizer["ContentTextPart3"]
                </div>

                <div style="font-size: 0.9rem; color: #888;">
                    @Localizer["EvaluationDateLabel"]:
                    @(Model.EvaluationDate?.ToString("dd MMMM yyyy") ?? DateTime.Now.ToString("dd MMMM yyyy"))

                    <br> @Localizer["DocumentNumberLabel"]: REF-@Model.Id.ToString("D8")
                </div>

                <div class="signatures">
                    <div class="sig-block">
                        <div class="sig-line"></div>
                        <div class="sig-name">Prof. Dr. Mehmet Yılmaz</div>
                        <div class="sig-title">@Localizer["CongressChairTitle"]</div>
                    </div>
                    <div class="sig-block">
                        <div class="sig-line"></div>
                        <div class="sig-name">Doç. Dr. Ayşe Demir</div>
                        <div class="sig-title">@Localizer["ScientificCommitteeChairTitle"]</div>
                    </div>
                </div>

                <div class="seal">
                    @Localizer["SealLine1"]<br>@Localizer["SealLine2"]<br>@Localizer["SealLine3"]
                </div>

            </div>
        </div>
    </div>

    <script>
        window.onload = function() {

        };
    </script>
</body>
</html>
@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Routing
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";
    var conferenceTitle = Context.Session.GetString("SelectedConferenceTitle") ?? "";

    var postUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Conflicts"
        : $"/{slug}/Review/Conflicts";

    var conflictInstitutions = ViewBag.ConflictInstitutions as List<string> ?? new List<string>();
    var conflictPeople = ViewBag.ConflictPeople as List<string> ?? new List<string>();

    var conflictInstitutionsText = string.Join(", ", conflictInstitutions);
    var conflictPeopleText = string.Join(", ", conflictPeople);
}

<style>
    .review-settings-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 780px;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .settings-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .settings-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .settings-card-title {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0 0 0.25rem;
        display: flex;
        align-items: center;
    }

    .settings-card-title i {
        color: #00aeef;
    }

    .settings-card-subtitle {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.55;
        margin-bottom: 0;
    }

    .settings-card-body {
        padding: 1.35rem;
    }

    .review-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        border: none;
        border-radius: 18px;
        font-weight: 850;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.045);
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        background: rgba(245, 158, 11, 0.10);
        border: 1px solid rgba(245, 158, 11, 0.20);
        border-radius: 22px;
        padding: 1rem 1.1rem;
        color: #475569;
        font-size: 0.92rem;
        font-weight: 650;
        line-height: 1.65;
        margin-bottom: 1.4rem;
    }

    .warning-box-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 16px;
        background: #ffffff;
        color: #f59e0b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        font-size: 1.1rem;
    }

    .warning-box-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 0.18rem;
    }

    .conflict-section-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 1.25rem;
        height: 100%;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.035);
    }

    .conflict-section-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
    }

    .conflict-section-title i {
        color: #00aeef;
    }

    .conflict-input-group {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        background: #f8fafc;
        margin-bottom: 1rem;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.035);
    }

    .conflict-input-group .form-control {
        min-height: 54px;
        border: none;
        background: transparent;
        padding: 1rem 1.1rem;
        color: #334155;
        font-size: 0.92rem;
        font-weight: 750;
        box-shadow: none;
    }

    .conflict-input-group .form-control::placeholder {
        color: #94a3b8;
        font-weight: 650;
    }

    .conflict-input-group .form-control:focus {
        background: #ffffff;
        box-shadow: none;
    }

    .conflict-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .conflict-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 0.9rem 1rem;
    }

    .conflict-name {
        color: #334155;
        font-weight: 950;
    }

    .conflict-note {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 750;
        margin-top: 0.15rem;
        line-height: 1.45;
    }

    .save-btn {
        min-height: 46px;
        border: none;
        border-radius: 999px;
        padding: 0 1.25rem;
        color: #ffffff;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        font-size: 0.88rem;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.18);
        transition: all 0.2s ease;
    }

    .save-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 18px 34px rgba(13, 110, 253, 0.26);
    }

    .coming-soon-box {
        margin-top: 1.4rem;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 1rem;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 750;
        line-height: 1.6;
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .review-settings-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-title {
            font-size: 1.45rem;
        }

        .settings-card-body {
            padding: 1.1rem;
        }

        .warning-box {
            flex-direction: column;
        }

        .save-btn {
            width: 100%;
        }
    }
</style>

<div class="review-settings-page">

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-handshake-slash"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("HeaderTitle", "Çıkar Çatışmaları")
                </h3>

                <p class="program-lead">
                    @L("PageDescription", "Tarafsız değerlendirme yapamayacağınız kişi veya kurumları buradan belirleyebilirsiniz.")
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(conferenceTitle))
        {
            <div class="program-conference-pill">
                <i class="fas fa-calendar-check"></i>
                <span>@conferenceTitle</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(slug))
        {
            <div class="program-conference-pill">
                <i class="fas fa-link"></i>
                <span>/@slug</span>
            </div>
        }
    </div>

    <div class="settings-card">
        <div class="settings-card-header">
            <h5 class="settings-card-title">
                <i class="fas fa-shield-alt me-2"></i>
                @L("ConflictCardTitle", "Çıkar Çatışması Bildirimi")
            </h5>

            <p class="settings-card-subtitle">
                @L("ConflictCardSubtitle", "Bu bilgiler değerlendirme atamalarında etik uyumluluk için kullanılabilir.")
            </p>
        </div>

        <div class="settings-card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success review-alert mb-4">
                    <i class="fas fa-check-circle"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger review-alert mb-4">
                    <i class="fas fa-times-circle"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="warning-box">
                <div class="warning-box-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>

                <div>
                    <div class="warning-box-title">
                        @L("AlertTitle", "Etik değerlendirme için önemli")
                    </div>

                    <div>
                        @L("AlertDescription", "Aynı kurumdan olduğunuz, ortak yayın yaptığınız veya tarafsız değerlendirme yapamayacağınız kişi ve kurumları belirtmeniz önerilir.")
                    </div>
                </div>
            </div>

            <form action="@postUrl" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="conflict-section-card">
                            <h6 class="conflict-section-title">
                                <i class="fas fa-university me-2"></i>
                                @L("InstitutionRestrictionTitle", "Kurum Kısıtları")
                            </h6>

                            <div class="input-group conflict-input-group">
                                <input type="text"
                                       name="conflictInstitutions"
                                       value="@conflictInstitutionsText"
                                       class="form-control"
                                       placeholder="@L("InstitutionPlaceholder", "Örn: Akdeniz Üniversitesi, X Kurumu")" />
                            </div>

                            <div class="conflict-list">
                                @if (conflictInstitutions.Any())
                                {
                                    foreach (var institution in conflictInstitutions)
                                    {
                                        <div class="conflict-item">
                                            <div>
                                                <div class="conflict-name">
                                                    @institution
                                                </div>

                                                <div class="conflict-note">
                                                    @L("InstitutionSavedNote", "Kurum atama kontrolünde dikkate alınır")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="conflict-item">
                                        <div class="conflict-note">
                                            @L("NoInstitutionConflictText", "Kayıtlı kurum kısıtı yok.")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="conflict-section-card">
                            <h6 class="conflict-section-title">
                                <i class="fas fa-user-friends me-2"></i>
                                @L("PersonRestrictionTitle", "Kişi Kısıtları")
                            </h6>

                            <div class="input-group conflict-input-group">
                                <input type="text"
                                       name="conflictPeople"
                                       value="@conflictPeopleText"
                                       class="form-control"
                                       placeholder="@L("PersonPlaceholder", "Örn: Prof. Dr. Ayşe Yılmaz, Mehmet Demir")" />
                            </div>

                            <div class="conflict-list">
                                @if (conflictPeople.Any())
                                {
                                    foreach (var person in conflictPeople)
                                    {
                                        <div class="conflict-item">
                                            <div>
                                                <div class="conflict-name">
                                                    @person
                                                </div>

                                                <div class="conflict-note">
                                                    @L("PersonSavedNote", "Kişi atama kontrolünde dikkate alınır")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="conflict-item">
                                        <div class="conflict-note">
                                            @L("NoPersonConflictText", "Kayıtlı kişi kısıtı yok.")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit" class="save-btn">
                        <i class="fas fa-save"></i>
                        @L("SaveButton", "Kaydet")
                    </button>
                </div>
            </form>

            <div class="coming-soon-box">
                <i class="fas fa-circle-info me-2 text-primary"></i>
                @L("ConflictHelpText", "Birden fazla kişi veya kurumu virgülle ayırarak yazabilirsiniz. Boş bırakırsanız kayıt temizlenir.")
            </div>
        </div>
    </div>
</div>
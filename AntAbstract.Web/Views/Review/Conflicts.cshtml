@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Routing
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";

    var postUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Conflicts"
        : $"/{slug}/Review/Conflicts";

    var conflictInstitutions = ViewBag.ConflictInstitutions as List<string> ?? new List<string>();
    var conflictPeople = ViewBag.ConflictPeople as List<string> ?? new List<string>();

    var conflictInstitutionsText = string.Join(", ", conflictInstitutions);
    var conflictPeopleText = string.Join(", ", conflictPeople);
}

<style>
    .review-settings-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 1.25rem 1.5rem 4rem;
    }

    .settings-hero {
        background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.18), transparent 34%), linear-gradient(135deg, #ffffff 0%, #fffaf2 100%);
        border: 1px solid #f1e4cf;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.055);
        margin-bottom: 1.5rem;
    }

    .settings-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 280px;
        flex: 1;
    }

    .settings-hero-icon {
        width: 66px;
        height: 66px;
        min-width: 66px;
        border-radius: 24px;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 16px 32px rgba(245, 158, 11, 0.22);
    }

    .settings-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .settings-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 1.8rem;
        font-weight: 950;
        letter-spacing: -0.045em;
        line-height: 1.15;
    }

    .settings-description {
        margin: 0;
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        line-height: 1.6;
    }

    .settings-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.065);
        overflow: hidden;
    }

    .settings-card-header {
        padding: 1.25rem 1.45rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .settings-card-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .settings-card-subtitle {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        margin-bottom: 0;
    }

    .settings-card-body {
        padding: 1.5rem;
    }

    .warning-box {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        background: rgba(245, 158, 11, 0.11);
        border: 1px solid rgba(245, 158, 11, 0.20);
        border-radius: 22px;
        padding: 1rem 1.1rem;
        color: #475569;
        font-weight: 650;
        line-height: 1.65;
        margin-bottom: 1.5rem;
    }

    .warning-box-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 16px;
        background: #ffffff;
        color: #f59e0b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        font-size: 1.1rem;
    }

    .warning-box-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.15rem;
    }

    .conflict-section-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 1.25rem;
        height: 100%;
    }

    .conflict-section-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 1rem;
    }

    .conflict-input-group {
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        overflow: hidden;
        background: #f8fafc;
        margin-bottom: 1rem;
    }

    .conflict-input-group .form-control {
        border: none;
        background: transparent;
        padding: 0.9rem 1rem;
        font-weight: 700;
        box-shadow: none;
    }

    .conflict-input-group .form-control:focus {
        background: #ffffff;
        box-shadow: none;
    }

    .conflict-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .conflict-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 0.9rem 1rem;
    }

    .conflict-name {
        color: #334155;
        font-weight: 950;
    }

    .conflict-note {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 700;
        margin-top: 0.15rem;
    }

    .coming-soon-box {
        margin-top: 1.5rem;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 1rem;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 700;
        line-height: 1.6;
    }

    @@media (max-width: 768px) {
        .review-settings-page {
            padding: 1rem 1rem 3rem;
        }

        .settings-hero-left {
            flex-direction: column;
            align-items: flex-start;
            min-width: 100%;
        }

        .settings-title {
            font-size: 1.45rem;
        }
    }
</style>

<div class="review-settings-page">

    <div class="settings-hero">
        <div class="settings-hero-left">
            <div class="settings-hero-icon">
                <i class="fas fa-handshake-slash"></i>
            </div>

            <div>
                <div class="settings-kicker">
                    @L("HeaderKicker", "Hakem Profili")
                </div>

                <h1 class="settings-title">
                    @L("HeaderTitle", "Çıkar Çatışmaları")
                </h1>

                <p class="settings-description">
                    @L("PageDescription", "Tarafsız değerlendirme yapamayacağınız kişi veya kurumları buradan belirleyebilirsiniz.")
                </p>
            </div>
        </div>
    </div>

    <div class="settings-card">
        <div class="settings-card-header">
            <h5 class="settings-card-title">
                <i class="fas fa-shield-alt text-warning me-2"></i>
                @L("ConflictCardTitle", "Çıkar Çatışması Bildirimi")
            </h5>

            <p class="settings-card-subtitle">
                @L("ConflictCardSubtitle", "Bu bilgiler değerlendirme atamalarında etik uyumluluk için kullanılabilir.")
            </p>
        </div>

        <div class="settings-card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-3 border-0 shadow-sm mb-4">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                    <i class="fas fa-times-circle me-2"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="warning-box">
                <div class="warning-box-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>

                <div>
                    <div class="warning-box-title">
                        @L("AlertTitle", "Etik değerlendirme için önemli")
                    </div>

                    <div>
                        @L("AlertDescription", "Aynı kurumdan olduğunuz, ortak yayın yaptığınız veya tarafsız değerlendirme yapamayacağınız kişi ve kurumları belirtmeniz önerilir.")
                    </div>
                </div>
            </div>

            <form action="@postUrl" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="conflict-section-card">
                            <h6 class="conflict-section-title text-primary">
                                <i class="fas fa-university me-2"></i>
                                @L("InstitutionRestrictionTitle", "Kurum Kısıtları")
                            </h6>

                            <div class="input-group conflict-input-group">
                                <input type="text"
                                       name="conflictInstitutions"
                                       value="@conflictInstitutionsText"
                                       class="form-control"
                                       placeholder="@L("InstitutionPlaceholder", "Örn: Akdeniz Üniversitesi, X Kurumu")" />
                            </div>

                            <div class="conflict-list">
                                @if (conflictInstitutions.Any())
                                {
                                    foreach (var institution in conflictInstitutions)
                                    {
                                        <div class="conflict-item">
                                            <div>
                                                <div class="conflict-name">
                                                    @institution
                                                </div>

                                                <div class="conflict-note">
                                                    @L("InstitutionSavedNote", "Kurum atama kontrolünde dikkate alınır")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="conflict-item">
                                        <div class="conflict-note">
                                            @L("NoInstitutionConflictText", "Kayıtlı kurum kısıtı yok.")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="conflict-section-card">
                            <h6 class="conflict-section-title text-success">
                                <i class="fas fa-user-friends me-2"></i>
                                @L("PersonRestrictionTitle", "Kişi Kısıtları")
                            </h6>

                            <div class="input-group conflict-input-group">
                                <input type="text"
                                       name="conflictPeople"
                                       value="@conflictPeopleText"
                                       class="form-control"
                                       placeholder="@L("PersonPlaceholder", "Örn: Prof. Dr. Ayşe Yılmaz, Mehmet Demir")" />
                            </div>

                            <div class="conflict-list">
                                @if (conflictPeople.Any())
                                {
                                    foreach (var person in conflictPeople)
                                    {
                                        <div class="conflict-item">
                                            <div>
                                                <div class="conflict-name">
                                                    @person
                                                </div>

                                                <div class="conflict-note">
                                                    @L("PersonSavedNote", "Kişi atama kontrolünde dikkate alınır")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="conflict-item">
                                        <div class="conflict-note">
                                            @L("NoPersonConflictText", "Kayıtlı kişi kısıtı yok.")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit" class="btn btn-warning rounded-pill fw-bold px-4 py-2">
                        <i class="fas fa-save me-2"></i>
                        @L("SaveButton", "Kaydet")
                    </button>
                </div>
            </form>

            <div class="coming-soon-box">
                <i class="fas fa-circle-info me-2 text-primary"></i>
                @L("ConflictHelpText", "Birden fazla kişi veya kurumu virgülle ayırarak yazabilirsiniz. Boş bırakırsanız kayıt temizlenir.")
            </div>
        </div>
    </div>
</div>
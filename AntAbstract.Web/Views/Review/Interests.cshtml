@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Routing
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";

    var postUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Interests"
        : $"/{slug}/Review/Interests";

    var expertiseAreas = ViewBag.ExpertiseAreas as List<string> ?? new List<string>();
    var expertiseAreasText = string.Join(", ", expertiseAreas);
}

<style>
    .review-settings-page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1.25rem 1.5rem 4rem;
    }

    .settings-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.055);
        margin-bottom: 1.5rem;
    }

    .settings-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 280px;
        flex: 1;
    }

    .settings-hero-icon {
        width: 66px;
        height: 66px;
        min-width: 66px;
        border-radius: 24px;
        background: linear-gradient(135deg, #00aeef, #2563eb);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 16px 32px rgba(0, 174, 239, 0.22);
    }

    .settings-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .settings-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 1.8rem;
        font-weight: 950;
        letter-spacing: -0.045em;
        line-height: 1.15;
    }

    .settings-description {
        margin: 0;
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        line-height: 1.6;
    }

    .settings-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.065);
        overflow: hidden;
    }

    .settings-card-header {
        padding: 1.25rem 1.45rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .settings-card-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .settings-card-subtitle {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        margin-bottom: 0;
    }

    .settings-card-body {
        padding: 1.5rem;
    }

    .info-box {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        background: rgba(0, 174, 239, 0.08);
        border: 1px solid rgba(0, 174, 239, 0.15);
        border-radius: 22px;
        padding: 1rem 1.1rem;
        color: #475569;
        font-weight: 650;
        line-height: 1.65;
        margin-bottom: 1.5rem;
    }

    .info-box-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 16px;
        background: #ffffff;
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        font-size: 1.1rem;
    }

    .info-box-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.15rem;
    }

    .form-label-custom {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.65rem;
    }

    .expertise-input-group {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        background: #f8fafc;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.045);
    }

    .expertise-input-group .form-control {
        border: none;
        background: transparent;
        padding: 1rem 1.1rem;
        font-weight: 700;
        color: #334155;
        box-shadow: none;
    }

    .expertise-input-group .form-control:focus {
        background: #ffffff;
        box-shadow: none;
    }

    .expertise-input-group .btn {
        border-radius: 0;
        padding-inline: 1.25rem;
        font-weight: 950;
    }

    .section-divider {
        border-color: #e2e8f0;
        margin: 1.7rem 0;
    }

    .expertise-list-title {
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.055em;
        margin-bottom: 1rem;
    }

    .expertise-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: #ffffff;
        color: #0f172a;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 0.65rem 0.85rem;
        font-size: 0.88rem;
        font-weight: 850;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.045);
        transition: all 0.2s ease;
    }

    .expertise-badge:hover {
        border-color: rgba(0, 174, 239, 0.35);
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(0, 174, 239, 0.10);
    }

    .expertise-hash {
        color: #00aeef;
        font-weight: 950;
    }

    .expertise-remove {
        color: #ef4444;
        cursor: pointer;
        opacity: 0.75;
        transition: all 0.2s ease;
    }

    .expertise-remove:hover {
        opacity: 1;
        transform: scale(1.12);
    }

    .coming-soon-box {
        margin-top: 1.5rem;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 1rem;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 700;
        line-height: 1.6;
    }

    @@media (max-width: 768px) {
        .review-settings-page {
            padding: 1rem 1rem 3rem;
        }

        .settings-hero-left {
            flex-direction: column;
            align-items: flex-start;
            min-width: 100%;
        }

        .settings-title {
            font-size: 1.45rem;
        }

        .expertise-input-group {
            display: block;
        }

        .expertise-input-group .btn {
            width: 100%;
            border-radius: 0;
            padding: 0.9rem;
        }
    }
</style>

<div class="review-settings-page">

    <div class="settings-hero">
        <div class="settings-hero-left">
            <div class="settings-hero-icon">
                <i class="fas fa-tags"></i>
            </div>

            <div>
                <div class="settings-kicker">
                    @L("HeaderKicker", "Hakem Profili")
                </div>

                <h1 class="settings-title">
                    @L("HeaderTitle", "Uzmanlık Alanlarım")
                </h1>

                <p class="settings-description">
                    @L("PageDescription", "Değerlendirme yapabileceğiniz akademik ve teknik alanları buradan tanımlayabilirsiniz.")
                </p>
            </div>
        </div>
    </div>

    <div class="settings-card">
        <div class="settings-card-header">
            <h5 class="settings-card-title">
                <i class="fas fa-layer-group text-primary me-2"></i>
                @L("ExpertiseCardTitle", "Uzmanlık Bilgileri")
            </h5>

            <p class="settings-card-subtitle">
                @L("ExpertiseCardSubtitle", "Bu bilgiler ileride hakem atama sürecinde doğru eşleşme yapmak için kullanılabilir.")
            </p>
        </div>

        <div class="settings-card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-3 border-0 shadow-sm mb-4">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                    <i class="fas fa-times-circle me-2"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="info-box">
                <div class="info-box-icon">
                    <i class="fas fa-info-circle"></i>
                </div>

                <div>
                    <div class="info-box-title">
                        @L("WhyImportantTitle", "Neden önemli?")
                    </div>

                    <div>
                        @L("WhyImportantText", "Uzmanlık alanlarınız, size atanacak bildirilerin çalışma konunuzla daha uyumlu seçilmesine yardımcı olur.")
                    </div>
                </div>
            </div>

            <label class="form-label-custom">
                @L("AddExpertiseLabel", "Yeni uzmanlık alanı ekle")
            </label>

            <form action="@postUrl" method="post">
                @Html.AntiForgeryToken()

                <div class="input-group expertise-input-group mb-4">
                    <input type="text"
                           class="form-control"
                           name="expertiseAreas"
                           value="@expertiseAreasText"
                           placeholder="@L("AddExpertisePlaceholder", "Örn: Makine öğrenmesi, doğal dil işleme, sağlık bilişimi...")" />

                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-save me-2"></i>
                        @L("SaveButton", "Kaydet")
                    </button>
                </div>
            </form>

            <hr class="section-divider" />

            <div class="expertise-list-title">
                @L("SavedExpertiseTitle", "Kayıtlı uzmanlık alanları")
            </div>

            @if (expertiseAreas.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var area in expertiseAreas)
                    {
                        <span class="expertise-badge">
                            <span class="expertise-hash">#</span>
                            @area
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="coming-soon-box">
                    <i class="fas fa-circle-info me-2 text-primary"></i>
                    @L("NoExpertiseText", "Henüz uzmanlık alanı eklenmedi. Alanları virgülle ayırarak yukarıdaki kutudan kaydedebilirsiniz.")
                </div>
            }

            <div class="coming-soon-box">
                <i class="fas fa-check-circle me-2 text-success"></i>
                @L("SavedNotice", "Bu bilgiler hakem öneri ve atama ekranlarında kullanılmak üzere profilinize kaydedilir.")
            </div>
        </div>
    </div>
</div>
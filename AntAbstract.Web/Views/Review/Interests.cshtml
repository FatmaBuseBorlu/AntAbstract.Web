@using System
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Routing
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var loc = Localizer.GetString(key);
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";
    var conferenceTitle = Context.Session.GetString("SelectedConferenceTitle") ?? "";

    var postUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Interests"
        : $"/{slug}/Review/Interests";

    var expertiseAreas = ViewBag.ExpertiseAreas as List<string> ?? new List<string>();
    var expertiseAreasText = string.Join(", ", expertiseAreas);
}

<style>
    .review-settings-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 780px;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .settings-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .settings-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .settings-card-title {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .settings-card-title i {
        color: #00aeef;
    }

    .settings-card-subtitle {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.55;
        margin: 0.25rem 0 0;
    }

    .settings-card-body {
        padding: 1.35rem;
    }

    .review-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        border: none;
        border-radius: 18px;
        font-weight: 850;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.045);
    }

    .info-box {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        background: rgba(0, 174, 239, 0.08);
        border: 1px solid rgba(0, 174, 239, 0.16);
        border-radius: 22px;
        padding: 1rem 1.1rem;
        color: #475569;
        font-size: 0.92rem;
        font-weight: 650;
        line-height: 1.65;
        margin-bottom: 1.4rem;
    }

    .info-box-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 16px;
        background: #ffffff;
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        font-size: 1.1rem;
    }

    .info-box-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 0.18rem;
    }

    .form-label-custom {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.65rem;
    }

    .expertise-input-group {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        background: #f8fafc;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
    }

    .expertise-input-group .form-control {
        min-height: 56px;
        border: none;
        background: transparent;
        padding: 1rem 1.1rem;
        color: #334155;
        font-size: 0.94rem;
        font-weight: 750;
        box-shadow: none;
    }

    .expertise-input-group .form-control::placeholder {
        color: #94a3b8;
        font-weight: 650;
    }

    .expertise-input-group .form-control:focus {
        background: #ffffff;
        box-shadow: none;
    }

    .expertise-input-group .btn {
        border: none;
        border-radius: 0;
        padding-inline: 1.35rem;
        font-weight: 950;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        box-shadow: none;
    }

    .section-divider {
        border-color: #e2e8f0;
        margin: 1.7rem 0;
        opacity: 1;
    }

    .expertise-list-title {
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.055em;
        margin-bottom: 1rem;
    }

    .expertise-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: #ffffff;
        color: #0f172a;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 0.65rem 0.85rem;
        font-size: 0.88rem;
        font-weight: 850;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.045);
        transition: all 0.2s ease;
    }

    .expertise-badge:hover {
        border-color: rgba(0, 174, 239, 0.35);
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(0, 174, 239, 0.10);
    }

    .expertise-hash {
        color: #00aeef;
        font-weight: 950;
    }

    .coming-soon-box {
        margin-top: 1.4rem;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        padding: 1rem;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 750;
        line-height: 1.6;
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .review-settings-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-title {
            font-size: 1.45rem;
        }

        .settings-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .settings-card-body {
            padding: 1.1rem;
        }

        .info-box {
            flex-direction: column;
        }

        .expertise-input-group {
            display: block;
        }

        .expertise-input-group .form-control {
            width: 100%;
        }

        .expertise-input-group .btn {
            width: 100%;
            min-height: 52px;
            border-radius: 0;
        }
    }
</style>

<div class="review-settings-page">

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-tags"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("HeaderTitle", "Uzmanlık Alanlarım")
                </h3>

                <p class="program-lead">
                    @L("PageDescription", "Değerlendirme yapabileceğiniz akademik ve teknik alanları buradan tanımlayabilirsiniz.")
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(conferenceTitle))
        {
            <div class="program-conference-pill">
                <i class="fas fa-calendar-check"></i>
                <span>@conferenceTitle</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(slug))
        {
            <div class="program-conference-pill">
                <i class="fas fa-link"></i>
                <span>/@slug</span>
            </div>
        }
    </div>

    <div class="settings-card">
        <div class="settings-card-header">
            <div>
                <h5 class="settings-card-title">
                    <i class="fas fa-layer-group me-2"></i>
                    @L("ExpertiseCardTitle", "Uzmanlık Bilgileri")
                </h5>

                <p class="settings-card-subtitle">
                    @L("ExpertiseCardSubtitle", "Bu bilgiler ileride hakem atama sürecinde doğru eşleşme yapmak için kullanılabilir.")
                </p>
            </div>
        </div>

        <div class="settings-card-body">


            <div class="info-box">
                <div class="info-box-icon">
                    <i class="fas fa-info-circle"></i>
                </div>

                <div>
                    <div class="info-box-title">
                        @L("WhyImportantTitle", "Neden önemli?")
                    </div>

                    <div>
                        @L("WhyImportantText", "Uzmanlık alanlarınız, size atanacak bildirilerin çalışma konunuzla daha uyumlu seçilmesine yardımcı olur.")
                    </div>
                </div>
            </div>

            <label class="form-label-custom">
                @L("AddExpertiseLabel", "Yeni uzmanlık alanı ekle")
            </label>

            <form action="@postUrl" method="post">
                @Html.AntiForgeryToken()

                <div class="input-group expertise-input-group mb-4">
                    <input type="text"
                           class="form-control"
                           name="expertiseAreas"
                           value="@expertiseAreasText"
                           placeholder="@L("AddExpertisePlaceholder", "Örn: Makine öğrenmesi, doğal dil işleme, sağlık bilişimi...")" />

                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-save me-2"></i>
                        @L("SaveButton", "Kaydet")
                    </button>
                </div>
            </form>

            <hr class="section-divider" />

            <div class="expertise-list-title">
                @L("SavedExpertiseTitle", "Kayıtlı uzmanlık alanları")
            </div>

            @if (expertiseAreas.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var area in expertiseAreas)
                    {
                        <span class="expertise-badge">
                            <span class="expertise-hash">#</span>
                            @area
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="coming-soon-box">
                    <i class="fas fa-circle-info me-2 text-primary"></i>
                    @L("NoExpertiseText", "Henüz uzmanlık alanı eklenmedi. Alanları virgülle ayırarak yukarıdaki kutudan kaydedebilirsiniz.")
                </div>
            }

            <div class="coming-soon-box">
                <i class="fas fa-check-circle me-2 text-success"></i>
                @L("SavedNotice", "Bu bilgiler hakem öneri ve atama ekranlarında kullanılmak üzere profilinize kaydedilir.")
            </div>
        </div>
    </div>
</div>
@using AntAbstract.Application.DTOs.Review
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Routing
@using System
@using System.Collections.Generic
@using System.Linq

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@model List<ReviewAssignmentDto>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var loc = Localizer.GetString(key);
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    var assignments = Model ?? new List<ReviewAssignmentDto>();

    var pendingList = assignments
        .Where(x => !x.IsReviewed)
        .OrderBy(x => x.AssignedDate)
        .ToList();

    var completedList = assignments
        .Where(x => x.IsReviewed)
        .OrderByDescending(x => x.EvaluationDate)
        .ToList();

    var slug = ViewBag.Slug as string
        ?? Context.GetRouteValue("slug")?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var currentConferenceTitle = ViewBag.CurrentConferenceTitle as string
        ?? Context.Session.GetString("SelectedConferenceTitle")
        ?? "";

    var declinePostUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/DeclineAssignment"
        : $"/{slug}/Review/DeclineAssignment";

    var certificatesUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Certificates"
        : $"/{slug}/Certificates";

    string BuildEvaluateUrl(int assignmentId)
    {
        return string.IsNullOrWhiteSpace(slug)
            ? $"/Review/Evaluate/{assignmentId}"
            : $"/{slug}/Review/Evaluate/{assignmentId}";
    }

    string BuildCertificateUrl(int assignmentId)
    {
        return string.IsNullOrWhiteSpace(slug)
            ? $"/Review/DownloadCertificate/{assignmentId}"
            : $"/{slug}/Review/DownloadCertificate/{assignmentId}";
    }

    string ShortRef(object? value, int length = 6)
    {
        var text = value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(text))
        {
            return "------";
        }

        return text.Length <= length
            ? text.ToUpper()
            : text.Substring(0, length).ToUpper();
    }
}

<style>
    .review-index-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .review-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 18px;
        border: 1px solid transparent;
        font-weight: 800;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .review-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .review-alert-info {
        background: rgba(13, 110, 253, 0.10);
        border-color: rgba(13, 110, 253, 0.20);
        color: #0d6efd;
    }

    .review-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .review-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.15), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.45rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        margin-bottom: 1.5rem;
    }

    .review-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .review-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .review-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .review-page-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 1.85rem;
        font-weight: 950;
        letter-spacing: -0.045em;
        line-height: 1.2;
    }

    .review-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        line-height: 1.6;
    }

    .review-conference-pill {
        width: fit-content;
        margin-top: 0.6rem;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        border: 1px solid rgba(13, 110, 253, 0.14);
        font-size: 0.76rem;
        font-weight: 900;
    }

    .review-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .review-action-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .stat-box {
        background: #fff;
        border-radius: 16px;
        padding: 15px 20px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.045);
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #f1f5f9;
        min-width: 160px;
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .task-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 25px;
        transition: all 0.3s;
        height: 100%;
        display: flex;
        flex-direction: column;
        border-left: 5px solid #f59e0b;
        position: relative;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
    }

    .task-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08);
        border-color: #00aeef;
    }

    .nav-pills-custom .nav-link {
        color: #64748b;
        font-weight: 800;
        padding: 10px 20px;
        border-radius: 50px;
        transition: all 0.2s;
    }

    .nav-pills-custom .nav-link.active {
        background-color: #00aeef;
        color: white;
        box-shadow: 0 4px 10px rgba(0, 174, 239, 0.3);
    }

    .completed-table-card {
        border: none;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    }

    .review-btn-secondary {
        background: #f1f5f9;
        border: 1.5px solid #e2e8f0;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .review-btn-secondary:hover {
        border-color: #0d6efd;
        color: #0d6efd;
        background: rgba(13,110,253,0.06);
    }

    .review-btn-bidding:hover {
        border-color: #7c3aed !important;
        color: #7c3aed !important;
        background: rgba(124,58,237,0.06) !important;
    }

    /* Dashboard stat bar */
    .review-dashboard-bar {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
        align-items: stretch;
    }

    .review-stat-card {
        flex: 1;
        min-width: 120px;
        background: #fff;
        border: 1px solid #e8eef6;
        border-radius: 18px;
        padding: 0.9rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        box-shadow: 0 4px 14px rgba(15,23,42,0.05);
    }

    .rsc-urgent {
        border-color: rgba(239,68,68,0.35);
        background: rgba(239,68,68,0.04);
    }

    .rsc-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .rsc-blue   { background: rgba(13,110,253,0.12); color: #0d6efd; }
    .rsc-yellow { background: rgba(245,158,11,0.12); color: #b45309; }
    .rsc-green  { background: rgba(34,197,94,0.12);  color: #16a34a; }
    .rsc-orange { background: rgba(249,115,22,0.12); color: #ea580c; }
    .rsc-red    { background: rgba(239,68,68,0.12);  color: #dc2626; }

    .rsc-value {
        font-size: 1.25rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1.1;
    }

    .rsc-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    /* Progress card */
    .review-progress-card {
        flex: 2;
        min-width: 200px;
        background: #fff;
        border: 1px solid #e8eef6;
        border-radius: 18px;
        padding: 0.9rem 1.1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.4rem;
        box-shadow: 0 4px 14px rgba(15,23,42,0.05);
    }

    .rpc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .rpc-label {
        font-size: 0.72rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .rpc-pct {
        font-size: 1.1rem;
        font-weight: 900;
        color: #0f172a;
    }

    .rpc-track {
        height: 10px;
        border-radius: 999px;
        background: #f1f5f9;
        overflow: hidden;
    }

    .rpc-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #0d6efd, #00aeef);
        min-width: 4px;
        transition: width 0.6s ease;
    }

    .rpc-fill-done { background: linear-gradient(90deg, #16a34a, #22c55e); }

    .rpc-sub {
        font-size: 0.74rem;
        color: #94a3b8;
        font-weight: 650;
    }

    /* Tab count badge */
    .tab-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        border-radius: 999px;
        background: rgba(245,158,11,0.2);
        color: #b45309;
        font-size: 0.72rem;
        font-weight: 900;
        padding: 0 0.4rem;
        margin-left: 0.3rem;
    }

    /* Task card deadline chip */
    .task-deadline-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        height: 24px;
        border-radius: 999px;
        padding: 0 0.6rem;
        font-size: 0.72rem;
        font-weight: 800;
    }

    .tdc-gray   { background: rgba(148,163,184,0.15); color: #64748b; }
    .tdc-orange { background: rgba(249,115,22,0.12);  color: #ea580c; }
    .tdc-red    { background: rgba(239,68,68,0.12);   color: #dc2626; }

    .task-card-urgent  { border-left-color: #f97316; }
    .task-card-overdue { border-left-color: #ef4444; background: rgba(239,68,68,0.02); }

    .task-conf-label {
        font-size: 0.77rem;
        color: #64748b;
        font-weight: 650;
    }

    .task-topic-chip {
        display: inline-flex;
        align-items: center;
        height: 20px;
        border-radius: 999px;
        padding: 0 0.5rem;
        background: rgba(13,110,253,0.10);
        color: #1d4ed8;
        font-size: 0.7rem;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .review-hero-left {
            flex-direction: column;
            align-items: flex-start;
            min-width: 100%;
        }

        .review-hero-actions,
        .review-action-btn {
            width: 100%;
        }

        .review-page-title {
            font-size: 1.5rem;
        }

        .review-dashboard-bar { gap: 0.5rem; }
        .review-stat-card { min-width: calc(50% - 0.25rem); }
        .review-progress-card { min-width: 100%; }
    }
</style>

<div class="container-fluid px-4 py-4 review-index-page">




    <div class="review-hero-card">
        <div class="review-hero-left">
            <div class="review-hero-icon">
                <i class="fas fa-gavel"></i>
            </div>

            <div>
                <div class="review-section-label">
                    @L("SectionLabel", "Hakem Paneli")
                </div>

                <h2 class="review-page-title">
                    @Localizer["PageHeading"]
                </h2>

                <p class="review-page-description">
                    @Localizer["PageLead"]
                </p>

                @if (!string.IsNullOrWhiteSpace(currentConferenceTitle))
                {
                    <div class="review-conference-pill">
                        <i class="fas fa-calendar-check"></i>
                        @currentConferenceTitle
                    </div>
                }
            </div>
        </div>

        <div class="review-hero-actions">
            <a href="@(string.IsNullOrWhiteSpace(slug) ? "/Review/Bidding" : $"/{slug}/Review/Bidding")"
               class="btn review-action-btn review-btn-secondary review-btn-bidding" title="Bildiri Teklifleri">
                <i class="fas fa-hand-pointer"></i>
                <span class="d-none d-lg-inline">Teklifler</span>
            </a>
            <a href="@(string.IsNullOrWhiteSpace(slug) ? "/Review/Interests" : $"/{slug}/Review/Interests")"
               class="btn review-action-btn review-btn-secondary" title="@Localizer["UzmanlikAlanlari"]">
                <i class="fas fa-brain"></i>
                <span class="d-none d-lg-inline">@Localizer["Uzmanlik"]</span>
            </a>
            <a href="@(string.IsNullOrWhiteSpace(slug) ? "/Review/Conflicts" : $"/{slug}/Review/Conflicts")"
               class="btn review-action-btn review-btn-secondary" title="@Localizer["CikarCatismalari"]">
                <i class="fas fa-shield-halved"></i>
                <span class="d-none d-lg-inline">@Localizer["CikarCatismasi"]</span>
            </a>
            <a href="@certificatesUrl"
               class="btn btn-outline-primary review-action-btn">
                <i class="fas fa-certificate"></i>
                @L("MyCertificatesButton", "Sertifikalarım")
            </a>
        </div>
    </div>

    @{
        int totalAssignments = assignments.Count;
        int completedCount = completedList.Count;
        int pendingCount = pendingList.Count;
        int progressPct = totalAssignments > 0 ? (int)Math.Round(completedCount * 100.0 / totalAssignments) : 0;
        var nextDeadline = pendingList
            .Where(x => x.ReviewDeadline.HasValue)
            .OrderBy(x => x.ReviewDeadline)
            .FirstOrDefault()?.ReviewDeadline;
        int daysLeft = nextDeadline.HasValue ? (int)(nextDeadline.Value.Date - DateTime.Today).TotalDays : -1;
    }

    <div class="review-dashboard-bar mb-4">
        <div class="review-stat-card">
            <div class="rsc-icon rsc-blue"><i class="fas fa-list-check"></i></div>
            <div class="rsc-body">
                <div class="rsc-value">@totalAssignments</div>
                <div class="rsc-label">Toplam Atama</div>
            </div>
        </div>
        <div class="review-stat-card">
            <div class="rsc-icon rsc-yellow"><i class="fas fa-hourglass-half"></i></div>
            <div class="rsc-body">
                <div class="rsc-value">@pendingCount</div>
                <div class="rsc-label">Bekleyen</div>
            </div>
        </div>
        <div class="review-stat-card">
            <div class="rsc-icon rsc-green"><i class="fas fa-check-double"></i></div>
            <div class="rsc-body">
                <div class="rsc-value">@completedCount</div>
                <div class="rsc-label">Tamamlanan</div>
            </div>
        </div>
        @if (nextDeadline.HasValue)
        {
            <div class="review-stat-card @(daysLeft <= 3 ? "rsc-urgent" : "")">
                <div class="rsc-icon @(daysLeft <= 3 ? "rsc-red" : "rsc-orange")"><i class="fas fa-calendar-xmark"></i></div>
                <div class="rsc-body">
                    <div class="rsc-value">
                        @if (daysLeft < 0)
                        { <span class="text-danger">@Localizer["Gecti"]</span> }
                        else if (daysLeft == 0)
                        { <span class="text-danger">@Localizer["Bugun"]</span> }
                        else
                        { <text>@daysLeft </text> }
                    </div>
                    <div class="rsc-label">Sonraki Deadline</div>
                </div>
            </div>
        }
        <div class="review-progress-card">
            <div class="rpc-header">
                <span class="rpc-label">Tamamlanma</span>
                <span class="rpc-pct">%@progressPct</span>
            </div>
            <div class="rpc-track">
                <div class="rpc-fill @(progressPct == 100 ? "rpc-fill-done" : "")" style="width: @(progressPct)%"></div>
            </div>
            <div class="rpc-sub">@completedCount / @totalAssignments değerlendirme</div>
        </div>
    </div>

    <div class="d-flex align-items-center mb-4">
        <ul class="nav nav-pills nav-pills-custom" id="reviewTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active me-2"
                        id="pending-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#pending"
                        type="button">
                    <i class="fas fa-clock me-2"></i>
                    @Localizer["PendingTab"]
                    @if (pendingCount > 0)
                    {
                        <span class="tab-count-badge">@pendingCount</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link"
                        id="completed-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#completed"
                        type="button">
                    <i class="fas fa-history me-2"></i>
                    @Localizer["CompletedTab"]
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="reviewTabsContent">

        <div class="tab-pane fade show active" id="pending">
            @if (pendingList.Any())
            {
                <div class="row g-4">
                    @foreach (var item in pendingList)
                    {
                        <div class="col-lg-6 col-xl-4">
                            @{
                                int cardDaysLeft = item.ReviewDeadline.HasValue
                                    ? (int)(item.ReviewDeadline.Value.Date - DateTime.Today).TotalDays
                                    : int.MaxValue;
                                bool isOverdue = cardDaysLeft < 0;
                                bool isUrgent  = cardDaysLeft >= 0 && cardDaysLeft <= 3;
                            }
                            <div class="task-card @(isOverdue ? "task-card-overdue" : isUrgent ? "task-card-urgent" : "")">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-light text-secondary border">
                                        #REF-@ShortRef(item.SubmissionId)
                                    </span>
                                    @if (item.ReviewDeadline.HasValue)
                                    {
                                        <span class="task-deadline-chip @(isOverdue ? "tdc-red" : isUrgent ? "tdc-orange" : "tdc-gray")">
                                            <i class="fas fa-clock"></i>
                                            @if (isOverdue)
                                            {
                                                <text></text>
                                            }
                                            else if (cardDaysLeft == 0)
                                            {
                                                <text></text>
                                            }
                                            else
                                            {
                                                <text>@cardDaysLeft </text>
                                            }
                                        </span>
                                    }
                                </div>

                                <h6 class="fw-bold text-dark mb-2 line-clamp-2"
                                    style="min-height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.SubmissionTitle
                                </h6>

                                <div class="d-flex align-items-center flex-wrap gap-1 mb-3 pb-3 border-bottom">
                                    <span class="task-conf-label">@item.ConferenceName</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Topic))
                                    {
                                        <span class="task-topic-chip">@item.Topic</span>
                                    }
                                </div>

                                <div class="mt-auto d-flex gap-2">
                                    <a href="@BuildEvaluateUrl(item.Id)"
                                       class="btn btn-primary btn-sm flex-grow-1 fw-bold shadow-sm rounded-pill py-2">
                                        <i class="fas fa-play me-2"></i>
                                        @Localizer["EvaluateButton"]
                                    </a>

                                    <button type="button"
                                            onclick="openDeclineModal('@item.Id')"
                                            class="btn btn-outline-danger btn-sm rounded-circle shadow-sm"
                                            style="width: 38px; height: 38px;"
                                            title="@Localizer["DeclineTaskTitle"]"
                                            data-bs-toggle="tooltip">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                        <i class="fas fa-clipboard-check fa-3x text-muted opacity-25"></i>
                    </div>

                    <h5 class="fw-bold text-dark">
                        @Localizer["NoPendingTitle"]
                    </h5>

                    <p class="text-muted small">
                        @Localizer["NoPendingText"]
                    </p>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="completed">

            <div class="card completed-table-card">
                <div class="card-header bg-white py-3 px-4 border-bottom border-light">
                    <h6 class="fw-bold mb-0 text-secondary d-flex align-items-center">
                        <i class="fas fa-history text-primary me-2 opacity-50"></i>
                        @Localizer["HistoryHeader"]
                    </h6>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="py-3 px-4 text-muted small text-uppercase fw-bold" style="width: 40%;">
                                    @Localizer["SubmissionInfoColumn"]
                                </th>

                                <th class="py-3 text-muted small text-uppercase fw-bold">
                                    @Localizer["DateColumn"]
                                </th>

                                <th class="py-3 text-center text-muted small text-uppercase fw-bold">
                                    @Localizer["ScoreColumn"]
                                </th>

                                <th class="py-3 text-center text-muted small text-uppercase fw-bold">
                                    @Localizer["DecisionColumn"]
                                </th>

                                <th class="py-3 px-4 text-end text-muted small text-uppercase fw-bold">
                                    @Localizer["ActionsColumn"]
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (completedList.Any())
                            {
                                foreach (var item in completedList)
                                {
                                    var itemScore = item.Score ?? 0;

                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3 d-none d-md-block">
                                                    <i class="fas fa-file-alt fa-lg"></i>
                                                </div>

                                                <div>
                                                    <h6 class="mb-1 fw-bold text-dark text-truncate" style="max-width: 350px;">
                                                        @item.SubmissionTitle
                                                    </h6>

                                                    <span class="badge bg-light text-secondary border fw-normal">
                                                        #REF-@item.Id.ToString("D8")
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-center text-muted small fw-bold">
                                                <i class="far fa-calendar-check me-2 text-success"></i>
                                                @(item.EvaluationDate.HasValue ? item.EvaluationDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "-")
                                            </div>
                                        </td>

                                        <td class="text-center">
                                            @if (itemScore >= 80)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                                    @itemScore
                                                </span>
                                            }
                                            else if (itemScore >= 50)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2">
                                                    @itemScore
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                                                    @itemScore
                                                </span>
                                            }
                                        </td>

                                        <td class="text-center">
                                            @if (item.Recommendation == "Accept")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">
                                                    <i class="fas fa-check-circle me-1"></i>
                                                    @Localizer["AcceptLabel"]
                                                </span>
                                            }
                                            else if (item.Recommendation == "Reject")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-2">
                                                    <i class="fas fa-times-circle me-1"></i>
                                                    @Localizer["RejectLabel"]
                                                </span>
                                            }
                                            else if (!string.IsNullOrEmpty(item.Recommendation) && item.Recommendation.Contains("Revision"))
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2">
                                                    <i class="fas fa-tools me-1"></i>
                                                    @Localizer["RevisionLabel"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">
                                                    @(item.Recommendation ?? "-")
                                                </span>
                                            }
                                        </td>

                                        <td class="text-end px-4">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="@BuildCertificateUrl(item.Id)"
                                                   target="_blank"
                                                   class="btn btn-outline-dark btn-sm rounded-pill fw-bold px-3 shadow-sm">
                                                    <i class="fas fa-certificate text-warning me-1"></i>
                                                    @Localizer["CertificateButton"]
                                                </a>

                                                <a href="@BuildEvaluateUrl(item.Id)"
                                                   class="btn btn-light text-muted btn-sm rounded-circle border shadow-sm"
                                                   title="@Localizer["ViewDetailsTitle"]"
                                                   data-bs-toggle="tooltip">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="text-muted opacity-50 mb-2">
                                            <i class="fas fa-inbox fa-3x"></i>
                                        </div>

                                        <p class="small fw-bold text-muted mb-0">
                                            @Localizer["NoCompletedText"]
                                        </p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>
</div>

<div class="modal fade" id="declineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @Localizer["DeclineModalTitle"]
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@Localizer["CloseButton"]">
                </button>
            </div>

            <form action="@declinePostUrl" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body pt-3">
                    <input type="hidden" name="id" id="declineAssignmentId" />

                    <p class="text-muted small mb-4">
                        @Localizer["DeclineModalDescription"]
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">
                            @Localizer["DeclineReasonLabel"]
                        </label>

                        <div class="d-grid gap-2">
                            <input type="radio"
                                   class="btn-check"
                                   name="Reason"
                                   id="reason1"
                                   value="ConflictOfInterest"
                                   required />

                            <label class="btn btn-outline-light text-dark text-start border shadow-sm p-3 d-flex align-items-center rounded-3" for="reason1">
                                <i class="fas fa-handshake-slash text-danger me-3 fs-5"></i>

                                <div>
                                    <span class="d-block fw-bold" style="font-size: 0.9rem;">
                                        @Localizer["Reason1Title"]
                                    </span>

                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @Localizer["Reason1Text"]
                                    </small>
                                </div>
                            </label>

                            <input type="radio"
                                   class="btn-check"
                                   name="Reason"
                                   id="reason2"
                                   value="NotMyField" />

                            <label class="btn btn-outline-light text-dark text-start border shadow-sm p-3 d-flex align-items-center rounded-3" for="reason2">
                                <i class="fas fa-flask text-warning me-3 fs-5"></i>

                                <div>
                                    <span class="d-block fw-bold" style="font-size: 0.9rem;">
                                        @Localizer["Reason2Title"]
                                    </span>

                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @Localizer["Reason2Text"]
                                    </small>
                                </div>
                            </label>

                            <input type="radio"
                                   class="btn-check"
                                   name="Reason"
                                   id="reason3"
                                   value="TimeConstraints" />

                            <label class="btn btn-outline-light text-dark text-start border shadow-sm p-3 d-flex align-items-center rounded-3" for="reason3">
                                <i class="fas fa-hourglass-end text-primary me-3 fs-5"></i>

                                <div>
                                    <span class="d-block fw-bold" style="font-size: 0.9rem;">
                                        @Localizer["Reason3Title"]
                                    </span>

                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @Localizer["Reason3Text"]
                                    </small>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">
                            @Localizer["AdditionalNoteLabel"]
                        </label>

                        <textarea name="Note"
                                  class="form-control bg-light"
                                  rows="2"
                                  placeholder="@Localizer["AdditionalNotePlaceholder"]"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="button"
                            class="btn btn-light rounded-pill fw-bold"
                            data-bs-dismiss="modal">
                        @Localizer["CancelButton"]
                    </button>

                    <button type="submit"
                            class="btn btn-danger rounded-pill fw-bold px-4 shadow-sm">
                        <i class="fas fa-ban me-2"></i>
                        @Localizer["DeclineTaskButton"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeclineModal(id) {
            document.getElementById('declineAssignmentId').value = id;

            var modalElement = document.getElementById('declineModal');
            var myModal = new bootstrap.Modal(modalElement);

            myModal.show();
        }

        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));

            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
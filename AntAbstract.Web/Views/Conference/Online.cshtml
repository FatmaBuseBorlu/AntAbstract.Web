@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var slug = ViewContext.RouteData.Values["slug"]?.ToString() ?? "";
    var conferenceId = (Guid)ViewBag.ConferenceId;
    var onlineUrl = ViewBag.OnlineUrl as string ?? "";
}

<form id="afForm" method="post">
    @Html.AntiForgeryToken()
</form>

<div class="container py-4">
    <h4>@Localizer["PageHeading"]</h4>
    <p>@Localizer["PageDescription"]</p>

    <a class="btn btn-primary" href="@onlineUrl" target="_blank">
        @Localizer["OpenMeetingButton"]
    </a>

    <div class="mt-3">
        <span id="statusText">@Localizer["TrackingStatusText"]</span>
    </div>
</div>

<script>
    const slug = "@slug";
    const conferenceId = "@conferenceId";
    const token = document.querySelector('#afForm input[name="__RequestVerificationToken"]').value;

    const completedText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["CompletedText"].Value));
    const remainingPrefix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["RemainingPrefix"].Value));
    const remainingSuffix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["RemainingSuffix"].Value));

    async function post(url) {
        const res = await fetch(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded",
                "RequestVerificationToken": token
            },
            body: "conferenceId=" + encodeURIComponent(conferenceId)
        });
        return await res.json();
    }

    (async function () {
        await post(`/${slug}/Attendance/Join`);

        setInterval(async () => {
            const data = await post(`/${slug}/Attendance/Ping`);
            const remain = Math.max(0, (data.requiredSeconds - data.totalSeconds));

            if (data.completed) {
                document.getElementById("statusText").innerText = completedText;
            } else {
                document.getElementById("statusText").innerText = remainingPrefix + remain + remainingSuffix;
            }
        }, 30000);
    })();
</script>
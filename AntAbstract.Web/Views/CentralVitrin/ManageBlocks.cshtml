@model IEnumerable<AntAbstract.Domain.Entities.ConferencePageBlock>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitleFormat", ViewBag.ConferenceName].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0">
                <i class="fas fa-layer-group me-2"></i> @ViewBag.ConferenceName @Localizer["ShowcaseTitleSuffix"]
            </h5>
            <div>
                <span class="badge bg-light text-primary me-3">@Localizer["CentralAccessBadge"]</span>
                <a asp-action="CreateBlock" asp-route-conferenceId="@ViewBag.ConferenceId" class="btn btn-light btn-sm fw-bold text-primary shadow-sm rounded-pill px-3">
                    <i class="fas fa-plus me-1"></i> @Localizer["AddNewBlockButton"]
                </a>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["OrderColumn"]</th>
                            <th>@Localizer["BlockTypeColumn"]</th>
                            <th>@Localizer["ShowcaseTitleColumn"]</th>
                            <th>@Localizer["StatusColumn"]</th>
                            <th>@Localizer["ActionsColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var block in Model)
                        {
                            <tr>
                                <td>@block.Order</td>
                                <td>
                                    <span class="badge bg-info text-dark">@block.BlockType</span>
                                </td>
                                <td class="fw-bold">@block.Title</td>
                                <td>
                                    @if (block.IsActive)
                                    {
                                        <span class="badge bg-success">@Localizer["PublishedBadge"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["HiddenBadge"]</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="EditBlock" asp-route-id="@block.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-pen"></i> @Localizer["EditContentButton"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> @Localizer["BackToConferenceListButton"]
                </a>
            </div>
        </div>
    </div>
</div>
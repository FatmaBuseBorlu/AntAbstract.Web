@model IEnumerable<AntAbstract.Domain.Entities.Conference>

@{
    ViewData["Title"] = "Süper Admin - Vitrin Yönetimi";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml"; // Kendi Admin temanın Layout'u
}

<div class="container-fluid mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-globe"></i> Merkezi Vitrin Yönetimi (God Mode)</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">Buradan sistemdeki tüm kongrelerin vitrinlerine (müşteri sayfalarına) sızabilir ve anında düzenleyebilirsiniz.</p>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Kongre Adı</th>
                            <th>Tarih</th>
                            <th>Müşteri (Tenant) URL</th>
                            <th class="text-center">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Title</td>
                                <td>@item.StartDate.ToString("dd.MM.yyyy")</td>
                                <td><span class="badge bg-secondary">/@(item.Tenant?.Slug ?? "Yok")</span></td>
                                <td class="text-center">
                                    <a asp-action="ManageBlocks" asp-route-conferenceId="@item.Id" class="btn btn-primary btn-sm fw-bold">
                                        <i class="fas fa-edit"></i> Vitrini Yönet
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<AntAbstract.Domain.Entities.Conference>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="fas fa-globe"></i> @Localizer["HeaderTitle"]</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">@Localizer["PageDescription"]</p>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["ConferenceNameColumn"]</th>
                            <th>@Localizer["DateColumn"]</th>
                            <th>@Localizer["TenantUrlColumn"]</th>
                            <th class="text-center">@Localizer["ActionColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Title</td>
                                <td>@item.StartDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary">/@(item.Tenant?.Slug ?? Localizer["NoneText"].Value)</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="ManageBlocks" asp-route-conferenceId="@item.Id" class="btn btn-primary btn-sm fw-bold">
                                        <i class="fas fa-edit"></i> @Localizer["ManageShowcaseButton"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@model AntAbstract.Domain.Entities.ConferencePageBlock
@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.WebsiteBlocks
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var aboutContent = ViewBag.AboutContent as AboutBlockContent;

    var blockTypeText = Model.BlockType.ToString();
}

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">

<style>
    .cms-card {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f1f5f9;
    }

    .cms-header {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        padding: 25px;
        color: white;
    }

    .form-control-modern {
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        padding: 12px 15px;
        transition: all 0.3s;
    }

        .form-control-modern:focus {
            border-color: #00aeef;
            box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
        }

    .note-editor {
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid #e2e8f0 !important;
    }

    .note-toolbar {
        background-color: #f8fafc !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }
</style>

<div class="container-fluid mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="ManageBlocks" asp-route-conferenceId="@Model.ConferenceId" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
            <i class="fas fa-arrow-left me-2"></i> @Localizer["BackToShowcaseButton"]
        </a>
        <h4 class="text-muted fw-bold mb-0">@Localizer["ContentManagementTitle"]</h4>
    </div>

    <div class="card cms-card">
        <div class="cms-header">
            <h4 class="mb-1 fw-bold">
                <i class="fas fa-pen-nib me-2 text-info"></i> @Localizer["EditPrefix"] @Model.Title
            </h4>
            <small class="text-white-50">@Localizer["ChangesReflectImmediatelyText"]</small>
        </div>

        <div class="card-body p-4 p-lg-5">
            <form asp-controller="CentralVitrin" asp-action="EditBlock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ConferenceId" />

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold text-dark">
                            @Localizer["VisibleMenuTitleLabel"] <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Title" class="form-control form-control-modern" placeholder="@Localizer["VisibleMenuTitlePlaceholder"]" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Subtitle" class="form-label fw-bold text-dark">@Localizer["BlockTypeLabel"]</label>
                        <input type="text" class="form-control form-control-modern bg-light text-muted" value="@blockTypeText" readonly />
                    </div>
                </div>

                @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
                {
                    <div class="bg-light p-4 rounded-4 border mb-5">
                        <h5 class="fw-bold mb-4 text-primary">
                            <i class="fas fa-file-alt me-2"></i> @Localizer["DetailedContentHeader"]
                        </h5>

                        <div class="mb-4">
                            <label class="form-label fw-bold">@Localizer["ContentTextLabel"]</label>
                            <p class="small text-muted mb-2">
                                <i class="fas fa-info-circle"></i> @Localizer["ContentTextHelpText"]
                            </p>
                            <textarea id="summernote" name="aboutContent.Description">@aboutContent.Description</textarea>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-5">
                        <label asp-for="Subtitle" class="form-label fw-bold text-dark">@Localizer["ShortDescriptionLabel"]</label>
                        <textarea asp-for="Subtitle" class="form-control form-control-modern" rows="4"></textarea>
                    </div>
                }

                <div class="d-flex align-items-center justify-content-between border-top pt-4 mt-2">
                    <div class="form-check form-switch fs-5">
                        <input asp-for="IsActive" class="form-check-input shadow-sm" type="checkbox" role="switch" id="activeSwitch" style="cursor: pointer;">
                        <label asp-for="IsActive" class="form-check-label fw-bold text-dark ms-2" for="activeSwitch" style="cursor: pointer;">
                            @Localizer["PublishOnSiteLabel"]
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-lg">
                        <i class="fas fa-save me-2"></i> @Localizer["SaveChangesButton"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <script>
        const summernotePlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SummernotePlaceholder"].Value));

        $(document).ready(function() {
            $('#summernote').summernote({
                placeholder: summernotePlaceholder,
                tabsize: 2,
                height: 300,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'picture']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ]
            });
        });
    </script>
}
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-lg rounded-3">
                <div class="card-header bg-primary text-white p-4 rounded-top">
                    <h4 class="fw-bold mb-1">
                        <i class="fas fa-poll-h me-2"></i> @Localizer["HeaderTitle"]
                    </h4>
                    <p class="mb-0 small opacity-75">@Localizer["HeaderDescription"]</p>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Submit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="submissionId" value="@ViewBag.SubmissionId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">@Localizer["Question1Label"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-star text-warning"></i></span>
                                <select name="q1" class="form-select" required>
                                    <option value="">@Localizer["SelectOption"]</option>
                                    <option value="@Localizer["Q1Option5Value"]">⭐⭐⭐⭐⭐ @Localizer["Q1Option5Text"]</option>
                                    <option value="@Localizer["Q1Option4Value"]">⭐⭐⭐⭐ @Localizer["Q1Option4Text"]</option>
                                    <option value="@Localizer["Q1Option3Value"]">⭐⭐⭐ @Localizer["Q1Option3Text"]</option>
                                    <option value="@Localizer["Q1Option2Value"]">⭐⭐ @Localizer["Q1Option2Text"]</option>
                                    <option value="@Localizer["Q1Option1Value"]">⭐ @Localizer["Q1Option1Text"]</option>
                                </select>
                            </div>
                            <textarea name="q1_detail"
                                      class="form-control mt-2 text-muted small"
                                      rows="2"
                                      placeholder="@Localizer["Q1DetailPlaceholder"]"></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">@Localizer["Question2Label"]</label>
                            <div class="d-flex gap-4 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="q2" id="q2_yes" value="@Localizer["Q2YesValue"]" required>
                                    <label class="form-check-label" for="q2_yes">👍 @Localizer["Q2YesText"]</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="q2" id="q2_no" value="@Localizer["Q2NoValue"]">
                                    <label class="form-check-label" for="q2_no">👎 @Localizer["Q2NoText"]</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">@Localizer["Question3Label"]</label>
                            <select name="q3" class="form-select" required>
                                <option value="">@Localizer["SelectOption"]</option>
                                <option value="@Localizer["Q3OptionHighValue"]">@Localizer["Q3OptionHighText"]</option>
                                <option value="@Localizer["Q3OptionMediumValue"]">@Localizer["Q3OptionMediumText"]</option>
                                <option value="@Localizer["Q3OptionNoValue"]">@Localizer["Q3OptionNoText"]</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">@Localizer["Question4Label"]</label>
                            <textarea name="q4"
                                      class="form-control bg-light"
                                      rows="3"
                                      placeholder="@Localizer["Q4Placeholder"]"
                                      required></textarea>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold text-dark">@Localizer["Question5Label"]</label>
                            <textarea name="q5"
                                      class="form-control bg-light"
                                      rows="3"
                                      placeholder="@Localizer["Q5Placeholder"]"
                                      required></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                <i class="fas fa-paper-plane me-2"></i> @Localizer["SubmitButton"]
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
@model List<AntAbstract.Domain.Entities.Notification>

@{
    ViewData["Title"] = "Bildirimler";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var totalCount = Model?.Count ?? 0;
    var unreadCount = Model?.Count(x => !x.IsRead) ?? 0;
}

<div class="notification-page">

    <div class="notification-hero">
        <div class="notification-hero-left">
            <div class="notification-hero-icon">
                <i class="fas fa-bell"></i>
            </div>

            <div>
                <div class="notification-label">
                    Hesap Merkezi
                </div>

                <h2 class="notification-title">
                    Bildirimler
                </h2>

                <p class="notification-lead">
                    
                </p>
            </div>
        </div>

        <div class="notification-stats">
            <div class="notification-stat">
                <span>Toplam</span>
                <strong>@totalCount</strong>
            </div>

            <div class="notification-stat unread">
                <span></span>
                <strong>@unreadCount</strong>
            </div>
        </div>
    </div>

    <div class="notification-card">
        <div class="notification-card-header">
            <div>
                <h5>
                    
                </h5>

                <p>
                    
                </p>
            </div>

            @if (unreadCount > 0)
            {
                <form asp-controller="Notification"
                      asp-action="MarkAllReadPage"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="mark-all-btn">
                        <i class="fas fa-check-double"></i>
                        
                    </button>
                </form>
            }
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="notification-empty">
                <div class="notification-empty-icon">
                    <i class="fas fa-bell-slash"></i>
                </div>

                <h4>
                    
                </h4>

                <p>
                    
                </p>
            </div>
        }
        else
        {
            <div class="notification-list">
                @foreach (var item in Model)
                {
                    <div class="notification-row @(item.IsRead ? "" : "unread")">
                        <div class="notification-row-icon @(item.IsRead ? "read" : "active")">
                            <i class="fas @(item.IsRead ? "fa-bell" : "fa-circle-check")"></i>
                        </div>

                        <div class="notification-row-content">
                            <div class="notification-row-title">
                                @item.Title
                            </div>

                            <div class="notification-row-message">
                                @item.Message
                            </div>

                            <div class="notification-row-date">
                                <i class="far fa-clock"></i>
                                @item.CreatedAt.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div class="notification-row-action">
                            @if (item.IsRead)
                            {
                                <span class="read-pill">
                                    Okundu
                                </span>
                            }
                            else
                            {
                                <form asp-controller="Notification"
                                      asp-action="MarkReadPage"
                                      method="post"
                                      class="m-0">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@item.Id" />

                                    <button type="submit" class="read-btn">
                                        Okundu Yap
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<style>
    .notification-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .notification-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 1.45rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem;
        flex-wrap: wrap;
    }

    .notification-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 280px;
        flex: 1;
    }

    .notification-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .notification-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.25rem;
    }

    .notification-title {
        color: #0f172a;
        font-size: 1.85rem;
        font-weight: 900;
        letter-spacing: -0.055em;
        margin: 0 0 0.25rem;
    }

    .notification-lead {
        color: #64748b;
        font-size: 0.94rem;
        font-weight: 650;
        line-height: 1.55;
        margin: 0;
    }

    .notification-stats {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .notification-stat {
        min-width: 110px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        padding: 0.8rem 1rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.045);
    }

        .notification-stat span {
            display: block;
            color: #64748b;
            font-size: 0.72rem;
            font-weight: 900;
            margin-bottom: 0.2rem;
        }

        .notification-stat strong {
            color: #0f172a;
            font-size: 1.55rem;
            font-weight: 900;
            line-height: 1;
        }

        .notification-stat.unread {
            background: rgba(0, 174, 239, 0.08);
            border-color: rgba(0, 174, 239, 0.20);
        }

    .notification-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.055);
        overflow: hidden;
    }

    .notification-card-header {
        padding: 1.25rem 1.4rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .notification-card-header h5 {
            color: #0f172a;
            font-size: 1.15rem;
            font-weight: 900;
            margin: 0 0 0.2rem;
        }

        .notification-card-header p {
            color: #64748b;
            font-size: 0.84rem;
            font-weight: 650;
            margin: 0;
        }

    .mark-all-btn {
        min-height: 40px;
        border: none;
        border-radius: 999px;
        padding: 0 1rem;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        font-size: 0.82rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        box-shadow: 0 12px 26px rgba(0, 174, 239, 0.22);
    }

    .notification-list {
        display: grid;
    }

    .notification-row {
        display: grid;
        grid-template-columns: 52px 1fr auto;
        gap: 0.9rem;
        align-items: center;
        padding: 1rem 1.4rem;
        border-bottom: 1px solid #edf2f7;
        background: #ffffff;
    }

        .notification-row:last-child {
            border-bottom: none;
        }

        .notification-row.unread {
            background: #f0f9ff;
        }

    .notification-row-icon {
        width: 48px;
        height: 48px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

        .notification-row-icon.active {
            background: rgba(34, 197, 94, 0.10);
            color: #16a34a;
        }

        .notification-row-icon.read {
            background: #f1f5f9;
            color: #94a3b8;
        }

    .notification-row-content {
        min-width: 0;
    }

    .notification-row-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 900;
        margin-bottom: 0.2rem;
    }

    .notification-row-message {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.45;
    }

    .notification-row-date {
        margin-top: 0.35rem;
        color: #94a3b8;
        font-size: 0.76rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .read-pill,
    .read-btn {
        min-height: 32px;
        border-radius: 999px;
        padding: 0 0.75rem;
        font-size: 0.74rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .read-pill {
        background: #f1f5f9;
        color: #64748b;
    }

    .read-btn {
        border: 1px solid rgba(13, 110, 253, 0.22);
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
    }

    .notification-empty {
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .notification-empty-icon {
        width: 84px;
        height: 84px;
        border-radius: 999px;
        background: #f8fafc;
        color: #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.25rem;
        margin-bottom: 1rem;
    }

    .notification-empty h4 {
        color: #0f172a;
        font-size: 1.3rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .notification-empty p {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .notification-hero-left {
            align-items: flex-start;
            flex-direction: column;
        }

        .notification-row {
            grid-template-columns: 1fr;
            align-items: flex-start;
        }

        .notification-row-action,
        .read-btn {
            width: 100%;
        }
    }
</style>
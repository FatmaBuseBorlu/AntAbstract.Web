@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Http
@using System
@using System.Collections.Generic
@using System.Linq

@model List<AntAbstract.Domain.Entities.Certificate>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string L(string key, string fallback)
    {
        var loc = Localizer[key];
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    ViewData["Title"] = L("PageTitle", "Sertifikalarım");
    Layout = "_LayoutDashboard";

    var certificates = Model ?? new List<Certificate>();

    var slug = ViewBag.Slug as string
        ?? ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var currentConferenceTitle = ViewBag.CurrentConferenceTitle as string
        ?? Context.Session.GetString("SelectedConferenceTitle")
        ?? "";

    var conferenceTitles = ViewBag.ConferenceTitles as Dictionary<Guid, string>
        ?? new Dictionary<Guid, string>();

    string GetCertificateTypeText(CertificateType type)
    {
        return type switch
        {
            CertificateType.Author => L("Type_Author", "Yazar Sertifikası"),
            CertificateType.Reviewer => L("Type_Reviewer", "Hakem Sertifikası"),
            _ => type.ToString()
        };
    }

    string GetCertificateTypeIcon(CertificateType type)
    {
        return type switch
        {
            CertificateType.Author => "fas fa-user-graduate",
            CertificateType.Reviewer => "fas fa-gavel",
            _ => "fas fa-award"
        };
    }

    string GetCertificateTypeClass(CertificateType type)
    {
        return type switch
        {
            CertificateType.Author => "author",
            CertificateType.Reviewer => "reviewer",
            _ => "default"
        };
    }

    string GetConferenceText(Guid conferenceId)
    {
        if (conferenceTitles.TryGetValue(conferenceId, out var title) &&
            !string.IsNullOrWhiteSpace(title))
        {
            return title;
        }

        return conferenceId == Guid.Empty
            ? L("UnknownConferenceText", "Kongre bilgisi yok")
            : conferenceId.ToString();
    }

    string GetDownloadUrl(Guid certificateId)
    {
        if (!string.IsNullOrWhiteSpace(slug))
        {
            return $"/{slug}/Certificates/Download/{certificateId}";
        }

        return $"/Certificates/Download/{certificateId}";
    }

    var totalCount = certificates.Count;
    var authorCount = certificates.Count(x => x.Type == CertificateType.Author);
    var reviewerCount = certificates.Count(x => x.Type == CertificateType.Reviewer);
}

<style>
    .certificates-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .certificate-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .certificate-summary-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .summary-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 174, 239, 0.10);
        color: #00aeef;
        font-size: 1.1rem;
    }

    .summary-value {
        color: #0f172a;
        font-size: 1.3rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .summary-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.25rem;
    }

    .certificates-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .certificates-card-header {
        padding: 1.1rem 1.35rem;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .certificates-card-title {
        margin: 0;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
    }

    .certificates-card-subtitle {
        margin: 0.25rem 0 0;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
    }

    .certificates-table {
        margin-bottom: 0;
    }

    .certificates-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.15rem;
        white-space: nowrap;
    }

    .certificates-table tbody td {
        color: #475569;
        font-size: 0.92rem;
        font-weight: 700;
        padding: 1.1rem 1.15rem;
        vertical-align: middle;
        border-color: #edf2f7;
    }

    .certificate-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .certificate-type-badge.author {
        background: rgba(13, 110, 253, 0.09);
        color: #0d6efd;
    }

    .certificate-type-badge.reviewer {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .certificate-type-badge.default {
        background: rgba(100, 116, 139, 0.10);
        color: #475569;
    }

    .conference-name {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        max-width: 280px;
        padding: 0.45rem 0.7rem;
        border-radius: 12px;
        background: #f8fafc;
        color: #475569;
        font-size: 0.8rem;
        font-weight: 850;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .date-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: #475569;
        font-weight: 850;
        white-space: nowrap;
    }

    .date-pill i {
        color: #94a3b8;
    }

    .generated-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 950;
        background: rgba(22, 163, 74, 0.10);
        color: #15803d;
        white-space: nowrap;
    }

    .waiting-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 950;
        background: rgba(100, 116, 139, 0.10);
        color: #64748b;
        white-space: nowrap;
    }

    .download-btn {
        min-height: 38px;
        border-radius: 999px;
        padding: 0 0.9rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-size: 0.82rem;
        font-weight: 950;
        color: #ffffff;
        background: linear-gradient(135deg, #00aeef, #2563eb);
        border: none;
        text-decoration: none;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.22);
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .download-btn:hover {
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(37, 99, 235, 0.30);
        text-decoration: none;
    }

    .empty-state {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 4rem 1.5rem;
        text-align: center;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
    }

    .empty-state-content {
        max-width: 620px;
        margin: 0 auto;
    }

    .empty-icon {
        width: 116px;
        height: 116px;
        border-radius: 999px;
        background: #f8fafc;
        color: #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 3.6rem;
        margin-bottom: 1.2rem;
    }

    .empty-title {
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .empty-description {
        color: #64748b;
        font-size: 0.92rem;
        font-weight: 650;
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.7;
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }

        .certificate-summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .certificates-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-title {
            font-size: 1.45rem;
        }

        .program-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .certificates-table thead {
            display: none;
        }

        .certificates-table tbody tr {
            display: block;
            padding: 0.9rem 1rem;
            border-bottom: 1px solid #e2e8f0;
        }

        .certificates-table tbody td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            border: none;
            padding: 0.45rem 0;
            text-align: right !important;
        }

        .certificates-table tbody td::before {
            content: attr(data-label);
            color: #64748b;
            font-size: 0.74rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            text-align: left;
        }

        .conference-name {
            max-width: 180px;
        }
    }
</style>

<div class="certificates-page">

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-award"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("PageHeading", "Sertifikalarım")
                </h3>

                <p class="program-lead">
                    @L("PageDescription", "Kazanmış olduğunuz yazar ve hakem sertifikalarını buradan görüntüleyebilir ve indirebilirsiniz.")
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(currentConferenceTitle))
        {
            <div class="program-conference-pill">
                <i class="fas fa-calendar-check"></i>
                <span>@currentConferenceTitle</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(slug))
        {
            <div class="program-conference-pill">
                <i class="fas fa-link"></i>
                <span>/@slug</span>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 fw-bold mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info border-0 shadow-sm rounded-4 fw-bold mb-4">
            <i class="fas fa-circle-info me-2"></i>
            @TempData["InfoMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 fw-bold mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!certificates.Any())
    {
        <div class="empty-state">
            <div class="empty-state-content">
                <div class="empty-icon">
                    <i class="fas fa-award"></i>
                </div>

                <h4 class="empty-title">
                    @L("NoCertificatesTitle", "Henüz sertifikanız bulunmuyor.")
                </h4>

                <p class="empty-description">
                    @L("NoCertificatesMessage", "Sertifika koşullarını sağladığınızda yazar veya hakem sertifikalarınız bu alanda görüntülenecektir.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="certificate-summary-grid">
            <div class="certificate-summary-card">
                <div class="summary-icon">
                    <i class="fas fa-layer-group"></i>
                </div>

                <div>
                    <div class="summary-value">@totalCount</div>
                    <div class="summary-label">@L("TotalCertificatesLabel", "Toplam Sertifika")</div>
                </div>
            </div>

            <div class="certificate-summary-card">
                <div class="summary-icon">
                    <i class="fas fa-user-graduate"></i>
                </div>

                <div>
                    <div class="summary-value">@authorCount</div>
                    <div class="summary-label">@L("AuthorCertificatesLabel", "Yazar Sertifikası")</div>
                </div>
            </div>

            <div class="certificate-summary-card">
                <div class="summary-icon">
                    <i class="fas fa-gavel"></i>
                </div>

                <div>
                    <div class="summary-value">@reviewerCount</div>
                    <div class="summary-label">@L("ReviewerCertificatesLabel", "Hakem Sertifikası")</div>
                </div>
            </div>
        </div>

        <div class="certificates-card">
            <div class="certificates-card-header">
                <div>
                    <h5 class="certificates-card-title">
                        @L("CertificateListTitle", "Sertifika Listesi")
                    </h5>

                    <p class="certificates-card-subtitle">
                        @L("CertificateListDescription", "Hak kazandığınız belgeler aşağıda listelenir.")
                    </p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle certificates-table">
                    <thead>
                        <tr>
                            <th>@L("TypeColumn", "Tür")</th>
                            <th>@L("ConferenceColumn", "Kongre")</th>
                            <th>@L("EligibilityColumn", "Hak Ediş Tarihi")</th>
                            <th>@L("GeneratedAtColumn", "Oluşturulma Tarihi")</th>
                            <th class="text-end">@L("ActionColumn", "İşlem")</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var certificate in certificates.OrderByDescending(x => x.GeneratedAt ?? x.EligibleAt))
                        {
                            var typeText = GetCertificateTypeText(certificate.Type);
                            var typeIcon = GetCertificateTypeIcon(certificate.Type);
                            var typeClass = GetCertificateTypeClass(certificate.Type);
                            var downloadUrl = GetDownloadUrl(certificate.Id);
                            var conferenceText = GetConferenceText(certificate.ConferenceId);

                            <tr>
                                <td data-label="@L("TypeColumn", "Tür")">
                                    <span class="certificate-type-badge @typeClass">
                                        <i class="@typeIcon"></i>
                                        @typeText
                                    </span>
                                </td>

                                <td data-label="@L("ConferenceColumn", "Kongre")">
                                    <span class="conference-name" title="@conferenceText">
                                        <i class="fas fa-calendar-check"></i>
                                        @conferenceText
                                    </span>
                                </td>

                                <td data-label="@L("EligibilityColumn", "Hak Ediş Tarihi")">
                                    <span class="date-pill">
                                        <i class="fas fa-calendar-day"></i>
                                        @certificate.EligibleAt.ToLocalTime().ToString("dd.MM.yyyy")
                                    </span>
                                </td>

                                <td data-label="@L("GeneratedAtColumn", "Oluşturulma Tarihi")">
                                    @if (certificate.GeneratedAt.HasValue)
                                    {
                                        <span class="generated-badge">
                                            <i class="fas fa-check-circle"></i>
                                            @certificate.GeneratedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="waiting-badge">
                                            <i class="fas fa-clock"></i>
                                            @L("WaitingGenerationText", "Bekliyor")
                                        </span>
                                    }
                                </td>

                                <td data-label="@L("ActionColumn", "İşlem")" class="text-end">
                                    <a class="download-btn"
                                       href="@downloadUrl">
                                        <i class="fas fa-download"></i>
                                        @L("DownloadButton", "İndir")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
@model AntAbstract.Web.Models.ViewModels.Proceedings.ProceedingBookPageViewModel

@using System
@using System.Collections.Generic
@using System.Linq
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    ViewData["Title"] = L("PageTitle", "Bildiri Kitapları");
    ViewData["BodyClass"] = "page-proceedings";

    var books = Model?.Books ?? new List<AntAbstract.Web.Models.ViewModels.Proceedings.ProceedingBookItemViewModel>();
}

<section class="proceedings-page">

    <div class="proceedings-hero">
        <div class="proceedings-hero-shape shape-one"></div>
        <div class="proceedings-hero-shape shape-two"></div>
        <div class="proceedings-hero-shape shape-three"></div>

        <div class="container">
            <div class="proceedings-hero-content">

                <div class="proceedings-pill">
                    <i class="fas fa-book-open"></i>
                    @L("HeroPill", "Akademik yayın arşivi")
                </div>

                <h1 class="proceedings-title">
                    @if (Model?.IsSingleConferencePage == true && !string.IsNullOrWhiteSpace(Model.ConferenceTitle))
                    {
                        @Model.ConferenceTitle
                    }
                    else
                    {
                        @L("HeroTitle", "Bildiri Kitapları")
                    }
                </h1>

                <p class="proceedings-description">
                    @L("HeroDescription", "Kongrelere ait yayınlanmış bildiri kitaplarını görüntüleyin, inceleyin ve PDF olarak indirin.")
                </p>

                @if (books.Any())
                {
                    <div class="proceedings-search-card">
                        <div class="proceedings-search-input-wrap">
                            <i class="fas fa-search"></i>

                            <input type="text"
                                   id="proceedingsSearchInput"
                                   autocomplete="off"
                                   placeholder="@L("SearchPlaceholder", "Bildiri kitabı, kongre adı veya yıl ara...")" />
                        </div>

                        <button type="button"
                                id="proceedingsSearchButton"
                                class="proceedings-search-button">
                            <i class="fas fa-search"></i>
                            @L("SearchButton", "Ara")
                        </button>
                    </div>

                    <div class="proceedings-filter-chips">
                        <button type="button" class="proceeding-chip active" data-filter="">
                            <i class="fas fa-border-all"></i>
                            @L("FilterAll", "Tümü")
                        </button>

                        <button type="button" class="proceeding-chip" data-filter="bildiri kitabı">
                            <i class="fas fa-file-lines"></i>
                            @L("FilterProceedings", "Bildiri Kitabı")
                        </button>

                        <button type="button" class="proceeding-chip" data-filter="yayında">
                            <i class="fas fa-circle-check"></i>
                            @L("PublishedBadge", "Yayında")
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>

    <div class="proceedings-list-section">
        <div class="container">

            <div class="proceedings-list-header">
                <div>
                    <h2>
                        @L("ListTitle", "Yayınlanan Bildiri Kitapları")
                    </h2>

                    <p>
                        @L("ListDescription", "Kongre arşivinde yer alan bildiri kitaplarını buradan inceleyebilirsiniz.")
                    </p>
                </div>

                <div class="proceedings-count-badge">
                    <span id="visibleProceedingsCount">@books.Count</span> / @books.Count @L("BookCountText", "kitap")
                </div>
            </div>

            @if (!books.Any())
            {
                <div class="proceedings-empty">
                    <div class="proceedings-empty-icon">
                        <i class="fas fa-book-open"></i>
                    </div>

                    @if (Model?.IsSingleConferencePage == true)
                    {
                        <h3>
                            @L("SingleEmptyTitle", "Bu kongre için bildiri kitabı henüz yayınlanmadı")
                        </h3>

                        <p>
                            @L("SingleEmptyDescription", "Bildiri kitabı yayınlandığında bu sayfadan görüntüleyebilir ve PDF olarak indirebilirsiniz.")
                        </p>
                    }
                    else
                    {
                        <h3>
                            @L("EmptyTitle", "Henüz yayınlanan bildiri kitabı yok")
                        </h3>

                        <p>
                            @L("EmptyDescription", "Bildiri kitabı yayınlandığında bu alanda otomatik olarak görüntülenecektir.")
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="proceedings-grid" id="proceedingsGrid">

                    @for (var i = 0; i < books.Count; i++)
                    {
                        var book = books[i];

                        var accentClass = i % 3 == 0
                            ? "proceeding-accent-blue"
                            : i % 3 == 1
                                ? "proceeding-accent-green"
                                : "proceeding-accent-orange";

                        var publishedText = book.PublishedDate.HasValue
                            ? book.PublishedDate.Value.ToString("dd.MM.yyyy")
                            : L("PublishedDateUnknown", "Yayın tarihi belirtilmedi");

                        var searchText = $"{book.ConferenceTitle} {book.Year} {book.CategoryText} {book.StatusText} bildiri kitabı pdf".ToLowerInvariant();

                        <article class="proceeding-card @accentClass"
                                 data-search="@searchText">

                            <div class="proceeding-cover">
                                <div class="proceeding-year-badge">
                                    @book.Year
                                </div>

                                <div class="proceeding-isbn-badge">
                                    PDF
                                </div>

                                <div class="proceeding-book-visual">
                                    <div class="book-spine"></div>

                                    <div class="book-front">
                                        <div class="book-front-icon">
                                            <i class="fas fa-file-pdf"></i>
                                        </div>

                                        <div class="book-front-title">
                                            @L("BookCoverTitle", "Bildiri Kitabı")
                                        </div>

                                        <div class="book-front-year">
                                            @book.Year
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="proceeding-body">
                                <div class="proceeding-topline">
                                    <span class="proceeding-category">
                                        @book.CategoryText
                                    </span>

                                    <span class="proceeding-status">
                                        <i class="fas fa-circle-check"></i>
                                        @book.StatusText
                                    </span>
                                </div>

                                <h3 class="proceeding-card-title">
                                    @book.ConferenceTitle
                                </h3>

                                <p class="proceeding-editors">
                                    @L("AutoGeneratedText", "Sistem tarafından kabul edilmiş bildirilerden otomatik oluşturuldu.")
                                </p>

                                <div class="proceeding-meta">
                                    <span>
                                        <i class="fas fa-calendar-check"></i>
                                        @book.Year
                                    </span>

                                    <span>
                                        <i class="fas fa-file-pdf"></i>
                                        PDF
                                    </span>

                                    <span>
                                        <i class="fas fa-clock"></i>
                                        @publishedText
                                    </span>
                                </div>

                                <div class="proceeding-actions">
                                    <a href="@book.FileUrl"
                                       target="_blank"
                                       class="proceeding-action-btn proceeding-view-btn">
                                        <i class="fas fa-eye"></i>
                                        @L("ViewBookButton", "Kitabı Gör")
                                    </a>

                                    <a href="@book.DownloadUrl"
                                       class="proceeding-action-btn proceeding-download-btn">
                                        <i class="fas fa-download"></i>
                                        @L("DownloadPdfButton", "PDF İndir")
                                    </a>
                                </div>
                            </div>

                        </article>
                    }

                </div>

                <div class="proceedings-empty d-none" id="noProceedingsResult">
                    <div class="proceedings-empty-icon">
                        <i class="fas fa-magnifying-glass"></i>
                    </div>

                    <h3>
                        @L("NoResultTitle", "Arama sonucu bulunamadı")
                    </h3>

                    <p>
                        @L("NoResultDescription", "Farklı bir bildiri kitabı adı, kongre adı veya yıl deneyin.")
                    </p>
                </div>
            }

        </div>
    </div>

</section>

<style>
    .page-proceedings main,
    .page-proceedings .main-content,
    .page-proceedings .page-content,
    .page-proceedings .content-wrapper {
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    .proceedings-page {
        padding-top: 0;
        background: #f8fafc;
        min-height: 100vh;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .proceedings-hero {
        position: relative;
        overflow: hidden;
        padding: calc(4rem + 86px) 0 2.4rem;
        background: radial-gradient(circle at 8% 28%, rgba(0, 174, 239, 0.18), transparent 22%), radial-gradient(circle at 88% 18%, rgba(13, 110, 253, 0.15), transparent 28%), linear-gradient(135deg, #f8fcff 0%, #eef8ff 48%, #e8f3ff 100%);
        border-bottom-left-radius: 46px;
        border-bottom-right-radius: 46px;
    }

    .proceedings-hero::before {
        content: "";
        position: absolute;
        left: -120px;
        top: -150px;
        width: 360px;
        height: 360px;
        border-radius: 999px;
        border: 2px solid rgba(13, 110, 253, 0.10);
    }

    .proceedings-hero::after {
        content: "";
        position: absolute;
        right: -160px;
        bottom: -200px;
        width: 460px;
        height: 460px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.46);
    }

    .proceedings-hero-shape {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
    }

    .shape-one {
        left: 9%;
        top: 53%;
        width: 34px;
        height: 34px;
        background: rgba(13, 110, 253, 0.18);
        box-shadow: 0 18px 44px rgba(13, 110, 253, 0.22);
    }

    .shape-two {
        right: 16%;
        top: 22%;
        width: 9px;
        height: 9px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 90px 50px 0 rgba(255, 255, 255, 0.75), 160px 100px 0 rgba(255, 255, 255, 0.75);
    }

    .shape-three {
        right: 9%;
        bottom: 20%;
        width: 80px;
        height: 80px;
        background: rgba(0, 174, 239, 0.08);
    }

    .proceedings-hero-content {
        position: relative;
        z-index: 2;
        max-width: 1180px;
        margin: 0 auto;
        text-align: center;
    }

    .proceedings-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        font-size: 0.86rem;
        font-weight: 900;
        margin-bottom: 1.25rem;
    }

    .proceedings-title {
        margin: 0;
        color: #0f172a;
        font-size: clamp(2.25rem, 4.5vw, 4rem);
        font-weight: 900;
        letter-spacing: -0.06em;
        line-height: 1.05;
    }

    .proceedings-description {
        margin: 1rem auto 0;
        max-width: 780px;
        color: #64748b;
        font-size: 1.12rem;
        font-weight: 500;
        line-height: 1.7;
    }

    .proceedings-search-card {
        max-width: 1120px;
        margin: 2.1rem auto 0;
        padding: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 26px;
        box-shadow: 0 22px 50px rgba(15, 23, 42, 0.10);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .proceedings-search-input-wrap {
        flex: 1;
        min-height: 58px;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0 1.1rem;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #dbe3ef;
    }

    .proceedings-search-input-wrap i {
        color: #64748b;
        font-size: 1.1rem;
    }

    .proceedings-search-input-wrap input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 600;
    }

    .proceedings-search-input-wrap input::placeholder {
        color: #94a3b8;
        font-weight: 600;
    }

    .proceedings-search-button {
        min-height: 58px;
        min-width: 150px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        border: none;
        border-radius: 18px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-size: 0.98rem;
        font-weight: 900;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.28);
        transition: all 0.2s ease;
    }

    .proceedings-search-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 20px 40px rgba(13, 110, 253, 0.34);
    }

    .proceedings-filter-chips {
        margin-top: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.7rem;
    }

    .proceeding-chip {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0 1rem;
        border-radius: 999px;
        border: 1px solid #dbe3ef;
        background: rgba(255, 255, 255, 0.86);
        color: #334155;
        font-size: 0.82rem;
        font-weight: 800;
        transition: all 0.2s ease;
    }

    .proceeding-chip:hover,
    .proceeding-chip.active {
        border-color: rgba(13, 110, 253, 0.35);
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
    }

    .proceedings-list-section {
        padding: 2.2rem 0 4rem;
    }

    .proceedings-list-header {
        margin-bottom: 1.35rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .proceedings-list-header h2 {
        margin: 0;
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 900;
        letter-spacing: -0.03em;
    }

    .proceedings-list-header p {
        margin: 0.35rem 0 0;
        color: #64748b;
        font-size: 0.94rem;
        font-weight: 600;
    }

    .proceedings-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 900;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    }

    .proceedings-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.35rem;
    }

    .proceeding-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
        transition: all 0.24s ease;
    }

    .proceeding-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 26px 60px rgba(15, 23, 42, 0.11);
    }

    .proceeding-cover {
        position: relative;
        min-height: 245px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at top left, rgba(13, 110, 253, 0.06), transparent 35%), #f8fafc;
        border-bottom: 1px solid #edf2f7;
    }

    .proceeding-year-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.8rem;
        border-radius: 12px;
        background: #ffffff;
        color: #0d6efd;
        font-size: 0.85rem;
        font-weight: 900;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.10);
        border: 1px solid #edf2f7;
    }

    .proceeding-isbn-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        max-width: 165px;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.8rem;
        border-radius: 12px;
        background: #0f172a;
        color: #ffffff;
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.35px;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.12);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .proceeding-book-visual {
        position: relative;
        width: 150px;
        height: 180px;
        perspective: 900px;
    }

    .book-spine {
        position: absolute;
        left: -16px;
        top: 12px;
        width: 32px;
        height: 162px;
        border-radius: 14px 0 0 14px;
        background: rgba(15, 23, 42, 0.18);
        transform: skewY(-7deg);
    }

    .book-front {
        position: relative;
        width: 150px;
        height: 180px;
        border-radius: 20px;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 22px 42px rgba(15, 23, 42, 0.18);
        overflow: hidden;
    }

    .book-front::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.20), transparent 42%), radial-gradient(circle at top right, rgba(255,255,255,0.20), transparent 30%);
    }

    .book-front-icon,
    .book-front-title,
    .book-front-year {
        position: relative;
        z-index: 2;
    }

    .book-front-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.18);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.85rem;
        margin-bottom: 1rem;
    }

    .book-front-title {
        font-size: 0.95rem;
        font-weight: 900;
        text-align: center;
        line-height: 1.25;
    }

    .book-front-year {
        margin-top: 0.8rem;
        font-size: 0.8rem;
        font-weight: 900;
        opacity: 0.85;
    }

    .proceeding-accent-blue .book-front {
        background: linear-gradient(135deg, #0d47a1, #0d6efd);
    }

    .proceeding-accent-green .book-front {
        background: linear-gradient(135deg, #15803d, #22c55e);
    }

    .proceeding-accent-orange .book-front {
        background: linear-gradient(135deg, #ff4d22, #ff7a1a);
    }

    .proceeding-body {
        padding: 1.55rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .proceeding-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .proceeding-category,
    .proceeding-status {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 900;
        padding: 0.35rem 0.72rem;
    }

    .proceeding-category {
        background: #f1f5f9;
        color: #334155;
    }

    .proceeding-status {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .proceeding-card-title {
        margin: 0;
        min-height: 66px;
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.35;
    }

    .proceeding-editors {
        margin: 0.85rem 0 0;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.55;
        min-height: 44px;
    }

    .proceeding-meta {
        margin-top: 1rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.85rem;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .proceeding-meta span {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
    }

    .proceeding-meta i {
        color: #0d6efd;
    }

    .proceeding-actions {
        margin-top: 1.4rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .proceeding-action-btn {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border-radius: 14px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 900;
        border: 1px solid #dbe3ef;
        transition: all 0.2s ease;
    }

    .proceeding-view-btn {
        color: #0d6efd;
        background: rgba(13, 110, 253, 0.06);
        border-color: rgba(13, 110, 253, 0.20);
    }

    .proceeding-view-btn:hover {
        color: #ffffff;
        background: #0d6efd;
        border-color: #0d6efd;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.22);
        transform: translateY(-1px);
    }

    .proceeding-download-btn {
        color: #ef4444;
        background: rgba(239, 68, 68, 0.06);
        border-color: rgba(239, 68, 68, 0.20);
    }

    .proceeding-download-btn:hover {
        color: #ffffff;
        background: #ef4444;
        border-color: #ef4444;
        box-shadow: 0 14px 28px rgba(239, 68, 68, 0.20);
        transform: translateY(-1px);
    }

    .proceedings-empty {
        padding: 4rem 1.5rem;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .proceedings-empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 1rem;
        border-radius: 24px;
        background: rgba(0, 174, 239, 0.10);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
    }

    .proceedings-empty h3 {
        margin: 0 0 0.4rem;
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
    }

    .proceedings-empty p {
        margin: 0;
        color: #64748b;
        font-weight: 600;
    }

    @@media (max-width: 1200px) {
        .proceedings-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .proceedings-hero {
            padding: calc(2.5rem + 74px) 0 1.8rem;
            border-bottom-left-radius: 30px;
            border-bottom-right-radius: 30px;
        }

        .proceedings-search-card {
            flex-direction: column;
            align-items: stretch;
            border-radius: 22px;
        }

        .proceedings-search-button {
            width: 100%;
        }

        .proceedings-grid {
            grid-template-columns: 1fr;
        }

        .proceeding-cover {
            min-height: 225px;
        }

        .proceeding-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("proceedingsSearchInput");
            const searchButton = document.getElementById("proceedingsSearchButton");
            const cards = Array.from(document.querySelectorAll(".proceeding-card"));
            const noResultBox = document.getElementById("noProceedingsResult");
            const visibleCount = document.getElementById("visibleProceedingsCount");
            const chips = Array.from(document.querySelectorAll(".proceeding-chip"));

            let activeFilter = "";

            function normalizeText(value) {
                return (value || "")
                    .toString()
                    .toLocaleLowerCase("tr-TR")
                    .replaceAll("ı", "i")
                    .replaceAll("İ", "i");
            }

            function applyFilters() {
                const searchTerm = searchInput ? normalizeText(searchInput.value.trim()) : "";
                const filterTerm = normalizeText(activeFilter);

                let count = 0;

                cards.forEach(function (card) {
                    const searchText = normalizeText(card.getAttribute("data-search"));

                    const matchesSearch = !searchTerm || searchText.includes(searchTerm);

                    const matchesFilter = !filterTerm || filterTerm
                        .split(" ")
                        .filter(Boolean)
                        .some(function (term) {
                            return searchText.includes(term);
                        });

                    const isVisible = matchesSearch && matchesFilter;

                    card.classList.toggle("d-none", !isVisible);

                    if (isVisible) {
                        count++;
                    }
                });

                if (visibleCount) {
                    visibleCount.textContent = count;
                }

                if (noResultBox) {
                    noResultBox.classList.toggle("d-none", count !== 0);
                }
            }

            if (searchButton) {
                searchButton.addEventListener("click", applyFilters);
            }

            if (searchInput) {
                searchInput.addEventListener("input", applyFilters);

                searchInput.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        applyFilters();
                    }
                });
            }

            chips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    chips.forEach(function (item) {
                        item.classList.remove("active");
                    });

                    chip.classList.add("active");
                    activeFilter = chip.getAttribute("data-filter") || "";

                    applyFilters();
                });
            });

            applyFilters();
        });
    </script>
}
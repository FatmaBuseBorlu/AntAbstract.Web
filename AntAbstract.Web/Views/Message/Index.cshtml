@using AntAbstract.Domain.Entities
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var inboxMessages = ViewBag.Inbox as List<AntAbstract.Domain.Entities.Message>;
    var sentMessages = ViewBag.Sent as List<AntAbstract.Domain.Entities.Message>;
}

<style>
    .message-nav .list-group-item {
        border: none;
        border-radius: 12px !important;
        margin-bottom: 5px;
        padding: 12px 18px;
        color: #64748b;
        font-weight: 600;
        transition: all 0.2s;
    }

        .message-nav .list-group-item.active {
            background-color: #e0f2fe !important;
            color: #00aeef !important;
            box-shadow: none;
        }

        .message-nav .list-group-item:hover:not(.active) {
            background-color: #f8fafc;
            color: #00aeef;
        }

    .message-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        background: #fff;
        overflow: hidden;
    }

    .msg-item {
        border-left: 4px solid transparent;
        transition: all 0.2s;
    }

        .msg-item.unread {
            background-color: #f0f9ff;
            border-left-color: #00aeef;
        }

        .msg-item:hover {
            background-color: #f8fafc;
            transform: translateX(5px);
        }

    .msg-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        background-color: #00aeef;
        color: white;
        flex-shrink: 0;
    }

    .btn-compose {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        padding: 12px 25px;
        border-radius: 12px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

        .btn-compose:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
        }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">@Localizer["PageHeading"]</h3>
            <p class="text-muted small mb-0">@Localizer["PageDescription"]</p>
        </div>
        <a href="/Message/Create" class="btn btn-compose text-white">
            <i class="fas fa-plus me-2"></i> @Localizer["NewMessageButton"]
        </a>
    </div>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="list-group message-nav shadow-sm bg-white p-2 rounded-4 border-0">
                <a class="list-group-item list-group-item-action active" id="list-inbox-list" data-bs-toggle="list" href="#list-inbox" role="tab">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-inbox me-2"></i> @Localizer["InboxTab"]</span>
                        <span class="badge rounded-pill bg-primary">@inboxMessages?.Count</span>
                    </div>
                </a>
                <a class="list-group-item list-group-item-action" id="list-sent-list" data-bs-toggle="list" href="#list-sent" role="tab">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-paper-plane me-2"></i> @Localizer["SentTab"]</span>
                        <span class="badge rounded-pill bg-secondary bg-opacity-25 text-secondary">@sentMessages?.Count</span>
                    </div>
                </a>
                <a href="#" class="list-group-item list-group-item-action disabled text-muted opacity-50">
                    <i class="fas fa-trash-alt me-2"></i> @Localizer["TrashTab"]
                </a>
            </div>

            <div class="mt-4 p-3 bg-primary bg-opacity-10 rounded-4 text-primary small">
                <i class="fas fa-info-circle me-2"></i> @Localizer["InfoBoxText"]
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content" id="nav-tabContent">

                <div class="tab-pane fade show active" id="list-inbox" role="tabpanel">
                    <div class="message-card">
                        <div class="card-header bg-white p-3 border-bottom-0">
                            <h6 class="fw-bold m-0 text-dark">@Localizer["InboxMessagesHeader"]</h6>
                        </div>
                        <div class="list-group list-group-flush">
                            @if (inboxMessages != null && inboxMessages.Any())
                            {
                                @foreach (var msg in inboxMessages)
                                {
                                    <a asp-action="Details" asp-route-id="@msg.Id" class="list-group-item list-group-item-action p-4 msg-item @(msg.IsRead ? "" : "unread")">
                                        <div class="d-flex align-items-center">
                                            <div class="msg-avatar me-3">
                                                @(msg.Sender?.FirstName?.Substring(0, 1).ToUpper() ?? "S")
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <h6 class="mb-0 fw-bold @(msg.IsRead ? "text-dark" : "text-primary")">@msg.Subject</h6>
                                                    <small class="text-muted">@msg.SentDate.ToString("dd MMM HH:mm")</small>
                                                </div>
                                                <p class="mb-1 text-muted small text-truncate" style="max-width: 500px;">@msg.Content</p>
                                                <small class="text-primary fw-600">
                                                    <i class="fas fa-user-circle me-1"></i>
                                                    @(msg.Sender != null
                                                                                                ? $"{msg.Sender.FirstName} {msg.Sender.LastName}"
                                                                                                : Localizer["SystemSender"].Value)
                                        </small>
                                    </div>
                                </div>
                            </a>
                                                        }
                            }
                            else
                            {
                                <div class="text-center p-5">
                                    <div class="mb-3">
                                        <i class="fas fa-envelope-open-text fa-4x text-muted opacity-25"></i>
                                    </div>
                                    <h6 class="text-dark fw-bold">@Localizer["InboxEmptyTitle"]</h6>
                                    <p class="text-muted small">@Localizer["InboxEmptyText"]</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="list-sent" role="tabpanel">
                    <div class="message-card">
                        <div class="card-header bg-white p-3 border-bottom-0">
                            <h6 class="fw-bold m-0 text-dark">@Localizer["SentMessagesHeader"]</h6>
                        </div>
                        <div class="list-group list-group-flush">
                            @if (sentMessages != null && sentMessages.Any())
                            {
                                @foreach (var msg in sentMessages)
                                {
                                    <div class="list-group-item list-group-item-action p-4 msg-item">
                                        <div class="d-flex align-items-center">
                                            <div class="msg-avatar bg-secondary me-3">
                                                <i class="fas fa-paper-plane"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <h6 class="mb-0 fw-bold text-dark">@msg.Subject</h6>
                                                    <small class="text-muted">@msg.SentDate.ToString("dd MMM HH:mm")</small>
                                                </div>
                                                <p class="mb-1 text-muted small text-truncate" style="max-width: 500px;">@msg.Content</p>
                                                <small class="text-muted">
                                                    <i class="fas fa-user-check me-1"></i>
                                                    @Localizer["RecipientLabel"] @(msg.Receiver?.FirstName ?? Localizer["DefaultRecipient"].Value)
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center p-5">
                                    <div class="mb-3 text-muted opacity-25">
                                        <i class="fas fa-paper-plane fa-4x"></i>
                                    </div>
                                    <h6 class="text-dark fw-bold">@Localizer["SentEmptyTitle"]</h6>
                                    <p class="text-muted small">@Localizer["SentEmptyText"]</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
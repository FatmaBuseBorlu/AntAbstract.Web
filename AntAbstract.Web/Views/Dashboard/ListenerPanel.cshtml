@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization

@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Dinleyici Paneli";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";

    string L(string tr, string en) => isEnglish ? en : tr;

    var conference   = ViewBag.Conference as Conference;
    var slug         = ViewBag.Slug as string ?? "";
    var registration = ViewBag.Registration as Registration;
    var attendance   = ViewBag.Attendance as ConferenceAttendance;
    var certificate  = ViewBag.Certificate as Certificate;
    var sessionCount = (int)(ViewBag.SessionCount ?? 0);
    var fullName     = ViewBag.FullName as string ?? "";

    var attendanceSeconds  = attendance?.TotalSeconds ?? 0;
    var requiredSeconds    = attendance?.RequiredSeconds ?? 600;
    var attendanceComplete = attendance?.CompletedAt.HasValue == true || attendanceSeconds >= requiredSeconds;
    var attendancePct      = requiredSeconds > 0
        ? (int)Math.Min(100, Math.Round((double)attendanceSeconds / requiredSeconds * 100))
        : 0;

    var isPaid = registration?.IsPaid == true || (registration?.Amount ?? 1) <= 0;
}

<div class="container-fluid px-4 py-4">

    <!-- Başlık -->
    <div class="mb-4">
        <p class="text-muted mb-1 small text-uppercase fw-semibold">
            @L("Dinleyici Paneli", "Listener Panel")
        </p>
        <h4 class="fw-bold mb-0">
            @(conference?.Title ?? L("Kongre", "Conference"))
        </h4>
        @if (!string.IsNullOrWhiteSpace(fullName))
        {
            <p class="text-muted mt-1">@L("Hoş geldiniz,", "Welcome,") <strong>@fullName</strong></p>
        }
    </div>

    <!-- Durum Kartları -->
    <div class="row g-3 mb-4">

        <!-- Kayıt -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 @(registration != null ? "bg-success bg-opacity-10" : "bg-secondary bg-opacity-10")">
                            <i class="fas fa-id-card fs-4 @(registration != null ? "text-success" : "text-secondary")"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">@L("Kayıt Durumu", "Registration Status")</p>
                            @if (registration != null)
                            {
                                <p class="fw-semibold mb-0 text-success">@L("Kayıtlı", "Registered")</p>
                                <small class="text-muted">@(registration.RegistrationType?.Name ?? "")</small>
                            }
                            else
                            {
                                <p class="fw-semibold mb-0 text-secondary">@L("Kayıt Yok", "Not Registered")</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ödeme -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 @(isPaid ? "bg-success bg-opacity-10" : "bg-warning bg-opacity-10")">
                            <i class="fas fa-credit-card fs-4 @(isPaid ? "text-success" : "text-warning")"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">@L("Ödeme Durumu", "Payment Status")</p>
                            @if (registration == null)
                            {
                                <p class="fw-semibold mb-0 text-secondary">—</p>
                            }
                            else if (isPaid)
                            {
                                <p class="fw-semibold mb-0 text-success">@L("Ödendi", "Paid")</p>
                            }
                            else
                            {
                                <p class="fw-semibold mb-0 text-warning">@L("Ödeme Bekliyor", "Pending Payment")</p>
                                <small>
                                    <a href="/@slug/payment" class="text-warning">@L("Ödeme Yap →", "Pay Now →")</a>
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Katılım -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 @(attendanceComplete ? "bg-success bg-opacity-10" : "bg-primary bg-opacity-10")">
                            <i class="fas fa-clock fs-4 @(attendanceComplete ? "text-success" : "text-primary")"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p class="text-muted small mb-1">@L("Katılım Süresi", "Attendance")</p>
                            @if (attendance == null)
                            {
                                <p class="fw-semibold mb-0 text-secondary">@L("Henüz Katılmadı", "Not Started")</p>
                            }
                            else
                            {
                                <p class="fw-semibold mb-1 @(attendanceComplete ? "text-success" : "text-primary")">
                                    @(attendanceComplete
                                        ? L("Tamamlandı ✓", "Completed ✓")
                                        : $"{attendancePct}% — {attendanceSeconds / 60} dk")
                                </p>
                                <div class="progress" style="height:6px;">
                                    <div class="progress-bar @(attendanceComplete ? "bg-success" : "")"
                                         role="progressbar"
                                         style="width:@(attendancePct)%"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sertifika -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 p-3 @(certificate != null ? "bg-success bg-opacity-10" : "bg-secondary bg-opacity-10")">
                            <i class="fas fa-certificate fs-4 @(certificate != null ? "text-success" : "text-secondary")"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">@L("Sertifika", "Certificate")</p>
                            @if (certificate != null)
                            {
                                <p class="fw-semibold mb-0 text-success">@L("Hazır", "Ready")</p>
                                <small>
                                    <a href="/Certificates/Download/@certificate.Id" class="text-success">
                                        @L("İndir →", "Download →")
                                    </a>
                                </small>
                            }
                            else if (attendanceComplete)
                            {
                                <p class="fw-semibold mb-0 text-warning">@L("Oluşturuluyor…", "Generating…")</p>
                            }
                            else
                            {
                                <p class="fw-semibold mb-0 text-secondary">@L("Henüz Yok", "Not Yet")</p>
                                <small class="text-muted">@L("Katılım tamamlanınca oluşur", "Generated after attendance")</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Hızlı Erişim -->
    <div class="row g-3">
        <div class="col-12">
            <h6 class="fw-semibold text-muted text-uppercase small mb-3">
                @L("Hızlı Erişim", "Quick Access")
            </h6>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
            <a href="/@slug/Program/Index" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="fas fa-calendar-alt fs-3 text-primary mb-2 d-block"></i>
                    <span class="fw-semibold">@L("Program", "Program")</span>
                    @if (sessionCount > 0)
                    {
                        <small class="text-muted d-block">@sessionCount @L("oturum", "sessions")</small>
                    }
                </div>
            </a>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
            <a href="/Certificates" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="fas fa-award fs-3 text-warning mb-2 d-block"></i>
                    <span class="fw-semibold">@L("Sertifikalarım", "My Certificates")</span>
                </div>
            </a>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
            <a href="/@slug/accommodation" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="fas fa-hotel fs-3 text-info mb-2 d-block"></i>
                    <span class="fw-semibold">@L("Konaklama", "Accommodation")</span>
                </div>
            </a>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
            <a href="/@slug/proceedings" class="card border-0 shadow-sm text-decoration-none text-dark h-100">
                <div class="card-body text-center py-4">
                    <i class="fas fa-book-open fs-3 text-secondary mb-2 d-block"></i>
                    <span class="fw-semibold">@L("Bildiri Kitabı", "Proceedings")</span>
                </div>
            </a>
        </div>

    </div>

</div>

@using AntAbstract.Domain.Entities
@using System
@using System.Collections.Generic

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var totalTenants       = (int)(ViewBag.TotalTenants       ?? 0);
    var totalConferences   = (int)(ViewBag.TotalConferences   ?? 0);
    var totalUsers         = (int)(ViewBag.TotalUsers         ?? 0);
    var totalSubmissions   = (int)(ViewBag.TotalSubmissions   ?? 0);
    var totalRegistrations = (int)(ViewBag.TotalRegistrations ?? 0);
    var totalCertificates  = (int)(ViewBag.TotalCertificates  ?? 0);
    var activeConferences  = (int)(ViewBag.ActiveConferences  ?? 0);

    var totalAdmins    = (int)(ViewBag.TotalAdmins    ?? 0);
    var totalAuthors   = (int)(ViewBag.TotalAuthors   ?? 0);
    var totalReferees  = (int)(ViewBag.TotalReferees  ?? 0);
    var totalListeners = (int)(ViewBag.TotalListeners ?? 0);

    var submissionAccepted    = (int)(ViewBag.SubmissionAccepted    ?? 0);
    var submissionRejected    = (int)(ViewBag.SubmissionRejected    ?? 0);
    var submissionPending     = (int)(ViewBag.SubmissionPending     ?? 0);
    var submissionUnderReview = (int)(ViewBag.SubmissionUnderReview ?? 0);

    var recentConferences   = ViewBag.RecentConferences   as List<Conference>   ?? new List<Conference>();
    var recentRegistrations = ViewBag.RecentRegistrations as List<Registration> ?? new List<Registration>();
}

<style>
    .sa-section-title {
        font-size: .7rem; font-weight: 800; letter-spacing: .12em;
        text-transform: uppercase; color: #64748b; margin-bottom: 14px;
    }
    .sa-stat-card {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 22px;
        padding: 1.05rem; box-shadow: 0 12px 30px rgba(15,23,42,.04);
        display: flex; align-items: center; gap: .85rem; min-height: 96px;
        transition: all .2s ease; height: 100%;
    }
    .sa-stat-card:hover { transform: translateY(-2px); box-shadow: 0 18px 42px rgba(15,23,42,.075); }
    .sa-stat-card .sa-icon {
        width: 46px; height: 46px; min-width: 46px; border-radius: 16px;
        display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .sa-stat-card .sa-value { font-size: 1.35rem; font-weight: 900; line-height: 1.1; color: #0f172a; }
    .sa-stat-card .sa-label { font-size: .78rem; font-weight: 850; color: #64748b; margin-top: .25rem; }
    .action-card {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 22px;
        padding: 22px; box-shadow: 0 12px 30px rgba(15,23,42,.04);
        transition: all .2s ease; height: 100%;
        text-decoration: none; color: inherit; display: flex; flex-direction: column;
    }
    .action-card:hover { transform: translateY(-3px); box-shadow: 0 18px 42px rgba(15,23,42,.075); color: inherit; }
    .action-card .ac-icon {
        width: 48px; height: 48px; border-radius: 14px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.2rem; margin-bottom: 14px;
    }
    .bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .bar-label { width: 120px; font-size: .8rem; color: #475569; }
    .bar-wrap { flex: 1; background: #f1f5f9; border-radius: 99px; height: 8px; }
    .bar-fill { height: 8px; border-radius: 99px; }
    .bar-count { width: 40px; text-align: right; font-size: .8rem; font-weight: 700; color: #0f172a; }
    .recent-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
    .recent-row:last-child { border-bottom: none; }
    .recent-avatar {
        width: 34px; height: 34px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: .7rem; font-weight: 800; color: #fff; flex-shrink: 0;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
    }
    [data-theme="dark"] .sa-stat-card { background: #1e293b; border-color: #334155; }
    [data-theme="dark"] .sa-stat-card .sa-value { color: #f1f5f9; }
    [data-theme="dark"] .sa-stat-card .sa-label { color: #94a3b8; }
    [data-theme="dark"] .action-card { background: #1e293b; border-color: #334155; }
    [data-theme="dark"] .action-card:hover { background: #0f172a; }
    [data-theme="dark"] .action-card strong { color: #f1f5f9; }
    [data-theme="dark"] .bar-label { color: #94a3b8; }
    [data-theme="dark"] .bar-wrap { background: #334155; }
    [data-theme="dark"] .bar-count { color: #f1f5f9; }
    [data-theme="dark"] .recent-row { border-color: #334155; }
</style>

<div class="admin-hero">
    <div class="admin-hero-left">
        <div class="admin-hero-icon" style="background:linear-gradient(135deg,#6366f1,#3b82f6);">
            <i class="fas fa-shield-alt"></i>
        </div>
        <div>
            <div class="admin-hero-kicker">SUPER ADMIN PANEL</div>
            <h3 class="admin-hero-title">@Localizer["SuperAdmin"]</h3>
            <p class="admin-hero-lead">@Localizer["SuperAdminDescription"]</p>
        </div>
    </div>
    <div class="admin-hero-actions">
        <a href="/Admin" class="admin-hero-btn admin-hero-btn-light">
            <i class="fas fa-arrow-left"></i> @Localizer["BackToPanel"]
        </a>
        <a href="/Admin/SystemReports" class="admin-hero-btn admin-hero-btn-primary">
            <i class="fas fa-chart-line"></i> @Localizer["Refresh"]
        </a>
    </div>
</div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-blue"><i class="fas fa-building"></i></div>
                <div>
                    <div class="sa-value">@totalTenants</div>
                    <div class="sa-label">@Localizer["TotalInstitutions"]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-green"><i class="fas fa-calendar-alt"></i></div>
                <div>
                    <div class="sa-value">@totalConferences</div>
                    <div class="sa-label">@Localizer["TotalConferences"]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-green"><i class="fas fa-check-circle"></i></div>
                <div>
                    <div class="sa-value">@activeConferences</div>
                    <div class="sa-label">@Localizer["ActiveConferences"]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-cyan"><i class="fas fa-users"></i></div>
                <div>
                    <div class="sa-value">@totalUsers</div>
                    <div class="sa-label">@Localizer["TotalUsers"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-orange"><i class="fas fa-user-shield"></i></div>
                <div>
                    <div class="sa-value">@totalAdmins</div>
                    <div class="sa-label">Admin</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-green"><i class="fas fa-pen"></i></div>
                <div>
                    <div class="sa-value">@totalAuthors</div>
                    <div class="sa-label">@Localizer["RoleAuthor"]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-purple"><i class="fas fa-user-graduate"></i></div>
                <div>
                    <div class="sa-value">@totalReferees</div>
                    <div class="sa-label">@Localizer["RoleReferee"]</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="sa-stat-card">
                <div class="sa-icon stat-red"><i class="fas fa-file-alt"></i></div>
                <div>
                    <div class="sa-value">@totalSubmissions</div>
                    <div class="sa-label">@Localizer["TotalSubmissions"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-12 col-lg-4">
            <div class="admin-list-card" style="padding:1.2rem;height:100%;">
                <h6 class="sa-section-title mb-3">@Localizer["RoleDistribution"]</h6>
                @{
                    var roleRows = new[]
                    {
                        ("Admin",     totalAdmins,    "#3b82f6"),
                        (@Localizer["RoleAuthor"].Value,     totalAuthors,   "#22c55e"),
                        (@Localizer["RoleReferee"].Value,     totalReferees,  "#f59e0b"),
                        (@Localizer["RoleListener"].Value, totalListeners, "#a855f7"),
                    };
                    var maxRole = roleRows.Max(r => r.Item2) is int mx && mx > 0 ? mx : 1;
                }
                @foreach (var (roleName, count, color) in roleRows)
                {
                    var pct = (int)Math.Round((double)count / maxRole * 100);
                    <div class="bar-row">
                        <span class="bar-label">@roleName</span>
                        <div class="bar-wrap">
                            <div class="bar-fill" style="width:@(pct)%;background:@color;"></div>
                        </div>
                        <span class="bar-count">@count</span>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="admin-list-card" style="padding:1.2rem;height:100%;">
                <h6 class="sa-section-title mb-3">@Localizer["SubmissionStatus"]</h6>
                @{
                    var subRows = new[]
                    {
                        (@Localizer["Accepted"].Value,     submissionAccepted,    "#22c55e"),
                        (@Localizer["UnderReview"].Value,       submissionUnderReview, "#3b82f6"),
                        (@Localizer["AwaitingDecision"].Value,   submissionPending,     "#f59e0b"),
                        (@Localizer["Rejected"].Value,       submissionRejected,    "#ef4444"),
                    };
                    var maxSub = subRows.Max(r => r.Item2) is int ms && ms > 0 ? ms : 1;
                }
                @foreach (var (label, count, color) in subRows)
                {
                    var pct = (int)Math.Round((double)count / maxSub * 100);
                    <div class="bar-row">
                        <span class="bar-label">@label</span>
                        <div class="bar-wrap">
                            <div class="bar-fill" style="width:@(pct)%;background:@color;"></div>
                        </div>
                        <span class="bar-count">@count</span>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="admin-list-card" style="padding:1.2rem;height:100%;">
                <h6 class="sa-section-title mb-3">@Localizer["RecentRegistrations"]</h6>
                @if (!recentRegistrations.Any())
                {
                    <p class="text-muted small">Henüz kayıt yok.</p>
                }
                @foreach (var reg in recentRegistrations)
                {
                    var userName = reg.AppUser != null
                        ? $"{reg.AppUser.FirstName} {reg.AppUser.LastName}".Trim()
                        : reg.BillingName ?? "—";
                    var initial = string.IsNullOrWhiteSpace(userName) ? "?" : userName[0].ToString().ToUpper();
                    <div class="recent-row">
                        <div class="recent-avatar">@initial</div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold text-truncate" style="font-size:.85rem;">@(string.IsNullOrWhiteSpace(userName) ? "—" : userName)</div>
                            <div class="text-muted text-truncate" style="font-size:.75rem;">@(reg.Conference?.Title ?? "—")</div>
                        </div>
                        <span class="badge @(reg.IsPaid ? "bg-success" : "bg-warning text-dark")" style="font-size:.65rem;">
                            @(reg.IsPaid ? Localizer["Paid"].Value : Localizer["Pending"].Value)
                        </span>
                    </div>
                }
            </div>
        </div>

    </div>

    <div class="admin-list-card mb-4" style="padding:1.2rem;">
        @if (!recentConferences.Any())
        {
            <p class="text-muted small mb-0">Henüz kongre eklenmemiş.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th class="text-center">@Localizer["Status"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in recentConferences)
                        {
                            var now2 = DateTime.UtcNow;
                            var isActive = c.StartDate <= now2 && c.EndDate >= now2;
                            var isUpcoming = c.StartDate > now2;
                            var slug2 = c.Tenant?.Slug ?? c.Slug ?? "";
                            <tr>
                                <td class="fw-semibold">@(c.Title ?? "—")</td>
                                <td class="text-muted">@(c.Tenant?.Name ?? "—")</td>
                                <td class="text-muted" style="font-size:.82rem;">@c.StartDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-muted" style="font-size:.82rem;">@c.EndDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-center">
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <span class="badge bg-info text-dark"></span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"></span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(slug2))
                                    {
                                        <a href="/@slug2/Admin/ConferenceFlow" class="btn btn-xs btn-outline-primary btn-sm py-0 px-2" style="font-size:.75rem;">
                                            @Localizer["Manage"]
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Hızlı Erişim -->
    <p class="sa-section-title">@Localizer["QuickAccess"]</p>
    <div class="row g-3">
        @{
            var quickLinks = new[]
            {
                ("/Admin/Tenants",         "fas fa-building",           "bg-primary bg-opacity-10 text-primary",     Localizer["QA_InstitutionMgmt"].Value,  Localizer["QA_InstitutionDesc"].Value),
                ("/Admin/Users",           "fas fa-user-tie",           "bg-info bg-opacity-10 text-info",           Localizer["QA_Users"].Value,            Localizer["QA_UsersDesc"].Value),
                ("/Admin/AllConferences",  "fas fa-calendar",           "bg-success bg-opacity-10 text-success",     Localizer["QA_AllConferences"].Value,   Localizer["QA_AllConferencesDesc"].Value),
                ("/Admin/SystemReports",   "fas fa-chart-bar",          "bg-warning bg-opacity-10 text-warning",     Localizer["QA_SystemReports"].Value,    Localizer["QA_SystemReportsDesc"].Value),
                ("/Admin/SystemParameters","fas fa-sliders",            "bg-secondary bg-opacity-10 text-secondary", Localizer["QA_SystemParams"].Value,     Localizer["QA_SystemParamsDesc"].Value),
                ("/Admin/CentralVitrin",   "fas fa-store",              "bg-danger bg-opacity-10 text-danger",       Localizer["QA_Showcase"].Value,         Localizer["QA_ShowcaseDesc"].Value),
                ("/Admin/EmailTemplates",  "fas fa-envelope-open-text", "bg-primary bg-opacity-10 text-primary",     Localizer["QA_EmailTemplates"].Value,   Localizer["QA_EmailTemplatesDesc"].Value),
                ("/Admin/Broadcast",       "fas fa-paper-plane",        "bg-info bg-opacity-10 text-info",           Localizer["QA_BulkEmail"].Value,        Localizer["QA_BulkEmailDesc"].Value),
                ("/Admin/AuditLogs",       "fas fa-history",            "bg-secondary bg-opacity-10 text-secondary", Localizer["QA_AuditLog"].Value,         Localizer["QA_AuditLogDesc"].Value),
                ("/Admin/Health",          "fas fa-heartbeat",          "bg-danger bg-opacity-10 text-danger",       Localizer["QA_Health"].Value,           Localizer["QA_HealthDesc"].Value),
            };
        }
        @foreach (var (href, icon, iconCls, title, desc) in quickLinks)
        {
            <div class="col-12 col-sm-6 col-xl-4">
                <a href="@href" class="action-card">
                    <div class="ac-icon @iconCls"><i class="@icon"></i></div>
                    <strong class="mb-1">@title</strong>
                    <small class="text-muted mt-1">@desc</small>
                </a>
            </div>
        }
    </div>

</div>

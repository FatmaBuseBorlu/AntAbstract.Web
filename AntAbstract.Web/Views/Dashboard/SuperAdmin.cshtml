@{
    ViewData["Title"] = "Sistem Yönetim Paneli";
    Layout = "_LayoutDashboard";

    var totalTenants = ViewBag.TotalTenants ?? 0;
    var totalConferences = ViewBag.TotalConferences ?? 0;
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var totalAdmins = ViewBag.TotalAdmins ?? 0;
    var totalAuthors = ViewBag.TotalAuthors ?? 0;
    var totalReferees = ViewBag.TotalReferees ?? 0;
}

<style>
    .super-admin-hero {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        color: #ffffff;
        border-radius: 28px;
        padding: 34px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
        margin-bottom: 26px;
    }

        .super-admin-hero h3 {
            font-weight: 900;
            margin-bottom: 10px;
        }

        .super-admin-hero p {
            color: #cbd5e1;
            margin-bottom: 0;
            line-height: 1.7;
        }

    .system-card {
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 16px 42px rgba(15, 23, 42, 0.06);
        padding: 24px;
        height: 100%;
        transition: all 0.22s ease;
    }

        .system-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.10);
        }

    .system-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 16px;
    }

    .system-card h5 {
        color: #0f172a;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .system-card p {
        color: #64748b;
        line-height: 1.65;
        min-height: 52px;
    }

    .system-card a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 10px 18px;
        background: linear-gradient(135deg, #00aeef, #0284c7);
        color: #ffffff;
        text-decoration: none;
        font-weight: 900;
    }

    .stat-box {
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: #ffffff;
        padding: 22px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.05);
    }

    .stat-number {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
        line-height: 1;
    }

    .stat-label {
        color: #64748b;
        font-weight: 800;
        margin-top: 8px;
    }
</style>

<div class="container-fluid">

    <div class="super-admin-hero">
        <h3>
            <i class="fas fa-shield-alt me-2 text-info"></i>
            Sistem Yönetim Paneli
        </h3>

        <p>
            Bu alan sadece sistem sahibine özeldir. Kurumları, kurum adminlerini ve genel kullanıcı yapısını buradan yönetebilirsiniz.
            Kongre kayıt, hakem atama ve bildiri operasyonları kurum adminleri tarafından yapılır.
        </p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4 col-xl-2">
            <div class="stat-box">
                <div class="stat-number">@totalTenants</div>
                <div class="stat-label">Kurum</div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="stat-box">
                <div class="stat-number">@totalConferences</div>
                <div class="stat-label">Kongre</div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="stat-box">
                <div class="stat-number">@totalUsers</div>
                <div class="stat-label">Kullanıcı</div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="stat-box">
                <div class="stat-number">@totalAdmins</div>
                <div class="stat-label">Admin</div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="stat-box">
                <div class="stat-number">@totalAuthors</div>
                <div class="stat-label">Yazar</div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2">
            <div class="stat-box">
                <div class="stat-number">@totalReferees</div>
                <div class="stat-label">Hakem</div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-xl-3">
            <div class="system-card">
                <div class="system-icon">
                    <i class="fas fa-building"></i>
                </div>

                <h5>Kurum Yönetimi</h5>

                <p>
                    Sisteme kurum ekleyin, kurum bilgilerini düzenleyin ve tenant yapısını yönetin.
                </p>

                <a href="/Admin/Tenants">
                    Yönet
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="system-card">
                <div class="system-icon">
                    <i class="fas fa-user-tie"></i>
                </div>

                <h5>Kurum Adminleri</h5>

                <p>
                    Kurumlara admin atayın. Adminler kendi kurumlarının kongre süreçlerini yönetir.
                </p>

                <a href="/Admin/Users">
                    Yönet
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="system-card">
                <div class="system-icon">
                    <i class="fas fa-users"></i>
                </div>

                <h5>Kullanıcı Yönetimi</h5>

                <p>
                    Sistemdeki kullanıcıları, rolleri ve genel erişim durumlarını takip edin.
                </p>

                <a href="/Admin/Users">
                    Yönet
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="system-card">
                <div class="system-icon">
                    <i class="fas fa-chart-line"></i>
                </div>

                <h5>Sistem Raporları</h5>

                <p>
                    Kurum, kullanıcı ve kongre sayıları gibi genel sistem istatistiklerini inceleyin.
                </p>

                <a href="#">
                    İncele
                    <i class="fas fa-clock"></i>
                </a>
            </div>
        </div>

    </div>
</div>
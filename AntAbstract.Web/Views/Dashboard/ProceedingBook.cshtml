@model AntAbstract.Web.Models.ViewModels.Proceedings.ProceedingBookPageViewModel

@using System
@using System.Globalization
@using System.Linq

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string L(string key, string fallback)
    {
        var loc = Localizer.GetString(key);
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    ViewData["Title"] = L("PageTitle", "Bildiri Kitabı");
    Layout = "_LayoutDashboard";

    var hasBook = Model != null
        && Model.IsProceedingBookPublished
        && Model.Books != null
        && Model.Books.Any();

    var book = hasBook
        ? Model!.Books!.FirstOrDefault()
        : null;

    var conferenceTitle = Model?.ConferenceTitle ?? "";

    var publishedDateText = Model?.ProceedingBookPublishedDate.HasValue == true
        ? Model.ProceedingBookPublishedDate.Value.ToLocalTime().ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
        : L("PublishedDateNotFound", "Henüz yayınlanmadı");

    var statusText = hasBook
        ? L("PublishedBadge", "Yayında")
        : L("NotPublishedBadge", "Yayında Değil");

    var fileStatusText = hasBook
        ? L("PdfReadyText", "PDF hazır")
        : L("PdfNotReadyText", "PDF henüz yayınlanmadı");

    var yearText = book?.Year.ToString()
        ?? DateTime.Now.Year.ToString();
}

<style>
    .author-proceeding-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .program-lead strong {
        color: #334155;
        font-weight: 900;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .proceeding-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .proceeding-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .proceeding-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.10);
        color: #00aeef;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .stat-warning {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .proceeding-stat-value {
        color: #0f172a;
        font-size: 1.3rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .proceeding-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.25rem;
    }

    .author-proceeding-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(320px, 0.85fr);
        gap: 1.25rem;
        align-items: start;
    }

    .author-proceeding-card,
    .author-proceeding-side-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .author-proceeding-card-body {
        padding: 1.25rem;
    }

    .book-preview-box {
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        min-height: 280px;
        background: linear-gradient(135deg, #f8fafc, #eef6ff);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .book-year-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        padding: 0 0.8rem;
        border-radius: 12px;
        background: #ffffff;
        color: #0d6efd;
        font-size: 0.85rem;
        font-weight: 900;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
    }

    .book-type-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        padding: 0 0.8rem;
        border-radius: 12px;
        background: #0f172a;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 900;
        box-shadow: 0 10px 22px rgba(15, 23, 42, 0.10);
    }

    .book-cover {
        position: relative;
        width: 150px;
        height: 180px;
    }

    .book-spine {
        position: absolute;
        left: -16px;
        top: 12px;
        width: 32px;
        height: 162px;
        border-radius: 14px 0 0 14px;
        background: rgba(15, 23, 42, 0.16);
        transform: skewY(-7deg);
    }

    .book-front {
        position: relative;
        width: 150px;
        height: 180px;
        border-radius: 20px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 22px 42px rgba(15, 23, 42, 0.18);
        overflow: hidden;
    }

    .book-front::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.20), transparent 42%), radial-gradient(circle at top right, rgba(255,255,255,0.18), transparent 30%);
    }

    .book-front-icon,
    .book-front-title,
    .book-front-year {
        position: relative;
        z-index: 2;
    }

    .book-front-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.18);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.85rem;
        margin-bottom: 1rem;
    }

    .book-front-title {
        font-size: 0.95rem;
        font-weight: 900;
        text-align: center;
        line-height: 1.25;
    }

    .book-front-year {
        margin-top: 0.8rem;
        font-size: 0.8rem;
        font-weight: 900;
        opacity: 0.88;
    }

    .author-proceeding-empty-icon {
        width: 116px;
        height: 116px;
        border-radius: 999px;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #cbd5e1;
        font-size: 3.2rem;
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.06);
        margin-bottom: 1rem;
    }

    .author-proceeding-empty-title {
        color: #0f172a;
        font-size: 1.2rem;
        font-weight: 900;
        margin-bottom: 0.4rem;
    }

    .author-proceeding-empty-text {
        color: #64748b;
        font-size: 0.92rem;
        font-weight: 650;
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .book-info-section {
        padding: 1.35rem 0 0;
    }

    .book-info-title {
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 950;
        letter-spacing: -0.04em;
        line-height: 1.35;
        margin-bottom: 0.55rem;
    }

    .book-info-text {
        color: #64748b;
        font-size: 0.92rem;
        font-weight: 650;
        line-height: 1.65;
        margin-bottom: 1rem;
    }

    .book-meta-list {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.85rem;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 800;
        margin-bottom: 1.25rem;
    }

    .book-meta-list span {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
    }

    .book-meta-list i {
        color: #0d6efd;
    }

    .book-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.15rem;
    }

    .book-action-btn {
        min-height: 42px;
        border-radius: 14px;
        padding: 0 1rem;
        font-size: 0.86rem;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .book-view-btn {
        background: rgba(13, 110, 253, 0.08);
        border: 1px solid rgba(13, 110, 253, 0.22);
        color: #0d6efd;
    }

    .book-download-btn {
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.24);
        color: #ef4444;
    }

    .book-action-btn:hover {
        transform: translateY(-1px);
        text-decoration: none;
    }

    .book-view-btn:hover {
        color: #ffffff;
        background: #0d6efd;
    }

    .book-download-btn:hover {
        color: #ffffff;
        background: #ef4444;
    }

    .side-card-body {
        padding: 1.25rem;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.42rem 0.75rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 900;
        margin-bottom: 1rem;
    }

    .status-published {
        background: #dcfce7;
        color: #15803d;
    }

    .status-unpublished {
        background: #fff7ed;
        color: #f59e0b;
    }

    .side-info-list {
        display: grid;
        gap: 0.95rem;
    }

    .side-info-item {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        color: #475569;
        font-size: 0.9rem;
        font-weight: 750;
        line-height: 1.45;
    }

    .side-info-item i {
        color: #00aeef;
        margin-top: 0.12rem;
        width: 20px;
        text-align: center;
    }

    .side-info-item strong {
        display: block;
        color: #334155;
        font-weight: 950;
        margin-bottom: 0.15rem;
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }

        .proceeding-stats,
        .author-proceeding-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .author-proceeding-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-title {
            font-size: 1.45rem;
        }

        .book-actions {
            flex-direction: column;
        }

        .book-action-btn {
            width: 100%;
        }
    }
</style>

<div class="author-proceeding-page">

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-book-open"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("HeaderTitle", "Bildiri Kitabı")
                </h3>

                <p class="program-lead">
                    @if (!string.IsNullOrWhiteSpace(conferenceTitle))
                    {
                        <strong>@conferenceTitle</strong>
                        <text> @L("HeaderDescriptionWithConference", "kongresine ait bildiri kitabını buradan görüntüleyebilir ve indirebilirsiniz.")</text>
                    }
                    else
                    {
                        @L("HeaderDescription", "Seçili kongreye ait bildiri kitabını buradan görüntüleyebilir ve indirebilirsiniz.")
                    }
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(conferenceTitle))
        {
            <div class="program-conference-pill">
                <i class="fas fa-calendar-check"></i>
                <span>@conferenceTitle</span>
            </div>
        }
    </div>

    <div class="proceeding-stats">
        <div class="proceeding-stat-card">
            <div class="proceeding-stat-icon @(hasBook ? "stat-green" : "stat-warning")">
                <i class="fas @(hasBook ? "fa-circle-check" : "fa-clock")"></i>
            </div>

            <div>
                <div class="proceeding-stat-value">
                    @statusText
                </div>

                <div class="proceeding-stat-label">
                    @L("StatusStatLabel", "Yayın Durumu")
                </div>
            </div>
        </div>

        <div class="proceeding-stat-card">
            <div class="proceeding-stat-icon stat-blue">
                <i class="fas fa-calendar-check"></i>
            </div>

            <div>
                <div class="proceeding-stat-value">
                    @(hasBook ? publishedDateText : "-")
                </div>

                <div class="proceeding-stat-label">
                    @L("PublishedDateStatLabel", "Yayın Tarihi")
                </div>
            </div>
        </div>

        <div class="proceeding-stat-card">
            <div class="proceeding-stat-icon stat-cyan">
                <i class="fas fa-file-pdf"></i>
            </div>

            <div>
                <div class="proceeding-stat-value">
                    @fileStatusText
                </div>

                <div class="proceeding-stat-label">
                    @L("FileStatusStatLabel", "Dosya Durumu")
                </div>
            </div>
        </div>
    </div>

    <div class="author-proceeding-grid">
        <div class="author-proceeding-card">
            <div class="author-proceeding-card-body">
                @if (hasBook && book != null)
                {
                    <div class="book-preview-box">
                        <div class="book-year-badge">
                            @book.Year
                        </div>

                        <div class="book-type-badge">
                            PDF
                        </div>

                        <div class="book-cover">
                            <div class="book-spine"></div>

                            <div class="book-front">
                                <div class="book-front-icon">
                                    <i class="fas fa-file-pdf"></i>
                                </div>

                                <div class="book-front-title">
                                    @L("BookCoverTitle", "Bildiri Kitabı")
                                </div>

                                <div class="book-front-year">
                                    @book.Year
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="book-info-section">
                        <h4 class="book-info-title">
                            @book.ConferenceTitle
                        </h4>

                        <p class="book-info-text">
                            @L("BookDescription", "Bildiri kitabı yayındadır. PDF dosyasını tarayıcıda görüntüleyebilir veya bilgisayarınıza indirebilirsiniz.")
                        </p>

                        <div class="book-meta-list">
                            <span>
                                <i class="fas fa-calendar-check"></i>
                                @book.Year
                            </span>

                            <span>
                                <i class="fas fa-file-pdf"></i>
                                PDF
                            </span>

                            <span>
                                <i class="fas fa-clock"></i>
                                @publishedDateText
                            </span>
                        </div>

                        <div class="book-actions">
                            <a href="@book.FileUrl"
                               target="_blank"
                               class="book-action-btn book-view-btn">
                                <i class="fas fa-eye"></i>
                                @L("ViewBookButton", "Kitabı Gör")
                            </a>

                            <a href="@book.DownloadUrl"
                               class="book-action-btn book-download-btn">
                                <i class="fas fa-download"></i>
                                @L("DownloadPdfButton", "PDF Olarak İndir")
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="book-preview-box">
                        <div>
                            <div class="author-proceeding-empty-icon">
                                <i class="fas fa-file-circle-xmark"></i>
                            </div>

                            <h4 class="author-proceeding-empty-title">
                                @L("NoBookTitle", "Bildiri kitabı henüz yayınlanmadı")
                            </h4>

                            <p class="author-proceeding-empty-text">
                                @L("NoBookDescription", "Bu kongreye ait bildiri kitabı yayınlandığında buradan PDF dosyasını görüntüleyebilir ve indirebilirsiniz.")
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <aside class="author-proceeding-side-card">
            <div class="side-card-body">
                @if (hasBook)
                {
                    <span class="status-pill status-published">
                        <i class="fas fa-circle-check"></i>
                        @L("PublishedBadge", "Yayında")
                    </span>
                }
                else
                {
                    <span class="status-pill status-unpublished">
                        <i class="fas fa-clock"></i>
                        @L("NotPublishedBadge", "Yayında Değil")
                    </span>
                }

                <div class="side-info-list">
                    <div class="side-info-item">
                        <i class="fas fa-calendar-check"></i>

                        <div>
                            <strong>@L("PublishedDateLabel", "Yayın Tarihi")</strong>
                            @publishedDateText
                        </div>
                    </div>

                    <div class="side-info-item">
                        <i class="fas fa-book"></i>

                        <div>
                            <strong>@L("ConferenceLabel", "Kongre")</strong>
                            @conferenceTitle
                        </div>
                    </div>

                    <div class="side-info-item">
                        <i class="fas fa-file-pdf"></i>

                        <div>
                            <strong>@L("FileStatusLabel", "Dosya Durumu")</strong>
                            @fileStatusText
                        </div>
                    </div>

                    <div class="side-info-item">
                        <i class="fas fa-info-circle"></i>

                        <div>
                            <strong>@L("InfoLabel", "Bilgi")</strong>
                            @L("SingleConferenceInfo", "Bu alan sadece seçili kongreye ait bildiri kitabını gösterir.")
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

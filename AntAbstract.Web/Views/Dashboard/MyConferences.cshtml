                                        {
                                            <div class="admin-action-row">
                                                <a href="@conferenceFlowUrl"
                                                   class="small-action-btn">
                                                    <i class="fas fa-stream"></i>
                                                    @Localizer["AdminFlow"]
                                                </a>

                                                <a href="@adminSubmissionsUrl"
                                                   class="small-action-btn">
                                                    <i class="fas fa-file-lines"></i>
                                                    @Localizer["AdminSubmissions"]
                                                </a>

                                                <a href="@adminAssignmentUrl"
                                                   class="small-action-btn">
                                                    <i class="fas fa-user-check"></i>
                                                    @Localizer["AdminAssignReviewer"]

                                            <span>
                                                @GetDateRange(kongre)
                                            </span>
                                        </div>

                                        <div class="card-meta">
                                            <i class="fas fa-map-marker-alt text-danger"></i>

                                            <span>
                                                @cityText
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(kongre.Venue))
                                        {
                                            <div class="card-meta">
                                                <i class="fas fa-building text-secondary"></i>

                                                <span>
                                                    @kongre.Venue
                                                </span>
                                            </div>
                                        }
                                    </div>


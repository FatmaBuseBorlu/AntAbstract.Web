@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Routing
@using System.Globalization
@using System.Linq
@using AntAbstract.Domain.Entities

@inject IViewLocalizer Localizer
@inject AntAbstract.Infrastructure.Context.TenantContext Tc

@model IEnumerable<Conference>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutConferenceSelection.cshtml";

    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;
        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
    };

    var returnUrl = Context.Request.Query["returnUrl"].ToString();

    string? selectedIdStr = null;

    if (Tc.Current != null)
    {
        selectedIdStr = Context.Session.GetString($"SelectedConferenceId:{Tc.Current.Id}");
    }

    selectedIdStr ??= Context.Session.GetString("SelectedConferenceId");

    Guid? selectedConferenceId = Guid.TryParse(selectedIdStr, out var sid)
        ? sid
        : null;

    var registeredConferences = Model?.ToList() ?? new List<Conference>();

    var availableConferences = ViewBag.AvailableConferences as IEnumerable<Conference>
        ?? Enumerable.Empty<Conference>();

    var submissionAvailableConferences = ViewBag.SubmissionAvailableConferences as IEnumerable<Conference>
        ?? Enumerable.Empty<Conference>();

    var registrationAvailableConferences = ViewBag.RegistrationAvailableConferences as IEnumerable<Conference>
        ?? availableConferences;

    var availableConferenceList = availableConferences.ToList();
    var submissionAvailableConferenceList = submissionAvailableConferences.ToList();
    var registrationAvailableConferenceList = registrationAvailableConferences.ToList();

    var hasRegisteredConferences = registeredConferences.Any();
    var hasSubmissionAvailableConferences = submissionAvailableConferenceList.Any();
    var hasRegistrationAvailableConferences = registrationAvailableConferenceList.Any();

    var hasAnyConference =
        hasRegisteredConferences ||
        hasSubmissionAvailableConferences ||
        hasRegistrationAvailableConferences;

    string GetConferenceSlug(Conference conference)
    {
        return conference.Tenant?.Slug ?? conference.Slug ?? "";
    }

    string GetWebsiteUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/"
            : $"/{tenantSlug}";
    }

    string GetSubmissionIndexUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Dashboard/MyConferences"
            : $"/{tenantSlug}/Submission/Index";
    }

    string GetSubmissionCreateUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Dashboard/MyConferences"
            : $"/{tenantSlug}/Submission/Create";
    }

    string GetRegistrationUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Home/Congresses"
            : $"/{tenantSlug}/registration";
    }

    string GetCityText(Conference conference)
    {
        return !string.IsNullOrWhiteSpace(conference.City)
            ? conference.City
            : L("OnlineVirtual", "Online / Sanal");
    }

    string GetFirstLetter(Conference conference)
    {
        return !string.IsNullOrWhiteSpace(conference.Title)
            ? conference.Title.Substring(0, 1).ToUpper()
            : "A";
    }
}

@section Styles {
    <style>
        .selection-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 1.65rem 1.5rem 3rem;
            width: 100%;
        }

        .selection-hero {
            text-align: center;
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.7px;
        }

        .page-description {
            color: #64748b;
            font-size: 1.05rem;
        }

        .search-wrapper {
            max-width: 600px;
            margin: 0 auto 2.25rem auto;
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 1.05rem 1.5rem 1.05rem 3.5rem;
            border-radius: 50px;
            border: 1px solid #e2e8f0;
            background-color: #fff;
            font-size: 1rem;
            transition: all 0.3s;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        }

            .search-input:focus {
                outline: none;
                border-color: #00aeef;
                box-shadow: 0 8px 30px rgba(0, 174, 239, 0.15);
            }

        .search-icon {
            position: absolute;
            left: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.2rem;
        }

        .section-block {
            margin-bottom: 2.35rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 0.25rem;
        }

        .section-subtitle {
            color: #64748b;
            font-size: 0.95rem;
            margin-bottom: 0;
        }

        .section-count {
            background: #fff;
            border: 1px solid #e2e8f0;
            color: #64748b;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.55rem 0.9rem;
            border-radius: 999px;
            white-space: nowrap;
        }

        .empty-mini-state {
            background: #fff;
            border: 1px dashed #cbd5e1;
            border-radius: 22px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .empty-mini-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: #f8fafc;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: #94a3b8;
            font-size: 2rem;
        }

        .conf-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

            .conf-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
                border-color: #00aeef;
            }

            .conf-card.active {
                border: 2px solid #10b981;
                background-color: #fcfdfd;
            }

            .conf-card.available {
                border-color: #dbeafe;
            }

                .conf-card.available:hover {
                    border-color: #2563eb;
                }

        .active-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #10b981;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 5px 12px;
            border-radius: 20px;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);
            z-index: 2;
        }

        .available-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: #2563eb;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 5px 12px;
            border-radius: 20px;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.18);
            z-index: 2;
        }

        .submission-badge {
            background: #16a34a;
            box-shadow: 0 4px 10px rgba(22, 163, 74, 0.18);
        }

        .logo-wrapper {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

            .logo-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                padding: 10px;
                border-radius: 20px;
            }

        .logo-placeholder {
            font-size: 1.5rem;
            font-weight: 800;
            color: #00aeef;
        }

        .tenant-badge {
            max-width: 130px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .conf-title {
            min-height: 3.5rem;
            line-height: 1.4;
            color: #0f172a;
        }

        .card-meta {
            font-size: 0.9rem;
            color: #64748b;
            margin-bottom: 0.6rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 500;
        }

            .card-meta i {
                width: 20px;
                text-align: center;
            }

        .footer-actions {
            margin-top: auto;
            padding-top: 1.5rem;
            display: grid;
            gap: 12px;
        }

        .btn-select,
        .btn-select-start,
        .btn-register,
        .btn-submit-paper,
        .btn-secondary-custom {
            position: relative;
            overflow: hidden;
        }

        .btn-select,
        .btn-select-start,
        .btn-register,
        .btn-submit-paper {
            color: #fff;
            border: none;
            font-weight: 800;
            padding: 12px 16px;
            border-radius: 16px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 0.96rem;
            width: 100%;
            text-decoration: none;
            min-height: 50px;
            letter-spacing: 0.1px;
        }

        .btn-select {
            background: linear-gradient(135deg, #00aeef 0%, #0984e3 100%);
            box-shadow: 0 6px 18px rgba(0, 174, 239, 0.25);
        }

            .btn-select:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 26px rgba(0, 174, 239, 0.35);
                color: white;
            }

            .btn-select.active-btn {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                box-shadow: 0 6px 18px rgba(16, 185, 129, 0.25);
                cursor: pointer;
                opacity: 1;
            }

                .btn-select.active-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 26px rgba(16, 185, 129, 0.35);
                }

        .btn-select-start {
            background: linear-gradient(135deg, #00aeef 0%, #0d6efd 100%);
            box-shadow: 0 10px 24px rgba(0, 174, 239, 0.24);
        }

            .btn-select-start:hover {
                transform: translateY(-2px);
                color: #fff;
                box-shadow: 0 14px 30px rgba(0, 174, 239, 0.34);
                background: linear-gradient(135deg, #009bd8 0%, #0b5ed7 100%);
            }

            .btn-select-start.active-btn {
                background: linear-gradient(135deg, #00aeef 0%, #0d6efd 100%);
                box-shadow: 0 10px 24px rgba(0, 174, 239, 0.24);
            }

                .btn-select-start.active-btn:hover {
                    box-shadow: 0 12px 28px rgba(16, 185, 129, 0.35);
                }

        .btn-register {
            background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 55%, #06b6d4 100%);
            box-shadow: 0 10px 24px rgba(14, 165, 233, 0.22);
        }

            .btn-register:hover {
                transform: translateY(-2px);
                color: #fff;
                box-shadow: 0 14px 30px rgba(14, 165, 233, 0.32);
                background: linear-gradient(135deg, #1d4ed8 0%, #0284c7 55%, #0891b2 100%);
            }

        .btn-submit-paper {
            background: linear-gradient(135deg, #059669 0%, #10b981 55%, #22c55e 100%);
            box-shadow: 0 10px 24px rgba(16, 185, 129, 0.22);
        }

            .btn-submit-paper:hover {
                transform: translateY(-2px);
                color: #fff;
                box-shadow: 0 14px 30px rgba(16, 185, 129, 0.32);
                background: linear-gradient(135deg, #047857 0%, #059669 55%, #16a34a 100%);
            }

        .btn-secondary-custom {
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            color: #475569;
            border: 1px solid #dbe4ef;
            font-weight: 700;
            padding: 11px 14px;
            border-radius: 16px;
            transition: all 0.3s ease;
            font-size: 0.93rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 48px;
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.04);
        }

            .btn-secondary-custom:hover {
                background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
                color: #0f172a;
                border-color: #cbd5e1;
                transform: translateY(-2px);
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
            }

        .no-results {
            display: none;
            text-align: center;
            padding: 4rem;
            color: #94a3b8;
        }

        .empty-state-icon {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
            margin-bottom: 1.5rem;
        }

        @@media (max-width: 768px) {
            .selection-container {
                padding: 1.25rem 1rem 2.5rem;
            }

            .selection-hero {
                margin-bottom: 1.5rem;
            }

            .page-title {
                font-size: 1.6rem;
            }

            .search-wrapper {
                margin-bottom: 1.75rem;
            }

            .section-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .conf-title {
                min-height: auto;
            }
        }
    </style>
}

<div class="selection-container">
    <div class="selection-hero">
        <h2 class="page-title mb-2">
            @L("Welcome", "Hoş Geldiniz")
        </h2>

        <p class="page-description mb-0">
            @L("SelectWorkspaceDescription", "İşlem yapmak istediğiniz çalışma alanını yani kongreyi aşağıdan seçiniz.")
        </p>
    </div>

    <div class="search-wrapper">
        <i class="fas fa-search search-icon"></i>

        <input type="text"
               id="conferenceSearch"
               class="search-input"
               placeholder="@L("SearchPlaceholder", "Kongre adı ile arama yapın...")" />
    </div>

    @if (!hasAnyConference)
    {
        <div class="col-12 text-center py-4">
            <div class="empty-state-icon">
                <i class="far fa-folder-open fa-4x text-muted opacity-50"></i>
            </div>

            <h3 class="fw-bold text-dark">
                @L("NoConferenceTitle", "Henüz görüntülenebilir kongre bulunamadı")
            </h3>

            <p class="text-muted mb-4">
                @L("NoConferenceDescription", "Şu anda kayıtlı olduğunuz veya kayıt olabileceğiniz aktif bir kongre bulunmuyor.")
            </p>

            <a href="/Home/Index#congress-list" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                @L("DiscoverEvents", "Etkinlikleri Keşfet")
            </a>
        </div>
    }
    else
    {
        @if (!hasRegisteredConferences)
        {
            <div class="empty-mini-state">
                <div class="empty-mini-icon">
                    <i class="far fa-folder-open"></i>
                </div>

                <h4 class="fw-bold text-dark mb-2">
                    @L("NoRegistrationTitle", "Henüz Bir Kaydınız Yok")
                </h4>

                <p class="text-muted mb-0">
                    @L("NoRegistrationDescription", "Yazar panelini kullanmak için önce aşağıdaki etkinliklerden birine kayıt olmalısınız.")
                </p>
            </div>
        }

        @if (hasRegisteredConferences)
        {
            <section class="section-block conference-section">
                <div class="section-header">
                    <div>
                        <h3 class="section-title">
                            @L("RegisteredConferencesTitle", "Kayıtlı Olduğum Kongreler")
                        </h3>

                        <p class="section-subtitle">
                            @L("RegisteredConferencesDescription", "Bu kongrelerde panelinize geçiş yapabilir ve işlemlerinize devam edebilirsiniz.")
                        </p>
                    </div>

                    <span class="section-count">
                        @registeredConferences.Count @L("ConferenceCountText", "Kongre")
                    </span>
                </div>

                <div class="row g-4 justify-content-center conference-grid">
                    @foreach (var kongre in registeredConferences)
                    {
                        var tenantSlug = GetConferenceSlug(kongre);
                        var effectiveReturnUrl = GetSubmissionIndexUrl(tenantSlug);
                        var isSelected = selectedConferenceId.HasValue && selectedConferenceId.Value == kongre.Id;
                        var hasLogo = !string.IsNullOrWhiteSpace(kongre.LogoPath);
                        var firstLetter = GetFirstLetter(kongre);
                        var cityText = GetCityText(kongre);
                        var websiteUrl = GetWebsiteUrl(tenantSlug);

                        <div class="col-md-6 col-lg-4 col-xl-4 conf-item">
                            <div class="conf-card p-4 @(isSelected ? "active" : "")">

                                @if (isSelected)
                                {
                                    <span class="active-badge">
                                        @L("Active", "Aktif")
                                    </span>
                                }

                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="logo-wrapper">
                                        @if (hasLogo)
                                        {
                                            <img src="@kongre.LogoPath" alt="@kongre.Title" />
                                        }
                                        else
                                        {
                                            <span class="logo-placeholder">@firstLetter</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(tenantSlug))
                                    {
                                        <span class="badge bg-light text-secondary border rounded-pill px-3 tenant-badge">
                                            @tenantSlug
                                        </span>
                                    }
                                </div>

                                <h5 class="fw-bold mb-3 conf-title">
                                    @kongre.Title
                                </h5>

                                <div class="card-meta">
                                    <i class="far fa-calendar-alt text-primary"></i>

                                    <span class="fw-bold text-dark">
                                        @kongre.StartDate.ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                                    </span>
                                </div>

                                <div class="card-meta">
                                    <i class="fas fa-map-marker-alt text-danger"></i>

                                    <span>
                                        @cityText
                                    </span>
                                </div>

                                <div class="footer-actions">
                                    <form action="/Dashboard/SelectConferencePost"
                                          method="post"
                                          class="d-grid">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="conferenceId" value="@kongre.Id" />
                                        <input type="hidden" name="returnUrl" value="@effectiveReturnUrl" />

                                        <button type="submit" class="btn-select-start @(isSelected ? "active-btn" : "")">
                                            @if (isSelected)
                                            {
                                                <span>@L("ReturnToPanelActive", "Panele Dön")</span>
                                                <i class="fas fa-sign-in-alt"></i>
                                            }
                                            else
                                            {
                                                <span>@L("SelectAndStart", "Seç ve Başla")</span>
                                                <i class="fas fa-arrow-right"></i>
                                            }
                                        </button>
                                    </form>

                                    <a href="@websiteUrl" target="_blank" class="btn-secondary-custom">
                                        <i class="fas fa-external-link-alt small"></i>
                                        <span>@L("Website", "Web Sitesi")</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @if (hasSubmissionAvailableConferences)
        {
            <section class="section-block conference-section">
                <div class="section-header">
                    <div>
                        <h3 class="section-title">
                            @L("SubmissionAvailableConferencesTitle", "Bildiri Gönderebileceğim Kongreler")
                        </h3>

                        <p class="section-subtitle">
                            @L("SubmissionAvailableConferencesDescription", "Bu kongrelere ödeme yapmadan önce bildiri göndererek değerlendirme sürecinizi başlatabilirsiniz.")
                        </p>
                    </div>

                    <span class="section-count">
                        @submissionAvailableConferenceList.Count @L("ConferenceCountText", "Kongre")
                    </span>
                </div>

                <div class="row g-4 justify-content-center conference-grid">
                    @foreach (var kongre in submissionAvailableConferenceList)
                    {
                        var tenantSlug = GetConferenceSlug(kongre);
                        var hasLogo = !string.IsNullOrWhiteSpace(kongre.LogoPath);
                        var firstLetter = GetFirstLetter(kongre);
                        var cityText = GetCityText(kongre);
                        var websiteUrl = GetWebsiteUrl(tenantSlug);
                        var submissionCreateUrl = GetSubmissionCreateUrl(tenantSlug);

                        <div class="col-md-6 col-lg-4 col-xl-4 conf-item">
                            <div class="conf-card available p-4">

                                <span class="available-badge submission-badge">
                                    @L("SubmissionOpen", "Başvuru Açık")
                                </span>

                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="logo-wrapper">
                                        @if (hasLogo)
                                        {
                                            <img src="@kongre.LogoPath" alt="@kongre.Title" />
                                        }
                                        else
                                        {
                                            <span class="logo-placeholder">@firstLetter</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(tenantSlug))
                                    {
                                        <span class="badge bg-light text-secondary border rounded-pill px-3 tenant-badge">
                                            @tenantSlug
                                        </span>
                                    }
                                </div>

                                <h5 class="fw-bold mb-3 conf-title">
                                    @kongre.Title
                                </h5>

                                <div class="card-meta">
                                    <i class="far fa-calendar-alt text-primary"></i>

                                    <span class="fw-bold text-dark">
                                        @kongre.StartDate.ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                                    </span>
                                </div>

                                <div class="card-meta">
                                    <i class="fas fa-map-marker-alt text-danger"></i>

                                    <span>
                                        @cityText
                                    </span>
                                </div>

                                <div class="footer-actions">
                                    <a href="@submissionCreateUrl" class="btn-submit-paper">
                                        <span>@L("SubmitPaper", "Bildiri Gönder")</span>
                                        <i class="fas fa-paper-plane"></i>
                                    </a>

                                    <a href="@websiteUrl" target="_blank" class="btn-secondary-custom">
                                        <i class="fas fa-external-link-alt small"></i>
                                        <span>@L("Website", "Web Sitesi")</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @if (hasRegistrationAvailableConferences)
        {
            <section class="section-block conference-section">
                <div class="section-header">
                    <div>
                        <h3 class="section-title">
                            @L("AvailableConferencesTitle", "Kayıt Olabileceğim Kongreler")
                        </h3>

                        <p class="section-subtitle">
                            @L("AvailableConferencesDescription", "Bu kongrelere kayıt olarak başvuru sürecinizi başlatabilirsiniz.")
                        </p>
                    </div>

                    <span class="section-count">
                        @registrationAvailableConferenceList.Count @L("ConferenceCountText", "Kongre")
                    </span>
                </div>

                <div class="row g-4 justify-content-center conference-grid">
                    @foreach (var kongre in registrationAvailableConferenceList)
                    {
                        var tenantSlug = GetConferenceSlug(kongre);
                        var hasLogo = !string.IsNullOrWhiteSpace(kongre.LogoPath);
                        var firstLetter = GetFirstLetter(kongre);
                        var cityText = GetCityText(kongre);
                        var websiteUrl = GetWebsiteUrl(tenantSlug);
                        var registerUrl = GetRegistrationUrl(tenantSlug);

                        <div class="col-md-6 col-lg-4 col-xl-4 conf-item">
                            <div class="conf-card available p-4">

                                <span class="available-badge">
                                    @L("Available", "Kayıt Açık")
                                </span>

                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="logo-wrapper">
                                        @if (hasLogo)
                                        {
                                            <img src="@kongre.LogoPath" alt="@kongre.Title" />
                                        }
                                        else
                                        {
                                            <span class="logo-placeholder">@firstLetter</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(tenantSlug))
                                    {
                                        <span class="badge bg-light text-secondary border rounded-pill px-3 tenant-badge">
                                            @tenantSlug
                                        </span>
                                    }
                                </div>

                                <h5 class="fw-bold mb-3 conf-title">
                                    @kongre.Title
                                </h5>

                                <div class="card-meta">
                                    <i class="far fa-calendar-alt text-primary"></i>

                                    <span class="fw-bold text-dark">
                                        @kongre.StartDate.ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                                    </span>
                                </div>

                                <div class="card-meta">
                                    <i class="fas fa-map-marker-alt text-danger"></i>

                                    <span>
                                        @cityText
                                    </span>
                                </div>

                                <div class="footer-actions">
                                    <a href="@registerUrl" class="btn-register">
                                        <span>@L("GoToRegistrationPage", "Kayıt Ol")</span>
                                        <i class="fas fa-user-plus"></i>
                                    </a>

                                    <a href="@websiteUrl" target="_blank" class="btn-secondary-custom">
                                        <i class="fas fa-external-link-alt small"></i>
                                        <span>@L("Website", "Web Sitesi")</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <div id="noResults" class="no-results">
            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>

            <h4>
                @L("NoSearchResults", "Aramanıza uygun kongre bulunamadı.")
            </h4>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('conferenceSearch');
            const noResults = document.getElementById('noResults');

            if (!searchInput) {
                return;
            }

            searchInput.addEventListener('keyup', function () {
                const input = this.value.toLowerCase().trim();
                const items = document.querySelectorAll('.conference-grid .conf-item');
                const sections = document.querySelectorAll('.conference-section');

                let hasVisible = false;

                items.forEach(function (item) {
                    const titleElement = item.querySelector('.conf-title');

                    if (!titleElement) {
                        item.style.display = 'none';
                        return;
                    }

                    const title = titleElement.innerText.toLowerCase();

                    if (title.includes(input)) {
                        item.style.display = '';
                        hasVisible = true;
                    } else {
                        item.style.display = 'none';
                    }
                });

                sections.forEach(function (section) {
                    const visibleCards = Array.from(section.querySelectorAll('.conference-grid .conf-item'))
                        .filter(function (item) {
                            return item.style.display !== 'none';
                        });

                    if (visibleCards.length > 0 || input === '') {
                        section.style.display = '';
                    } else {
                        section.style.display = 'none';
                    }
                });

                if (noResults) {
                    noResults.style.display = hasVisible || input === '' ? 'none' : 'block';
                }
            });
        });
    </script>
}
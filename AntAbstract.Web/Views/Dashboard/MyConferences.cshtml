                   class="btn selection-light-btn">
                    <i class="fas fa-globe"></i>
                    @L("DiscoverEvents", "Etkinlikleri Keşfet")
                </a>
            }
        </div>
    </div>

    <div class="search-card">
        <div class="search-wrapper">
            <i class="fas fa-search search-icon"></i>

            <input type="text"
                   id="conferenceSearch"
                   class="search-input"
                   placeholder="@(isAdmin ? @Localizer["AdminSearchPlaceholder"].Value : L("SearchPlaceholder", "Kongre adı ile arama yapın..."))" />
        </div>
    </div>

    @if (!hasAnyConference)
    {
        <div class="empty-state-card">
            <div class="empty-state-icon">
                <i class="far fa-folder-open"></i>
            </div>

            <h3 class="fw-bold text-dark">
                @(isAdmin
                    ? @Localizer["AdminNoConferenceTitle"]
                    : L("NoConferenceTitle", "Henüz görüntülenebilir kongre bulunamadı"))
            </h3>

            <p class="text-muted mb-4">
                @if (isAdmin)
                {
                    <span>
                        @Localizer["AdminNoConferenceDescription"]
                    </span>
                }
                else
                {
                    <span>
                        @L("NoConferenceDescription", "Şu anda kayıtlı olduğunuz veya kayıt olabileceğiniz aktif bir kongre bulunmuyor.")
                    </span>
                }

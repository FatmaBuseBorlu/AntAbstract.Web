                        <h3 class="section-title">
                            @L("AvailableConferencesTitle", "Kayıt Olabileceğim Kongreler")
                        </h3>

                        <p class="section-subtitle">
                            @L("AvailableConferencesDescription", "Bu kongrelere kayıt olarak başvuru sürecinizi başlatabilirsiniz.")
                        </p>
                    </div>

                    <span class="section-count">
                        @registrationAvailableConferenceList.Count @L("ConferenceCountText", "Kongre")
                    </span>
                </div>

                <div class="row g-4 conference-grid">
                    @foreach (var kongre in registrationAvailableConferenceList)
                    {
                        var tenantSlug = GetConferenceSlug(kongre);
                        var hasLogo = !string.IsNullOrWhiteSpace(kongre.LogoPath);
                        var firstLetter = GetFirstLetter(kongre);
                        var cityText = GetCityText(kongre);
                        var websiteUrl = GetWebsiteUrl(tenantSlug, kongre.Id);
                        var registerUrl = GetRegistrationUrl(tenantSlug);
                        var statusText = GetConferenceStatusText(kongre);

                        <div class="col-md-6 col-xl-4 conf-item">
                            <div class="conference-card available">
                                <div class="conference-card-body">

                                    <span class="status-floating-badge open-badge">
                                        <i class="fas fa-user-plus"></i>
                                        @L("Available", "Kayıt Açık")
                                    </span>

                                    <div class="card-top-row">
                                        <div class="logo-wrapper">
                                            @if (hasLogo)
                                            {
                                                <img src="@kongre.LogoPath" alt="@kongre.Title" />
                                            }
                                            else
                                            {
                                                <span class="logo-placeholder">@firstLetter</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(tenantSlug))
                                        {
                                            <span class="tenant-badge">
                                                <i class="fas fa-link"></i>
                                                @tenantSlug
                                            </span>
                                        }
                                    </div>

                                    <h5 class="conference-title conf-title">
                                        @kongre.Title
                                    </h5>

                                    <div class="card-meta-list">
                                        <div class="card-meta">
                                            <i class="far fa-calendar-alt text-primary"></i>
                                            <span>@GetDateRange(kongre)</span>
                                        </div>

                                        <div class="card-meta">
                                            <i class="fas fa-map-marker-alt text-danger"></i>
                                            <span>@cityText</span>
                                        </div>

                                        <div class="card-meta">
                                            <i class="fas fa-circle text-primary"></i>
                                            <span>@statusText</span>
                                        </div>
                                    </div>

                                    <div class="card-actions">
                                        <a href="@registerUrl"
                                           class="register-action-btn">
                                            <span>@L("GoToRegistrationPage", "Kayıt Ol")</span>
                                            <i class="fas fa-user-plus"></i>
                                        </a>

                                        <a href="@websiteUrl"
                                           target="_blank"
                                           class="secondary-action-btn">
                                            <i class="fas fa-arrow-up-right-from-square"></i>
                                            <span>@L("Website", "Web Sitesi")</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <div id="noResults" class="no-results">
            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>

            <h4 class="fw-bold text-dark">
                @L("NoSearchResults", "Aramanıza uygun kongre bulunamadı.")
            </h4>

            <p class="mb-0">
                @Localizer["NoSearchResultsDescription"]
            </p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('conferenceSearch');
            const noResults = document.getElementById('noResults');

            if (!searchInput) {
                return;
            }

            searchInput.addEventListener('keyup', function () {
                const input = this.value.toLowerCase().trim();
                const items = document.querySelectorAll('.conference-grid .conf-item');
                const sections = document.querySelectorAll('.conference-section');

                let hasVisible = false;

                items.forEach(function (item) {
                    const text = item.innerText.toLowerCase();

                    if (text.includes(input)) {
                        item.style.display = '';
                        hasVisible = true;
                    } else {
                        item.style.display = 'none';
                    }
                });

                sections.forEach(function (section) {
                    const visibleCards = Array.from(section.querySelectorAll('.conference-grid .conf-item'))
                        .filter(function (item) {
                            return item.style.display !== 'none';
                        });

                    if (visibleCards.length > 0 || input === '') {
                        section.style.display = '';
                    } else {
                        section.style.display = 'none';
                    }
                });

                if (noResults) {
                    noResults.style.display = hasVisible || input === '' ? 'none' : 'block';
                }
            });
        });
    </script>
}
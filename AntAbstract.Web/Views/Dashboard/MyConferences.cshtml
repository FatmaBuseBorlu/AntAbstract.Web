@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Routing
@using System
@using System.Globalization
@using System.Linq
@using AntAbstract.Domain.Entities

@inject IViewLocalizer Localizer
@inject AntAbstract.Infrastructure.Context.TenantContext Tc

@model IEnumerable<Conference>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutConferenceSelection.cshtml";

    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;

        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : text;
    };

    var isAdmin = User.IsInRole("Admin");
    var isAuthor = User.IsInRole("Author") || User.IsInRole("Yazar");
    var isListener = User.IsInRole("Listener") || User.IsInRole("Dinleyici");

    // Sayfa iki mesaj birden gösteriyordu: üstte kırmızı uyarı şeridi
    // ("Kongre bulunamadı."), altında da aynı şeyi söyleyen karşılama kartı
    // ("...aşağıdan seçiniz"). Üstelik kırmızı şerit, hemen altında kongresi
    // listelenen kullanıcıya "hiç kongren yok" gibi okunuyordu.
    //
    // Mesajı şeritten alıp karşılama kartının içine taşıyoruz. Anahtarları
    // burada siliyoruz; gövde layout'tan önce çalıştığı için şerit basılmıyor
    // ve ekranda tek bir yönlendirme kalıyor.
    var noticeText = TempData["ErrorMessage"] as string
                     ?? TempData["InfoMessage"] as string
                     ?? TempData["SuccessMessage"] as string;

    var noticeKind = TempData["ErrorMessage"] != null
        ? "error"
        : TempData["InfoMessage"] != null
            ? "info"
            : "success";

    TempData.Remove("ErrorMessage");
    TempData.Remove("InfoMessage");
    TempData.Remove("SuccessMessage");

    var noticeIcon = noticeKind switch
    {
        "error" => "circle-exclamation",
        "info" => "circle-info",
        _ => "circle-check"
    };

    string? selectedIdStr = null;

    if (Tc.Current != null)
    {
        selectedIdStr = Context.Session.GetString($"SelectedConferenceId:{Tc.Current.Id}");
    }

    selectedIdStr ??= Context.Session.GetString("SelectedConferenceId");

    Guid? selectedConferenceId = Guid.TryParse(selectedIdStr, out var sid)
        ? sid
        : null;

    var registeredConferences = Model?.ToList() ?? new List<Conference>();

    var availableConferences = ViewBag.AvailableConferences as IEnumerable<Conference>
        ?? Enumerable.Empty<Conference>();

    var submissionAvailableConferences = ViewBag.SubmissionAvailableConferences as IEnumerable<Conference>
        ?? Enumerable.Empty<Conference>();

    var registrationAvailableConferences = ViewBag.RegistrationAvailableConferences as IEnumerable<Conference>
        ?? availableConferences;

    var availableConferenceList = availableConferences.ToList();
    var submissionAvailableConferenceList = submissionAvailableConferences.ToList();
    var registrationAvailableConferenceList = registrationAvailableConferences.ToList();

    var hasRegisteredConferences = registeredConferences.Any();
    var hasSubmissionAvailableConferences = !isAdmin && submissionAvailableConferenceList.Any();
    var hasRegistrationAvailableConferences = !isAdmin && registrationAvailableConferenceList.Any();

    var hasAnyConference =
        hasRegisteredConferences ||
        hasSubmissionAvailableConferences ||
        hasRegistrationAvailableConferences;

    var today = DateTime.Today;

    string GetConferenceSlug(Conference conference)
    {
        return conference.Tenant?.Slug ?? conference.Slug ?? "";
    }

    string GetWebsiteUrl(string tenantSlug, Guid conferenceId = default)
    {
        if (string.IsNullOrWhiteSpace(tenantSlug)) return "/";
        return conferenceId == default
            ? $"/{tenantSlug}"
            : $"/{tenantSlug}?conferenceId={conferenceId}";
    }

    string GetDashboardUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Dashboard"
            : $"/{tenantSlug}/Dashboard";
    }

    string GetConferenceFlowUrl(Conference conference)
    {
        var tenantSlug = GetConferenceSlug(conference);

        return string.IsNullOrWhiteSpace(tenantSlug)
            ? $"/Admin/ConferenceFlow?conferenceId={conference.Id}"
            : $"/{tenantSlug}/Admin/ConferenceFlow?conferenceId={conference.Id}";
    }

    string GetAdminSubmissionsUrl(Conference conference)
    {
        var tenantSlug = GetConferenceSlug(conference);

        return string.IsNullOrWhiteSpace(tenantSlug)
            ? $"/Admin/Submissions?conferenceId={conference.Id}"
            : $"/{tenantSlug}/Admin/Submissions?conferenceId={conference.Id}";
    }

    string GetAdminAssignmentUrl(Conference conference)
    {
        var tenantSlug = GetConferenceSlug(conference);

        return string.IsNullOrWhiteSpace(tenantSlug)
            ? $"/Admin/Assignment?conferenceId={conference.Id}"
            : $"/{tenantSlug}/Admin/Assignment?conferenceId={conference.Id}";
    }

    string GetSubmissionIndexUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Dashboard/MyConferences"
            : $"/{tenantSlug}/my-submissions";
    }

    string GetSubmissionCreateUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Dashboard/MyConferences"
            : $"/{tenantSlug}/submit-abstract";
    }

    string GetRegistrationUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Home/Congresses"
            : $"/{tenantSlug}/registration";
    }

    string GetPaymentUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Payment/New"
            : $"/{tenantSlug}/payment";
    }

    string GetPaymentsUrl(string tenantSlug)
    {
        return string.IsNullOrWhiteSpace(tenantSlug)
            ? "/Payment/My"
            : $"/{tenantSlug}/payments";
    }

    string GetCityText(Conference conference)
    {
        return !string.IsNullOrWhiteSpace(conference.City)
            ? conference.City
            : L("OnlineVirtual", "Online / Sanal");
    }

    string GetFirstLetter(Conference conference)
    {
        return !string.IsNullOrWhiteSpace(conference.Title)
            ? conference.Title.Trim().Substring(0, 1).ToUpper()
            : "A";
    }

    string GetDateRange(Conference conference)
    {
        return $"{conference.StartDate.ToString("dd MMM yyyy", CultureInfo.CurrentUICulture)} - {conference.EndDate.ToString("dd MMM yyyy", CultureInfo.CurrentUICulture)}";
    }

    string GetConferenceStatusText(Conference conference)
    {
        if (conference.StartDate.Date <= today && conference.EndDate.Date >= today)
        {
            return L("StatusActive", "Devam Ediyor");
        }

        if (conference.StartDate.Date > today)
        {
            return L("StatusUpcoming", "Yaklaşan");
        }

        return L("StatusCompleted", "Tamamlandı");
    }

    string GetConferenceStatusClass(Conference conference)
    {
        if (conference.StartDate.Date <= today && conference.EndDate.Date >= today)
        {
            return "status-active";
        }

        if (conference.StartDate.Date > today)
        {
            return "status-upcoming";
        }

        return "status-completed";
    }
}

@section Styles {
    <style>
        .selection-page {
            max-width: 1280px;
            margin: 0 auto;
            padding: 1.5rem 1.5rem 3rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .selection-hero-card {
            background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
            border: 1px solid #e8eef6;
            border-radius: 30px;
            padding: 1.65rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.25rem;
            flex-wrap: wrap;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
            margin-bottom: 1.5rem;
        }

        .selection-hero-left {
            display: flex;
            align-items: center;
            gap: 1rem;
            min-width: 300px;
            flex: 1;
        }

        .selection-hero-icon {
            width: 66px;
            height: 66px;
            min-width: 66px;
            border-radius: 24px;
            background: linear-gradient(135deg, #0d6efd, #00aeef);
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.55rem;
            box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
        }

        .selection-label {
            color: #64748b;
            font-size: 0.78rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.35rem;
        }

        .selection-title {
            margin: 0 0 0.35rem;
            color: #0f172a;
            font-size: 2rem;
            font-weight: 950;
            letter-spacing: -0.05em;
            line-height: 1.2;
        }

        .selection-description {
            margin: 0;
            color: #64748b;
            font-size: 0.96rem;
            font-weight: 650;
            line-height: 1.65;
            max-width: 850px;
        }

        /* Yönlendirme sebebi kartın içinde duruyor; sayfanın tepesinde ayrı
           bir uyarı şeridi açmıyoruz ki tek mesaj kalsın. */
        .selection-notice {
            display: inline-flex;
            align-items: flex-start;
            gap: 0.5rem;
            margin: 0 0 0.5rem;
            padding: 0.5rem 0.85rem;
            border-radius: 10px;
            font-size: 0.9rem;
            font-weight: 800;
            line-height: 1.5;
            max-width: 850px;
        }

            .selection-notice i {
                margin-top: 0.15rem;
            }

        .selection-notice-error {
            background: rgba(239, 68, 68, 0.1);
            color: #b91c1c;
        }

        .selection-notice-info {
            background: rgba(0, 174, 239, 0.1);
            color: #0369a1;
        }

        .selection-notice-success {
            background: rgba(34, 197, 94, 0.12);
            color: #15803d;
        }

        .selection-hero-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .selection-light-btn,
        .selection-primary-btn {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.55rem;
            border-radius: 999px;
            padding: 0 1.15rem;
            font-size: 0.9rem;
            font-weight: 900;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .selection-light-btn {
            background: #ffffff;
            color: #334155;
            border: 1px solid #dbe3ef;
        }

        .selection-light-btn:hover {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.32);
            background: #ffffff;
            transform: translateY(-1px);
        }

        .selection-primary-btn {
            border: none;
            background: linear-gradient(135deg, #0d6efd, #00aeef);
            color: #ffffff;
            box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
        }

        .selection-primary-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
        }

        .search-card {
            background: #ffffff;
            border: 1px solid #e8eef6;
            border-radius: 26px;
            padding: 1rem;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
            margin-bottom: 1.75rem;
        }

        .search-wrapper {
            position: relative;
        }

        .search-input {
            width: 100%;
            min-height: 52px;
            padding: 0.95rem 1.25rem 0.95rem 3.2rem;
            border-radius: 18px;
            border: 1px solid #cbd5e1;
            background-color: #fff;
            color: #0f172a;
            font-size: 0.96rem;
            font-weight: 700;
            transition: all 0.2s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: #00aeef;
            box-shadow: 0 0 0 0.18rem rgba(0, 174, 239, 0.12);
        }

        .search-icon {
            position: absolute;
            left: 1.15rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1rem;
        }

        .section-block {
            margin-bottom: 2rem;
        }

        .section-header-card {
            background: #ffffff;
            border: 1px solid #e8eef6;
            border-radius: 26px;
            padding: 1.25rem 1.35rem;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .section-title {
            font-size: 1.18rem;
            font-weight: 950;
            color: #0f172a;
            margin-bottom: 0.25rem;
        }

        .section-subtitle {
            color: #64748b;
            font-size: 0.88rem;
            font-weight: 650;
            line-height: 1.6;
            margin-bottom: 0;
        }

        .section-count {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #475569;
            font-weight: 950;
            font-size: 0.78rem;
            padding: 0.48rem 0.85rem;
            border-radius: 999px;
            white-space: nowrap;
        }

        .conference-grid {
            align-items: stretch;
        }

        .conference-card {
            background: #ffffff;
            border: 1px solid #e8eef6;
            border-radius: 28px;
            transition: all 0.22s ease;
            position: relative;
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
        }

        .conference-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 44px rgba(15, 23, 42, 0.10);
            border-color: rgba(13, 110, 253, 0.28);
        }

        .conference-card.selected {
            border-color: rgba(34, 197, 94, 0.55);
            box-shadow: 0 18px 42px rgba(34, 197, 94, 0.10);
        }

        .conference-card.available {
            border-color: rgba(13, 110, 253, 0.18);
        }

        .conference-card-body {
            padding: 1.2rem;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .status-floating-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.68rem;
            font-weight: 950;
            padding: 0.35rem 0.65rem;
            border-radius: 999px;
            border: 1px solid transparent;
        }

        .status-active {
            background: rgba(34, 197, 94, 0.12);
            color: #15803d;
            border-color: rgba(34, 197, 94, 0.18);
        }

        .status-upcoming {
            background: rgba(0, 174, 239, 0.12);
            color: #0284c7;
            border-color: rgba(0, 174, 239, 0.18);
        }

        .status-completed {
            background: rgba(100, 116, 139, 0.12);
            color: #64748b;
            border-color: rgba(100, 116, 139, 0.18);
        }

        .selected-badge {
            background: rgba(34, 197, 94, 0.12);
            color: #15803d;
            border: 1px solid rgba(34, 197, 94, 0.20);
        }

        .open-badge {
            background: rgba(13, 110, 253, 0.10);
            color: #0d6efd;
            border: 1px solid rgba(13, 110, 253, 0.16);
        }

        .submission-badge {
            background: rgba(22, 163, 74, 0.12);
            color: #15803d;
            border: 1px solid rgba(22, 163, 74, 0.18);
        }

        .card-top-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
            padding-right: 6.5rem;
        }

        .logo-wrapper {
            width: 68px;
            height: 68px;
            min-width: 68px;
            border-radius: 22px;
            background: #f8fafc;
            border: 1px solid #edf2f7;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.8);
        }

        .logo-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 10px;
            border-radius: 20px;
        }

        .logo-placeholder {
            width: 100%;
            height: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0d6efd, #00aeef);
            color: #ffffff;
            font-size: 1.35rem;
            font-weight: 950;
        }

        .tenant-badge {
            max-width: 135px;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #64748b;
            padding: 0.35rem 0.65rem;
            font-size: 0.72rem;
            font-weight: 900;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .conference-title {
            min-height: 3.2rem;
            line-height: 1.35;
            color: #0f172a;
            font-size: 1.05rem;
            font-weight: 950;
            margin-bottom: 0.9rem;
        }

        .card-meta-list {
            display: grid;
            gap: 0.55rem;
            margin-bottom: 1rem;
        }

        .card-meta {
            font-size: 0.84rem;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-weight: 700;
        }

        .card-meta i {
            width: 20px;
            text-align: center;
        }

        .card-actions {
            margin-top: auto;
            display: grid;
            gap: 0.7rem;
        }

        .primary-action-btn,
        .success-action-btn,
        .register-action-btn,
        .secondary-action-btn,
        .small-action-btn {
            border-radius: 16px;
            min-height: 48px;
            font-size: 0.9rem;
            font-weight: 950;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            border: 1px solid transparent;
            width: 100%;
        }

        .primary-action-btn {
            background: linear-gradient(135deg, #0d6efd, #00aeef);
            color: #ffffff;
            box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
        }

        .primary-action-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
        }

        .success-action-btn {
            background: linear-gradient(135deg, #059669, #22c55e);
            color: #ffffff;
            box-shadow: 0 12px 26px rgba(34, 197, 94, 0.18);
        }

        .success-action-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 16px 32px rgba(34, 197, 94, 0.24);
        }

        .register-action-btn {
            background: linear-gradient(135deg, #2563eb, #06b6d4);
            color: #ffffff;
            box-shadow: 0 12px 26px rgba(14, 165, 233, 0.18);
        }

        .register-action-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 16px 32px rgba(14, 165, 233, 0.24);
        }

        .secondary-action-btn,
        .small-action-btn {
            background: #ffffff;
            color: #334155;
            border-color: #dbe3ef;
        }

        .secondary-action-btn:hover,
        .small-action-btn:hover {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.32);
            background: #f8fbff;
            transform: translateY(-1px);
        }

        .action-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.7rem;
        }

        .author-action-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.7rem;
        }

        .admin-action-row {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.7rem;
        }

        .empty-state-card {
            background: #ffffff;
            border: 1px dashed #cbd5e1;
            border-radius: 28px;
            padding: 3rem 1.5rem;
            text-align: center;
            color: #64748b;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.04);
        }

        .empty-state-icon {
            width: 92px;
            height: 92px;
            border-radius: 30px;
            background: rgba(13, 110, 253, 0.10);
            color: #0d6efd;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2.3rem;
            margin-bottom: 1rem;
        }

        .empty-mini-state {
            background: #ffffff;
            border: 1px dashed #cbd5e1;
            border-radius: 26px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 2rem;
            color: #64748b;
        }

        .empty-mini-icon {
            width: 72px;
            height: 72px;
            border-radius: 24px;
            background: rgba(13, 110, 253, 0.10);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: #0d6efd;
            font-size: 1.8rem;
        }

        .no-results {
            display: none;
            text-align: center;
            padding: 3rem 1.5rem;
            color: #64748b;
            background: #ffffff;
            border: 1px dashed #cbd5e1;
            border-radius: 28px;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.04);
        }

        @@media (max-width: 992px) {
            .selection-hero-card {
                align-items: flex-start;
                flex-direction: column;
            }

            .selection-hero-left {
                align-items: flex-start;
            }

            .selection-hero-actions,
            .selection-hero-actions .btn {
                width: 100%;
            }

            .selection-title {
                font-size: 1.65rem;
            }

            .admin-action-row,
            .author-action-row {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .selection-page {
                padding: 1.25rem 1rem 2.5rem;
            }

            .selection-hero-left {
                flex-direction: column;
            }

            .section-header-card {
                align-items: flex-start;
                flex-direction: column;
            }

            .conference-title {
                min-height: auto;
            }

            .card-top-row {
                padding-right: 0;
                flex-direction: column;
            }

            .status-floating-badge {
                position: static;
                width: fit-content;
                margin-bottom: 1rem;
            }

            .action-row,
            .author-action-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="selection-page">

    <div class="selection-hero-card">
        <div class="selection-hero-left">
            <div class="selection-hero-icon">
                @if (isAdmin)
                {
                    <i class="fas fa-user-shield"></i>
                }
                else if (isAuthor)
                {
                    <i class="fas fa-pen-nib"></i>
                }
                else if (isListener)
                {
                    <i class="fas fa-ticket"></i>
                }
                else
                {
                    <i class="fas fa-calendar-check"></i>
                }
            </div>

            <div>

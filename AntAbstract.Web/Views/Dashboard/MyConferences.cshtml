                        var isSelected = selectedConferenceId.HasValue && selectedConferenceId.Value == kongre.Id;
                        var hasLogo = !string.IsNullOrWhiteSpace(kongre.LogoPath);
                        var firstLetter = GetFirstLetter(kongre);
                        var cityText = GetCityText(kongre);
                        var websiteUrl = GetWebsiteUrl(tenantSlug, kongre.Id);
                        var dashboardUrl = GetDashboardUrl(tenantSlug);
                        var conferenceFlowUrl = GetConferenceFlowUrl(kongre);
                        var adminSubmissionsUrl = GetAdminSubmissionsUrl(kongre);
                        var adminAssignmentUrl = GetAdminAssignmentUrl(kongre);
                        var submissionIndexUrl = GetSubmissionIndexUrl(tenantSlug);
                        var submissionCreateUrl = GetSubmissionCreateUrl(tenantSlug);
                        var paymentUrl = GetPaymentUrl(tenantSlug);
                        var paymentsUrl = GetPaymentsUrl(tenantSlug);
                        var statusText = GetConferenceStatusText(kongre);
                        var statusClass = GetConferenceStatusClass(kongre);

                        var effectiveReturnUrl = isAdmin
                            ? conferenceFlowUrl
                            : submissionIndexUrl;

                        <div class="col-md-6 col-xl-4 conf-item">
                            <div class="conference-card @(isSelected ? "selected" : "")">
                                <div class="conference-card-body">

                                    @if (isSelected)
                                    {
                                        <span class="status-floating-badge selected-badge">
                                            <i class="fas fa-check-circle"></i>
                                            @L("Active", "Aktif")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-floating-badge @statusClass">
                                            <i class="fas fa-circle"></i>
                                            @statusText
                                        </span>
                                    }

                                    <div class="card-top-row">
                                        <div class="logo-wrapper">
                                            @if (hasLogo)
                                            {
                                                <img src="@kongre.LogoPath" alt="@kongre.Title" />
                                            }
                                            else
                                            {
                                                <span class="logo-placeholder">@firstLetter</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(tenantSlug))
                                        {
                                            <span class="tenant-badge">
                                                <i class="fas fa-link"></i>
                                                @tenantSlug
                                            </span>
                                        }
                                    </div>

                                    <h5 class="conference-title conf-title">
                                        @kongre.Title
                                    </h5>

                                    <div class="card-meta-list">
                                        <div class="card-meta">

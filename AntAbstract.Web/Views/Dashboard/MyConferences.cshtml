                                              method="post"
                                              class="d-grid">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="conferenceId" value="@kongre.Id" />
                                            <input type="hidden" name="returnUrl" value="@effectiveReturnUrl" />

                                            <button type="submit"
                                                    class="primary-action-btn">
                                                @if (isAdmin)
                                                {
                                                    <span>
                                                        @(isSelected ? @Localizer["AdminReturnToFlow"] : @Localizer["AdminSelectAndManage"])
                                                    </span>
                                                    <i class="fas fa-stream"></i>
                                                }
                                                else if (isSelected)
                                                {
                                                    <span>@L("ReturnToPanelActive", "Panele Dön")</span>
                                                    <i class="fas fa-sign-in-alt"></i>
                                                }
                                                else
                                                {
                                                    <span>@L("SelectAndStart", "Seç ve Başla")</span>
                                                    <i class="fas fa-arrow-right"></i>
                                                }
                                            </button>

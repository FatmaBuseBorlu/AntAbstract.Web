                                                <a href="@submissionCreateUrl"
                                                   class="secondary-action-btn">
                                                    <i class="fas fa-paper-plane"></i>
                                                    @Localizer["SubmitPaper"]
                                                </a>

                                                <a href="@paymentsUrl"
                                                   class="secondary-action-btn">
                                                    <i class="fas fa-receipt"></i>
                                                    @Localizer["MyPayments"]
                                                </a>
                                            </div>

                                            <div class="action-row">
                                                <a href="@paymentUrl"

                    {
                        var tenantSlug = GetConferenceSlug(kongre);
                        var hasLogo = !string.IsNullOrWhiteSpace(kongre.LogoPath);
                        var firstLetter = GetFirstLetter(kongre);
                        var cityText = GetCityText(kongre);
                        var websiteUrl = GetWebsiteUrl(tenantSlug, kongre.Id);
                        var submissionCreateUrl = GetSubmissionCreateUrl(tenantSlug);
                        var statusText = GetConferenceStatusText(kongre);

                        <div class="col-md-6 col-xl-4 conf-item">
                            <div class="conference-card available">
                                <div class="conference-card-body">

                                    <span class="status-floating-badge submission-badge">
                                        <i class="fas fa-paper-plane"></i>
                                        @L("SubmissionOpen", "Başvuru Açık")
                                    </span>

                                    <div class="card-top-row">
                                        <div class="logo-wrapper">
                                            @if (hasLogo)

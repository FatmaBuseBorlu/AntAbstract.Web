@using AntAbstract.Web.Models.ViewModels.Admin.Dashboard
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Routing
@using System.Globalization
@model DashboardViewModel

@inject AntAbstract.Infrastructure.Context.TenantContext Tc
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;
        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
    };

    bool isReferee = ViewBag.IsReferee ?? false;
    bool isAuthor = ViewBag.IsAuthor ?? false;
    bool isAdmin = User.IsInRole("Admin");

    int pendingReviews = ViewBag.PendingReviews ?? 0;
    int completedReviews = ViewBag.CompletedReviews ?? 0;

    string? selectedConferenceIdStr = null;

    if (Tc.Current != null)
    {
        selectedConferenceIdStr = Context.Session.GetString($"SelectedConferenceId:{Tc.Current.Id}");
    }

    selectedConferenceIdStr ??= Context.Session.GetString("SelectedConferenceId");

    Guid? selectedConferenceId = Guid.TryParse(selectedConferenceIdStr, out var parsedConferenceId)
        ? parsedConferenceId
        : null;

    var hasSelectedConference = selectedConferenceId.HasValue;

    string mainColumnClass = (isAdmin || isReferee) ? "col-12" : "col-xl-8 col-lg-8";
    string sideColumnClass = (isAdmin || isReferee) ? "d-none" : "col-xl-4 col-lg-4";

    var slug = Context.GetRouteValue("slug")?.ToString() ?? Tc.Current?.Slug ?? "";
    var baseUrl = string.IsNullOrWhiteSpace(slug) ? "" : $"/{slug}";

    var dashboardUrl = isReferee && !isAdmin
        ? "/Dashboard"
        : $"{baseUrl}/Dashboard";

    var dashboardMyConferencesUrl = $"{baseUrl}/Dashboard/MyConferences";
    var submissionCreateUrl = $"{baseUrl}/Submission/Create";
    var submissionIndexUrl = $"{baseUrl}/Submission/Index";

    var reviewIndexUrl = isReferee && !isAdmin
        ? "/Review/Index"
        : $"{baseUrl}/Review/Index";

    var reviewGuidelinesUrl = isReferee && !isAdmin
        ? "/Review/Guidelines"
        : $"{baseUrl}/Review/Guidelines";

    var assignmentUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Assignment"
        : $"{baseUrl}/Admin/Assignment";

    var certificatesIndexUrl = isReferee && !isAdmin
        ? "/Certificates"
        : $"{baseUrl}/Certificates";

    var messageIndexUrl = isReferee && !isAdmin
        ? "/Message/Index"
        : $"{baseUrl}/Message/Index";

    var selectedConferenceQuery = hasSelectedConference
        ? $"?conferenceId={selectedConferenceId.Value}"
        : "";

    var conferenceFlowUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/ConferenceFlow{selectedConferenceQuery}";

    var adminSubmissionsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Submissions{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/Submissions{selectedConferenceQuery}";

    var adminAssignmentUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Assignment{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/Assignment{selectedConferenceQuery}";

    var adminDecisionUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Decision{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/Decision{selectedConferenceQuery}";

    var adminRefereeUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Referee{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/Referee{selectedConferenceQuery}";

    var adminRegistrationsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Registrations{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/Registrations{selectedConferenceQuery}";

    var adminProgramUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Program{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/Program{selectedConferenceQuery}";

    var adminProceedingBookUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ProceedingBook{selectedConferenceQuery}"
        : $"{baseUrl}/Admin/ProceedingBook{selectedConferenceQuery}";

    var publicSiteUrl = string.IsNullOrWhiteSpace(slug)
        ? "/"
        : $"/{slug}";

    var conferenceDisplayName = isReferee && !isAdmin && !hasSelectedConference
        ? L("RefereeDashboardTitle", "Hakem Paneli")
        : string.IsNullOrWhiteSpace(Model.ConferenceName)
            ? L("GeneralManagementPanel", "Genel Yönetim Paneli")
            : Model.ConferenceName;
}

<style>
    .dashboard-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .dashboard-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        margin-bottom: 1.5rem;
    }

    .dashboard-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .dashboard-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .dashboard-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .dashboard-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
        line-height: 1.2;
    }

    .dashboard-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        line-height: 1.65;
    }

    .dashboard-meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.8rem;
    }

    .dashboard-meta-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border-radius: 999px;
        padding: 0.48rem 0.78rem;
        font-size: 0.78rem;
        font-weight: 900;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .dashboard-meta-chip.primary {
        background: rgba(0, 174, 239, 0.10);
        border-color: rgba(0, 174, 239, 0.22);
        color: #0d6efd;
    }

    .dashboard-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .dashboard-light-btn,
    .dashboard-outline-btn,
    .dashboard-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0 1.15rem;
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .dashboard-light-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #dbe3ef;
    }

    .dashboard-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .dashboard-outline-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .dashboard-outline-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .dashboard-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
    }

    .dashboard-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
    }

    .dashboard-alert {
        border: 1px solid rgba(245, 158, 11, 0.22);
        background: rgba(245, 158, 11, 0.08);
        color: #92400e;
        border-radius: 24px;
        padding: 1rem 1.1rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.04);
        margin-bottom: 1.5rem;
    }

    .admin-info-alert {
        border: 1px solid rgba(13, 110, 253, 0.16);
        background: rgba(13, 110, 253, 0.07);
        color: #0d6efd;
        border-radius: 24px;
        padding: 1rem 1.1rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.04);
        margin-bottom: 1.5rem;
    }

    .dashboard-stat-card {
        min-height: 104px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1.15rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        justify-content: space-between;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
        transition: all 0.2s ease;
    }

    .dashboard-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    .dashboard-stat-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .stat-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .stat-red {
        background: rgba(239, 68, 68, 0.10);
        color: #ef4444;
    }

    .stat-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .dashboard-stat-number {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 950;
        line-height: 1;
    }

    .dashboard-stat-label {
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 850;
        margin-top: 0.3rem;
    }

    .dashboard-section-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .dashboard-card-header {
        padding: 1.25rem 1.35rem;
        border-bottom: 1px solid #edf2f7;
        background: #ffffff;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .dashboard-card-title {
        color: #0f172a;
        font-size: 1.12rem;
        font-weight: 950;
        margin-bottom: 0.18rem;
    }

    .dashboard-card-subtitle {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.55;
    }

    .dashboard-card-body {
        padding: 1.35rem;
    }

    .quick-action-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .quick-action-card {
        min-height: 145px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border: 1px solid #e8eef6;
        background: #ffffff;
        border-radius: 22px;
        padding: 1rem;
        text-decoration: none;
        color: #475569;
        transition: all 0.2s ease;
    }

    .quick-action-card:hover {
        transform: translateY(-2px);
        border-color: rgba(13, 110, 253, 0.28);
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
        color: #0d6efd;
    }

    .quick-action-icon {
        width: 48px;
        height: 48px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        margin-bottom: 0.85rem;
    }

    .quick-action-title {
        display: block;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .quick-action-text {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 650;
        line-height: 1.55;
    }

    .empty-action-box {
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 24px;
        padding: 2rem 1.25rem;
        text-align: center;
        color: #64748b;
    }

    .empty-action-icon {
        width: 80px;
        height: 80px;
        border-radius: 28px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .conf-list-card {
        border: 1px solid #e8eef6;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .conf-item-btn {
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        display: block;
    }

    .conf-item {
        padding: 15px 20px;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .conf-item:hover {
        background-color: #f8fafc;
    }

    .conf-item.active {
        background-color: #f0f9ff;
        border-left: 4px solid #00aeef;
    }

    .date-box {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        width: 50px;
        text-align: center;
        margin-right: 15px;
        flex-shrink: 0;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }

    .date-month {
        font-size: 0.6rem;
        text-transform: uppercase;
        color: #fff;
        background: #94a3b8;
        padding: 2px 0;
        border-radius: 7px 7px 0 0;
        font-weight: bold;
    }

    .date-day {
        font-size: 1.1rem;
        font-weight: 800;
        color: #334155;
        padding: 2px 0;
    }

    .active .date-month {
        background: #00aeef;
    }

    .referee-empty-card {
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 20px;
        padding: 2.5rem 1.5rem;
        text-align: center;
    }

    .referee-empty-icon {
        width: 82px;
        height: 82px;
        border-radius: 50%;
        background: #f8fafc;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        color: #94a3b8;
        font-size: 2.2rem;
    }

    @@media (max-width: 1200px) {
        .quick-action-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .dashboard-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .dashboard-hero-left {
            align-items: flex-start;
        }

        .dashboard-hero-actions,
        .dashboard-hero-actions .btn {
            width: 100%;
        }

        .dashboard-title {
            font-size: 1.65rem;
        }

        .quick-action-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .dashboard-hero-left {
            flex-direction: column;
        }

        .quick-action-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-alert .d-flex,
        .admin-info-alert .d-flex {
            align-items: flex-start !important;
            flex-direction: column;
        }

        .dashboard-alert .btn,
        .admin-info-alert .btn {
            width: 100%;
            margin-top: 0.75rem;
        }
    }
</style>

<div class="container-fluid dashboard-page">

    <div class="dashboard-hero">
        <div class="dashboard-hero-left">
            <div class="dashboard-hero-icon">
                @if (isReferee && !isAdmin)
                {
                    <i class="fas fa-gavel"></i>
                }
                else if (isAdmin)
                {
                    <i class="fas fa-user-shield"></i>
                }
                else
                {
                    <i class="fas fa-gauge-high"></i>
                }
            </div>

            <div>
                <div class="dashboard-section-label">
                    @(isReferee && !isAdmin
                        ? L("RefereeWorkspaceBadge", "Hakem Çalışma Alanı")
                        : isAdmin
                            ? L("AdminViewTitle", "Admin Görünümü")
                            : L("WorkspaceBadge", "Çalışma Alanı"))
                </div>

                <h2 class="dashboard-title">
                    @conferenceDisplayName
                </h2>

                <p class="dashboard-description">
                    @if (isAdmin)
                    {
                        <span>
                            Seçili kongrenizin bildiri, hakem, karar, kayıt ve program süreçlerini buradan hızlıca yönetebilirsiniz.
                        </span>
                    }
                    else if (isReferee && !isAdmin)
                    {
                        <span>
                            Size atanan değerlendirme görevlerini ve hakemlik sürecinizi buradan takip edebilirsiniz.
                        </span>
                    }
                    else
                    {
                        <span>
                            Bildiri, kayıt, program ve sertifika işlemlerinize buradan ulaşabilirsiniz.
                        </span>
                    }
                </p>

                <div class="dashboard-meta-row">
                    <span class="dashboard-meta-chip primary">
                        <i class="far fa-calendar-alt"></i>
                        @DateTime.Now.ToString("dd MMMM yyyy, dddd", CultureInfo.CurrentUICulture)
                    </span>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <span class="dashboard-meta-chip">
                            <i class="fas fa-link"></i>
                            /@slug
                        </span>
                    }

                    @if (hasSelectedConference)
                    {
                        <span class="dashboard-meta-chip">
                            <i class="fas fa-check-circle"></i>
                            Seçili Kongre Aktif
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="dashboard-hero-actions">
            @if (isAdmin && hasSelectedConference)
            {
                <a href="@conferenceFlowUrl"
                   class="btn dashboard-primary-btn">
                    <i class="fas fa-stream"></i>
                    Kongre Akışına Git
                </a>

                <a href="@publicSiteUrl"
                   target="_blank"
                   class="btn dashboard-outline-btn">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    Siteyi Gör
                </a>
            }

            @if (isAdmin)
            {
                <a href="@dashboardMyConferencesUrl"
                   class="btn dashboard-light-btn">
                    <i class="fas fa-right-left"></i>
                    Kongre Değiştir
                </a>
            }
            else if (!isReferee)
            {
                <a href="@dashboardMyConferencesUrl"
                   class="btn dashboard-primary-btn">
                    <i class="fas fa-calendar-check"></i>
                    Kongre Seç
                </a>
            }
        </div>
    </div>

    @if (!hasSelectedConference && !isAdmin && !isReferee)
    {
        <div class="dashboard-alert">
            <div class="d-flex align-items-center gap-3">
                <i class="fas fa-exclamation-circle fs-3"></i>

                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-1">
                        İşlem yapmak için önce kongre seçmelisiniz
                    </h6>

                    <small>
                        Bildiri gönderme, ödeme ve program gibi işlemler seçili kongreye göre çalışır.
                    </small>
                </div>

                <a href="@dashboardMyConferencesUrl"
                   class="btn btn-warning rounded-pill fw-bold px-4">
                    Kongre Seç
                </a>
            </div>
        </div>
    }

    @if (isAdmin)
    {
        <div class="admin-info-alert">
            <div class="d-flex align-items-center gap-3">
                <i class="fas fa-user-shield fs-3"></i>

                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-1">
                        @L("AdminViewTitle", "Admin Görünümü")
                    </h6>

                    <small>
                        @L("AdminViewDescription", "Kurumunuza bağlı kongre süreçlerini buradan takip edebilirsiniz.")
                    </small>
                </div>

                @if (hasSelectedConference)
                {
                    <a href="@conferenceFlowUrl"
                       class="btn btn-primary rounded-pill fw-bold px-4">
                        Kongre Akışı
                    </a>
                }
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="@mainColumnClass">

            @if (isReferee && !isAdmin)
            {
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="dashboard-stat-card">
                            <div>
                                <div class="dashboard-stat-number">
                                    @pendingReviews
                                </div>

                                <div class="dashboard-stat-label">
                                    @L("PendingReview", "Bekleyen Değerlendirme")
                                </div>
                            </div>

                            <div class="dashboard-stat-icon stat-orange">
                                <i class="fas fa-gavel"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="dashboard-stat-card">
                            <div>
                                <div class="dashboard-stat-number">
                                    @completedReviews
                                </div>

                                <div class="dashboard-stat-label">
                                    @L("Completed", "Tamamlanan")
                                </div>
                            </div>

                            <div class="dashboard-stat-icon stat-green">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3 mb-4">
                    <div class="col-xl-3 col-md-6">
                        <div class="dashboard-stat-card">
                            <div>
                                <div class="dashboard-stat-number">
                                    @Model.TotalSubmissions
                                </div>

                                <div class="dashboard-stat-label">
                                    @L("Total", "Toplam Bildiri")
                                </div>
                            </div>

                            <div class="dashboard-stat-icon stat-blue">
                                <i class="fas fa-file-alt"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="dashboard-stat-card">
                            <div>
                                <div class="dashboard-stat-number">
                                    @Model.AwaitingDecision
                                </div>

                                <div class="dashboard-stat-label">
                                    @L("Awaiting", "Karar Bekleyen")
                                </div>
                            </div>

                            <div class="dashboard-stat-icon stat-orange">
                                <i class="fas fa-hourglass-half"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="dashboard-stat-card">
                            <div>
                                <div class="dashboard-stat-number">
                                    @Model.AcceptedSubmissions
                                </div>

                                <div class="dashboard-stat-label">
                                    @L("Accepted", "Kabul Edilen")
                                </div>
                            </div>

                            <div class="dashboard-stat-icon stat-green">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="dashboard-stat-card">
                            <div>
                                <div class="dashboard-stat-number">
                                    @Model.RejectedSubmissions
                                </div>

                                <div class="dashboard-stat-label">
                                    @L("Rejected", "Reddedilen")
                                </div>
                            </div>

                            <div class="dashboard-stat-icon stat-red">
                                <i class="fas fa-times-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="dashboard-section-card">
                <div class="dashboard-card-header">
                    <div>
                        <div class="dashboard-card-title">
                            @L("QuickActions", "Hızlı İşlemler")
                        </div>

                        <p class="dashboard-card-subtitle">
                            @if (isAdmin)
                            {
                                <span>Kongre operasyon ekranlarına hızlı geçiş yapabilirsiniz.</span>
                            }
                            else if (isReferee && !isAdmin)
                            {
                                <span>Hakemlik görevlerinize ve belgelerinize buradan ulaşabilirsiniz.</span>
                            }
                            else
                            {
                                <span>Başvuru, bildiri ve mesaj işlemlerinize buradan ulaşabilirsiniz.</span>
                            }
                        </p>
                    </div>

                    @if (!isAdmin && !isReferee && hasSelectedConference)
                    {
                        <a href="@submissionIndexUrl"
                           class="btn dashboard-light-btn">
                            @L("AllMySubmissions", "Tüm Bildirilerim")
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    }
                </div>

                <div class="dashboard-card-body">

                    @if (!hasSelectedConference && !isAdmin && !isReferee)
                    {
                        <div class="empty-action-box">
                            <div class="empty-action-icon">
                                <i class="fas fa-hand-pointer"></i>
                            </div>

                            <h5 class="fw-bold text-dark">
                                Önce Kongre Seçmelisiniz
                            </h5>

                            <p class="text-muted small mb-4">
                                Başvuru, ödeme, program ve sertifika işlemleri seçili kongre üzerinden ilerler.
                            </p>

                            <a href="@dashboardMyConferencesUrl"
                               class="btn dashboard-primary-btn">
                                <i class="fas fa-calendar-check"></i>
                                Kongre Seç
                            </a>
                        </div>
                    }
                    else if (Model.TotalSubmissions == 0 && !isAdmin && !isReferee)
                    {
                        <div class="empty-action-box">
                            <div class="empty-action-icon">
                                <i class="fas fa-paper-plane"></i>
                            </div>

                            <h5 class="fw-bold text-dark">
                                @L("NoSubmissionTitle", "Henüz başvurunuz yok")
                            </h5>

                            <p class="text-muted small mb-4">
                                @L("NoSubmissionDescription", "Seçili kongre için yeni bir bildiri başvurusu oluşturabilirsiniz.")
                            </p>

                            <a href="@submissionCreateUrl"
                               class="btn dashboard-primary-btn">
                                <i class="fas fa-plus"></i>
                                @L("CreateNewSubmission", "Yeni Bildiri Oluştur")
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="quick-action-grid">

                            @if (isReferee && !isAdmin)
                            {
                                <a href="@reviewIndexUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-orange">
                                            <i class="fas fa-gavel"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            @L("ReviewPanel", "Görevlerim")
                                        </span>

                                        <span class="quick-action-text">
                                            @L("RefereeEntry", "Atanmış bildirileri değerlendir")
                                        </span>
                                    </div>
                                </a>

                                <a href="@certificatesIndexUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-green">
                                            <i class="fas fa-certificate"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            @L("Certificates", "Sertifikalarım")
                                        </span>

                                        <span class="quick-action-text">
                                            @L("CertificatesDescription", "Belgelerinizi indirin")
                                        </span>
                                    </div>
                                </a>

                                <a href="@reviewGuidelinesUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-blue">
                                            <i class="fas fa-book-open"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            @L("RefereeGuide", "Hakem Rehberi")
                                        </span>

                                        <span class="quick-action-text">
                                            @L("RefereeGuideDescription", "Değerlendirme kuralları")
                                        </span>
                                    </div>
                                </a>

                                <a href="@messageIndexUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-purple">
                                            <i class="fas fa-envelope"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            @L("Messages", "Mesajlar")
                                        </span>

                                        <span class="quick-action-text">
                                            @L("MessagesDescription", "İletişim kutusu")
                                        </span>
                                    </div>
                                </a>
                            }
                            else if (isAdmin)
                            {
                                <a href="@conferenceFlowUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-blue">
                                            <i class="fas fa-stream"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Kongre Akışı
                                        </span>

                                        <span class="quick-action-text">
                                            Tüm operasyon ekranlarına tek yerden geçin.
                                        </span>
                                    </div>
                                </a>

                                <a href="@adminSubmissionsUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-cyan">
                                            <i class="fas fa-file-lines"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Bildiri Yönetimi
                                        </span>

                                        <span class="quick-action-text">
                                            Gelen bildirileri ve başvuru durumlarını inceleyin.
                                        </span>
                                    </div>
                                </a>

                                <a href="@adminAssignmentUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-orange">
                                            <i class="fas fa-user-check"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Hakem Atama
                                        </span>

                                        <span class="quick-action-text">
                                            Bildirilere uygun hakemleri atayın.
                                        </span>
                                    </div>
                                </a>

                                <a href="@adminDecisionUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-green">
                                            <i class="fas fa-gavel"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Karar Ekranı
                                        </span>

                                        <span class="quick-action-text">
                                            Kabul, ret veya revizyon kararlarını yönetin.
                                        </span>
                                    </div>
                                </a>

                                <a href="@adminRefereeUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-purple">
                                            <i class="fas fa-users"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Hakem Havuzu
                                        </span>

                                        <span class="quick-action-text">
                                            Kurumunuza bağlı hakem listesini yönetin.
                                        </span>
                                    </div>
                                </a>

                                <a href="@adminRegistrationsUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-cyan">
                                            <i class="fas fa-credit-card"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Kayıtlar & Ödemeler
                                        </span>

                                        <span class="quick-action-text">
                                            Katılımcı kayıtlarını ve ödeme durumlarını takip edin.
                                        </span>
                                    </div>
                                </a>

                                <a href="@adminProgramUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-blue">
                                            <i class="fas fa-microphone"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Program / Oturumlar
                                        </span>

                                        <span class="quick-action-text">
                                            Kongre programını ve oturumları düzenleyin.
                                        </span>
                                    </div>
                                </a>

                                <a href="@adminProceedingBookUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-green">
                                            <i class="fas fa-book-open"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            Bildiri Kitabı
                                        </span>

                                        <span class="quick-action-text">
                                            Kabul edilen bildirilerden kitap sürecini yönetin.
                                        </span>
                                    </div>
                                </a>
                            }
                            else
                            {
                                @if (isAuthor)
                                {
                                    <a href="@submissionCreateUrl" class="quick-action-card">
                                        <div>
                                            <div class="quick-action-icon stat-blue">
                                                <i class="fas fa-plus-circle"></i>
                                            </div>

                                            <span class="quick-action-title">
                                                @L("AddNewSubmission", "Yeni Bildiri Ekle")
                                            </span>

                                            <span class="quick-action-text">
                                                Seçili kongreye yeni bildiri gönderin.
                                            </span>
                                        </div>
                                    </a>

                                    <a href="@submissionIndexUrl" class="quick-action-card">
                                        <div>
                                            <div class="quick-action-icon stat-green">
                                                <i class="fas fa-list"></i>
                                            </div>

                                            <span class="quick-action-title">
                                                @L("ViewMySubmissions", "Bildirilerimi Gör")
                                            </span>

                                            <span class="quick-action-text">
                                                Daha önce gönderdiğiniz bildirileri takip edin.
                                            </span>
                                        </div>
                                    </a>
                                }

                                <a href="@messageIndexUrl" class="quick-action-card">
                                    <div>
                                        <div class="quick-action-icon stat-purple">
                                            <i class="fas fa-envelope"></i>
                                        </div>

                                        <span class="quick-action-title">
                                            @L("Messages", "Mesajlar")
                                        </span>

                                        <span class="quick-action-text">
                                            Sistem mesajlarını ve bildirimleri görüntüleyin.
                                        </span>
                                    </div>
                                </a>
                            }

                        </div>
                    }
                </div>
            </div>

            @if (isReferee && !isAdmin)
            {
                <div class="dashboard-section-card">
                    <div class="dashboard-card-header">
                        <div>
                            <div class="dashboard-card-title">
                                <i class="far fa-clock text-danger me-2"></i>
                                @L("NeedsAttention", "Dikkat Gerektirenler")
                            </div>

                            <p class="dashboard-card-subtitle">
                                Bekleyen hakemlik görevleriniz burada özetlenir.
                            </p>
                        </div>

                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                            @L("Urgent", "Acil")
                        </span>
                    </div>

                    <div class="dashboard-card-body">
                        @if (pendingReviews > 0)
                        {
                            <div class="d-flex align-items-center">
                                <div class="dashboard-stat-icon stat-red me-3">
                                    <i class="fas fa-gavel"></i>
                                </div>

                                <div class="flex-grow-1">
                                    <h6 class="mb-1 fw-bold text-dark">
                                        @L("PendingReviewNoticeTitle", "Bekleyen değerlendirmeleriniz var")
                                    </h6>

                                    <small class="text-danger fw-bold">
                                        <i class="fas fa-exclamation-circle me-1"></i>
                                        @pendingReviews @L("PendingReviewNoticeText", "değerlendirme bekliyor")
                                    </small>
                                </div>

                                <a href="@reviewIndexUrl"
                                   class="btn btn-sm btn-outline-danger rounded-pill fw-bold px-3">
                                    @L("Review", "İncele")
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="referee-empty-card">
                                <div class="referee-empty-icon">
                                    <i class="fas fa-clipboard-check"></i>
                                </div>

                                <h5 class="fw-bold text-dark mb-2">
                                    @L("NoPendingReviewDashboardTitle", "Bekleyen değerlendirme bulunmuyor")
                                </h5>

                                <p class="text-muted small mb-0">
                                    @L("NoPendingReviewDashboardDescription", "Size yeni bir değerlendirme görevi atandığında bu alanda görüntülenecektir.")
                                </p>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>

        <div class="@sideColumnClass">
            <div class="conf-list-card mb-4">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                    <h6 class="fw-bold mb-0 text-dark">
                        @L("MyRegisteredCongresses", "Kayıtlı Kongrelerim")
                    </h6>

                    <a href="@dashboardMyConferencesUrl" class="text-decoration-none small fw-bold">
                        @L("AllCaps", "Tümü")
                    </a>
                </div>

                <div class="list-group list-group-flush">
                    @if (Model.MyConferences != null && Model.MyConferences.Any())
                    {
                        @foreach (var conf in Model.MyConferences.Take(5))
                        {
                            var tenantSlug = conf.Tenant?.Slug ?? conf.Slug ?? "";
                            var isActive = selectedConferenceId.HasValue && selectedConferenceId.Value == conf.Id;

                            var selectReturnUrl = string.IsNullOrWhiteSpace(tenantSlug)
                                ? "/Dashboard"
                                : $"/{tenantSlug}/Dashboard";

                            <form asp-controller="Dashboard"
                                  asp-action="SelectConferencePost"
                                  asp-route-slug="@tenantSlug"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="conferenceId" value="@conf.Id" />
                                <input type="hidden" name="returnUrl" value="@selectReturnUrl" />

                                <button type="submit" class="conf-item-btn">
                                    <div class="conf-item @(isActive ? "active" : "")">
                                        <div class="date-box">
                                            <div class="date-month">
                                                @conf.StartDate.ToString("MMM", CultureInfo.CurrentUICulture).ToUpper()
                                            </div>

                                            <div class="date-day">
                                                @conf.StartDate.Day
                                            </div>
                                        </div>

                                        <div class="flex-grow-1 overflow-hidden">
                                            <h6 class="fw-bold text-dark mb-0 text-truncate small" title="@conf.Title">
                                                @conf.Title
                                            </h6>

                                            <small class="text-muted d-block text-truncate" style="font-size: 0.7rem;">
                                                <i class="fas fa-map-marker-alt me-1"></i>
                                                @(conf.City ?? L("Online", "Online"))
                                            </small>
                                        </div>

                                        @if (isActive)
                                        {
                                            <i class="fas fa-check-circle text-primary ms-2"></i>
                                        }
                                    </div>
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="fas fa-calendar-times mb-2 fs-4"></i>

                            <p class="small mb-0">
                                @L("NoRegisteredCongressYet", "Henüz kayıtlı kongreniz yok.")
                            </p>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-white position-relative"
                 style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%);">

                <div class="card-body p-4 position-relative z-1">
                    <h6 class="fw-bold mb-2">
                        @L("NeedHelp", "Yardıma mı ihtiyacınız var?")
                    </h6>

                    <p class="small opacity-75 mb-3">
                        @L("SupportDescription", "Destek ekibimizden yardım alabilirsiniz.")
                    </p>

                    <a href="/Home/Contact"
                       class="btn btn-light text-dark fw-bold w-100 rounded-pill shadow-sm btn-sm">
                        <i class="fas fa-headset me-2"></i>
                        @L("CreateSupportRequest", "Destek Talebi Oluştur")
                    </a>
                </div>

                <i class="fas fa-life-ring position-absolute text-white opacity-10"
                   style="font-size: 5rem; right: -20px; bottom: -20px;"></i>
            </div>
        </div>
    </div>
</div>
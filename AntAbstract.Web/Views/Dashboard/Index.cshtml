@section Scripts {
    @if (isAdmin && Model?.SelectedConference != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const canvas = document.getElementById('dashboardTrendChart');

                if (!canvas || typeof Chart === 'undefined') {
                    return;
                }

                const labels = @Html.Raw(trendLabelsJson);
                const registrations = @Html.Raw(dailyRegistrationsJson);
                const payments = @Html.Raw(dailyPaymentsJson);
                const currency = @Html.Raw(JsonSerializer.Serialize(Model.RevenueCurrency));

                new Chart(canvas.getContext('2d'), {
                    data: {
                        labels,
                        datasets: [
                            {
                                type: 'bar',
                                label: 'Günlük kayıt',
                                data: registrations,
                                backgroundColor: 'rgba(13, 110, 253, 0.18)',
                                borderColor: '#0d6efd',
                                borderWidth: 1,
                                borderRadius: 8,
                                yAxisID: 'registrations'
                            },
                            {
                                type: 'line',
                                label: `Ödeme (${currency})`,
                                data: payments,
                                borderColor: '#10b981',
                                backgroundColor: 'rgba(16, 185, 129, 0.12)',
                                borderWidth: 3,
                                fill: true,
                                tension: 0.36,
                                pointRadius: 3,
                                pointHoverRadius: 5,
                                yAxisID: 'payments'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { usePointStyle: true, font: { weight: '700' } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        if (ctx.dataset.yAxisID === 'payments') {
                                            return `${ctx.dataset.label}: ${Number(ctx.raw || 0).toLocaleString('tr-TR')} ${currency}`;
                                        }

                                        return `${ctx.dataset.label}: ${ctx.raw || 0}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { weight: '700' } }
                            },
                            registrations: {
                                type: 'linear',
                                position: 'left',
                                beginAtZero: true,
                                ticks: { precision: 0 },
                                title: { display: true, text: '' }
                            },
                            payments: {
                                type: 'linear',
                                position: 'right',
                                beginAtZero: true,
                                grid: { drawOnChartArea: false },
                                ticks: {
                                    callback: function (value) {
                                        return Number(value).toLocaleString('tr-TR');
                                    }
                                },
                                title: { display: true, text: currency }
                            }
                        }
                    }
                });
            });
        </script>
    }
}

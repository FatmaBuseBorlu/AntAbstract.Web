@using AntAbstract.Web.Models.ViewModels.Admin.Dashboard
@model DashboardViewModel
@inject AntAbstract.Infrastructure.Context.TenantContext Tc

@{
    ViewData["Title"] = "Panel";
    Layout = "_LayoutDashboard";

    bool isReferee = ViewBag.IsReferee ?? false;
    bool isAuthor = ViewBag.IsAuthor ?? false;
    int pendingReviews = ViewBag.PendingReviews ?? 0;
    int completedReviews = ViewBag.CompletedReviews ?? 0;
    bool isAdmin = User.IsInRole("Admin");

    string mainColumnClass = isAdmin ? "col-12" : "col-xl-8 col-lg-7";
    string sideColumnClass = isAdmin ? "d-none" : "col-xl-4 col-lg-5";

    var slug = Context.GetRouteValue("slug")?.ToString() ?? Tc.Current?.Slug ?? "";
    var baseUrl = string.IsNullOrWhiteSpace(slug) ? "" : $"/{slug}";

    // Linkler
    var reviewIndexUrl = $"{baseUrl}/Review/Index";
    var submissionCreateUrl = $"{baseUrl}/Submission/Create";
    var submissionIndexUrl = $"{baseUrl}/Submission/Index";
    var dashboardUrl = $"{baseUrl}/Dashboard";
    var dashboardMyConferencesUrl = $"{baseUrl}/Dashboard/MyConferences";
    var adminUsersUrl = $"{baseUrl}/Admin/Users";
}

<style>
    /* Liste Elemanı: Tıklanabilir Yapı */
    .conf-switch-btn {
        background: none;
        border: none;
        padding: 0;
        width: 100%;
        text-align: left;
    }

    .conf-list-item {
        transition: all 0.2s;
        border-left: 3px solid transparent;
        cursor: pointer;
    }

        .conf-list-item:hover {
            background-color: #f8fafc;
            border-left-color: var(--primary-color);
            transform: translateX(5px);
        }

        .conf-list-item.active-conf {
            background-color: #f0f9ff;
            border-left-color: var(--primary-color);
        }

    /* Tarih Rozeti */
    .date-badge-sm {
        background-color: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 4px 8px;
        text-align: center;
        min-width: 50px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }

    .date-month {
        font-size: 0.65rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #64748b;
        display: block;
        line-height: 1;
        margin-bottom: 2px;
    }

    .date-day {
        font-size: 1rem;
        font-weight: 800;
        display: block;
        line-height: 1;
        color: #334155;
    }
</style>

<div class="card border-0 shadow-sm mb-4 bg-white overflow-hidden">
    <div class="card-body p-4 position-relative">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10 rounded-pill me-2">
                        <i class="fas fa-check-circle me-1"></i> AKTİF
                    </span>
                    <small class="text-muted text-uppercase fw-bold" style="letter-spacing: 0.5px; font-size: 0.7rem;">Çalışma Alanı</small>
                </div>
                <h3 class="fw-bold text-dark mb-1">
                    @(string.IsNullOrEmpty(Model.ConferenceName) ? "Genel Yönetim Paneli" : Model.ConferenceName)
                </h3>
                <p class="text-muted mb-0 small">
                    <i class="far fa-calendar-alt me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy")
                </p>
            </div>

            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a href="@dashboardMyConferencesUrl" class="btn btn-outline-primary rounded-pill fw-bold shadow-sm px-4">
                    <i class="fas fa-exchange-alt me-2"></i> Kongre Değiştir
                </a>
            </div>
        </div>
    </div>
    <div class="progress" style="height: 3px;">
        <div class="progress-bar bg-primary" role="progressbar" style="width: 100%"></div>
    </div>
</div>

@if (isAdmin)
{
    <div class="alert alert-primary border-0 shadow-sm d-flex align-items-center mb-4 rounded-3">
        <div class="bg-primary text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fas fa-user-shield"></i>
        </div>
        <div>
            <h6 class="fw-bold mb-0">Yönetici Modu</h6>
            <small>Tüm yetkilere sahipsiniz.</small>
        </div>
    </div>
}

<div class="row g-4">
    <div class="@mainColumnClass">

        @if ((isAuthor || !isReferee) && !isAdmin)
        {
            <h6 class="text-muted fw-bold small text-uppercase mb-3 ps-1">BİLDİRİ ÖZETİ</h6>
            <div class="row g-3 mb-4 row-cols-2 row-cols-xl-4">
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3 text-center">
                        <h6 class="text-muted small fw-bold mb-2">TOPLAM</h6>
                        <h2 class="fw-bold text-dark mb-0">@Model.TotalSubmissions</h2>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3 text-center border-bottom border-4 border-warning">
                        <h6 class="text-muted small fw-bold mb-2">BEKLEYEN</h6>
                        <h2 class="fw-bold text-warning mb-0">@Model.AwaitingDecision</h2>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3 text-center border-bottom border-4 border-success">
                        <h6 class="text-muted small fw-bold mb-2">KABUL</h6>
                        <h2 class="fw-bold text-success mb-0">@Model.AcceptedSubmissions</h2>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm h-100 p-3 text-center border-bottom border-4 border-danger">
                        <h6 class="text-muted small fw-bold mb-2">RED</h6>
                        <h2 class="fw-bold text-danger mb-0">@Model.RejectedSubmissions</h2>
                    </div>
                </div>
            </div>
        }

        @if (isReferee && !isAdmin)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted small fw-bold mb-1">DEĞERLENDİRME BEKLEYEN</h6>
                                <h2 class="fw-bold text-dark mb-0">@pendingReviews</h2>
                            </div>
                            <i class="fas fa-hourglass-half fa-2x text-warning opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 border-start border-4 border-success p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted small fw-bold mb-1">TAMAMLANAN</h6>
                                <h2 class="fw-bold text-dark mb-0">@completedReviews</h2>
                            </div>
                            <i class="fas fa-check-circle fa-2x text-success opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm" style="min-height: 350px;">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Son Hareketler</h6>
                @if (!isAdmin && isAuthor)
                {
                    <a href="@submissionIndexUrl" class="small fw-bold text-decoration-none">Tümünü Gör</a>
                }
            </div>
            <div class="card-body d-flex align-items-center justify-content-center flex-column">
                @if (Model.TotalSubmissions == 0 && !isAdmin && !isReferee)
                {
                    <div class="mb-3 p-3 bg-light rounded-circle"><i class="fas fa-file-signature fa-2x text-muted opacity-50"></i></div>
                    <h6 class="fw-bold text-dark">Henüz Bildiri Yok</h6>
                    <p class="text-muted small mb-4">Kongreye katılım için ilk bildirinizi gönderin.</p>
                    <a href="@submissionCreateUrl" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm"><i class="fas fa-plus me-1"></i> Yeni Bildiri</a>
                }
                else
                {
                    <p class="text-muted small">Güncel bildiriminiz bulunmuyor.</p>
                }
            </div>
        </div>
    </div>

    <div class="@sideColumnClass">

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Hızlı Geçiş</h6>
                <a href="@dashboardMyConferencesUrl" class="text-decoration-none small fw-bold" style="font-size: 0.75rem;">TÜMÜ</a>
            </div>

            <div class="list-group list-group-flush">
                @if (Model.MyConferences != null && Model.MyConferences.Any())
                {
                    @foreach (var conf in Model.MyConferences.Take(5)) // Sadece ilk 5 tanesini göster
                    {
                        var tenantSlug = conf.Tenant?.Slug ?? conf.Slug ?? "";
                        var isActive = conf.Title == Model.ConferenceName; // Basit bir aktiflik kontrolü

                        <form asp-controller="Dashboard" asp-action="SelectConferencePost" asp-route-slug="@tenantSlug" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="conferenceId" value="@conf.Id" />
                            <input type="hidden" name="returnUrl" value="@dashboardUrl" />

                            <button type="submit" class="conf-switch-btn">
                                <div class="list-group-item px-3 py-3 border-light conf-list-item @(isActive ? "active-conf" : "")">
                                    <div class="d-flex align-items-center">
                                        <div class="date-badge-sm me-3 flex-shrink-0">
                                            <span class="date-month">@conf.StartDate.ToString("MMM")</span>
                                            <span class="date-day">@conf.StartDate.Day</span>
                                        </div>

                                        <div class="flex-grow-1" style="min-width: 0;">
                                            <h6 class="fw-bold text-dark mb-0 text-truncate small" title="@conf.Title">
                                                @conf.Title
                                            </h6>
                                            <small class="text-muted d-block text-truncate" style="font-size: 0.7rem;">
                                                @(conf.City ?? "Online")
                                            </small>
                                        </div>

                                        <div class="flex-shrink-0 ms-2 text-muted">
                                            @if (isActive)
                                            {
                                                <i class="fas fa-check-circle text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-chevron-right small"></i>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </form>
                    }
                }
                else
                {
                    <div class="p-4 text-center text-muted small">
                        Kayıtlı kongre yok. <a href="/Home/Index#congress-list" class="fw-bold">İncele</a>
                    </div>
                }
            </div>
        </div>

        <div class="card bg-primary text-white border-0 shadow-sm overflow-hidden position-relative" style="background: linear-gradient(135deg, #00aeef 0%, #007bb5 100%);">
            <div class="card-body p-4 position-relative z-1">
                <h6 class="fw-bold mb-2">Yardım Merkezi</h6>
                <p class="small opacity-75 mb-3">Teknik sorunlarınızda destek ekibimiz yanınızda.</p>
                <a href="/Home/Contact" class="btn btn-light text-primary fw-bold w-100 shadow-sm rounded-pill btn-sm">Destek Talebi</a>
            </div>
            <i class="far fa-life-ring position-absolute text-white opacity-10" style="font-size: 6rem; right: -15px; bottom: -25px;"></i>
        </div>

    </div>
</div>
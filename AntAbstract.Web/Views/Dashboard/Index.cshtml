@model AntAbstract.Web.Models.ViewModels.Admin.Dashboard.DashboardViewModel

@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Http
@using System
@using System.Linq

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    ViewData["Title"] = L("PageTitle", "Panel");
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var selectedConferenceTitle = Context.Session.GetString("SelectedConferenceTitle") ?? "";

    var conferenceTitle = !string.IsNullOrWhiteSpace(selectedConferenceTitle)
        ? selectedConferenceTitle
        : Model?.ConferenceName ?? L("GeneralPanelTitle", "Genel Panel");

    var isReviewer = ViewBag.IsReferee == true;
    var isAuthor = ViewBag.IsAuthor == true;

    var pendingReviews = ViewBag.PendingReviews is int pending
        ? pending
        : 0;

    var completedReviews = ViewBag.CompletedReviews is int completed
        ? completed
        : 0;

    string BuildUrl(string cleanPath, string fallbackPath)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return fallbackPath;
        }

        return $"/{slug}{cleanPath}";
    }

    var mySubmissionsUrl = BuildUrl("/my-submissions", "/Submission/Index");
    var submitAbstractUrl = BuildUrl("/submit-abstract", "/Submission/Create");
    var programUrl = BuildUrl("/Program/Index", "/Program/Index");
    var proceedingBookUrl = BuildUrl("/Dashboard/ProceedingBook", "/Dashboard/ProceedingBook");
    var paymentsUrl = BuildUrl("/payments", "/Payment/My");
    var accommodationUrl = BuildUrl("/Accommodation/Index", "/Accommodation/Index");
    var certificatesUrl = BuildUrl("/Certificates", "/Certificates");
    var changeConferenceUrl = "/Dashboard/ChangeConference";
}

<style>
    .dashboard-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .dashboard-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .dashboard-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .dashboard-hero-btn-light {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .dashboard-hero-btn-light:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .dashboard-hero-btn-primary {
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        border: none;
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.18);
    }

    .dashboard-hero-btn-primary:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.26);
        text-decoration: none;
    }

    .dashboard-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .dashboard-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 96px;
    }

    .dashboard-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .stat-red {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
    }

    .stat-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .dashboard-stat-value {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .dashboard-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.25rem;
    }

    .dashboard-section-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
        gap: 1.25rem;
        align-items: start;
    }

    .dashboard-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .dashboard-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .dashboard-card-title {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        margin: 0;
    }

    .dashboard-card-subtitle {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        margin: 0.2rem 0 0;
    }

    .dashboard-card-body {
        padding: 1.35rem;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
    }

    .quick-action-card {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: #ffffff;
        padding: 1rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        transition: all 0.2s ease;
        min-height: 92px;
    }

    .quick-action-card:hover {
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-2px);
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.075);
        text-decoration: none;
    }

    .quick-action-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 16px;
        background: rgba(0, 174, 239, 0.10);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .quick-action-title {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 900;
        margin-bottom: 0.15rem;
    }

    .quick-action-text {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.45;
        margin: 0;
    }

    .conference-list {
        display: grid;
        gap: 0.75rem;
    }

    .conference-mini-card {
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 0.95rem;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .conference-mini-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 15px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .conference-mini-title {
        color: #0f172a;
        font-size: 0.86rem;
        font-weight: 900;
        line-height: 1.35;
        margin-bottom: 0.15rem;
    }

    .conference-mini-date {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 750;
    }

    .empty-mini {
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        padding: 1.2rem;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 700;
        text-align: center;
        background: #f8fafc;
    }

    @@media (max-width: 1200px) {
        .dashboard-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-section-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .dashboard-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-title {
            font-size: 1.45rem;
        }

        .dashboard-stat-grid,
        .quick-actions-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 fw-bold mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info border-0 shadow-sm rounded-4 fw-bold mb-4">
            <i class="fas fa-circle-info me-2"></i>
            @TempData["InfoMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 fw-bold mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @if (isReviewer && !isAuthor)
                    {
                        @L("ReviewerDashboardTitle", "Hakem Paneli")
                    }
                    else
                    {
                        @L("DashboardTitle", "Kontrol Paneli")
                    }
                </h3>

                <p class="program-lead">
                    @if (isReviewer && !isAuthor)
                    {
                        @L("ReviewerDashboardLead", "Size atanan değerlendirmeleri, tamamlanan incelemeleri ve kongre süreçlerini buradan takip edebilirsiniz.")
                    }
                    else
                    {
                        @L("DashboardLead", "Seçili kongreye ait bildiri, değerlendirme ve işlem özetlerinizi buradan takip edebilirsiniz.")
                    }
                </p>
            </div>
        </div>

        <div class="dashboard-hero-actions">
            @if (!string.IsNullOrWhiteSpace(conferenceTitle))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-calendar-check"></i>
                    <span>@conferenceTitle</span>
                </div>
            }

            <a href="@changeConferenceUrl" class="dashboard-hero-btn dashboard-hero-btn-light">
                <i class="fas fa-right-left"></i>
                @L("ChangeConferenceButton", "Kongre Değiştir")
            </a>

            @if (isAuthor)
            {
                <a href="@submitAbstractUrl" class="dashboard-hero-btn dashboard-hero-btn-primary">
                    <i class="fas fa-paper-plane"></i>
                    @L("SubmitAbstractButton", "Bildiri Gönder")
                </a>
            }
        </div>
    </div>

    <div class="dashboard-stat-grid">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon stat-blue">
                <i class="fas fa-file-lines"></i>
            </div>

            <div>
                <div class="dashboard-stat-value">
                    @(Model?.TotalSubmissions ?? 0)
                </div>

                <div class="dashboard-stat-label">
                    @L("TotalSubmissionsLabel", "Toplam Bildiri")
                </div>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon stat-green">
                <i class="fas fa-circle-check"></i>
            </div>

            <div>
                <div class="dashboard-stat-value">
                    @(Model?.AcceptedSubmissions ?? 0)
                </div>

                <div class="dashboard-stat-label">
                    @L("AcceptedSubmissionsLabel", "Kabul Edilen")
                </div>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon stat-orange">
                <i class="fas fa-clock"></i>
            </div>

            <div>
                <div class="dashboard-stat-value">
                    @(Model?.AwaitingDecision ?? 0)
                </div>

                <div class="dashboard-stat-label">
                    @L("AwaitingDecisionLabel", "Karar Bekleyen")
                </div>
            </div>
        </div>

        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon stat-red">
                <i class="fas fa-circle-xmark"></i>
            </div>

            <div>
                <div class="dashboard-stat-value">
                    @(Model?.RejectedSubmissions ?? 0)
                </div>

                <div class="dashboard-stat-label">
                    @L("RejectedSubmissionsLabel", "Reddedilen")
                </div>
            </div>
        </div>

        @if (isReviewer)
        {
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon stat-purple">
                    <i class="fas fa-user-check"></i>
                </div>

                <div>
                    <div class="dashboard-stat-value">
                        @pendingReviews
                    </div>

                    <div class="dashboard-stat-label">
                        @L("PendingReviewsLabel", "Bekleyen Değerlendirme")
                    </div>
                </div>
            </div>

            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon stat-green">
                    <i class="fas fa-clipboard-check"></i>
                </div>

                <div>
                    <div class="dashboard-stat-value">
                        @completedReviews
                    </div>

                    <div class="dashboard-stat-label">
                        @L("CompletedReviewsLabel", "Tamamlanan Değerlendirme")
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="dashboard-section-grid">
        <div class="dashboard-card">
            <div class="dashboard-card-header">
                <div>
                    <h5 class="dashboard-card-title">
                        @L("QuickActionsTitle", "Hızlı İşlemler")
                    </h5>

                    <p class="dashboard-card-subtitle">
                        @L("QuickActionsSubtitle", "Sık kullanılan modüllere buradan hızlıca ulaşabilirsiniz.")
                    </p>
                </div>
            </div>

            <div class="dashboard-card-body">
                <div class="quick-actions-grid">
                    @if (isAuthor)
                    {
                        <a href="@submitAbstractUrl" class="quick-action-card">
                            <div class="quick-action-icon">
                                <i class="fas fa-paper-plane"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    @L("SubmitAbstractAction", "Bildiri Gönder")
                                </div>

                                <p class="quick-action-text">
                                    @L("SubmitAbstractActionText", "Yeni bildiriyi değerlendirme sürecine gönder.")
                                </p>
                            </div>
                        </a>

                        <a href="@mySubmissionsUrl" class="quick-action-card">
                            <div class="quick-action-icon">
                                <i class="fas fa-file-lines"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    @L("MySubmissionsAction", "Bildirilerim")
                                </div>

                                <p class="quick-action-text">
                                    @L("MySubmissionsActionText", "Gönderdiğin bildirileri ve durumlarını takip et.")
                                </p>
                            </div>
                        </a>
                    }

                    <a href="@programUrl" class="quick-action-card">
                        <div class="quick-action-icon">
                            <i class="fas fa-calendar-days"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                @L("ProgramAction", "Program")
                            </div>

                            <p class="quick-action-text">
                                @L("ProgramActionText", "Kongre oturumlarını ve sunum saatlerini görüntüle.")
                            </p>
                        </div>
                    </a>

                    <a href="@proceedingBookUrl" class="quick-action-card">
                        <div class="quick-action-icon">
                            <i class="fas fa-book-open"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                @L("ProceedingBookAction", "Bildiri Kitabı")
                            </div>

                            <p class="quick-action-text">
                                @L("ProceedingBookActionText", "Yayınlanan bildiri kitabını görüntüle veya indir.")
                            </p>
                        </div>
                    </a>

                    <a href="@certificatesUrl" class="quick-action-card">
                        <div class="quick-action-icon">
                            <i class="fas fa-award"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                @L("CertificatesAction", "Sertifikalarım")
                            </div>

                            <p class="quick-action-text">
                                @L("CertificatesActionText", "Hak kazandığın belgeleri görüntüle.")
                            </p>
                        </div>
                    </a>

                    <a href="@paymentsUrl" class="quick-action-card">
                        <div class="quick-action-icon">
                            <i class="fas fa-credit-card"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                @L("PaymentsAction", "Ödemelerim")
                            </div>

                            <p class="quick-action-text">
                                @L("PaymentsActionText", "Ödeme kayıtlarını takip et.")
                            </p>
                        </div>
                    </a>

                    <a href="@accommodationUrl" class="quick-action-card">
                        <div class="quick-action-icon">
                            <i class="fas fa-hotel"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                @L("AccommodationAction", "Konaklama")
                            </div>

                            <p class="quick-action-text">
                                @L("AccommodationActionText", "Kongreye ait otel seçeneklerini incele.")
                            </p>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <aside class="dashboard-card">
            <div class="dashboard-card-header">
                <div>
                    <h5 class="dashboard-card-title">
                        @L("MyConferencesTitle", "Kongrelerim")
                    </h5>

                    <p class="dashboard-card-subtitle">
                        @L("MyConferencesSubtitle", "Erişiminizin olduğu kongreler.")
                    </p>
                </div>
            </div>

            <div class="dashboard-card-body">
                @if (Model?.MyConferences != null && Model.MyConferences.Any())
                {
                    <div class="conference-list">
                        @foreach (var conference in Model.MyConferences.Take(5))
                        {
                            <div class="conference-mini-card">
                                <div class="conference-mini-icon">
                                    <i class="fas fa-calendar-check"></i>
                                </div>

                                <div>
                                    <div class="conference-mini-title">
                                        @conference.Title
                                    </div>

                                    <div class="conference-mini-date">
                                        @conference.StartDate.ToString("dd.MM.yyyy")
                                        -
                                        @conference.EndDate.ToString("dd.MM.yyyy")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-mini">
                        <i class="fas fa-circle-info me-1"></i>
                        @L("NoConferenceText", "Henüz görüntülenecek kongre bulunmuyor.")
                    </div>
                }
            </div>
        </aside>
    </div>
</div>
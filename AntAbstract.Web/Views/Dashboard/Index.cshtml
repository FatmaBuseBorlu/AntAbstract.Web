                                <div class="text-muted small">@L("UnassignedSubmissionsLabel", "Atamasız Bildiri")</div>
                            </div>
                        </a>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="text-center p-3 rounded-3" style="background:#f0fff4">
                            <div class="fw-bold fs-3 text-success">@(Model.TotalReferees)</div>

@using AntAbstract.Domain.Entities
@using System
@using System.Collections.Generic
@using System.Linq

@model Submission

@{
    ViewData["Title"] = "Bildiri Detayı";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var slug = ViewBag.Slug as string
               ?? Model.Conference?.Tenant?.Slug
               ?? "";

    var conferenceId = ViewBag.ConferenceId is Guid vbConferenceId
        ? vbConferenceId
        : Model.ConferenceId;

    var conferenceTitle = ViewBag.ConferenceTitle as string
                          ?? Model.Conference?.Title
                          ?? "";

    var returnUrl = ViewBag.ReturnUrl as string;

    var listUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : !string.IsNullOrWhiteSpace(slug)
            ? $"/{slug}/Admin/Submissions?conferenceId={conferenceId}"
            : $"/Admin/Submissions?conferenceId={conferenceId}";

    var flowUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceId}"
        : $"/Admin/ConferenceFlow?conferenceId={conferenceId}";

    var assignUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Admin/Assignment/Assign/{Model.Id}?conferenceId={conferenceId}"
        : $"/Admin/Assignment/Assign/{Model.Id}?conferenceId={conferenceId}";

    var decisionUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Admin/Decision?conferenceId={conferenceId}"
        : $"/Admin/Decision?conferenceId={conferenceId}";

    var changeStatusPostUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Admin/Submissions/ChangeStatus"
        : "/Admin/Submissions/ChangeStatus";

    var authors = Model.SubmissionAuthors?
        .OrderBy(x => x.Order)
        .ToList() ?? new List<SubmissionAuthor>();

    var files = Model.Files?
        .OrderByDescending(x => x.UploadedAt)
        .ToList() ?? new List<SubmissionFile>();

    var assignments = Model.ReviewAssignments?
        .ToList() ?? new List<ReviewAssignment>();

    var completedReviewCount = assignments.Count(x => x.Review != null);
    var totalReviewerCount = assignments.Count;

    var currentStatus = Model.Status;

    string StatusLabel(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "Yeni",
            SubmissionStatus.Pending => "Beklemede",
            SubmissionStatus.UnderReview => "Hakem Değerlendirmesinde",
            SubmissionStatus.Accepted => "Kabul Edildi",
            SubmissionStatus.Rejected => "Reddedildi",
            SubmissionStatus.RevisionRequired => "Revizyon Gerekli",
            SubmissionStatus.Presented => "Sunuldu",
            _ => status.ToString()
        };
    }

    string StatusClass(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "status-new",
            SubmissionStatus.Pending => "status-pending",
            SubmissionStatus.UnderReview => "status-review",
            SubmissionStatus.Accepted => "status-accepted",
            SubmissionStatus.Rejected => "status-rejected",
            SubmissionStatus.RevisionRequired => "status-revision",
            SubmissionStatus.Presented => "status-presented",
            _ => "status-default"
        };
    }

    string StatusIcon(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "fas fa-sparkles",
            SubmissionStatus.Pending => "fas fa-clock",
            SubmissionStatus.UnderReview => "fas fa-user-check",
            SubmissionStatus.Accepted => "fas fa-circle-check",
            SubmissionStatus.Rejected => "fas fa-circle-xmark",
            SubmissionStatus.RevisionRequired => "fas fa-rotate",
            SubmissionStatus.Presented => "fas fa-presentation-screen",
            _ => "fas fa-circle-info"
        };
    }

    string GetAuthorName()
    {
        if (Model.Author == null)
        {
            return "Yazar bilgisi yok";
        }

        var fullName = $"{Model.Author.FirstName} {Model.Author.LastName}".Trim();

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return Model.Author.Email ?? "Yazar bilgisi yok";
    }

    string GetAuthorEmail()
    {
        return Model.Author?.Email ?? "-";
    }

    string GetInitial(string? value, string fallback = "B")
    {
        return string.IsNullOrWhiteSpace(value)
            ? fallback
            : value.Trim().Substring(0, 1).ToUpper();
    }

    string GetReviewerName(ReviewAssignment assignment)
    {
        if (assignment.Reviewer == null)
        {
            return "Hakem bilgisi yok";
        }

        var fullName = $"{assignment.Reviewer.FirstName} {assignment.Reviewer.LastName}".Trim();

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return assignment.Reviewer.Email ?? "Hakem bilgisi yok";
    }

    var statusOptions = new List<SubmissionStatus>
    {
        SubmissionStatus.New,
        SubmissionStatus.Pending,
        SubmissionStatus.UnderReview,
        SubmissionStatus.RevisionRequired,
        SubmissionStatus.Accepted,
        SubmissionStatus.Rejected,
        SubmissionStatus.Presented
    };

    var authorName = GetAuthorName();
}

<div class="container-fluid submission-detail-page">

    <div class="detail-hero-card mb-4">
        <div class="detail-hero-left">
            <div class="detail-hero-icon">
                <i class="fas fa-file-lines"></i>
            </div>

            <div>
                <div class="detail-section-label">
                    Kongre Operasyonları
                </div>

                <h2 class="detail-page-title">
                    Bildiri Detayı
                </h2>

                <p class="detail-page-description">
                    Bildirinin özetini, yazarlarını, dosyalarını, hakem durumunu ve karar sürecini buradan takip edebilirsiniz.
                </p>

                <div class="selected-conference-pill">
                    <i class="fas fa-calendar-check"></i>

                    <span>Seçili Kongre:</span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(conferenceTitle) ? "Kongre seçilmedi" : conferenceTitle)
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <em>/@slug</em>
                    }
                </div>
            </div>
        </div>

        <div class="detail-hero-actions">

            <a href="@flowUrl"
               class="btn detail-light-btn">
                <i class="fas fa-arrow-left me-2"></i>
                Kongre Akışına Dön
            </a>

            <a href="@listUrl"
               class="btn detail-outline-btn">
                <i class="fas fa-list me-2"></i>
                Bildiri Yönetimine Dön
            </a>

        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="detail-stat-card">
                <div class="stat-icon stat-blue">
                    <i class="@StatusIcon(currentStatus)"></i>
                </div>

                <div>
                    <div class="stat-title">Bildiri Durumu</div>
                    <div class="stat-value">@StatusLabel(currentStatus)</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="detail-stat-card">
                <div class="stat-icon stat-green">
                    <i class="fas fa-user-check"></i>
                </div>

                <div>
                    <div class="stat-title">Hakem Durumu</div>
                    <div class="stat-value">@completedReviewCount / @totalReviewerCount</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="detail-stat-card">
                <div class="stat-icon stat-orange">
                    <i class="fas fa-calendar-day"></i>
                </div>

                <div>
                    <div class="stat-title">Gönderim Tarihi</div>
                    <div class="stat-value">@Model.CreatedDate.ToString("dd.MM.yyyy")</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="detail-stat-card">
                <div class="stat-icon stat-purple">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <div class="stat-title">Yazar Sayısı</div>
                    <div class="stat-value">@authors.Count</div>
                </div>
            </div>
        </div>
    </div>

    <div class="detail-main-card mb-4">
        <div class="detail-main-header">
            <div>
                <div class="submission-ref">
                    Ref: #@Model.Id.ToString().Substring(0, 8).ToUpper()
                </div>

                <h3>
                    @Model.Title
                </h3>

                <div class="submission-meta">
                    <span>
                        <i class="fas fa-user me-1"></i>
                        @authorName
                    </span>

                    <span>
                        <i class="fas fa-envelope me-1"></i>
                        @GetAuthorEmail()
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.Topic))
                    {
                        <span>
                            <i class="fas fa-tag me-1"></i>
                            @Model.Topic
                        </span>
                    }
                </div>
            </div>

            <span class="submission-status @StatusClass(currentStatus)">
                @StatusLabel(currentStatus)
            </span>
        </div>

        <div class="detail-main-body">
            <div class="abstract-box">
                <h5>
                    <i class="fas fa-align-left text-primary me-2"></i>
                    Bildiri Özeti
                </h5>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Abstract) ? "Özet bilgisi girilmemiş." : Model.Abstract)
                </p>
            </div>

            <div class="keywords-box">
                <h6>
                    Anahtar Kelimeler
                </h6>

                @if (!string.IsNullOrWhiteSpace(Model.Keywords))
                {
                    <div class="keyword-list">
                        @foreach (var keyword in Model.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="keyword-chip">
                                <i class="fas fa-tag"></i>
                                @keyword
                            </span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted fw-bold small">
                        Anahtar kelime belirtilmedi.
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-4">
            <div class="side-action-card h-100">
                <div class="side-action-header">
                    <div class="side-action-icon soft-blue">
                        <i class="fas fa-bolt"></i>
                    </div>

                    <div>
                        <h5>Hızlı İşlemler</h5>
                        <p>Bu bildiriyle ilgili işlem ekranlarına hızlı geçiş.</p>
                    </div>
                </div>

                <div class="side-action-body">
                    <a href="@assignUrl"
                       class="quick-action-card">
                        <div class="quick-action-icon soft-blue">
                            <i class="fas fa-user-plus"></i>
                        </div>

                        <div>
                            <strong>Hakem Ata</strong>
                            <span>Bu bildiriye hakem seç.</span>
                        </div>

                        <i class="fas fa-arrow-right"></i>
                    </a>

                    <a href="@decisionUrl"
                       class="quick-action-card">
                        <div class="quick-action-icon soft-red">
                            <i class="fas fa-gavel"></i>
                        </div>

                        <div>
                            <strong>Karar Ekranına Git</strong>
                            <span>Kabul, ret veya revizyon kararı ver.</span>
                        </div>

                        <i class="fas fa-arrow-right"></i>
                    </a>

                    <a href="@listUrl"
                       class="quick-action-card">
                        <div class="quick-action-icon soft-gray">
                            <i class="fas fa-list"></i>
                        </div>

                        <div>
                            <strong>Bildiri Yönetimine Dön</strong>
                            <span>Tüm başvuruları görüntüle.</span>
                        </div>

                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-xl-8">
            <div class="side-action-card h-100">
                <div class="side-action-header">
                    <div class="side-action-icon soft-green">
                        <i class="fas fa-pen-to-square"></i>
                    </div>

                    <div>
                        <h5>Durum Yönetimi</h5>
                        <p>Bildiri durumunu hızlıca güncelleyebilirsiniz.</p>
                    </div>
                </div>

                <div class="side-action-body">
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <form method="post"
                              action="@changeStatusPostUrl"
                              class="status-form">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="conferenceId" value="@conferenceId" />
                            <input type="hidden" name="returnUrl" value="@listUrl" />

                            <div>
                                <label class="detail-label">
                                    Yeni Durum
                                </label>

                                <select name="status" class="form-select detail-select">
                                    @foreach (var statusItem in statusOptions)
                                    {
                                        var statusValue = statusItem.ToString();

                                        if (currentStatus == statusItem)
                                        {
                                            <option value="@statusValue" selected>
                                                @StatusLabel(statusItem)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@statusValue">
                                                @StatusLabel(statusItem)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <button type="submit" class="btn detail-primary-btn">
                                <i class="fas fa-save me-2"></i>
                                Durumu Güncelle
                            </button>
                        </form>

                        <div class="status-help-box mt-3">
                            <i class="fas fa-circle-info"></i>
                            <span>
                                Karar işlemleri için asıl önerilen ekran <strong>Bildiri Karar Ekranı</strong>dır. Bu alan hızlı durum güncelleme için bırakılmıştır.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            <i class="fas fa-lock"></i>
                            <strong>Yetki bulunmuyor</strong>
                            <span>Bu alan yalnızca Admin veya Süper Admin kullanıcıları içindir.</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <div class="detail-list-card h-100">
                <div class="detail-list-header">
                    <div>
                        <h5>Yazarlar</h5>
                        <p>Bildiriye bağlı yazar listesi.</p>
                    </div>

                    <span>@authors.Count yazar</span>
                </div>

                <div class="detail-list-body">
                    @if (!authors.Any())
                    {
                        <div class="empty-box">
                            <i class="fas fa-user-slash"></i>
                            <strong>Yazar bilgisi yok</strong>
                            <span>Bu bildiriye bağlı yazar kaydı bulunamadı.</span>
                        </div>
                    }
                    else
                    {
                        <div class="simple-list">
                            @foreach (var author in authors)
                            {
                                var fullName = $"{author.FirstName} {author.LastName}".Trim();

                                if (string.IsNullOrWhiteSpace(fullName))
                                {
                                    fullName = author.Email ?? "Yazar";
                                }

                                <div class="simple-list-item">
                                    <div class="list-avatar">
                                        @GetInitial(fullName, "Y")
                                    </div>

                                    <div class="list-content">
                                        <strong>
                                            @fullName
                                        </strong>

                                        <span>
                                            @(string.IsNullOrWhiteSpace(author.Email) ? "-" : author.Email)
                                        </span>

                                        <small>
                                            @(string.IsNullOrWhiteSpace(author.Institution) ? "Kurum bilgisi yok" : author.Institution)
                                        </small>
                                    </div>

                                    @if (author.IsCorrespondingAuthor)
                                    {
                                        <span class="mini-badge">
                                            Sorumlu Yazar
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="detail-list-card h-100">
                <div class="detail-list-header">
                    <div>
                        <h5>Dosyalar</h5>
                        <p>Bildiriye yüklenen dosyalar.</p>
                    </div>

                    <span>@files.Count dosya</span>
                </div>

                <div class="detail-list-body">
                    @if (!files.Any())
                    {
                        <div class="empty-box">
                            <i class="fas fa-file-circle-xmark"></i>
                            <strong>Dosya yok</strong>
                            <span>Bu bildiriye ait yüklenmiş dosya bulunmuyor.</span>
                        </div>
                    }
                    else
                    {
                        <div class="simple-list">
                            @foreach (var file in files)
                            {
                                <div class="simple-list-item">
                                    <div class="list-avatar file-avatar">
                                        <i class="fas fa-file"></i>
                                    </div>

                                    <div class="list-content">
                                        <strong>
                                            @file.FileName
                                        </strong>

                                        <span>
                                            @file.UploadedAt.ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    </div>

                                    <a href="@file.FilePath"
                                       target="_blank"
                                       class="btn btn-sm detail-light-btn">
                                        <i class="fas fa-download me-1"></i>
                                        İndir
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="detail-list-card mb-4">
        <div class="detail-list-header">
            <div>
                <h5>Hakem Atamaları</h5>
                <p>Bu bildiriye atanmış hakemler ve değerlendirme durumları.</p>
            </div>

            <span>@completedReviewCount / @totalReviewerCount değerlendirme</span>
        </div>

        <div class="detail-list-body">
            @if (!assignments.Any())
            {
                <div class="empty-box">
                    <i class="fas fa-user-check"></i>
                    <strong>Hakem atanmamış</strong>
                    <span>Bu bildiriye henüz hakem atanmamış.</span>

                    <a href="@assignUrl"
                       class="btn detail-primary-btn mt-3">
                        <i class="fas fa-user-plus me-2"></i>
                        Hakem Ata
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 detail-table">
                        <thead>
                            <tr>
                                <th>Hakem</th>
                                <th>E-posta</th>
                                <th>Değerlendirme</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var assignment in assignments)
                            {
                                var reviewerName = GetReviewerName(assignment);
                                var reviewerEmail = assignment.Reviewer?.Email ?? "-";
                                var hasReview = assignment.Review != null;

                                <tr>
                                    <td>
                                        <div class="table-user">
                                            <div class="table-avatar">
                                                @GetInitial(reviewerName, "H")
                                            </div>

                                            <strong>
                                                @reviewerName
                                            </strong>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-muted fw-bold">
                                            @reviewerEmail
                                        </span>
                                    </td>

                                    <td>
                                        @if (hasReview)
                                        {
                                            <span class="review-status done">
                                                <i class="fas fa-check-circle"></i>
                                                Tamamlandı
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="review-status waiting">
                                                <i class="fas fa-clock"></i>
                                                Bekliyor
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

<style>
    .submission-detail-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .detail-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.15), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .detail-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .detail-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .detail-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .detail-page-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.05em;
    }

    .detail-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 600;
        line-height: 1.65;
    }

    .selected-conference-pill {
        width: fit-content;
        margin-top: 0.75rem;
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.10);
        border: 1px solid rgba(0, 174, 239, 0.22);
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .selected-conference-pill span,
    .selected-conference-pill strong {
        color: #0d6efd;
    }

    .selected-conference-pill em {
        color: #64748b;
        font-style: normal;
        font-weight: 900;
    }

    .detail-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .detail-light-btn,
    .detail-outline-btn,
    .detail-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0 1.15rem;
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .detail-light-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #dbe3ef;
    }

    .detail-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .detail-outline-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .detail-outline-btn:hover {
        color: #0d6efd;

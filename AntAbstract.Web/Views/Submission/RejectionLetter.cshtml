@using AntAbstract.Application.DTOs.Submission
@using System.Linq
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model SubmissionDto

@{
    Layout = null;
    ViewData["Title"] = Localizer["PageTitle"].Value;

    var firstAuthor = Model.Authors?.OrderBy(a => a.Order).FirstOrDefault();
    var authorName = firstAuthor != null ? $"{firstAuthor.FirstName} {firstAuthor.LastName}" : Model.CorrespondingAuthorName;
    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <title>@Localizer["PageTitle"]</title>
    <style>
        body {
            font-family: 'Times New Roman', serif;
            padding: 40px;
            color: #333;
            line-height: 1.6;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #d9534f;
        }

        .title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 20px;
            text-decoration: underline;
        }

        .content {
            font-size: 14px;
            text-align: justify;
        }

        .footer {
            margin-top: 50px;
            font-size: 12px;
            color: #777;
            border-top: 1px solid #ddd;
            padding-top: 10px;
            text-align: center;
        }

        .signature {
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">@Localizer["CommitteeTitle"]</div>
        <div style="font-size: 14px; margin-top: 5px;">@Localizer["ScientificBoardTitle"]</div>
    </div>

    <div style="text-align: right; margin-bottom: 20px;">
        <strong>@Localizer["DateLabel"]</strong> @DateTime.Now.ToString("dd MMMM yyyy")
    </div>

    <p><strong>@Localizer["GreetingText", authorName]</strong></p>

    <div class="content">
        <p>
            @Localizer["Paragraph1_Part1"]
            <strong>"Ref: #@Model.Id.ToString().Substring(0, 8).ToUpper()"</strong>
            @Localizer["Paragraph1_Part2"]
            <strong>"@Model.Title"</strong>
            @Localizer["Paragraph1_Part3"]
        </p>

        <p>
            @Localizer["Paragraph2_Part1"]
            <strong>@Localizer["RejectedHighlight"]</strong>
            @Localizer["Paragraph2_Part2"]
        </p>

        <p>
            @Localizer["Paragraph3"]
        </p>

        <p>
            @Localizer["Paragraph4"]
        </p>

        <p>@Localizer["SuccessWishText"]</p>
    </div>

    <div class="signature">
        <p>@Localizer["SignatureGreeting"]</p>
        <br />
        <strong>@Localizer["SignatureName"]</strong><br />
        @Localizer["SignatureTitle1"]<br />
        @Localizer["SignatureTitle2"]
    </div>

    <div class="footer">
        @Localizer["FooterLine1"]<br />
        @Localizer["FooterLine2"]
    </div>

</body>
</html>
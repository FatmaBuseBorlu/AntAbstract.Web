@using AntAbstract.Application.DTOs.Submission
@using AntAbstract.Domain.Entities
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model List<SubmissionDto>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<style>
    .submission-card {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 16px;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

        .submission-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            border-color: #e2e8f0;
        }

    .status-badge {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 30px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-new {
        background-color: #e3f2fd;
        color: #1565c0;
    }

    .status-pending {
        background-color: #fff8e1;
        color: #f57f17;
    }

    .status-review {
        background-color: #fff3e0;
        color: #ef6c00;
    }

    .status-accepted {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .status-rejected {
        background-color: #ffebee;
        color: #c62828;
    }

    .status-revision {
        background-color: #f3e5f5;
        color: #7b1fa2;
    }

    .card-icon-box {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background-color: #f8fafc;
        color: #00aeef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .meta-text {
        font-size: 0.85rem;
        color: #64748b;
    }

    .card-actions {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px dashed #e2e8f0;
        display: flex;
        gap: 10px;
    }

    .btn-card-action {
        flex: 1;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 8px;
        padding: 8px;
    }

    .hover-scale {
        transition: transform 0.2s;
    }

        .hover-scale:hover {
            transform: translateY(-3px);
        }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h3 class="fw-bold text-dark mb-1">@Localizer["PageHeading"]</h3>
            <p class="text-muted mb-0">@Localizer["PageLead"]</p>
        </div>

        @if (ViewBag.CurrentConferenceTitle != null)
        {
            <div class="d-none d-md-block ms-4 me-auto">
                <span class="badge bg-info bg-opacity-10 text-info border border-info px-3 py-2 rounded-pill">
                    <i class="fas fa-filter me-1"></i> @ViewBag.CurrentConferenceTitle
                </span>
                <a href="/Submission/Index" class="btn btn-link btn-sm text-decoration-none text-muted ms-1">@Localizer["ViewAllButton"]</a>
            </div>
        }

        <a href="/Submission/Create" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-sm hover-scale">
            <i class="fas fa-plus-circle me-2"></i> @Localizer["NewSubmissionButton"]
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                SubmissionStatus statusEnum = SubmissionStatus.New;
                Enum.TryParse<SubmissionStatus>(item.Status, out statusEnum);

                string statusClass = statusEnum switch
                {
                    SubmissionStatus.New => "status-new",
                    SubmissionStatus.Pending => "status-pending",
                    SubmissionStatus.UnderReview => "status-review",
                    SubmissionStatus.Accepted => "status-accepted",
                    SubmissionStatus.Rejected => "status-rejected",
                    SubmissionStatus.RevisionRequired => "status-revision",
                    SubmissionStatus.Presented => "bg-primary text-white",
                    _ => "bg-light text-dark border"
                };

                string statusText = statusEnum switch
                {
                    SubmissionStatus.New => Localizer["StatusNewDraft"].Value,
                    SubmissionStatus.Pending => Localizer["StatusPending"].Value,
                    SubmissionStatus.UnderReview => Localizer["StatusUnderReview"].Value,
                    SubmissionStatus.Accepted => Localizer["StatusAccepted"].Value,
                    SubmissionStatus.Rejected => Localizer["StatusRejected"].Value,
                    SubmissionStatus.RevisionRequired => Localizer["StatusRevisionRequired"].Value,
                    SubmissionStatus.Presented => Localizer["StatusPresented"].Value,
                    _ => item.Status
                };

                <div class="col-md-6 col-xl-4">
                    <div class="submission-card p-4">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center text-muted small fw-bold">
                                <i class="far fa-calendar-alt me-2 text-primary opacity-50"></i>
                                @item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                            </div>
                            <span class="status-badge @statusClass">
                                @statusText
                            </span>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <div class="card-icon-box me-3">
                                <i class="fas fa-file-alt"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 text-truncate" style="max-width: 250px;" title="@item.Title">
                                    @item.Title
                                </h6>
                                <p class="mb-0 small text-muted text-truncate" style="max-width: 250px;">
                                    <i class="fas fa-globe me-1 text-secondary opacity-50"></i>
                                    @(item.ConferenceTitle ?? Localizer["ConferenceNotSpecifiedText"].Value)
                                </p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-light text-secondary border fw-normal">
                                    <i class="fas fa-users me-1"></i> @(item.Authors?.Count ?? 0) @Localizer["AuthorsText"]
                                </span>
                                @if (!string.IsNullOrEmpty(item.Keywords))
                                {
                                    var firstKey = item.Keywords.Split(',')[0];
                                    <span class="badge bg-light text-secondary border fw-normal">
                                        <i class="fas fa-tag me-1"></i> @firstKey
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-actions">
                            <a href="@Url.Action("Details", "Submission", new { id = item.Id })" class="btn btn-light border btn-card-action text-dark">
                                <i class="fas fa-eye me-1 text-primary"></i> @Localizer["DetailsButton"]
                            </a>

                            @if (statusEnum == SubmissionStatus.New || statusEnum == SubmissionStatus.RevisionRequired)
                            {
                                <a href="@Url.Action("Edit", "Submission", new { id = item.Id })" class="btn btn-light border btn-card-action text-dark">
                                    <i class="fas fa-edit me-1 text-warning"></i> @Localizer["EditButton"]
                                </a>
                                <a href="@Url.Action("Delete", "Submission", new { id = item.Id })" class="btn btn-light border btn-card-action text-dark">
                                    <i class="fas fa-trash-alt me-1 text-danger"></i> @Localizer["DeleteButton"]
                                </a>
                            }
                            else if (statusEnum == SubmissionStatus.Accepted)
                            {
                                <a href="@Url.Action("DownloadAcceptanceLetter", "Submission", new { id = item.Id })" class="btn btn-success btn-card-action text-white" target="_blank">
                                    <i class="fas fa-certificate me-1"></i> @Localizer["CertificateButton"]
                                </a>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row justify-content-center mt-5">
            <div class="col-md-6 text-center">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 120px; height: 120px;">
                    <i class="fas fa-folder-open fa-4x text-muted opacity-25"></i>
                </div>
                <h4 class="fw-bold text-dark">@Localizer["EmptyStateTitle"]</h4>
                <p class="text-muted mb-4">
                    @Localizer["EmptyStateText"]
                </p>
                <a href="/Submission/Create" class="btn btn-primary px-5 py-3 rounded-pill fw-bold shadow-sm hover-scale">
                    <i class="fas fa-paper-plane me-2"></i> @Localizer["FirstSubmissionButton"]
                </a>
            </div>
        </div>
    }
</div>

<script>
    document.querySelectorAll('.hover-scale').forEach(el => {
        el.addEventListener('mouseenter', () => el.style.transform = 'translateY(-2px)');
        el.addEventListener('mouseleave', () => el.style.transform = 'translateY(0)');
        el.style.transition = 'transform 0.2s';
    });
</script>
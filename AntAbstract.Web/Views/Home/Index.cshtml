@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Identity
@using System.Net
@using System.Text.RegularExpressions
@inject SignInManager<AppUser> SignInManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@model LandingPageViewModel

@{
    ViewData["Title"] = L("HomeSeoTitle", "Anasayfa");
    ViewData["MetaDescription"] = L("HomeSeoDescription", "AntAbstract ile kongre kayıt, bildiri gönderimi, hakem değerlendirme, program, ödeme ve sertifika süreçlerini tek panelden yönetin.");
    Layout = "_Layout";

    string L(string key, string fallback)
    {
        var loc = Localizer.GetString(key);
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    string CleanHtmlText(string? text, int maxLength = 130)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "";
        }

        var withoutTags = Regex.Replace(text, "<.*?>", " ");
        var decoded = WebUtility.HtmlDecode(withoutTags);
        var cleaned = Regex.Replace(decoded, @"\s+", " ").Trim();

        if (cleaned.Length > maxLength)
        {
            return cleaned.Substring(0, maxLength).Trim() + "...";
        }

        return cleaned;
    }

    string GetAuthorInitials(string? authorName)
    {
        if (string.IsNullOrWhiteSpace(authorName))
        {
            return "A";
        }

        var parts = authorName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x.Substring(0, 1).ToUpper());

        var initials = string.Join("", parts);

        return string.IsNullOrWhiteSpace(initials) ? "A" : initials;
    }

    var activeCongresses = Model.ActiveCongresses ?? new List<CongressCardDto>();
    var pastCongresses = Model.PastCongresses ?? new List<CongressCardDto>();
    var proceedingBooks = Model.ProceedingBooks ?? new List<ProceedingBookCardDto>();
    var lastSubmissions = Model.LastSubmissions ?? new List<SubmissionCardDto>();
}


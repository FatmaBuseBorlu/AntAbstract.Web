                <div class="workflow-step" data-animate data-delay="200">
                    <div class="workflow-number">2</div>
                    <div class="workflow-connector"></div>
                    <div class="workflow-card">
                        <div class="workflow-icon"><i class="fas fa-user-plus"></i></div>
                        <h5>@L("Workflow2Title", "Kayıt Ol")</h5>
                        <p>@L("Workflow2Text", "Katılımcı kayıt türünü seçer, bilgilerini girer ve süreci başlatır.")</p>
                    </div>
                </div>

                <div class="workflow-step" data-animate data-delay="300">
                    <div class="workflow-number">3</div>
                    <div class="workflow-connector"></div>
                    <div class="workflow-card">
                        <div class="workflow-icon"><i class="fas fa-file-upload"></i></div>
                        <h5>@L("Workflow3Title", "Bildiri Gönder")</h5>
                        <p>@L("Workflow3Text", "Yazar bildirisini yükler, konu ve yazar bilgilerini sisteme ekler.")</p>
                    </div>
                </div>

                <div class="workflow-step" data-animate data-delay="400">
                    <div class="workflow-number">4</div>
                    <div class="workflow-connector"></div>
                    <div class="workflow-card">
                        <div class="workflow-icon"><i class="fas fa-check-double"></i></div>
                        <h5>@L("Workflow4Title", "Değerlendirme")</h5>
                        <p>@L("Workflow4Text", "Hakemler bildirileri inceler, sonuçlar ve sertifikalar sistemden takip edilir.")</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (proceedingBooks.Any())

    .cta-section {
        background: radial-gradient(circle at top left, rgba(0, 174, 239, 0.16), transparent 30%), linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    }

    .cta-box {
        background: #0f172a;
        color: #ffffff;
        border-radius: 34px;
        padding: clamp(34px, 5vw, 62px);
        box-shadow: 0 32px 80px rgba(15,23,42,0.18);
        position: relative;
        overflow: hidden;
    }

        .cta-box::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            right: -70px;
            top: -80px;
            background: rgba(0,174,239,0.22);

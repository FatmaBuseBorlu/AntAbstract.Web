@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@model LandingPageViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_Layout";
}

<style>
    .page-content-wrapper {
        padding-top: 0;
    }

    .hero-section {
        padding-top: 140px;
        padding-bottom: 80px;
        background: radial-gradient(circle at top right, #f8f9fa 0%, #e9ecef 100%);
        overflow: hidden;
    }

    .dashboard-preview-card {
        transform: perspective(1000px) rotateY(-10deg) rotateX(5deg);
        transition: transform 0.5s ease;
        box-shadow: -20px 20px 60px rgba(0,0,0,0.15);
        border: 8px solid #fff;
        border-radius: 12px;
    }

        .dashboard-preview-card:hover {
            transform: perspective(1000px) rotateY(-5deg) rotateX(2deg) translateY(-10px);
            box-shadow: -10px 10px 40px rgba(0,0,0,0.2);
        }

    .feature-card, .pricing-card {
        background: #fff;
        transition: all 0.3s ease;
        height: 100%;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .feature-card {
        padding: 2rem;
        border-radius: 1rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-color: var(--primary-color);
        }

    .feature-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .pricing-card {
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        position: relative;
        overflow: hidden;
    }

        .pricing-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-color: var(--primary-color);
        }

        .pricing-card.popular {
            border: 2px solid var(--primary-color);
            box-shadow: 0 10px 30px rgba(0, 174, 239, 0.1);
        }

    .popular-badge {
        background: var(--primary-color);
        color: #fff;
        padding: 5px 30px;
        position: absolute;
        top: 20px;
        right: -30px;
        transform: rotate(45deg);
        font-size: 0.8rem;
        font-weight: bold;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .congress-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid rgba(0,0,0,0.05);
    }

        .congress-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,174,239, 0.15) !important;
            border-color: var(--primary-color);
        }

    .card-img-wrapper {
        height: 200px;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    .submission-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .submission-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
            background: #fff !important;
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hover-color {
        transition: all 0.3s ease;
    }

        .hover-color:hover {
            color: var(--primary-color) !important;
            transform: scale(1.1);
        }

    .stats-section {
        background: linear-gradient(135deg, #00aeef 0%, #007bb5 100%);
        color: white;
    }

    .stat-number {
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -1px;
    }
</style>

<div class="page-content-wrapper">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-5 pt-5">
            <div class="alert alert-success border-0 shadow-sm rounded-3">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5">
                    <div class="d-inline-flex align-items-center bg-white shadow-sm rounded-pill px-3 py-2 mb-4 border">
                        <span class="badge bg-primary rounded-pill me-2">@Localizer["NewBadge"]</span>
                        <span class="text-muted small fw-bold">@Localizer["HeroMiniBadgeText"]</span>
                    </div>

                    <h1 class="display-4 fw-bold lh-sm mb-4 text-dark">
                        @Localizer["HeroTitleLine1"] <br>
                        <span style="color: var(--primary-color);">@Localizer["HeroTitleLine2"]</span>
                    </h1>

                    <p class="lead text-muted mb-5">
                        @Localizer["HeroDescription"]
                    </p>

                    <div class="d-flex gap-3">
                        <a href="#congress-list" class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill fw-bold border-0">
                            @Localizer["DiscoverCongressesButton"]
                        </a>
                        <a href="#pricing" class="btn btn-outline-dark btn-lg px-4 rounded-pill">
                            <i class="fas fa-tags me-2"></i>@Localizer["PackagesButton"]
                        </a>
                    </div>
                </div>

                <div class="col-lg-6 text-center">
                    <div class="position-relative" style="z-index: 10;">
                        <img src="https://ui-avatars.com/api/?name=Admin+Panel&background=00aeef&color=fff&size=800&font-size=0.1"
                             class="img-fluid dashboard-preview-card"
                             alt="@Localizer["AdminPanelAlt"]">

                        <div class="position-absolute bg-white p-3 rounded-3 shadow-lg text-start animate__animated animate__fadeInUp"
                             style="bottom: 30px; left: -20px; z-index: 20; max-width: 200px;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-success bg-opacity-10 p-2 rounded-circle text-success">
                                    <i class="fas fa-check-circle fa-2x"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold">100%</h5>
                                    <small class="text-muted">@Localizer["DigitalTransformationText"]</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="congress-list" class="py-5 bg-white">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h6 class="text-uppercase text-primary letter-spacing-2 fw-bold">@Localizer["UpcomingEventsLabel"]</h6>
                <h2 class="fw-bold mb-3 display-6" style="color: #333;">@Localizer["CongressCalendarTitle"]</h2>
                <p class="text-muted mw-600 mx-auto">@Localizer["CongressCalendarDescription"]</p>
                <div style="width: 60px; height: 4px; background: var(--primary-color); margin: 20px auto 0; border-radius: 2px;"></div>
            </div>

            <div class="row g-4">
                @if (Model.ActiveCongresses != null && Model.ActiveCongresses.Any())
                {
                    @foreach (var item in Model.ActiveCongresses)
                    {
                        var vitrinUrl = $"/{item.Slug}";

                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm border-0 congress-card rounded-4 overflow-hidden">
                                <div class="card-img-wrapper position-relative">
                                    @if (item.ImageUrl != null && !item.ImageUrl.Contains("resimyok"))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" class="w-100 h-100 object-fit-cover">
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted opacity-50">
                                            <i class="fas fa-university fa-3x mb-2"></i>
                                            <div>@Localizer["NoImageUploadedText"]</div>
                                        </div>
                                    }
                                    <div class="position-absolute top-0 end-0 m-3 bg-white rounded-3 shadow-sm p-2 text-center lh-1">
                                        <span class="d-block fw-bold text-primary fs-4">@item.StartDate.Day</span>
                                        <small class="text-uppercase text-muted fw-bold" style="font-size: 10px;">@item.StartDate.ToString("MMM")</small>
                                    </div>
                                </div>

                                <div class="card-body d-flex flex-column p-4">
                                    <div class="mb-2">
                                        <span class="badge bg-light text-secondary border">
                                            <i class="fas fa-map-marker-alt text-danger me-1"></i> @item.Location
                                        </span>
                                    </div>

                                    <h5 class="card-title fw-bold mb-3 text-dark">
                                        <a href="@vitrinUrl" class="text-decoration-none text-dark stretched-link">@item.Title</a>
                                    </h5>

                                    <p class="card-text text-muted small mb-4 flex-grow-1">
                                        @item.Description
                                    </p>

                                    <div class="d-grid gap-2 position-relative" style="z-index: 2;">
                                        <a href="@vitrinUrl" class="btn btn-primary fw-bold text-white shadow-sm py-2" style="border-radius: 12px; transition: all 0.3s;">
                                            <i class="fas fa-external-link-alt me-2"></i> @Localizer["ReviewCongressSiteButton"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <div class="alert alert-light border shadow-sm d-inline-block px-5">
                            <i class="fas fa-info-circle text-primary mb-3 fs-1"></i>
                            <h5 class="text-muted">@Localizer["NoActiveCongressText"]</h5>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h6 class="text-uppercase text-primary letter-spacing-2 fw-bold">@Localizer["ProcessesLabel"]</h6>
                <h2 class="fw-bold display-6">@Localizer["EndToEndManagementTitle"]</h2>
                <p class="text-muted mw-600 mx-auto">@Localizer["EndToEndManagementDescription"]</p>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-primary bg-opacity-10 text-primary">
                            <i class="fas fa-laptop-code"></i>
                        </div>
                        <h4 class="fw-bold mb-3">@Localizer["Feature1Title"]</h4>
                        <p class="text-muted">@Localizer["Feature1Description"]</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-success bg-opacity-10 text-success">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <h4 class="fw-bold mb-3">@Localizer["Feature2Title"]</h4>
                        <p class="text-muted">@Localizer["Feature2Description"]</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-warning bg-opacity-10 text-warning">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h4 class="fw-bold mb-3">@Localizer["Feature3Title"]</h4>
                        <p class="text-muted">@Localizer["Feature3Description"]</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-white overflow-hidden">
        <div class="container py-5">
            <div class="row align-items-center gy-5">
                <div class="col-lg-6 order-2 order-lg-1">
                    <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill">@Localizer["ExperienceBadge"]</span>
                    <h2 class="display-5 fw-bold mb-4">@Localizer["WhatIsAntAbstractTitle"]</h2>
                    <p class="lead text-dark opacity-75 mb-4">
                        @Localizer["WhatIsAntAbstractParagraph1"]
                    </p>
                    <p class="text-muted mb-5">
                        @Localizer["WhatIsAntAbstractParagraph2"]
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <span class="fw-bold">@Localizer["ExperienceFeatureText"]</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <span class="fw-bold">@Localizer["SupportFeatureText"]</span>
                            </div>
                        </div>
                    </div>
                    <a href="/Home/About" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">@Localizer["MoreInfoButton"]</a>
                </div>

                <div class="col-lg-6 order-1 order-lg-2">
                    <div class="position-relative ms-lg-5">
                        <img src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                             alt="@Localizer["ConferenceMeetingAlt"]"
                             class="img-fluid rounded-4 shadow-lg"
                             style="transform: rotate(2deg);">
                        <div class="position-absolute bg-primary opacity-10 rounded-4"
                             style="width: 100%; height: 100%; top: -20px; left: -20px; z-index: -1; transform: rotate(-2deg);"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-4 border-bottom border-top bg-light">
        <div class="container">
            <p class="text-center text-muted small fw-bold letter-spacing-2 mb-4">@Localizer["PartnersLabel"]</p>
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-4 justify-content-center align-items-center opacity-75">
                <div class="col text-center"><i class="fas fa-university fa-2x text-secondary hover-color"></i><div class="small mt-2 text-muted">Ankara Üni.</div></div>
                <div class="col text-center"><i class="fas fa-graduation-cap fa-2x text-secondary hover-color"></i><div class="small mt-2 text-muted">Hacettepe</div></div>
                <div class="col text-center"><i class="fas fa-microscope fa-2x text-secondary hover-color"></i><div class="small mt-2 text-muted">TÜBİTAK</div></div>
                <div class="col text-center"><i class="fas fa-globe-europe fa-2x text-secondary hover-color"></i><div class="small mt-2 text-muted">Erasmus+</div></div>
                <div class="col text-center"><i class="fas fa-atom fa-2x text-secondary hover-color"></i><div class="small mt-2 text-muted">ASELSAN</div></div>
                <div class="col text-center"><i class="fas fa-landmark fa-2x text-secondary hover-color"></i><div class="small mt-2 text-muted">Kültür Bak.</div></div>
            </div>
        </div>
    </section>

    <section id="pricing" class="py-5 bg-white">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h6 class="text-uppercase text-primary letter-spacing-2 fw-bold">@Localizer["PackagesLabel"]</h6>
                <h2 class="fw-bold mb-3 display-6">@Localizer["ChoosePlanTitle"]</h2>
                <p class="text-muted mw-600 mx-auto">@Localizer["ChoosePlanDescription"]</p>
            </div>

            <div class="row align-items-center g-4">
                <div class="col-lg-4">
                    <div class="pricing-card p-4">
                        <h5 class="fw-bold text-dark">@Localizer["BasicPackageTitle"]</h5>
                        <p class="text-muted small">@Localizer["BasicPackageSubtitle"]</p>
                        <div class="my-4">
                            <span class="display-6 fw-bold text-dark">10.000 ₺</span>
                            <span class="text-muted">@Localizer["OneTimeText"]</span>
                        </div>
                        <ul class="list-unstyled mb-4 text-muted small">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> @Localizer["BasicFeature1"]</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> @Localizer["BasicFeature2"]</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> @Localizer["BasicFeature3"]</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> @Localizer["BasicFeature4"]</li>
                        </ul>
                        <div class="d-grid">
                            <a href="/Home/Contact" class="btn btn-outline-dark fw-bold rounded-pill">@Localizer["BuyButton"]</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="pricing-card popular p-5 shadow-lg">
                        <div class="popular-badge">@Localizer["PopularBadge"]</div>
                        <h5 class="fw-bold text-primary">@Localizer["StandardPackageTitle"]</h5>
                        <p class="text-muted small">@Localizer["StandardPackageSubtitle"]</p>
                        <div class="my-4">
                            <span class="display-5 fw-bold text-dark">20.000 ₺</span>
                            <span class="text-muted">@Localizer["PerYearText"]</span>
                        </div>
                        <ul class="list-unstyled mb-4 text-secondary">
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i> <strong>@Localizer["StandardFeature1"]</strong></li>
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i> @Localizer["StandardFeature2"]</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i> @Localizer["StandardFeature3"]</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i> @Localizer["StandardFeature4"]</li>
                        </ul>
                        <div class="d-grid">
                            <a href="/Home/Contact" class="btn btn-primary fw-bold rounded-pill py-3">@Localizer["StartNowButton"]</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="pricing-card p-4">
                        <h5 class="fw-bold text-dark">@Localizer["AdvancedPackageTitle"]</h5>
                        <p class="text-muted small">@Localizer["AdvancedPackageSubtitle"]</p>
                        <div class="my-4">
                            <span class="display-6 fw-bold text-dark">40.000 ₺</span>
                            <span class="text-muted">@Localizer["PerYearText"]</span>
                        </div>
                        <ul class="list-unstyled mb-4 text-muted small">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> <strong>@Localizer["AdvancedFeature1"]</strong></li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> @Localizer["AdvancedFeature2"]</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> @Localizer["AdvancedFeature3"]</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> @Localizer["AdvancedFeature4"]</li>
                        </ul>
                        <div class="d-grid">
                            <a href="/Home/Contact" class="btn btn-outline-dark fw-bold rounded-pill">@Localizer["ContactUsButton"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-white border-top">
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div>
                    <h6 class="text-uppercase text-primary letter-spacing-2 fw-bold">@Localizer["AcademicFlowLabel"]</h6>
                    <h2 class="fw-bold mb-0 display-6">@Localizer["LatestSubmissionsTitle"]</h2>
                </div>
                <a href="#" class="btn btn-outline-light text-muted border-0 d-none d-md-block">
                    @Localizer["ViewAllButton"] <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="row g-4">
                @if (Model.LastSubmissions != null && Model.LastSubmissions.Any())
                {
                    @foreach (var sub in Model.LastSubmissions)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-0 shadow-sm submission-card bg-light">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <img src="@sub.AuthorImageUrl" alt="@sub.AuthorName" class="rounded-circle me-3 shadow-sm" width="45" height="45">
                                        <div class="overflow-hidden">
                                            <h6 class="fw-bold mb-0 text-truncate" style="font-size: 0.95rem;">@sub.AuthorName</h6>
                                            <small class="text-muted text-truncate d-block" style="font-size: 0.75rem;">@sub.University</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-white text-primary border mb-3">
                                        <i class="fas fa-hashtag me-1"></i>@sub.ConferenceName
                                    </span>
                                    <h6 class="fw-bold text-dark mb-2 line-clamp-2" style="min-height: 40px;">
                                        @sub.Title
                                    </h6>
                                    <p class="text-muted small line-clamp-3 mb-0">
                                        @sub.AbstractSnippet
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-4 text-muted">@Localizer["NoPublishedSubmissionsText"]</div>
                }
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="text-center mb-5">
                        <h6 class="text-uppercase text-primary fw-bold">@Localizer["FaqLabel"]</h6>
                        <h2 class="fw-bold mb-3">@Localizer["FaqTitle"]</h2>
                        <p class="text-muted">@Localizer["FaqDescription"]</p>
                    </div>

                    <div class="accordion shadow-sm rounded-3 overflow-hidden" id="faqAccordion">
                        <div class="accordion-item border-0 border-bottom">
                            <h2 class="accordion-header">
                                <button class="accordion-button fw-bold collapsed bg-white py-4" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                    @Localizer["Faq1Question"]
                                </button>
                            </h2>
                            <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted pb-4">
                                    @Localizer["Faq1AnswerPart1"] <strong>@Localizer["Faq1AnswerHighlight"]</strong> @Localizer["Faq1AnswerPart2"]
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item border-0 border-bottom">
                            <h2 class="accordion-header">
                                <button class="accordion-button fw-bold collapsed bg-white py-4" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    @Localizer["Faq2Question"]
                                </button>
                            </h2>
                            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted pb-4">
                                    @Localizer["Faq2Answer"]
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item border-0 border-bottom">
                            <h2 class="accordion-header">
                                <button class="accordion-button fw-bold collapsed bg-white py-4" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    @Localizer["Faq3Question"]
                                </button>
                            </h2>
                            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-muted pb-4">
                                    @Localizer["Faq3Answer"]
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="stats-section py-5">
        <div class="container py-4">
            <div class="row text-center">
                <div class="col-md-4 stat-item">
                    <i class="fas fa-users mb-3 display-4 text-white-50"></i>
                    <div class="stat-number">@Model.TotalUsers.ToString("N0")</div>
                    <div class="text-uppercase letter-spacing-1 opacity-75">@Localizer["ActiveUsersStat"]</div>
                </div>
                <div class="col-md-4 stat-item">
                    <i class="fas fa-globe-americas mb-3 display-4 text-white-50"></i>
                    <div class="stat-number">@Model.ActiveCongressesCount</div>
                    <div class="text-uppercase letter-spacing-1 opacity-75">@Localizer["ActiveCongressesStat"]</div>
                </div>
                <div class="col-md-4 stat-item">
                    <i class="fas fa-file-alt mb-3 display-4 text-white-50"></i>
                    <div class="stat-number">500+</div>
                    <div class="text-uppercase letter-spacing-1 opacity-75">@Localizer["CompletedOrganizationsStat"]</div>
                </div>
            </div>
        </div>
    </section>
</div>
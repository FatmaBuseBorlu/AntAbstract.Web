        line-height: 1;
        margin-bottom: 10px;
    }

    .stat-label {
        opacity: 0.86;
        text-transform: uppercase;
        font-weight: 900;
        font-size: 0.78rem;
        letter-spacing: 0.7px;
    }

    .cta-section {
        background: radial-gradient(circle at top left, rgba(0, 174, 239, 0.16), transparent 30%), linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    }

    .cta-box {
        background: #0f172a;
        color: #ffffff;
        border-radius: 34px;
        padding: clamp(34px, 5vw, 62px);
        box-shadow: 0 32px 80px rgba(15,23,42,0.18);
        position: relative;
        overflow: hidden;
    }

        .cta-box::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            right: -70px;
            top: -80px;
            background: rgba(0,174,239,0.22);
        }

        .cta-box h2,
        .cta-box p,
        .cta-box a {
            position: relative;
            z-index: 2;
        }

    .modern-empty-state {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 42px;
        text-align: center;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
    }

        .modern-empty-state i {
            font-size: 2.5rem;
            color: #00aeef;
            margin-bottom: 16px;
        }

    /* ── Animasyonlar ─────────────────────────────────────────────────── */
    [data-animate] {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 0.65s cubic-bezier(.22,1,.36,1), transform 0.65s cubic-bezier(.22,1,.36,1);
    }
    [data-animate].animated {
        opacity: 1;
        transform: translateY(0);
    }
    [data-animate="fade-left"]  { transform: translateX(-40px); }
    [data-animate="fade-right"] { transform: translateX(40px); }
    [data-animate="fade-left"].animated,
    [data-animate="fade-right"].animated { transform: translateX(0); }
    [data-animate="scale"] { transform: scale(0.88); }
    [data-animate="scale"].animated { transform: scale(1); }

    /* Delay yardımcıları */
    [data-delay="100"] { transition-delay: 0.10s; }
    [data-delay="200"] { transition-delay: 0.20s; }
    [data-delay="300"] { transition-delay: 0.30s; }
    [data-delay="400"] { transition-delay: 0.40s; }
    [data-delay="500"] { transition-delay: 0.50s; }
    [data-delay="600"] { transition-delay: 0.60s; }
    [data-delay="700"] { transition-delay: 0.70s; }

    /* Hero partikülleri */
    .hero-particles {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }
    .hero-particles span {
        position: absolute;
        border-radius: 50%;
        animation: floatParticle linear infinite;
        opacity: 0;
    }

    @@keyframes floatParticle {
        0%   { transform: translateY(0) rotate(0deg);   opacity: 0; }
        10%  { opacity: 1; }
        90%  { opacity: 0.7; }
        100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
    }

    /* Sayaç animasyonu */
    .stat-number.counting { transition: none; }

    /* Satır kayan çizgi animasyonu */
    @@keyframes slideInLine {
        from { width: 0; }
        to   { width: 100%; }
    }
    .animate-line::after {
        content: '';
        display: block;
        height: 3px;
        background: linear-gradient(90deg, #00aeef, #0284c7);
        border-radius: 999px;
        animation: slideInLine 0.7s ease forwards;
        margin-top: 6px;
    }

    /* Hero badge pulse */
    @@keyframes badgePulse {
        0%, 100% { box-shadow: 0 10px 30px rgba(15,23,42,0.06); }
        50%       { box-shadow: 0 10px 30px rgba(0,174,239,0.25); }
    }
    .hero-badge { animation: badgePulse 3s ease infinite; }

    /* Dashboard float */
    @@keyframes dashFloat {
        0%, 100% { transform: perspective(1100px) rotateY(-7deg) rotateX(4deg) translateY(0); }
        50%       { transform: perspective(1100px) rotateY(-7deg) rotateX(4deg) translateY(-10px); }
    }
    .dashboard-shell { animation: dashFloat 5s ease-in-out infinite; }
    .dashboard-shell:hover { animation: none; }

    /* Floating note bob */
    @@keyframes noteBob {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-6px); }
    }
    .floating-note { animation: noteBob 4s ease-in-out infinite; }

    /* Shimmer on mock-progress */
    @@keyframes shimmer {
        0%   { background-position: -200% 0; }
        100% { background-position:  200% 0; }
    }
    .mock-progress span {
        background: linear-gradient(90deg, #00aeef, #22c55e, #00aeef);
        background-size: 200% 100%;
        animation: shimmer 2.5s linear infinite;
    }

    /* Kongre kartı reveal */
    .congress-item { transition: opacity 0.35s, transform 0.35s; }

    @@media (max-width: 991.98px) {
        .hero-modern {
            padding-top: 130px;
        }

        .dashboard-shell {
            transform: none;
            margin-top: 28px;
        }

        .floating-note {
            position: static;
            margin-top: 16px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .hero-actions {
            align-items: stretch;
        }

        .primary-pill-btn,
        .secondary-pill-btn {
            width: 100%;
        }

        .modern-congress-body {
            min-height: auto;
        }

        .modern-congress-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .modern-detail-btn {
            width: 100%;
        }
    }
</style>


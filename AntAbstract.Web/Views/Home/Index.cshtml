    <section id="congress-list" class="modern-congress-section py-5">
        <div class="container py-5">

            <div class="text-center mb-5">
                <div class="section-kicker mb-3">
                    <i class="fas fa-calendar-check"></i>
                    @L("UpcomingEventsLabel", "Yaklaşan Etkinlikler")
                </div>

                <h2 class="section-title display-6">
                    @L("CongressCalendarTitle", "Güncel Kongre Takvimi")
                </h2>

                <p class="section-description mx-auto">
                    @L("CongressCalendarDescription", "Başvurusu devam eden ve katılım sağlayabileceğiniz aktif organizasyonları inceleyin.")
                </p>
            </div>

            @if (activeCongresses.Any())
            {
                <div class="d-flex flex-column flex-md-row align-items-md-center gap-3 mb-4">
                    <div class="input-group" style="max-width:360px;">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="congress-search" class="form-control border-start-0 ps-0"
                               placeholder="Kongre ara..." autocomplete="off" />
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-secondary congress-filter active" data-filter="all">Tümü</button>
                        <button class="btn btn-sm btn-outline-success congress-filter" data-filter="submission">Bildiri Açık</button>
                        <button class="btn btn-sm btn-outline-primary congress-filter" data-filter="registration">Kayıt Açık</button>
                    </div>
                    <small class="text-muted ms-auto"><span id="congress-count">@activeCongresses.Count</span> kongre</small>
                </div>
            }

            <div class="row g-4 justify-content-center" id="congress-grid">
                @if (activeCongresses.Any())
                {
                    @foreach (var item in activeCongresses)
                    {
                        var vitrinUrl = $"/{item.Slug}";
                        var panelUrl = "/Dashboard/MyConferences";

                        var locationText = string.IsNullOrWhiteSpace(item.Location)
                        ? L("OnlineConferenceText", "Çevrimiçi")
                        : item.Location;

                        var rawDescriptionText = string.IsNullOrWhiteSpace(item.Description)
                        ? L("CongressDefaultDescription", "Kongre detaylarını inceleyebilir, kayıt ve bildiri gönderim sürecine devam edebilirsiniz.")
                        : item.Description;

                        var descriptionText = CleanHtmlText(rawDescriptionText, 130);

                        <div class="col-md-6 col-lg-4 congress-item"
                             data-title="@item.Title.ToLower()"
                             data-submission="@(item.IsSubmissionOpen ? "true" : "false")"
                             data-registration="@(item.IsRegistrationOpen ? "true" : "false")">
                            <article class="modern-congress-card">
                                <div class="modern-congress-image">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl) &&
                                                                !item.ImageUrl.Contains("resimyok", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title">
                                    }
                                    else
                                    {
                                        <div class="modern-congress-placeholder">
                                            <div>
                                                <i class="fas fa-university"></i>
                                                <span>@L("NoImageUploadedText", "Görsel yüklenmedi")</span>
                                            </div>
                                        </div>
                                    }

                                    <div class="modern-date-badge">
                                        <span class="modern-date-day">
                                            @item.StartDate.Day
                                        </span>

                                        <span class="modern-date-month">
                                            @item.StartDate.ToString("MMM", System.Globalization.CultureInfo.CurrentUICulture)
                                        </span>
                                    </div>
                                </div>

                                <div class="modern-congress-body">
                                    <div class="modern-location-badge">
                                        <i class="fas fa-map-marker-alt"></i>
                                        @locationText
                                    </div>

                                    <a href="@vitrinUrl"
                                       class="modern-congress-title"
                                       title="@item.Title">
                                        @item.Title
                                    </a>

                                    <p class="modern-congress-description">
                                        @descriptionText
                                    </p>

                                    <div class="d-flex gap-1 flex-wrap mb-3">
                                        @if (item.IsSubmissionOpen)
                                        {
                                            <span class="badge" style="background:rgba(34,197,94,.12);color:#15803d;font-size:.72rem;font-weight:800;border:1px solid rgba(34,197,94,.2);padding:5px 9px;border-radius:999px;">
                                                <i class="fas fa-file-alt me-1"></i>Bildiri Açık
                                            </span>
                                        }
                                        @if (item.IsRegistrationOpen)
                                        {
                                            <span class="badge" style="background:rgba(0,174,239,.10);color:#0284c7;font-size:.72rem;font-weight:800;border:1px solid rgba(0,174,239,.2);padding:5px 9px;border-radius:999px;">
                                                <i class="fas fa-user-plus me-1"></i>Kayıt Açık
                                            </span>
                                        }
                                        @if (item.AbstractSubmissionDeadline.HasValue && item.AbstractSubmissionDeadline > DateTime.Now)
                                        {
                                            <span class="badge" style="background:rgba(245,158,11,.10);color:#b45309;font-size:.72rem;font-weight:800;border:1px solid rgba(245,158,11,.2);padding:5px 9px;border-radius:999px;">
                                                <i class="fas fa-clock me-1"></i>Son: @item.AbstractSubmissionDeadline.Value.ToString("dd MMM")
                                            </span>
                                        }
                                    </div>

                                    <div class="modern-congress-footer">
                                        <span class="modern-year-pill">
                                            <i class="far fa-calendar-alt me-1"></i>
                                            @item.StartDate.Year
                                        </span>

                                        @if (item.IsRegistered)
                                        {
                                            <a href="@panelUrl" class="modern-detail-btn registered-congress-btn">
                                                <i class="fas fa-check-circle"></i>
                                                @L("AlreadyRegisteredButton", "Kayıtlısınız")
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@vitrinUrl" class="modern-detail-btn">
                                                @L("RegisterButton", "Kayıt Ol")
                                                <i class="fas fa-paper-plane"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                }
                else
                {
                    <div class="col-lg-7">
                        <div class="modern-empty-state">
                            <i class="fas fa-info-circle"></i>

                            <h5 class="fw-bold text-dark mb-2">
                                @L("NoActiveCongressText", "Şu anda aktif kongre bulunmuyor.")
                            </h5>

                            <p class="text-muted mb-0">
                                @L("NoActiveCongressDescription", "Yeni kongreler eklendiğinde bu alanda görüntülenecektir.")
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>


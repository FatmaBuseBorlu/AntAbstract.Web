                </a>
            </div>

            <div class="row g-4">
                @foreach (var book in proceedingBooks.Take(4))
                {
                    var bookUrl = $"/{book.Slug}/Proceedings/Index?conferenceId={book.ConferenceId}";
                    var colors = new[] { "#0284c7", "#6366f1", "#10b981", "#f59e0b" };
                    var colorIdx = proceedingBooks.ToList().IndexOf(book) % 4;
                    <div class="col-sm-6 col-lg-3">
                        <a href="@bookUrl" class="text-decoration-none">
                            <div class="proceeding-book-card">

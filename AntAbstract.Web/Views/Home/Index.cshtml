@section Styles {
<style>
    /* ── Animasyonlar ─────────────────────────────────────────────────── */
    [data-animate] {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 0.65s cubic-bezier(.22,1,.36,1), transform 0.65s cubic-bezier(.22,1,.36,1);
    }
    [data-animate].animated {
        opacity: 1 !important;
        transform: translateY(0) !important;
    }
    [data-animate="fade-left"]  { transform: translateX(-40px); }
    [data-animate="fade-right"] { transform: translateX(40px); }
    [data-animate="fade-left"].animated,
    [data-animate="fade-right"].animated { transform: translateX(0) !important; }
    [data-animate="scale"] { transform: scale(0.88); }
    [data-animate="scale"].animated { transform: scale(1) !important; }

    /* Delay yardımcıları */
    [data-delay="100"] { transition-delay: 0.10s; }
    [data-delay="200"] { transition-delay: 0.20s; }
    [data-delay="300"] { transition-delay: 0.30s; }
    [data-delay="400"] { transition-delay: 0.40s; }
    [data-delay="500"] { transition-delay: 0.50s; }
    [data-delay="600"] { transition-delay: 0.60s; }
    [data-delay="700"] { transition-delay: 0.70s; }

    /* Hero partikülleri */
    .hero-particles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
    .hero-particles span { position: absolute; border-radius: 50%; animation: floatParticle linear infinite; opacity: 0; }

    @@keyframes floatParticle {
        0%   { transform: translateY(0) rotate(0deg);   opacity: 0; }
        10%  { opacity: 1; }
        90%  { opacity: 0.7; }
        100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
    }

    @@keyframes orbFloat {
        0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(16px, -18px, 0) scale(1.05); }
    }

    @@keyframes livePulse {
        0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
        70% { box-shadow: 0 0 0 11px rgba(34, 197, 94, 0); }
        100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    }

    @@keyframes slideInLine {
        from { width: 0; }
        to   { width: 100%; }
    }
    .animate-line::after {
        content: ''; display: block; height: 3px;
        background: linear-gradient(90deg, #00aeef, #0284c7);
        border-radius: 999px; animation: slideInLine 0.7s ease forwards; margin-top: 6px;
    }

    @@keyframes badgePulse {
        0%, 100% { box-shadow: 0 10px 30px rgba(15,23,42,0.06); }
        50%       { box-shadow: 0 10px 30px rgba(0,174,239,0.25); }
    }
    .hero-badge { animation: badgePulse 3s ease infinite; }

    @@keyframes dashFloat {
        0%, 100% { transform: perspective(1100px) rotateY(-7deg) rotateX(4deg) translateY(0); }
        50%       { transform: perspective(1100px) rotateY(-7deg) rotateX(4deg) translateY(-10px); }
    }
    .dashboard-shell { animation: dashFloat 5s ease-in-out infinite; }
    .dashboard-shell:hover { animation: none; }

    @@keyframes noteBob {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-6px); }
    }
    .floating-note { animation: noteBob 4s ease-in-out infinite; }

    @@keyframes shimmer {
        0%   { background-position: -200% 0; }
        100% { background-position:  200% 0; }
    }
    .mock-progress span {
        background: linear-gradient(90deg, #00aeef, #22c55e, #00aeef);
        background-size: 200% 100%;
        animation: shimmer 2.5s linear infinite;
    }
</style>
}

@section Scripts {
<script>
/* ── Animasyon motoru ──────────────────────────────────────────────── */
(function () {
    function initAnimations() {
    // Scroll-triggered reveal
    var animated = document.querySelectorAll('[data-animate]');
    var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) {
                var delay = parseInt(e.target.dataset.delay || '0', 10);
                setTimeout(function() { e.target.classList.add('animated'); }, delay);
                io.unobserve(e.target);
            }
        });
    }, { threshold: 0.08 });

    animated.forEach(function (el) { io.observe(el); });

    // Hero elementlerini hemen göster (viewport içinde başlıyorlar)
    document.querySelectorAll('.hero-content [data-animate]').forEach(function (el) {
        el.classList.add('animated');
    });

    // Sayaç animasyonu
    function animateCounter(el, target, duration) {
        var start = 0;
        var step = target / (duration / 16);
        var suffix = el.textContent.includes('+') ? '+' : '';
        var timer = setInterval(function () {
            start += step;
            if (start >= target) { start = target; clearInterval(timer); }
            el.textContent = Math.round(start).toLocaleString('tr-TR') + suffix;
        }, 16);
    }

    var counterObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) {
                var el = e.target;
                var target = parseInt(el.dataset.count, 10);
                if (!isNaN(target) && target > 0) animateCounter(el, target, 1400);
                counterObserver.unobserve(el);
            }
        });
    }, { threshold: 0.5 });

    document.querySelectorAll('.stat-number[data-count]').forEach(function (el) {
        counterObserver.observe(el);
    });

    // Yüzen partiküller
    var container = document.getElementById('heroParticles');
    if (container) {
        var colors = ['#00aeef', '#0284c7', '#22c55e', '#a78bfa', '#f59e0b'];
        for (var i = 0; i < 22; i++) {
            var p = document.createElement('span');
            var size = Math.random() * 7 + 3;
            p.style.cssText = [
                'width:'  + size + 'px',
                'height:' + size + 'px',
                'left:'   + (Math.random() * 100) + '%',
                'bottom:' + (-(Math.random() * 20)) + '%',
                'background:' + colors[Math.floor(Math.random() * colors.length)],
                'animation-duration:' + (Math.random() * 14 + 8) + 's',
                'animation-delay:' + (Math.random() * 8) + 's'
            ].join(';');
            container.appendChild(p);
        }
    }
    } // end initAnimations

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAnimations);
    } else {
        initAnimations();
    }
})();

/* kongre filtre kodu kaldırıldı — detaylı arama /congresses sayfasında */
</script>
}

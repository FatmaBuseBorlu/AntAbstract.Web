        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 20px;
        padding: 24px 20px;
        backdrop-filter: blur(12px);
        transition: all 0.3s ease;
        width: 100%;
    }

        .workflow-card:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-4px);
            border-color: rgba(0, 174, 239, 0.25);
        }

    .workflow-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: rgba(0, 174, 239, 0.15);
        color: #38bdf8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin: 0 auto 14px;
    }

    .workflow-card h5 {
        font-weight: 900;
        margin-bottom: 10px;
    }

    .workflow-card p {
        color: #cbd5e1;
        margin-bottom: 0;
        line-height: 1.65;
        font-size: 0.93rem;
    }

    .proceeding-book-card {
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #f1f5f9;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .proceeding-book-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
    }

    .proceeding-book-cover {
        height: 140px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        gap: 6px;
    }

    .proceeding-book-cover i { font-size: 2rem; opacity: 0.9; }
    .proceeding-book-cover span { font-size: 1.5rem; font-weight: 950; letter-spacing: -1px; }

    .proceeding-book-info {
        padding: 18px 20px;
    }

    .proceeding-book-info h6 {
        color: #0f172a;
        font-weight: 900;
        font-size: 0.9rem;
        line-height: 1.35;
        margin-bottom: 8px;
    }

    .proceeding-book-info p {
        color: #94a3b8;
        font-size: 0.78rem;
        margin-bottom: 10px;
    }

    .proceeding-published-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        font-size: 0.72rem;
        font-weight: 800;
    }

    .past-congress-timeline {
        position: relative;
        padding-left: 120px;
    }

    .past-congress-timeline::before {
        content: "";
        position: absolute;
        left: 119px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e2e8f0;
    }

    .past-congress-item {
        display: flex;
        align-items: flex-start;
        gap: 24px;
        padding: 16px 0;
        position: relative;
        transition: all 0.2s ease;
    }

    .past-congress-item:hover .past-congress-content {
        background: #f0f7ff;
        border-color: rgba(0, 174, 239, 0.25);
    }

    .past-congress-date {
        position: absolute;
        left: -120px;
        width: 100px;
        text-align: right;
        flex-shrink: 0;
    }

    .past-date-year { display: block; font-size: 1.1rem; font-weight: 950; color: #0f172a; }
    .past-date-month { display: block; font-size: 0.78rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; }

    .past-congress-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #00aeef;
        border: 3px solid #fff;
        box-shadow: 0 0 0 2px #e2e8f0;
        flex-shrink: 0;
        margin-top: 6px;
        position: relative;
        z-index: 2;
    }

    .past-congress-content {
        flex: 1;
        padding: 14px 18px;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
        background: #fff;
        transition: all 0.2s ease;
    }

    .past-congress-content h6 {
        color: #0f172a;
        font-weight: 900;
        font-size: 0.92rem;
        margin-bottom: 4px;
    }

    .past-congress-content p {
        color: #94a3b8;
        font-size: 0.78rem;
        margin-bottom: 0;
    }

    .latest-submissions-section {
        background: #f8fafc;
    }

    .submission-card-modern {
        height: 100%;
        min-height: 275px;
        border: 1px solid #e8eef6;
        border-radius: 26px;
        padding: 1.35rem;
        background: #ffffff;
        box-shadow: 0 16px 42px rgba(15, 23, 42, 0.055);
        transition: all 0.24s ease;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .submission-card-modern:hover {
            transform: translateY(-7px);
            box-shadow: 0 26px 68px rgba(15, 23, 42, 0.105);
            border-color: rgba(0, 174, 239, 0.32);
        }

    .submission-author-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1rem;
        min-width: 0;
    }

    .submission-author-avatar {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.10);
        background: #f8fafc;
    }

    .submission-author-placeholder {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fde68a, #fdba74);
        color: #0f172a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 1rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.10);
    }

    .submission-author-info {
        min-width: 0;
    }

    .submission-author-name {
        color: #0f172a;
        font-size: 0.98rem;
        font-weight: 900;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .submission-author-university {
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 600;
        margin: 0.15rem 0 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .submission-conference-badge {
        max-width: 100%;
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.38rem 0.65rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        border: 1px solid rgba(13, 110, 253, 0.16);
        color: #0d6efd;
        font-size: 0.74rem;
        font-weight: 900;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 1rem;
    }

        .submission-conference-badge span {
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .submission-card-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        line-height: 1.4;
        margin-bottom: 0.65rem;
        min-height: 44px;
    }

    .submission-card-description {
        color: #64748b;
        font-size: 0.88rem;
        line-height: 1.65;
        font-weight: 600;
        margin-bottom: 0;
    }

    .submission-card-footer {
        margin-top: auto;
        padding-top: 1rem;
    }

    .submission-detail-link {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: #0284c7;
        font-size: 0.82rem;
        font-weight: 900;
        text-decoration: none;
    }

        .submission-detail-link:hover {
            color: #0d6efd;
            text-decoration: none;
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .stats-modern {
        background: linear-gradient(135deg, #00aeef 0%, #0284c7 100%);
        color: #ffffff;
    }

    .stat-box {
        text-align: center;
        padding: 22px;
    }

    .stat-number {
        font-size: clamp(2.1rem, 4vw, 3.2rem);
        font-weight: 950;
        line-height: 1;
        margin-bottom: 10px;
    }

    .stat-label {
        opacity: 0.86;
        text-transform: uppercase;
        font-weight: 900;
        font-size: 0.78rem;
        letter-spacing: 0.7px;
    }

    /* ── Pricing Section ── */
    .pricing-section {
        background: radial-gradient(circle at 20% 80%, rgba(0, 174, 239, 0.06), transparent 40%),
                    radial-gradient(circle at 80% 20%, rgba(99, 102, 241, 0.06), transparent 40%),
                    #f8fafc;
    }

    .pricing-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid #e2e8f0;
        padding: 40px 32px;
        position: relative;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .pricing-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.10);
        border-color: rgba(0, 174, 239, 0.3);
    }

    .pricing-card.featured {
        border: 2px solid #00aeef;
        box-shadow: 0 16px 48px rgba(0, 174, 239, 0.12);
    }

    .pricing-card.featured:hover {
        box-shadow: 0 28px 70px rgba(0, 174, 239, 0.18);
    }

    .pricing-badge {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(135deg, #00aeef, #0284c7);
        color: #fff;
        padding: 6px 20px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .pricing-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 20px;
    }

    .pricing-plan-name {
        font-size: 1.2rem;
        font-weight: 900;
        color: #0f172a;
        letter-spacing: -0.3px;
        margin-bottom: 8px;
    }

    .pricing-plan-desc {
        font-size: 0.88rem;
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .pricing-price {
        display: flex;
        align-items: baseline;
        gap: 4px;
        margin-bottom: 8px;
    }

    .pricing-price .amount {
        font-size: 2.8rem;
        font-weight: 950;
        color: #0f172a;
        letter-spacing: -2px;
        line-height: 1;
    }

    .pricing-price .currency {
        font-size: 1.1rem;
        font-weight: 700;
        color: #64748b;
    }

    .pricing-per {
        font-size: 0.8rem;
        color: #94a3b8;
        margin-bottom: 28px;
    }

    .pricing-divider {
        height: 1px;
        background: #e2e8f0;
        margin-bottom: 24px;
    }

    .pricing-features {
        list-style: none;
        padding: 0;
        margin: 0 0 32px;
        flex: 1;
    }

    .pricing-features li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 7px 0;
        font-size: 0.88rem;
        color: #334155;
        line-height: 1.5;
    }

    .pricing-features li i {
        color: #22c55e;
        font-size: 0.82rem;
        margin-top: 3px;
        flex-shrink: 0;
    }

    .pricing-features li.disabled {
        color: #cbd5e1;
    }

    .pricing-features li.disabled i {
        color: #cbd5e1;
    }

    .pricing-btn {
        display: block;
        width: 100%;
        padding: 14px;
        border-radius: 14px;
        font-weight: 800;
        font-size: 0.92rem;
        text-align: center;
        text-decoration: none;
        transition: all 0.3s ease;
        border: 2px solid #e2e8f0;
        background: #fff;
        color: #0f172a;
    }

    .pricing-btn:hover {
        border-color: #00aeef;
        color: #0284c7;
        background: rgba(0, 174, 239, 0.04);
    }

    .pricing-btn.featured {
        background: linear-gradient(135deg, #00aeef, #0284c7);
        color: #fff;
        border-color: transparent;
    }

    .pricing-btn.featured:hover {
        background: linear-gradient(135deg, #0284c7, #0369a1);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0, 174, 239, 0.3);
    }

    .pricing-submissions {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 10px;
        background: rgba(0, 174, 239, 0.08);
        color: #0284c7;
        font-size: 0.78rem;
        font-weight: 800;
        margin-bottom: 20px;
    }

    .cta-section {
        background: radial-gradient(circle at top left, rgba(0, 174, 239, 0.16), transparent 30%), linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    }

    .cta-box {
        background: #0f172a;
        color: #ffffff;
        border-radius: 34px;
        padding: clamp(34px, 5vw, 62px);
        box-shadow: 0 32px 80px rgba(15,23,42,0.18);
        position: relative;
        overflow: hidden;
    }

        .cta-box::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            right: -70px;
            top: -80px;
            background: rgba(0,174,239,0.22);
        }

        .cta-box h2,
        .cta-box p,
        .cta-box a {
            position: relative;
            z-index: 2;
        }

    .modern-empty-state {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 42px;
        text-align: center;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
    }

        .modern-empty-state i {
            font-size: 2.5rem;
            color: #00aeef;
            margin-bottom: 16px;
        }

    /* Kongre kartı reveal */
    .congress-item { transition: opacity 0.35s, transform 0.35s; }

    @@media (max-width: 991.98px) {
        .hero-modern {
            padding-top: 130px;
        }

        .dashboard-shell {
            transform: none;
            margin-top: 28px;
        }

        .floating-note {
            position: static;
            margin-top: 16px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .hero-metric-strip {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .workflow-timeline { flex-direction: column; gap: 1rem; }
        .workflow-line { display: none; }
    }

    @@media (max-width: 576px) {
        .hero-actions {
            align-items: stretch;
        }

        .primary-pill-btn,
        .secondary-pill-btn {
            width: 100%;
        }

        .modern-congress-body {
            min-height: auto;
        }

        .modern-congress-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .modern-detail-btn {
            width: 100%;
        }

        .hero-modern { padding: 100px 0 50px; }
        .hero-title { font-size: clamp(1.8rem, 8vw, 2.8rem); letter-spacing: -1px; }
        .hero-description { font-size: 1rem; }
        .hero-trust-row { flex-direction: column; gap: 8px; }
        .dashboard-shell { border-radius: 18px; padding: 10px; }
        .mock-stat-row { grid-template-columns: 1fr 1fr; }
        .hero-live-strip { align-items: flex-start; flex-direction: column; }
        .insight-rail { grid-template-columns: 1fr; }

        .role-card { padding: 20px; }
        .cta-box { padding: 24px; border-radius: 22px; }
        .stat-box { padding: 16px 12px; }
        .stat-number { font-size: 2rem; }

        /* Kongre filter bar */
        .congress-filter-bar { flex-wrap: wrap; gap: .4rem; }
        .congress-filter { font-size: .75rem; padding: .3rem .65rem; }
        #congress-search { width: 100% !important; }
    }
</style>

<div class="home-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container" style="padding-top: 120px;">
            <div class="alert alert-success border-0 shadow-sm rounded-4">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <section class="hero-modern">
        <!-- Yüzen partiküller -->
        <div class="hero-particles" id="heroParticles"></div>
        <div class="hero-orb hero-orb-one"></div>
        <div class="hero-orb hero-orb-two"></div>

        <div class="container hero-content">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="hero-badge" data-animate data-delay="100">
                        <span>@L("NewBadge", "Yeni")</span>
                        <i class="fas fa-sparkles"></i>
                        @L("HeroMiniBadgeText", "Bilimsel etkinlikler için dijital yönetim platformu")
                    </div>

                    <h1 class="hero-title" data-animate data-delay="200">
                        @L("HeroTitleMain", "Bilimsel Etkinliklerinizi")
                        <span class="gradient-text d-block">
                            @L("HeroTitleHighlight", "Tek Platformdan Yönetin")
                        </span>
                    </h1>

                    <p class="hero-description" data-animate data-delay="300">
                        @L("HeroModernDescription", "Bildiri toplama, hakem değerlendirme, kayıt, ödeme, program oluşturma ve sertifika süreçlerini AntAbstract ile kolayca yönetin.")
                    </p>

                    <div class="hero-actions" data-animate data-delay="400">
                        <a href="#congress-list" class="primary-pill-btn">
                            <i class="fas fa-calendar-check"></i>
                            @L("DiscoverCongressesButton", "Kongreleri Keşfet")
                        </a>

                        <a href="#how-it-works" class="secondary-pill-btn">
                            <i class="fas fa-play-circle"></i>
                            @L("HowItWorksButton", "Nasıl Çalışır?")
                        </a>
                    </div>

                    <div class="hero-trust-row" data-animate data-delay="500">
                        <div class="hero-trust-item">
                            <i class="fas fa-check-circle"></i>
                            @L("TrustItem1", "Çok dilli kullanım")
                        </div>

                        <div class="hero-trust-item">
                            <i class="fas fa-check-circle"></i>
                            @L("TrustItem2", "Rol bazlı yönetim")
                        </div>

                        <div class="hero-trust-item">
                            <i class="fas fa-check-circle"></i>
                            @L("TrustItem3", "Dinamik kongre sayfaları")
                        </div>
                    </div>

                    <div class="hero-metric-strip" data-animate data-delay="600">
                        <div class="hero-metric">
                            <strong>@Model.ActiveCongressesCount</strong>
                            <span>@L("HeroMetricActiveCongress", "aktif kongre yayında")</span>
                        </div>

                        <div class="hero-metric">
                            <strong>@Model.TotalUsers.ToString("N0")</strong>
                            <span>@L("HeroMetricUsers", "akademik kullanıcı")</span>
                        </div>

                        <div class="hero-metric">
                            <strong>360°</strong>
                            <span>@L("HeroMetricWorkflow", "başvuru, hakem, ödeme ve sertifika")</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6" data-animate="fade-right" data-delay="300">
                    <div class="dashboard-shell">
                        <div class="dashboard-window">
                            <div class="dashboard-topbar">
                                <div class="window-dots">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>

                                <small class="fw-bold text-muted">
                                    AntAbstract Dashboard
                                </small>
                            </div>

                            <div class="dashboard-body">
                                <div class="hero-live-strip">
                                    <div class="live-status">
                                        <span class="live-dot"></span>
                                        @L("LivePanelStatus", "Canlı yönetim paneli")
                                    </div>

                                    <div class="live-chip">
                                        <i class="fas fa-bell"></i>
                                        @L("LivePanelChip", "Anlık süreç takibi")
                                    </div>
                                </div>

                                <div class="mock-stat-row">
                                    <div class="mock-stat">
                                        <strong>@Model.ActiveCongressesCount</strong>
                                        <span>@L("ActiveCongressesStat", "Aktif Kongre")</span>
                                    </div>

                                    <div class="mock-stat">
                                        <strong>@Model.TotalUsers.ToString("N0")</strong>
                                        <span>@L("ActiveUsersStat", "Kullanıcı")</span>
                                    </div>

                                    <div class="mock-stat">
                                        <strong>500+</strong>
                                        <span>@L("SubmissionsStat", "Bildiri")</span>
                                    </div>
                                </div>

                                <div class="dashboard-grid">
                                    <div class="mock-card">
                                        <div class="mock-card-title">
                                            @L("MockReviewProgressTitle", "Hakem Değerlendirme Süreci")
                                        </div>

                                        <div class="mock-progress">
                                            <span></span>
                                        </div>

                                        <div class="mock-list">
                                            <div class="mock-list-item">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="mock-avatar">
                                                        <i class="fas fa-file-alt"></i>
                                                    </span>
                                                    <div>
                                                        <div class="fw-bold text-dark small">@L("MockSubmission1", "Yeni bildiri")</div>
                                                        <small class="text-muted">@L("MockSubmissionStatus1", "Hakeme atandı")</small>
                                                    </div>
                                                </div>
                                                <span class="mock-pill">@L("MockStatusActive", "Aktif")</span>
                                            </div>

                                            <div class="mock-list-item">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="mock-avatar">
                                                        <i class="fas fa-award"></i>
                                                    </span>
                                                    <div>
                                                        <div class="fw-bold text-dark small">@L("MockCertificate", "Sertifika")</div>
                                                        <small class="text-muted">@L("MockCertificateStatus", "Hazırlandı")</small>
                                                    </div>
                                                </div>
                                                <span class="mock-pill">@L("MockStatusReady", "Hazır")</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mock-card">
                                        <div class="mock-card-title">
                                            @L("MockPanelTitle", "Panel Özeti")
                                        </div>

                                        <div class="d-grid gap-3">
                                            <div>

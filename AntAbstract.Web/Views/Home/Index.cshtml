    }

    .feature-card-modern h5 {
        color: #0f172a;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .feature-card-modern p {
        color: #64748b;
        line-height: 1.68;
        margin-bottom: 0;
    }

    .submission-card-modern {
        height: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 22px;
        background: #ffffff;
        box-shadow: 0 15px 42px rgba(15,23,42,0.05);
        transition: all 0.24s ease;
    }

        .submission-card-modern:hover {
            transform: translateY(-7px);
            box-shadow: 0 24px 64px rgba(15,23,42,0.10);
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .stats-modern {
        background: linear-gradient(135deg, #00aeef 0%, #0284c7 100%);
        color: #ffffff;
    }

    .stat-box {
        text-align: center;
        padding: 22px;
    }

    .stat-number {
        font-size: clamp(2.1rem, 4vw, 3.2rem);
        font-weight: 950;
        line-height: 1;
        margin-bottom: 10px;
    }

    .stat-label {

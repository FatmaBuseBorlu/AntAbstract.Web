                                    <span>@book.StartDate.ToString("yyyy")</span>
                                </div>
                                <div class="proceeding-book-info">
                                    <h6>@book.ConferenceTitle</h6>
                                    <p><i class="fas fa-map-marker-alt me-1"></i>@book.Location</p>
                                    @if (book.PublishedDate.HasValue)
                                    {
                                        <span class="proceeding-published-badge">
                                            <i class="fas fa-check-circle me-1"></i>@book.PublishedDate.Value.ToString("MMM yyyy")
                                        </span>
                                    }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>

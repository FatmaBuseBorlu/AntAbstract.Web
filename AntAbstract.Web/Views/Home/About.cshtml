@using System
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string L(string key, string fallback)
    {
        var loc = Localizer.GetString(key);
        return loc.ResourceNotFound ? fallback : loc.Value;
    }

    ViewData["Title"] = L("PageTitle", "Hakkımızda");
    ViewData["BodyClass"] = "page-about";
}

<section class="about-page">

    <div class="about-hero">
        <div class="about-shape shape-one"></div>
        <div class="about-shape shape-two"></div>

        <div class="container">
            <div class="about-hero-content">
                <div class="about-pill">
                    <i class="fas fa-layer-group"></i>
                    @L("HeroPill", "Biz kimiz?")
                </div>

                <h1 class="about-title">
                    @L("HeroTitleLine1", "Bilimsel Süreçlerde")
                    <span>@L("HeroTitleLine2", "Dijital Dönüşüm")</span>
                </h1>

                <p class="about-description">
                    @L("HeroDescription", "AntAbstract, akademik kongrelerinizi planlamadan sonuçlandırmaya kadar her aşamada yöneten, teknoloji ve deneyimi birleştiren çözüm ortağınızdır.")
                </p>
            </div>
        </div>
    </div>

    <div class="about-content-section">
        <div class="container">

            <div class="row g-4 align-items-center mb-5">
                <div class="col-lg-6">
                    <div class="about-section-label">
                        @L("WhyLabel", "Neden AntAbstract?")
                    </div>

                    <h2 class="about-section-title">
                        @L("WhyTitle", "Kongre yönetimini daha hızlı, düzenli ve güvenilir hale getiriyoruz.")
                    </h2>

                    <p class="about-section-text">
                        @L("WhyText1", "Ulusal ve uluslararası kongre, sempozyum ve çalıştaylarınızı fiziksel sınırların ötesine taşıyarak online ortamda yönetmenizi sağlayan işlevsel bir yazılım sistemidir.")
                    </p>

                    <p class="about-section-text">
                        @L("WhyText2", "Bildiri gönderimi, hakem değerlendirmesi, kayıt süreçleri, ödeme takibi ve bildiri kitabı yönetimi gibi temel akademik operasyonları tek bir platformda toplar.")
                    </p>
                </div>

                <div class="col-lg-6">
                    <div class="about-visual-card">
                        <div class="about-dashboard-card">
                            <div class="dashboard-dots">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>

                            <div class="dashboard-title">
                                AntAbstract Dashboard
                            </div>

                            <div class="dashboard-stats">
                                <div>
                                    <strong>500+</strong>
                                    <span>@L("StatPapers", "Bildiri")</span>
                                </div>

                                <div>
                                    <strong>120+</strong>
                                    <span>@L("StatReviewers", "Hakem")</span>
                                </div>

                                <div>
                                    <strong>30+</strong>
                                    <span>@L("StatEvents", "Kongre")</span>
                                </div>
                            </div>

                            <div class="dashboard-progress">
                                <div class="progress-line w-75"></div>
                                <div class="progress-line w-50"></div>
                                <div class="progress-line w-90"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="about-feature-grid mb-5">
                <div class="about-feature-card">
                    <div class="feature-icon icon-blue">
                        <i class="fas fa-file-signature"></i>
                    </div>

                    <h3>@L("Feature1Title", "Bildiri Yönetimi")</h3>

                    <p>
                        @L("Feature1Text", "Yazarların bildiri gönderim süreçlerini kolaylaştırır ve tüm başvuruları düzenli şekilde takip eder.")
                    </p>
                </div>

                <div class="about-feature-card">
                    <div class="feature-icon icon-green">
                        <i class="fas fa-gavel"></i>
                    </div>

                    <h3>@L("Feature2Title", "Hakem Değerlendirme")</h3>

                    <p>
                        @L("Feature2Text", "Hakem atama, değerlendirme ve karar süreçlerini daha kontrollü ve şeffaf hale getirir.")
                    </p>
                </div>

                <div class="about-feature-card">
                    <div class="feature-icon icon-orange">
                        <i class="fas fa-users"></i>
                    </div>

                    <h3>@L("Feature3Title", "Katılımcı Yönetimi")</h3>

                    <p>
                        @L("Feature3Text", "Kayıt, katılım ve kullanıcı işlemlerini tek panel üzerinden kolayca yönetmenizi sağlar.")
                    </p>
                </div>

                <div class="about-feature-card">
                    <div class="feature-icon icon-purple">
                        <i class="fas fa-book-open"></i>
                    </div>

                    <h3>@L("Feature4Title", "Bildiri Kitabı")</h3>

                    <p>
                        @L("Feature4Text", "Yayınlanan bildiri kitaplarını dijital arşivde düzenli şekilde sunar ve erişilebilir hale getirir.")
                    </p>
                </div>
            </div>

            <div class="about-cta-card">
                <div>
                    <h2>@L("CtaTitle", "Kongre süreçlerinizi dijitalleştirmeye hazır mısınız?")</h2>

                    <p>
                        @L("CtaText", "AntAbstract ile akademik etkinliklerinizi uçtan uca daha profesyonel yönetin.")
                    </p>
                </div>

                <a href="/contact" class="about-cta-btn">
                    <i class="fas fa-paper-plane"></i>
                    @L("CtaButton", "İletişime Geç")
                </a>
            </div>

        </div>
    </div>

</section>

<style>
    .page-about main,
    .page-about .main-content,
    .page-about .page-content,
    .page-about .content-wrapper {
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    .about-page {
        padding-top: 0;
        background: #f8fafc;
        min-height: 100vh;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .about-hero {
        position: relative;
        overflow: hidden;
        padding: calc(4.2rem + 86px) 0 4rem;
        background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 35%, #0d1b3e 65%, #071228 100%);
        color: #ffffff;
        border-bottom-left-radius: 46px;
        border-bottom-right-radius: 46px;
    }

        .about-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 500px 350px at 15% 40%, rgba(0, 174, 239, 0.12), transparent),
                radial-gradient(ellipse 400px 300px at 85% 30%, rgba(99, 102, 241, 0.1), transparent);
            pointer-events: none;
        }

        .about-hero::after {
            content: "";
            position: absolute;
            right: -160px;
            bottom: -190px;
            width: 430px;
            height: 430px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.06);
        }

    .about-shape {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
    }

    .shape-one {
        left: 9%;
        top: 55%;
        width: 36px;
        height: 36px;
        background: rgba(0, 174, 239, 0.28);
        box-shadow: 0 18px 44px rgba(0, 174, 239, 0.22);
    }

    .shape-two {
        right: 15%;
        top: 28%;
        width: 9px;
        height: 9px;
        background: rgba(255, 255, 255, 0.75);
        box-shadow: 85px 55px 0 rgba(255,255,255,0.55), 160px 95px 0 rgba(255,255,255,0.45);
    }

    .about-hero-content {
        position: relative;
        z-index: 2;
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
    }

    .about-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.12);
        color: #38bdf8;
        font-size: 0.85rem;
        font-weight: 900;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 1.35rem;
    }

    .about-title {
        margin: 0;
        font-size: clamp(2.5rem, 5vw, 4.4rem);
        font-weight: 900;
        letter-spacing: -0.065em;
        line-height: 1.08;
    }

        .about-title span {
            display: block;
            color: #00aeef;
        }

    .about-description {
        max-width: 760px;
        margin: 1.4rem auto 0;
        color: #cbd5e1;
        font-size: 1.13rem;
        font-weight: 500;
        line-height: 1.8;
    }

    .about-content-section {
        padding: 4rem 0;
    }

    .about-section-label {
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.7rem;
    }

    .about-section-title {
        color: #0f172a;
        font-size: clamp(1.8rem, 3vw, 2.5rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1.15;
        margin-bottom: 1rem;
    }

    .about-section-text {
        color: #64748b;
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.8;
        margin-bottom: 1rem;
    }

    .about-visual-card {
        min-height: 360px;
        border-radius: 30px;
        background: radial-gradient(circle at top right, rgba(0,174,239,0.18), transparent 36%), linear-gradient(135deg, #ffffff, #eef8ff);
        border: 1px solid #e2e8f0;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.10);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .about-dashboard-card {
        width: 100%;
        max-width: 430px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.4rem;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.10);
    }

    .dashboard-dots {
        display: flex;
        gap: 0.45rem;
        margin-bottom: 1.3rem;
    }

        .dashboard-dots span {
            width: 11px;
            height: 11px;
            border-radius: 999px;
            background: #ef4444;
        }

            .dashboard-dots span:nth-child(2) {
                background: #f59e0b;
            }

            .dashboard-dots span:nth-child(3) {
                background: #22c55e;
            }

    .dashboard-title {
        color: #0f172a;
        font-weight: 900;
        font-size: 1.05rem;
        margin-bottom: 1.2rem;
    }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.8rem;
        margin-bottom: 1.3rem;
    }

        .dashboard-stats div {
            padding: 1rem;
            border-radius: 18px;
            background: #f8fafc;
        }

        .dashboard-stats strong {
            display: block;
            color: #0f172a;
            font-size: 1.3rem;
            font-weight: 900;
        }

        .dashboard-stats span {
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 800;
        }

    .dashboard-progress {
        display: grid;
        gap: 0.65rem;
    }

    .progress-line {
        height: 10px;
        border-radius: 999px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
    }

    .about-feature-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.2rem;
    }

    .about-feature-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 26px;
        padding: 1.5rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        transition: all 0.22s ease;
    }

        .about-feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 26px 60px rgba(15, 23, 42, 0.10);
        }

    .feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 1.1rem;
    }

    .icon-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .icon-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .icon-orange {
        background: rgba(249, 115, 22, 0.10);
        color: #f97316;
    }

    .icon-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .about-feature-card h3 {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        margin-bottom: 0.6rem;
    }

    .about-feature-card p {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 500;
        line-height: 1.65;
        margin: 0;
    }

    .about-cta-card {
        margin-top: 2rem;
        padding: 2rem;
        border-radius: 30px;
        background: radial-gradient(circle at top right, rgba(0,174,239,0.20), transparent 30%), linear-gradient(135deg, #0f172a, #082f49);
        color: #ffffff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
    }

        .about-cta-card h2 {
            font-size: 1.6rem;
            font-weight: 900;
            letter-spacing: -0.04em;
            margin-bottom: 0.45rem;
        }

        .about-cta-card p {
            color: #cbd5e1;
            margin: 0;
            font-weight: 500;
        }

    .about-cta-btn {
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        padding: 0 1.3rem;
        border-radius: 16px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        text-decoration: none;
        font-weight: 900;
        box-shadow: 0 16px 32px rgba(0, 174, 239, 0.24);
    }

        .about-cta-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
        }

    @@media (max-width: 1200px) {
        .about-feature-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .about-hero {
            padding: calc(3rem + 74px) 0 3rem;
            border-bottom-left-radius: 30px;
            border-bottom-right-radius: 30px;
        }

        .about-content-section {
            padding: 2.5rem 0;
        }

        .about-feature-grid {
            grid-template-columns: 1fr;
        }

        .dashboard-stats {
            grid-template-columns: 1fr;
        }

        .about-cta-card {
            align-items: stretch;
        }

        .about-cta-btn {
            width: 100%;
        }
    }
</style>


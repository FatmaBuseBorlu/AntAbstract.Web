        sections.Add((
            "scope",
            "2. Service Scope",
            "2. Scope of Services",
            @"
<p>
Services that may be offered through AntAbstract include:
</p>

<ul>
    <li>Publishing congress and event pages.</li>
    <li>User account creation and login processes.</li>
    <li>Author, reviewer, organizer and admin panels.</li>
    <li>Congress registration and participation workflows.</li>
    <li>Abstract, full-text and file submission processes.</li>
    <li>Reviewer assignment and scientific evaluation processes.</li>
    <li>Payment, billing and payment history processes.</li>
    <li>Acceptance letters, badges, participation documents and certificate generation.</li>
    <li>Abstract books, congress programs and announcement processes.</li>
</ul>

<p>

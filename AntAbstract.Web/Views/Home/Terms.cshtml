        sections.Add((
            "intro",
            "1. Introduction",
            "1. Introduction",
            @"
<p>
AntAbstract is a digital platform designed to support registration, abstract submission, peer review,
payment, document and certificate processes for congresses, symposiums, workshops and similar academic events.
</p>

<p>
These Terms of Use apply to all users who visit the AntAbstract website, create an account, register for a congress,
submit an abstract, participate as a reviewer, make a payment or use the management panels.
</p>"

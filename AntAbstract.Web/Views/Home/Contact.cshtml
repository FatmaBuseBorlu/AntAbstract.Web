@using System
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    ViewData["Title"] = L("PageTitle", "İletişim");
    ViewData["BodyClass"] = "page-contact";
}

<section class="contact-page">

    <div class="contact-hero">
        <div class="contact-shape shape-one"></div>
        <div class="contact-shape shape-two"></div>

        <div class="container">
            <div class="contact-hero-content">
                <div class="contact-pill">
                    <i class="fas fa-paper-plane"></i>
                    @L("HeroPill", "Bize ulaşın")
                </div>

                <h1 class="contact-title">
                    @L("HeroTitle", "İletişime Geçin")
                </h1>

                <p class="contact-description">
                    @L("HeroDescription", "Kongre yönetim süreçleriniz, teknik destek veya iş birliği talepleriniz için bizimle iletişime geçebilirsiniz.")
                </p>
            </div>
        </div>
    </div>

    <div class="contact-content-section">
        <div class="container">

            <div class="row g-4">

                <div class="col-lg-5">
                    <div class="contact-info-card">
                        <div class="contact-info-header">
                            <div class="contact-info-icon">
                                <i class="fas fa-headset"></i>
                            </div>

                            <div>
                                <h2>@L("InfoTitle", "İletişim Bilgileri")</h2>
                                <p>@L("InfoDescription", "Size en kısa sürede dönüş yapabilmemiz için aşağıdaki kanallardan bize ulaşabilirsiniz.")</p>
                            </div>
                        </div>

                        <div class="contact-info-list">
                            <div class="contact-info-item">
                                <span class="info-icon icon-blue">
                                    <i class="fas fa-envelope"></i>
                                </span>

                                <div>
                                    <strong>@L("EmailLabel", "E-posta")</strong>
                                    <span>destek@antabstract.com</span>
                                </div>
                            </div>

                            <div class="contact-info-item">
                                <span class="info-icon icon-green">
                                    <i class="fas fa-phone"></i>
                                </span>

                                <div>
                                    <strong>@L("PhoneLabel", "Telefon")</strong>
                                    <span>+90 850 123 45 67</span>
                                </div>
                            </div>

                            <div class="contact-info-item">
                                <span class="info-icon icon-orange">
                                    <i class="fas fa-location-dot"></i>
                                </span>

                                <div>
                                    <strong>@L("AddressLabel", "Adres")</strong>
                                    <span>@L("AddressText", "İstanbul, Türkiye")</span>
                                </div>
                            </div>

                            <div class="contact-info-item">
                                <span class="info-icon icon-purple">
                                    <i class="fas fa-clock"></i>
                                </span>

                                <div>
                                    <strong>@L("WorkingHoursLabel", "Çalışma Saatleri")</strong>
                                    <span>@L("WorkingHoursText", "Pazartesi - Cuma / 09:00 - 18:00")</span>
                                </div>
                            </div>
                        </div>

                        <div class="contact-socials">
                            <a href="#" aria-label="Twitter">
                                <i class="fab fa-twitter"></i>
                            </a>

                            <a href="#" aria-label="LinkedIn">
                                <i class="fab fa-linkedin-in"></i>
                            </a>

                            <a href="#" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>

                            <a href="#" aria-label="YouTube">
                                <i class="fab fa-youtube"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="contact-form-card">
                        <div class="form-card-header">
                            <div>
                                <span>@L("FormLabel", "Mesaj gönder")</span>
                                <h2>@L("FormTitle", "Size nasıl yardımcı olabiliriz?")</h2>
                            </div>
                        </div>

                        <form method="post" action="#">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="contact-label">
                                        @L("NameLabel", "Ad Soyad")
                                    </label>

                                    <div class="contact-input-wrap">
                                        <i class="fas fa-user"></i>
                                        <input type="text"
                                               name="FullName"
                                               placeholder="@L("NamePlaceholder", "Adınız ve soyadınız")" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="contact-label">
                                        @L("EmailInputLabel", "E-posta")
                                    </label>

                                    <div class="contact-input-wrap">
                                        <i class="fas fa-envelope"></i>
                                        <input type="email"
                                               name="Email"
                                               placeholder="@L("EmailPlaceholder", "ornek@email.com")" />
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="contact-label">
                                        @L("SubjectLabel", "Konu")
                                    </label>

                                    <div class="contact-input-wrap">
                                        <i class="fas fa-tag"></i>
                                        <input type="text"
                                               name="Subject"
                                               placeholder="@L("SubjectPlaceholder", "Mesaj konusu")" />
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="contact-label">
                                        @L("MessageLabel", "Mesajınız")
                                    </label>

                                    <div class="contact-textarea-wrap">
                                        <i class="fas fa-comment-dots"></i>
                                        <textarea name="Message"
                                                  rows="6"
                                                  placeholder="@L("MessagePlaceholder", "Mesajınızı buraya yazın...")"></textarea>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="contact-submit-btn">
                                        <i class="fas fa-paper-plane"></i>
                                        @L("SendButton", "Mesajı Gönder")
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>

            <div class="contact-map-card">
                <div class="map-placeholder">
                    <i class="fas fa-map-location-dot"></i>
                    <span>@L("MapPlaceholder", "Harita alanı")</span>
                </div>
            </div>

        </div>
    </div>

</section>

<style>
    .page-contact main,
    .page-contact .main-content,
    .page-contact .page-content,
    .page-contact .content-wrapper {
        padding-top: 0 !important;
        margin-top: 0 !important;
    }

    .contact-page {
        padding-top: 0;
        background: #f8fafc;
        min-height: 100vh;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .contact-hero {
        position: relative;
        overflow: hidden;
        padding: calc(4rem + 86px) 0 3.4rem;
        background: radial-gradient(circle at 8% 28%, rgba(0, 174, 239, 0.18), transparent 22%), radial-gradient(circle at 88% 18%, rgba(13, 110, 253, 0.16), transparent 28%), linear-gradient(135deg, #f8fcff 0%, #eef8ff 48%, #e8f3ff 100%);
        border-bottom-left-radius: 46px;
        border-bottom-right-radius: 46px;
    }

        .contact-hero::after {
            content: "";
            position: absolute;
            right: -150px;
            bottom: -190px;
            width: 430px;
            height: 430px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.48);
        }

    .contact-shape {
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
    }

    .shape-one {
        left: 9%;
        top: 55%;
        width: 34px;
        height: 34px;
        background: rgba(13, 110, 253, 0.18);
        box-shadow: 0 18px 44px rgba(13, 110, 253, 0.22);
    }

    .shape-two {
        right: 15%;
        top: 25%;
        width: 9px;
        height: 9px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 85px 55px 0 rgba(255,255,255,0.75), 160px 95px 0 rgba(255,255,255,0.65);
    }

    .contact-hero-content {
        position: relative;
        z-index: 2;
        max-width: 820px;
        margin: 0 auto;
        text-align: center;
    }

    .contact-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        font-size: 0.86rem;
        font-weight: 900;
        margin-bottom: 1.25rem;
    }

    .contact-title {
        margin: 0;
        color: #0f172a;
        font-size: clamp(2.4rem, 4.7vw, 4.2rem);
        font-weight: 900;
        letter-spacing: -0.06em;
        line-height: 1.05;
    }

    .contact-description {
        margin: 1rem auto 0;
        max-width: 760px;
        color: #64748b;
        font-size: 1.12rem;
        font-weight: 500;
        line-height: 1.7;
    }

    .contact-content-section {
        padding: 3rem 0 4rem;
    }

    .contact-info-card,
    .contact-form-card,
    .contact-map-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
    }

    .contact-info-card {
        padding: 1.7rem;
        height: 100%;
    }

    .contact-info-header {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .contact-info-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        border-radius: 18px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .contact-info-header h2,
    .form-card-header h2 {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        margin: 0 0 0.4rem;
    }

    .contact-info-header p {
        color: #64748b;
        font-size: 0.9rem;
        line-height: 1.65;
        margin: 0;
    }

    .contact-info-list {
        display: grid;
        gap: 0.9rem;
    }

    .contact-info-item {
        display: flex;
        gap: 0.9rem;
        align-items: center;
        padding: 1rem;
        border-radius: 20px;
        background: #f8fafc;
        border: 1px solid #edf2f7;
    }

    .info-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .icon-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .icon-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .icon-orange {
        background: rgba(249, 115, 22, 0.10);
        color: #f97316;
    }

    .icon-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .contact-info-item strong {
        display: block;
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 900;
    }

    .contact-info-item span {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .contact-socials {
        display: flex;
        gap: 0.7rem;
        margin-top: 1.4rem;
    }

        .contact-socials a {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #0d6efd;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .contact-socials a:hover {
                background: #0d6efd;
                color: #ffffff;
                transform: translateY(-2px);
            }

    .contact-form-card {
        padding: 1.7rem;
    }

    .form-card-header {
        margin-bottom: 1.4rem;
    }

        .form-card-header span {
            color: #0d6efd;
            font-size: 0.82rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

    .contact-label {
        display: block;
        color: #0f172a;
        font-size: 0.86rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .contact-input-wrap,
    .contact-textarea-wrap {
        display: flex;
        gap: 0.8rem;
        border: 1px solid #dbe3ef;
        background: #ffffff;
        border-radius: 18px;
        transition: all 0.2s ease;
    }

    .contact-input-wrap {
        align-items: center;
        min-height: 54px;
        padding: 0 1rem;
    }

    .contact-textarea-wrap {
        align-items: flex-start;
        padding: 1rem;
    }

        .contact-input-wrap:focus-within,
        .contact-textarea-wrap:focus-within {
            border-color: rgba(13, 110, 253, 0.42);
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.08);
        }

        .contact-input-wrap i,
        .contact-textarea-wrap i {
            color: #94a3b8;
        }

        .contact-input-wrap input,
        .contact-textarea-wrap textarea {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            color: #0f172a;
            font-weight: 600;
        }

        .contact-textarea-wrap textarea {
            resize: none;
        }

            .contact-input-wrap input::placeholder,
            .contact-textarea-wrap textarea::placeholder {
                color: #94a3b8;
            }

    .contact-submit-btn {
        min-height: 54px;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        border: none;
        border-radius: 18px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-weight: 900;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
        transition: all 0.2s ease;
    }

        .contact-submit-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 20px 40px rgba(13, 110, 253, 0.30);
        }

    .contact-map-card {
        margin-top: 1.5rem;
        overflow: hidden;
    }

    .map-placeholder {
        min-height: 230px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        color: #64748b;
        font-weight: 900;
        background: linear-gradient(rgba(15, 23, 42, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, 0.03) 1px, transparent 1px), #f8fafc;
        background-size: 28px 28px;
    }

        .map-placeholder i {
            color: #0d6efd;
            font-size: 1.6rem;
        }

    @@media (max-width: 768px) {
        .contact-hero {
            padding: calc(3rem + 74px) 0 2.7rem;
            border-bottom-left-radius: 30px;
            border-bottom-right-radius: 30px;
        }

        .contact-content-section {
            padding: 2.4rem 0 3rem;
        }

        .contact-info-header {
            flex-direction: column;
        }
    }
</style>
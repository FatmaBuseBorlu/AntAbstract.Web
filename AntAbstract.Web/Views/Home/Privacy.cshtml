<style>
    .legal-hero {
        padding: 150px 0 70px;
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 35%), linear-gradient(135deg, #f8fafc 0%, #eef4f8 100%);
        border-bottom: 1px solid #e2e8f0;
    }

    .legal-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        color: #00aeef;
        border: 1px solid rgba(0, 174, 239, 0.2);
        padding: 8px 16px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
        margin-bottom: 20px;
    }

    .legal-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -1px;
        margin-bottom: 16px;
    }

    .legal-lead {
        max-width: 820px;
        color: #64748b;
        font-size: 1.1rem;
        line-height: 1.8;
        margin: 0 auto;
    }

    .legal-wrapper {
        padding: 60px 0;
        background: #fff;
    }

    .legal-layout {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 32px;
        align-items: flex-start;
    }

    .legal-sidebar {
        position: sticky;
        top: 110px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 18px;
    }

    .legal-sidebar-title {
        font-size: 0.85rem;
        font-weight: 800;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 12px;
    }

    .legal-nav-link {
        display: block;
        color: #64748b;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 10px 12px;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

        .legal-nav-link:hover {
            background: #fff;
            color: #00aeef;
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.04);
        }

    .legal-content {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 44px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.06);
    }

    .legal-section {
        padding-bottom: 34px;
        margin-bottom: 34px;
        border-bottom: 1px solid #e2e8f0;
        scroll-margin-top: 120px;
    }

        .legal-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .legal-section h2 {
            font-size: 1.45rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 18px;
            letter-spacing: -0.4px;
        }

        .legal-section p {
            color: #475569;
            line-height: 1.85;
            margin-bottom: 14px;
        }

        .legal-section ul {
            color: #475569;
            line-height: 1.9;
            margin-bottom: 0;
            padding-left: 20px;
        }

        .legal-section li {
            margin-bottom: 6px;
        }

    .legal-info-box {
        background: #f1f9fd;
        border: 1px solid rgba(0, 174, 239, 0.18);
        border-radius: 18px;
        padding: 18px 20px;
        color: #075985;
        line-height: 1.75;
        margin-bottom: 28px;
    }

    .legal-warning-box {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 18px;
        padding: 18px 20px;
        color: #9a3412;
        line-height: 1.75;
        margin-top: 18px;
    }

    .legal-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        margin-top: 18px;
    }

        .legal-table th,
        .legal-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
            color: #475569;
            line-height: 1.6;
        }

        .legal-table th {
            background: #f8fafc;
            color: #334155;
            font-weight: 800;
            width: 32%;
        }

        .legal-table tr:last-child th,
        .legal-table tr:last-child td {
            border-bottom: none;
        }

    .legal-footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
    }

    .legal-footer-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #f8fafc;
        color: #334155;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 10px 16px;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.2s ease;
    }

        .legal-footer-link:hover {
            background: #00aeef;
            border-color: #00aeef;
            color: #fff;
            transform: translateY(-2px);
        }

    .legal-wrapper-embed {
        padding: 0 !important;
        background: #fff !important;
    }

        .legal-wrapper-embed .container {
            max-width: 100% !important;
            padding: 0 !important;
        }

    .legal-layout-embed {
        display: block !important;
    }

    .legal-content-embed {
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 24px 30px !important;
    }

        .legal-content-embed .legal-info-box {
            margin-bottom: 22px !important;
        }

        .legal-content-embed .legal-section {
            padding-bottom: 24px !important;
            margin-bottom: 24px !important;
            scroll-margin-top: 20px !important;
        }

            .legal-content-embed .legal-section h2 {
                font-size: 1.25rem !important;
            }

        .legal-content-embed p,
        .legal-content-embed li,
        .legal-content-embed th,
        .legal-content-embed td {
            font-size: 0.92rem !important;
        }

    @@media (max-width: 992px) {
        .legal-layout {
            grid-template-columns: 1fr;
        }

        .legal-sidebar {
            position: static;
        }

        .legal-content {
            padding: 30px 22px;
        }

        .legal-hero {
            padding-top: 120px;
        }
    }

    @@media (max-width: 576px) {
        .legal-title {
            font-size: 2rem;
        }

        .legal-table th,
        .legal-table td {
            display: block;
            width: 100%;
        }

        .legal-table th {
            border-bottom: none;
            padding-bottom: 6px;
        }

        .legal-table td {
            padding-top: 6px;
        }
    }
</style>

@if (!isEmbed)
{
    <section class="legal-hero text-center">
        <div class="container">
            <div class="legal-badge">
                <i class="fas fa-file-signature"></i>
                @pageBadge
            </div>

            <h1 class="display-5 legal-title">
                @pageTitle
            </h1>

            <p class="legal-lead">
                @pageLead
            </p>
        </div>
    </section>
}

<section class="legal-wrapper @(isEmbed ? "legal-wrapper-embed" : "")">
    <div class="container">
        <div class="legal-layout @(isEmbed ? "legal-layout-embed" : "")">

            @if (!isEmbed)
            {
                <aside class="legal-sidebar">
                    <div class="legal-sidebar-title">
                        @(isEnglish ? "Contents" : "İçindekiler")
                    </div>

                    @foreach (var item in sections)
                    {
                        <a href="#@item.Id" class="legal-nav-link">
                            @item.Nav
                        </a>
                    }
                </aside>
            }

            <article class="legal-content @(isEmbed ? "legal-content-embed" : "")">

                <div class="legal-info-box">
                    <strong>@(isEnglish ? "Last updated:" : "Son güncelleme:")</strong> @lastUpdated
                    <br />
                    @noticeText
                </div>

                @foreach (var item in sections)
                {
                    <section id="@item.Id" class="legal-section">
                        <h2>@item.Title</h2>
                        @Html.Raw(HtmlSanitizer.Sanitize(item.Html))
                    </section>
                }

            </article>
        </div>
    </div>
</section>
@model AntAbstract.Web.Models.ViewModels.Website.ConferenceHomePageViewModel
@using Microsoft.AspNetCore.Identity
@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.WebsiteBlocks
@using System.Text.Json

@inject SignInManager<AppUser> SignInManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Model.Conference?.Title ?? Localizer["DefaultPageTitle"].Value;
    Layout = "_Layout";

    Func<string, string, string> L = (key, fallback) =>
{
    var text = Localizer[key].Value;
    return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
};

    var registeredIds = ViewBag.RegisteredConferenceIds as List<Guid> ?? new List<Guid>();

    var activeBlocks = Model.Blocks?
        .Where(b => b.IsActive)
        .OrderBy(b => b.Order)
        .ToList() ?? new List<ConferencePageBlock>();

    var heroBlock = activeBlocks.FirstOrDefault(b => b.BlockType == ConferencePageBlockType.Hero);

    string? heroBtnText = null;
    string? heroBtnUrl = null;

    if (heroBlock != null && !string.IsNullOrWhiteSpace(heroBlock.ContentJson))
    {
        try
        {
            using var doc = JsonDocument.Parse(heroBlock.ContentJson);
            var root = doc.RootElement;

            if (root.TryGetProperty("buttonText", out var bt))
            {
                heroBtnText = bt.GetString();
            }

            if (root.TryGetProperty("buttonUrl", out var bu))
            {
                heroBtnUrl = bu.GetString();
            }
        }
        catch
        {
        }
    }

    var slug = Model.Conference?.Tenant?.Slug
        ?? Model.Conference?.Slug
        ?? ViewContext.RouteData.Values["slug"]?.ToString()
        ?? "";

    var registrationUrl = string.IsNullOrWhiteSpace(slug)
        ? "/registration"
        : $"/{slug}/registration";

    var finalHeroBg = !string.IsNullOrWhiteSpace(Model.Conference?.BannerPath)
        ? Model.Conference.BannerPath
        : "https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80";
}

@if (Model.Conference == null)
{
    <div class="alert alert-danger mt-5 container">
        @Localizer["ConferenceNotFound"]
    </div>

    return;
}

<style>
    :root {
        --theme-primary: #0f172a;
        --theme-accent: #00aeef;
        --theme-danger: #ef4444;
    }

    .conf-hero-modern {
        position: relative;
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        padding: 160px 0 100px 0;
        color: white;
        border-bottom: 5px solid var(--theme-accent);
    }

    .hero-glass-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(15,23,42,0.85) 0%, rgba(15,23,42,0.6) 100%);
        backdrop-filter: blur(3px);
    }

    .sticky-sidebar {
        position: sticky;
        top: 30px;
        z-index: 10;
    }

    .modern-menu-list {
        background: #fff;
        border-radius: 20px;
        padding: 10px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        border: 1px solid #f1f5f9;
    }

    .modern-menu-item {
        color: #475569 !important;
        font-weight: 600;
        padding: 14px 20px !important;
        margin-bottom: 5px;
        border-radius: 12px !important;
        transition: all 0.3s ease;
        border: none !important;
    }

        .modern-menu-item:hover,
        .modern-menu-item.active {
            background-color: var(--theme-accent) !important;
            color: #fff !important;
            transform: translateX(5px);
            box-shadow: 0 4px 10px rgba(0, 174, 239, 0.2);
        }

    .content-card {
        background: #fff;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.03);
        border: 1px solid rgba(0,0,0,0.02);
        margin-bottom: 40px;
        scroll-margin-top: 40px;
    }

    .content-title {
        color: var(--theme-primary);
        font-weight: 800;
        font-size: 1.75rem;
        margin-bottom: 25px;
        position: relative;
        padding-bottom: 15px;
    }

        .content-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 4px;
            background: var(--theme-accent);
            border-radius: 2px;
        }

    .content-text {
        color: #475569;
        font-size: 1.1rem;
        line-height: 1.9;
        text-align: justify;
    }

    .modern-red-pulse-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        aspect-ratio: 1/1;
        max-height: 240px;
        background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
        border-radius: 50%;
        text-decoration: none;
        color: white;
        box-shadow: 0 15px 35px rgba(255, 75, 43, 0.3);
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
        border: 8px solid rgba(255,255,255,0.5);
    }

        .modern-red-pulse-btn:hover {
            transform: scale(1.05) translateY(-5px);
            color: white;
            box-shadow: 0 20px 40px rgba(255, 75, 43, 0.4);
            border-color: #fff;
        }

        .modern-red-pulse-btn i {
            transition: transform 0.3s;
        }

        .modern-red-pulse-btn:hover i {
            transform: translateY(-5px);
        }

    .word-doc-card {
        display: flex;
        align-items: center;
        text-decoration: none;
        padding: 15px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

        .word-doc-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.06);
            border-color: #2b579a;
        }

    .word-icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2b579a 0%, #1e3c6b 100%);
        color: white;
        margin-right: 15px;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .word-text-wrapper h6 {
        color: #1e293b;
        font-weight: 700;
        font-size: 0.95rem;
        margin: 0 0 4px 0;
        line-height: 1.3;
    }

    .word-text-wrapper small {
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .modern-bottom-cta {
        background: var(--theme-primary);
        padding: 80px 0;
        position: relative;
        overflow: hidden;
    }

        .modern-bottom-cta::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 500px;
            height: 500px;
            background: var(--theme-accent);
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.2;
        }
</style>

<div class="bg-white py-2 border-bottom d-none d-md-block shadow-sm position-relative" style="z-index: 100;">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="fw-bold text-dark d-flex align-items-center">
            <i class="fas fa-university text-primary me-2"></i>
            @Model.Conference.Title
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="d-flex gap-2">
                <a href="#" class="btn btn-sm btn-light rounded-circle text-primary">
                    <i class="fab fa-facebook-f"></i>
                </a>

                <a href="#" class="btn btn-sm btn-light rounded-circle text-info">
                    <i class="fab fa-twitter"></i>
                </a>

                <a href="#" class="btn btn-sm btn-light rounded-circle text-primary">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>

            <a href="@registrationUrl" class="btn btn-dark btn-sm rounded-pill px-4 fw-bold shadow-sm">
                <i class="fas fa-user-plus me-2 text-info"></i>
                @L("RegisterAndSubmitButton", "Kayıt Ol / Bildiri Gönder")
            </a>
        </div>
    </div>
</div>

<div class="conf-hero-modern" style="background-image: url('@finalHeroBg');">
    <div class="hero-glass-overlay"></div>

    <div class="container position-relative z-2">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill mb-3 fw-bold tracking-widest shadow-sm">
                    <i class="fas fa-satellite-dish text-danger me-1 animate__animated animate__flash animate__infinite"></i>
                    @(Model.Conference.City ?? Localizer["OnlineConferenceText"].Value)
                </span>

                <h1 class="display-4 fw-extrabold mb-4 lh-sm">
                    @(heroBlock?.Title ?? Model.Conference.Title)
                </h1>

                <div class="d-flex flex-wrap gap-4 fs-5 text-white-50 fw-medium mb-4">
                    <div class="d-flex align-items-center">
                        <i class="far fa-calendar-alt me-2 text-info"></i>
                        @Model.Conference.StartDate.ToString("d MMMM yyyy")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5" style="margin-top: -30px; position: relative; z-index: 5;">
    <div class="row g-4 g-lg-5">

        <div class="col-lg-3 d-none d-lg-block">
            <div class="sticky-sidebar">
                <div class="modern-menu-list list-group">
                    @if (!activeBlocks.Any(b => b.BlockType != ConferencePageBlockType.Hero))
                    {
                        <div class="p-3 text-muted text-center small">
                            <i class="fas fa-info-circle mb-2 fa-2x opacity-25"></i><br>
                            @Localizer["MenusWillBeAddedText"]
                        </div>
                    }

                    @foreach (var b in activeBlocks.Where(x => x.BlockType != ConferencePageBlockType.Hero))
                    {
                        <a href="#block-@b.Id" class="list-group-item modern-menu-item">
                            <i class="fas fa-chevron-right me-2 opacity-50" style="font-size: 0.7rem;"></i>
                            @b.Title
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            @if (!activeBlocks.Any(b => b.BlockType != ConferencePageBlockType.Hero))
            {
                <div class="content-card text-center py-5">
                    <img src="https://illustrations.popsy.co/amber/web-design.svg"
                         alt="@Localizer["UnderConstructionAlt"]"
                         style="width: 200px; opacity: 0.5;">

                    <h4 class="text-muted mt-4 fw-bold">
                        @Localizer["ContentsPreparingTitle"]
                    </h4>

                    <p class="text-muted">
                        @Localizer["ContentsPreparingText"]
                    </p>
                </div>
            }

            @foreach (var b in activeBlocks.Where(x => x.BlockType != ConferencePageBlockType.Hero))
            {
                <div id="block-@b.Id" class="content-card">
                    <h3 class="content-title">@b.Title</h3>

                    @if (b.BlockType == ConferencePageBlockType.About && !string.IsNullOrWhiteSpace(b.ContentJson))
                    {
                        AboutBlockContent? aboutContent = null;

                        try
                        {
                            aboutContent = JsonSerializer.Deserialize<AboutBlockContent>(
                            b.ContentJson,
                            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        }
                        catch
                        {
                        }

                        if (aboutContent != null)
                        {
                            <div class="content-text">
                                @Html.Raw(aboutContent.Description?.Replace("\n", "<br/>"))
                            </div>

                            @if (aboutContent.Features != null && aboutContent.Features.Any(f => !string.IsNullOrWhiteSpace(f)))
                            {
                                <div class="row mt-4 g-3">
                                    @foreach (var f in aboutContent.Features.Where(f => !string.IsNullOrWhiteSpace(f)))
                                    {
                                        <div class="col-sm-12">
                                            <div class="d-flex align-items-center bg-light p-3 rounded-3 border">
                                                <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                                                <span class="fw-bold text-dark">@f</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="content-text">
                            @if (!string.IsNullOrEmpty(b.Subtitle))
                            {
                                @Html.Raw(b.Subtitle.Replace("\n", "<br/>"))
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-3">
            <div class="sticky-sidebar">

                <div class="d-flex justify-content-center mb-5 mx-auto" style="max-width: 240px;">
                    <a href="@registrationUrl" class="modern-red-pulse-btn">
                        <i class="fas fa-cloud-upload-alt fa-3x mb-2 opacity-75"></i>

                        <span class="fs-6 fw-bold mb-1 opacity-75">
                            @L("OnlineLabel", "ÇEVRİMİÇİ")
                        </span>

                        <span class="fs-4 fw-bolder lh-1 text-center">
                            @L("RegisterAndSubmitText_Line1", "KAYIT OL")<br />
                            @L("RegisterAndSubmitText_Line2", "BİLDİRİ GÖNDER")
                        </span>
                    </a>
                </div>

                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                    @Localizer["DocumentsAndTemplatesTitle"]
                </h5>

                <div class="d-flex flex-column gap-3 mb-5">
                    <a href="#" class="word-doc-card">
                        <div class="word-icon-wrapper">
                            <i class="fas fa-file-word"></i>
                        </div>

                        <div class="word-text-wrapper">
                            <h6>@Localizer["WritingRulesTitle"]</h6>
                            <small>@Localizer["WritingRulesSubtitle"]</small>
                        </div>
                    </a>

                    <a href="#" class="word-doc-card">
                        <div class="word-icon-wrapper">
                            <i class="fas fa-file-word"></i>
                        </div>

                        <div class="word-text-wrapper">
                            <h6>@Localizer["SampleAbstractFormatTitle"]</h6>
                            <small>@Localizer["DocxDownloadText"]</small>
                        </div>
                    </a>

                    <a href="#" class="word-doc-card">
                        <div class="word-icon-wrapper">
                            <i class="fas fa-file-word"></i>
                        </div>

                        <div class="word-text-wrapper">
                            <h6>@Localizer["FullTextFormatTitle"]</h6>
                            <small>@Localizer["DocxDownloadText"]</small>
                        </div>
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>

<div class="modern-bottom-cta">
    <div class="container text-center position-relative z-2">
        <h2 class="display-6 fw-bold mb-4">
            @Localizer["BottomCtaTitle"]
        </h2>

        <p class="lead text-white-50 mb-5 mw-600 mx-auto">
            @Localizer["BottomCtaText"]
        </p>

        @if (registeredIds.Contains(Model.Conference.Id))
        {
            <a href="@registrationUrl"
               class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold text-primary shadow-lg">
                <i class="fas fa-paper-plane me-2"></i>
                @L("SubmitAbstractButton", "Bildiri Gönder")
            </a>
        }
        else
        {
            <a href="@registrationUrl"
               class="btn btn-info btn-lg rounded-pill px-5 py-3 fw-bold text-white shadow-lg border-0"
               style="background-color: var(--theme-accent);">
                <i class="fas fa-user-plus me-2"></i>
                @L("RegisterAndSubmitButton", "Kayıt Ol / Bildiri Gönder")
            </a>
        }
    </div>
</div>

<div class="bg-light py-5 border-top">
    <div class="container py-4">
        <h3 class="text-center fw-bold text-dark mb-5">
            @Localizer["SuggestedConferencesTitle"]
        </h3>

        <div class="row g-4 justify-content-center">
            @for (int i = 1; i <= 4; i++)
            {
                <div class="col-md-3 col-sm-6">
                    <a href="#" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden transition-all"
                             style="transition: transform 0.3s; cursor: pointer;"
                             onmouseover="this.style.transform='translateY(-10px)'"
                             onmouseout="this.style.transform='translateY(0)'">

                            <img src="https://placehold.co/300x400/e2e8f0/64748b?text=Kongre+Afişi+@i"
                                 class="card-img-top"
                                 alt="@Localizer["ConferencePosterAlt"]">
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
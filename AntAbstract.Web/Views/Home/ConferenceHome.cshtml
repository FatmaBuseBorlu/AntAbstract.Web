@model AntAbstract.Web.Models.ViewModels.Website.ConferenceHomePageViewModel
@using Microsoft.AspNetCore.Identity
@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.WebsiteBlocks
@using System.Text.Json
@using System.Linq

@inject SignInManager<AppUser> SignInManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Model.Conference?.Title ?? Localizer["DefaultPageTitle"].Value;
    Layout = "_Layout";

    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;
        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
    };

    string ResolveAssetUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "";
        }

        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("~/"))
        {
            return Url.Content(path);
        }

        if (path.StartsWith("/"))
        {
            return path;
        }

        return "/" + path.TrimStart('/');
    }

    var registeredIds = ViewBag.RegisteredConferenceIds as List<Guid> ?? new List<Guid>();

    var activeBlocks = Model.Blocks?
        .Where(b => b.IsActive)
        .OrderBy(b => b.Order)
        .ToList() ?? new List<ConferencePageBlock>();

    var heroBlock = activeBlocks.FirstOrDefault(b => b.BlockType == ConferencePageBlockType.Hero);

    var contentBlocks = activeBlocks
        .Where(x => x.BlockType != ConferencePageBlockType.Hero)
        .ToList();

    var slug = Model.Conference?.Tenant?.Slug
        ?? Model.Conference?.Slug
        ?? ViewContext.RouteData.Values["slug"]?.ToString()
        ?? "";

    var registrationUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}/registration";

    var submitAbstractUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}/submit-abstract";

    var programUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}/program";

    var isRegisteredToThisConference = Model.Conference != null
        && registeredIds.Contains(Model.Conference.Id);

    var mainActionUrl = isRegisteredToThisConference
        ? submitAbstractUrl
        : registrationUrl;

    var heroCardActionText = L("HeroCardContinueButton", "Başvuruya Devam Et");

    var heroCardActionIcon = "fa-arrow-right";
    var finalHeroBg = !string.IsNullOrWhiteSpace(Model.Conference?.BannerPath)
        ? ResolveAssetUrl(Model.Conference.BannerPath)
        : "https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80";

    var heroTitle = !string.IsNullOrWhiteSpace(heroBlock?.Title)
        ? heroBlock.Title
        : Model.Conference?.Title ?? "";

    var heroSubtitle = !string.IsNullOrWhiteSpace(heroBlock?.Subtitle)
        ? heroBlock.Subtitle
        : L("ConferenceHeroDefaultSubtitle",
            "Bilimsel paylaşımı, akademik iş birliğini ve yenilikçi fikirleri aynı platformda buluşturan kongre deneyimi.");

    var cityText = !string.IsNullOrWhiteSpace(Model.Conference?.City)
        ? Model.Conference.City
        : L("OnlineConferenceText", "Çevrimiçi");

    var conferenceDateText = Model.Conference != null
        ? Model.Conference.StartDate.ToString("dd MMMM yyyy")
        : "";

    var endDateText = Model.Conference != null
        ? Model.Conference.EndDate.ToString("dd MMMM yyyy")
        : "";

    var suggestedConferences = Model.SuggestedConferences?.ToList() ?? new List<Conference>();
}

@if (Model.Conference == null)
{
    <div class="alert alert-danger mt-5 container">
        @Localizer["ConferenceNotFound"]
    </div>

    return;
}


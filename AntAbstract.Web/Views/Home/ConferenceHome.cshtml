        font-size: 0.92rem;
        margin: 0 0 4px 0;
        line-height: 1.3;
    }

    .word-text-wrapper small {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 700;
    }

    .bottom-cta {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.25), transparent 30%), linear-gradient(135deg, #0f172a 0%, #172554 100%);
        padding: 80px 0;
        position: relative;
        overflow: hidden;
        color: #ffffff;
    }

        .bottom-cta h2 {
            color: #ffffff;
            font-weight: 900;
            letter-spacing: -0.05em;
        }

        .bottom-cta p {
            color: rgba(255, 255, 255, 0.70);
        }

    .suggested-section {
        background: radial-gradient(circle at 10% 0%, rgba(0, 174, 239, 0.08), transparent 30%), #ffffff;
        border-top: 1px solid #e8eef6;
    }

    .suggested-card {
        border: none;
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        transition: all 0.25s ease;
        height: 100%;
        background: #ffffff;
    }

        .suggested-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
        }

        .suggested-card img {
            height: 320px;
            object-fit: cover;
            width: 100%;
        }

    @@media (max-width: 992px) {
        .conference-hero {
            min-height: auto;
        }

        .hero-inner {
            padding: 4rem 0;
        }

        .hero-info-card {
            margin-top: 1.25rem;
        }

        .sticky-sidebar {
            position: static;
        }

        .action-info-grid,
        .hero-info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .conference-top-strip {
            display: none;
        }

        .content-card {
            padding: 24px;
            border-radius: 24px;
        }

        .hero-meta-item,
        .hero-actions a {
            width: 100%;
        }
    }

    @@media (max-width: 575px) {
        .hero-inner {
            padding: 2.5rem 0;
        }

        .hero-title {
            font-size: 1.6rem;
        }

        .content-card {
            padding: 16px;
            border-radius: 18px;
        }

        .section-title {
            font-size: 1.25rem;
        }

        .container {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
    }

    /* ── Yapılandırılmış blok gösterimleri ── */

    /* Konular */
    .block-topic-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 0.75rem;
    }

    .block-topic-item {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        padding: 0.95rem 1.1rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .block-topic-item i {
        color: #16a34a;
        margin-top: 3px;
        flex-shrink: 0;
    }

    .block-topic-item strong {
        display: block;
        color: #0f172a;
        font-size: 0.95rem;
    }

    .block-topic-item span {
        display: block;
        color: #64748b;
        font-size: 0.85rem;
        margin-top: 2px;
    }

    /* Önemli tarihler */
    .block-timeline {
        position: relative;
        padding-left: 1.6rem;
    }

    .block-timeline::before {
        content: "";
        position: absolute;
        left: 6px;
        top: 6px;
        bottom: 6px;
        width: 2px;
        background: #e2e8f0;
    }

    .block-timeline-item {
        position: relative;
        padding-bottom: 1.35rem;
    }

    .block-timeline-item:last-child {
        padding-bottom: 0;
    }

    .block-timeline-dot {
        position: absolute;
        left: -1.6rem;
        top: 5px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #0ea5e9;
        border: 3px solid #fff;
        box-shadow: 0 0 0 2px #bae6fd;
    }

    .block-timeline-item.is-passed .block-timeline-dot {
        background: #cbd5e1;
        box-shadow: 0 0 0 2px #e2e8f0;
    }

    .block-timeline-item.is-passed .block-timeline-body {
        opacity: 0.55;
    }

    .block-timeline-date {
        font-size: 0.78rem;
        font-weight: 800;
        color: #0ea5e9;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .block-timeline-label {
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
        margin-top: 2px;
    }

    .block-timeline-desc {
        font-size: 0.86rem;
        color: #64748b;
        margin-top: 3px;
    }

    /* Ücret tablosu */
    .block-fee-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.92rem;
    }

    .block-fee-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: 0.75rem 1rem;
        border-bottom: 2px solid #e2e8f0;
        text-align: left;
    }

    .block-fee-table tbody td {
        padding: 0.95rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        vertical-align: middle;
    }

    .block-fee-table tbody tr.is-highlighted td {
        background: #eff6ff;
    }

    .block-fee-table tbody tr.is-highlighted td:first-child {
        box-shadow: inset 3px 0 0 #0ea5e9;
    }

    .block-fee-desc {
        font-size: 0.8rem;
        color: #94a3b8;
        margin-top: 2px;
    }

    .block-fee-price {
        font-weight: 800;
        color: #0f172a;
        white-space: nowrap;
    }

    .block-fee-price span {
        font-size: 0.75rem;
        font-weight: 700;
        color: #94a3b8;
        margin-left: 2px;
    }

    /* Kurullar */
    .block-committee-group + .block-committee-group {
        margin-top: 1.75rem;
    }

    .block-committee-title {
        font-size: 1.02rem;
        font-weight: 800;
        color: #0f172a;
        padding-bottom: 0.6rem;
        margin-bottom: 1rem;
        border-bottom: 2px solid #e2e8f0;
    }

    .block-committee-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 0.7rem;
    }

    .block-committee-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.8rem 0.95rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .block-committee-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: #fff;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .block-committee-name {
        font-weight: 700;
        color: #0f172a;
        font-size: 0.9rem;
    }

    .block-committee-inst {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 1px;
    }

    /* İletişim */
    .block-contact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.75rem;
    }

    .block-contact-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1rem 1.15rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: all .15s ease;
    }

    a.block-contact-item:hover {
        border-color: #0ea5e9;
        background: #f0f9ff;
    }

    .block-contact-item i {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e0f2fe;
        color: #0284c7;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .block-contact-item span {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .block-contact-item strong {
        display: block;
        font-size: 0.9rem;
        color: #0f172a;
        margin-top: 2px;
    }

    .block-contact-map {
        margin-top: 1.1rem;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .block-contact-map iframe {
        width: 100%;
        height: 300px;
        border: 0;
        display: block;
    }

    /* SSS */
    .block-faq .accordion-item {
        border: 1px solid #e2e8f0;
        border-radius: 12px !important;
        margin-bottom: 0.6rem;
        overflow: hidden;
    }

    .block-faq .accordion-button {
        font-weight: 700;
        color: #0f172a;
        font-size: 0.94rem;
        background: #fff;
    }

    .block-faq .accordion-button:not(.collapsed) {
        background: #f0f9ff;
        color: #0369a1;
        box-shadow: none;
    }

    .block-faq .accordion-button:focus {
        box-shadow: none;
        border-color: #bae6fd;
    }

    .block-faq .accordion-body {
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.7;
    }

    /* Sponsorlar */
    .block-sponsor-tier {
        font-size: 0.78rem;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin: 1.4rem 0 0.8rem;
    }

    .block-sponsor-tier:first-child {
        margin-top: 0;
    }

    .block-sponsor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.75rem;
    }

    .block-sponsor-card {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 88px;
        padding: 1rem;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .block-sponsor-card img {
        max-width: 100%;
        max-height: 56px;
        object-fit: contain;
    }

    .block-sponsor-card span {
        font-weight: 700;
        color: #475569;
        font-size: 0.88rem;
        text-align: center;
    }

    /* Kongreye çağrı */
    .block-call-deadline {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 1.1rem;
        padding: 0.75rem 1.15rem;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 12px;
    }

    .block-call-deadline i {
        color: #b45309;
    }

    .block-call-deadline span {
        font-size: 0.74rem;
        font-weight: 800;
        color: #92400e;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .block-call-deadline strong {
        color: #78350f;
        font-size: 0.95rem;
    }

    .block-call-list {
        margin: 1.1rem 0 0;

    }

    .block-call-list li {
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.7;
        margin-bottom: 0.4rem;
    }

</style>

@* Bildiri gönderimi süresi dolduğunda kullanıcı buraya yönlendiriliyor ama
   sebep hiçbir yerde gösterilmiyordu; sessizce atılmış gibi görünüyordu. *@
@if (TempData["ErrorMessage"] != null || TempData["InfoMessage"] != null || TempData["SuccessMessage"] != null)
{
    <div class="container mt-3">
    </div>
}

<div class="conference-top-strip py-2 d-none d-md-block">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="conference-top-title">
            <i class="fas fa-university"></i>
            @Model.Conference.Title
            @if (!string.IsNullOrWhiteSpace(Model.Conference.ExternalWebsiteUrl))
            {
                <a href="@Model.Conference.ExternalWebsiteUrl" target="_blank" rel="noopener"
                   style="margin-left:12px;font-size:.75rem;font-weight:700;color:#38bdf8;text-decoration:none;">
                    <i class="fas fa-external-link-alt me-1"></i>@Localizer["ExternalSite"]
                </a>
            }
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="d-flex gap-2">
                <a href="#" class="social-circle" aria-label="Facebook">
                    <i class="fab fa-facebook-f"></i>
                </a>

                <a href="#" class="social-circle" aria-label="Twitter">
                    <i class="fab fa-twitter"></i>
                </a>

                <a href="#" class="social-circle" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>

            @{
                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                var currentShortCulture = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase) ? "TR" : "EN";
                var returnUrl = Context.Request.Path + Context.Request.QueryString;
            }
            <div class="dropdown language-dropdown">
                <button class="language-current-btn dropdown-toggle"
                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-globe"></i>
                    <span>@currentShortCulture</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end language-menu">
                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="culture" value="tr-TR" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="language-menu-item @(currentCulture.StartsWith("tr") ? "active" : "")">
                            <span class="language-code">TR</span>
                            <span class="language-name">Türkçe</span>
                        </button>
                    </form>
                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="culture" value="en-US" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="language-menu-item @(currentCulture.StartsWith("en") ? "active" : "")">
                            <span class="language-code">EN</span>
                            <span class="language-name">English</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="conference-hero" style="background-image: url('@finalHeroBg');">
    <div class="container hero-inner">
        <div class="row align-items-center g-4">

            <div class="col-xl-7 col-lg-7">
                @if (!string.IsNullOrWhiteSpace(Model.Conference.LogoPath))
                {
                    <div class="mb-3">
                        <img src="@ResolveAssetUrl(Model.Conference.LogoPath)"
                             alt="@Model.Conference.Title logo"
                             class="rounded-3 shadow"
                             style="height:56px;max-width:200px;object-fit:contain;background:rgba(255,255,255,.12);padding:6px 10px;" />
                    </div>
                }
                else
                {
                    <div class="hero-badge">
                        <i class="fas fa-calendar-check"></i>
                        @L("HeroBadge", "Güncel Bilimsel Etkinlik")
                    </div>
                }

                <h1 class="hero-title">
                    @heroTitle
                </h1>

                <p class="hero-subtitle">
                    @heroSubtitle
                </p>

                <div class="hero-meta-list">
                    <div class="hero-meta-item">
                        <div class="hero-meta-icon">
                            <i class="fas fa-location-dot"></i>
                        </div>

                        <div>
                            <small>@Localizer["LocationLabel"]</small>
                            <strong>@cityText</strong>
                        </div>
                    </div>

                    <div class="hero-meta-item">
                        <div class="hero-meta-icon">
                            <i class="fas fa-calendar-days"></i>
                        </div>

                        <div>
                            <small>@Localizer["StartDateLabel"]</small>
                            <strong>@conferenceDateText</strong>
                        </div>
                    </div>

                    <div class="hero-meta-item">
                        <div class="hero-meta-icon">
                            <i class="fas fa-flag-checkered"></i>
                        </div>

                        <div>
                            <small>@Localizer["EndDateLabel"]</small>
                            <strong>@endDateText</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-5 col-lg-5">
                <div class="hero-info-card">
                    <div class="hero-info-card-header">
                        <div>
                            <span>@Localizer["ConferenceInfoLabel"]</span>
                            <h3>@Localizer["ApplicationAndParticipation"]</h3>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.LogoPath))
                        {
                            <img src="@ResolveAssetUrl(Model.Conference.LogoPath)"
                                 alt="Logo"
                                 style="height:46px;max-width:100px;object-fit:contain;" />
                        }
                        else
                        {
                            <div class="hero-info-icon">
                                <i class="fas fa-paper-plane"></i>
                            </div>
                        }
                    </div>

                    <div class="hero-info-grid">
                        <div>
                            <small>@Localizer["RegistrationStatusLabel"]</small>
                            @if (canRegisterNow)
                            {
                                <strong class="text-success"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusOpen"]</strong>
                            }
                            else
                            {
                                <strong class="text-danger"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusClosed"]</strong>
                            }
                        </div>

                        <div>
                            <small>@Localizer["AbstractSubmissionLabel"]</small>
                            @if (canSubmitAbstract)
                            {
                                <strong class="text-success"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusActive"]</strong>
                            }
                            else
                            {
                                <strong class="text-danger"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusClosed"]</strong>
                            }
                        </div>

                        <div>
                            <small>@Localizer["LocationLabel"]</small>
                            <strong>@cityText</strong>
                        </div>

                        <div>
                            <small>@Localizer["DateLabel"]</small>
                            <strong>@conferenceDateText</strong>
                        </div>
                    </div>

                    @if (showMainAction)
                    {
                        <a href="@mainActionUrl" class="hero-card-cta">
                            <span>
                                <i class="fas @heroCardActionIcon"></i>
                                @heroCardActionText
                            </span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <div class="hero-card-cta" style="background:#94a3b8;cursor:default;">
                            <span><i class="fas fa-lock me-1"></i> @Localizer["ApplicationsClosed"]</span>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

<div class="conference-page-shell">
    <div class="container">
        <div class="row g-4 g-lg-5">

            <div class="col-lg-3 d-none d-lg-block">
                <div class="sticky-sidebar">
                    <div class="modern-menu-list list-group">
                        <div class="modern-menu-title">
                            @Localizer["QuickAccessLabel"]
                        </div>

                        @if (!contentBlocks.Any())
                        {
                            <div class="p-3 text-muted text-center small">
                                <i class="fas fa-info-circle mb-2 fa-2x opacity-25"></i><br>
                                @Localizer["MenusWillBeAddedText"]
                            </div>
                        }

                        @foreach (var b in contentBlocks)
                        {
                            <a href="#block-@b.Id" class="list-group-item modern-menu-item">
                                <i class="fas fa-chevron-right"></i>
                                @b.Title
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                @if (!contentBlocks.Any())
                {
                    <div class="empty-content-card">
                        <div class="empty-content-icon">
                            <i class="fas fa-layer-group"></i>
                        </div>

                        <h4 class="text-dark fw-bold">
                            @Localizer["ContentsPreparingTitle"]
                        </h4>

                        <p class="text-muted mb-0">
                            @Localizer["ContentsPreparingText"]
                        </p>
                    </div>
                }

                @foreach (var b in contentBlocks)
                {
                    <div id="block-@b.Id" class="content-card">
                        <h3 class="content-title">
                            @b.Title
                        </h3>

                        @if (b.BlockType == ConferencePageBlockType.About && !string.IsNullOrWhiteSpace(b.ContentJson))
                        {
                            AboutBlockContent? aboutContent = null;

                            try
                            {
                                aboutContent = JsonSerializer.Deserialize<AboutBlockContent>(
                                b.ContentJson,
                                new JsonSerializerOptions
                                {
                                    PropertyNameCaseInsensitive = true
                                });
                            }
                            catch
                            {
                            }

                            if (aboutContent != null)
                            {
                                <div class="content-text">
                                    @Html.Raw(HtmlSanitizer.Sanitize(aboutContent.Description?.Replace("\n", "<br/>") ?? ""))
                                </div>

                                @if (aboutContent.Features != null && aboutContent.Features.Any(f => !string.IsNullOrWhiteSpace(f)))
                                {
                                    <div class="row mt-4 g-3">
                                        @foreach (var f in aboutContent.Features.Where(f => !string.IsNullOrWhiteSpace(f)))
                                        {
                                            <div class="col-sm-12">
                                                <div class="d-flex align-items-center bg-light p-3 rounded-3 border">
                                                    <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                                                    <span class="fw-bold text-dark">@f</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.Topics)
                        {
                            var topics = ParseBlock<TopicsBlockContent>(b.ContentJson);

                            if (!string.IsNullOrWhiteSpace(topics?.Description))
                            {
                                <div class="content-text mb-4">
                                    @Html.Raw(HtmlSanitizer.Sanitize(topics.Description.Replace("\n", "<br/>")))
                                </div>
                            }

                            if (topics?.Items?.Any() == true)
                            {
                                <div class="block-topic-grid">
                                    @foreach (var t in topics.Items)
                                    {
                                        <div class="block-topic-item">
                                            <i class="fas fa-circle-check"></i>
                                            <div>
                                                <strong>@t.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                                {
                                                    <span>@t.Description</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.ImportantDates)
                        {
                            var dates = ParseBlock<ImportantDatesBlockContent>(b.ContentJson);

                            if (dates?.Items?.Any() == true)
                            {
                                <div class="block-timeline">
                                    @foreach (var d in dates.Items)
                                    {
                                        <div class="block-timeline-item @(d.IsPassed ? "is-passed" : "")">
                                            <div class="block-timeline-dot"></div>
                                            <div class="block-timeline-body">
                                                <div class="block-timeline-date">@d.Date</div>
                                                <div class="block-timeline-label">@d.Label</div>
                                                @if (!string.IsNullOrWhiteSpace(d.Description))
                                                {
                                                    <div class="block-timeline-desc">@d.Description</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.Fees)
                        {
                            var fees = ParseBlock<FeesBlockContent>(b.ContentJson);

                            if (!string.IsNullOrWhiteSpace(fees?.Description))
                            {
                                <div class="content-text mb-4">
                                    @Html.Raw(HtmlSanitizer.Sanitize(fees.Description.Replace("\n", "<br/>")))
                                </div>
                            }

                            if (fees?.Items?.Any() == true)
                            {
                                <div class="table-responsive">
                                    <table class="block-fee-table">
                                        <thead>
                                            <tr>
                                                <th>@L("FeeTypeHeader", "Kayıt Türü")</th>
                                                <th>@L("FeePriceHeader", "Ücret")</th>
                                                <th>@L("FeeDeadlineHeader", "Son Tarih")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var f in fees.Items)
                                            {
                                                <tr class="@(f.IsHighlighted ? "is-highlighted" : "")">
                                                    <td>
                                                        <strong>@f.Name</strong>
                                                        @if (!string.IsNullOrWhiteSpace(f.Description))
                                                        {
                                                            <div class="block-fee-desc">@f.Description</div>
                                                        }
                                                    </td>
                                                    <td class="block-fee-price">
                                                        @f.Price
                                                        <span>@fees.Currency</span>
                                                    </td>
                                                    <td>@(string.IsNullOrWhiteSpace(f.Deadline) ? "—" : f.Deadline)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.Committees)
                        {
                            var committees = ParseBlock<CommitteesBlockContent>(b.ContentJson);

                            if (committees?.Groups?.Any() == true)
                            {
                                foreach (var g in committees.Groups)
                                {
                                    <div class="block-committee-group">
                                        @if (!string.IsNullOrWhiteSpace(g.Name))
                                        {
                                            <h4 class="block-committee-title">@g.Name</h4>
                                        }

                                        @if (g.Members?.Any() == true)
                                        {
                                            <div class="block-committee-grid">
                                                @foreach (var m in g.Members)
                                                {
                                                    <div class="block-committee-card">
                                                        <div class="block-committee-avatar">
                                                            @(string.IsNullOrWhiteSpace(m.FullName) ? "?" : m.FullName.Trim()[0].ToString().ToUpperInvariant())
                                                        </div>
                                                        <div>
                                                            <div class="block-committee-name">
                                                                @(string.IsNullOrWhiteSpace(m.Title) ? "" : m.Title + " ")@m.FullName
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(m.Institution))
                                                            {
                                                                <div class="block-committee-inst">@m.Institution</div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.Contact)
                        {
                            var contact = ParseBlock<ContactBlockContent>(b.ContentJson);

                            if (!string.IsNullOrWhiteSpace(contact?.Description))
                            {
                                <div class="content-text mb-4">
                                    @Html.Raw(HtmlSanitizer.Sanitize(contact.Description.Replace("\n", "<br/>")))
                                </div>
                            }

                            if (contact != null)
                            {
                                <div class="block-contact-grid">
                                    @if (!string.IsNullOrWhiteSpace(contact.Email))
                                    {
                                        <a class="block-contact-item" href="mailto:@contact.Email">
                                            <i class="fas fa-envelope"></i>
                                            <div>
                                                <span>@L("ContactEmailLabel", "E-posta")</span>
                                                <strong>@contact.Email</strong>
                                            </div>
                                        </a>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(contact.Phone))
                                    {
                                        <a class="block-contact-item" href="tel:@contact.Phone.Replace(" ", "")">
                                            <i class="fas fa-phone"></i>
                                            <div>
                                                <span>@L("ContactPhoneLabel", "Telefon")</span>
                                                <strong>@contact.Phone</strong>
                                            </div>
                                        </a>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(contact.Address))
                                    {
                                        <div class="block-contact-item">
                                            <i class="fas fa-location-dot"></i>
                                            <div>
                                                <span>@L("ContactAddressLabel", "Adres")</span>
                                                <strong>@contact.Address</strong>
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(contact.MapEmbedUrl) &&
                                     contact.MapEmbedUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="block-contact-map">
                                        <iframe src="@contact.MapEmbedUrl"
                                                loading="lazy"
                                                referrerpolicy="no-referrer-when-downgrade"
                                                allowfullscreen></iframe>
                                    </div>
                                }
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.FAQ)
                        {
                            var faq = ParseBlock<FaqBlockContent>(b.ContentJson);

                            if (faq?.Questions?.Any() == true)
                            {
                                <div class="accordion block-faq" id="faq-@b.Id">
                                    @foreach (var (q, qi) in faq.Questions.Select((x, i) => (x, i)))
                                    {
                                        <div class="accordion-item">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#faq-@b.Id-@qi">
                                                    @q.Question
                                                </button>
                                            </h2>
                                            <div id="faq-@b.Id-@qi" class="accordion-collapse collapse"
                                                 data-bs-parent="#faq-@b.Id">
                                                <div class="accordion-body">
                                                    @Html.Raw(HtmlSanitizer.Sanitize((q.Answer ?? "").Replace("\n", "<br/>")))
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.Sponsors)
                        {
                            var sponsors = ParseBlock<SponsorBlockContent>(b.ContentJson);

                            if (sponsors?.Sponsors?.Any() == true)
                            {
                                foreach (var tier in new[] { "Platinum", "Gold", "Silver", "Bronze" })
                                {
                                    var inTier = sponsors.Sponsors
                                        .Where(s => string.Equals(s.Tier, tier, StringComparison.OrdinalIgnoreCase))
                                        .ToList();

                                    if (inTier.Count == 0)
                                    {
                                        continue;
                                    }

                                    <h4 class="block-sponsor-tier">@tier</h4>
                                    <div class="block-sponsor-grid">
                                        @foreach (var s in inTier)
                                        {
                                            var logo = ResolveAssetUrl(s.LogoUrl);
                                            var safeSite = !string.IsNullOrWhiteSpace(s.WebsiteUrl) &&
                                                           s.WebsiteUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                                                ? s.WebsiteUrl
                                                : null;

                                            <div class="block-sponsor-card">
                                                @if (safeSite != null)
                                                {
                                                    <a href="@safeSite" target="_blank" rel="noopener noreferrer">
                                                        @if (!string.IsNullOrWhiteSpace(logo))
                                                        {
                                                            <img src="@logo" alt="@s.Name" loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <span>@s.Name</span>
                                                        }
                                                    </a>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(logo))
                                                {
                                                    <img src="@logo" alt="@s.Name" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <span>@s.Name</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                        else if (b.BlockType == ConferencePageBlockType.CallForPapers)
                        {
                            var call = ParseBlock<CallForPapersBlockContent>(b.ContentJson);

                            if (!string.IsNullOrWhiteSpace(call?.Description))
                            {
                                <div class="content-text">
                                    @Html.Raw(HtmlSanitizer.Sanitize(call.Description.Replace("\n", "<br/>")))
                                </div>
                            }

                            if (!string.IsNullOrWhiteSpace(call?.Deadline))
                            {
                                <div class="block-call-deadline">
                                    <i class="fas fa-hourglass-half"></i>
                                    <span>@L("CallDeadlineLabel", "Son Gönderim")</span>
                                    <strong>@call.Deadline</strong>
                                </div>
                            }

                            if (call?.Guidelines?.Any() == true)
                            {
                                <ul class="block-call-list">
                                    @foreach (var g in call.Guidelines)
                                    {
                                        <li>@g</li>
                                    }
                                </ul>
                            }
                        }
                        else
                        {
                            <div class="content-text">
                                @if (!string.IsNullOrEmpty(b.Subtitle))
                                {
                                    @Html.Raw(HtmlSanitizer.Sanitize(b.Subtitle.Replace("\n", "<br/>")))
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-3">
                <div class="sticky-sidebar">

                    <div class="action-card">
                        @if (canRegisterNow || canSubmitAbstract)
                        {
                            <div class="action-card-badge">
                                <i class="fas fa-circle"></i>
                                @Localizer["ApplicationsOpen"]
                            </div>
                        }
                        else
                        {
                            <div class="action-card-badge" style="background:rgba(239,68,68,.10);color:#dc2626;">
                                <i class="fas fa-lock"></i>
                                @Localizer["ApplicationsClosed"]
                            </div>
                        }

                        <div class="action-card-icon">
                            <i class="fas fa-paper-plane"></i>
                        </div>

                        <h4>@Localizer["RegistrationAndSubmissionTitle"]</h4>

                        <p>
                            @Localizer["RegistrationAndSubmissionDesc"]
                        </p>

                        <div class="action-info-grid">
                            <div class="action-info-item">
                                <span>@Localizer["RegistrationLabel"]</span>
                                @if (canRegisterNow)
                                {
                                    <strong class="text-success">@Localizer["StatusOpen"]</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">@Localizer["StatusClosed"]</strong>
                                }
                            </div>
                            <div class="action-info-item">
                                <span>@Localizer["AbstractLabel"]</span>
                                @if (canSubmitAbstract)
                                {
                                    <strong class="text-success">@Localizer["StatusActive"]</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">@Localizer["StatusClosed"]</strong>
                                }
                            </div>
                        </div>

                        @if (Model.Conference.AbstractSubmissionDeadline.HasValue && Model.Conference.AbstractSubmissionDeadline > DateTime.Now)
                        {
                            <div class="mb-3 p-3 rounded-3 border text-center" style="background:#fffbeb;border-color:#fbbf24!important;">
                                <div class="small fw-bold text-warning mb-1"><i class="fas fa-clock me-1"></i>@Localizer["AbstractDeadlineLabel"]</div>
                                <div class="fw-bold text-dark small">@Model.Conference.AbstractSubmissionDeadline.Value.ToString("dd MMM yyyy HH:mm")</div>
                                <div id="deadline-countdown" class="mt-1 fw-bold" style="color:#d97706;font-size:.82rem;letter-spacing:.03em;">@Localizer["Calculating"]</div>
                            </div>
                        }

                        @if (canRegisterNow)
                        {
                            <a href="@registrationUrl" class="action-primary-btn">
                                <i class="fas fa-user-plus"></i>
                                @(isRegisteredToThisConference ? Localizer["AlreadyRegistered"].Value : Localizer["RegisterForConference"].Value)
                            </a>
                        }

                        @if (canSubmitAbstract && isRegisteredToThisConference)
                        {
                            <a href="@submitAbstractUrl" class="action-secondary-btn">
                                <i class="fas fa-file-arrow-up"></i> @Localizer["SubmitAbstractButton"]
                            </a>
                        }
                        else if (!isRegisteredToThisConference && canSubmitAbstract)
                        {
                            <div class="action-secondary-btn" style="cursor:default;opacity:.65;">
                                <i class="fas fa-info-circle me-1"></i> @Localizer["RegisterFirstForAbstract"]
                            </div>
                        }
                    </div>

                    <div class="documents-card">
                        <div class="documents-card-header">
                            <h5>
                                @Localizer["DocumentsAndTemplatesTitle"]
                            </h5>

                            <span>
                                <i class="fas fa-file-lines"></i>
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.WritingRulesPath))
                        {
                            <a href="@ResolveAssetUrl(Model.Conference.WritingRulesPath)" target="_blank" class="word-doc-card">
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div class="word-text-wrapper">
                                    <h6>@Localizer["WritingRulesTitle"]</h6>
                                    <small>@Localizer["WritingRulesSubtitle"]</small>
                                </div>
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.AbstractTemplatePath))
                        {
                            <a href="@ResolveAssetUrl(Model.Conference.AbstractTemplatePath)" target="_blank" class="word-doc-card" download>
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div class="word-text-wrapper">
                                    <h6>@Localizer["SampleAbstractFormatTitle"]</h6>
                                    <small>@Localizer["DocxDownloadText"]</small>
                                </div>
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.FullTextTemplatePath))
                        {
                            <a href="@ResolveAssetUrl(Model.Conference.FullTextTemplatePath)" target="_blank" class="word-doc-card" download>
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div class="word-text-wrapper">
                                    <h6>@Localizer["FullTextFormatTitle"]</h6>
                                    <small>@Localizer["DocxDownloadText"]</small>
                                </div>
                            </a>
                        }

                        @if (string.IsNullOrWhiteSpace(Model.Conference.WritingRulesPath) &&
                                                string.IsNullOrWhiteSpace(Model.Conference.AbstractTemplatePath) &&
                                                string.IsNullOrWhiteSpace(Model.Conference.FullTextTemplatePath))
                        {
                            <div class="alert alert-light border text-muted small rounded-3 mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                @Localizer["TemplatesNotUploaded"]
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="bottom-cta">
    <div class="container text-center position-relative z-2">
        <h2 class="display-6 fw-bold mb-4">
            @Localizer["BottomCtaTitle"]
        </h2>

        <p class="lead mb-5 mx-auto" style="max-width: 720px;">
            @Localizer["BottomCtaText"]
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            @if (canRegisterNow)
            {
                <a href="@registrationUrl" class="hero-primary-btn">
                    <i class="fas fa-user-plus"></i>
                    @(isRegisteredToThisConference ? Localizer["ViewYourRegistration"].Value : Localizer["RegisterNowButton"].Value)
                </a>
            }
            @if (canSubmitAbstract && isRegisteredToThisConference)
            {
                <a href="@submitAbstractUrl" class="hero-secondary-btn">
                    <i class="fas fa-file-arrow-up"></i> @Localizer["SubmitAbstractButton"]
                </a>
            }
            <a href="@programUrl" class="hero-secondary-btn">
                <i class="fas fa-calendar-alt"></i> @Localizer["ViewProgramButton"]
            </a>
        </div>

    </div>
</div>

@if (suggestedConferences.Any())
{
    <div class="suggested-section py-5">
        <div class="container py-4">
            <h3 class="text-center fw-bold text-dark mb-5">
                @Localizer["SuggestedConferencesTitle"]
            </h3>

            <div class="row g-4 justify-content-center">
                @foreach (var conf in suggestedConferences)
                {
                    var suggestedSlug = conf.Tenant?.Slug ?? conf.Slug ?? "";

                    var bannerUrl = !string.IsNullOrWhiteSpace(conf.BannerPath)
                    ? ResolveAssetUrl(conf.BannerPath)
                    : $"https://placehold.co/300x400/e2e8f0/64748b?text={Uri.EscapeDataString(conf.Title ?? "Kongre")}";

                    <div class="col-md-3 col-sm-6">
                        <a href="/@suggestedSlug" class="text-decoration-none">
                            <div class="suggested-card">
                                <div class="position-relative">
                                    <img src="@bannerUrl"
                                         alt="@conf.Title" />

                                    <div class="position-absolute bottom-0 start-0 w-100 p-3"
                                         style="background: linear-gradient(to top, rgba(0,0,0,0.88), transparent);">
                                        <h6 class="text-white fw-bold mb-1"
                                            style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @conf.Title
                                        </h6>

                                        <small class="text-info fw-bold">
                                            <i class="far fa-calendar-alt me-1"></i>
                                            @conf.StartDate.ToString("dd MMM yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.Conference.AbstractSubmissionDeadline.HasValue && Model.Conference.AbstractSubmissionDeadline > DateTime.Now)
{
    <script>
        (function () {
            var deadline = new Date('@Model.Conference.AbstractSubmissionDeadline.Value.ToString("o")');
            var el = document.getElementById('deadline-countdown');
            if (!el) return;

            function update() {
                var diff = deadline - new Date();
                if (diff <= 0) { el.textContent = '@Localizer["DeadlinePassed"]'; return; }
                var d = Math.floor(diff / 86400000);
                var h = Math.floor((diff % 86400000) / 3600000);
                var m = Math.floor((diff % 3600000) / 60000);
                var s = Math.floor((diff % 60000) / 1000);
                el.textContent = d + ' @Localizer["DaysShort"] ' + h + ' @Localizer["HoursShort"] ' + m + ' @Localizer["MinutesShort"] ' + s + ' @Localizer["SecondsLeft"]';
            }

            update();
            setInterval(update, 1000);
        })();
    </script>
}
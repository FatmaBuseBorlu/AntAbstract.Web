        .sticky-sidebar {
            position: static;
        }

        .action-info-grid,
        .hero-info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .conference-top-strip {
            display: none;
        }

        .content-card {
            padding: 24px;
            border-radius: 24px;
        }

        .hero-meta-item,
        .hero-actions a {
            width: 100%;
        }
    }

    @@media (max-width: 575px) {
        .hero-inner {
            padding: 2.5rem 0;
        }

        .hero-title {
            font-size: 1.6rem;
        }

        .content-card {
            padding: 16px;
            border-radius: 18px;
        }

        .section-title {
            font-size: 1.25rem;
        }

        .container {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
    }
</style>

<div class="conference-top-strip py-2 d-none d-md-block">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="conference-top-title">
            <i class="fas fa-university"></i>
            @Model.Conference.Title
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="d-flex gap-2">
                <a href="#" class="social-circle" aria-label="Facebook">
                    <i class="fab fa-facebook-f"></i>
                </a>

                <a href="#" class="social-circle" aria-label="Twitter">
                    <i class="fab fa-twitter"></i>
                </a>

                <a href="#" class="social-circle" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<section class="conference-hero" style="background-image: url('@finalHeroBg');">
    <div class="container hero-inner">
        <div class="row align-items-center g-4">

            <div class="col-xl-7 col-lg-7">
                @if (!string.IsNullOrWhiteSpace(Model.Conference.LogoPath))
                {
                    <div class="mb-3">
                        <img src="@ResolveAssetUrl(Model.Conference.LogoPath)"
                             alt="@Model.Conference.Title logo"
                             class="rounded-3 shadow"
                             style="height:56px;max-width:200px;object-fit:contain;background:rgba(255,255,255,.12);padding:6px 10px;" />
                    </div>
                }
                else
                {
                    <div class="hero-badge">
                        <i class="fas fa-calendar-check"></i>
                        @L("HeroBadge", "Güncel Bilimsel Etkinlik")
                    </div>
                }

                <h1 class="hero-title">
                    @heroTitle
                </h1>

                <p class="hero-subtitle">
                    @heroSubtitle
                </p>

                <div class="hero-meta-list">
                    <div class="hero-meta-item">
                        <div class="hero-meta-icon">
                            <i class="fas fa-location-dot"></i>
                        </div>

                        <div>
                            <small>@Localizer["LocationLabel"]</small>
                            <strong>@cityText</strong>
                        </div>
                    </div>

                    <div class="hero-meta-item">
                        <div class="hero-meta-icon">
                            <i class="fas fa-calendar-days"></i>
                        </div>

                        <div>
                            <small>@Localizer["StartDateLabel"]</small>
                            <strong>@conferenceDateText</strong>
                        </div>
                    </div>

                    <div class="hero-meta-item">
                        <div class="hero-meta-icon">
                            <i class="fas fa-flag-checkered"></i>
                        </div>

                        <div>
                            <small>@Localizer["EndDateLabel"]</small>
                            <strong>@endDateText</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-5 col-lg-5">
                <div class="hero-info-card">
                    <div class="hero-info-card-header">
                        <div>
                            <span>@Localizer["ConferenceInfoLabel"]</span>
                            <h3>@Localizer["ApplicationAndParticipation"]</h3>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.LogoPath))
                        {
                            <img src="@ResolveAssetUrl(Model.Conference.LogoPath)"
                                 alt="Logo"
                                 style="height:46px;max-width:100px;object-fit:contain;" />
                        }
                        else
                        {
                            <div class="hero-info-icon">
                                <i class="fas fa-paper-plane"></i>
                            </div>
                        }
                    </div>

                    <div class="hero-info-grid">
                        <div>
                            <small>@Localizer["RegistrationStatusLabel"]</small>
                            @if (Model.Conference.IsRegistrationOpen)
                            {
                                <strong class="text-success"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusOpen"]</strong>
                            }
                            else
                            {
                                <strong class="text-danger"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusClosed"]</strong>
                            }
                        </div>

                        <div>
                            <small>@Localizer["AbstractSubmissionLabel"]</small>
                            @if (Model.Conference.IsSubmissionOpen)
                            {
                                <strong class="text-success"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusActive"]</strong>
                            }
                            else
                            {
                                <strong class="text-danger"><i class="fas fa-circle me-1" style="font-size:.6rem;"></i>@Localizer["StatusClosed"]</strong>
                            }
                        </div>

                        <div>
                            <small>@Localizer["LocationLabel"]</small>
                            <strong>@cityText</strong>
                        </div>

                        <div>
                            <small>@Localizer["DateLabel"]</small>
                            <strong>@conferenceDateText</strong>
                        </div>
                    </div>

                    @if (Model.Conference.IsRegistrationOpen || Model.Conference.IsSubmissionOpen)
                    {
                        <a href="@mainActionUrl" class="hero-card-cta">
                            <span>
                                <i class="fas @heroCardActionIcon"></i>
                                @heroCardActionText
                            </span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <div class="hero-card-cta" style="background:#94a3b8;cursor:default;">
                            <span><i class="fas fa-lock me-1"></i> @Localizer["ApplicationsClosed"]</span>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

<div class="conference-page-shell">
    <div class="container">
        <div class="row g-4 g-lg-5">

            <div class="col-lg-3 d-none d-lg-block">
                <div class="sticky-sidebar">
                    <div class="modern-menu-list list-group">
                        <div class="modern-menu-title">
                            @Localizer["QuickAccessLabel"]
                        </div>

                        @if (!contentBlocks.Any())
                        {
                            <div class="p-3 text-muted text-center small">
                                <i class="fas fa-info-circle mb-2 fa-2x opacity-25"></i><br>
                                @Localizer["MenusWillBeAddedText"]
                            </div>
                        }

                        @foreach (var b in contentBlocks)
                        {
                            <a href="#block-@b.Id" class="list-group-item modern-menu-item">
                                <i class="fas fa-chevron-right"></i>
                                @b.Title
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                @if (!contentBlocks.Any())
                {
                    <div class="empty-content-card">
                        <div class="empty-content-icon">
                            <i class="fas fa-layer-group"></i>
                        </div>

                        <h4 class="text-dark fw-bold">
                            @Localizer["ContentsPreparingTitle"]
                        </h4>

                        <p class="text-muted mb-0">
                            @Localizer["ContentsPreparingText"]
                        </p>
                    </div>
                }

                @foreach (var b in contentBlocks)
                {
                    <div id="block-@b.Id" class="content-card">
                        <h3 class="content-title">
                            @b.Title
                        </h3>

                        @if (b.BlockType == ConferencePageBlockType.About && !string.IsNullOrWhiteSpace(b.ContentJson))
                        {
                            AboutBlockContent? aboutContent = null;

                            try
                            {
                                aboutContent = JsonSerializer.Deserialize<AboutBlockContent>(
                                b.ContentJson,
                                new JsonSerializerOptions
                                {
                                    PropertyNameCaseInsensitive = true
                                });
                            }
                            catch
                            {
                            }

                            if (aboutContent != null)
                            {
                                <div class="content-text">
                                    @Html.Raw(aboutContent.Description?.Replace("\n", "<br/>"))
                                </div>

                                @if (aboutContent.Features != null && aboutContent.Features.Any(f => !string.IsNullOrWhiteSpace(f)))
                                {
                                    <div class="row mt-4 g-3">
                                        @foreach (var f in aboutContent.Features.Where(f => !string.IsNullOrWhiteSpace(f)))
                                        {
                                            <div class="col-sm-12">
                                                <div class="d-flex align-items-center bg-light p-3 rounded-3 border">
                                                    <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                                                    <span class="fw-bold text-dark">@f</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="content-text">
                                @if (!string.IsNullOrEmpty(b.Subtitle))
                                {
                                    @Html.Raw(b.Subtitle.Replace("\n", "<br/>"))
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-3">
                <div class="sticky-sidebar">

                    <div class="action-card">
                        @if (Model.Conference.IsRegistrationOpen || Model.Conference.IsSubmissionOpen)
                        {
                            <div class="action-card-badge">
                                <i class="fas fa-circle"></i>
                                @Localizer["ApplicationsOpen"]
                            </div>
                        }
                        else
                        {
                            <div class="action-card-badge" style="background:rgba(239,68,68,.10);color:#dc2626;">
                                <i class="fas fa-lock"></i>
                                @Localizer["ApplicationsClosed"]
                            </div>
                        }

                        <div class="action-card-icon">
                            <i class="fas fa-paper-plane"></i>
                        </div>

                        <h4>@Localizer["RegistrationAndSubmissionTitle"]</h4>

                        <p>
                            @Localizer["RegistrationAndSubmissionDesc"]
                        </p>

                        <div class="action-info-grid">
                            <div class="action-info-item">
                                <span>@Localizer["RegistrationLabel"]</span>
                                @if (Model.Conference.IsRegistrationOpen)
                                {
                                    <strong class="text-success">@Localizer["StatusOpen"]</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">@Localizer["StatusClosed"]</strong>
                                }
                            </div>
                            <div class="action-info-item">
                                <span>@Localizer["AbstractLabel"]</span>
                                @if (Model.Conference.IsSubmissionOpen)
                                {
                                    <strong class="text-success">@Localizer["StatusActive"]</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">@Localizer["StatusClosed"]</strong>
                                }
                            </div>
                        </div>

                        @if (Model.Conference.AbstractSubmissionDeadline.HasValue && Model.Conference.AbstractSubmissionDeadline > DateTime.Now)
                        {
                            <div class="mb-3 p-3 rounded-3 border text-center" style="background:#fffbeb;border-color:#fbbf24!important;">
                                <div class="small fw-bold text-warning mb-1"><i class="fas fa-clock me-1"></i>@Localizer["AbstractDeadlineLabel"]</div>
                                <div class="fw-bold text-dark small">@Model.Conference.AbstractSubmissionDeadline.Value.ToString("dd MMM yyyy HH:mm")</div>
                                <div id="deadline-countdown" class="mt-1 fw-bold" style="color:#d97706;font-size:.82rem;letter-spacing:.03em;">@Localizer["Calculating"]</div>
                            </div>
                        }

                        @if (Model.Conference.IsRegistrationOpen)
                        {
                            <a href="@registrationUrl" class="action-primary-btn">
                                <i class="fas fa-user-plus"></i>
                                @(isRegisteredToThisConference ? Localizer["AlreadyRegistered"].Value : Localizer["RegisterForConference"].Value)
                            </a>
                        }

                        @if (Model.Conference.IsSubmissionOpen && isRegisteredToThisConference)
                        {
                            <a href="@submitAbstractUrl" class="action-secondary-btn">
                                <i class="fas fa-file-arrow-up"></i> @Localizer["SubmitAbstractButton"]
                            </a>
                        }
                        else if (!isRegisteredToThisConference && Model.Conference.IsSubmissionOpen)
                        {
                            <div class="action-secondary-btn" style="cursor:default;opacity:.65;">
                                <i class="fas fa-info-circle me-1"></i> @Localizer["RegisterFirstForAbstract"]
                            </div>
                        }
                    </div>

                    <div class="documents-card">
                        <div class="documents-card-header">
                            <h5>
                                @Localizer["DocumentsAndTemplatesTitle"]
                            </h5>

                            <span>
                                <i class="fas fa-file-lines"></i>
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.WritingRulesPath))
                        {
                            <a href="@ResolveAssetUrl(Model.Conference.WritingRulesPath)" target="_blank" class="word-doc-card">
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div class="word-text-wrapper">
                                    <h6>@Localizer["WritingRulesTitle"]</h6>
                                    <small>@Localizer["WritingRulesSubtitle"]</small>
                                </div>
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.AbstractTemplatePath))
                        {
                            <a href="@ResolveAssetUrl(Model.Conference.AbstractTemplatePath)" target="_blank" class="word-doc-card" download>
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div class="word-text-wrapper">
                                    <h6>@Localizer["SampleAbstractFormatTitle"]</h6>
                                    <small>@Localizer["DocxDownloadText"]</small>
                                </div>
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Conference.FullTextTemplatePath))
                        {
                            <a href="@ResolveAssetUrl(Model.Conference.FullTextTemplatePath)" target="_blank" class="word-doc-card" download>
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div class="word-text-wrapper">
                                    <h6>@Localizer["FullTextFormatTitle"]</h6>
                                    <small>@Localizer["DocxDownloadText"]</small>
                                </div>
                            </a>
                        }

                        @if (string.IsNullOrWhiteSpace(Model.Conference.WritingRulesPath) &&
                                                string.IsNullOrWhiteSpace(Model.Conference.AbstractTemplatePath) &&
                                                string.IsNullOrWhiteSpace(Model.Conference.FullTextTemplatePath))
                        {
                            <div class="alert alert-light border text-muted small rounded-3 mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                @Localizer["TemplatesNotUploaded"]
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<div class="bottom-cta">
    <div class="container text-center position-relative z-2">
        <h2 class="display-6 fw-bold mb-4">
            @Localizer["BottomCtaTitle"]
        </h2>

        <p class="lead mb-5 mx-auto" style="max-width: 720px;">
            @Localizer["BottomCtaText"]
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            @if (Model.Conference.IsRegistrationOpen)
            {
                <a href="@registrationUrl" class="hero-primary-btn">
                    <i class="fas fa-user-plus"></i>
                    @(isRegisteredToThisConference ? Localizer["ViewYourRegistration"].Value : Localizer["RegisterNowButton"].Value)
                </a>
            }
            @if (Model.Conference.IsSubmissionOpen && isRegisteredToThisConference)
            {
                <a href="@submitAbstractUrl" class="hero-secondary-btn">
                    <i class="fas fa-file-arrow-up"></i> @Localizer["SubmitAbstractButton"]
                </a>
            }
            <a href="@programUrl" class="hero-secondary-btn">
                <i class="fas fa-calendar-alt"></i> @Localizer["ViewProgramButton"]
            </a>
        </div>

    </div>
</div>

@if (suggestedConferences.Any())
{
    <div class="suggested-section py-5">
        <div class="container py-4">
            <h3 class="text-center fw-bold text-dark mb-5">
                @Localizer["SuggestedConferencesTitle"]
            </h3>

            <div class="row g-4 justify-content-center">
                @foreach (var conf in suggestedConferences)
                {
                    var suggestedSlug = conf.Tenant?.Slug ?? conf.Slug ?? "";

                    var bannerUrl = !string.IsNullOrWhiteSpace(conf.BannerPath)
                    ? ResolveAssetUrl(conf.BannerPath)
                    : $"https://placehold.co/300x400/e2e8f0/64748b?text={Uri.EscapeDataString(conf.Title ?? "Kongre")}";

                    <div class="col-md-3 col-sm-6">
                        <a href="/@suggestedSlug" class="text-decoration-none">
                            <div class="suggested-card">
                                <div class="position-relative">
                                    <img src="@bannerUrl"
                                         alt="@conf.Title" />

                                    <div class="position-absolute bottom-0 start-0 w-100 p-3"
                                         style="background: linear-gradient(to top, rgba(0,0,0,0.88), transparent);">
                                        <h6 class="text-white fw-bold mb-1"
                                            style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @conf.Title
                                        </h6>

                                        <small class="text-info fw-bold">
                                            <i class="far fa-calendar-alt me-1"></i>
                                            @conf.StartDate.ToString("dd MMM yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.Conference.AbstractSubmissionDeadline.HasValue && Model.Conference.AbstractSubmissionDeadline > DateTime.Now)
{
    <script>
        (function () {
            var deadline = new Date('@Model.Conference.AbstractSubmissionDeadline.Value.ToString("o")');
            var el = document.getElementById('deadline-countdown');
            if (!el) return;

            function update() {
                var diff = deadline - new Date();
                if (diff <= 0) { el.textContent = '@Localizer["DeadlinePassed"]'; return; }
                var d = Math.floor(diff / 86400000);
                var h = Math.floor((diff % 86400000) / 3600000);
                var m = Math.floor((diff % 3600000) / 60000);
                var s = Math.floor((diff % 60000) / 1000);
                el.textContent = d + ' @Localizer["DaysShort"] ' + h + ' @Localizer["HoursShort"] ' + m + ' @Localizer["MinutesShort"] ' + s + ' @Localizer["SecondsLeft"]';
            }

            update();
            setInterval(update, 1000);
        })();
    </script>
}
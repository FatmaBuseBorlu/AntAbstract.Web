@model IEnumerable<object>

@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Net
@using System.Text.RegularExpressions
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = "Kongreler";
    ViewData["BodyClass"] = "page-congresses";

    var conferences = Model?.ToList() ?? new List<object>();

    var registrationsByConference = ViewBag.RegistrationsByConference as Dictionary<Guid, Registration>
        ?? new Dictionary<Guid, Registration>();

    var isSuperAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("SuperAdmin");
    var isAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
    var isAuthor = User.Identity?.IsAuthenticated == true && User.IsInRole("Author");
    var isListener = User.Identity?.IsAuthenticated == true && User.IsInRole("Listener");
    var isReferee = User.Identity?.IsAuthenticated == true && User.IsInRole("Referee");

    var isSystemUser = isSuperAdmin || isAdmin;

    object? GetPropertyValue(object? item, params string[] propertyNames)
    {
        if (item == null)
        {
            return null;
        }

        foreach (var propertyName in propertyNames)
        {
            var property = item.GetType().GetProperty(propertyName);

            if (property == null)
            {
                continue;
            }

            var value = property.GetValue(item);

            if (value != null)
            {
                return value;
            }
        }

        return null;
    }

    object? GetNestedPropertyValue(object? item, string parentName, params string[] propertyNames)
    {
        var parent = GetPropertyValue(item, parentName);

        if (parent == null)
        {
            return null;
        }

        return GetPropertyValue(parent, propertyNames);
    }

    string GetText(object? item, string fallback, params string[] propertyNames)
    {
        var value = GetPropertyValue(item, propertyNames);
        var text = value?.ToString();

        return string.IsNullOrWhiteSpace(text)
            ? fallback
            : text;
    }

    string GetNestedText(object? item, string parentName, string fallback, params string[] propertyNames)
    {
        var value = GetNestedPropertyValue(item, parentName, propertyNames);
        var text = value?.ToString();

        return string.IsNullOrWhiteSpace(text)
            ? fallback
            : text;
    }

    Guid? GetGuid(object? item, params string[] propertyNames)
    {
        var value = GetPropertyValue(item, propertyNames);

        if (value == null)
        {
            return null;
        }

        if (value is Guid guidValue)
        {
            return guidValue;
        }

        if (Guid.TryParse(value.ToString(), out var parsedGuid))
        {
            return parsedGuid;
        }

        return null;
    }

    string CleanHtmlText(string? text, int maxLength = 110)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "";
        }

        var withoutTags = Regex.Replace(text, "<.*?>", " ");
        var decoded = WebUtility.HtmlDecode(withoutTags);
        var cleaned = Regex.Replace(decoded, @"\s+", " ").Trim();

        if (cleaned.Length > maxLength)
        {
            return cleaned.Substring(0, maxLength).Trim() + "...";
        }

        return cleaned;
    }

    DateTime? GetDate(object? item, params string[] propertyNames)
    {
        var value = GetPropertyValue(item, propertyNames);

        if (value == null)
        {
            return null;
        }

        if (value is DateTime date)
        {
            return date;
        }

        if (DateTime.TryParse(value.ToString(), out var parsedDate))
        {
            return parsedDate;
        }

        return null;
    }

    string NormalizeUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "";
        }

        if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/"))
        {
            return path;
        }

        return "/" + path.TrimStart('/');
    }

    string GetSlug(object item)
    {
        var slug = GetText(item, "", "Slug", "ConferenceSlug", "TenantSlug");

        if (string.IsNullOrWhiteSpace(slug))
        {
            slug = GetNestedText(item, "Tenant", "", "Slug", "TenantSlug");
        }

        return slug?.Trim('/') ?? "";
    }

    string GetLogoText(string title, string slug)
    {
        var key = $"{title} {slug}".ToLowerInvariant();

        if (key.Contains("irtad"))
        {
            return "IRTAD";
        }

        if (key.Contains("vet"))
        {
            return "VET LOGO";
        }

        if (key.Contains("tech") || key.Contains("ai") || key.Contains("artificial"))
        {
            return "AI SUMMIT";
        }

        var words = title
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(x => x.Length > 2)
            .Take(2)
            .ToList();

        if (words.Count == 0)
        {
            return "KONGRE";
        }

        if (words.Count == 1)
        {
            return words[0].Length > 8
                ? words[0].Substring(0, 8).ToUpper(new CultureInfo("tr-TR"))
                : words[0].ToUpper(new CultureInfo("tr-TR"));
        }

        return $"{words[0][0]}{words[1][0]}".ToUpper(new CultureInfo("tr-TR"));
    }

    string GetAccentClass(string title, string slug, int index)
    {
        var key = $"{title} {slug}".ToLowerInvariant();

        if (key.Contains("irtad") || key.Contains("turizm"))
        {
            return "accent-green";
        }

        if (key.Contains("vet") || key.Contains("veteriner"))
        {
            return "accent-blue";
        }

        if (key.Contains("tech") || key.Contains("ai") || key.Contains("artificial") || key.Contains("intelligence"))
        {
            return "accent-orange";
        }

        var remainder = index % 3;

        return remainder switch
        {
            0 => "accent-green",
            1 => "accent-blue",
            _ => "accent-orange"
        };
    }

    string GetMonthShort(DateTime? date)
    {
        if (!date.HasValue)
        {
            return "";
        }

        return date.Value
            .ToString("MMM", new CultureInfo("tr-TR"))
            .Replace(".", "")
            .ToUpper(new CultureInfo("tr-TR"));
    }
}

<section class="congresses-page">

    <div class="congress-hero">
        <div class="congress-hero-decoration decoration-one"></div>
        <div class="congress-hero-decoration decoration-two"></div>

        <div class="container">
            <div class="congress-hero-content">

                <div class="hero-pill">
                    <i class="fas fa-calendar-check"></i>
                    @Localizer["HeroPill"]
                </div>

                <h1 class="congress-hero-title">
                    @Localizer["HeroTitle"]
                </h1>

                <p class="congress-hero-description">
                    @Localizer["HeroDescription"]
                </p>

                <div class="congress-search-card">
                    <div class="congress-search-input-wrap">
                        <i class="fas fa-search"></i>

                        <input type="text"
                               id="congressSearchInput"
                               autocomplete="off"
                               placeholder="@Localizer["SearchPlaceholder"]" />
                    </div>

                    <button type="button"
                            id="congressSearchButton"
                            class="congress-search-button">
                        <i class="fas fa-search"></i>
                        @Localizer["SearchButton"]
                    </button>
                </div>

                <div class="congress-filter-chips">
                    <button type="button" class="filter-chip active" data-filter="">
                        <i class="fas fa-border-all"></i>
                        @Localizer["All"]
                    </button>

                    <button type="button" class="filter-chip" data-filter="tıp sağlık medicine health">
                        <i class="fas fa-stethoscope"></i>
                        @Localizer["FilterMedicine"]
                    </button>

                    <button type="button" class="filter-chip" data-filter="veteriner vet">
                        <i class="fas fa-paw"></i>
                        @Localizer["FilterVeterinary"]
                    </button>

                    <button type="button" class="filter-chip" data-filter="teknoloji tech ai artificial intelligence">
                        <i class="fas fa-microchip"></i>
                        @Localizer["FilterTechnology"]
                    </button>

                    <button type="button" class="filter-chip" data-filter="yapay zeka artificial intelligence ai">
                        <i class="fas fa-brain"></i>
                        @Localizer["FilterAI"]
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="congress-list-section">
        <div class="container">

            <div class="congress-list-header">
                <div>
                    <h2>@Localizer["CongressList"]</h2>
                    <p>@Localizer["CongressListDescription"]</p>
                </div>

                <div class="congress-count-badge">
                    <span id="visibleCongressCount">@conferences.Count</span> / @conferences.Count @Localizer["Congresses"]
                </div>
            </div>

            @if (!conferences.Any())
            {
                <div class="empty-congress-box">
                    <div class="empty-congress-icon">
                        <i class="fas fa-calendar-xmark"></i>
                    </div>

                    <h3>@Localizer["NoCongressFound"]</h3>

                    <p>
                        @Localizer["NoCongressDescription"]
                    </p>
                </div>
            }
            else
            {
                <div class="congress-card-grid" id="congressCardGrid">
                    @for (var i = 0; i < conferences.Count; i++)
                    {
                        var item = conferences[i];

                        var conferenceId = GetGuid(item, "Id", "ConferenceId", "CongressId");
                        var isRegistered = conferenceId.HasValue && registrationsByConference.ContainsKey(conferenceId.Value);

                        var title = GetText(item, "Kongre", "Title", "ConferenceTitle", "Name", "CongressName");
                        var slug = GetSlug(item);

                        var tenantName = GetNestedText(item, "Tenant", "", "Name", "TenantName");
                        var city = GetText(item, "", "City", "LocationCity", "CongressCity");
                        var country = GetText(item, "Turkey", "Country", "LocationCountry", "CongressCountry");

                        if (string.IsNullOrWhiteSpace(city))
                        {
                            city = GetText(item, "", "Location", "Address");
                        }

                        var startDate = GetDate(item, "StartDate", "ConferenceStartDate", "CongressStartDate", "BeginDate");
                        var endDate = GetDate(item, "EndDate", "ConferenceEndDate", "CongressEndDate", "FinishDate");

                        var yearText = startDate.HasValue
                        ? startDate.Value.Year.ToString()
                        : DateTime.Now.Year.ToString();

                        var dayText = startDate.HasValue
                        ? startDate.Value.Day.ToString("00")
                        : "--";

                        var monthText = GetMonthShort(startDate);

                        var rawDescription = GetText(
                        item,
                        !string.IsNullOrWhiteSpace(tenantName)
                        ? $"{tenantName} {Localizer.GetString("OrganizedByDesc").Value}"
                        : Localizer.GetString("DefaultDescription").Value,
                        "Description",
                        "ShortDescription",
                        "Summary",
                        "About"
                        );

                        var description = CleanHtmlText(rawDescription, 110);

                        var logoUrl = NormalizeUrl(GetText(item, "", "LogoUrl", "LogoPath", "ImageUrl", "ImagePath", "CoverImageUrl", "CoverImagePath"));
                        var logoText = GetLogoText(title, slug);
                        var accentClass = GetAccentClass(title, slug, i);

                        var siteUrl = !string.IsNullOrWhiteSpace(slug)
                        ? (conferenceId.HasValue ? $"/{slug}?conferenceId={conferenceId.Value}" : $"/{slug}")
                        : "#";

                        var registrationUrl = !string.IsNullOrWhiteSpace(slug)
                        ? $"/{slug}/registration"
                        : "#";

                        var panelUrl = !string.IsNullOrWhiteSpace(slug)
                        ? $"/{slug}/Dashboard"
                        : "/Dashboard/MyConferences";

                        string actionUrl;
                        string actionText;
                        string actionIcon;
                        string actionClass;

                        if (isSystemUser)
                        {
                            actionUrl = siteUrl;
                            actionText = Localizer.GetString("ViewSite").Value;
                            actionIcon = "fas fa-external-link-alt";
                            actionClass = "btn-site-view";
                        }
                        else if (isRegistered)
                        {
                            actionUrl = panelUrl;
                            actionText = "Panelime Git";
                            actionIcon = "fas fa-check-circle";
                            actionClass = "btn-registered-congress";
                        }
                        else
                        {
                            actionUrl = registrationUrl;
                            actionText = Localizer.GetString("Register").Value;
                            actionIcon = "fas fa-paper-plane";
                            actionClass = "btn-register-congress";
                        }

                        var searchText = $"{title} {slug} {tenantName} {city} {country} {description}".ToLowerInvariant();

                        <article class="congress-card @accentClass @(isRegistered ? "registered-card" : "")"
                                 data-search="@searchText">

                            @if (isRegistered && !isSystemUser)
                            {
                                <div class="registered-ribbon">
                                    <i class="fas fa-check-circle"></i>
                                    
                                </div>
                            }

                            <div class="congress-card-media">
                                <div class="congress-logo-box">
                                    @if (!string.IsNullOrWhiteSpace(logoUrl))
                                    {
                                        <img src="@logoUrl"
                                             alt="@title"
                                             class="congress-logo-image" />
                                    }
                                    else
                                    {
                                        <span>@logoText</span>
                                    }
                                </div>

                                <div class="congress-date-badge">
                                    <div class="date-day">@dayText</div>
                                    <div class="date-month">@monthText</div>
                                </div>
                            </div>

                            <div class="congress-card-body">
                                <div class="congress-tag">
                                    #@(string.IsNullOrWhiteSpace(slug) ? "KONGRE" : slug.ToUpper(new CultureInfo("tr-TR")))
                                </div>

                                <h3 class="congress-card-title">
                                    @title
                                </h3>

                                <div class="congress-meta">
                                    @if (!string.IsNullOrWhiteSpace(city))
                                    {
                                        <span>
                                            <i class="fas fa-location-dot"></i>
                                            @city@(string.IsNullOrWhiteSpace(country) ? "" : $", {country}")
                                        </span>
                                    }

                                    <span>
                                        <i class="fas fa-calendar-check"></i>
                                        @yearText
                                    </span>
                                </div>

                                <p class="congress-description">
                                    @description
                                </p>

                                <div class="congress-action-buttons">
                                    @if (!isSystemUser && !isReferee && !isRegistered)
                                    {
                                        <a href="@registrationUrl" class="congress-action-button btn-register-congress">
                                            <span>@Localizer["Register"]</span>
                                            <i class="fas fa-paper-plane"></i>
                                        </a>
                                    }
                                    else if (isRegistered)
                                    {
                                        <a href="@panelUrl" class="congress-action-button btn-registered-congress">
                                            <span>@Localizer["GoToPanel"]</span>
                                            <i class="fas fa-check-circle"></i>
                                        </a>
                                    }
                                    <a href="@siteUrl" class="congress-action-button btn-site-view">
                                        <span>@Localizer["ViewSite"]</span>
                                        <i class="fas fa-external-link-alt"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                <div class="empty-congress-box d-none" id="noCongressResult">
                    <div class="empty-congress-icon">
                        <i class="fas fa-magnifying-glass"></i>
                    </div>

                    <h3></h3>

                    <p>
                        
                    </p>
                </div>
            }

        </div>
    </div>

</section>


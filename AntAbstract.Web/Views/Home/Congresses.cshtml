@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("congressSearchInput");
            const searchButton = document.getElementById("congressSearchButton");
            const congressCards = Array.from(document.querySelectorAll(".congress-card"));
            const noResultBox = document.getElementById("noCongressResult");
            const visibleCongressCount = document.getElementById("visibleCongressCount");
            const filterChips = Array.from(document.querySelectorAll(".filter-chip"));

            let activeFilter = "";

            function normalizeText(value) {
                return (value || "")
                    .toString()
                    .toLocaleLowerCase("tr-TR")
                    .replaceAll("ı", "i")
                    .replaceAll("İ", "i");
            }

            function applyFilters() {
                const searchTerm = searchInput ? normalizeText(searchInput.value.trim()) : "";
                const filterTerm = normalizeText(activeFilter);
                let visibleCount = 0;

                congressCards.forEach(function (card) {
                    const searchText = normalizeText(card.getAttribute("data-search"));

                    const matchesSearch = !searchTerm || searchText.includes(searchTerm);

                    const matchesFilter = !filterTerm || filterTerm
                        .split(" ")
                        .filter(Boolean)
                        .some(function (term) {
                            return searchText.includes(term);
                        });

                    const isVisible = matchesSearch && matchesFilter;

                    card.classList.toggle("d-none", !isVisible);

                    if (isVisible) {
                        visibleCount++;
                    }
                });

                if (visibleCongressCount) {
                    visibleCongressCount.textContent = visibleCount;
                }

                if (noResultBox) {
                    noResultBox.classList.toggle("d-none", visibleCount !== 0);
                }
            }

            if (searchButton) {
                searchButton.addEventListener("click", applyFilters);
            }

            if (searchInput) {
                searchInput.addEventListener("input", applyFilters);

                searchInput.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        applyFilters();
                    }
                });
            }

            filterChips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    filterChips.forEach(function (item) {
                        item.classList.remove("active");
                    });

                    chip.classList.add("active");
                    activeFilter = chip.getAttribute("data-filter") || "";
                    applyFilters();
                });
            });

            applyFilters();
        });
    </script>
}
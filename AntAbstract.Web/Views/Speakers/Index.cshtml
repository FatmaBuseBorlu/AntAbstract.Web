@using AntAbstract.Domain.Entities
@model List<InvitedSpeaker>
@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "";
    var slug = (string?)ViewBag.Slug ?? "";
    var conferenceTitle = (string?)ViewBag.ConferenceTitle ?? "";
}

<style>
    .speakers-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .speakers-hero {
        text-align: center;
        margin-bottom: 3rem;
    }
    .speakers-hero h1 {
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: .5rem;
    }
    .speakers-hero p {
        color: #64748b;
        font-size: 1rem;
    }
    .speaker-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .speaker-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 40px rgba(0,0,0,.1);
    }
    .speaker-photo-wrap {
        position: relative;
        padding-top: 75%;
        background: linear-gradient(135deg, #dbeafe 0%, #ede9fe 100%);
        overflow: hidden;
    }
    .speaker-photo-wrap img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .speaker-photo-initials {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: 800;
        color: #2563eb;
        opacity: .4;
    }
    .speaker-body {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .speaker-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: .15rem;
    }
    .speaker-title {
        font-size: .82rem;
        color: #2563eb;
        font-weight: 600;
        margin-bottom: .25rem;
    }
    .speaker-institution {
        font-size: .82rem;
        color: #64748b;
        margin-bottom: .25rem;
    }
    .speaker-country {
        font-size: .78rem;
        color: #94a3b8;
        margin-bottom: .75rem;
    }
    .speaker-talk {
        background: #f8fafc;
        border-left: 3px solid #2563eb;
        border-radius: 0 8px 8px 0;
        padding: .5rem .75rem;
        font-size: .82rem;
        color: #1e40af;
        font-weight: 600;
        margin-bottom: .75rem;
    }
    .speaker-bio {
        font-size: .82rem;
        color: #64748b;
        line-height: 1.55;
        flex: 1;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
    }
    .speaker-footer {
        padding: .75rem 1.25rem;
        border-top: 1px solid #f1f5f9;
    }
    @@media (max-width: 575px) {
        .speakers-hero h1 { font-size: 1.5rem; }
        .speakers-page { padding: 1.25rem .75rem 3rem; }
        .speaker-photo-wrap { padding-top: 65%; }
    }
</style>

<div class="speakers-page">

    <div class="speakers-hero">
        <h1><i class="fas fa-microphone-alt text-primary me-2"></i></h1>
        <p>@conferenceTitle</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-user-tie fa-3x mb-3 opacity-50"></i>
            <p>Davetli konuşmacı bilgisi henüz yayınlanmadı.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var s in Model)
            {
                var initials = s.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Select(w => w[0]).Take(2).Aggregate("", (a, c) => a + c);

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="speaker-card">
                        <div class="speaker-photo-wrap">
                            @if (!string.IsNullOrWhiteSpace(s.PhotoUrl))
                            {
                                <img src="@s.PhotoUrl" alt="@s.FullName"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                <div class="speaker-photo-initials" style="display:none;">@initials</div>
                            }
                            else
                            {
                                <div class="speaker-photo-initials">@initials</div>
                            }
                        </div>
                        <div class="speaker-body">
                            <div class="speaker-name">@s.FullName</div>
                            @if (!string.IsNullOrWhiteSpace(s.Title))
                            {
                                <div class="speaker-title">@s.Title</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.Institution))
                            {
                                <div class="speaker-institution">
                                    <i class="fas fa-university me-1 opacity-50"></i>@s.Institution
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.Country))
                            {
                                <div class="speaker-country">
                                    <i class="fas fa-map-marker-alt me-1"></i>@s.Country
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.TalkTitle))
                            {
                                <div class="speaker-talk">
                                    <i class="fas fa-comment-dots me-1"></i>@s.TalkTitle
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.Bio))
                            {
                                <div class="speaker-bio">@s.Bio</div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(s.WebsiteUrl))
                        {
                            <div class="speaker-footer">
                                <a href="@s.WebsiteUrl" target="_blank" rel="noopener"
                                   class="btn btn-sm btn-outline-primary w-100">
                                    <i class="fas fa-external-link-alt me-1"></i>Web Sitesi
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

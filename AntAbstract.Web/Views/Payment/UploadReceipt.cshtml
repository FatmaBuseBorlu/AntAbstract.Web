@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var registration = ViewBag.Registration as AntAbstract.Domain.Entities.Registration;
    var slug = ViewBag.Slug as string ?? "";
    ViewData["Title"] = Localizer["UploadReceiptTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container py-5" style="max-width:620px">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:52px;height:52px;background:#f0f4ff">
                    <span style="font-size:24px">🧾</span>
                </div>
                <div>
                    <h5 class="fw-bold mb-0"> </h5>
                    <small class="text-muted">Banka havalesi / EFT dekontu</small>
                </div>
            </div>

            @if (registration != null)
            {
                <div class="alert alert-info border-0 rounded-3 mb-4" style="background:#f0f4ff">
                    <div class="row g-2">
                        <div class="col-6">
                            <small class="text-muted d-block">@Localizer["Kongre"]</small>
                            <strong>@(registration.Conference?.Title ?? "-")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block"></small>
                            <strong>@(registration.RegistrationType?.Name ?? "-")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Tutar</small>
                            <strong class="text-success">@registration.Amount.ToString("N2") @(registration.RegistrationType?.Currency ?? "TRY")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block"></small>
                            <strong>@registration.RegistrationDate.ToString("dd.MM.yyyy")</strong>
                        </div>
                    </div>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger rounded-3">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="UploadReceipt" asp-route-slug="@slug"
                  asp-route-registrationId="@registration?.Id"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label fw-semibold"></label>
                    <div class="border rounded-3 p-4 text-center" style="border-style:dashed!important;cursor:pointer"
                         onclick="document.getElementById('receiptFile').click()">
                        <span style="font-size:32px">📎</span>
                        <p class="mb-1 mt-2 fw-semibold"></p>
                        <small class="text-muted">PDF, PNG veya JPG — Maks. 10 MB</small>
                        <p class="mt-2 mb-0 text-primary small" id="fileNameDisplay"></p>
                    </div>
                    <input type="file" name="receiptFile" id="receiptFile" accept=".pdf,.png,.jpg,.jpeg"
                           class="d-none" onchange="document.getElementById('fileNameDisplay').textContent = this.files[0]?.name ?? ''" />
                </div>

                <div class="alert alert-warning border-0 rounded-3 small">
                    ⚠️ 
                    
                </div>

                <div class="d-flex gap-2 mt-3">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary flex-grow-1"></a>
                    <button type="submit" class="btn btn-primary flex-grow-1 fw-semibold">
                        📤 
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

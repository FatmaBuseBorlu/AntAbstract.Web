@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Http
@using System
@using System.Globalization
@using System.Linq
@model IEnumerable<AntAbstract.Domain.Entities.Payment>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var culture = CultureInfo.CurrentUICulture;
    var isEnglish = culture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    string L(string key, string tr, string en)
    {
        var value = Localizer[key].Value;

        if (string.Equals(value, key, StringComparison.OrdinalIgnoreCase))
        {
            return isEnglish ? en : tr;
        }

        return value;
    }

    string FormatMoney(decimal amount, string? currency)
    {
        currency = string.IsNullOrWhiteSpace(currency)
            ? "TRY"
            : currency;

        if (currency.Equals("TRY", StringComparison.OrdinalIgnoreCase))
        {
            return amount.ToString("C", new CultureInfo("tr-TR"));
        }

        return $"{amount.ToString("N2", culture)} {currency}";
    }

    string BuildConferenceUrl(string cleanPath, string fallbackPath)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return fallbackPath;
        }

        return $"/{slug}{cleanPath}";
    }

    var payments = Model?.ToList() ?? new List<Payment>();

    var totalPaid = payments
        .Where(x => x.Status == PaymentStatus.Completed)
        .Sum(x => x.Amount);

    var totalPending = payments
        .Where(x => x.Status == PaymentStatus.Pending)
        .Sum(x => x.Amount);

    var lastPaymentDate = payments.Any()
        ? payments.Max(x => x.PaymentDate).ToLocalTime().ToString("dd MMM yyyy", culture)
        : "-";

    var conferenceTitle = payments
        .FirstOrDefault(x => x.Conference != null)
        ?.Conference
        ?.Title
        ?? Context.Session.GetString("SelectedConferenceTitle")
        ?? "";

    var newPaymentUrl = BuildConferenceUrl(
        "/payment",
        "/Payment/New"
    );

    var mySubmissionsUrl = BuildConferenceUrl(
        "/my-submissions",
        "/Submission/Index"
    );

    var totalPaidText = FormatMoney(totalPaid, "TRY");
    var totalPendingText = FormatMoney(totalPending, "TRY");
}

<style>
    .payment-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .payment-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 18px;
        border: 1px solid transparent;
        font-weight: 800;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .payment-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .payment-alert-info {
        background: rgba(13, 110, 253, 0.10);
        border-color: rgba(13, 110, 253, 0.20);
        color: #0d6efd;
    }

    .payment-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .payment-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.055);
    }

    .payment-hero-left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-width: 300px;
        flex: 1;
    }

    .payment-hero-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        border-radius: 19px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.20);
    }

    .payment-section-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.3rem;
    }

    .payment-page-title {
        margin: 0 0 0.25rem;
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1.2;
    }

    .payment-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.55;
    }

    .payment-conference-name {
        color: #334155;
        font-weight: 900;
    }

    .payment-slug-badge {
        width: fit-content;
        margin-top: 0.45rem;
        padding: 0.32rem 0.7rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.09);
        color: #0d6efd;
        font-size: 0.74rem;
        font-weight: 900;
    }

    .payment-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .payment-primary-btn,
    .payment-secondary-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1rem;
        text-decoration: none;
        font-size: 0.88rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .payment-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 10px 24px rgba(13, 110, 253, 0.20);
    }

    .payment-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.28);
    }

    .payment-secondary-btn {
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
    }

    .payment-secondary-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .pay-stat-card {
        background: #ffffff;
        border: 1px solid #eef2f6;
        border-radius: 20px;
        padding: 1.35rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.045);
        transition: all 0.2s ease;
        min-height: 108px;
    }

    .pay-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.075);
    }

    .pay-stat-title {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 0.35rem;
    }

    .pay-stat-value {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 900;
        line-height: 1.1;
        margin: 0;
    }

    .pay-stat-value-warning {
        color: #f5b700;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .payment-table-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
    }

    .table-custom thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-weight: 900;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding: 1rem;
        white-space: nowrap;
    }

    .table-custom tbody td {
        padding: 1rem;
        vertical-align: middle;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

    .table-custom tr:hover td {
        background-color: #f8fafc;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .status-completed {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-pending {
        background-color: #fef9c3;
        color: #854d0e;
    }

    .status-failed {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .status-refunded {
        background-color: #e2e8f0;
        color: #475569;
    }

    .payment-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        transition: all 0.2s ease;
    }

    .payment-action-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        background: #f8fbff;
        transform: translateY(-1px);
        text-decoration: none;
    }

    .empty-payment-state {
        padding: 4rem 1rem;
        text-align: center;
    }

    .empty-payment-icon {
        color: #94a3b8;
        opacity: 0.35;
        margin-bottom: 1rem;
    }

    .empty-payment-title {
        color: #0f172a;
        font-size: 1.2rem;
        font-weight: 900;
        margin-bottom: 0.35rem;
    }

    .empty-payment-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        margin: 0 auto 1.25rem;
        max-width: 520px;
    }

    @@media (max-width: 992px) {
        .payment-hero-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .payment-hero-left {
            min-width: 100%;
        }

        .payment-hero-actions,
        .payment-hero-actions .btn,
        .payment-hero-actions a {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .payment-hero-left {
            align-items: flex-start;
            flex-direction: column;
        }

        .payment-page-title {
            font-size: 1.45rem;
        }

        .pay-stat-card {
            align-items: flex-start;
            gap: 1rem;
        }

        .pay-stat-value {
            font-size: 1.35rem;
        }
    }
</style>

<div class="container-fluid px-0 payment-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert payment-alert payment-alert-success mb-4">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert payment-alert payment-alert-info mb-4">
            <i class="fas fa-circle-info"></i>
            <span>@TempData["InfoMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert payment-alert payment-alert-error mb-4">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="payment-hero-card mb-4">
        <div class="payment-hero-left">
            <div class="payment-hero-icon">
                <i class="fas fa-credit-card"></i>
            </div>

            <div>
                <div class="payment-section-label">
                    @L("SectionLabel", "Kongre Ödeme İşlemleri", "Congress Payment Operations")
                </div>

                <h2 class="payment-page-title">
                    @Localizer["PageHeading"]
                </h2>

                <p class="payment-page-description">
                    @if (!string.IsNullOrWhiteSpace(conferenceTitle))
                    {
                        <span class="payment-conference-name">@conferenceTitle</span>
                        <text> @L("ConferencePaymentDescriptionSuffix", "kongresine ait ödeme kayıtlarınızı buradan takip edebilirsiniz.", "payment records can be tracked here.")</text>
                    }
                    else
                    {
                        @Localizer["PageDescription"]
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(slug))
                {
                    <div class="payment-slug-badge">
                        /@slug
                    </div>
                }
            </div>
        </div>

        <div class="payment-hero-actions">
            <a href="@mySubmissionsUrl" class="payment-secondary-btn">
                <i class="fas fa-file-lines me-2"></i>
                @L("MySubmissionsButton", "Bildirilerim", "My Abstracts")
            </a>

            <a href="@newPaymentUrl" class="payment-primary-btn">
                <i class="fas fa-plus-circle me-2"></i>
                @Localizer["NewPaymentButton"]
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="pay-stat-card">
                <div>
                    <p class="pay-stat-title">
                        @Localizer["TotalPaidTitle"]
                    </p>

                    <h3 class="pay-stat-value">
                        @totalPaidText
                    </h3>
                </div>

                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pay-stat-card">
                <div>
                    <p class="pay-stat-title">
                        @Localizer["PendingTransactionTitle"]
                    </p>

                    <h3 class="pay-stat-value pay-stat-value-warning">
                        @totalPendingText
                    </h3>
                </div>

                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-hourglass-half"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="pay-stat-card">
                <div>
                    <p class="pay-stat-title">
                        @Localizer["LastTransactionDateTitle"]
                    </p>

                    <h5 class="fw-bold text-dark mb-0">
                        @lastPaymentDate
                    </h5>
                </div>

                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-calendar-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="payment-table-card">
        <div class="table-responsive">
            <table class="table table-custom mb-0 w-100">
                <thead>
                    <tr>
                        <th>@Localizer["TransactionIdColumn"]</th>
                        <th>@Localizer["ServiceConferenceColumn"]</th>
                        <th>@Localizer["BillingInfoColumn"]</th>
                        <th>@Localizer["DateColumn"]</th>
                        <th>@Localizer["AmountColumn"]</th>
                        <th>@Localizer["MethodColumn"]</th>
                        <th>@Localizer["StatusColumn"]</th>
                        <th class="text-end">@Localizer["ActionsColumn"]</th>
                    </tr>
                </thead>

                <tbody>
                    @if (payments.Any())
                    {
                        foreach (var item in payments)
                        {
                            var itemConferenceTitle = item.Conference?.Title
                                ?? Localizer["GeneralPaymentText"].Value;

                            var itemCurrency = string.IsNullOrWhiteSpace(item.Currency)
                                ? "TRY"
                                : item.Currency;

                            var itemAmountText = FormatMoney(item.Amount, itemCurrency);

                            var itemTransactionText = !string.IsNullOrWhiteSpace(item.TransactionId)
                                ? item.TransactionId
                                : item.Id.ToString().Substring(0, 8).ToUpper();

                            var billingName = !string.IsNullOrWhiteSpace(item.BillingName)
                                ? item.BillingName
                                : $"{item.AppUser?.FirstName} {item.AppUser?.LastName}".Trim();

                            if (string.IsNullOrWhiteSpace(billingName))
                            {
                                billingName = L("BillingNameNotFound", "Fatura bilgisi yok", "No billing information");
                            }

                            var receiptUrl = BuildConferenceUrl(
                                $"/payment/success?id={item.Id}",
                                $"/Payment/Success?id={item.Id}"
                            );

                            var retryUrl = item.RelatedSubmissionId.HasValue
                                ? BuildConferenceUrl(
                                    $"/payment/checkout/{item.RelatedSubmissionId.Value}",
                                    $"/Payment/Index/{item.RelatedSubmissionId.Value}"
                                )
                                : newPaymentUrl;

                            <tr>
                                <td class="text-muted small">
                                    #@itemTransactionText
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light p-2 rounded-3 me-3 text-primary">
                                            <i class="fas fa-ticket-alt"></i>
                                        </div>

                                        <div>
                                            <div class="fw-bold text-dark">
                                                @itemConferenceTitle
                                            </div>

                                            @if (item.RelatedSubmissionId.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @Localizer["SubmissionIdLabel"]
                                                    @item.RelatedSubmissionId.Value.ToString().Substring(0, 6)...
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold d-block text-dark">
                                        @billingName
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(item.TaxNumber))
                                    {
                                        <small class="text-muted" style="font-size: 0.7rem;">
                                            @Localizer["TaxNumberShortLabel"] @item.TaxNumber
                                        </small>
                                    }
                                </td>

                                <td>
                                    @item.PaymentDate.ToLocalTime().ToString("dd MMM yyyy", culture)
                                    <br />
                                    <small class="text-muted">
                                        @item.PaymentDate.ToLocalTime().ToString("HH:mm", culture)
                                    </small>
                                </td>

                                <td class="fw-bold text-dark">
                                    @itemAmountText
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrWhiteSpace(item.PaymentMethod)
                                            ? L("UnknownPaymentMethod", "Belirtilmedi", "Not specified")
                                            : item.PaymentMethod)
                                    </span>
                                </td>

                                <td>
                                    @switch (item.Status)
                                    {
                                        case PaymentStatus.Completed:
                                            <span class="badge-status status-completed">
                                                <i class="fas fa-check-circle"></i>
                                                @Localizer["StatusCompleted"]
                                            </span>
                                            break;

                                        case PaymentStatus.Pending:
                                            <span class="badge-status status-pending">
                                                <i class="fas fa-clock"></i>
                                                @Localizer["StatusPending"]
                                            </span>
                                            break;

                                        case PaymentStatus.Failed:
                                            <span class="badge-status status-failed">
                                                <i class="fas fa-times-circle"></i>
                                                @Localizer["StatusFailed"]
                                            </span>
                                            break;

                                        case PaymentStatus.Refunded:
                                            <span class="badge-status status-refunded">
                                                <i class="fas fa-undo"></i>
                                                @Localizer["StatusRefunded"]
                                            </span>
                                            break;

                                        default:
                                            <span class="badge-status status-refunded">
                                                <i class="fas fa-circle-info"></i>
                                                @item.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="text-end">
                                    @if (item.Status == PaymentStatus.Completed)
                                    {
                                        <a href="@receiptUrl"
                                           class="payment-action-btn"
                                           title="@Localizer["ViewReceiptTitle"]">
                                            <i class="fas fa-file-invoice"></i>
                                        </a>
                                    }
                                    else if (item.Status == PaymentStatus.Failed || item.Status == PaymentStatus.Pending)
                                    {
                                        <a href="@retryUrl"
                                           class="payment-action-btn"
                                           title="@Localizer["RetryTitle"]">
                                            <i class="fas fa-redo"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-payment-state">
                                    <div class="empty-payment-icon">
                                        <i class="fas fa-receipt fa-3x"></i>
                                    </div>

                                    <h5 class="empty-payment-title">
                                        @Localizer["EmptyStateTitle"]
                                    </h5>

                                    <p class="empty-payment-text">
                                        @Localizer["EmptyStateText"]
                                    </p>

                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <a href="@mySubmissionsUrl" class="payment-secondary-btn">
                                            <i class="fas fa-file-lines me-2"></i>
                                            @L("MySubmissionsButton", "Bildirilerim", "My Abstracts")
                                        </a>

                                        <a href="@newPaymentUrl" class="payment-primary-btn">
                                            <i class="fas fa-plus-circle me-2"></i>
                                            @Localizer["NewPaymentButton"]
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Http
@using System
@using System.Globalization
@using System.Linq

@model IEnumerable<AntAbstract.Domain.Entities.Payment>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var culture = CultureInfo.CurrentUICulture;
    var isEnglish = culture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string L(string key, string tr, string en)
    {
        var value = Localizer[key].Value;

        if (string.Equals(value, key, StringComparison.OrdinalIgnoreCase))
        {
            return isEnglish ? en : tr;
        }

        return value;
    }

    ViewData["Title"] = L("PageTitle", "Ödeme Geçmişi", "Payment History");
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    string FormatMoney(decimal amount, string? currency)
    {
        currency = string.IsNullOrWhiteSpace(currency)
            ? "TRY"
            : currency;

        if (currency.Equals("TRY", StringComparison.OrdinalIgnoreCase))
        {
            return amount.ToString("C", new CultureInfo("tr-TR"));
        }

        return $"{amount.ToString("N2", culture)} {currency}";
    }

    string BuildConferenceUrl(string cleanPath, string fallbackPath)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return fallbackPath;
        }

        return $"/{slug}{cleanPath}";
    }

    var payments = Model?.ToList() ?? new List<Payment>();

    var totalPaid = payments
        .Where(x => x.Status == PaymentStatus.Completed)
        .Sum(x => x.Amount);

    var totalPending = payments
        .Where(x => x.Status == PaymentStatus.Pending)
        .Sum(x => x.Amount);

    var lastPaymentDate = payments.Any()
        ? payments.Max(x => x.PaymentDate).ToLocalTime().ToString("dd MMM yyyy", culture)
        : "-";

    var conferenceTitle = payments
        .FirstOrDefault(x => x.Conference != null)
        ?.Conference
        ?.Title
        ?? Context.Session.GetString("SelectedConferenceTitle")
        ?? "";

    var newPaymentUrl = BuildConferenceUrl(
        "/payment",
        "/Payment/New"
    );

    var mySubmissionsUrl = BuildConferenceUrl(
        "/my-submissions",
        "/Submission/Index"
    );

    var totalPaidText = FormatMoney(totalPaid, "TRY");
    var totalPendingText = FormatMoney(totalPending, "TRY");
}

<style>
    .payment-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .payment-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 18px;
        border: 1px solid transparent;
        font-weight: 800;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .payment-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .payment-alert-info {
        background: rgba(13, 110, 253, 0.10);
        border-color: rgba(13, 110, 253, 0.20);
        color: #0d6efd;
    }

    .payment-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .program-lead strong {
        color: #334155;
        font-weight: 900;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .payment-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .payment-primary-btn,
    .payment-secondary-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1rem;
        text-decoration: none;
        font-size: 0.88rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .payment-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 10px 24px rgba(13, 110, 253, 0.20);
    }

    .payment-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.28);
    }

    .payment-secondary-btn {
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
    }

    .payment-secondary-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .payment-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .pay-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.85rem;
    }

    .pay-stat-title {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-bottom: 0.35rem;
    }

    .pay-stat-value {
        color: #0f172a;
        font-size: 1.3rem;
        font-weight: 900;
        line-height: 1.1;
        margin: 0;
    }

    .pay-stat-value-warning {
        color: #f5b700;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .payment-table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
    }

    .table-custom thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-weight: 900;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding: 1rem;
        white-space: nowrap;
    }

    .table-custom tbody td {
        padding: 1rem;
        vertical-align: middle;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }

    .table-custom tr:hover td {
        background-color: #f8fafc;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .status-completed {
        background-color: #dcfce7;
        color: #166534;
    }

    .status-pending {
        background-color: #fef9c3;
        color: #854d0e;
    }

    .status-failed {
        background-color: #fee2e2;
        color: #991b1b;
    }

    .status-refunded {
        background-color: #e2e8f0;
        color: #475569;
    }

    .payment-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        transition: all 0.2s ease;
    }

    .payment-action-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        background: #f8fbff;
        transform: translateY(-1px);
        text-decoration: none;
    }

    .empty-payment-state {
        padding: 4rem 1rem;
        text-align: center;
    }

    .empty-payment-icon {
        color: #94a3b8;
        opacity: 0.35;
        margin-bottom: 1rem;
    }

    .empty-payment-title {
        color: #0f172a;
        font-size: 1.2rem;
        font-weight: 900;
        margin-bottom: 0.35rem;
    }

    .empty-payment-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        margin: 0 auto 1.25rem;
        max-width: 520px;
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }

        .payment-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .payment-primary-btn,
        .payment-secondary-btn {
            width: 100%;
        }

        .payment-stats {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .payment-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-title {
            font-size: 1.45rem;
        }
    }
</style>

<div class="payment-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert payment-alert payment-alert-success mb-4">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert payment-alert payment-alert-info mb-4">
            <i class="fas fa-circle-info"></i>
            <span>@TempData["InfoMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert payment-alert payment-alert-error mb-4">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-credit-card"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("PageHeading", "Ödeme Geçmişi", "Payment History")
                </h3>

                <p class="program-lead">
                    @if (!string.IsNullOrWhiteSpace(conferenceTitle))
                    {
                        <strong>@conferenceTitle</strong>
                        <text> @L("ConferencePaymentDescriptionSuffix", "kongresine ait ödeme kayıtlarınızı buradan takip edebilirsiniz.", "payment records can be tracked here.")</text>
                    }
                    else
                    {
                        @L("PageDescription", "Seçili kongreye ait ödeme kayıtlarınızı buradan takip edebilirsiniz.", "You can track your payment records for the selected congress here.")
                    }
                </p>
            </div>
        </div>

        <div class="payment-hero-actions">
            @if (!string.IsNullOrWhiteSpace(conferenceTitle))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-calendar-check"></i>
                    <span>@conferenceTitle</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(slug))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-link"></i>
                    <span>/@slug</span>
                </div>
            }

            <a href="@mySubmissionsUrl" class="payment-secondary-btn">
                <i class="fas fa-file-lines me-2"></i>
                @L("MySubmissionsButton", "Bildirilerim", "My Abstracts")
            </a>

            <a href="@newPaymentUrl" class="payment-primary-btn">
                <i class="fas fa-plus-circle me-2"></i>
                @L("NewPaymentButton", "Yeni Ödeme", "New Payment")
            </a>
        </div>
    </div>

    <div class="payment-stats">
        <div class="pay-stat-card">
            <div>
                <div class="pay-stat-title">
                    @L("TotalPaidTitle", "Toplam Ödenen", "Total Paid")
                </div>

                <h3 class="pay-stat-value">
                    @totalPaidText
                </h3>
            </div>

            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="fas fa-wallet"></i>
            </div>
        </div>

        <div class="pay-stat-card">
            <div>
                <div class="pay-stat-title">
                    @L("PendingTransactionTitle", "Bekleyen İşlem", "Pending Transaction")
                </div>

                <h3 class="pay-stat-value pay-stat-value-warning">
                    @totalPendingText
                </h3>
            </div>

            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="fas fa-hourglass-half"></i>
            </div>
        </div>

        <div class="pay-stat-card">
            <div>
                <div class="pay-stat-title">
                    @L("LastTransactionDateTitle", "Son İşlem Tarihi", "Last Transaction Date")
                </div>

                <h3 class="pay-stat-value">
                    @lastPaymentDate
                </h3>
            </div>

            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="fas fa-calendar-check"></i>
            </div>
        </div>
    </div>

    <div class="payment-table-card">
        <div class="table-responsive">
            <table class="table table-custom mb-0 w-100">
                <thead>
                    <tr>
                        <th>@L("TransactionIdColumn", "İşlem ID", "Transaction ID")</th>
                        <th>@L("ServiceConferenceColumn", "Hizmet / Kongre", "Service / Congress")</th>
                        <th>@L("BillingInfoColumn", "Fatura Bilgisi", "Billing Info")</th>
                        <th>@L("DateColumn", "Tarih", "Date")</th>
                        <th>@L("AmountColumn", "Tutar", "Amount")</th>
                        <th>@L("MethodColumn", "Yöntem", "Method")</th>
                        <th>@L("StatusColumn", "Durum", "Status")</th>
                        <th class="text-end">@L("ActionsColumn", "İşlemler", "Actions")</th>
                    </tr>
                </thead>

                <tbody>
                    @if (payments.Any())
                    {
                        foreach (var item in payments)
                        {
                            var itemConferenceTitle = item.Conference?.Title
                                ?? L("GeneralPaymentText", "Genel ödeme", "General payment");

                            var itemCurrency = string.IsNullOrWhiteSpace(item.Currency)
                                ? "TRY"
                                : item.Currency;

                            var itemAmountText = FormatMoney(item.Amount, itemCurrency);

                            var itemTransactionText = !string.IsNullOrWhiteSpace(item.TransactionId)
                                ? item.TransactionId
                                : item.Id.ToString().Substring(0, 8).ToUpper();

                            var billingName = !string.IsNullOrWhiteSpace(item.BillingName)
                                ? item.BillingName
                                : $"{item.AppUser?.FirstName} {item.AppUser?.LastName}".Trim();

                            if (string.IsNullOrWhiteSpace(billingName))
                            {
                                billingName = L("BillingNameNotFound", "Fatura bilgisi yok", "No billing information");
                            }

                            var receiptUrl = BuildConferenceUrl(
                                $"/payment/success?id={item.Id}",
                                $"/Payment/Success?id={item.Id}"
                            );

                            var retryUrl = item.RelatedSubmissionId.HasValue
                                ? BuildConferenceUrl(
                                    $"/payment/checkout/{item.RelatedSubmissionId.Value}",
                                    $"/Payment/Index/{item.RelatedSubmissionId.Value}"
                                )
                                : newPaymentUrl;

                            <tr>
                                <td class="text-muted small">
                                    #@itemTransactionText
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light p-2 rounded-3 me-3 text-primary">
                                            <i class="fas fa-ticket-alt"></i>
                                        </div>

                                        <div>
                                            <div class="fw-bold text-dark">
                                                @itemConferenceTitle
                                            </div>

                                            @if (item.RelatedSubmissionId.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @L("SubmissionIdLabel", "Bildiri ID:", "Submission ID:")
                                                    @item.RelatedSubmissionId.Value.ToString().Substring(0, 6)...
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold d-block text-dark">
                                        @billingName
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(item.TaxNumber))
                                    {
                                        <small class="text-muted" style="font-size: 0.7rem;">
                                            @L("TaxNumberShortLabel", "VN:", "Tax No:")
                                            @item.TaxNumber
                                        </small>
                                    }
                                </td>

                                <td>
                                    @item.PaymentDate.ToLocalTime().ToString("dd MMM yyyy", culture)
                                    <br />
                                    <small class="text-muted">
                                        @item.PaymentDate.ToLocalTime().ToString("HH:mm", culture)
                                    </small>
                                </td>

                                <td class="fw-bold text-dark">
                                    @itemAmountText
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrWhiteSpace(item.PaymentMethod)
                                            ? L("UnknownPaymentMethod", "Belirtilmedi", "Not specified")
                                            : item.PaymentMethod)
                                    </span>
                                </td>

                                <td>
                                    @switch (item.Status)
                                    {
                                        case PaymentStatus.Completed:
                                            <span class="badge-status status-completed">
                                                <i class="fas fa-check-circle"></i>
                                                @L("StatusCompleted", "Başarılı", "Completed")
                                            </span>
                                            break;

                                        case PaymentStatus.Pending:
                                            <span class="badge-status status-pending">
                                                <i class="fas fa-clock"></i>
                                                @L("StatusPending", "Bekliyor", "Pending")
                                            </span>
                                            break;

                                        case PaymentStatus.Failed:
                                            <span class="badge-status status-failed">
                                                <i class="fas fa-times-circle"></i>
                                                @L("StatusFailed", "Başarısız", "Failed")
                                            </span>
                                            break;

                                        case PaymentStatus.Refunded:
                                            <span class="badge-status status-refunded">
                                                <i class="fas fa-undo"></i>
                                                @L("StatusRefunded", "İade Edildi", "Refunded")
                                            </span>
                                            break;

                                        default:
                                            <span class="badge-status status-refunded">
                                                <i class="fas fa-circle-info"></i>
                                                @item.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="text-end">
                                    @if (item.Status == PaymentStatus.Completed)
                                    {
                                        <a href="@receiptUrl"
                                           class="payment-action-btn"
                                           title="@L("ViewReceiptTitle", "Makbuzu görüntüle", "View receipt")">
                                            <i class="fas fa-file-invoice"></i>
                                        </a>
                                    }
                                    else if (item.Status == PaymentStatus.Failed || item.Status == PaymentStatus.Pending)
                                    {
                                        <a href="@retryUrl"
                                           class="payment-action-btn"
                                           title="@L("RetryTitle", "Tekrar dene", "Retry")">
                                            <i class="fas fa-redo"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-payment-state">
                                    <div class="empty-payment-icon">
                                        <i class="fas fa-receipt fa-3x"></i>
                                    </div>

                                    <h5 class="empty-payment-title">
                                        @L("EmptyStateTitle", "Henüz ödeme kaydınız bulunmuyor.", "You do not have any payment records yet.")
                                    </h5>

                                    <p class="empty-payment-text">
                                        @L("EmptyStateText", "Ödeme işlemi yaptığınızda kayıtlarınız burada listelenecektir.", "Your payment records will be listed here after you make a payment.")
                                    </p>

                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <a href="@mySubmissionsUrl" class="payment-secondary-btn">
                                            <i class="fas fa-file-lines me-2"></i>
                                            @L("MySubmissionsButton", "Bildirilerim", "My Abstracts")
                                        </a>

                                        <a href="@newPaymentUrl" class="payment-primary-btn">
                                            <i class="fas fa-plus-circle me-2"></i>
                                            @L("NewPaymentButton", "Yeni Ödeme", "New Payment")
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
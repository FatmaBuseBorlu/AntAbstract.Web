@model AntAbstract.Domain.Entities.Payment
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">

            <div class="card border-0 shadow-lg p-4 rounded-4 position-relative overflow-hidden">
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at top, rgba(220, 252, 231, 0.4) 0%, rgba(255,255,255,0) 60%); pointer-events: none;"></div>

                <div class="position-relative">
                    <div class="mb-4 animate__animated animate__bounceIn">
                        <div style="width: 80px; height: 80px; background-color: #dcfce7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto; box-shadow: 0 10px 20px rgba(22, 101, 52, 0.1);">
                            <i class="fas fa-check fa-3x text-success"></i>
                        </div>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">@Localizer["SuccessHeading"]</h2>
                    <p class="text-muted mb-4">
                        @Localizer["SuccessDescription"]
                    </p>

                    @if (Model != null)
                    {
                        <div class="bg-light rounded-3 p-4 mb-4 text-start border border-dashed" style="border-style: dashed !important; border-color: #cbd5e1 !important;">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">@Localizer["ReferenceNoLabel"]</span>
                                <span class="fw-bold text-dark small">#@Model.TransactionId</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">@Localizer["DateLabel"]</span>
                                <span class="fw-bold text-dark small">@Model.PaymentDate.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">@Localizer["PaymentMethodLabel"]</span>
                                <span class="fw-bold text-dark small">
                                    <i class="fas fa-credit-card me-1"></i> @Localizer["CreditCardText"]
                                </span>
                            </div>
                            <hr class="my-3" style="opacity: 0.1;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted fw-bold">@Localizer["TotalAmountLabel"]</span>
                                <span class="fs-4 fw-bold text-primary">@Model.Amount.ToString("N2") @Model.Currency</span>
                            </div>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <a href="/Dashboard" class="btn btn-primary py-3 fw-bold rounded-pill shadow-sm" style="background-color: #00aeef; border:none;">
                            <i class="fas fa-home me-2"></i> @Localizer["BackToDashboardButton"]
                        </a>

                        <div class="d-flex gap-2">
                            <a href="/Payment/My" class="btn btn-light w-100 py-2 border fw-bold text-muted">
                                <i class="fas fa-list me-2"></i> @Localizer["HistoryButton"]
                            </a>
                            <button onclick="window.print()" class="btn btn-light w-100 py-2 border fw-bold text-muted">
                                <i class="fas fa-print me-2"></i> @Localizer["PrintButton"]
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <p class="mt-4 small text-muted">
                @Localizer["SupportText_Part1"]
                <a href="#" class="text-decoration-none fw-bold" style="color: #00aeef;">@Localizer["SupportTeamLinkText"]</a>
                @Localizer["SupportText_Part2"]
            </p>

        </div>
    </div>
</div>
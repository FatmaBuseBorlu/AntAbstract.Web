@model AntAbstract.Domain.Entities.Payment

@{
    ViewData["Title"] = "Güvenli Ödeme";
    Layout = "_LayoutDashboard";
}

<style>
   
    .credit-card-box {
        background: linear-gradient(135deg, #0f172a 0%, #334155 100%);
        border-radius: 16px;
        color: #fff;
        padding: 25px;
        position: relative;
        overflow: hidden;
        height: 220px;
        box-shadow: 0 20px 50px -12px rgba(15, 23, 42, 0.5);
    }

    .card-chip {
        width: 50px;
        height: 35px;
        background: #fbbf24;
        border-radius: 6px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

        .card-chip::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: rgba(0,0,0,0.2);
        }

    .form-floating > .form-control {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

        .form-floating > .form-control:focus {
            border-color: #00aeef;
            box-shadow: 0 0 0 4px rgba(0,174,239,0.1);
        }

    .summary-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 0.95rem;
    }

    .total-row {
        border-top: 2px dashed #e2e8f0;
        padding-top: 15px;
        margin-top: 15px;
    }
</style>

<div class="container-fluid px-0">

    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">Ödeme İşlemi</h3>
        <p class="text-muted">Lütfen ödeme bilgilerinizi güvenli bir şekilde giriniz.</p>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <form asp-action="ProcessPayment" method="post" id="paymentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ConferenceId" />
                    <input type="hidden" asp-for="RelatedSubmissionId" />

                    <h5 class="fw-bold text-dark mb-4"><i class="far fa-address-card me-2 text-primary"></i> Fatura Bilgileri</h5>
                    <div class="row g-3 mb-5">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="BillingName" class="form-control" placeholder="Ad Soyad" required />
                                <label>Ad Soyad / Firma Ünvanı</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="TaxNumber" class="form-control" placeholder="Vergi No" />
                                <label>TCKN / Vergi No (Opsiyonel)</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea asp-for="BillingAddress" class="form-control" placeholder="Adres" style="height: 80px" required></textarea>
                                <label>Fatura Adresi</label>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-4"><i class="far fa-credit-card me-2 text-primary"></i> Kart Bilgileri</h5>

                    <div class="row g-4">
                        <div class="col-md-5 d-none d-md-block">
                            <div class="credit-card-box d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="card-chip"></div>
                                    <i class="fab fa-cc-visa fa-2x opacity-50"></i>
                                </div>
                                <div>
                                    <div class="fs-5" style="letter-spacing: 2px; font-family: monospace;">**** **** **** ****</div>
                                </div>
                                <div class="d-flex justify-content-between small opacity-75">
                                    <span>KART SAHİBİ</span>
                                    <span>AA/YY</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="cc-name" placeholder="Kart Üzerindeki İsim" required />
                                <label>Kart Üzerindeki İsim</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="cc-number" placeholder="Kart Numarası" maxlength="19" required />
                                <label>Kart Numarası</label>
                            </div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="cc-expiry" placeholder="MM/YY" maxlength="5" required />
                                        <label>Son Kul. (AA/YY)</label>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" id="cc-cvc" placeholder="CVC" maxlength="3" required />
                                        <label>CVC / CVV</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5">
                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm" style="font-size: 1.1rem;">
                            <i class="fas fa-lock me-2"></i> @Model.Amount.ToString("N2") @Model.Currency Öde
                        </button>
                        <p class="text-center text-muted small mt-3">
                            <i class="fas fa-shield-alt text-success me-1"></i> Ödemeniz 256-bit SSL ile şifrelenmektedir.
                        </p>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                <h6 class="fw-bold text-dark mb-3">Sipariş Özeti</h6>

                <div class="d-flex align-items-center mb-3">
                    <div class="bg-white p-2 rounded border me-3">
                        <i class="fas fa-ticket-alt text-primary fa-lg"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">@Model.Conference?.Title</div>
                        <small class="text-muted">Kongre Kaydı</small>
                    </div>
                </div>

                <div class="summary-item">
                    <span class="text-muted">Hizmet Bedeli</span>
                    <span class="fw-bold text-dark">@Model.Amount.ToString("N2") @Model.Currency</span>
                </div>
                <div class="summary-item">
                    <span class="text-muted">KDV (%20)</span>
                    <span class="fw-bold text-dark">Dahil</span>
                </div>
                <div class="summary-item total-row align-items-center">
                    <span class="fw-bold text-dark fs-5">TOPLAM</span>
                    <span class="fw-bold text-primary fs-4">@Model.Amount.ToString("N2") @Model.Currency</span>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mt-3">
                <h6 class="fw-bold text-dark mb-2"><i class="fas fa-university me-2"></i>Havale ile Ödeme</h6>
                <p class="small text-muted mb-2">Kart kullanmak istemiyorsanız havale yapabilirsiniz.</p>
                <div class="bg-white p-2 rounded border small font-monospace text-muted">
                    TR12 0006 1000 0000 0012 3456 78
                </div>
            </div>
        </div>

    </div>
</div>
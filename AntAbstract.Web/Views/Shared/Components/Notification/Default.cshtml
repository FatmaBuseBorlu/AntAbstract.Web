@model List<AntAbstract.Domain.Entities.Notification>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var unreadNotifications = Model?
        .Where(x => !x.IsRead)
        .OrderByDescending(x => x.CreatedDate)
        .ToList() ?? new List<AntAbstract.Domain.Entities.Notification>();

    int unreadCount = unreadNotifications.Count;
}

<style>
    .badge-dot {
        position: absolute;
        top: 5px;
        right: 5px;
        width: 10px;
        height: 10px;
        background-color: #ef4444;
        border: 2px solid #fff;
        border-radius: 50%;
    }

    .badge-pulse {
        animation: pulse-red 2s infinite;
    }

    @@keyframes pulse-red {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
    }

    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 16px;
        text-decoration: none;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.2s, color 0.2s;
    }

        .notif-item:hover {
            background-color: #f8fafc;
            color: #00aeef;
        }

        .notif-item.unread {
            background-color: #f0f9ff;
        }

    .notif-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .notif-content {
        min-width: 0;
    }

        .notif-content p {
            margin: 0;
            font-size: 0.85rem;
            line-height: 1.4;
        }

    .notif-time {
        font-size: 0.7rem;
        color: #94a3b8;
        margin-top: 4px;
        display: block;
    }

    .notif-empty-state {
        text-align: center;
        padding: 42px 18px;
        color: #64748b;
    }

        .notif-empty-state i {
            font-size: 2rem;
            color: #cbd5e1;
            margin-bottom: 12px;
        }

        .notif-empty-state p {
            margin: 0;
            font-size: 0.85rem;
            font-weight: 700;
        }

    .notif-view-all {
        display: block;
        width: 100%;
        padding: 12px 14px;
        text-align: center;
        background: #f8fafc;
        color: #64748b;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 800;
        border-top: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }

        .notif-view-all:hover {
            background: #eef6ff;
            color: #0d6efd;
        }
</style>

<div class="dropdown">
    @Html.AntiForgeryToken()

    <a href="#"
       class="header-icon-btn position-relative"
       data-bs-toggle="dropdown"
       aria-expanded="false"
       id="notifDropdownBtn">
        <i class="far fa-bell fa-lg"></i>

        @if (unreadCount > 0)
        {
            <span class="badge-dot badge-pulse" id="notifBadge"></span>
        }
    </a>

    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-3 rounded-4 p-0 overflow-hidden"
        aria-labelledby="notifDropdownBtn"
        style="width: 340px;">

        <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
            <h6 class="fw-bold mb-0 text-dark">
                Bildirimler
            </h6>

            @if (unreadCount > 0)
            {
                <button type="button"
                        onclick="markAllRead()"
                        id="markAllReadBtn"
                        class="btn btn-link btn-sm p-0 text-decoration-none text-primary fw-bold"
                        style="font-size: 0.78rem;">
                    Tümünü Okundu Yap
                </button>
            }
        </li>

        <div id="notificationList" style="max-height: 350px; overflow-y: auto;">
            @if (unreadNotifications.Any())
            {
                foreach (var item in unreadNotifications)
                {
                    var link = string.IsNullOrWhiteSpace(item.Link)
                    ? "#"
                    : item.Link;

                    var icon = string.IsNullOrWhiteSpace(item.Icon)
                    ? "fas fa-info-circle"
                    : item.Icon;

                    var color = string.IsNullOrWhiteSpace(item.Color)
                    ? "primary"
                    : item.Color;

                    <a href="@link"
                       onclick="markRead('@item.Id', this)"
                       class="notif-item unread">

                        <div class="notif-icon bg-@color bg-opacity-10 text-@color">
                            <i class="@icon"></i>
                        </div>

                        <div class="notif-content">
                            <p>
                                <strong>@item.Title</strong>
                                <br />
                                <span class="text-muted">@item.Message</span>
                            </p>

                            <span class="notif-time">
                                @item.CreatedDate.ToString("dd MMM HH:mm")
                            </span>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="notif-empty-state" id="notificationEmptyState">
                    <i class="far fa-bell-slash"></i>
                    <p>Okunmamış bildiriminiz yok.</p>
                </div>
            }
        </div>

        <li>
            <a href="/Notification/Index" class="notif-view-all">
                Tümünü Gör
            </a>
        </li>
    </ul>
</div>

<script>
    function getAntiForgeryToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : "";
    }

    function updateNotificationBadgeVisibility() {
        const unreadItems = document.querySelectorAll('.notif-item.unread');
        const badge = document.getElementById('notifBadge');
        const markAllReadBtn = document.getElementById('markAllReadBtn');

        if (unreadItems.length === 0) {
            if (badge) {
                badge.style.display = 'none';
            }

            if (markAllReadBtn) {
                markAllReadBtn.style.display = 'none';
            }

            showEmptyNotificationState();
        }
    }

    function showEmptyNotificationState() {
        const notificationList = document.getElementById('notificationList');

        if (!notificationList) {
            return;
        }

        const existingEmptyState = document.getElementById('notificationEmptyState');

        if (existingEmptyState) {
            existingEmptyState.classList.remove('d-none');
            return;
        }

        notificationList.innerHTML = `
            <div class="notif-empty-state" id="notificationEmptyState">
                <i class="far fa-bell-slash"></i>
                <p>Okunmamış bildiriminiz yok.</p>
            </div>
        `;
    }

    function markRead(id, element) {
        if (!id || !element) {
            return;
        }

        const token = getAntiForgeryToken();

        fetch('/Notification/MarkRead?id=' + encodeURIComponent(id), {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        }).then(response => {
            if (!response.ok) {
                return;
            }

            element.classList.remove('unread');
            element.remove();

            updateNotificationBadgeVisibility();
        });
    }

    function markAllRead() {
        const token = getAntiForgeryToken();

        fetch('/Notification/MarkAllRead', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            }
        }).then(response => {
            if (!response.ok) {
                return;
            }

            document.querySelectorAll('.notif-item.unread').forEach(element => {
                element.remove();
            });

            updateNotificationBadgeVisibility();
        });
    }

    // ── SignalR Gerçek Zamanlı Bildirimler ──
    (function initSignalR() {
        if (typeof signalR === 'undefined') return;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/notifications')
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .build();

        connection.on('ReceiveNotification', function (n) {
            const list = document.getElementById('notificationList');
            if (!list) return;

            // Boş durumu kaldır
            var empty = document.getElementById('notificationEmptyState');
            if (empty) empty.remove();

            var icon = n.icon || 'fas fa-info-circle';
            var color = n.color || 'primary';
            var link = n.link || '#';

            var html = '<a href="' + link + '" onclick="markRead(\'' + n.id + '\', this)" class="notif-item unread">'
                + '<div class="notif-icon bg-' + color + ' bg-opacity-10 text-' + color + '">'
                + '<i class="' + icon + '"></i></div>'
                + '<div class="notif-content"><p><strong>' + escapeHtml(n.title) + '</strong><br>'
                + '<span class="text-muted">' + escapeHtml(n.message) + '</span></p>'
                + '<span class="notif-time">' + escapeHtml(n.createdAt) + '</span></div></a>';

            list.insertAdjacentHTML('afterbegin', html);

            // Badge göster
            var badge = document.getElementById('notifBadge');
            if (badge) {
                badge.style.display = '';
                badge.classList.add('badge-pulse');
            } else {
                var btn = document.getElementById('notifDropdownBtn');
                if (btn) {
                    var dot = document.createElement('span');
                    dot.className = 'badge-dot badge-pulse';
                    dot.id = 'notifBadge';
                    btn.appendChild(dot);
                }
            }

            // "Tümünü Okundu Yap" butonunu göster
            var markAllBtn = document.getElementById('markAllReadBtn');
            if (markAllBtn) markAllBtn.style.display = '';
        });

        connection.start().catch(function (err) {
            console.debug('SignalR bağlantısı kurulamadı:', err);
        });

        function escapeHtml(str) {
            if (!str) return '';
            var div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    })();
</script>
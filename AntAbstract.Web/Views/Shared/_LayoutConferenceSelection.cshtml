@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using AntAbstract.Domain.Entities
@using System
@using System.Globalization
@using System.Collections.Generic

@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject IViewLocalizer Localizer

@{
    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;
        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
    };

    var user = await UserManager.GetUserAsync(User);

    var roles = user != null
        ? await UserManager.GetRolesAsync(user)
        : new List<string>();

    var isSuperAdmin = roles.Contains("SuperAdmin");
    var isAdmin = roles.Contains("Admin");
    var isAuthor = roles.Contains("Author");
    var isReferee = roles.Contains("Referee");
    var isListener = roles.Contains("Listener");

    var roleText = isSuperAdmin
        ? "SÜPER ADMİN"
        : isAdmin
            ? "ADMİN"
            : isReferee
                ? "HAKEM"
                : isAuthor
                    ? "YAZAR"
                    : isListener
                        ? "DİNLEYİCİ"
                        : "KULLANICI";

    var panelText = isSuperAdmin
        ? "Süper Admin Paneli"
        : isAdmin
            ? "Yönetici Paneli"
            : isReferee
                ? "Hakem Paneli"
                : isAuthor
                    ? "Yazar Paneli"
                    : "Panelim";

    var panelUrl = isSuperAdmin
        ? "/Dashboard/SuperAdmin"
        : "/Dashboard/MyConferences";

    var fullName = user != null
        ? $"{user.FirstName} {user.LastName}".Trim()
        : (User.Identity?.Name ?? L("DefaultUser", "Kullanıcı"));

    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = user?.UserName ?? L("DefaultUser", "Kullanıcı");
    }

    var email = user?.Email ?? "";

    string initials = "U";

    if (!string.IsNullOrWhiteSpace(fullName))
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }
        else
        {
            initials = fullName.Substring(0, 1).ToUpper();
        }
    }

    var profileImg = !string.IsNullOrWhiteSpace(user?.ProfileImagePath)
        ? user.ProfileImagePath
        : "";

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? CultureInfo.CurrentUICulture.Name;

    var currentReturnUrl = string.IsNullOrEmpty(Context.Request.Path.Value)
        ? "/Dashboard/MyConferences"
        : $"{Context.Request.Path}{Context.Request.QueryString}";

    var isTr = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
    var isEn = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var currentShortCulture = isEn ? "EN" : "TR";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-dark: #0984e3;
            --primary-blue: #0d6efd;
            --bg-color: #f8fafc;
            --border-color: #e2e8f0;
            --text-dark: #0f172a;
            --text-soft: #334155;
            --text-muted: #64748b;
            --danger-color: #ef4444;
            --success-color: #10b981;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--text-dark);
        }

        .selection-navbar {
            height: 82px;
            padding: 0 2rem;
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(18px);
            box-shadow: 0 10px 28px rgba(15, 23, 42, 0.035);
        }

        .brand-logo {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--text-dark);
            text-decoration: none;
            letter-spacing: -0.7px;
            display: inline-flex;
            align-items: center;
            line-height: 1;
        }

            .brand-logo:hover {
                color: var(--text-dark);
                text-decoration: none;
            }

            .brand-logo span {
                color: var(--primary-color);
            }

        .selection-top-actions {
            display: flex;
            align-items: center;
            gap: 0.9rem;
        }

        .selection-language-dropdown {
            display: inline-flex;
            align-items: center;
        }

        .selection-language-dropdown-btn {
            min-height: 36px;
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: var(--text-muted);
            border-radius: 999px;
            padding: 0 0.75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.55rem;
            font-size: 0.8rem;
            font-weight: 900;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
            transition: all 0.2s ease;
        }

            .selection-language-dropdown-btn:hover,
            .selection-language-dropdown-btn.show {
                color: var(--primary-blue);
                border-color: rgba(13, 110, 253, 0.28);
                background: #ffffff;
                box-shadow: 0 14px 32px rgba(13, 110, 253, 0.12);
                transform: translateY(-1px);
            }

            .selection-language-dropdown-btn .fa-globe {
                color: var(--text-muted);
            }

        .selection-language-chevron {
            font-size: 0.68rem;
            color: var(--text-muted);
            transition: transform 0.2s ease;
        }

        .selection-language-dropdown-btn.show .selection-language-chevron {
            transform: rotate(180deg);
        }

        .selection-language-menu {
            min-width: 170px;
            padding: 0.5rem;
            border: 1px solid var(--border-color);
            border-radius: 20px;
            background: #ffffff;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.14);
            margin-top: 0.7rem !important;
        }

            .selection-language-menu form {
                margin: 0;
            }

            .selection-language-menu li + li {
                margin-top: 0.25rem;
            }

        .selection-language-dropdown-item {
            width: 100%;
            min-height: 42px;
            border: none;
            border-radius: 14px;
            background: transparent;
            color: var(--text-soft);
            padding: 0.55rem 0.7rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            font-weight: 900;
            transition: all 0.2s ease;
        }

            .selection-language-dropdown-item:hover {
                background: #f8fbff;
                color: var(--primary-blue);
            }

            .selection-language-dropdown-item.active {
                background: rgba(13, 110, 253, 0.09);
                color: var(--primary-blue);
            }

        .selection-language-code {
            min-width: 38px;
            height: 30px;
            border-radius: 999px;
            background: #f1f5f9;
            color: var(--primary-blue);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 900;
        }

        .selection-language-dropdown-item.active .selection-language-code {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-blue));
            color: #ffffff;
            box-shadow: 0 8px 18px rgba(13, 110, 253, 0.22);
        }

        .selection-language-name {
            flex: 1;
            text-align: left;
            font-size: 0.84rem;
            font-weight: 850;
            color: inherit;
        }

        .selection-account-menu {
            position: relative;
        }

        .selection-account-button {
            min-height: 52px;
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            border: 1px solid #dbeafe;
            border-radius: 999px;
            padding: 0.45rem 0.55rem 0.45rem 1.15rem;
            background: #ffffff;
            color: var(--text-dark);
            font-size: 0.9rem;
            font-weight: 900;
            text-decoration: none;
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .selection-account-button:hover,
            .selection-account-button.show {
                background: #f8fbff;
                border-color: rgba(13, 110, 253, 0.35);
                color: var(--text-dark);
                text-decoration: none;
                transform: translateY(-1px);
                box-shadow: 0 14px 34px rgba(15, 23, 42, 0.09);
            }

        .selection-account-name {
            max-width: 190px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .selection-account-avatar,
        .selection-account-avatar-img {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 999px;
        }

        .selection-account-avatar {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-blue));
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.82rem;
            font-weight: 900;
            box-shadow: 0 10px 22px rgba(13, 110, 253, 0.25);
            border: 2px solid #ffffff;
        }

        .selection-account-avatar-img {
            object-fit: cover;
            border: 2px solid #ffffff;
            box-shadow: 0 10px 22px rgba(15, 23, 42, 0.12);
        }

        .selection-account-chevron {
            color: var(--text-muted);
            font-size: 0.78rem;
            margin-right: 0.25rem;
            transition: transform 0.2s ease;
        }

        .selection-account-button.show .selection-account-chevron {
            transform: rotate(180deg);
        }

        .selection-account-dropdown {
            width: 315px;
            padding: 0;
            overflow: hidden;
            border: 1px solid var(--border-color);
            border-radius: 22px;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
            margin-top: 0.7rem !important;
            background: #ffffff;
        }

        .selection-account-summary {
            display: flex;
            align-items: center;
            gap: 0.95rem;
            padding: 1.15rem 1.15rem;
            background: linear-gradient(135deg, #e0f7ff 0%, #eef9ff 48%, #dff7ff 100%);
            border-bottom: 1px solid #dbeafe;
        }

        .selection-summary-avatar,
        .selection-summary-avatar-img {
            width: 58px;
            height: 58px;
            min-width: 58px;
            border-radius: 999px;
        }

        .selection-summary-avatar {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-blue));
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 900;
            border: 4px solid #ffffff;
            box-shadow: 0 12px 26px rgba(13, 110, 253, 0.25);
        }

        .selection-summary-avatar-img {
            object-fit: cover;
            border: 4px solid #ffffff;
            box-shadow: 0 12px 26px rgba(15, 23, 42, 0.14);
        }

        .selection-summary-name {
            color: var(--text-dark);
            font-size: 1rem;
            font-weight: 900;
            line-height: 1.15;
            margin-bottom: 0.3rem;
        }

        .selection-summary-meta {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            flex-wrap: wrap;
        }

        .selection-role-badge {
            display: inline-flex;
            align-items: center;
            min-height: 22px;
            padding: 0 0.5rem;
            border-radius: 999px;
            background: #ffffff;
            color: var(--primary-blue);
            font-size: 0.7rem;
            font-weight: 900;
            box-shadow: 0 6px 14px rgba(13, 110, 253, 0.08);
        }

        .selection-summary-email {
            color: var(--text-muted);
            font-size: 0.78rem;
            font-weight: 700;
            max-width: 190px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            display: block;
            margin-top: 0.22rem;
        }

        .selection-dropdown-body {
            padding: 0.8rem;
        }

        .selection-dropdown-item {
            width: 100%;
            min-height: 52px;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0 0.75rem;
            border-radius: 16px;
            border: none;
            background: transparent;
            color: var(--text-soft);
            font-size: 0.92rem;
            font-weight: 900;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .selection-dropdown-item:hover {
                background: #f8fafc;
                color: var(--primary-blue);
                text-decoration: none;
            }

        .selection-dropdown-icon {
            width: 38px;
            min-width: 38px;
            height: 38px;
            border-radius: 14px;
            color: var(--primary-blue);
            background: rgba(13, 110, 253, 0.10);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }

        .selection-dropdown-item:hover .selection-dropdown-icon {
            background: rgba(13, 110, 253, 0.14);
            transform: translateY(-1px);
        }

        .selection-dropdown-divider {
            height: 1px;
            background: var(--border-color);
            margin: 0.75rem 0;
        }

        .selection-logout-form {
            margin: 0;
        }

        .selection-dropdown-logout {
            color: var(--danger-color);
            cursor: pointer;
        }

            .selection-dropdown-logout .selection-dropdown-icon {
                color: var(--danger-color);
                background: rgba(239, 68, 68, 0.10);
            }

            .selection-dropdown-logout:hover {
                color: #dc2626;
                background: rgba(239, 68, 68, 0.08);
            }

                .selection-dropdown-logout:hover .selection-dropdown-icon {
                    color: #dc2626;
                    background: rgba(239, 68, 68, 0.13);
                }

        .selection-main {
            flex-grow: 1;
            width: 100%;
        }

        .selection-alert {
            border: none;
            border-radius: 18px;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
            font-weight: 700;
        }

        @@media (max-width: 768px) {
            .selection-navbar {
                height: 72px;
                padding: 0 0.75rem;
            }

            .brand-logo {
                font-size: 1.25rem;
            }

            .selection-language-dropdown-btn {
                min-height: 44px;
                padding: 0 0.8rem;
                font-size: 0.8rem;
            }

            .selection-language-menu {
                min-width: 155px;
            }

            .selection-account-name {
                display: none;
            }

            .selection-account-button {
                min-height: 46px;
                padding: 0.35rem 0.45rem;
                gap: 0.35rem;
            }

            .selection-account-chevron {
                display: none;
            }

            .selection-account-avatar,
            .selection-account-avatar-img {
                width: 36px;
                height: 36px;
                min-width: 36px;
            }

            .selection-account-dropdown {
                width: 295px;
            }
        }

        @@media (max-width: 480px) {
            .selection-top-actions {
                gap: 0.45rem;
            }

            .selection-language-dropdown {
                display: none;
            }

            .selection-account-dropdown {
                width: 285px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="selection-navbar d-flex justify-content-between align-items-center">
        <a href="/" class="brand-logo">
            ANT<span>ABSTRACT</span>
        </a>

        <div class="selection-top-actions">
            <div class="selection-language-dropdown dropdown">
                <button class="selection-language-dropdown-btn"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <i class="fas fa-globe"></i>
                    <span>@currentShortCulture</span>
                    <i class="fas fa-chevron-down selection-language-chevron"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end selection-language-menu">
                    <li>
                        <form asp-area=""
                              asp-controller="Language"
                              asp-action="ChangeLanguage"
                              method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="culture" value="tr-TR" />
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                            <button type="submit"
                                    class="dropdown-item selection-language-dropdown-item @(isTr ? "active" : "")">
                                <span class="selection-language-code">TR</span>
                                <span class="selection-language-name">Türkçe</span>
                            </button>
                        </form>
                    </li>

                    <li>
                        <form asp-area=""
                              asp-controller="Language"
                              asp-action="ChangeLanguage"
                              method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="culture" value="en-US" />
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                            <button type="submit"
                                    class="dropdown-item selection-language-dropdown-item @(isEn ? "active" : "")">
                                <span class="selection-language-code">EN</span>
                                <span class="selection-language-name">English</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="selection-account-menu dropdown">
                    <button type="button"
                            class="selection-account-button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <span class="selection-account-name">
                            @fullName
                        </span>

                        @if (!string.IsNullOrWhiteSpace(profileImg))
                        {
                            <img src="@profileImg"
                                 class="selection-account-avatar-img"
                                 alt="@fullName" />
                        }
                        else
                        {
                            <span class="selection-account-avatar">
                                @initials
                            </span>
                        }

                        <i class="fas fa-chevron-down selection-account-chevron"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end selection-account-dropdown">
                        <div class="selection-account-summary">
                            @if (!string.IsNullOrWhiteSpace(profileImg))
                            {
                                <img src="@profileImg"
                                     class="selection-summary-avatar-img"
                                     alt="@fullName" />
                            }
                            else
                            {
                                <span class="selection-summary-avatar">
                                    @initials
                                </span>
                            }

                            <div class="min-w-0">
                                <div class="selection-summary-name">
                                    @fullName
                                </div>

                                <div class="selection-summary-meta">
                                    <span class="selection-role-badge">
                                        @roleText
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(email))
                                {
                                    <span class="selection-summary-email">
                                        @email
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="selection-dropdown-body">
                            <a href="/Identity/Account/Manage"
                               class="selection-dropdown-item">
                                <span class="selection-dropdown-icon">
                                    <i class="fas fa-user-cog"></i>
                                </span>

                                <span>
                                    @L("Settings", "Hesap Ayarları")
                                </span>
                            </a>

                            <div class="selection-dropdown-divider"></div>

                            <form asp-controller="Dashboard"
                                  asp-action="CustomLogout"
                                  method="post"
                                  class="selection-logout-form">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="selection-dropdown-item selection-dropdown-logout">
                                    <span class="selection-dropdown-icon">
                                        <i class="fas fa-sign-out-alt"></i>
                                    </span>

                                    <span>
                                        @L("Logout", "Çıkış Yap")
                                    </span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </nav>

    <main class="selection-main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-4">
                <div class="alert alert-success alert-dismissible fade show selection-alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-4">
                <div class="alert alert-danger alert-dismissible fade show selection-alert">
                    <i class="fas fa-times-circle me-2"></i>
                    @TempData["ErrorMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="container mt-4">
                <div class="alert alert-info alert-dismissible fade show selection-alert">
                    <i class="fas fa-info-circle me-2"></i>
                    @TempData["InfoMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
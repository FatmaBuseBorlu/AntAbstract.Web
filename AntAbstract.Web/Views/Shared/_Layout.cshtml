@using System.Globalization
@using AntAbstract.Domain.Entities
@using AntAbstract.Infrastructure.Services
@using AntAbstract.Infrastructure.Services.Conferences
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject AntAbstract.Infrastructure.Context.TenantContext Tc
@inject ISelectedConferenceService SelectedConferenceService
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-dark: #0284c7;
            --dark-bg: #0f172a;
            --text-main: #334155;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .navbar {
            padding: 16px 0;
            background-color: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(15, 23, 42, 0.06);
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: #1e293b;
            letter-spacing: -0.5px;
            text-decoration: none;
            white-space: nowrap;
        }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            margin: 0 8px;
            font-size: 0.95rem;
            transition: all 0.2s;
            position: relative;
            white-space: nowrap;
        }

            .nav-link:hover {
                color: var(--primary-color) !important;
            }

            .nav-link.admin-link {
                color: #dc3545 !important;
                background-color: rgba(220, 53, 69, 0.1);
                border-radius: 999px;
                padding: 8px 16px !important;
                font-weight: 700;
            }

                .nav-link.admin-link:hover {
                    background-color: #dc3545;
                    color: white !important;
                    transform: translateY(-2px);
                }

            .nav-link.referee-link {
                color: var(--primary-color) !important;
                background-color: rgba(0, 174, 239, 0.1);
                border-radius: 999px;
                padding: 8px 16px !important;
                font-weight: 700;
            }

                .nav-link.referee-link:hover {
                    background-color: var(--primary-color);
                    color: white !important;
                    transform: translateY(-2px);
                }

            .nav-link.author-link {
                color: #6f42c1 !important;
                background-color: rgba(111, 66, 193, 0.1);
                border-radius: 999px;
                padding: 8px 16px !important;
                font-weight: 700;
            }

                .nav-link.author-link:hover {
                    background-color: #6f42c1;
                    color: white !important;
                    transform: translateY(-2px);
                }

            .nav-link.website-link {
                color: #198754 !important;
                background-color: rgba(25, 135, 84, 0.12);
                border-radius: 999px;
                padding: 8px 16px !important;
                font-weight: 700;
            }

                .nav-link.website-link:hover {
                    background-color: #198754;
                    color: white !important;
                    transform: translateY(-2px);
                }

        .header-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .language-dropdown {
            position: relative;
            flex-shrink: 0;
        }

        .language-current-btn {
            height: 44px;
            min-width: 82px;
            padding: 0 16px;
            border: 1px solid #dbe3ef;
            border-radius: 999px;
            background: #ffffff;
            color: #475569;
            font-weight: 800;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
            transition: all 0.2s ease;
        }

            .language-current-btn:hover {
                color: var(--primary-color);
                border-color: rgba(0, 174, 239, 0.35);
                box-shadow: 0 6px 18px rgba(0, 174, 239, 0.12);
            }

            .language-current-btn::after {
                margin-left: 2px;
                font-size: 0.75rem;
            }

        .language-menu {
            min-width: 155px;
            padding: 8px;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 14px 40px rgba(15, 23, 42, 0.14);
        }

            .language-menu form {
                margin: 0;
            }

        .language-menu-item {
            width: 100%;
            border: none;
            background: transparent;
            padding: 10px 12px;
            border-radius: 12px;
            color: #475569;
            font-weight: 700;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

            .language-menu-item:hover {
                background: #f1f5f9;
                color: var(--primary-color);
            }

            .language-menu-item.active {
                background: rgba(0, 174, 239, 0.1);
                color: var(--primary-color);
            }

        .header-actions .btn,
        .header-actions a.btn,
        .header-actions button.btn {
            height: 44px;
            min-width: 118px;
            padding: 0 22px !important;
            border-radius: 999px !important;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            line-height: 1 !important;
        }

        .header-actions .btn-outline-dark,
        .header-actions .btn-outline-primary,
        .header-actions .btn-outline-secondary {
            border: 1.5px solid #0f172a !important;
            color: #1e293b !important;
            background: #ffffff !important;
        }

            .header-actions .btn-outline-dark:hover,
            .header-actions .btn-outline-primary:hover,
            .header-actions .btn-outline-secondary:hover {
                background: #f8fafc !important;
                color: #0f172a !important;
            }

        .header-actions .btn-primary,
        .header-actions .btn-info {
            border: none !important;
            color: #ffffff !important;
            background: linear-gradient(135deg, #00aeef, #0284c7) !important;
            box-shadow: 0 6px 16px rgba(0, 174, 239, 0.24);
        }

            .header-actions .btn-primary:hover,
            .header-actions .btn-info:hover {
                color: #ffffff !important;
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(0, 174, 239, 0.32);
            }

        .footer-modern {
            background-color: var(--dark-bg);
            color: #94a3b8;
            font-size: 0.9rem;
            margin-top: auto;
        }

        .footer-title {
            color: #fff;
            font-weight: 700;
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
        }

        .footer-link {
            color: #94a3b8;
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: color 0.2s, padding-left 0.2s;
        }

            .footer-link:hover {
                color: var(--primary-color);
                padding-left: 5px;
            }

        .social-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.1);
            color: white;
            border-radius: 50%;
            margin-right: 8px;
            transition: all 0.3s;
            text-decoration: none;
        }

            .social-btn:hover {
                background: var(--primary-color);
                color: white;
                transform: translateY(-3px);
            }

        @@media (min-width: 992px) {
            .navbar-brand {
                flex: 0 0 240px;
            }

            .navbar-collapse {
                flex: 1;
            }

            .navbar-nav {
                flex: 1;
                justify-content: center;
            }

            .header-actions {
                flex: 0 0 390px;
            }
        }

        @@media (max-width: 991.98px) {
            .header-actions {
                margin-top: 18px;
                align-items: flex-start;
                justify-content: flex-start;
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body>

    @{
        var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var path = (Context.Request.Path.Value ?? "").TrimEnd('/');

        var isPaymentPage = string.Equals(controller, "Payment", StringComparison.OrdinalIgnoreCase);

        var isSuperAdmin = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("SuperAdmin");

        var isAdminLike = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Admin");

        var isListener = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Listener");

        var isReferee = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Referee");

        var isAuthor = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Author");

        var isAdminArea = string.Equals(area, "Admin", StringComparison.OrdinalIgnoreCase);

        var isAdminAssignmentPath =
        path.StartsWith("/Admin/Assignment", StringComparison.OrdinalIgnoreCase)
        || path.Contains("/Admin/Assignment", StringComparison.OrdinalIgnoreCase);

        var isHomeIndexPage =
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);

        var isHomeAboutPage =
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "About", StringComparison.OrdinalIgnoreCase);

        var isHomeContactPage =
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Contact", StringComparison.OrdinalIgnoreCase);

        var isHomeCongressesPage =
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Congresses", StringComparison.OrdinalIgnoreCase);

        var isHomeProceedingsPage =
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Proceedings", StringComparison.OrdinalIgnoreCase);

        var isPublicProceedingsPath =
        path.Equals("/proceedings", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/Home/Proceedings", StringComparison.OrdinalIgnoreCase);

        var isLegalPage =
        path.Equals("/privacy", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/Home/Privacy", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/kvkk", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/Home/Kvkk", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/cookies", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/Home/Cookies", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/terms", StringComparison.OrdinalIgnoreCase)
        || path.Equals("/Home/Terms", StringComparison.OrdinalIgnoreCase);

        var isRegistrationPage =
        string.Equals(controller, "Registration", StringComparison.OrdinalIgnoreCase);

        var isTenantConferenceHomePage = Tc.Current != null && isHomeIndexPage;
        var hideGlobalNavbar = isTenantConferenceHomePage;

        var hideAdminNav =
        isAdminArea ||
        isAdminAssignmentPath ||
        isHomeIndexPage ||
        isHomeAboutPage ||
        isHomeContactPage ||
        isHomeCongressesPage ||
        isHomeProceedingsPage ||
        isPublicProceedingsPath ||
        isLegalPage ||
        isRegistrationPage ||
        isPaymentPage;

        var slug =
        ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Tc.Current?.Slug
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

        var selectedConferenceId = SelectedConferenceService.GetSelectedConferenceId();
        var hasSelectedConference = selectedConferenceId.HasValue;

        var assignmentUrl = (hasSelectedConference && !string.IsNullOrWhiteSpace(slug))
        ? $"/{slug}/Admin/Assignment?conferenceId={selectedConferenceId.Value}"
        : "/Admin/Assignment";

        var websiteUrl = (!string.IsNullOrWhiteSpace(slug))
        ? $"/{slug}/Admin/Website"
        : "/Admin/Website";

        var superAdminPanelUrl = "/Dashboard/SuperAdmin";

        var listenerPanelUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Dashboard"
        : "/Dashboard";

        var requestCulture = Context.Features.Get<IRequestCultureFeature>();
        var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

        var currentShortCulture = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
        ? "EN"
        : "TR";

        var returnUrl = string.IsNullOrEmpty(Context.Request.Path.Value)
        ? "/"
        : $"{Context.Request.Path}{Context.Request.QueryString}";
    }

    @if (hideGlobalNavbar)
    {
        <style>
            html,
            body {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

            main[role="main"] {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

            .navbar,
            header {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

            .conference-topbar,
            .conference-header,
            .tenant-header,
            .conference-page-header,
            .conference-hero,
            .hero-section,
            .page-hero,
            .site-hero {
                margin-top: 0 !important;
            }
        </style>
    }

    @if (!hideGlobalNavbar)
    {
        <header>
            <nav class="navbar navbar-expand-lg fixed-top">
                <div class="container">
                    <a class="navbar-brand" href="/">
                        ANT<span style="color: var(--primary-color);">ABSTRACT</span>
                    </a>

                    <button class="navbar-toggler border-0"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarNav"
                            aria-controls="navbarNav"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav mx-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link" href="/">@Localizer["Menu_Home"]</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/about">@Localizer["Menu_About"]</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/congresses">@Localizer["Menu_Congresses"]</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/proceedings">@Localizer["Menu_Proceedings"]</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/contact">@Localizer["Menu_Contact"]</a>
                            </li>

                            @if (!hideAdminNav && isSuperAdmin)
                            {
                                <li class="nav-item ms-lg-3">
                                    <a class="nav-link admin-link shadow-sm" href="@superAdminPanelUrl">
                                        <i class="fas fa-shield-alt me-1"></i>
                                        Sistem Paneli
                                    </a>
                                </li>
                            }

                            @if (!hideAdminNav && isAdminLike && (Tc.Current != null || !string.IsNullOrWhiteSpace(slug)))
                            {
                                <li class="nav-item ms-lg-3">
                                    <a class="nav-link admin-link shadow-sm" href="@assignmentUrl">
                                        @if (hasSelectedConference)
                                        {
                                            <i class="fas fa-tasks me-1"></i>
                                            @Localizer["AdminPanel"]
                                        }
                                        else
                                        {
                                            <i class="fas fa-hand-pointer me-1"></i>
                                            @Localizer["SelectConference"]
                                        }
                                    </a>
                                </li>

                                @if (hasSelectedConference)
                                {
                                    <li class="nav-item ms-lg-2">
                                        <a class="nav-link website-link shadow-sm" href="@websiteUrl">
                                            <i class="fas fa-pen-to-square me-1"></i>
                                            @Localizer["WebsiteManagement"]
                                        </a>
                                    </li>
                                }
                            }

                            @if (isReferee && !hideAdminNav)
                            {
                                <li class="nav-item ms-lg-3">
                                    <a class="nav-link referee-link shadow-sm" href="/Dashboard">
                                        <i class="fas fa-gavel me-1"></i>
                                        @Localizer["RefereePanel"]
                                    </a>
                                </li>
                            }

                            @if (isAuthor && !hideAdminNav)
                            {
                                <li class="nav-item ms-lg-3">
                                    <a class="nav-link author-link shadow-sm" href="/Dashboard">
                                        <i class="fas fa-user-graduate me-1"></i>
                                        @Localizer["AuthorPanel"]
                                    </a>
                                </li>
                            }
                            @if (isListener && !hideAdminNav)
                            {
                                <li class="nav-item ms-lg-3">
                                    <a class="nav-link author-link shadow-sm" href="@listenerPanelUrl">
                                        <i class="fas fa-user-check me-1"></i>
                                        Katılımcı Paneli
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="header-actions">
                            <div class="dropdown language-dropdown">
                                <button class="language-current-btn dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="fas fa-globe"></i>
                                    @currentShortCulture
                                </button>

                                <div class="dropdown-menu dropdown-menu-end language-menu">
                                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="culture" value="tr-TR" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <button type="submit"
                                                class="language-menu-item @(currentCulture == "tr-TR" ? "active" : "")">
                                            <span>🇹🇷</span>
                                            <span>Türkçe</span>
                                        </button>
                                    </form>

                                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="culture" value="en-US" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <button type="submit"
                                                class="language-menu-item @(currentCulture == "en-US" ? "active" : "")">
                                            <span>🇬🇧</span>
                                            <span>English</span>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-modern pt-5 pb-4">
        <div class="container">
            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white fw-bold mb-3">
                        <i class="fas fa-layer-group me-2 text-primary"></i>ANT ABSTRACT
                    </h5>

                    <p class="mb-4" style="line-height: 1.8;">
                        @Localizer["Footer_Description"]
                    </p>

                    <div class="d-flex">
                        <a href="#" class="social-btn" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>

                        <a href="#" class="social-btn" aria-label="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>

                        <a href="#" class="social-btn" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>

                        <a href="#" class="social-btn" aria-label="YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">
                        @Localizer["Footer_Platform"]
                    </h6>

                    <a href="/" class="footer-link">
                        @Localizer["Menu_Home"]
                    </a>

                    <a href="/congresses" class="footer-link">
                        @Localizer["Menu_Congresses"]
                    </a>

                    <a href="/about" class="footer-link">
                        @Localizer["Menu_About"]
                    </a>

                    <a href="/login" class="footer-link">
                        @Localizer["Menu_Login"]
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">
                        @Localizer["Footer_SupportLegal"]
                    </h6>

                    <a href="/privacy" class="footer-link">
                        <i class="fas fa-shield-alt me-2 text-primary"></i>
                        @Localizer["Footer_PrivacyPolicy"]
                    </a>

                    <a href="/kvkk" class="footer-link">
                        <i class="fas fa-file-signature me-2 text-primary"></i>
                        @Localizer["Footer_Kvkk"]
                    </a>

                    <a href="/cookies" class="footer-link">
                        <i class="fas fa-cookie-bite me-2 text-primary"></i>
                        @Localizer["Footer_CookiePolicy"]
                    </a>

                    <a href="/terms" class="footer-link">
                        <i class="fas fa-file-contract me-2 text-primary"></i>
                        @Localizer["Footer_Terms"]
                    </a>

                    <a href="/contact" class="footer-link">
                        <i class="fas fa-envelope me-2 text-primary"></i>
                        @Localizer["Menu_Contact"]
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">
                        @Localizer["Footer_ContactUs"]
                    </h6>

                    <div class="d-flex mb-3">
                        <i class="fas fa-map-marker-alt text-primary mt-1 me-3"></i>
                        <span>@Localizer["Footer_Address"]</span>
                    </div>

                    <div class="d-flex mb-3">
                        <i class="fas fa-phone text-primary mt-1 me-3"></i>
                        <span>+90 850 123 45 67</span>
                    </div>

                    <div class="d-flex">
                        <i class="fas fa-envelope text-primary mt-1 me-3"></i>
                        <span>destek@antabstract.com</span>
                    </div>
                </div>

            </div>

            <hr class="my-4 border-secondary opacity-25">

            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    &copy; @DateTime.Now.Year <strong>AntAbstract</strong>. @Localizer["Footer_AllRightsReserved"]
                </div>

                <div class="col-md-6 text-center text-md-end">
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                        v2.1.0 Stable
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
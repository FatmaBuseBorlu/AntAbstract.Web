@using System
@using System.Globalization
@using AntAbstract.Domain.Entities
@using AntAbstract.Infrastructure.Services
@using AntAbstract.Infrastructure.Services.Conferences
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject AntAbstract.Infrastructure.Context.TenantContext Tc
@inject ISelectedConferenceService SelectedConferenceService
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-dark: #0284c7;
            --dark-bg: #0f172a;
            --text-main: #334155;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .navbar-brand {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .navbar {
            padding: 16px 0;
            background-color: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(15, 23, 42, 0.06);
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.6rem;
            color: #1e293b;
            letter-spacing: -0.5px;
            text-decoration: none;
            white-space: nowrap;
        }

        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            margin: 0 8px;
            font-size: 0.95rem;
            transition: all 0.2s;
            position: relative;
            white-space: nowrap;
        }

            .nav-link:hover {
                color: var(--primary-color) !important;
            }

        .header-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .language-dropdown {
            position: relative;
            flex-shrink: 0;
        }

        .language-current-btn {
            height: 44px;
            min-width: 82px;
            padding: 0 16px;
            border: 1px solid #dbe3ef;
            border-radius: 999px;
            background: #ffffff;
            color: #475569;
            font-weight: 800;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
            transition: all 0.2s ease;
        }

            .language-current-btn:hover {
                color: var(--primary-color);
                border-color: rgba(0, 174, 239, 0.35);
                box-shadow: 0 6px 18px rgba(0, 174, 239, 0.12);
            }

            .language-current-btn::after {
                margin-left: 2px;
                font-size: 0.75rem;
            }

        .language-menu {
            min-width: 190px;
            padding: 10px;
            border: none !important;
            border-radius: 24px !important;
            background-color: #ffffff;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);
            overflow: hidden;
            margin-top: 10px !important;
        }

            .language-menu form {
                margin: 0;
            }

                .language-menu form + form {
                    margin-top: 6px;
                }

        .language-menu-item {
            width: 100%;
            min-height: 54px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 12px;
            border: none;
            background: transparent;
            border-radius: 16px;
            padding: 0.8rem 1rem;
            color: #475569;
            transition: all 0.2s ease;
        }

            .language-menu-item:hover,
            .language-menu-item.active {
                background-color: rgba(0, 174, 239, 0.12);
                color: var(--primary-color);
            }

        .language-code {
            min-width: 24px;
            font-size: 0.8rem;
            font-weight: 900;
            color: var(--primary-color);
            letter-spacing: 0.3px;
        }

        .language-name {
            font-size: 1rem;
            font-weight: 800;
            color: inherit;
        }

        .header-actions .btn,
        .header-actions a.btn,
        .header-actions button.btn {
            height: 44px;
            min-width: 118px;
            padding: 0 22px !important;
            border-radius: 999px !important;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            line-height: 1 !important;
        }

        .header-actions .btn-outline-dark,
        .header-actions .btn-outline-primary,
        .header-actions .btn-outline-secondary {
            border: 1.5px solid #0f172a !important;
            color: #1e293b !important;
            background: #ffffff !important;
        }

            .header-actions .btn-outline-dark:hover,
            .header-actions .btn-outline-primary:hover,
            .header-actions .btn-outline-secondary:hover {
                background: #f8fafc !important;
                color: #0f172a !important;
            }

        .header-actions .btn-primary,
        .header-actions .btn-info {
            border: none !important;
            color: #ffffff !important;
            background: linear-gradient(135deg, #00aeef, #0284c7) !important;
            box-shadow: 0 6px 16px rgba(0, 174, 239, 0.24);
        }

            .header-actions .btn-primary:hover,
            .header-actions .btn-info:hover {
                color: #ffffff !important;
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(0, 174, 239, 0.32);
            }

        .public-user-btn,
        .public-account-menu {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .public-user-btn-name,
        .public-account-name,
        .public-account-role,
        .public-account-email,
        .public-account-item-title,
        .public-account-item-desc {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .public-account-menu .fas,
        .public-account-menu .fa-solid,
        .public-account-menu .far,
        .public-account-menu .fa-regular,
        .public-account-menu .fab,
        .public-account-menu .fa-brands,
        .public-user-btn .fas,
        .public-user-btn .fa-solid,
        .public-user-btn .far,
        .public-user-btn .fa-regular,
        .public-user-btn .fab,
        .public-user-btn .fa-brands {
            font-family: "Font Awesome 6 Free" !important;
        }

        .public-account-menu .fas,
        .public-account-menu .fa-solid,
        .public-user-btn .fas,
        .public-user-btn .fa-solid {
            font-weight: 900 !important;
        }

        .public-account-menu .far,
        .public-account-menu .fa-regular,
        .public-user-btn .far,
        .public-user-btn .fa-regular {
            font-weight: 400 !important;
        }

        .public-user-btn {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.32rem 0.42rem 0.32rem 0.95rem;
            border-radius: 999px;
            background-color: #ffffff;
            border: 1px solid #dbe3ef;
            color: #0f172a;
            font-weight: 800;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .public-user-btn:hover,
            .public-user-btn:focus {
                color: var(--primary-color);
                border-color: rgba(0, 174, 239, 0.35);
                box-shadow: 0 8px 22px rgba(0, 174, 239, 0.12);
            }

            .public-user-btn::after {
                display: none;
            }

        .public-user-btn-name {
            max-width: 145px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #0f172a;
            font-size: 0.92rem;
            font-weight: 900;
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .public-user-avatar-wrap {
            position: relative;
            width: 36px;
            height: 36px;
            min-width: 36px;
        }

        .public-user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #ffffff;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12);
        }

        .public-user-online-dot {
            position: absolute;
            right: 0;
            bottom: 1px;
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background-color: #22c55e;
            border: 2px solid #ffffff;
        }

        .public-account-menu {
            width: 272px;
            padding: 0;
            border: none !important;
            border-radius: 22px !important;
            overflow: hidden;
            background-color: #ffffff;
            box-shadow: 0 18px 44px rgba(15, 23, 42, 0.14);
            margin-top: 12px !important;
        }

        .public-account-header {
            display: flex;
            align-items: center;
            gap: 0.78rem;
            padding: 1rem 1.05rem;
            background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.20), transparent 38%), linear-gradient(135deg, rgba(0, 174, 239, 0.10), #ffffff);
            border-bottom: 1px solid #e2e8f0;
        }

        .public-account-avatar {
            width: 48px;
            height: 48px;
            min-width: 48px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #ffffff;
            box-shadow: 0 10px 22px rgba(15, 23, 42, 0.12);
        }

        .public-account-info {
            min-width: 0;
        }

        .public-account-name {
            font-size: 0.94rem;
            font-weight: 900;
            color: #0f172a;
            line-height: 1.2;
            letter-spacing: -0.025em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 175px;
        }

        .public-account-role {
            display: inline-flex;
            align-items: center;
            margin-top: 0.24rem;
            padding: 0.16rem 0.55rem;
            border-radius: 999px;
            background-color: rgba(0, 174, 239, 0.14);
            color: var(--primary-color);
            font-size: 0.62rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.35px;
            line-height: 1.2;
        }

        .public-account-email {
            margin-top: 0.25rem;
            color: #64748b;
            font-size: 0.72rem;
            font-weight: 600;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 175px;
        }

        .public-account-divider {
            height: 1px;
            background-color: #e2e8f0;
            margin: 0;
        }

        .public-account-body {
            padding: 0.45rem;
        }

        .public-account-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.62rem;
            padding: 0.68rem 0.7rem;
            border-radius: 14px;
            border: none;
            background-color: transparent;
            color: #334155;
            text-decoration: none;
            transition: all 0.2s ease;
            text-align: left;
        }

            .public-account-item:hover {
                background-color: #f8fafc;
                color: var(--primary-color);
            }

        .public-account-item-icon {
            width: 34px;
            height: 34px;
            min-width: 34px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.88rem;
        }

        .public-icon-primary {
            background-color: rgba(13, 110, 253, 0.10);
            color: #0d6efd;
        }

        .public-icon-info {
            background-color: rgba(0, 174, 239, 0.10);
            color: var(--primary-color);
        }

        .public-icon-danger {
            background-color: rgba(239, 68, 68, 0.10);
            color: #ef4444;
        }

        .public-account-item-content {
            min-width: 0;
        }

        .public-account-item-title {
            display: block;
            font-size: 0.88rem;
            font-weight: 900;
            line-height: 1.2;
            letter-spacing: -0.015em;
        }

        .public-account-item-desc {
            display: block;
            margin-top: 0.16rem;
            color: #64748b;
            font-size: 0.7rem;
            font-weight: 600;
            line-height: 1.25;
        }

        .public-account-logout {
            color: #ef4444;
            font-weight: 900;
        }

            .public-account-logout:hover {
                background-color: rgba(239, 68, 68, 0.08);
                color: #ef4444;
            }

        .footer-modern {
            background-color: var(--dark-bg);
            color: #94a3b8;
            font-size: 0.9rem;
            margin-top: auto;
        }

        .footer-title {
            color: #fff;
            font-weight: 700;
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
        }

        .footer-link {
            color: #94a3b8;
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: color 0.2s, padding-left 0.2s;
        }

            .footer-link:hover {
                color: var(--primary-color);
                padding-left: 5px;
            }

        .social-btn {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.1);
            color: white;
            border-radius: 50%;
            margin-right: 8px;
            transition: all 0.3s;
            text-decoration: none;
        }

            .social-btn:hover {
                background: var(--primary-color);
                color: white;
                transform: translateY(-3px);
            }

        @@media (min-width: 992px) {
            .navbar-brand {
                flex: 0 0 240px;
            }

            .navbar-collapse {
                flex: 1;
            }

            .navbar-nav {
                flex: 1;
                justify-content: center;
            }

            .header-actions {
                flex: 0 0 390px;
            }
        }

        @@media (max-width: 991.98px) {
            .header-actions {
                margin-top: 18px;
                align-items: flex-start;
                justify-content: flex-start;
                flex-wrap: wrap;
            }

            .public-account-menu {
                width: 255px;
            }

            .public-user-btn {
                padding: 0.32rem 0.42rem 0.32rem 0.8rem;
            }

            .public-user-btn-name {
                max-width: 130px;
                font-size: 0.88rem;
            }

            .public-user-avatar-wrap,
            .public-user-avatar {
                width: 34px;
                height: 34px;
                min-width: 34px;
            }

            .public-account-name {
                max-width: 160px;
            }

            .public-account-email {
                max-width: 160px;
            }
        }
    </style>
</head>

<body class="@(ViewData["BodyClass"]?.ToString() ?? "")">

    @{
        Func<string, string, string> L = (key, fallback) =>
        {
            var value = Localizer[key].Value;

            return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
        };

        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var path = (Context.Request.Path.Value ?? "").TrimEnd('/');

        var isPaymentPage = string.Equals(controller, "Payment", StringComparison.OrdinalIgnoreCase);

        var isSuperAdmin = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("SuperAdmin");

        var isAdminLike = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Admin");

        var isListener = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Listener");

        var isReferee = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Referee");

        var isAuthor = User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Author");

        var isHomeIndexPage =
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);

        var isTenantConferenceHomePage = Tc.Current != null && isHomeIndexPage;
        var hideGlobalNavbar = isTenantConferenceHomePage;

        var slug =
        ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Tc.Current?.Slug
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

        var selectedConferenceId = SelectedConferenceService.GetSelectedConferenceId();
        var hasSelectedConference = selectedConferenceId.HasValue;

        var assignmentUrl = (hasSelectedConference && !string.IsNullOrWhiteSpace(slug))
        ? $"/{slug}/Admin/Assignment?conferenceId={selectedConferenceId!.Value}"
        : "/Admin/Assignment";

        var superAdminPanelUrl = "/Dashboard/SuperAdmin";

        var listenerPanelUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Dashboard"
        : "/Dashboard";

        var refereePanelUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Review/Index"
        : "/Review/Index";

        var authorPanelUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/Submission/Index"
        : "/Submission/Index";

        var requestCulture = Context.Features.Get<IRequestCultureFeature>();
        var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

        var currentShortCulture = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
        ? "EN"
        : "TR";

        Func<string, string, string, string> T = (key, trFallback, enFallback) =>
        {
            var value = Localizer[key].Value;

            if (!string.Equals(value, key, StringComparison.OrdinalIgnoreCase))
            {
                return value;
            }

            return currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
            ? enFallback
            : trFallback;
        };

        var returnUrl = string.IsNullOrEmpty(Context.Request.Path.Value)
        ? "/"
        : $"{Context.Request.Path}{Context.Request.QueryString}";

        var currentUser = SignInManager.IsSignedIn(User)
        ? await UserManager.GetUserAsync(User)
        : null;

        var publicDisplayName = currentUser != null
        ? $"{currentUser.FirstName} {currentUser.LastName}".Trim()
        : "";

        if (string.IsNullOrWhiteSpace(publicDisplayName))
        {
            publicDisplayName = currentUser?.Email ?? User.Identity?.Name ?? L("Role_User", "Kullanıcı");
        }

        var publicEmail = currentUser?.Email ?? User.Identity?.Name ?? "";

        var publicRoleText = L("Role_User", "Kullanıcı");
        var publicPanelUrl = "/Dashboard";
        var publicPanelText = L("Dropdown_Dashboard", "Panelim");
        var publicPanelIcon = "fas fa-gauge-high";

        if (isSuperAdmin)
        {
            publicRoleText = L("Role_SuperAdmin", "Süper Admin");
            publicPanelUrl = superAdminPanelUrl;
            publicPanelText = L("Dropdown_SystemPanel", "Sistem Paneli");
            publicPanelIcon = "fas fa-gauge-high";
        }
        else if (isAdminLike)
        {
            publicRoleText = L("Role_Admin", "Admin");
            publicPanelUrl = hasSelectedConference ? assignmentUrl : "/Dashboard";
            publicPanelText = L("Dropdown_ManagementPanel", "Yönetim Paneli");
            publicPanelIcon = "fas fa-briefcase";
        }
        else if (isReferee)
        {
            publicRoleText = L("Role_Referee", "Hakem");
            publicPanelUrl = refereePanelUrl;
            publicPanelText = L("Dropdown_RefereePanel", "Hakem Paneli");
            publicPanelIcon = "fas fa-gavel";
        }
        else if (isAuthor)
        {
            publicRoleText = L("Role_Author", "Yazar");
            publicPanelUrl = authorPanelUrl;
            publicPanelText = L("Dropdown_AuthorPanel", "Yazar Paneli");
            publicPanelIcon = "fas fa-file-alt";
        }
        else if (isListener)
        {
            publicRoleText = L("Role_Listener", "Dinleyici");
            publicPanelUrl = listenerPanelUrl;
            publicPanelText = L("Dropdown_Dashboard", "Panelim");
            publicPanelIcon = "fas fa-gauge-high";
        }

        var publicRoleUpper = publicRoleText.ToUpper(new CultureInfo("tr-TR"));

        var nameParts = publicDisplayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        var publicInitials = "U";

        if (nameParts.Length >= 2)
        {
            publicInitials = $"{nameParts[0][0]}{nameParts[nameParts.Length - 1][0]}";
        }
        else if (nameParts.Length == 1 && nameParts[0].Length >= 2)
        {
            publicInitials = nameParts[0].Substring(0, 2);
        }
        else if (!string.IsNullOrWhiteSpace(publicEmail))
        {
            publicInitials = publicEmail.Substring(0, Math.Min(2, publicEmail.Length));
        }

        publicInitials = publicInitials.ToUpper(new CultureInfo("tr-TR"));

        var publicProfileImg = !string.IsNullOrWhiteSpace(currentUser?.ProfileImagePath)
        ? currentUser.ProfileImagePath
        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(publicDisplayName)}&background=00aeef&color=fff&size=128&bold=true";
    }

    @if (hideGlobalNavbar)
    {
        <style>
            html,
            body {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

            main[role="main"] {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

            .navbar,
            header {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

            .conference-topbar,
            .conference-header,
            .tenant-header,
            .conference-page-header,
            .conference-hero,
            .hero-section,
            .page-hero,
            .site-hero {
                margin-top: 0 !important;
            }
        </style>
    }

    @if (!hideGlobalNavbar)
    {
        <header>
            <nav class="navbar navbar-expand-lg fixed-top">
                <div class="container">
                    <a class="navbar-brand" href="/">
                        ANT<span style="color: var(--primary-color);">ABSTRACT</span>
                    </a>

                    <button class="navbar-toggler border-0"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarNav"
                            aria-controls="navbarNav"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav mx-auto align-items-center">
                            <li class="nav-item">
                                <a class="nav-link" href="/">
                                    @Localizer["Menu_Home"]
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/about">
                                    @Localizer["Menu_About"]
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/congresses">
                                    @Localizer["Menu_Congresses"]
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Proceedings/Index">
                                    @Localizer["Menu_Proceedings"]
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/contact">
                                    @Localizer["Menu_Contact"]
                                </a>
                            </li>
                        </ul>

                        <div class="header-actions">
                            <div class="dropdown language-dropdown">
                                <button class="language-current-btn dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="fas fa-globe"></i>
                                    <span>@currentShortCulture</span>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end language-menu">
                                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="culture" value="tr-TR" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <button type="submit"
                                                class="language-menu-item @(currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                            <span class="language-code">TR</span>
                                            <span class="language-name">Türkçe</span>
                                        </button>
                                    </form>

                                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="culture" value="en-US" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                                        <button type="submit"
                                                class="language-menu-item @(currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                            <span class="language-code">EN</span>
                                            <span class="language-name">English</span>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            @if (SignInManager.IsSignedIn(User))
                            {
                                <div class="dropdown">
                                    <button class="public-user-btn"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="@L("AccountMenu", "Hesap menüsü")">
                                        <span class="public-user-btn-name">
                                            @publicDisplayName
                                        </span>

                                        <span class="public-user-avatar-wrap">
                                            <img src="@publicProfileImg"
                                                 class="public-user-avatar"
                                                 alt="@publicDisplayName" />

                                            <span class="public-user-online-dot"></span>
                                        </span>
                                    </button>

                                    <div class="dropdown-menu dropdown-menu-end public-account-menu">
                                        <div class="public-account-header">
                                            <img src="@publicProfileImg"
                                                 class="public-account-avatar"
                                                 alt="@publicDisplayName" />

                                            <div class="public-account-info">
                                                <div class="public-account-name">
                                                    @publicDisplayName
                                                </div>

                                                <div class="public-account-role">
                                                    @publicRoleUpper
                                                </div>

                                                <div class="public-account-email">
                                                    @publicEmail
                                                </div>
                                            </div>
                                        </div>

                                        <div class="public-account-body">
                                            <a class="public-account-item"
                                               href="@publicPanelUrl">
                                                <span class="public-account-item-icon public-icon-primary">
                                                    <i class="@publicPanelIcon"></i>
                                                </span>

                                                <span class="public-account-item-content">
                                                    <span class="public-account-item-title">
                                                        @publicPanelText
                                                    </span>
                                                </span>
                                            </a>

                                            @if (isSuperAdmin || isAdminLike)
                                            {
                                                <a class="public-account-item"
                                                   href="/Admin/EmailTemplates">
                                                    <span class="public-account-item-icon public-icon-warning">
                                                        <i class="fas fa-envelope-open-text"></i>
                                                    </span>

                                                    <span class="public-account-item-content">
                                                        <span class="public-account-item-title">
                                                            @L("Dropdown_EmailTemplates", "E-posta Şablonları")
                                                        </span>
                                                    </span>
                                                </a>
                                            }

                                            <a class="public-account-item"
                                               href="/Identity/Account/Manage">
                                                <span class="public-account-item-icon public-icon-info">
                                                    <i class="fas fa-user-gear"></i>
                                                </span>

                                                <span class="public-account-item-content">
                                                    <span class="public-account-item-title">
                                                        @L("Dropdown_Settings", "Hesap Ayarları")
                                                    </span>
                                                </span>
                                            </a>
                                        </div>

                                        <div class="public-account-divider"></div>

                                        <div class="public-account-body">
                                            <form asp-area=""
                                                  asp-controller="Dashboard"
                                                  asp-action="CustomLogout"
                                                  method="post"
                                                  class="m-0">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="public-account-item public-account-logout">
                                                    <span class="public-account-item-icon public-icon-danger">
                                                        <i class="fas fa-right-from-bracket"></i>
                                                    </span>

                                                    <span class="public-account-item-content">
                                                        <span class="public-account-item-title">
                                                            @L("Dropdown_Logout", "Çıkış Yap")
                                                        </span>
                                                    </span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <a href="/login" class="btn btn-outline-primary">
                                    @L("Login", "Giriş Yap")
                                </a>

                                <a href="/register" class="btn btn-primary">
                                    @L("Register", "Kayıt Ol")
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer-modern pt-5 pb-4">
        <div class="container">
            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <h5 class="text-white fw-bold mb-3">
                        <i class="fas fa-layer-group me-2 text-primary"></i>
                        ANT ABSTRACT
                    </h5>

                    <p class="mb-4" style="line-height: 1.8;">
                        @T(
                        "Footer_Description",
                                                "Akademik süreçlerinizi dijitalleştirin. Özet toplama, hakem değerlendirme ve katılımcı kayıt süreçlerinde güvenilir çözüm ortağınız.",
                                                "Digitize your academic processes. Your reliable solution partner for abstract submission, peer review and participant registration processes."
                                                )
                    </p>

                    <div class="d-flex">
                        <a href="#" class="social-btn" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>

                        <a href="#" class="social-btn" aria-label="LinkedIn">
                            <i class="fab fa-linkedin-in"></i>
                        </a>

                        <a href="#" class="social-btn" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>

                        <a href="#" class="social-btn" aria-label="YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-title">
                        @T("Footer_QuickLinks", "Hızlı Bağlantılar", "Quick Links")
                    </h6>

                    <a href="/" class="footer-link">
                        <i class="fas fa-chevron-right me-2 small text-primary"></i>
                        @T("Menu_Home", "Ana Sayfa", "Home")
                    </a>

                    <a href="/about" class="footer-link">
                        <i class="fas fa-chevron-right me-2 small text-primary"></i>
                        @T("Menu_About", "Hakkımızda", "About")
                    </a>

                    <a href="/congresses" class="footer-link">
                        <i class="fas fa-chevron-right me-2 small text-primary"></i>
                        @T("Menu_Congresses", "Kongreler", "Congresses")
                    </a>

                    <a href="/Proceedings/Index" class="footer-link">
                        <i class="fas fa-chevron-right me-2 small text-primary"></i>
                        @T("Menu_Proceedings", "Bildiri Kitabı", "Proceedings")
                    </a>

                    <a href="/contact" class="footer-link">
                        <i class="fas fa-chevron-right me-2 small text-primary"></i>
                        @T("Menu_Contact", "İletişim", "Contact")
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">
                        @T("Footer_Legal", "Yasal", "Legal")
                    </h6>

                    <a href="/privacy" class="footer-link">
                        <i class="fas fa-shield-alt me-2 text-primary"></i>
                        @T("PrivacyPolicy", "Gizlilik Politikası", "Privacy Policy")
                    </a>

                    <a href="/kvkk" class="footer-link">
                        <i class="fas fa-file-signature me-2 text-primary"></i>
                        KVKK
                    </a>

                    <a href="/cookies" class="footer-link">
                        <i class="fas fa-cookie-bite me-2 text-primary"></i>
                        @T("CookiePolicy", "Çerez Politikası", "Cookie Policy")
                    </a>

                    <a href="/terms" class="footer-link">
                        <i class="fas fa-file-contract me-2 text-primary"></i>
                        @T("TermsOfUse", "Kullanım Şartları", "Terms of Use")
                    </a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">
                        @T("Footer_ContactUs", "Bize Ulaşın", "Contact Us")
                    </h6>

                    <div class="d-flex mb-3">
                        <i class="fas fa-map-marker-alt text-primary mt-1 me-3"></i>
                        <span>
                            @T(
                                                        "Footer_Address",
                                                        "Teknokent Binası, Ar-Ge Blokları No:12, Antalya / Türkiye",
                                                        "Teknokent Building, R&D Blocks No:12, Antalya / Türkiye"
                                                        )
                        </span>
                    </div>

                    <div class="d-flex mb-3">
                        <i class="fas fa-phone text-primary mt-1 me-3"></i>
                        <span>+90 850 123 45 67</span>
                    </div>

                    <div class="d-flex">
                        <i class="fas fa-envelope text-primary mt-1 me-3"></i>
                        <span>destek@antabstract.com</span>
                    </div>
                </div>

            </div>

            <hr class="my-4 border-secondary opacity-25">

            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    &copy; @DateTime.Now.Year <strong>AntAbstract</strong>.
                    @T("Footer_AllRightsReserved", "Tüm hakları saklıdır.", "All rights reserved.")
                </div>

                <div class="col-md-6 text-center text-md-end">
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                        v2.1.0 Stable
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
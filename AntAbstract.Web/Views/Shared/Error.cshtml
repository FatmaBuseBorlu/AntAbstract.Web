@using AntAbstract.Web.Models.ViewModels.Shared
@model ErrorViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment

@{
    @* Buraya nesne atanıyordu; sekme başlığında sınıf adı yazıyordu. *@
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<style>
    .error-page {
        max-width: 640px;
        margin: 0 auto;
        padding: 4rem 1.5rem 5rem;
        text-align: center;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .error-icon {
        width: 92px;
        height: 92px;
        border-radius: 999px;
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.6rem;
        margin-bottom: 1.4rem;
    }

    .error-title {
        color: #0f172a;
        font-size: 1.6rem;
        font-weight: 900;
        margin-bottom: 0.6rem;
    }

    .error-message {
        color: #64748b;
        font-size: 1.02rem;
        line-height: 1.65;
        margin-bottom: 1.6rem;
    }

    .error-request-id {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        border-radius: 10px;
        padding: 0.55rem 1rem;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 1.6rem;
        word-break: break-all;
    }

    .error-home-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        background: #00aeef;
        color: #ffffff;
        border-radius: 12px;
        padding: 0.78rem 1.6rem;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 10px 24px rgba(0, 174, 239, 0.28);
    }

    .error-home-btn:hover {
        color: #ffffff;
        text-decoration: none;
    }

    .error-dev-box {
        margin-top: 2.5rem;
        text-align: left;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 14px;
        padding: 1.1rem 1.25rem;
        color: #92400e;
        font-size: 0.9rem;
        line-height: 1.6;
    }
</style>

<div class="error-page">
    <div class="error-icon">
        <i class="fas fa-triangle-exclamation"></i>
    </div>

    <h1 class="error-title">@Localizer["PageTitle"]</h1>

    <p class="error-message">@Localizer["ErrorMessage"]</p>

    @if (Model.ShowRequestId)
    {
        <div class="error-request-id">
            @Localizer["RequestIdHeader"]: <code>@Model.RequestId</code>
        </div>

        <div></div>
    }

    <a href="/" class="error-home-btn">
        <i class="fas fa-house"></i>
        @Localizer["BackToHome"]
    </a>

    @* Geliştirici açıklaması son kullanıcıya gösterilmemeli; eskiden her
       ortamda basılıyordu. Üstelik LocalizedHtmlString doğrudan yazdırıldığı
       için metin yerine sınıf adı çıkıyordu. *@
    @if (HostEnvironment.IsDevelopment())
    {
        <div class="error-dev-box">
            <strong>@Localizer["DevModeHeader"]</strong>
            <p class="mb-1 mt-2">@Localizer["DevModeInfo1"]</p>
            <p class="mb-0">@Localizer["DevModeInfo2"]</p>
        </div>
    }
</div>

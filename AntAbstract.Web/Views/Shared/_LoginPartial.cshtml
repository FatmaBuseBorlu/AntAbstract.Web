@using AntAbstract.Domain.Entities
@using AntAbstract.Infrastructure.Services.Conferences
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject AntAbstract.Infrastructure.Context.TenantContext Tc
@inject ISelectedConferenceService SelectedConferenceService
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var isSignedIn = SignInManager.IsSignedIn(User);

    var slug =
        ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Tc.Current?.Slug
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var selectedConferenceId = SelectedConferenceService.GetSelectedConferenceId();
    var hasSelectedConference = selectedConferenceId.HasValue;
}

@if (isSignedIn)
{
    var user = await UserManager.GetUserAsync(User);

    var displayName = user != null
        ? $"{user.FirstName} {user.LastName}".Trim()
        : User.Identity?.Name;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = user?.Email ?? Localizer["DefaultUserName"].Value;
    }

    var profileImg = !string.IsNullOrWhiteSpace(user?.ProfileImagePath)
        ? user.ProfileImagePath
        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&background=00aeef&color=fff&size=128&bold=true";

    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");
    var isAuthor = User.IsInRole("Author");
    var isListener = User.IsInRole("Listener");
    var isReferee = User.IsInRole("Referee");

    var roleText = Localizer["Role_User"].Value;

    if (isSuperAdmin)
    {
        roleText = Localizer["Role_SuperAdmin"].Value;
    }
    else if (isAdmin)
    {
        roleText = Localizer["Role_Admin"].Value;
    }
    else if (isReferee)
    {
        roleText = Localizer["Role_Referee"].Value;
    }
    else if (isAuthor)
    {
        roleText = Localizer["Role_Author"].Value;
    }
    else if (isListener)
    {
        roleText = Localizer["Role_Listener"].Value;
    }

    var panelUrl = "/Dashboard";

    if (isSuperAdmin)
    {
        panelUrl = "/Dashboard/SuperAdmin";
    }
    else if (!string.IsNullOrWhiteSpace(slug))
    {
        panelUrl = $"/{slug}/Dashboard";
    }

    <div class="dropdown">
        <button class="public-user-btn"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            <span class="public-user-btn-name d-none d-xl-inline">
                @displayName
            </span>

            <img src="@profileImg"
                 class="public-user-avatar"
                 alt="@displayName" />
        </button>

        <div class="dropdown-menu dropdown-menu-end public-account-menu">

            <div class="public-account-header">
                <img src="@profileImg"
                     class="public-account-avatar"
                     alt="@displayName" />

                <div class="public-account-info">
                    <div class="public-account-name">
                        @displayName
                    </div>

                    <div class="public-account-role">
                        @roleText
                    </div>

                    <div class="public-account-email">
                        @(user?.Email ?? User.Identity?.Name)
                    </div>
                </div>
            </div>

            <div class="public-account-divider"></div>

            <div class="public-account-body">
                <a href="@panelUrl" class="public-account-item">
                    <span class="public-account-item-icon public-icon-primary">
                        <i class="fas fa-gauge-high"></i>
                    </span>

                    <span>
                        <span class="public-account-item-title">
                            @Localizer["SystemPanel"]
                        </span>
                    </span>
                </a>

                <a href="/Identity/Account/Manage" class="public-account-item">
                    <span class="public-account-item-icon public-icon-info">
                        <i class="fas fa-user-cog"></i>
                    </span>

                    <span>
                        <span class="public-account-item-title">
                            @Localizer["AccountSettings"]
                        </span>
                    </span>
                </a>
            </div>

            <div class="public-account-divider"></div>

            <div class="public-account-body">
                <form asp-area=""
                      asp-controller="Dashboard"
                      asp-action="CustomLogout"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="public-account-item public-account-logout">
                        <span class="public-account-item-icon public-icon-danger">
                            <i class="fas fa-sign-out-alt"></i>
                        </span>

                        <span>
                            <span class="public-account-item-title">
                                @Localizer["Logout"]
                            </span>
                        </span>
                    </button>
                </form>
            </div>

        </div>
    </div>
}
else
{
    <a href="/login" class="btn btn-outline-dark">
        @Localizer["Login"]
    </a>

    <a href="/register" class="btn btn-primary">
        @Localizer["Register"]
    </a>
}
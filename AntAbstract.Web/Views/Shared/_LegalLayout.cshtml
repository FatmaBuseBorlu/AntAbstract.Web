@using System.Globalization
@{
    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
</head>
<body style="font-family:'Plus Jakarta Sans',sans-serif;background:#f8fafc;">
    <nav style="background:#fff;border-bottom:1px solid #e2e8f0;padding:.75rem 0;box-shadow:0 2px 12px rgba(15,23,42,0.04);">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/" style="text-decoration:none;font-size:1.3rem;font-weight:900;color:#0f172a;">
                ANT<span style="color:#00aeef;">ABSTRACT</span>
            </a>
            <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary" style="border-radius:999px;font-weight:800;font-size:.82rem;">
                <i class="fas fa-arrow-left me-1"></i> @(isEnglish ? "Back" : "Geri Dön")
            </a>
        </div>
    </nav>

    @RenderBody()

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

                        <i class="fas fa-calendar-plus text-primary"></i>
                        @L("Management_Conferences", "Kongrelerim / Kongre Oluştur")
                    </a>
                }
            }

            @if (!isSuperAdmin)
            {
                <div class="menu-label">@L("Section_Communication", "İletişim")</div>

                <a href="@messageIndexUrl"

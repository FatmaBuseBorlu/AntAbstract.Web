       tanimlayan bir gorunum (Yaka Karti) bu yuzden her acilisinda
       "sections have been defined but have not been rendered" hatasiyla
       500 veriyordu. *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <a href="/" class="sidebar-brand">
            ANT<span style="color: var(--primary-color);">ABSTRACT</span>
        </a>

        <div class="sidebar-menu">
            <div class="menu-label">@L("Section_General", "Genel")</div>

            <a href="@dashboardUrl"
               class="nav-link @(currentController == "Dashboard" && (currentAction == "Index" || currentAction == "SuperAdmin" || ((isAuthor || isListener) && currentAction == "MyConferences")) ? "active" : "")">
                <i class="fas fa-home"></i>
                @L("Dashboard_Home", "Ana Sayfa")
            </a>

            @if (isSuperAdmin)
            {
                <div class="menu-label text-info">
                    @L("Section_GlobalSystem", "Global Sistem")
                </div>

                <a href="/Admin/Tenants"
                   class="nav-link @(currentController == "Tenants" ? "active" : "")">
                    <i class="fas fa-building text-info"></i>
                    @L("Global_Institutions", "Kurumlar")
                </a>

                <a href="/Admin/Users"
                   class="nav-link @(currentController == "Users" ? "active" : "")">
                    <i class="fas fa-users-cog text-danger"></i>
                    @L("Management_Users", "Kullanıcılar")
                </a>

                <a href="/Admin/AllConferences"
                   class="nav-link @(currentController == "AllConferences" ? "active" : "")">
                    <i class="fas fa-calendar-alt text-primary"></i>
                    @L("Global_AllConferences", "Tüm Kongreler")
                </a>

                <a href="/Admin/CentralVitrin"
                   class="nav-link @(currentController == "CentralVitrin" ? "active" : "")">
                    <i class="fas fa-globe text-primary"></i>
                    @L("Global_CongressWebsites", "Kongre Siteleri")
                </a>

                <div class="menu-label text-success">
                    @L("Section_ContentManagement", "İçerik Yönetimi")
                </div>

                <a href="/Admin/PageBlocks"
                   class="nav-link @(currentController == "PageBlocks" ? "active" : "")">
                    <i class="fas fa-layer-group text-success"></i>
                    @L("Global_SiteSectionTemplates", "Site Bölüm Şablonları")
                </a>

                <div class="menu-label text-primary">
                    @L("Section_CongressOperations", "Kongre Operasyonları")
                </div>

                <a href="@conferenceFlowUrl"
                   class="nav-link @(currentController == "ConferenceFlow" ? "active" : "")">
                    <i class="fas fa-stream text-primary"></i>
                    @L("Management_CongressFlow", "Kongre Akışı")
                </a>

                <div class="menu-label text-warning">
                    @L("Section_CongressTools", "Kongre Araçları")
                </div>

                <a href="/Admin/EmailTemplates"
                   class="nav-link @(currentController == "EmailTemplates" ? "active" : "")">
                    <i class="fas fa-envelope-open-text text-primary"></i>
                    @L("Tools_EmailTemplates", "E-posta Şablonları")
                </a>

                <a href="/Admin/Broadcast"
                   class="nav-link @(currentController == "Broadcast" ? "active" : "")">
                    <i class="fas fa-paper-plane text-primary"></i>
                    @L("Tools_BulkEmail", "Toplu E-posta")
                </a>

                <a href="/Admin/PermissionMatrix"
                   class="nav-link @(currentController == "PermissionMatrix" ? "active" : "")">
                    <i class="fas fa-shield-alt text-info"></i>
                    @L("Tools_PermissionMatrix", "Yetki Matrisi")
                </a>

                <div class="menu-label text-secondary">
                    @L("Section_System", "Sistem")
                </div>

                <a href="/Admin/SystemParameters"
                   class="nav-link @(currentController == "SystemParameters" ? "active" : "")">
                    <i class="fas fa-cogs text-info"></i>
                    @L("Global_SystemParameters", "Sistem Parametreleri")
                </a>

                <a href="/Admin/SystemReports"
                   class="nav-link @(currentController == "SystemReports" ? "active" : "")">
                    <i class="fas fa-chart-line text-warning"></i>
                    @L("Global_SystemReports", "Sistem Raporları")
                </a>

                <a href="/Admin/AuditLogs"
                   class="nav-link @(currentController == "AuditLogs" ? "active" : "")">
                    <i class="fas fa-history text-secondary"></i>
                    @L("System_AuditLog", "Denetim Günlüğü")
                </a>

                <a href="/Admin/Health"
                   class="nav-link @(currentController == "Health" ? "active" : "")">
                    <i class="fas fa-heartbeat text-danger"></i>
                    @L("System_Health", "Sistem Sağlığı")
                </a>
            }

            @if (!isSuperAdmin && !isManagementTeam)
            {
                if (isReferee)
                {
                    <div class="menu-label">@L("Section_Referee", "Hakem")</div>

                    <a href="@reviewIndexUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Index" ? "active" : "")">
                        <i class="fas fa-gavel text-warning"></i>
                        @L("Referee_MyTasks", "Görevlerim")
                    </a>

                    <a href="@reviewInterestsUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Interests" ? "active" : "")">
                        <i class="fas fa-tags text-info"></i>
                        @L("Referee_Expertise", "Uzmanlık Alanlarım")
                    </a>

                    <a href="@reviewAvailabilityUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Availability" ? "active" : "")">
                        <i class="fas fa-calendar-times text-danger"></i>
                        @L("Referee_Availability", "Müsaitlik Durumu")
                    </a>

                    <a href="@reviewConflictsUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Conflicts" ? "active" : "")">
                        <i class="fas fa-handshake-slash text-secondary"></i>
                        @L("Referee_Conflicts", "Çıkar Çatışmaları")
                    </a>

                    <a href="@reviewGuidelinesUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Guidelines" ? "active" : "")">
                        <i class="fas fa-book-open text-primary"></i>
                        @L("Referee_Guide", "Hakem Rehberi")
                    </a>

                    <a href="@certificatesIndexUrl"
                       class="nav-link @(currentController == "Certificates" ? "active" : "")">
                        <i class="fas fa-certificate text-success"></i>
                        @L("Referee_Certificates", "Sertifikalarım")
                    </a>
                }

                @* "Başvurular" başlığı yalnızca dinleyiciye basılıyordu; yazarın
                   bildiri bağlantıları başlıksız kalıp "Genel" bölümüne yapışık
                   görünüyordu. Başlık artık bölüm doluysa çıkıyor. *@
                var hasSubmissionSection = isListener || (isAuthor && hasSelectedConference);

                if (hasSubmissionSection)
                {
                    <div class="menu-label">@L("Section_Submissions", "Başvurular")</div>
                }

                if (isListener)
                {
                    <a href="@dashboardMyConferencesUrl"
                       class="nav-link @(currentController == "Dashboard" && currentAction == "MyConferences" ? "active" : "")">
                        <i class="fas fa-calendar-check text-primary"></i>
                        @L("Common_SelectConference", "Kongre Seç")
                    </a>
                }

                if (isAuthor && hasSelectedConference)
                {
                    <a href="@submissionCreateUrl"
                       class="nav-link @(currentController == "Submission" && currentAction == "Create" ? "active" : "")">
                        <i class="fas fa-plus-circle text-success"></i>
                        @L("Author_NewSubmission", "Bildiri Gönder")
                    </a>

                    <a href="@submissionIndexUrl"
                       class="nav-link @(currentController == "Submission" && currentAction == "Index" ? "active" : "")">
                        <i class="fas fa-file-contract text-info"></i>
                        @L("Author_MySubmissions", "Bildirilerim")
                    </a>
                }

                if ((isAuthor || isListener) && hasSelectedConference)
                {
                    <div class="menu-label">@L("Section_Congress", "Kongre")</div>

                    <a href="@programUrl"
                       class="nav-link @(currentController == "Program" ? "active" : "")">
                        <i class="fas fa-calendar-day text-danger"></i>
                        @L("Congress_Program", "Program")
                    </a>

                    <a href="@proceedingsUrl"
                       class="nav-link @(currentController == "Dashboard" && currentAction == "ProceedingBook" ? "active" : "")">
                        <i class="fas fa-book" style="color: #6f42c1;"></i>
                        @L("Congress_Proceedings", "Bildiri Kitabı")
                    </a>

                    <a href="@paymentMyUrl"
                       class="nav-link @(currentController == "Payment" ? "active" : "")">
                        <i class="fas fa-file-invoice-dollar text-info"></i>
                        @L("Congress_MyPayments", "Ödemelerim")
                    </a>

                    <a href="@accommodationUrl"
                       class="nav-link @(currentController == "Accommodation" ? "active" : "")">
                        <i class="fas fa-hotel text-warning"></i>
                        @L("Congress_Accommodation", "Konaklama")
                    </a>

                    <a href="@certificatesIndexUrl"
                       class="nav-link @(currentController == "Certificates" ? "active" : "")">
                        <i class="fas fa-certificate text-success"></i>
                        @L("Congress_Certificates", "Sertifikalarım")
                    </a>
                }
            }

            @* Blok eskiden SuperAdmin'i tümüyle dışlıyordu; kongre yönetim
               ekranlarının tamamı artık yönetim ekibine açık. *@
            @if (isManagementTeam)
            {
                @if (hasSelectedConference)
                {
                    <div class="menu-label text-primary">
                        @L("Section_CongressOperations", "Kongre Operasyonları")
                    </div>

                    <a href="@conferenceFlowUrl"
                       class="nav-link @(currentController == "ConferenceFlow" ? "active" : "")">
                        <i class="fas fa-stream text-primary"></i>
                        @L("Management_CongressFlow", "Kongre Akışı")
                    </a>

                    <a href="@submissionsAdminUrl"
                       class="nav-link @(currentController == "Submissions" ? "active" : "")">
                        <i class="fas fa-file-alt text-primary"></i>
                        @L("Management_AllApplications", "Bildiri Yönetimi")
                    </a>

                    <a href="@assignmentUrl"
                       class="nav-link @(currentController == "Assignment" && currentAction != "Workload" ? "active" : "")">
                        <i class="fas fa-tasks text-info"></i>
                        @L("Management_Assignment", "Hakem Atama")
                    </a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/Assignment/Workload?conferenceId={selectedConferenceId}" : $"/{slug}/Admin/Assignment/Workload?conferenceId={selectedConferenceId}")"
                       class="nav-link @(currentController == "Assignment" && currentAction == "Workload" ? "active" : "")">
                        <i class="fas fa-balance-scale text-info"></i>@Localizer["YukDengesi"]</a>

                    <a href="@decisionUrl"
                       class="nav-link @(currentController == "Decision" ? "active" : "")">
                        <i class="fas fa-gavel text-danger"></i>
                        @L("Management_DecisionScreen", "Karar Ekranı")
                    </a>

                    <a href="@refereeAdminUrl"
                       class="nav-link @(currentController == "Referee" ? "active" : "")">
                        <i class="fas fa-user-check text-warning"></i>
                        @L("Management_Referees", "Hakemler")
                    </a>

                    <a href="@certificatesIndexUrl"
                       class="nav-link @(currentController == "Certificates" ? "active" : "")">
                        <i class="fas fa-certificate text-success"></i>
                        @L("Management_Certificates", "Sertifikalar")
                    </a>

                    <div class="menu-label text-danger">
                        @L("Section_RegistrationProgram", "Kayıt ve Program")
                    </div>

                    <a href="@registrationsUrl"
                       class="nav-link @(currentController == "Registrations" ? "active" : "")">
                        <i class="fas fa-credit-card text-info"></i>
                        @L("System_RegistrationsPayments", "Kayıtlar ve Ödemeler")
                    </a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/Payments/FinanceSummary?conferenceId={selectedConferenceId}" : $"/{slug}/Admin/Payments/FinanceSummary?conferenceId={selectedConferenceId}")"
                       class="nav-link @(currentController == "Payments" && currentAction == "FinanceSummary" ? "active" : "")">
                        <i class="fas fa-chart-line text-success"></i>@Localizer["FinansOzeti"]</a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/Attendance?conferenceId={selectedConferenceId}" : $"/{slug}/Admin/Attendance?conferenceId={selectedConferenceId}")"
                       class="nav-link @(currentController == "Attendance" && currentAction != "Badges" ? "active" : "")">
                        <i class="fas fa-qrcode text-dark"></i>
                        Check-in
                    </a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/Attendance/Badges?conferenceId={selectedConferenceId}" : $"/{slug}/Admin/Attendance/Badges?conferenceId={selectedConferenceId}")"
                       class="nav-link @(currentController == "Attendance" && currentAction == "Badges" ? "active" : "")">
                        <i class="fas fa-id-badge text-primary"></i>@Localizer["YakaKartiBaski"]</a>

                    <a href="@registrationTypesUrl"
                       class="nav-link @(currentController == "RegistrationTypes" ? "active" : "")">
                        <i class="fas fa-tags text-primary"></i>
                        @L("System_RegistrationTypes", "Kayıt Türleri")
                    </a>

                    <a href="@conferenceTopicsUrl"
                       class="nav-link @(currentController == "ConferenceTopics" ? "active" : "")">
                        <i class="fas fa-layer-group text-success"></i>
                        @L("System_ConferenceTopics", "Bildiri Konuları")
                    </a>

                    <a href="@sessionUrl"
                       class="nav-link @(currentController == "Session" ? "active" : "")">
                        <i class="fas fa-microphone-alt text-success"></i>
                        @L("Management_Session", "Program / Oturumlar")
                    </a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/Speakers?conferenceId={selectedConferenceId}" : $"/{slug}/Admin/Speakers?conferenceId={selectedConferenceId}")"
                       class="nav-link @(currentController == "Speakers" ? "active" : "")">
                        <i class="fas fa-user-tie text-info"></i>@Localizer["DavetliKonusmacilar"]</a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/Sponsors?conferenceId={selectedConferenceId}" : $"/{slug}/Admin/Sponsors?conferenceId={selectedConferenceId}")"
                       class="nav-link @(currentController == "Sponsors" ? "active" : "")">
                        <i class="fas fa-handshake text-warning"></i>
                        Sponsorlar
                    </a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/ReviewCriteria?conferenceId={selectedConferenceId}" : $"/{slug}/Admin/ReviewCriteria?conferenceId={selectedConferenceId}")"
                       class="nav-link @(currentController == "ReviewCriteria" ? "active" : "")">
                        <i class="fas fa-star-half-alt text-warning"></i>@Localizer["DegerlendirmeKriterleri"]</a>

                    <a href="@reportsUrl"
                       class="nav-link @(currentController == "Reports" ? "active" : "")">
                        <i class="fas fa-chart-pie text-warning"></i>
                        @L("Management_Reports", "Raporlar")
                    </a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? "/Admin/Broadcast" : $"/{slug}/Admin/Broadcast")"
                       class="nav-link @(currentController == "Broadcast" ? "active" : "")">
                        <i class="fas fa-paper-plane text-primary"></i>
                        @L("Tools_BulkEmail", "Toplu E-posta")
                    </a>

                    <a href="@(string.IsNullOrWhiteSpace(slug) ? "/Admin/PermissionMatrix" : $"/{slug}/Admin/PermissionMatrix")"
                       class="nav-link @(currentController == "PermissionMatrix" ? "active" : "")">
                        <i class="fas fa-shield-alt text-secondary"></i>
                        @L("Tools_PermissionMatrix", "Yetki Matrisi")
                    </a>

                    <a href="@websiteAdminUrl"
                       class="nav-link @(currentController == "Website" ? "active" : "")">
                        <i class="fas fa-pen-to-square text-success"></i>
                        @L("System_WebsiteManagement", "Website Yönetimi")
                    </a>
                }
                else
                {
                    <div class="menu-label text-danger">
                        @L("Section_CongressOperations", "Kongre İşlemleri")
                    </div>

                    <a href="@conferencesUrl"
                       class="nav-link @(currentController == "Conferences" ? "active" : "")">
                        <i class="fas fa-calendar-plus text-primary"></i>
                        @L("Management_Conferences", "Kongrelerim / Kongre Oluştur")
                    </a>

                    @* Bu iki ekran yalnızca kongre seçiliyken menüde yer
                       alıyordu; panele yeni girildiğinde seçim henüz yapılmamış
                       olduğu için hiç görünmüyor, kullanıcı ekranların varlığını
                       fark edemiyordu. Adresler kongre seçme adımıyla başlıyor —
                       Kongre Akışı'nın forceSelect ile yaptığının aynısı. *@
                    <a href="/Admin/RegistrationTypes"
                       class="nav-link @(currentController == "RegistrationTypes" ? "active" : "")">
                        <i class="fas fa-tags text-primary"></i>
                        @L("System_RegistrationTypes", "Kayıt Türleri")
                    </a>

                    <a href="/Admin/ConferenceTopics"
                       class="nav-link @(currentController == "ConferenceTopics" ? "active" : "")">
                        <i class="fas fa-layer-group text-success"></i>
                        @L("System_ConferenceTopics", "Bildiri Konuları")
                    </a>
                }
            }

            @if (!isSuperAdmin)
            {
                <div class="menu-label">@L("Section_Communication", "İletişim")</div>

                <a href="@messageIndexUrl"
                   class="nav-link @(currentController == "Message" ? "active" : "")">
                    <i class="fas fa-envelope text-warning"></i>
                    @L("Common_Messages", "Mesajlar")
                </a>

                @if (isManagementTeam)
                {
                    var broadcastUrl = string.IsNullOrWhiteSpace(slug)
                        ? "/Admin/Broadcast"
                        : $"/{slug}/Admin/Broadcast";
                    <a href="@broadcastUrl"
                       class="nav-link @(currentController == "Broadcast" ? "active" : "")">
                        <i class="fas fa-paper-plane text-primary"></i>
                        @L("Tools_BulkEmail", "Toplu E-posta")
                    </a>

                    var attendanceUrl = string.IsNullOrWhiteSpace(slug)
                        ? "/Admin/Attendance/Scan"
                        : $"/{slug}/Admin/Attendance/Scan";
                    <a href="@attendanceUrl"
                       class="nav-link @(currentController == "Attendance" ? "active" : "")">
                        <i class="fas fa-qrcode text-success"></i>
                        QR Check-In
                    </a>

                    var attendanceListUrl = string.IsNullOrWhiteSpace(slug)
                        ? "/Admin/Attendance"
                        : $"/{slug}/Admin/Attendance";
                    <a href="@attendanceListUrl"
                       class="nav-link @(currentController == "Attendance" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-clipboard-check text-info"></i>@Localizer["KatilimciListesi"]</a>
                }
            }

            @if (isAdmin)
            {
                var auditUrl = string.IsNullOrWhiteSpace(slug)
                    ? "/Admin/AuditLogs"
                    : $"/{slug}/Admin/AuditLogs";
                <a href="@auditUrl"
                   class="nav-link @(currentController == "AuditLogs" ? "active" : "")">
                    <i class="fas fa-history text-secondary"></i>
                    @L("System_AuditLog", "Denetim Günlüğü")
                </a>

                var healthUrl = string.IsNullOrWhiteSpace(slug)
                    ? "/Admin/Health"
                    : $"/{slug}/Admin/Health";
                <a href="@healthUrl"
                   class="nav-link @(currentController == "Health" ? "active" : "")">
                    <i class="fas fa-heartbeat text-danger"></i>
                    @L("System_Health", "Sistem Sağlığı")
                </a>
            }
        </div>

        <div class="p-3 border-top mt-auto">
            <div class="menu-label m-0 mb-2">
                @L("Section_Help", "Yardım")
            </div>

            <a href="/Home/Contact" class="nav-link text-muted small justify-content-center">
                <i class="far fa-question-circle me-2"></i>
                @L("Common_SupportCenter", "Destek Merkezi")
            </a>
        </div>
    </aside>

    <div class="main-content">
        <header class="top-header">
            <div class="dashboard-header-left">
                <button class="sidebar-toggle-btn"
                        id="sidebarToggle"
                        type="button"
                        onclick="toggleSidebar()"
                        aria-label="@L("Common_Menu", "Menü")">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="dashboard-title-block d-none d-sm-block">
                    <div class="dashboard-title-row">
                        <h6 class="dashboard-title">
                            @displayName
                        </h6>

                        <span class="dashboard-role-pill">
                            @userRole
                        </span>
                    </div>

                    <div class="dashboard-subtitle">
                        @(string.IsNullOrWhiteSpace(headerBadgeText)
                            ? L("Header_ManagementPanel", "Yönetim Paneli")
                            : headerBadgeText)
                    </div>
                </div>
            </div>

            <div class="dashboard-header-actions">

                <a href="@publicSiteUrl"
                   target="_blank"
                   class="dashboard-site-link d-none d-md-inline-flex"
                   data-bs-toggle="tooltip"
                   title="@L("Header_BackToSiteTooltip", "Siteye dön")">
                    <i class="fas fa-external-link-alt"></i>
                    <span>@L("Header_Site", "Site")</span>
                </a>

                <div class="dropdown language-dropdown d-none d-sm-inline-flex">
                    <button class="language-dropdown-btn"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fas fa-globe"></i>
                        <span>@currentShortCulture</span>
                        <i class="fas fa-chevron-down language-chevron"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end language-dropdown-menu">
                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="culture" value="tr-TR" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item language-dropdown-item @(isTurkishCulture ? "active" : "")">
                                    <span class="language-code">TR</span>
                                    <span class="language-name">Türkçe</span>
                                </button>
                            </form>
                        </li>

                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="culture" value="en-US" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item language-dropdown-item @(isEnglishCulture ? "active" : "")">
                                    <span class="language-code">EN</span>
                                    <span class="language-name">English</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                @await Component.InvokeAsync("Notification")

                <button type="button" class="header-icon-btn" id="themeToggleBtn"
                        onclick="toggleTheme()" title="@Localizer["TemaDegistir"]">
                    <i class="fas fa-moon" id="themeIcon"></i>
                </button>

                <div class="dropdown account-dropdown">
                    <button class="user-menu-btn"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="@L("Common_AccountMenu", "Hesap menüsü")">

                        <span class="user-menu-name">
                            @shortDisplayName
                        </span>

                        <span class="user-avatar-wrapper">
                            <img src="@profileImg" class="user-avatar" alt="@displayName">
                        </span>

                        <i class="fas fa-chevron-down user-menu-chevron"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end account-dropdown-menu">

                        <div class="account-dropdown-header">
                            <img src="@profileImg"
                                 class="account-dropdown-avatar"
                                 alt="@displayName" />

                            <div class="account-dropdown-user-info">
                                <div class="account-dropdown-name">
                                    @displayName
                                </div>

                                <div class="account-dropdown-role">
                                    @userRole
                                </div>

                                <div class="account-dropdown-email">
                                    @(user?.Email ?? User.Identity?.Name)

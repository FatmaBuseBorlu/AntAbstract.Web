@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using AntAbstract.Domain.Entities
@using System
@using System.Globalization

@inject UserManager<AppUser> UserManager
@inject AntAbstract.Infrastructure.Context.TenantContext Tc
@inject IViewLocalizer Localizer

@{
    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;
        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
    };

    var user = await UserManager.GetUserAsync(User);

    var displayName = user != null
        ? $"{user.FirstName} {user.LastName}".Trim()
        : User.Identity?.Name;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = user?.Email ?? "Kullanıcı";
    }

    var profileImg = !string.IsNullOrWhiteSpace(user?.ProfileImagePath)
        ? user.ProfileImagePath
        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&background=00aeef&color=fff&size=128&bold=true";

    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");
    var isAuthor = User.IsInRole("Author");
    var isListener = User.IsInRole("Listener");
    var isReferee = User.IsInRole("Referee");

    var isManagementTeam = isAdmin || isSuperAdmin;

    string userRole = L("Role_User", "Kullanıcı");

    if (isSuperAdmin)
    {
        userRole = L("Role_SuperAdmin", "Süper Admin");
    }
    else if (isAdmin)
    {
        userRole = L("Role_Admin", "Admin");
    }
    else if (isReferee)
    {
        userRole = L("Role_Referee", "Hakem");
    }
    else if (isAuthor)
    {
        userRole = L("Role_Author", "Yazar");
    }
    else if (isListener)
    {
        userRole = L("Role_Listener", "Dinleyici");
    }

    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
                ?? Tc.Current?.Slug
                ?? Context.Session.GetString("SelectedConferenceSlug")
                ?? "";

    string? confIdStr = null;

    if (Tc.Current != null)
    {
        var tenantKey = $"SelectedConferenceId:{Tc.Current.Id}";
        confIdStr = Context.Session.GetString(tenantKey);
    }

    confIdStr ??= Context.Session.GetString("SelectedConferenceId");

    Guid? selectedConferenceId = Guid.TryParse(confIdStr, out var parsedId)
        ? parsedId
        : null;

    var hasSelectedConference = selectedConferenceId.HasValue;

    string? selectedConferenceTitle = null;

    if (Tc.Current != null)
    {
        selectedConferenceTitle = Context.Session.GetString($"SelectedConferenceTitle:{Tc.Current.Id}");
    }

    selectedConferenceTitle ??= Context.Session.GetString("SelectedConferenceTitle");

    var hideSelectedConferenceBar = ViewData["HideSelectedConferenceBar"] as bool? ?? false;

    var dashboardMyConferencesUrl = "/Dashboard/MyConferences";

    var dashboardUrl = isSuperAdmin
        ? "/Dashboard/SuperAdmin"
        : isAuthor || isListener
            ? "/Dashboard/MyConferences"
            : string.IsNullOrWhiteSpace(slug)
                ? "/Dashboard"
                : $"/{slug}/Dashboard";

    var changeSelectedConferenceUrl = isSuperAdmin
        ? "/Admin/ConferenceFlow?forceSelect=true"
        : dashboardMyConferencesUrl;

    var submissionsAdminUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Submissions"
        : $"/{slug}/Admin/Submissions";

    var submissionIndexUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Submission/Index"
        : $"/{slug}/Submission/Index";

    var submissionCreateUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Submission/Create"
        : $"/{slug}/Submission/Create";

    var reviewIndexUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Index"
        : $"/{slug}/Review/Index";

    var reviewInterestsUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Interests"
        : $"/{slug}/Review/Interests";

    var reviewAvailabilityUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Availability"
        : $"/{slug}/Review/Availability";

    var reviewConflictsUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Conflicts"
        : $"/{slug}/Review/Conflicts";

    var reviewGuidelinesUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Review/Guidelines"
        : $"/{slug}/Review/Guidelines";

    var certificatesIndexUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Certificates"
        : $"/{slug}/Certificates";

    var messageIndexUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Message/Index"
        : $"/{slug}/Message/Index";

    var paymentMyUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Payment/My"
        : $"/{slug}/Payment/My";

    var accommodationUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Accommodation/Index"
        : $"/{slug}/Accommodation/Index";

    var programUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Program/Index"
        : $"/{slug}/Program/Index";

    var proceedingsUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Proceedings/Index"
        : $"/{slug}/Proceedings/Index";

    var conferenceFlowUrl = isSuperAdmin
        ? hasSelectedConference && selectedConferenceId.HasValue && !string.IsNullOrWhiteSpace(slug)
            ? $"/{slug}/Admin/ConferenceFlow?conferenceId={selectedConferenceId.Value}"
            : "/Admin/ConferenceFlow?forceSelect=true"
        : string.IsNullOrWhiteSpace(slug)
            ? "/Admin/ConferenceFlow"
            : $"/{slug}/Admin/ConferenceFlow";

    var reportsUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Reports"
        : $"/{slug}/Admin/Reports";

    var assignmentUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Assignment"
        : $"/{slug}/Admin/Assignment";

    var decisionUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Decision"
        : $"/{slug}/Admin/Decision";

    var sessionUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Session"
        : $"/{slug}/Admin/Session";

    var conferencesUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Conferences"
        : $"/{slug}/Admin/Conferences";

    var registrationsUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Registrations"
        : $"/{slug}/Admin/Registrations";

    var registrationTypesUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/RegistrationTypes"
        : $"/{slug}/Admin/RegistrationTypes";

    var conferenceTopicsUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/ConferenceTopics"
        : $"/{slug}/Admin/ConferenceTopics";

    var websiteAdminUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Website"
        : $"/{slug}/Admin/Website";

    var headerBadgeText = isSuperAdmin
        ? L("Header_SystemManagement", "Sistem Yönetimi")
        : Tc.Current?.Name;

    if (!isSuperAdmin && string.IsNullOrWhiteSpace(headerBadgeText) && !string.IsNullOrWhiteSpace(slug))
    {
        headerBadgeText = slug;
    }

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var isTurkishCulture = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
    var isEnglishCulture = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var currentShortCulture = isEnglishCulture ? "EN" : "TR";

    var returnUrl = string.IsNullOrEmpty(Context.Request.Path.Value)
        ? "/"
        : $"{Context.Request.Path}{Context.Request.QueryString}";

    var publicSiteUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}"
        : "/";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --sidebar-width: 270px;
            --header-height: 72px;
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --primary-soft: rgba(0, 174, 239, 0.10);
            --dark-bg: #1e293b;
            --menu-text: #64748b;
            --menu-hover-bg: #f8fafc;
            --menu-active-bg: rgba(0, 174, 239, 0.08);
            --menu-active-text: #00aeef;
            --border-color: #e2e8f0;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --danger: #ef4444;
            --page-bg: #f3f4f6;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--page-bg);
            overflow-x: hidden;
            color: var(--text-dark);
        }

        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #ffffff;
            border-right: 1px solid var(--border-color);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease-in-out;
        }

        body.sidebar-closed .sidebar {
            left: calc(var(--sidebar-width) * -1);
        }

        .sidebar-brand {
            height: var(--header-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-size: 1.35rem;
            font-weight: 900;
            color: var(--dark-bg);
            border-bottom: 1px solid #f1f5f9;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .sidebar-menu {
            padding: 1rem;
            flex-grow: 1;
            overflow-y: auto;
            list-style: none;
        }

            .sidebar-menu::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar-menu::-webkit-scrollbar-thumb {
                background: #e2e8f0;
                border-radius: 10px;
            }

        .menu-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #94a3b8;
            font-weight: 800;
            letter-spacing: 0.8px;
            margin: 1.5rem 0 0.5rem 0.8rem;
        }

            .menu-label:first-child {
                margin-top: 0.5rem;
            }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: var(--menu-text);
            font-weight: 700;
            font-size: 0.9rem;
            border-radius: 0.75rem;
            margin-bottom: 0.2rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .nav-link:hover {
                background-color: var(--menu-hover-bg);
                color: var(--primary-color);
                transform: translateX(3px);
            }

            .nav-link.active {
                background-color: var(--menu-active-bg);
                color: var(--menu-active-text);
            }

            .nav-link i {
                width: 24px;
                font-size: 1rem;
                margin-right: 0.8rem;
                text-align: center;
            }

        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: all 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
        }

        body.sidebar-closed .main-content {
            margin-left: 0;
        }

        .top-header {
            height: var(--header-height);
            background-color: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.85);
            position: sticky;
            top: 0;
            z-index: 1040;
            padding: 0 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dashboard-header-left {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        .sidebar-toggle-btn {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            color: var(--primary-color);
            background: #ffffff;
            border: 1px solid #edf2f7;
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        }

            .sidebar-toggle-btn:hover {
                background-color: rgba(0, 174, 239, 0.08);
                color: var(--primary-color);
                border-color: rgba(0, 174, 239, 0.22);
                transform: translateY(-1px);
            }

        .dashboard-title-block {
            min-width: 0;
            margin-left: 0.9rem;
        }

        .dashboard-title-row {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            min-width: 0;
        }

        .dashboard-title {
            margin: 0;
            color: var(--text-dark);
            font-size: 1rem;
            font-weight: 900;
            line-height: 1.2;
            white-space: nowrap;
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dashboard-role-pill {
            display: inline-flex;
            align-items: center;
            padding: 0.16rem 0.55rem;
            border-radius: 999px;
            background-color: rgba(0, 174, 239, 0.12);
            color: var(--primary-color);
            font-size: 0.62rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.35px;
            white-space: nowrap;
        }

        .dashboard-subtitle {
            margin-top: 0.18rem;
            color: var(--text-muted);
            font-size: 0.76rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 360px;
        }

        .dashboard-header-actions {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .dashboard-site-link {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.55rem 0.95rem;
            border-radius: 999px;
            color: #64748b;
            background-color: #ffffff;
            border: 1px solid #dbe3ef;
            font-size: 0.86rem;
            font-weight: 900;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
            white-space: nowrap;
        }

            .dashboard-site-link:hover {
                color: var(--primary-color);
                background-color: #ffffff;
                border-color: rgba(0, 174, 239, 0.28);
                box-shadow: 0 10px 24px rgba(0, 174, 239, 0.10);
                transform: translateY(-1px);
            }

        .language-dropdown-btn {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.55rem 0.95rem;
            border-radius: 999px;
            border: 1px solid #dbe3ef;
            background-color: #ffffff;
            color: #475569;
            font-size: 0.9rem;
            font-weight: 900;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
            transition: all 0.2s ease;
        }

            .language-dropdown-btn:hover {
                border-color: rgba(0, 174, 239, 0.28);
                color: var(--primary-color);
                background-color: #ffffff;
                box-shadow: 0 10px 24px rgba(0, 174, 239, 0.10);
                transform: translateY(-1px);
            }

            .language-dropdown-btn .fa-globe {
                color: #64748b;
            }

        .language-chevron {
            font-size: 0.65rem;
            color: #64748b;
        }

        .language-dropdown-menu {
            min-width: 160px;
            padding: 8px;
            border: none !important;
            border-radius: 20px !important;
            background-color: #ffffff;
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.14);
            overflow: hidden;
            margin-top: 10px !important;
        }

            .language-dropdown-menu form {
                margin: 0;
            }

            .language-dropdown-menu li + li {
                margin-top: 4px;
            }

        .language-dropdown-item {
            width: 100%;
            min-height: 42px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            border: none;
            background: transparent;
            border-radius: 14px;
            padding: 0.58rem 0.75rem;
            color: #475569;
            transition: all 0.2s ease;
        }

            .language-dropdown-item:hover,
            .language-dropdown-item.active {
                background-color: rgba(0, 174, 239, 0.12);
                color: var(--primary-color);
            }

        .language-code {
            min-width: 22px;
            font-size: 0.74rem;
            font-weight: 900;
            color: var(--primary-color);
            letter-spacing: 0.25px;
        }

        .language-name {
            font-size: 0.9rem;
            font-weight: 800;
            color: inherit;
        }

        .header-icon-btn {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            color: #64748b;
            background: transparent;
            transition: all 0.2s;
            cursor: pointer;
            text-decoration: none;
        }

            .header-icon-btn:hover {
                background-color: #f1f5f9;
                color: var(--primary-color);
            }

        .position-relative .badge-notify {
            position: absolute;
            top: 2px;
            right: 2px;
            width: 8px;
            height: 8px;
            background-color: var(--danger);
            border-radius: 50%;
            border: 2px solid #fff;
        }

        .user-menu-btn {
            width: 46px;
            height: 46px;
            min-width: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 0;
            border-radius: 999px;
            background-color: #ffffff;
            border: 1px solid #dbe3ef;
            transition: all 0.2s ease;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.08);
            position: relative;
        }

            .user-menu-btn:hover {
                border-color: rgba(0, 174, 239, 0.32);
                box-shadow: 0 12px 28px rgba(0, 174, 239, 0.12);
                transform: translateY(-1px);
            }

            .user-menu-btn::after {
                content: "";
                width: 10px;
                height: 10px;
                border-radius: 999px;
                background-color: #22c55e;
                border: 2px solid #ffffff;
                position: absolute;
                right: 3px;
                bottom: 4px;
            }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #ffffff;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.10);
        }

        .user-role-badge {
            font-size: 0.6rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--primary-color);
            background-color: rgba(0, 174, 239, 0.1);
            padding: 2px 8px;
            border-radius: 10px;
            display: inline-block;
        }

        .account-dropdown-menu {
            width: 272px;
            padding: 0;
            border: none !important;
            border-radius: 22px !important;
            overflow: hidden;
            background-color: #ffffff;
            box-shadow: 0 22px 55px rgba(15, 23, 42, 0.16);
            margin-top: 12px !important;
        }

        .account-dropdown-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.95rem;
            background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 35%), linear-gradient(135deg, rgba(0, 174, 239, 0.08), #ffffff);
        }

        .account-dropdown-avatar {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #ffffff;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.11);
        }

        .account-dropdown-user-info {
            min-width: 0;
        }

        .account-dropdown-name {
            font-size: 0.9rem;
            font-weight: 900;
            color: #0f172a;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 175px;
        }

        .account-dropdown-role {
            display: inline-flex;
            align-items: center;
            margin-top: 0.23rem;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            background-color: rgba(0, 174, 239, 0.12);
            color: var(--primary-color);
            font-size: 0.58rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .account-dropdown-email {
            margin-top: 0.24rem;
            color: #64748b;
            font-size: 0.69rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 175px;
        }

        .account-dropdown-divider {
            height: 1px;
            background-color: #e2e8f0;
            margin: 0;
        }

        .account-dropdown-body {
            padding: 0.45rem;
        }

        .account-dropdown-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.65rem 0.7rem;
            border-radius: 15px;
            border: none;
            background-color: transparent;
            color: #334155;
            text-decoration: none;
            transition: all 0.2s ease;
            text-align: left;
        }

            .account-dropdown-item:hover {
                background-color: #f8fafc;
                color: var(--primary-color);
            }

        .account-dropdown-item-icon {
            width: 34px;
            height: 34px;
            min-width: 34px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
        }

        .account-icon-primary {
            background-color: rgba(13, 110, 253, 0.10);
            color: #0d6efd;
        }

        .account-icon-info {
            background-color: rgba(0, 174, 239, 0.10);
            color: var(--primary-color);
        }

        .account-icon-danger {
            background-color: rgba(239, 68, 68, 0.10);
            color: var(--danger);
        }

        .account-dropdown-item-content {
            min-width: 0;
        }

        .account-dropdown-item-title {
            display: block;
            font-size: 0.86rem;
            font-weight: 900;
            line-height: 1.2;
        }

        .account-dropdown-item-desc {
            display: block;
            margin-top: 0.16rem;
            font-size: 0.68rem;
            color: #64748b;
            line-height: 1.25;
        }

        .account-dropdown-logout {
            color: var(--danger);
            font-weight: 900;
        }

            .account-dropdown-logout:hover {
                background-color: rgba(239, 68, 68, 0.08);
                color: var(--danger);
            }

        .content-wrapper {
            padding: 2rem;
            flex-grow: 1;
        }

        .selected-conference-banner {
            border: 1px solid rgba(0, 174, 239, 0.18);
            background: linear-gradient(135deg, rgba(0, 174, 239, 0.10), rgba(255, 255, 255, 0.95));
            border-radius: 18px;
            padding: 1rem 1.2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.04);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .selected-conference-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background-color: var(--primary-color);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 8px 18px rgba(0, 174, 239, 0.25);
        }

        .selected-conference-title {
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .selected-conference-subtitle {
            font-size: 0.78rem;
            color: #64748b;
            font-weight: 600;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.48);
            z-index: 1045;
        }

        @@media (max-width: 991px) {
            .sidebar {
                transform: translateX(-100%);
                left: 0;
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0 !important;
            }

            .content-wrapper {
                padding: 1rem;
            }

            .sidebar-overlay.show {
                display: block;
            }

            .top-header {
                padding: 0 1rem;
            }

            body.sidebar-closed .sidebar {
                left: 0;
            }

            .dashboard-site-link {
                display: none !important;
            }

            .language-dropdown {
                display: none !important;
            }

            .dashboard-title-block {
                display: none;
            }

            .user-menu-btn {
                width: 42px;
                height: 42px;
                min-width: 42px;
                border: none;
                background: transparent;
                box-shadow: none;
            }

            .user-avatar {
                width: 36px;
                height: 36px;
                border-width: 2px;
            }

            .selected-conference-banner {
                align-items: flex-start;
                flex-direction: column;
            }

            .account-dropdown-menu {
                width: 255px;
            }
        }
    </style>
</head>

<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <a href="/" class="sidebar-brand">
            ANT<span style="color: var(--primary-color);">ABSTRACT</span>
        </a>

        <div class="sidebar-menu">
            <div class="menu-label">@L("Section_General", "Genel")</div>

            <a href="@dashboardUrl"
               class="nav-link @(currentController == "Dashboard" && (currentAction == "Index" || currentAction == "SuperAdmin" || ((isAuthor || isListener) && currentAction == "MyConferences")) ? "active" : "")">
                <i class="fas fa-home"></i>
                @L("Dashboard_Home", "Ana Sayfa")
            </a>

            @if (isSuperAdmin)
            {
                <div class="menu-label text-info">
                    @L("Section_GlobalSystem", "Global Sistem")
                </div>

                <a href="/Admin/Tenants"
                   class="nav-link @(currentController == "Tenants" ? "active" : "")">
                    <i class="fas fa-building text-info"></i>
                    @L("Global_Institutions", "Kurumlar")
                </a>

                <a href="/Admin/Users"
                   class="nav-link @(currentController == "Users" ? "active" : "")">
                    <i class="fas fa-users-cog text-danger"></i>
                    @L("Management_Users", "Kullanıcılar")
                </a>

                <a href="/Admin/AllConferences"
                   class="nav-link @(currentController == "AllConferences" ? "active" : "")">
                    <i class="fas fa-calendar-alt text-primary"></i>
                    @L("Global_AllConferences", "Tüm Kongreler")
                </a>

                <a href="/Admin/CentralVitrin"
                   class="nav-link @(currentController == "CentralVitrin" ? "active" : "")">
                    <i class="fas fa-globe text-primary"></i>
                    @L("Global_CongressWebsites", "Kongre Siteleri")
                </a>

                <a href="/Admin/PageBlocks"
                   class="nav-link @(currentController == "PageBlocks" ? "active" : "")">
                    <i class="fas fa-layer-group text-success"></i>
                    @L("Global_SiteSectionTemplates", "Site Bölüm Şablonları")
                </a>

                <a href="/Admin/SystemParameters"
                   class="nav-link @(currentController == "SystemParameters" ? "active" : "")">
                    <i class="fas fa-cogs text-info"></i>
                    @L("Global_SystemParameters", "Sistem Parametreleri")
                </a>

                <a href="/Admin/SystemReports"
                   class="nav-link @(currentController == "SystemReports" ? "active" : "")">
                    <i class="fas fa-chart-line text-warning"></i>
                    @L("Global_SystemReports", "Sistem Raporları")
                </a>

                <div class="menu-label text-primary">
                    @L("Section_CongressOperations", "Kongre Operasyonları")
                </div>

                <a href="/Admin/ConferenceFlow?forceSelect=true"
                   class="nav-link @(currentController == "ConferenceFlow" ? "active" : "")">
                    <i class="fas fa-stream text-primary"></i>
                    @L("Management_CongressFlow", "Kongre Akışı")
                </a>
            }

            @if (!isSuperAdmin && !isManagementTeam)
            {
                if (isReferee)
                {
                    <div class="menu-label">@L("Section_Referee", "Hakem")</div>

                    <a href="@reviewIndexUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Index" ? "active" : "")">
                        <i class="fas fa-gavel text-warning"></i>
                        @L("Referee_MyTasks", "Görevlerim")
                    </a>

                    <a href="@reviewInterestsUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Interests" ? "active" : "")">
                        <i class="fas fa-tags text-info"></i>
                        @L("Referee_Expertise", "Uzmanlık Alanlarım")
                    </a>

                    <a href="@reviewAvailabilityUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Availability" ? "active" : "")">
                        <i class="fas fa-calendar-times text-danger"></i>
                        @L("Referee_Availability", "Müsaitlik Durumu")
                    </a>

                    <a href="@reviewConflictsUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Conflicts" ? "active" : "")">
                        <i class="fas fa-handshake-slash text-secondary"></i>
                        @L("Referee_Conflicts", "Çıkar Çatışmaları")
                    </a>

                    <a href="@reviewGuidelinesUrl"
                       class="nav-link @(currentController == "Review" && currentAction == "Guidelines" ? "active" : "")">
                        <i class="fas fa-book-open text-primary"></i>
                        @L("Referee_Guide", "Hakem Rehberi")
                    </a>

                    <a href="@certificatesIndexUrl"
                       class="nav-link @(currentController == "Certificates" ? "active" : "")">
                        <i class="fas fa-certificate text-success"></i>
                        @L("Referee_Certificates", "Sertifikalarım")
                    </a>
                }

                if (isAuthor || isListener)
                {
                    <div class="menu-label">@L("Section_Submissions", "Başvurular")</div>

                    <a href="@dashboardMyConferencesUrl"
                       class="nav-link @(currentController == "Dashboard" && currentAction == "MyConferences" ? "active" : "")">
                        <i class="fas fa-calendar-check text-primary"></i>
                        @L("Common_SelectConference", "Kongre Seç")
                    </a>
                }

                if (isAuthor && hasSelectedConference)
                {
                    <a href="@submissionCreateUrl"
                       class="nav-link @(currentController == "Submission" && currentAction == "Create" ? "active" : "")">
                        <i class="fas fa-plus-circle text-success"></i>
                        @L("Author_NewSubmission", "Bildiri Gönder")
                    </a>

                    <a href="@submissionIndexUrl"
                       class="nav-link @(currentController == "Submission" && currentAction == "Index" ? "active" : "")">
                        <i class="fas fa-file-contract text-info"></i>
                        @L("Author_MySubmissions", "Başvurularım")
                    </a>
                }

                if ((isAuthor || isListener) && hasSelectedConference)
                {
                    <div class="menu-label">@L("Section_Congress", "Kongre")</div>

                    <a href="@programUrl"
                       class="nav-link @(currentController == "Program" ? "active" : "")">
                        <i class="fas fa-calendar-day text-danger"></i>
                        @L("Congress_Program", "Program")
                    </a>

                    <a href="@proceedingsUrl"
                       class="nav-link @(currentController == "Proceedings" ? "active" : "")">
                        <i class="fas fa-book" style="color: #6f42c1;"></i>
                        @L("Congress_Proceedings", "Bildiri Kitabı")
                    </a>

                    <a href="@paymentMyUrl"
                       class="nav-link @(currentController == "Payment" ? "active" : "")">
                        <i class="fas fa-file-invoice-dollar text-info"></i>
                        @L("Congress_MyPayments", "Ödemelerim")
                    </a>

                    <a href="@accommodationUrl"
                       class="nav-link @(currentController == "Accommodation" ? "active" : "")">
                        <i class="fas fa-hotel text-warning"></i>
                        @L("Congress_Accommodation", "Konaklama")
                    </a>

                    <a href="@certificatesIndexUrl"
                       class="nav-link @(currentController == "Certificates" ? "active" : "")">
                        <i class="fas fa-certificate text-success"></i>
                        @L("Congress_Certificates", "Sertifikalarım")
                    </a>
                }
            }
            @if (!isSuperAdmin && isManagementTeam)
            {
                @if (hasSelectedConference)
                {
                    <div class="menu-label text-primary">
                        @L("Section_CongressOperations", "Kongre Operasyonları")
                    </div>

                    <a href="@conferenceFlowUrl"
                       class="nav-link @(currentController == "ConferenceFlow" ? "active" : "")">
                        <i class="fas fa-stream text-primary"></i>
                        @L("Management_CongressFlow", "Kongre Akışı")
                    </a>

                    <a href="@submissionsAdminUrl"
                       class="nav-link @(currentController == "Submissions" ? "active" : "")">
                        <i class="fas fa-file-alt text-primary"></i>
                        @L("Management_AllApplications", "Bildiri Yönetimi")
                    </a>

                    <a href="@assignmentUrl"
                       class="nav-link @(currentController == "Assignment" ? "active" : "")">
                        <i class="fas fa-tasks text-info"></i>
                        @L("Management_Assignment", "Hakem Atama")
                    </a>

                    <a href="@decisionUrl"
                       class="nav-link @(currentController == "Decision" ? "active" : "")">
                        <i class="fas fa-gavel text-danger"></i>
                        @L("Management_DecisionScreen", "Karar Ekranı")
                    </a>

                    <a href="/Admin/Referee"
                       class="nav-link @(currentController == "Referee" ? "active" : "")">
                        <i class="fas fa-user-check text-warning"></i>
                        @L("Management_Referees", "Hakemler")
                    </a>

                    <a href="@certificatesIndexUrl"
                       class="nav-link @(currentController == "Certificates" ? "active" : "")">
                        <i class="fas fa-certificate text-success"></i>
                        @L("Management_Certificates", "Sertifikalar")
                    </a>

                    <div class="menu-label text-danger">
                        @L("Section_RegistrationProgram", "Kayıt ve Program")
                    </div>

                    <a href="@registrationsUrl"
                       class="nav-link @(currentController == "Registrations" ? "active" : "")">
                        <i class="fas fa-credit-card text-info"></i>
                        @L("System_RegistrationsPayments", "Kayıtlar ve Ödemeler")
                    </a>

                    <a href="@registrationTypesUrl"
                       class="nav-link @(currentController == "RegistrationTypes" ? "active" : "")">
                        <i class="fas fa-tags text-primary"></i>
                        @L("System_RegistrationTypes", "Kayıt Türleri")
                    </a>

                    <a href="@conferenceTopicsUrl"
                       class="nav-link @(currentController == "ConferenceTopics" ? "active" : "")">
                        <i class="fas fa-layer-group text-success"></i>
                        @L("System_ConferenceTopics", "Bildiri Konuları")
                    </a>

                    <a href="@sessionUrl"
                       class="nav-link @(currentController == "Session" ? "active" : "")">
                        <i class="fas fa-microphone-alt text-success"></i>
                        @L("Management_Session", "Program / Oturumlar")
                    </a>

                    <a href="@reportsUrl"
                       class="nav-link @(currentController == "Reports" ? "active" : "")">
                        <i class="fas fa-chart-pie text-warning"></i>
                        @L("Management_Reports", "Raporlar")
                    </a>

                    <a href="@websiteAdminUrl"
                       class="nav-link @(currentController == "Website" ? "active" : "")">
                        <i class="fas fa-pen-to-square text-success"></i>
                        @L("System_WebsiteManagement", "Website Yönetimi")
                    </a>
                }
                else
                {
                    <div class="menu-label text-danger">
                        @L("Section_CongressOperations", "Kongre İşlemleri")
                    </div>

                    <a href="@conferencesUrl"
                       class="nav-link @(currentController == "Conferences" ? "active" : "")">
                        <i class="fas fa-calendar-plus text-primary"></i>
                        @L("Management_Conferences", "Kongrelerim / Kongre Oluştur")
                    </a>
                }
            }

            @if (!isSuperAdmin)
            {
                <div class="menu-label">@L("Section_Communication", "İletişim")</div>

                <a href="@messageIndexUrl"
                   class="nav-link @(currentController == "Message" ? "active" : "")">
                    <i class="fas fa-envelope text-warning"></i>
                    @L("Common_Messages", "Mesajlar")
                </a>
            }
        </div>

        <div class="p-3 border-top mt-auto">
            <a href="/Home/Contact" class="nav-link text-muted small justify-content-center">
                <i class="far fa-question-circle me-2"></i>
                @L("Common_SupportCenter", "Destek Merkezi")
            </a>
        </div>
    </aside>

    <div class="main-content">
        <header class="top-header">
            <div class="dashboard-header-left">
                <button class="sidebar-toggle-btn"
                        id="sidebarToggle"
                        type="button"
                        onclick="toggleSidebar()"
                        aria-label="@L("Common_Menu", "Menü")">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="dashboard-title-block d-none d-sm-block">
                    <div class="dashboard-title-row">
                        <h6 class="dashboard-title">
                            @displayName
                        </h6>

                        <span class="dashboard-role-pill">
                            @userRole
                        </span>
                    </div>

                    <div class="dashboard-subtitle">
                        @(string.IsNullOrWhiteSpace(headerBadgeText)
                                                ? L("Header_ManagementPanel", "Yönetim Paneli")
                                                : headerBadgeText)
                    </div>
                </div>
            </div>

            <div class="dashboard-header-actions">

                <a href="@publicSiteUrl"
                   target="_blank"
                   class="dashboard-site-link d-none d-md-inline-flex"
                   data-bs-toggle="tooltip"
                   title="@L("Header_BackToSiteTooltip", "Siteye dön")">
                    <i class="fas fa-external-link-alt"></i>
                    <span>@L("Header_Site", "Site")</span>
                </a>

                <div class="dropdown language-dropdown d-none d-sm-block">
                    <button class="language-dropdown-btn"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fas fa-globe"></i>

                        <span>
                            @currentShortCulture
                        </span>

                        <i class="fas fa-chevron-down language-chevron"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end language-dropdown-menu">
                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="culture" value="tr-TR" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item language-dropdown-item @(isTurkishCulture ? "active" : "")">
                                    <span class="language-code">TR</span>
                                    <span class="language-name">Türkçe</span>
                                </button>
                            </form>
                        </li>

                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="culture" value="en-US" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item language-dropdown-item @(isEnglishCulture ? "active" : "")">
                                    <span class="language-code">GB</span>
                                    <span class="language-name">English</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                @await Component.InvokeAsync("Notification")

                <div class="dropdown account-dropdown">
                    <button class="user-menu-btn"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="@L("Common_AccountMenu", "Hesap menüsü")">
                        <img src="@profileImg" class="user-avatar" alt="@displayName">
                    </button>

                    <div class="dropdown-menu dropdown-menu-end account-dropdown-menu">

                        <div class="account-dropdown-header">
                            <img src="@profileImg"
                                 class="account-dropdown-avatar"
                                 alt="@displayName" />

                            <div class="account-dropdown-user-info">
                                <div class="account-dropdown-name">
                                    @displayName
                                </div>

                                <div class="account-dropdown-role">
                                    @userRole
                                </div>

                                <div class="account-dropdown-email">
                                    @(user?.Email ?? User.Identity?.Name)
                                </div>
                            </div>
                        </div>

                        <div class="account-dropdown-divider"></div>

                        <div class="account-dropdown-body">
                            <a class="account-dropdown-item"
                               href="/Identity/Account/Manage">
                                <span class="account-dropdown-item-icon account-icon-primary">
                                    <i class="fas fa-user-cog"></i>
                                </span>

                                <span class="account-dropdown-item-content">
                                    <span class="account-dropdown-item-title">
                                        @L("Dropdown_Settings", "Hesap Ayarları")
                                    </span>

                                    <span class="account-dropdown-item-desc">
                                        @L("Dropdown_SettingsDescription", "Profil bilgilerini düzenle")
                                    </span>
                                </span>
                            </a>

                            @if (!isSuperAdmin)
                            {
                                <a class="account-dropdown-item"
                                   href="@dashboardMyConferencesUrl">
                                    <span class="account-dropdown-item-icon account-icon-info">
                                        <i class="fas fa-exchange-alt"></i>
                                    </span>

                                    <span class="account-dropdown-item-content">
                                        <span class="account-dropdown-item-title">
                                            @L("Dropdown_ConferenceSelection", "Kongre Seçimi")
                                        </span>

                                        <span class="account-dropdown-item-desc">
                                            @L("Dropdown_ConferenceSelectionDescription", "Aktif kongreyi değiştir")
                                        </span>
                                    </span>
                                </a>
                            }
                        </div>

                        <div class="account-dropdown-divider"></div>

                        <div class="account-dropdown-body">
                            <form asp-area=""
                                  asp-controller="Dashboard"
                                  asp-action="CustomLogout"
                                  method="post"
                                  class="m-0">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="account-dropdown-item account-dropdown-logout">
                                    <span class="account-dropdown-item-icon account-icon-danger">
                                        <i class="fas fa-sign-out-alt"></i>
                                    </span>

                                    <span class="account-dropdown-item-content">
                                        <span class="account-dropdown-item-title">
                                            @L("Dropdown_Logout", "Çıkış Yap")
                                        </span>
                                    </span>
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </header>

        <div class="content-wrapper">
            @if (!isSuperAdmin && !hideSelectedConferenceBar && hasSelectedConference && !string.IsNullOrWhiteSpace(selectedConferenceTitle))
            {
                <div class="selected-conference-banner">
                    <div class="d-flex align-items-center gap-3">
                        <div class="selected-conference-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>

                        <div>
                            <div class="selected-conference-subtitle">
                                @L("Common_SelectedConference", "Seçili Kongre")
                            </div>

                            <div class="selected-conference-title">
                                @selectedConferenceTitle
                            </div>
                        </div>
                    </div>

                    <a href="@changeSelectedConferenceUrl" class="btn btn-sm btn-primary rounded-pill px-3">
                        <i class="fas fa-exchange-alt me-1"></i>
                        @L("Common_ChangeConference", "Kongre Değiştir")
                    </a>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3">
                    <i class="fas fa-times-circle me-2"></i>
                    @TempData["ErrorMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3">
                    <i class="fas fa-info-circle me-2"></i>
                    @TempData["InfoMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));

            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            const isClosed = localStorage.getItem("sidebar-closed") === "true";

            if (isClosed && window.innerWidth > 991) {
                document.body.classList.add("sidebar-closed");
            }
        });

        function toggleSidebar() {
            if (window.innerWidth <= 991) {
                toggleMobileSidebar();
                return;
            }

            document.body.classList.toggle('sidebar-closed');
            localStorage.setItem("sidebar-closed", document.body.classList.contains("sidebar-closed"));
        }

        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');

            sidebar.classList.toggle('show');
            overlay.classList.toggle('show');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
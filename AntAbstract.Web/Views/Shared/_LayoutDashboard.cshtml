                    @L("Common_Messages", "Mesajlar")
                </a>

                @if (isManagementTeam)
                {
                    var broadcastUrl = string.IsNullOrWhiteSpace(slug)
                        ? "/Admin/Broadcast"
                        : $"/{slug}/Admin/Broadcast";
                    <a href="@broadcastUrl"
                       class="nav-link @(currentController == "Broadcast" ? "active" : "")">
                        <i class="fas fa-paper-plane text-primary"></i>
                        Toplu E-posta
                    </a>

                    var attendanceUrl = string.IsNullOrWhiteSpace(slug)
                        ? "/Admin/Attendance/Scan"
                        : $"/{slug}/Admin/Attendance/Scan";
                    <a href="@attendanceUrl"
                       class="nav-link @(currentController == "Attendance" ? "active" : "")">
                        <i class="fas fa-qrcode text-success"></i>
                        QR Check-In
                    </a>

                    var attendanceListUrl = string.IsNullOrWhiteSpace(slug)
                        ? "/Admin/Attendance"
                        : $"/{slug}/Admin/Attendance";
                    <a href="@attendanceListUrl"
                       class="nav-link @(currentController == "Attendance" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-clipboard-check text-info"></i>
                        Katılımcı Listesi
                    </a>
                }
            }

            @if (isAdmin)
            {
                var auditUrl = string.IsNullOrWhiteSpace(slug)
                    ? "/Admin/AuditLogs"
                    : $"/{slug}/Admin/AuditLogs";
                <a href="@auditUrl"
                   class="nav-link @(currentController == "AuditLogs" ? "active" : "")">
                    <i class="fas fa-history text-secondary"></i>
                    Denetim Günlüğü
                </a>

                var healthUrl = string.IsNullOrWhiteSpace(slug)
                    ? "/Admin/Health"
                    : $"/{slug}/Admin/Health";
                <a href="@healthUrl"
                   class="nav-link @(currentController == "Health" ? "active" : "")">
                    <i class="fas fa-heartbeat text-danger"></i>
                    Sistem Sağlığı
                </a>
            }
        </div>

        <div class="p-3 border-top mt-auto">
            <div class="menu-label m-0 mb-2">
                @L("Section_Help", "Yardım")
            </div>

            <a href="/Home/Contact" class="nav-link text-muted small justify-content-center">
                <i class="far fa-question-circle me-2"></i>
                @L("Common_SupportCenter", "Destek Merkezi")
            </a>
        </div>
    </aside>

    <div class="main-content">
        <header class="top-header">
            <div class="dashboard-header-left">
                <button class="sidebar-toggle-btn"
                        id="sidebarToggle"
                        type="button"
                        onclick="toggleSidebar()"
                        aria-label="@L("Common_Menu", "Menü")">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="dashboard-title-block d-none d-sm-block">
                    <div class="dashboard-title-row">
                        <h6 class="dashboard-title">
                            @displayName
                        </h6>

                        <span class="dashboard-role-pill">
                            @userRole
                        </span>
                    </div>

                    <div class="dashboard-subtitle">
                        @(string.IsNullOrWhiteSpace(headerBadgeText)
                            ? L("Header_ManagementPanel", "Yönetim Paneli")
                            : headerBadgeText)
                    </div>
                </div>
            </div>

            <div class="dashboard-header-actions">

                <a href="@publicSiteUrl"
                   target="_blank"
                   class="dashboard-site-link d-none d-md-inline-flex"
                   data-bs-toggle="tooltip"
                   title="@L("Header_BackToSiteTooltip", "Siteye dön")">
                    <i class="fas fa-external-link-alt"></i>
                    <span>@L("Header_Site", "Site")</span>
                </a>

                <div class="dropdown language-dropdown d-none d-sm-inline-flex">
                    <button class="language-dropdown-btn"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fas fa-globe"></i>
                        <span>@currentShortCulture</span>
                        <i class="fas fa-chevron-down language-chevron"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end language-dropdown-menu">
                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="culture" value="tr-TR" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item language-dropdown-item @(isTurkishCulture ? "active" : "")">
                                    <span class="language-code">TR</span>
                                    <span class="language-name">Türkçe</span>
                                </button>
                            </form>
                        </li>

                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="culture" value="en-US" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />

                                <button type="submit"
                                        class="dropdown-item language-dropdown-item @(isEnglishCulture ? "active" : "")">
                                    <span class="language-code">EN</span>
                                    <span class="language-name">English</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                @await Component.InvokeAsync("Notification")

                <div class="dropdown account-dropdown">
                    <button class="user-menu-btn"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="@L("Common_AccountMenu", "Hesap menüsü")">

                        <span class="user-menu-name">
                            @shortDisplayName
                        </span>

                        <span class="user-avatar-wrapper">
                            <img src="@profileImg" class="user-avatar" alt="@displayName">
                        </span>

                        <i class="fas fa-chevron-down user-menu-chevron"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end account-dropdown-menu">

                        <div class="account-dropdown-header">
                            <img src="@profileImg"
                                 class="account-dropdown-avatar"
                                 alt="@displayName" />

                            <div class="account-dropdown-user-info">
                                <div class="account-dropdown-name">
                                    @displayName
                                </div>

                                <div class="account-dropdown-role">
                                    @userRole
                                </div>

                                <div class="account-dropdown-email">
                                    @(user?.Email ?? User.Identity?.Name)
                                </div>
                            </div>
                        </div>

                        <div class="account-dropdown-divider"></div>

                        <div class="account-dropdown-body">
                            <a class="account-dropdown-item"
                               href="/Identity/Account/Manage">
                                <span class="account-dropdown-item-icon account-icon-primary">
                                    <i class="fas fa-user-cog"></i>
                                </span>

                                <span class="account-dropdown-item-content">
                                    <span class="account-dropdown-item-title">
                                        @L("Dropdown_Settings", "Hesap Ayarları")
                                    </span>

                                    <span class="account-dropdown-item-desc">
                                        @L("Dropdown_SettingsDescription", "Profil bilgilerini düzenle")
                                    </span>
                                </span>
                            </a>

                            @if (!isSuperAdmin && !isReferee)
                            {
                                <a class="account-dropdown-item"
                                   href="@dashboardMyConferencesUrl">
                                    <span class="account-dropdown-item-icon account-icon-info">
                                        <i class="fas fa-exchange-alt"></i>
                                    </span>

                                    <span class="account-dropdown-item-content">
                                        <span class="account-dropdown-item-title">
                                            @L("Dropdown_ConferenceSelection", "Kongre Seçimi")
                                        </span>

                                        <span class="account-dropdown-item-desc">
                                            @L("Dropdown_ConferenceSelectionDescription", "Aktif kongreyi değiştir")
                                        </span>
                                    </span>
                                </a>
                            }
                        </div>

                        <div class="account-dropdown-divider"></div>

                        <div class="account-dropdown-body">
                            <form asp-area=""
                                  asp-controller="Dashboard"
                                  asp-action="CustomLogout"
                                  method="post"
                                  class="m-0">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="account-dropdown-item account-dropdown-logout">
                                    <span class="account-dropdown-item-icon account-icon-danger">
                                        <i class="fas fa-sign-out-alt"></i>
                                    </span>

                                    <span class="account-dropdown-item-content">
                                        <span class="account-dropdown-item-title">
                                            @L("Dropdown_Logout", "Çıkış Yap")
                                        </span>
                                    </span>
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </header>

        <div class="content-wrapper">
            @if (!isSuperAdmin && !isReferee && !hideSelectedConferenceBar && hasSelectedConference && !string.IsNullOrWhiteSpace(selectedConferenceTitle))
            {
                <div class="selected-conference-banner">
                    <div class="d-flex align-items-center gap-3">
                        <div class="selected-conference-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>

                        <div>
                            <div class="selected-conference-subtitle">
                                @L("Common_SelectedConference", "Seçili Kongre")
                            </div>

                            <div class="selected-conference-title">
                                @selectedConferenceTitle
                            </div>
                        </div>
                    </div>

                    <a href="@changeSelectedConferenceUrl" class="btn btn-sm btn-primary rounded-pill px-3">
                        <i class="fas fa-exchange-alt me-1"></i>
                        @L("Common_ChangeConference", "Kongre Değiştir")
                    </a>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3">
                    <i class="fas fa-check-circle me-2"></i>
                    @TempData["SuccessMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3">
                    <i class="fas fa-times-circle me-2"></i>
                    @TempData["ErrorMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3">
                    <i class="fas fa-info-circle me-2"></i>
                    @TempData["InfoMessage"]

                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));

            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            const isClosed = localStorage.getItem("sidebar-closed") === "true";

            if (isClosed && window.innerWidth > 991) {
                document.body.classList.add("sidebar-closed");
            }
        });

        function toggleSidebar() {
            if (window.innerWidth <= 991) {
                toggleMobileSidebar();
                return;
            }

            document.body.classList.toggle('sidebar-closed');
            localStorage.setItem("sidebar-closed", document.body.classList.contains("sidebar-closed"));
        }

        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');

            sidebar.classList.toggle('show');
            overlay.classList.toggle('show');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

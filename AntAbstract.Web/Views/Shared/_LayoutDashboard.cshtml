                    <a href="@certificatesIndexUrl"
                       class="nav-link @(currentController == "Certificates" ? "active" : "")">
                        <i class="fas fa-certificate text-success"></i>
                        @L("Congress_Certificates", "Sertifikalarım")
                    </a>
                }
            }

            @if (!isSuperAdmin && isManagementTeam)
            {
                @if (hasSelectedConference)

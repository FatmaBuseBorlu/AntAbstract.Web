                    <a href="@submissionIndexUrl"
                       class="nav-link @(currentController == "Submission" && currentAction == "Index" ? "active" : "")">
                        <i class="fas fa-file-contract text-info"></i>
                        @L("Author_MySubmissions", "Bildirilerim")
                    </a>
                }

                if ((isAuthor || isListener) && hasSelectedConference)
                {
                    <div class="menu-label">@L("Section_Congress", "Kongre")</div>

                    <a href="@programUrl"
                       class="nav-link @(currentController == "Program" ? "active" : "")">
                        <i class="fas fa-calendar-day text-danger"></i>
                        @L("Congress_Program", "Program")
                    </a>

                    <a href="@proceedingsUrl"
                       class="nav-link @(currentController == "Dashboard" && currentAction == "ProceedingBook" ? "active" : "")">
                        <i class="fas fa-book" style="color: #6f42c1;"></i>

@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using AntAbstract.Domain.Entities
@using System
@using System.Globalization

@inject UserManager<AppUser> UserManager
@inject AntAbstract.Infrastructure.Context.TenantContext Tc
@inject IViewLocalizer Localizer

@{
    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;
        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
    };

    var user = await UserManager.GetUserAsync(User);

    var displayName = user != null
        ? $"{user.FirstName} {user.LastName}".Trim()
        : User.Identity?.Name;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = user?.Email ?? "Kullanıcı";
    }

    var shortDisplayName = displayName;

    if (!string.IsNullOrWhiteSpace(shortDisplayName) && shortDisplayName.Length > 22)
    {
        shortDisplayName = shortDisplayName.Substring(0, 22).Trim() + "...";
    }

var profileImg = !string.IsNullOrWhiteSpace(user?.ProfileImagePath)
    ? user.ProfileImagePath
    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&background=00aeef&color=fff&size=128&font-size=0.35&bold=true";

    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");

    var isAuthor =
        User.IsInRole("Author") ||
        User.IsInRole("Yazar");

    var isListener =
        User.IsInRole("Listener") ||
        User.IsInRole("Dinleyici");

    var isReferee =
        User.IsInRole("Referee") ||
        User.IsInRole("Hakem") ||
        User.IsInRole("Reviewer");

    var isManagementTeam = isAdmin || isSuperAdmin;

    string userRole = L("Role_User", "Kullanıcı");

    if (isSuperAdmin)
    {
        userRole = L("Role_SuperAdmin", "Süper Admin");
    }
    else if (isAdmin)
    {
        userRole = L("Role_Admin", "Admin");
    }
    else if (isReferee)
    {
        userRole = L("Role_Referee", "Hakem");
    }
    else if (isAuthor)
    {
        userRole = L("Role_Author", "Yazar");
    }
    else if (isListener)
    {
        userRole = L("Role_Listener", "Dinleyici");
    }

    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
                ?? Tc.Current?.Slug
                ?? Context.Session.GetString("SelectedConferenceSlug")
                ?? "";

    string BuildConferenceUrl(string cleanPath, string fallbackPath)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return fallbackPath;
        }

        return $"/{slug}{cleanPath}";
    }

    string? confIdStr = null;

    if (Tc.Current != null)
    {
        var tenantKey = $"SelectedConferenceId:{Tc.Current.Id}";
        confIdStr = Context.Session.GetString(tenantKey);
    }

    confIdStr ??= Context.Session.GetString("SelectedConferenceId");

    Guid? selectedConferenceId = Guid.TryParse(confIdStr, out var parsedId)
        ? parsedId
        : null;

    var hasSelectedConference = selectedConferenceId.HasValue;

    string? selectedConferenceTitle = null;

    if (Tc.Current != null)
    {
        selectedConferenceTitle = Context.Session.GetString($"SelectedConferenceTitle:{Tc.Current.Id}");
    }

    selectedConferenceTitle ??= Context.Session.GetString("SelectedConferenceTitle");

    var hideSelectedConferenceBar = ViewData["HideSelectedConferenceBar"] as bool? ?? false;

    var dashboardMyConferencesUrl = "/Dashboard/MyConferences";

    var dashboardUrl = isSuperAdmin
        ? "/Dashboard/SuperAdmin"
        : isAuthor || isListener
            ? "/Dashboard/MyConferences"
            : isReferee && !isManagementTeam
                ? "/Dashboard"
                : BuildConferenceUrl("/Dashboard", "/Dashboard");

    var changeSelectedConferenceUrl = isSuperAdmin
        ? "/Admin/ConferenceFlow?forceSelect=true"
        : dashboardMyConferencesUrl;

    var submissionsAdminUrl = BuildConferenceUrl(
        "/Admin/Submissions",
        "/Admin/Submissions"
    );

    var submissionIndexUrl = BuildConferenceUrl(
        "/my-submissions",
        "/Submission/Index"
    );

    var submissionCreateUrl = BuildConferenceUrl(
        "/submit-abstract",
        "/Submission/Create"
    );

    var reviewIndexUrl = isReferee && !isManagementTeam
        ? "/Review/Index"
        : BuildConferenceUrl("/Review/Index", "/Review/Index");

    var reviewInterestsUrl = isReferee && !isManagementTeam
        ? "/Review/Interests"
        : BuildConferenceUrl("/Review/Interests", "/Review/Interests");

    var reviewAvailabilityUrl = isReferee && !isManagementTeam
        ? "/Review/Availability"
        : BuildConferenceUrl("/Review/Availability", "/Review/Availability");

    var reviewConflictsUrl = isReferee && !isManagementTeam
        ? "/Review/Conflicts"
        : BuildConferenceUrl("/Review/Conflicts", "/Review/Conflicts");

    var reviewGuidelinesUrl = isReferee && !isManagementTeam
        ? "/Review/Guidelines"
        : BuildConferenceUrl("/Review/Guidelines", "/Review/Guidelines");

    var certificatesIndexUrl = isReferee && !isManagementTeam
        ? "/Certificates"
        : BuildConferenceUrl("/Certificates", "/Certificates");

    var messageIndexUrl = isReferee && !isManagementTeam
        ? "/Message/Index"
        : BuildConferenceUrl("/Message/Index", "/Message/Index");

    var paymentMyUrl = BuildConferenceUrl(
        "/payments",
        "/Payment/My"
    );

    var paymentNewUrl = BuildConferenceUrl(
        "/payment",
        "/Payment/New"
    );

    var accommodationUrl = BuildConferenceUrl(
        "/Accommodation/Index",
        "/Accommodation/Index"
    );

    var programUrl = BuildConferenceUrl(
        "/Program/Index",
        "/Program/Index"
    );

    var proceedingsUrl = BuildConferenceUrl(
        "/Dashboard/ProceedingBook",
        "/Dashboard/ProceedingBook"
    );

    var conferenceFlowUrl = isSuperAdmin
        ? hasSelectedConference && selectedConferenceId.HasValue && !string.IsNullOrWhiteSpace(slug)
            ? $"/{slug}/Admin/ConferenceFlow?conferenceId={selectedConferenceId.Value}"
            : "/Admin/ConferenceFlow?forceSelect=true"
        : BuildConferenceUrl("/Admin/ConferenceFlow", "/Admin/ConferenceFlow");

    var reportsUrl = BuildConferenceUrl(
        "/Admin/Reports",
        "/Admin/Reports"
    );

    var assignmentUrl = BuildConferenceUrl(
        "/Admin/Assignment",
        "/Admin/Assignment"
    );

    var decisionUrl = BuildConferenceUrl(
        "/Admin/Decision",
        "/Admin/Decision"
    );

    var sessionUrl = BuildConferenceUrl(
        "/Admin/Session",
        "/Admin/Session"
    );

    var conferencesUrl = BuildConferenceUrl(
        "/Admin/Conferences",
        "/Admin/Conferences"
    );

    var registrationsUrl = BuildConferenceUrl(
        "/Admin/Registrations",
        "/Admin/Registrations"
    );

    var registrationTypesUrl = BuildConferenceUrl(
        "/Admin/RegistrationTypes",
        "/Admin/RegistrationTypes"
    );

    var conferenceTopicsUrl = BuildConferenceUrl(
        "/Admin/ConferenceTopics",
        "/Admin/ConferenceTopics"
    );

    var websiteAdminUrl = BuildConferenceUrl(
        "/Admin/Website",
        "/Admin/Website"
    );

    var refereeAdminUrl = BuildConferenceUrl(
        "/Admin/Referee",
        "/Admin/Referee"
    );

    var headerBadgeText = isSuperAdmin
        ? L("Header_SystemManagement", "Sistem Yönetimi")
        : Tc.Current?.Name;

    if (!isSuperAdmin && string.IsNullOrWhiteSpace(headerBadgeText) && !string.IsNullOrWhiteSpace(slug))
    {
        headerBadgeText = slug;
    }

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var isTurkishCulture = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
    var isEnglishCulture = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var currentShortCulture = isEnglishCulture ? "EN" : "TR";

    var returnUrl = string.IsNullOrEmpty(Context.Request.Path.Value)
        ? "/"
        : $"{Context.Request.Path}{Context.Request.QueryString}";

    var publicSiteUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}"
        : "/";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AntAbstract</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/admin-design-system.css" />

    <style>
        :root {
            --sidebar-width: 270px;
            --header-height: 72px;
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --primary-soft: rgba(0, 174, 239, 0.10);
            --dark-bg: #1e293b;
            --menu-text: #64748b;
            --menu-hover-bg: #f8fafc;
            --menu-active-bg: rgba(0, 174, 239, 0.08);
            --menu-active-text: #00aeef;
            --border-color: #e2e8f0;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --danger: #ef4444;
            --page-bg: #f3f4f6;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--page-bg);
            overflow-x: hidden;
            color: var(--text-dark);
        }

        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #ffffff;
            border-right: 1px solid var(--border-color);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease-in-out;
        }

        body.sidebar-closed .sidebar {
            left: calc(var(--sidebar-width) * -1);
        }

        .sidebar-brand {
            height: var(--header-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            font-size: 1.35rem;
            font-weight: 900;
            color: var(--dark-bg);
            border-bottom: 1px solid #f1f5f9;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .sidebar-menu {
            padding: 1rem;
            flex-grow: 1;
            overflow-y: auto;
            list-style: none;
        }

        .sidebar-menu::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-menu::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 10px;
        }

        .menu-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #94a3b8;
            font-weight: 800;
            letter-spacing: 0.8px;
            margin: 1.5rem 0 0.5rem 0.8rem;
        }

        .menu-label:first-child {
            margin-top: 0.5rem;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: var(--menu-text);
            font-weight: 700;
            font-size: 0.9rem;
            border-radius: 0.75rem;
            margin-bottom: 0.2rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .nav-link:hover {
            background-color: var(--menu-hover-bg);
            color: var(--primary-color);
            transform: translateX(3px);
        }

        .nav-link.active {
            background-color: var(--menu-active-bg);
            color: var(--menu-active-text);
        }

        .nav-link i {
            width: 24px;
            font-size: 1rem;
            margin-right: 0.8rem;
            text-align: center;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: all 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        body.sidebar-closed .main-content {
            margin-left: 0;
        }

        .top-header {
            height: var(--header-height);
            background-color: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.85);
            position: sticky;
            top: 0;
            z-index: 1040;
            padding: 0 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dashboard-header-left {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        .sidebar-toggle-btn {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            color: var(--primary-color);
            background: #ffffff;
            border: 1px solid #edf2f7;
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.06);
        }

        .sidebar-toggle-btn:hover {
            background-color: rgba(0, 174, 239, 0.08);
            color: var(--primary-color);
            border-color: rgba(0, 174, 239, 0.22);
            transform: translateY(-1px);
        }

        .dashboard-title-block {
            min-width: 0;
            margin-left: 0.9rem;
        }

        .dashboard-title-row {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            min-width: 0;
        }

        .dashboard-title {
            margin: 0;
            color: var(--text-dark);
            font-size: 1rem;
            font-weight: 900;
            line-height: 1.2;
            white-space: nowrap;
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dashboard-role-pill {
            display: inline-flex;
            align-items: center;
            padding: 0.16rem 0.55rem;
            border-radius: 999px;
            background-color: rgba(0, 174, 239, 0.12);
            color: var(--primary-color);
            font-size: 0.62rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.35px;
            white-space: nowrap;
        }

        .dashboard-subtitle {
            margin-top: 0.18rem;
            color: var(--text-muted);
            font-size: 0.76rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 360px;
        }

        .dashboard-header-actions {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .dashboard-site-link {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.55rem 0.95rem;
            border-radius: 999px;
            color: #64748b;
            background-color: #ffffff;
            border: 1px solid #dbe3ef;
            font-size: 0.86rem;
            font-weight: 900;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
            white-space: nowrap;
        }

        .dashboard-site-link:hover {
            color: var(--primary-color);
            background-color: #ffffff;
            border-color: rgba(0, 174, 239, 0.28);
            box-shadow: 0 10px 24px rgba(0, 174, 239, 0.10);
            transform: translateY(-1px);
        }

        .language-dropdown {
            display: inline-flex;
            align-items: center;
        }

        .language-dropdown-btn {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.55rem 0.95rem;
            border-radius: 999px;
            border: 1px solid #dbe3ef;
            background-color: #ffffff;
            color: #475569;
            font-size: 0.9rem;
            font-weight: 900;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
            transition: all 0.2s ease;
        }

        .language-dropdown-btn:hover {
            border-color: rgba(0, 174, 239, 0.28);
            color: var(--primary-color);
            background-color: #ffffff;
            box-shadow: 0 10px 24px rgba(0, 174, 239, 0.10);
            transform: translateY(-1px);
        }

        .language-dropdown-btn .fa-globe {
            color: #64748b;
        }

        .language-chevron {
            font-size: 0.65rem;
            color: #64748b;
        }

        .language-dropdown-menu {
            min-width: 160px;
            padding: 8px;
            border: none !important;
            border-radius: 20px !important;
            background-color: #ffffff;
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.14);
            overflow: hidden;
            margin-top: 10px !important;
        }

        .language-dropdown-menu form {
            margin: 0;
        }

        .language-dropdown-menu li + li {
            margin-top: 4px;
        }

        .language-dropdown-item {
            width: 100%;
            min-height: 42px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            border: none;
            background: transparent;
            border-radius: 14px;
            padding: 0.58rem 0.75rem;
            color: #475569;
            transition: all 0.2s ease;
        }

        .language-dropdown-item:hover,
        .language-dropdown-item.active {
            background-color: rgba(0, 174, 239, 0.12);
            color: var(--primary-color);
        }

        .language-code {
            min-width: 22px;
            font-size: 0.74rem;
            font-weight: 900;
            color: var(--primary-color);
            letter-spacing: 0.25px;
        }

        .language-name {
            font-size: 0.9rem;
            font-weight: 800;
            color: inherit;
        }

        .header-icon-btn {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            color: #64748b;
            background: transparent;
            transition: all 0.2s;
            cursor: pointer;
            text-decoration: none;
        }

        .header-icon-btn:hover {
            background-color: #f1f5f9;
            color: var(--primary-color);
        }

        .position-relative .badge-notify {
            position: absolute;
            top: 2px;
            right: 2px;
            width: 8px;
            height: 8px;
            background-color: var(--danger);
            border-radius: 50%;
            border: 2px solid #fff;
        }

        .user-menu-btn {
            min-height: 48px;
            max-width: 250px;
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            cursor: pointer;
            padding: 0.35rem 0.75rem 0.35rem 1rem;
            border-radius: 999px;
            background-color: #ffffff;
            border: 1px solid #dbe3ef;
            transition: all 0.2s ease;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.08);
            position: relative;
            color: var(--text-dark);
            overflow: visible;
        }

        .user-menu-btn:hover,
        .user-menu-btn.show {
            border-color: rgba(0, 174, 239, 0.32);
            box-shadow: 0 12px 28px rgba(0, 174, 239, 0.12);
            transform: translateY(-1px);
            background-color: #ffffff;
        }

        .user-menu-name {
            max-width: 145px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 0.86rem;
            font-weight: 900;
            color: var(--text-dark);
            line-height: 1;
        }

        .user-avatar-wrapper {
            position: relative;
            width: 38px;
            height: 38px;
            min-width: 38px;
            overflow: visible;
            margin-right: 4px;
        }

        .user-avatar-wrapper::after {
            content: "";
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background-color: #22c55e;
            border: 2px solid #ffffff;
            position: absolute;
            right: -2px;
            bottom: -2px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #ffffff;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.10);
        }

        .user-menu-chevron {
            color: #64748b;
            font-size: 0.72rem;
            margin-right: 0.15rem;
            transition: transform 0.2s ease;
        }

        .user-menu-btn.show .user-menu-chevron {
            transform: rotate(180deg);
        }

        .account-dropdown-menu {
            width: 315px;
            padding: 0;
            border: none !important;
            border-radius: 24px !important;
            overflow: hidden;
            background-color: #ffffff;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
            margin-top: 12px !important;
        }

        .account-dropdown-header {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            padding: 1.05rem;
            background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.20), transparent 38%), linear-gradient(135deg, rgba(0, 174, 239, 0.10), #ffffff);
        }

        .account-dropdown-avatar {
            width: 56px;
            height: 56px;
            min-width: 56px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #ffffff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.13);
        }

        .account-dropdown-user-info {
            min-width: 0;
        }

        .account-dropdown-name {
            font-size: 0.95rem;
            font-weight: 900;
            color: #0f172a;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 210px;
        }

        .account-dropdown-role {
            display: inline-flex;
            align-items: center;
            margin-top: 0.28rem;
            padding: 0.18rem 0.55rem;
            border-radius: 999px;
            background-color: rgba(0, 174, 239, 0.12);
            color: var(--primary-color);
            font-size: 0.6rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .account-dropdown-email {
            margin-top: 0.3rem;
            color: #64748b;
            font-size: 0.74rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 210px;
        }

        .account-dropdown-divider {
            height: 1px;
            background-color: #e2e8f0;
            margin: 0;
        }

        .account-dropdown-body {
            padding: 0.55rem;
        }

        .account-dropdown-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.72rem 0.75rem;
            border-radius: 16px;
            border: none;
            background-color: transparent;
            color: #334155;
            text-decoration: none;
            transition: all 0.2s ease;
            text-align: left;
        }

        .account-dropdown-item:hover {
            background-color: #f8fafc;
            color: var(--primary-color);
        }

        .account-dropdown-item-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.92rem;
        }

        .account-icon-primary {
            background-color: rgba(13, 110, 253, 0.10);
            color: #0d6efd;
        }

        .account-icon-info {
            background-color: rgba(0, 174, 239, 0.10);
            color: var(--primary-color);
        }

        .account-icon-danger {
            background-color: rgba(239, 68, 68, 0.10);
            color: var(--danger);
        }

        .account-dropdown-item-content {
            min-width: 0;
        }

        .account-dropdown-item-title {
            display: block;
            font-size: 0.88rem;
            font-weight: 900;
            line-height: 1.2;
        }

        .account-dropdown-item-desc {
            display: block;
            margin-top: 0.16rem;
            font-size: 0.7rem;
            color: #64748b;
            line-height: 1.25;
        }

        .account-dropdown-logout {
            color: var(--danger);
            font-weight: 900;
        }

        .account-dropdown-logout:hover {
            background-color: rgba(239, 68, 68, 0.08);
            color: var(--danger);
        }

        .content-wrapper {
            padding: 1.5rem 1.75rem;
            flex-grow: 1;
            max-width: 100%;
            overflow-x: hidden;
        }

        .selected-conference-banner {
            border: 1px solid rgba(0, 174, 239, 0.20);
            background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(239, 248, 255, 0.96));
            border-radius: 24px;
            padding: 1.35rem 1.5rem;
            margin-bottom: 1.75rem;
            box-shadow: 0 16px 38px rgba(15, 23, 42, 0.055);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .selected-conference-icon {
            width: 54px;
            height: 54px;
            min-width: 54px;
            border-radius: 18px;
            background: linear-gradient(135deg, #00aeef, #0d6efd);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 12px 26px rgba(0, 174, 239, 0.24);
            font-size: 1.15rem;
        }

        .selected-conference-title {
            font-weight: 900;
            color: #0f172a;
            margin-bottom: 2px;
            font-size: 1rem;
            line-height: 1.25;
        }

        .selected-conference-subtitle {
            font-size: 0.82rem;
            color: #64748b;
            font-weight: 800;
        }

        .details-page-header {
            border: 1px solid rgba(0, 174, 239, 0.18);
            border-radius: 28px;
            padding: 1.45rem 1.6rem;
            background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff, #f8fbff);
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        }

        .details-page-header h4,
        .details-page-header h3 {
            color: var(--text-dark);
            letter-spacing: -0.03em;
        }

        .modern-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 28px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
            overflow: hidden;
        }

        .modern-card-header {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            padding: 1.55rem 1.65rem 1.15rem;
        }

        .modern-card-icon {
            width: 56px;
            height: 56px;
            min-width: 56px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
        }

        .modern-card-icon.soft-primary {
            background: rgba(0, 174, 239, 0.12);
            color: #0284c7;
        }

        .modern-card-icon.soft-info {
            background: rgba(13, 110, 253, 0.10);
            color: #0d6efd;
        }

        .modern-card-icon.soft-success {
            background: rgba(25, 135, 84, 0.12);
            color: #198754;
        }

        .modern-card-icon.soft-warning {
            background: rgba(245, 158, 11, 0.12);
            color: #f59e0b;
        }

        .modern-card-icon.soft-danger {
            background: rgba(239, 68, 68, 0.10);
            color: var(--danger);
        }

        .modern-card-title {
            color: var(--text-dark);
            font-weight: 900;
            letter-spacing: -0.03em;
            font-size: 1.08rem;
        }

        .modern-card-text {
            color: var(--text-muted);
            line-height: 1.55;
            font-size: 0.88rem;
            font-weight: 700;
        }

        .modern-card-body {
            padding: 0 1.65rem 1.65rem;
        }

        .conference-form-page .form-label {
            color: #475569 !important;
            font-size: 0.75rem;
            font-weight: 900 !important;
            letter-spacing: 0.28px;
            text-transform: uppercase;
            margin-bottom: 0.45rem;
        }

        .conference-form-page .form-control,
        .conference-form-page .form-select {
            min-height: 46px;
            border-radius: 14px;
            border: 1px solid var(--border-color);
            color: #334155;
            font-weight: 700;
            box-shadow: none;
        }

        .conference-form-page .form-control-lg {
            min-height: 54px;
            border-radius: 16px;
            font-size: 1rem;
            font-weight: 800;
        }

        .conference-form-page textarea.form-control {
            min-height: 132px;
            line-height: 1.65;
        }

        .conference-form-page .form-control:focus,
        .conference-form-page .form-select:focus {
            border-color: rgba(0, 174, 239, 0.55);
            box-shadow: 0 0 0 0.2rem rgba(0, 174, 239, 0.10);
        }

        .conference-form-page .form-check-input {
            cursor: pointer;
            border-color: #cbd5e1;
        }

        .conference-form-page .form-switch .form-check-input {
            width: 2.8em;
            height: 1.45em;
            margin-right: 0.65rem;
        }

        .conference-form-page .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .conference-form-actions {
            position: sticky;
            top: calc(var(--header-height) + 1rem);
            padding: 1rem;
            border: 1px solid var(--border-color);
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.94);
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.48);
            z-index: 1045;
        }

        @@media (max-width: 991px) {
            .sidebar {
                transform: translateX(-100%);
                left: 0;
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0 !important;
            }

            .content-wrapper {
                padding: 1rem;
            }

            .sidebar-overlay.show {
                display: block;
            }

            .top-header {
                padding: 0 1rem;
            }

            body.sidebar-closed .sidebar {
                left: 0;
            }

            .dashboard-site-link {
                display: none !important;
            }

            .language-dropdown {
                display: none !important;
            }

            .dashboard-title-block {
                display: none;
            }

            .user-menu-btn {
                min-height: 42px;
                max-width: 42px;
                width: 42px;
                height: 42px;
                padding: 0.2rem;
                border: none;
                background: transparent;
                box-shadow: none;
                gap: 0;
            }

            .user-menu-name,
            .user-menu-chevron {
                display: none;
            }

            .user-avatar-wrapper {
                width: 38px;
                height: 38px;
                min-width: 38px;
            }

            .user-avatar {
                width: 38px;
                height: 38px;
                border-width: 2px;
            }

            .selected-conference-banner {
                align-items: flex-start;
                flex-direction: column;
            }

            .details-page-header,
            .modern-card-header,
            .modern-card-body {
                padding: 1.15rem;
            }

            .modern-card-icon {
                width: 48px;
                height: 48px;
                min-width: 48px;
                border-radius: 16px;
            }

            .conference-form-actions {
                position: static;
            }

            .account-dropdown-menu {
                width: 295px;
            }

            /* Tablo yatay kaydırma */
            .table-responsive-force { overflow-x: auto; -webkit-overflow-scrolling: touch; }
            table { min-width: 560px; }

            /* Buton grupları alt alta */
            .btn-group-mobile { flex-direction: column !important; }
            .btn-group-mobile .btn { border-radius: 8px !important; width: 100%; }

            /* Hero/başlık satırları */
            .d-flex.justify-content-between { flex-wrap: wrap; gap: .75rem; }
            .reports-hero-actions { flex-wrap: wrap; gap: .5rem; }

            /* Kart padding küçültme */
            .card { border-radius: 12px !important; }
            .p-4 { padding: 1rem !important; }

            /* Stat kartları tek sütun */
            .row.g-3 > [class*="col-md-3"],
            .row.g-3 > [class*="col-md-4"] { flex: 0 0 50%; max-width: 50%; }

            /* Form etiketleri tam genişlik */
            .row.g-3 > .col-md-6,
            .row.g-3 > .col-md-4,
            .row.g-3 > .col-md-8 { flex: 0 0 100%; max-width: 100%; }
        }

        @@media (max-width: 575px) {
            .row.g-3 > [class*="col-md-3"],
            .row.g-3 > [class*="col-md-4"] { flex: 0 0 100%; max-width: 100%; }
            .content-wrapper { padding: .75rem; }
            h4.fw-bold { font-size: 1.1rem; }
        }
    </style>
</head>

<body>

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleMobileSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <a href="/" class="sidebar-brand">
            ANT<span style="color: var(--primary-color);">ABSTRACT</span>
        </a>

        <div class="sidebar-menu">
            <div class="menu-label">@L("Section_General", "Genel")</div>

            <a href="@dashboardUrl"
               class="nav-link @(currentController == "Dashboard" && (currentAction == "Index" || currentAction == "SuperAdmin" || ((isAuthor || isListener) && currentAction == "MyConferences")) ? "active" : "")">

                    background: #334155 !important; border-color: #475569 !important; color: #94a3b8 !important;
                }
                [data-theme="dark"] .admin-card {
                    background: #1e293b !important; border-color: #334155 !important;
                }
                [data-theme="dark"] .admin-card-header {
                    background: linear-gradient(135deg, #1e293b, #0f172a) !important; border-color: #334155 !important;
                }
                [data-theme="dark"] .admin-card-title { color: #f1f5f9 !important; }
                [data-theme="dark"] .admin-card-kicker { color: #94a3b8 !important; }
                [data-theme="dark"] .admin-card-body { color: #cbd5e1 !important; }

                /* ── Deep Dark Mode — all page-specific white elements ── */
                [data-theme="dark"] .content-wrapper .form-control,
                [data-theme="dark"] .content-wrapper .form-select {
                    background: #0f172a !important; border-color: #334155 !important; color: #e2e8f0 !important;
                }
                [data-theme="dark"] .content-wrapper .form-label,
                [data-theme="dark"] .content-wrapper label { color: #cbd5e1 !important; }
                [data-theme="dark"] .content-wrapper .form-text { color: #64748b !important; }
                [data-theme="dark"] .content-wrapper .form-check-label { color: #94a3b8 !important; }

                [data-theme="dark"] .content-wrapper .table { color: #cbd5e1 !important; --bs-table-bg: transparent !important; }
                [data-theme="dark"] .content-wrapper .table thead,
                [data-theme="dark"] .content-wrapper .table-light { background: #0f172a !important; color: #94a3b8 !important; --bs-table-bg: #0f172a !important; }
                [data-theme="dark"] .content-wrapper .table-dark { background: #0f172a !important; --bs-table-bg: #0f172a !important; }
                [data-theme="dark"] .content-wrapper .table tbody tr { border-color: #334155 !important; }
                [data-theme="dark"] .content-wrapper .table tbody tr:hover { background: rgba(56,189,248,0.04) !important; }
                [data-theme="dark"] .content-wrapper .table th { color: #94a3b8 !important; border-color: #334155 !important; }
                [data-theme="dark"] .content-wrapper .table td { border-color: #1e293b !important; }

                [data-theme="dark"] .content-wrapper .card {
                    background: #1e293b !important; border-color: #334155 !important; color: #cbd5e1 !important;
                }
                [data-theme="dark"] .content-wrapper .card-header {
                    background: #0f172a !important; border-color: #334155 !important; color: #f1f5f9 !important;
                }
                [data-theme="dark"] .content-wrapper .card-footer {
                    background: #0f172a !important; border-color: #334155 !important;
                }
                [data-theme="dark"] .content-wrapper .card-title { color: #f1f5f9 !important; }
                [data-theme="dark"] .content-wrapper .card-body { color: #cbd5e1 !important; }

                [data-theme="dark"] .content-wrapper .modal-content {
                    background: #1e293b !important; border-color: #334155 !important; color: #e2e8f0 !important;
                }
                [data-theme="dark"] .content-wrapper .modal-header { border-color: #334155 !important; }
                [data-theme="dark"] .content-wrapper .modal-footer { border-color: #334155 !important; }
                [data-theme="dark"] .content-wrapper .modal-title { color: #f1f5f9 !important; }
                [data-theme="dark"] .content-wrapper .btn-close { filter: invert(1) !important; }

                [data-theme="dark"] .content-wrapper .list-group-item {
                    background: #1e293b !important; border-color: #334155 !important; color: #cbd5e1 !important;
                }
                [data-theme="dark"] .content-wrapper .alert { border-color: #334155 !important; }
                [data-theme="dark"] .content-wrapper .bg-white { background: #1e293b !important; }
                [data-theme="dark"] .content-wrapper .bg-light { background: #0f172a !important; }
                [data-theme="dark"] .content-wrapper .border { border-color: #334155 !important; }
                [data-theme="dark"] .content-wrapper .text-dark { color: #e2e8f0 !important; }
                [data-theme="dark"] .content-wrapper .text-muted { color: #64748b !important; }
                [data-theme="dark"] .content-wrapper h1, [data-theme="dark"] .content-wrapper h2,
                [data-theme="dark"] .content-wrapper h3, [data-theme="dark"] .content-wrapper h4,
                [data-theme="dark"] .content-wrapper h5, [data-theme="dark"] .content-wrapper h6 {
                    color: #f1f5f9 !important;
                }
                [data-theme="dark"] .content-wrapper p { color: #cbd5e1 !important; }
                [data-theme="dark"] .content-wrapper strong { color: #f1f5f9 !important; }
                [data-theme="dark"] .content-wrapper .badge.bg-light { background: #334155 !important; color: #e2e8f0 !important; }
                [data-theme="dark"] .content-wrapper .badge.bg-secondary { background: #475569 !important; }
                [data-theme="dark"] .content-wrapper .btn-outline-secondary {
                    border-color: #475569 !important; color: #94a3b8 !important;
                }
                [data-theme="dark"] .content-wrapper .btn-outline-secondary:hover {
                    background: #334155 !important; color: #e2e8f0 !important;
                }
                [data-theme="dark"] .content-wrapper .btn-outline-primary {
                    border-color: #3b82f6 !important; color: #60a5fa !important;
                }
                [data-theme="dark"] .content-wrapper .nav-tabs { border-color: #334155 !important; }
                [data-theme="dark"] .content-wrapper .nav-tabs .nav-link { color: #94a3b8 !important; }
                [data-theme="dark"] .content-wrapper .nav-tabs .nav-link.active {
                    background: #1e293b !important; border-color: #334155 #334155 #1e293b !important; color: #f1f5f9 !important;
                }
                [data-theme="dark"] .content-wrapper .accordion-item {
                    background: #1e293b !important; border-color: #334155 !important;
                }
                [data-theme="dark"] .content-wrapper .accordion-button {
                    background: #1e293b !important; color: #f1f5f9 !important;
                }
                [data-theme="dark"] .content-wrapper .accordion-button::after { filter: invert(1) !important; }
                [data-theme="dark"] .content-wrapper .dropdown-menu {
                    background: #1e293b !important; border-color: #334155 !important;
                }
                [data-theme="dark"] .content-wrapper .dropdown-item { color: #cbd5e1 !important; }
                [data-theme="dark"] .content-wrapper .dropdown-item:hover { background: #334155 !important; }
                [data-theme="dark"] .content-wrapper .pagination .page-link {
                    background: #1e293b !important; border-color: #334155 !important; color: #94a3b8 !important;
                }
                [data-theme="dark"] .content-wrapper .pagination .page-item.active .page-link {
                    background: #3b82f6 !important; border-color: #3b82f6 !important; color: #fff !important;
                }
                [data-theme="dark"] .content-wrapper ::placeholder { color: #64748b !important; opacity: 1 !important; }
                [data-theme="dark"] .content-wrapper hr { border-color: #334155 !important; opacity: 0.5 !important; }
            </style>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha512-IlHM3u+5pyqzJFBfLYkvv3AXvjz5E3F9UPnFNwJz+5XqGrqF3uc6rGFEhTqC/bQCIoKq/DqlGPyMn1pZSsXNA=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));

            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            const isClosed = localStorage.getItem("sidebar-closed") === "true";

            if (isClosed && window.innerWidth > 991) {
                document.body.classList.add("sidebar-closed");
            }
        });

        function toggleSidebar() {
            if (window.innerWidth <= 991) {
                toggleMobileSidebar();
                return;
            }

            document.body.classList.toggle('sidebar-closed');
            localStorage.setItem("sidebar-closed", document.body.classList.contains("sidebar-closed"));
        }

        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');

            sidebar.classList.toggle('show');
            overlay.classList.toggle('show');
        }
    </script>

    <script src="~/js/upload-dropzone.js" asp-append-version="true"></script>

    <script>
    (function () {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark') applyTheme('dark');

        function applyTheme(mode) {
            document.documentElement.setAttribute('data-theme', mode);
            var icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = mode === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
            }
        }

        window.toggleTheme = function () {
            var current = document.documentElement.getAttribute('data-theme');
            var next = current === 'dark' ? 'light' : 'dark';
            if (next === 'light') {
                document.documentElement.removeAttribute('data-theme');
            } else {
                applyTheme('dark');
            }
            localStorage.setItem('theme', next);
            var icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = next === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
            }
        };
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

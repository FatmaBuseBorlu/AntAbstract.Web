                }

                if (isAuthor && hasSelectedConference)
                {
                    <a href="@submissionCreateUrl"
                       class="nav-link @(currentController == "Submission" && currentAction == "Create" ? "active" : "")">
                        <i class="fas fa-plus-circle text-success"></i>
                        @L("Author_NewSubmission", "Bildiri Gönder")

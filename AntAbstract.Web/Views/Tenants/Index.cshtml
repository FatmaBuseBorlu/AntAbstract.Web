@model List<AntAbstract.Web.Models.ViewModels.Admin.Tenants.TenantListItemViewModel>

@{
    ViewData["Title"] = "Kurum Yönetimi";
    Layout = "_LayoutDashboard";

    var totalTenantCount = ViewBag.TotalTenantCount ?? 0;
    var tenantWithAdminCount = ViewBag.TenantWithAdminCount ?? 0;
    var totalConferenceCount = ViewBag.TotalConferenceCount ?? 0;
    var totalUserCount = ViewBag.TotalUserCount ?? 0;

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container-fluid">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="text-uppercase text-muted fw-bold small mb-1">
                Global Sistem
            </div>

            <h2 class="fw-bold mb-1 text-dark">
                Kurum Yönetimi
            </h2>

            <p class="text-muted mb-0">
                Sistemdeki kurumları, kurum adminlerini, bağlı kullanıcıları ve kongre sayılarını buradan takip edebilirsiniz.
            </p>
        </div>

        <div class="page-header-right">
            <a asp-area="Admin"
               asp-controller="Tenants"
               asp-action="Create"
               class="btn btn-primary rounded-pill px-4 header-action-btn">
                <i class="fas fa-plus me-2"></i>
                Yeni Kurum Ekle
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-building"></i>
                </div>

                <div>
                    <div class="info-number">@totalTenantCount</div>
                    <div class="info-label">Toplam Kurum</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-success bg-opacity-10 text-success">
                    <i class="fas fa-user-shield"></i>
                </div>

                <div>
                    <div class="info-number">@tenantWithAdminCount</div>
                    <div class="info-label">Admin Atanmış Kurum</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-info bg-opacity-10 text-info">
                    <i class="fas fa-calendar-alt"></i>
                </div>

                <div>
                    <div class="info-number">@totalConferenceCount</div>
                    <div class="info-label">Toplam Kongre</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <div class="info-number">@totalUserCount</div>
                    <div class="info-label">Bağlı Kullanıcı</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <h5 class="fw-bold mb-1">
                Kurum Listesi
            </h5>

            <p class="text-muted small mb-0">
                Bu listede sistemde kayıtlı kurumları, admin atama durumlarını ve bağlı kayıt sayılarını görebilirsiniz.
            </p>
        </div>

        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-building-circle-exclamation fa-3x mb-3 opacity-25"></i>

                    <h6 class="fw-bold mb-1">
                        Kurum bulunamadı
                    </h6>

                    <p class="mb-0">
                        Henüz sisteme kayıtlı kurum bulunmuyor.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive tenants-table-responsive">
                    <table class="table table-hover align-middle mb-0 tenants-table">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-muted fw-bold small" style="width: 26%;">
                                    Kurum
                                </th>

                                <th class="py-3 text-muted fw-bold small" style="width: 14%;">
                                    URL
                                </th>

                                <th class="py-3 text-muted fw-bold small" style="width: 22%;">
                                    Kurum Admini
                                </th>

                                <th class="py-3 text-muted fw-bold small text-center" style="width: 10%;">
                                    Kongre
                                </th>

                                <th class="py-3 text-muted fw-bold small text-center" style="width: 10%;">
                                    Kullanıcı
                                </th>

                                <th class="py-3 text-muted fw-bold small text-center" style="width: 8%;">
                                    Durum
                                </th>

                                <th class="pe-4 py-3 text-muted fw-bold small text-end" style="min-width: 260px;">
                                    İşlemler
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                var firstLetter = !string.IsNullOrWhiteSpace(item.Name)
                                    ? item.Name.Trim().Substring(0, 1).ToUpper()
                                    : "?";

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="tenant-avatar me-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold">
                                                @firstLetter
                                            </div>

                                            <div>
                                                <span class="fw-bold d-block text-dark">
                                                    @item.Name
                                                </span>

                                                <small class="text-muted">
                                                    ID: @item.Id.ToString().Substring(0, 8)...
                                                </small>

                                                @if (!string.IsNullOrWhiteSpace(item.ScientificFieldName) || !string.IsNullOrWhiteSpace(item.CongressTypeName))
                                                {
                                                    <div class="tenant-meta mt-1">
                                                        @if (!string.IsNullOrWhiteSpace(item.ScientificFieldName))
                                                        {
                                                            <span class="tenant-meta-badge">
                                                                <i class="fas fa-flask me-1"></i>
                                                                @item.ScientificFieldName
                                                            </span>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(item.CongressTypeName))
                                                        {
                                                            <span class="tenant-meta-badge">
                                                                <i class="fas fa-tag me-1"></i>
                                                                @item.CongressTypeName
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Slug))
                                        {
                                            <a href="/@item.Slug"
                                               target="_blank"
                                               class="slug-link">
                                                @item.SlugPath
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.HasAdmin)
                                        {
                                            <span class="admin-badge bg-success bg-opacity-10 text-success">
                                                <i class="fas fa-user-shield me-1"></i>
                                                @item.AdminDisplayText
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge bg-warning bg-opacity-10 text-warning">
                                                <i class="fas fa-triangle-exclamation me-1"></i>
                                                Admin atanmamış
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <span class="count-badge bg-primary bg-opacity-10 text-primary">
                                            @item.ConferenceCount
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <span class="count-badge bg-info bg-opacity-10 text-info">
                                            @item.UserCount
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Aktif
                                        </span>
                                    </td>

                                    <td class="pe-4 text-end actions-cell">
                                        <div class="action-buttons">

                                            <a asp-area="Admin"
                                               asp-controller="Tenants"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-info rounded-3 action-icon-btn"
                                               title="Detay">
                                                <i class="fas fa-search"></i>
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Tenants"
                                               asp-action="AssignManager"
                                               asp-route-id="@item.Id"
                                               asp-route-returnUrl="@returnUrl"
                                               class="btn btn-sm btn-outline-secondary rounded-3 action-icon-btn"
                                               title="Kurum yöneticisi ata">
                                                <i class="fas fa-user-plus"></i>
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Tenants"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning rounded-3 action-icon-btn"
                                               title="Düzenle">
                                                <i class="fas fa-pen-to-square"></i>
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Tenants"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger rounded-3 action-icon-btn"
                                               title="Sil">
                                                <i class="fas fa-trash"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>

<style>
    .info-card {
        background-color: #fff;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        border: 1px solid #f1f5f9;
        min-height: 95px;
    }

    .info-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .info-number {
        font-size: 1.55rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }

    .info-label {
        color: #64748b;
        font-weight: 700;
        font-size: 0.76rem;
        margin-top: 0.25rem;
    }

    .tenants-table-responsive {
        overflow-x: auto;
    }

    .tenants-table {
        min-width: 1180px;
    }

    .tenants-table thead th {
        font-size: 0.7rem;
        letter-spacing: 0.8px;
        border-bottom: none;
        text-transform: uppercase;
    }

    .tenants-table tbody tr {
        border-bottom: 1px solid #f8fafc;
        transition: background-color 0.2s ease;
    }

    .tenants-table tbody tr:hover {
        background-color: #fbfcfe !important;
    }

    .tenant-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        font-size: 0.95rem;
    }

    .tenant-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .tenant-meta-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background-color: #f8fafc;
        color: #64748b;
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.18rem 0.45rem;
    }

    .slug-link {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background-color: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        text-decoration: none;
        padding: 0.35rem 0.65rem;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .slug-link:hover {
        color: #0a58ca;
        background-color: rgba(13, 110, 253, 0.12);
    }

    .admin-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.4rem 0.7rem;
        font-size: 0.76rem;
        font-weight: 800;
        max-width: 260px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 32px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 900;
    }

    .actions-cell {
        min-width: 260px;
        white-space: nowrap;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: nowrap;
    }

    .action-icon-btn {
        width: 36px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .page-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.65rem;
        flex-wrap: nowrap;
        flex: 0 0 auto;
    }

    .header-action-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        font-weight: 800;
        font-size: 0.95rem;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }
</style>
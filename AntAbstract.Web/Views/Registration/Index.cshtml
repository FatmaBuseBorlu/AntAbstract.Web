@using System.Globalization
@using AntAbstract.Domain.Entities
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model IEnumerable<RegistrationType>

@{
    ViewData["Title"] = Localizer["RegistrationTitle"].Value;
    Layout = "_Layout";

    var slug = ViewBag.Slug as string ?? "";
    var conferenceTitle = ViewBag.ConferenceTitle as string ?? Localizer["ConferenceTitleDefault"].Value;

    var ticketTypes = Model?.ToList() ?? new List<RegistrationType>();
}

<style>
    .registration-page {
        min-height: calc(100vh - 160px);
        padding: 60px 0;
    }

    .registration-wrapper {
        max-width: 560px;
        margin: 0 auto;
    }

    .registration-steps {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 28px;
        margin-bottom: 34px;
    }

    .registration-step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 120px;
    }

    .registration-step-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 24px;
        margin-bottom: 10px;
    }

        .registration-step-circle.active {
            background-color: #19aaf8;
            color: #fff;
        }

        .registration-step-circle.passive {
            background-color: #eef2f6;
            color: #6c757d;
        }

    .registration-step-line {
        flex: 1;
        max-width: 130px;
        height: 3px;
        background-color: #e8edf3;
        border-radius: 10px;
        margin-top: -28px;
    }

    .registration-step-label {
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        line-height: 1.4;
    }

        .registration-step-label.active {
            color: #0d6efd;
        }

        .registration-step-label.passive {
            color: #495057;
        }

    .ticket-card {
        width: 100%;
        border: 1px solid #e8eef5;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
        background-color: #fff;
    }

        .ticket-card .card-body {
            padding: 34px;
        }

    .ticket-icon-box {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        background: #eaf7ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #19aaf8;
        font-size: 28px;
        margin-bottom: 20px;
    }

    .ticket-title {
        font-size: 24px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 12px;
    }

    .ticket-description {
        font-size: 16px;
        color: #5f6b7a;
        line-height: 1.7;
        margin-bottom: 26px;
    }

    .ticket-price-wrap {
        padding: 26px 34px 18px 34px;
        border-top: 1px solid #eef2f6;
        background: #fff;
    }

    .ticket-price {
        font-size: 52px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }

    .ticket-currency {
        font-size: 20px;
        font-weight: 700;
        color: #5f6b7a;
        margin-left: 8px;
    }

    .deadline-box {
        margin: 18px 34px 0 34px;
        background: #f6f9fc;
        border: 1px solid #e7edf3;
        border-radius: 16px;
        padding: 16px 18px;
        color: #5f6b7a;
        font-size: 16px;
        display: flex;
        align-items: center;
    }

    .ticket-action {
        padding: 18px 34px 34px 34px;
    }

    .btn-ticket {
        width: 100%;
        border: none;
        border-radius: 18px;
        padding: 16px 20px;
        font-size: 18px;
        font-weight: 700;
        background: linear-gradient(90deg, #19aaf8 0%, #1595ea 100%);
        color: #fff;
        box-shadow: 0 10px 24px rgba(25, 170, 248, 0.22);
    }

        .btn-ticket:hover {
            color: #fff;
            opacity: 0.96;
        }

    .back-link-wrap {
        text-align: center;
        margin-top: 34px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 18px;
        font-weight: 600;
        color: #64748b;
        text-decoration: none;
    }

        .back-link:hover {
            color: #0d6efd;
        }

    @@media (max-width: 768px) {
        .registration-page {
            padding: 36px 0;
        }

        .registration-wrapper {
            max-width: 100%;
            padding: 0 14px;
        }

        .registration-step-item {
            min-width: 100px;
        }

        .registration-step-line {
            max-width: 70px;
        }

        .ticket-card .card-body,
        .ticket-price-wrap,
        .ticket-action {
            padding-left: 20px;
            padding-right: 20px;
        }

        .deadline-box {
            margin-left: 20px;
            margin-right: 20px;
        }

        .ticket-price {
            font-size: 40px;
        }
    }
</style>

<div class="registration-page">
    <div class="container">
        <div class="registration-wrapper">

            <div class="text-center mb-5">
                <h1 class="fw-bold text-dark mb-2">
                    @Localizer["RegistrationTitle"]
                </h1>

                <p class="text-muted mb-3">
                    @Localizer["RegistrationLead"]
                </p>

                <div class="badge bg-white text-dark border rounded-pill px-4 py-2 shadow-sm">
                    <i class="fas fa-university text-primary me-2"></i>
                    @conferenceTitle
                </div>
            </div>

            <div class="registration-steps">
                <div class="registration-step-item">
                    <div class="registration-step-circle active">1</div>

                    <div class="registration-step-label active">
                        @Localizer["Step1Label"]
                    </div>
                </div>

                <div class="registration-step-line"></div>

                <div class="registration-step-item">
                    <div class="registration-step-circle passive">2</div>

                    <div class="registration-step-label passive">
                        @Localizer["Step2Label"]
                    </div>
                </div>
            </div>

            @if (ticketTypes.Any())
            {
                foreach (var ticket in ticketTypes)
                {
                    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

                    var ticketName = isEnglish && !string.IsNullOrWhiteSpace(ticket.NameEn)
                    ? ticket.NameEn
                    : ticket.Name;

                    var ticketDescription = isEnglish && !string.IsNullOrWhiteSpace(ticket.DescriptionEn)
                    ? ticket.DescriptionEn
                    : ticket.Description;

                    <div class="ticket-card mb-4">
                        <div class="card-body">
                            <div class="ticket-icon-box">
                                <i class="fas fa-ticket-alt"></i>
                            </div>

                            <div class="ticket-title">
                                @ticketName
                            </div>

                            <div class="ticket-description">
                                @(string.IsNullOrWhiteSpace(ticketDescription)
                                                        ? Localizer["DefaultTicketDescription"].Value
                                                        : ticketDescription)
                    </div>
                </div>

                        <div class="ticket-price-wrap">
                            <span class="ticket-price">
                                @ticket.Price.ToString("N2", CultureInfo.CurrentCulture)
                            </span>

                            <span class="ticket-currency">
                                @ticket.Currency
                            </span>
                        </div>

                        <div class="deadline-box">
                            <i class="fas fa-check-circle me-2 text-success"></i>
                            @Localizer["NoDeadlineText"]
                        </div>

                        <div class="ticket-action">
                            <a href="/@slug/registration/checkout/@ticket.Id" class="btn btn-ticket">
                                @Localizer["SelectAndContinueButton"]
                                <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>
                        }
            }
            else
            {
                <div class="ticket-card">
                    <div class="card-body text-center py-5">
                        <h3 class="mb-3">
                            @Localizer["NoRegistrationTypeTitle"]
                        </h3>

                        <p class="text-muted mb-0">
                            @Localizer["NoRegistrationTypeDescription"]
                        </p>
                    </div>
                </div>
            }

            <div class="back-link-wrap">
                <a href="/@slug" class="back-link">
                    <i class="fas fa-arrow-left"></i>
                    @Localizer["BackToConferenceButton"]
                </a>
            </div>

        </div>
    </div>
</div>
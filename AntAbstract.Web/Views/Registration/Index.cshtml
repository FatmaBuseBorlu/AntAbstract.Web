@model List<AntAbstract.Domain.Entities.RegistrationType>
@using System.Globalization

@{
    ViewData["Title"] = "Kongre Kaydı";

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var slug = ViewBag.Slug as string ?? "";
    var conferenceTitle = ViewBag.ConferenceTitle as string ?? (isEnglish ? "Congress" : "Kongre");

    DateTime? conferenceStartDate = null;

    if (ViewBag.ConferenceStartDate is DateTime startDate)
    {
        conferenceStartDate = startDate;
    }

    var titleText = isEnglish
        ? "Welcome to the Congress Registration Page"
        : "Kongre Kayıt Ekranına Hoş Geldiniz";

    var descriptionText = isEnglish
        ? "You can create your congress registration here and continue with the abstract submission process after registration."
        : "Bu ekrandan kongre kaydınızı oluşturabilir ve kayıt sonrasında bildiri gönderim sürecine devam edebilirsiniz.";

    var selectTypeText = isEnglish
        ? "Select Registration Type"
        : "Kayıt Türü Seçiniz";

    var emptyTitle = isEnglish
        ? "No active registration type found"
        : "Aktif kayıt türü bulunamadı";

    var emptyDescription = isEnglish
        ? "There is currently no active registration type for this congress. Please contact the congress organization team."
        : "Bu kongre için şu anda aktif bir kayıt türü bulunmuyor. Lütfen kongre organizasyon ekibiyle iletişime geçiniz.";

    var continueText = isEnglish
        ? "Continue"
        : "Devam Et";

    var backText = isEnglish
        ? "Back to Congress Page"
        : "Kongre Sayfasına Dön";
}

<style>
    .registration-page {
        background: #f8fafc;
        min-height: calc(100vh - 90px);
        padding: 60px 0;
    }

    .registration-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 32%), linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 28px;
        padding: 46px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
        margin-bottom: 34px;
    }

    .registration-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.82rem;
        margin-bottom: 18px;
    }

    .registration-title {
        font-size: 2.4rem;
        font-weight: 900;
        letter-spacing: -1px;
        margin-bottom: 12px;
    }

    .registration-conference-name {
        color: #38bdf8;
        font-weight: 900;
    }

    .registration-description {
        color: rgba(255, 255, 255, 0.78);
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 780px;
        margin-bottom: 0;
    }

    .registration-section-title {
        font-weight: 900;
        color: #0f172a;
        margin-bottom: 20px;
    }

    .ticket-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 26px;
        height: 100%;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
        transition: all 0.22s ease;
    }

        .ticket-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 28px 70px rgba(15, 23, 42, 0.1);
            border-color: rgba(0, 174, 239, 0.35);
        }

    .ticket-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 18px;
    }

    .ticket-name {
        font-weight: 900;
        color: #0f172a;
        font-size: 1.15rem;
        margin-bottom: 8px;
    }

    .ticket-description {
        color: #64748b;
        line-height: 1.65;
        min-height: 54px;
        margin-bottom: 18px;
    }

    .ticket-price {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 18px;
    }

        .ticket-price strong {
            font-size: 2rem;
            color: #0f172a;
            font-weight: 900;
        }

        .ticket-price span {
            color: #64748b;
            font-weight: 800;
        }

    .deadline-box {
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 14px;
        padding: 10px 12px;
        font-size: 0.86rem;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .btn-register-ticket {
        background: #00aeef;
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 900;
        width: 100%;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-register-ticket:hover {
            background: #0095cd;
            color: #fff;
        }

    .empty-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 36px;
        text-align: center;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        border-radius: 20px;
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 18px;
    }

    @@media (max-width: 768px) {
        .registration-hero {
            padding: 30px 22px;
        }

        .registration-title {
            font-size: 1.8rem;
        }
    }
</style>

<section class="registration-page">
    <div class="container">

        <div class="registration-hero">
            <div class="registration-badge">
                <i class="fas fa-ticket-alt"></i>
                @(isEnglish ? "Congress Registration" : "Kongre Kaydı")
            </div>

            <h1 class="registration-title">
                @titleText
            </h1>

            <h2 class="registration-conference-name mb-3">
                @conferenceTitle
            </h2>

            @if (conferenceStartDate.HasValue)
            {
                <div class="mb-3 fw-bold text-white-50">
                    <i class="far fa-calendar-alt me-2"></i>
                    @conferenceStartDate.Value.ToLocalTime().ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                </div>
            }

            <p class="registration-description">
                @descriptionText
            </p>
        </div>

        <h3 class="registration-section-title">
            @selectTypeText
        </h3>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-card">
                <div class="empty-icon">
                    <i class="fas fa-exclamation-circle"></i>
                </div>

                <h4 class="fw-bold text-dark mb-2">
                    @emptyTitle
                </h4>

                <p class="text-muted mb-4">
                    @emptyDescription
                </p>

                <a href="/@slug" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                    <i class="fas fa-arrow-left me-2"></i>
                    @backText
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ticket in Model)
                {
                    var ticketName = isEnglish && !string.IsNullOrWhiteSpace(ticket.NameEn)
                    ? ticket.NameEn
                    : ticket.Name;

                    var ticketDescription = isEnglish && !string.IsNullOrWhiteSpace(ticket.DescriptionEn)
                    ? ticket.DescriptionEn
                    : ticket.Description;

                    var checkoutUrl = $"/{slug}/registration/checkout/{ticket.Id}";

                    <div class="col-md-6 col-lg-4">
                        <div class="ticket-card">
                            <div class="ticket-icon">
                                <i class="fas fa-receipt"></i>
                            </div>

                            <h4 class="ticket-name">
                                @ticketName
                            </h4>

                            <p class="ticket-description">
                                @(string.IsNullOrWhiteSpace(ticketDescription)
                                                        ? (isEnglish ? "Congress registration type" : "Kongre kayıt türü")
                                                        : ticketDescription)
                    </p>

                            <div class="ticket-price">
                                <strong>@ticket.Price.ToString("N2")</strong>
                                <span>@ticket.Currency</span>
                            </div>

                    @if (ticket.Deadline.HasValue)
                            {
                                <div class="deadline-box">
                                    <i class="far fa-clock me-2"></i>
                                    @(isEnglish ? "Deadline" : "Son tarih"):
                                    @ticket.Deadline.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                </div>
                            }

                            <a href="@checkoutUrl" class="btn-register-ticket">
                                @continueText
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
@using Microsoft.AspNetCore.Identity
@using AntAbstract.Domain.Entities
@inject UserManager<AppUser> UserManager
@model AntAbstract.Domain.Entities.Conference

@{
    Layout = "_Layout";
    var slug = ViewContext.RouteData.Values["slug"];
    var user = await UserManager.GetUserAsync(User);
    var backUrl = ViewBag.BackUrl as string;
    if (string.IsNullOrEmpty(backUrl))
    {
        backUrl = "/";
    }
}

<style>
    .step-indicator {
        display: flex;
        justify-content: center;
        margin-bottom: 30px;
    }

    .step {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin: 0 10px;
        position: relative;
        z-index: 1;
    }

        .step.active {
            background: #00aeef;
            color: white;
            box-shadow: 0 0 10px rgba(0, 174, 239, 0.4);
        }

    .step-line {
        height: 2px;
        background: #e9ecef;
        flex: 1;
        margin-top: 20px;
        max-width: 100px;
    }

    .summary-card {
        background-color: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .user-profile-mini {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: white;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .avatar-circle {
        width: 50px;
        height: 50px;
        background-color: #00aeef;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: bold;
    }

    .terms-link {
        color: #00aeef;
        text-decoration: none;
        border-bottom: 1px dashed #00aeef;
        transition: all 0.2s;
    }

        .terms-link:hover {
            color: #0077a3;
            border-bottom-style: solid;
        }
</style>

<div class="container mt-5 pt-5 mb-5">

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="d-flex align-items-center justify-content-center mb-4">
                <div class="text-center">
                    <div class="step active">1</div>
                    <small class="fw-bold mt-1 d-block text-primary">Kayıt Onayı</small>
                </div>
                <div class="step-line"></div>
                <div class="text-center">
                    <div class="step">2</div>
                    <small class="fw-bold mt-1 d-block text-muted">Ödeme</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-white p-4 text-center border-bottom">
                    <h4 class="fw-bold text-dark mb-1">Kongre Kayıt Onayı</h4>
                    <p class="text-muted small mb-0">Lütfen bilgilerinizi kontrol edip onaylayın</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <span class="badge bg-light text-primary border mb-2">@Model.StartDate.ToString("yyyy")</span>
                        <h5 class="fw-bold text-dark">@Model.Title</h5>
                        <div class="d-flex justify-content-center gap-3 text-muted small mt-2">
                            <span><i class="fas fa-calendar-alt me-1"></i> @Model.StartDate.ToString("dd MMMM yyyy")</span>
                            <span><i class="fas fa-map-marker-alt me-1"></i> @(Model.City ?? "Online")</span>
                        </div>
                    </div>

                    <div class="summary-card p-3 mb-4">
                        <label class="small text-muted fw-bold text-uppercase mb-2">Kayıt Yapılacak Hesap</label>
                        <div class="user-profile-mini">
                            <div class="avatar-circle">
                                @(user?.UserName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="lh-1">
                                <h6 class="fw-bold mb-1">@(user?.FirstName + " " + user?.LastName)</h6>
                                <small class="text-muted">@user?.Email</small> <br>
                                <small class="text-muted" style="font-size: 11px;">@user?.PhoneNumber</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <span class="fw-bold text-dark">Katılım Ücreti</span>
                            <div class="small text-muted">Standart Katılım Bedeli</div>
                        </div>
                        <div class="fs-4 fw-bold text-primary">
                            @ViewBag.Price @ViewBag.Currency
                        </div>
                    </div>

                    <form asp-action="Create" asp-route-slug="@slug" method="post">
                        <input type="hidden" name="conferenceId" value="@Model.Id" />

                        <div class="form-check bg-light p-3 rounded border mb-4">
                            <input class="form-check-input mt-1" type="checkbox" id="termsCheck" required style="cursor: pointer;">
                            <label class="form-check-label small text-muted lh-sm ms-2" for="termsCheck" style="cursor: pointer;">
                                <a href="#" class="terms-link fw-bold" data-bs-toggle="modal" data-bs-target="#termsModal">
                                    Katılım ve İptal Koşulları
                                </a>'nı okudum, kişisel verilerimin işlenmesini kabul ediyorum ve kaydımı onaylıyorum.
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold shadow-sm" style="background-color: #00aeef; border: none;">
                                <span>KAYDI TAMAMLA</span> <i class="fas fa-arrow-right ms-2"></i>
                            </button>

                            <a href="@backUrl" class="btn btn-link text-muted text-decoration-none btn-sm">Vazgeç ve Geri Dön</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4 text-muted small">
                <i class="fas fa-lock me-1"></i> Tüm işlemleriniz 256-bit SSL ile korunmaktadır.
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">

            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="termsModalLabel">
                    <i class="fas fa-file-contract me-2 text-primary"></i>Katılım ve İptal Koşulları
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <div class="modal-body p-4 text-secondary" style="font-size: 0.9rem; line-height: 1.7;">
                <h6 class="fw-bold text-dark mt-2">1. Taraflar</h6>
                <p>İşbu sözleşme, <strong>AntAbstract</strong> (Hizmet Sağlayıcı) ile Kongre Katılımcısı (Kullanıcı) arasında akdedilmiştir.</p>

                <h6 class="fw-bold text-dark mt-3">2. Hizmetin Kapsamı</h6>
                <p>Kullanıcı, işbu form ile seçmiş olduğu kongreye kayıt olmayı, belirlenen katılım ücretini ödemeyi ve kongre kurallarına uymayı taahhüt eder.</p>

                <h6 class="fw-bold text-dark mt-3">3. İptal ve İade Koşulları</h6>
                <div class="bg-light p-3 rounded-3 border mb-2">
                    <ul class="mb-0 ps-3">
                        <li>Kongre tarihine <strong>30 gün kala</strong> yapılan iptallerde ücretin %100'ü iade edilir.</li>
                        <li>Kongre tarihine <strong>15 gün kala</strong> yapılan iptallerde ücretin %50'si iade edilir.</li>
                        <li>Son 15 gün içerisinde yapılan iptallerde <strong>iade yapılmamaktadır.</strong></li>
                    </ul>
                </div>

                <h6 class="fw-bold text-dark mt-3">4. KVKK Aydınlatma Metni</h6>
                <p>
                    6698 sayılı Kişisel Verilerin Korunması Kanunu uyarınca, kimlik, iletişim ve ödeme bilgileriniz;
                    kongre kaydının oluşturulması, fatura kesilmesi ve iletişim faaliyetlerinin yürütülmesi amacıyla işlenmektedir.
                    Verileriniz yasal zorunluluklar haricinde üçüncü kişilerle paylaşılmamaktadır.
                </p>

                <p class="small text-muted fst-italic mt-4 border-top pt-2">
                    * Bu metin bilgilendirme amaçlıdır. Onaylayarak tüm koşulları kabul etmiş sayılırsınız.
                </p>
            </div>

            <div class="modal-footer border-top-0 px-4 pb-4">
                <button type="button" class="btn btn-light fw-bold rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary fw-bold rounded-pill px-4" onclick="acceptTerms()">
                    <i class="fas fa-check-circle me-2"></i> Okudum, Kabul Ediyorum
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    function acceptTerms() {
        var checkbox = document.getElementById('termsCheck');
        if(checkbox) {
            checkbox.checked = true;
            checkbox.focus(); 
        }

        var modalEl = document.getElementById('termsModal');
        var modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
    }
</script>
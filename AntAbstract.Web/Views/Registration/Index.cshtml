@using AntAbstract.Domain.Entities
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@model IEnumerable<RegistrationType>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_Layout";

    var slug = ViewBag.Slug as string ?? "";
    var conferenceTitle = ViewBag.ConferenceTitle as string ?? Localizer["ConferenceTitleDefault"].Value;

    var ticketTypes = Model?.ToList() ?? new List<RegistrationType>();
}

<style>
    .registration-page {
        min-height: 80vh;
        background: #f8fafc;
        padding: 70px 0;
    }

    .page-heading {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.7px;
    }

    .page-lead {
        color: #64748b;
        font-size: 1.05rem;
    }

    .step-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        margin-bottom: 35px;
    }

    .step-box {
        text-align: center;
    }

    .step {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        position: relative;
        z-index: 1;
    }

        .step.active {
            background: #00aeef;
            color: white;
            box-shadow: 0 8px 20px rgba(0, 174, 239, 0.25);
        }

    .step-line {
        width: 110px;
        height: 2px;
        background: #e2e8f0;
        margin: 21px 16px 0 16px;
    }

    .ticket-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
        transition: all 0.25s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .ticket-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.09);
            border-color: #00aeef;
        }

    .ticket-header {
        padding: 28px 28px 18px 28px;
        border-bottom: 1px solid #f1f5f9;
    }

    .ticket-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(0, 174, 239, 0.1);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 18px;
    }

    .ticket-title {
        font-weight: 800;
        color: #0f172a;
        font-size: 1.25rem;
        margin-bottom: 6px;
    }

    .ticket-description {
        color: #64748b;
        font-size: 0.92rem;
        min-height: 44px;
    }

    .ticket-body {
        padding: 24px 28px 28px 28px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .price-text {
        font-size: 2.1rem;
        line-height: 1;
        font-weight: 900;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .currency-text {
        font-weight: 800;
        color: #64748b;
        margin-left: 6px;
    }

    .deadline-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px 14px;
        color: #64748b;
        font-size: 0.9rem;
        margin-top: 18px;
    }

    .btn-register-ticket {
        background: linear-gradient(135deg, #00aeef 0%, #0984e3 100%);
        border: none;
        color: white;
        font-weight: 800;
        padding: 14px 18px;
        border-radius: 16px;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        margin-top: auto;
        box-shadow: 0 8px 22px rgba(0, 174, 239, 0.25);
        transition: all 0.25s ease;
    }

        .btn-register-ticket:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(0, 174, 239, 0.34);
        }

    .empty-card {
        background: white;
        border: 1px dashed #cbd5e1;
        border-radius: 24px;
        padding: 50px 30px;
        text-align: center;
        color: #64748b;
    }

    .empty-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #f8fafc;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.6rem;
        color: #94a3b8;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {
        .registration-page {
            padding: 40px 0;
        }

        .step-line {
            width: 60px;
        }

        .price-text {
            font-size: 1.8rem;
        }
    }
</style>

<div class="registration-page">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="page-heading mb-2">
                @Localizer["RegistrationTitle"]
            </h1>

            <p class="page-lead mb-2">
                @Localizer["RegistrationLead"]
            </p>

            <div class="badge bg-white text-dark border rounded-pill px-4 py-2 mt-2 shadow-sm">
                <i class="fas fa-university text-primary me-2"></i>
                @conferenceTitle
            </div>
        </div>

        <div class="step-wrapper">
            <div class="step-box">
                <div class="step active">1</div>
                <small class="fw-bold mt-2 d-block text-primary">
                    @Localizer["Step1Label"]
                </small>
            </div>

            <div class="step-line"></div>

            <div class="step-box">
                <div class="step">2</div>
                <small class="fw-bold mt-2 d-block text-muted">
                    @Localizer["Step2Label"]
                </small>
            </div>
        </div>

        @if (!ticketTypes.Any())
        {
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div class="empty-card">
                        <div class="empty-icon">
                            <i class="fas fa-ticket-alt"></i>
                        </div>

                        <h4 class="fw-bold text-dark mb-2">
                            @Localizer["NoRegistrationTypeTitle"]
                        </h4>

                        <p class="mb-4">
                            @Localizer["NoRegistrationTypeDescription"]
                        </p>

                        <a href="/@slug" class="btn btn-outline-primary rounded-pill px-4">
                            <i class="fas fa-arrow-left me-2"></i>
                            @Localizer["BackToConferenceButton"]
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                @foreach (var ticket in ticketTypes)
                {
                    var checkoutUrl = $"/{slug}/registration/checkout/{ticket.Id}";

                    <div class="col-md-6 col-lg-4">
                        <div class="ticket-card">
                            <div class="ticket-header">
                                <div class="ticket-icon">
                                    <i class="fas fa-ticket-alt"></i>
                                </div>

                                <h3 class="ticket-title">
                                    @ticket.Name
                                </h3>

                                <p class="ticket-description mb-0">
                                    @(string.IsNullOrWhiteSpace(ticket.Description)
                                                                ? Localizer["DefaultTicketDescription"].Value
                                                                : ticket.Description)
                        </p>
                    </div>

                            <div class="ticket-body">
                                <div class="d-flex align-items-end mb-2">
                                    <span class="price-text">
                                        @ticket.Price.ToString("N2")
                                    </span>

                                    <span class="currency-text">
                                        @ticket.Currency
                                    </span>
                                </div>

                        @if (ticket.Deadline.HasValue)
                                {
                                    <div class="deadline-box">
                                        <i class="far fa-clock me-2 text-warning"></i>
                                        @Localizer["DeadlineLabel"]:
                                        <strong>
                                            @ticket.Deadline.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                        </strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="deadline-box">
                                        <i class="fas fa-check-circle me-2 text-success"></i>
                                        @Localizer["NoDeadlineText"]
                                    </div>
                                }

                                <a href="@checkoutUrl" class="btn-register-ticket">
                                    <span>@Localizer["SelectAndContinueButton"]</span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-5">
                <a href="/@slug" class="text-decoration-none text-muted fw-bold">
                    <i class="fas fa-arrow-left me-2"></i>
                    @Localizer["BackToConferenceButton"]
                </a>
            </div>
        }
    </div>
</div>
@model List<AntAbstract.Domain.Entities.RegistrationType>

@using System
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Kongre Ön Kaydı";

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string T(string tr, string en)
    {
        return isEnglish ? en : tr;
    }

    var slug = ViewBag.Slug as string ?? "";
    var conferenceTitle = ViewBag.ConferenceTitle as string ?? T("Kongre", "Congress");

    DateTime? conferenceStartDate = null;

    if (ViewBag.ConferenceStartDate is DateTime startDate)
    {
        conferenceStartDate = startDate;
    }

    var congressHomeUrl = string.IsNullOrWhiteSpace(slug)
        ? "/"
        : $"/{slug}";

    var hasSlug = !string.IsNullOrWhiteSpace(slug);

    var titleText = T(
        "Kongre Ön Kayıt Ekranına Hoş Geldiniz",
        "Welcome to the Congress Pre-Registration Page"
    );

    var descriptionText = T(
        "Bu ekrandan kongre ön kaydınızı oluşturabilirsiniz. Ön kayıt sonrasında bildirinizin özetini göndereceksiniz. Ödeme yalnızca bildiriniz kabul edildikten sonra istenecektir.",
        "You can create your pre-registration here. After pre-registration, you will submit your abstract. Payment will be requested only after your abstract is accepted."
    );

    var selectTypeText = T(
        "Başvuru Türü Seçiniz",
        "Select Application Type"
    );

    var emptyTitle = T(
        "Aktif başvuru türü bulunamadı",
        "No active application type found"
    );

    var emptyDescription = T(
        "Bu kongre için şu anda aktif bir başvuru türü bulunmuyor. Lütfen kongre organizasyon ekibiyle iletişime geçiniz.",
        "There is currently no active application type for this congress. Please contact the congress organization team."
    );

    var continueText = T(
        "Ön Kayda Devam Et",
        "Continue to Pre-Registration"
    );

    var backText = T(
        "Kongre Sayfasına Dön",
        "Back to Congress Page"
    );

    var processTitleText = T(
        "Başvuru Süreci",
        "Application Process"
    );

    var step1Text = T(
        "Ön kayıt oluştur",
        "Create pre-registration"
    );

    var step2Text = T(
        "Bildiri gönder",
        "Submit abstract"
    );

    var step3Text = T(
        "Hakem değerlendirmesi",
        "Reviewer evaluation"
    );

    var step4Text = T(
        "Kabul sonrası ödeme yap",
        "Pay after acceptance"
    );

    var paymentInformationTitle = T(
        "Ödeme Bilgilendirmesi",
        "Payment Information"
    );

    var paymentLaterText = T(
        "Ön kayıt aşamasında ödeme alınmaz. Bildiriniz hakem değerlendirmesi sonrası kabul edilirse ödeme adımı açılacaktır.",
        "No payment is collected during pre-registration. If your abstract is accepted after reviewer evaluation, the payment step will be opened."
    );

    var applicationDeadlineText = T(
        "Başvuru son tarihi",
        "Application deadline"
    );

    var deadlineExpiredText = T(
        "Başvuru süresi doldu",
        "Application deadline has passed"
    );

    var missingCongressText = T(
        "Kongre bilgisi eksik",
        "Congress information is missing"
    );

    var defaultTicketName = T(
        "Başvuru Türü",
        "Application Type"
    );

    var defaultTicketDescription = T(
        "Bildiri gönderimi ve kongre katılım süreci için ön başvuru türüdür.",
        "This option creates your pre-application for abstract submission and congress participation."
    );
}

<style>
    .registration-page {
        background: #f8fafc;
        min-height: calc(100vh - 90px);
        padding: 60px 0;
    }

    .registration-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 18px;
        border: 1px solid transparent;
        font-weight: 800;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .registration-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .registration-alert-info {
        background: rgba(13, 110, 253, 0.10);
        border-color: rgba(13, 110, 253, 0.20);
        color: #0d6efd;
    }

    .registration-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .registration-hero {
        background:
            radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 32%),
            linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        border-radius: 28px;
        padding: 46px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
        margin-bottom: 34px;
    }

    .registration-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 0.82rem;
        margin-bottom: 18px;
    }

    .registration-title {
        font-size: 2.4rem;
        font-weight: 950;
        letter-spacing: -1px;
        margin-bottom: 12px;
    }

    .registration-conference-name {
        color: #38bdf8;
        font-weight: 950;
    }

    .registration-date {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: rgba(255, 255, 255, 0.72);
        font-weight: 800;
        margin-bottom: 1rem;
    }

    .registration-description {
        color: rgba(255, 255, 255, 0.82);
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 900px;
        margin-bottom: 0;
        font-weight: 600;
    }

    .registration-section-title {
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 20px;
        letter-spacing: -0.035em;
    }

    .process-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
        margin-bottom: 34px;
    }

    .process-title {
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 18px;
    }

    .process-step {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        height: 100%;
    }

    .process-step-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .process-step-text {
        color: #0f172a;
        font-weight: 850;
        font-size: 0.92rem;
        line-height: 1.35;
    }

    .ticket-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 26px;
        height: 100%;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
        transition: all 0.22s ease;
        display: flex;
        flex-direction: column;
    }

    .ticket-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 28px 70px rgba(15, 23, 42, 0.1);
        border-color: rgba(0, 174, 239, 0.35);
    }

    .ticket-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 18px;
    }

    .ticket-name {
        font-weight: 950;
        color: #0f172a;
        font-size: 1.15rem;
        margin-bottom: 8px;
        letter-spacing: -0.02em;
    }

    .ticket-description {
        color: #64748b;
        line-height: 1.65;
        min-height: 54px;
        margin-bottom: 18px;
        font-weight: 600;
    }

    .ticket-price {
        font-size: 1.75rem;
        font-weight: 950;
        color: #0f172a;
        letter-spacing: -0.03em;
        margin-bottom: 4px;
    }

    .ticket-price .currency {
        font-size: 1rem;
        font-weight: 700;
        color: #64748b;
        margin-right: 4px;
    }

    .ticket-price-free {
        font-size: 1.1rem;
        font-weight: 700;
        color: #16a34a;
    }

    .early-bird-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 999px;
        margin-bottom: 12px;
    }

    .price-row {
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid #e2e8f0;
    }

    .payment-later-box {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        color: #075985;
        border-radius: 16px;
        padding: 14px;
        margin-bottom: 18px;
    }

    .payment-later-label {
        font-size: 0.78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: #0369a1;
        margin-bottom: 6px;
    }

    .payment-later-note {
        font-size: 0.86rem;
        font-weight: 750;
        line-height: 1.5;
        margin-bottom: 0;
    }

    .deadline-box {
        background: #fff7ed;
        color: #9a3412;
        border: 1px solid #fed7aa;
        border-radius: 14px;
        padding: 10px 12px;
        font-size: 0.86rem;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .deadline-box-expired {
        background: #fef2f2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .btn-register-ticket {
        background: #00aeef;
        color: #ffffff;
        border: none;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 950;
        width: 100%;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: auto;
        transition: all 0.2s ease;
    }

    .btn-register-ticket:hover {
        background: #0095cd;
        color: #ffffff;
        transform: translateY(-1px);
        text-decoration: none;
    }

    .btn-register-ticket:disabled,
    .btn-register-ticket.disabled {
        background: #cbd5e1;
        color: #64748b;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
        pointer-events: none;
    }

    .empty-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 36px;
        text-align: center;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        border-radius: 20px;
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 18px;
    }

    @@media (max-width: 768px) {
        .registration-page { padding: 36px 0; }
        .registration-hero { padding: 30px 22px; border-radius: 22px; }
        .registration-title { font-size: 1.8rem; }
        .process-card, .ticket-card, .empty-card { border-radius: 20px; }
    }

    @@media (max-width: 575px) {
        .registration-page { padding: 16px 0; }
        .registration-hero { padding: 20px 16px; border-radius: 16px; }
        .registration-title { font-size: 1.4rem; }
        .ticket-card { padding: 1.25rem; }
        .price-row { flex-wrap: wrap; gap: .5rem; }
        /* Fiyat karşılaştırma tablosu yatay scroll */
        .price-comparison-table { overflow-x: auto; }
        /* Kayıt butonu tam genişlik */
        .ticket-card .btn { width: 100%; }
    }
</style>

<section class="registration-page">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert registration-alert registration-alert-success mb-4">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert registration-alert registration-alert-info mb-4">
                <i class="fas fa-info-circle"></i>
                <span>@TempData["InfoMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert registration-alert registration-alert-error mb-4">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="registration-hero">
            <div class="registration-badge">
                <i class="fas fa-clipboard-check"></i>
                @T("Kongre Ön Kaydı", "Congress Pre-Registration")
            </div>

            <h1 class="registration-title">
                @titleText
            </h1>

            <h2 class="registration-conference-name mb-3">
                @conferenceTitle
            </h2>

            @if (conferenceStartDate.HasValue)
            {
                <div class="registration-date">
                    <i class="far fa-calendar-alt"></i>
                    @conferenceStartDate.Value.ToLocalTime().ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                </div>
            }

            <p class="registration-description">
                @descriptionText
            </p>
        </div>

        <div class="process-card">
            <h4 class="process-title">
                @processTitleText
            </h4>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="process-step">
                        <div class="process-step-icon">
                            <i class="fas fa-user-check"></i>
                        </div>

                        <div class="process-step-text">
                            @step1Text
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="process-step">
                        <div class="process-step-icon">
                            <i class="fas fa-file-upload"></i>
                        </div>

                        <div class="process-step-text">
                            @step2Text
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="process-step">
                        <div class="process-step-icon">
                            <i class="fas fa-user-edit"></i>
                        </div>

                        <div class="process-step-text">
                            @step3Text
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="process-step">
                        <div class="process-step-icon">
                            <i class="fas fa-credit-card"></i>
                        </div>

                        <div class="process-step-text">
                            @step4Text
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h3 class="registration-section-title">
            @selectTypeText
        </h3>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-card">
                <div class="empty-icon">
                    <i class="fas fa-exclamation-circle"></i>
                </div>

                <h4 class="fw-bold text-dark mb-2">
                    @emptyTitle
                </h4>

                <p class="text-muted mb-4">
                    @emptyDescription
                </p>

                <a href="@congressHomeUrl" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                    <i class="fas fa-arrow-left me-2"></i>
                    @backText
                </a>
            </div>
        }
        else
        {
            @* Fiyat özet tablosu — birden fazla kayıt türü varsa göster *@
            @if (Model.Count > 1)
            {
                <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;overflow:hidden;">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead style="background:#f8fafc;">
                                <tr>
                                    <th class="ps-4 py-3">@T("Kayıt Türü", "Registration Type")</th>
                                    <th class="py-3">@T("Fiyat", "Price")</th>
                                    <th class="py-3">@T("Son Tarih", "Deadline")</th>
                                    <th class="py-3">@T("Durum", "Status")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model)
                                {
                                    var rowName = isEnglish && !string.IsNullOrWhiteSpace(t.NameEn) ? t.NameEn : t.Name;
                                    var expired = t.Deadline.HasValue && t.Deadline.Value.Date < DateTime.UtcNow.Date;
                                    var earlyRow = !expired && t.Deadline.HasValue;
                                    <tr class="@(expired ? "opacity-50" : "")">
                                        <td class="ps-4 fw-semibold">
                                            @rowName
                                            @if (earlyRow)
                                            {
                                                <span class="badge ms-2" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;font-size:.7rem;">
                                                    @T("Erken Kayıt", "Early Bird")
                                                </span>
                                            }
                                        </td>
                                        <td class="fw-bold">
                                            @if (t.Price <= 0)
                                            {
                                                <span class="text-success">@T("Ücretsiz", "Free")</span>
                                            }
                                            else
                                            {
                                                @($"{t.Currency} {t.Price:N0}")
                                            }
                                        </td>
                                        <td class="text-muted">
                                            @(t.Deadline.HasValue ? t.Deadline.Value.ToString("dd.MM.yyyy") : "—")
                                        </td>
                                        <td>
                                            @if (expired)
                                            {
                                                <span class="badge bg-danger">@T("Sona Erdi", "Expired")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@T("Açık", "Open")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="row g-4">
                @foreach (var ticket in Model)
                {
                    var ticketName = isEnglish && !string.IsNullOrWhiteSpace(ticket.NameEn)
                        ? ticket.NameEn
                        : ticket.Name;

                    var ticketDescription = isEnglish && !string.IsNullOrWhiteSpace(ticket.DescriptionEn)
                        ? ticket.DescriptionEn
                        : ticket.Description;

                    if (string.IsNullOrWhiteSpace(ticketName))
                    {
                        ticketName = defaultTicketName;
                    }

                    if (!isEnglish && ticketName.Contains("Yazar Katılım Ücreti", StringComparison.OrdinalIgnoreCase))
                    {
                        ticketName = "Yazar Ön Başvurusu";
                    }

                    if (!isEnglish && ticketName.Contains("Ücreti", StringComparison.OrdinalIgnoreCase))
                    {
                        ticketName = ticketName.Replace("Ücreti", "Başvurusu");
                    }

                    if (!isEnglish && ticketName.Contains("Ücret", StringComparison.OrdinalIgnoreCase))
                    {
                        ticketName = ticketName.Replace("Ücret", "Başvuru");
                    }

                    if (isEnglish &&
                        (
                            ticketName.Contains("Author Participation Fee", StringComparison.OrdinalIgnoreCase) ||
                            ticketName.Contains("Yazar Katılım Ücreti", StringComparison.OrdinalIgnoreCase)
                        ))
                    {
                        ticketName = "Author Pre-Application";
                    }

                    if (string.IsNullOrWhiteSpace(ticketDescription) ||
                        (!isEnglish && ticketDescription.Contains("katılım", StringComparison.OrdinalIgnoreCase)) ||
                        (!isEnglish && ticketDescription.Contains("ücret", StringComparison.OrdinalIgnoreCase)) ||
                        (isEnglish && ticketDescription.Contains("fee", StringComparison.OrdinalIgnoreCase)))
                    {
                        ticketDescription = defaultTicketDescription;
                    }

                    var checkoutUrl = hasSlug
                        ? $"/{slug}/registration/checkout/{ticket.Id}"
                        : "#";

                    var isDeadlineExpired = ticket.Deadline.HasValue &&
                                            ticket.Deadline.Value.Date < DateTime.UtcNow.Date;

                    var isEarlyBird = !isDeadlineExpired && ticket.Deadline.HasValue;
                    var daysUntilDeadline = ticket.Deadline.HasValue
                        ? (int)(ticket.Deadline.Value.Date - DateTime.UtcNow.Date).TotalDays
                        : int.MaxValue;
                    var urgentDeadline = isEarlyBird && daysUntilDeadline <= 7;
                    <div class="col-md-6 col-lg-4">
                        <div class="ticket-card @(isDeadlineExpired ? "opacity-60" : "")">
                            <div class="ticket-icon">
                                <i class="fas fa-file-signature"></i>
                            </div>

                            @if (isEarlyBird)
                            {
                                <div class="early-bird-badge">
                                    <i class="fas fa-bolt"></i>
                                    @if (urgentDeadline)
                                    {
                                        @($"Son {daysUntilDeadline} gün!")
                                    }
                                    else
                                    {
                                        @T("Erken Kayıt", "Early Bird")
                                    }
                                </div>
                            }

                            <h4 class="ticket-name">
                                @ticketName
                            </h4>

                            <p class="ticket-description">
                                @ticketDescription
                            </p>

                            <div class="price-row">
                                @if (ticket.Price <= 0)
                                {
                                    <div class="ticket-price-free">
                                        <i class="fas fa-check-circle me-1"></i>@T("Ücretsiz", "Free")
                                    </div>
                                }
                                else
                                {
                                    <div class="ticket-price">
                                        <span class="currency">@ticket.Currency</span>@ticket.Price.ToString("N0")
                                    </div>
                                    @if (isEarlyBird)
                                    {
                                        <small class="text-muted">@T("Erken kayıt fiyatı", "Early bird price")</small>
                                    }
                                }
                            </div>

                            <div class="payment-later-box">
                                <div class="payment-later-label">
                                    @paymentInformationTitle
                                </div>

                                <p class="payment-later-note">
                                    <i class="fas fa-info-circle me-1"></i>
                                    @paymentLaterText
                                </p>
                            </div>

                            @if (ticket.Deadline.HasValue)
                            {
                                <div class="deadline-box @(isDeadlineExpired ? "deadline-box-expired" : "")">
                                    <i class="far fa-clock me-2"></i>

                                    @if (isDeadlineExpired)
                                    {
                                        @deadlineExpiredText
                                    }
                                    else
                                    {
                                        @applicationDeadlineText
                                        <span>:</span>
                                        @ticket.Deadline.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                    }
                                </div>
                            }

                            @if (!hasSlug)
                            {
                                <button type="button" class="btn-register-ticket" disabled>
                                    @missingCongressText
                                </button>
                            }
                            else if (isDeadlineExpired)
                            {
                                <button type="button" class="btn-register-ticket" disabled>
                                    @deadlineExpiredText
                                </button>
                            }
                            else
                            {
                                <a href="@checkoutUrl" class="btn-register-ticket">
                                    @continueText
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
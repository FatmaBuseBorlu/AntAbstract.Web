@model AntAbstract.Domain.Entities.Registration
@using AntAbstract.Domain.Entities
@using System.Globalization

@{
    ViewData["Title"] = "Kongre Kaydı Onayı";

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var ticket = ViewBag.Ticket as RegistrationType;
    var user = ViewBag.User as AppUser;
    var slug = ViewBag.Slug as string ?? "";
    var conferenceTitle = ViewBag.ConferenceTitle as string ?? ticket?.Conference?.Title ?? (isEnglish ? "Congress" : "Kongre");

    DateTime? conferenceStartDate = null;

    if (ViewBag.ConferenceStartDate is DateTime startDate)
    {
        conferenceStartDate = startDate;
    }

    var titleText = isEnglish
        ? "Complete Your Congress Registration"
        : "Kongre Kaydınızı Tamamlayın";

    var welcomeText = isEnglish
        ? "Welcome to the registration screen of"
        : "Kayıt ekranına hoş geldiniz";

    var descriptionText = isEnglish
        ? "Please review your selected registration type and complete the billing information below."
        : "Seçtiğiniz kayıt türünü kontrol edip aşağıdaki fatura bilgilerini tamamlayınız.";

    var submitText = isEnglish
        ? "Create My Congress Registration"
        : "Kongre Kaydımı Oluştur";

    var backText = isEnglish
        ? "Back to Registration Types"
        : "Kayıt Türlerine Dön";
}

<style>
    .checkout-page {
        background: #f8fafc;
        min-height: calc(100vh - 90px);
        padding: 60px 0;
    }

    .checkout-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 32%), linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 28px;
        padding: 42px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
        margin-bottom: 30px;
    }

    .checkout-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.82rem;
        margin-bottom: 18px;
    }

    .checkout-title {
        font-size: 2.2rem;
        font-weight: 900;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    .checkout-conference-name {
        color: #38bdf8;
        font-weight: 900;
        margin-bottom: 12px;
    }

    .checkout-description {
        color: rgba(255, 255, 255, 0.78);
        font-size: 1.02rem;
        line-height: 1.8;
        max-width: 760px;
        margin-bottom: 0;
    }

    .checkout-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
    }

    .summary-card {
        background: #0f172a;
        color: #fff;
        border-radius: 22px;
        padding: 26px;
        height: 100%;
    }

    .summary-label {
        color: #94a3b8;
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .summary-value {
        font-weight: 900;
        font-size: 1.1rem;
        margin-bottom: 18px;
    }

    .summary-price {
        font-size: 2.1rem;
        font-weight: 900;
        color: #38bdf8;
    }

    .form-label {
        font-size: 0.82rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .form-control {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 12px 14px;
        background: #f8fafc;
        font-weight: 600;
    }

        .form-control:focus {
            background: #fff;
            border-color: #00aeef;
            box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
        }

    .btn-create-registration {
        background: #00aeef;
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 13px 22px;
        font-weight: 900;
    }

        .btn-create-registration:hover {
            background: #0095cd;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .checkout-hero {
            padding: 30px 22px;
        }

        .checkout-title {
            font-size: 1.8rem;
        }
    }
</style>

<section class="checkout-page">
    <div class="container">

        <div class="checkout-hero">
            <div class="checkout-badge">
                <i class="fas fa-check-circle"></i>
                @(isEnglish ? "Registration Confirmation" : "Kayıt Onayı")
            </div>

            <h1 class="checkout-title">
                @titleText
            </h1>

            <div class="mb-2 text-white-50 fw-bold">
                @welcomeText
            </div>

            <h2 class="checkout-conference-name">
                @conferenceTitle
            </h2>

            @if (conferenceStartDate.HasValue)
            {
                <div class="mb-3 fw-bold text-white-50">
                    <i class="far fa-calendar-alt me-2"></i>
                    @conferenceStartDate.Value.ToLocalTime().ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                </div>
            }

            <p class="checkout-description">
                @descriptionText
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="summary-card">
                    <div class="summary-label">
                        @(isEnglish ? "Selected Type" : "Seçilen Kayıt Türü")
                    </div>

                    <div class="summary-value">
                        @{
                            var ticketName = isEnglish && !string.IsNullOrWhiteSpace(ticket?.NameEn)
                            ? ticket.NameEn
                            : ticket?.Name;
                        }
                        @ticketName
                    </div>

                    <div class="summary-label">
                        @(isEnglish ? "Amount" : "Tutar")
                    </div>

                    <div class="summary-price">
                        @(ticket?.Price.ToString("N2") ?? Model.Amount.ToString("N2"))
                        <span style="font-size: 1rem;">@(ticket?.Currency ?? "TRY")</span>
                    </div>

                    @if (ticket?.Deadline != null)
                    {
                        <div class="mt-4">
                            <div class="summary-label">
                                @(isEnglish ? "Deadline" : "Son Tarih")
                            </div>

                            <div class="summary-value mb-0">
                                @ticket.Deadline.Value.ToLocalTime().ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                <div class="checkout-card">
                    <form method="post" action="/@slug/registration/checkout/@Model.RegistrationTypeId">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <h4 class="fw-bold text-dark mb-1">
                                @(isEnglish ? "Billing Information" : "Fatura Bilgileri")
                            </h4>

                            <p class="text-muted mb-0">
                                @(isEnglish
                                                                ? "If you do not need an invoice, you may leave optional fields blank."
                                                                : "Fatura gerekmiyorsa isteğe bağlı alanları boş bırakabilirsiniz.")
                            </p>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">
                                    @(isEnglish ? "Billing Name / Institution" : "Fatura Adı / Kurum Adı")
                                </label>
                                <input name="BillingName"
                                       class="form-control"
                                       value="@(user != null ? $"{user.FirstName} {user.LastName}" : "")" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    @(isEnglish ? "Tax Office" : "Vergi Dairesi")
                                </label>
                                <input name="TaxOffice" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    @(isEnglish ? "Tax Number / ID Number" : "Vergi Numarası / T.C. Kimlik No")
                                </label>
                                <input name="TaxNumber" class="form-control" value="@user?.IdentityNumber" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    @(isEnglish ? "Email" : "E-Posta")
                                </label>
                                <input class="form-control" value="@user?.Email" disabled />
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    @(isEnglish ? "Billing Address" : "Fatura Adresi")
                                </label>
                                <textarea name="BillingAddress" class="form-control" rows="4"></textarea>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-4">
                            <a href="/@slug/registration" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                                <i class="fas fa-arrow-left me-2"></i>
                                @backText
                            </a>

                            <button type="submit" class="btn btn-create-registration px-4">
                                @submitText
                                <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</section>
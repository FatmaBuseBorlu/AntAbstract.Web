@using Microsoft.AspNetCore.Identity
@using AntAbstract.Domain.Entities
@inject UserManager<AppUser> UserManager
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model AntAbstract.Domain.Entities.Registration

@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["PageTitle"].Value;

    var slug = ViewBag.Slug;
    var user = ViewBag.User as AppUser;
    var ticket = ViewBag.Ticket as RegistrationType;
    var backUrl = $"/{slug}/Registration";
}

<style>
    .step-indicator {
        display: flex;
        justify-content: center;
        margin-bottom: 30px;
    }

    .step {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin: 0 10px;
        position: relative;
        z-index: 1;
    }

        .step.active {
            background: #00aeef;
            color: white;
            box-shadow: 0 0 10px rgba(0, 174, 239, 0.4);
        }

    .step-line {
        height: 2px;
        background: #e9ecef;
        flex: 1;
        margin-top: 20px;
        max-width: 100px;
    }

    .summary-card {
        background-color: #f8f9fa;
        border-radius: 10px;
        border: 1px solid #e9ecef;
    }

    .user-profile-mini {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px;
        background: white;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .avatar-circle {
        width: 50px;
        height: 50px;
        background-color: #00aeef;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: bold;
    }

    .terms-link {
        color: #00aeef;
        text-decoration: none;
        border-bottom: 1px dashed #00aeef;
        transition: all 0.2s;
    }

        .terms-link:hover {
            color: #0077a3;
            border-bottom-style: solid;
        }
</style>

<div class="container mt-5 pt-5 mb-5">

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="d-flex align-items-center justify-content-center mb-4">
                <div class="text-center">
                    <div class="step active">1</div>
                    <small class="fw-bold mt-1 d-block text-primary">@Localizer["Step1Label"]</small>
                </div>
                <div class="step-line"></div>
                <div class="text-center">
                    <div class="step">2</div>
                    <small class="fw-bold mt-1 d-block text-muted">@Localizer["Step2Label"]</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-white p-4 text-center border-bottom">
                    <h4 class="fw-bold text-dark mb-1">@Localizer["HeaderTitle"]</h4>
                    <p class="text-muted small mb-0">@Localizer["HeaderDescription"]</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <span class="badge bg-light text-primary border mb-2">@ticket.Conference.StartDate.ToString("yyyy")</span>
                        <h5 class="fw-bold text-dark">@ticket.Conference.Title</h5>
                    </div>

                    <div class="summary-card p-3 mb-4">
                        <label class="small text-muted fw-bold text-uppercase mb-2">@Localizer["AccountSummaryLabel"]</label>
                        <div class="user-profile-mini">
                            <div class="avatar-circle">
                                @(user?.FirstName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div class="lh-1">
                                <h6 class="fw-bold mb-1">@(user?.FirstName + " " + user?.LastName)</h6>
                                <small class="text-muted">@user?.Email</small> <br>
                                <small class="text-muted" style="font-size: 11px;">@user?.PhoneNumber</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                        <div>
                            <span class="fw-bold text-dark text-uppercase">@ticket.Name</span>
                            <div class="small text-muted">@Localizer["ParticipationFeeText"]</div>
                        </div>
                        <div class="fs-4 fw-bold text-primary">
                            @ticket.Price.ToString("N2") @ticket.Currency
                        </div>
                    </div>

                    <form asp-action="CheckoutPost" asp-route-slug="@slug" asp-route-typeId="@ticket.Id" method="post">
                        @Html.AntiForgeryToken()

                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fas fa-file-invoice me-2 text-secondary"></i>@Localizer["InvoiceInfoTitle"]
                        </h6>

                        <div class="bg-light p-4 rounded-3 border mb-4">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold text-muted">
                                        @Localizer["BillingNameLabel"] <span class="text-danger">*</span>
                                    </label>
                                    <input type="text"
                                           class="form-control"
                                           name="BillingName"
                                           value="@(user?.FirstName + " " + user?.LastName)"
                                           required
                                           placeholder="@Localizer["BillingNamePlaceholder"]">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">@Localizer["TaxOfficeLabel"]</label>
                                    <input type="text"
                                           class="form-control"
                                           name="TaxOffice"
                                           placeholder="@Localizer["TaxOfficePlaceholder"]">
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-muted">
                                        @Localizer["TaxNumberLabel"] <span class="text-danger">*</span>
                                    </label>
                                    <input type="text"
                                           class="form-control"
                                           name="TaxNumber"
                                           required
                                           placeholder="@Localizer["TaxNumberPlaceholder"]">
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label small fw-bold text-muted">
                                        @Localizer["BillingAddressLabel"] <span class="text-danger">*</span>
                                    </label>
                                    <textarea class="form-control"
                                              name="BillingAddress"
                                              rows="2"
                                              required
                                              placeholder="@Localizer["BillingAddressPlaceholder"]"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="form-check bg-light p-3 rounded border mb-4">
                            <input class="form-check-input mt-1" type="checkbox" id="termsCheck" required style="cursor: pointer;">
                            <label class="form-check-label small text-muted lh-sm ms-2" for="termsCheck" style="cursor: pointer;">
                                <a href="#" class="terms-link fw-bold" data-bs-toggle="modal" data-bs-target="#termsModal">
                                    @Localizer["TermsLinkText"]
                                </a>
                                @Localizer["TermsApprovalText"]
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold shadow-sm" style="background-color: #00aeef; border: none;">
                                <span>@Localizer["GoToPaymentButton"]</span> <i class="fas fa-arrow-right ms-2"></i>
                            </button>

                            <a href="@backUrl" class="btn btn-link text-muted text-decoration-none btn-sm mt-2">
                                @Localizer["BackToTicketsButton"]
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4 text-muted small">
                <i class="fas fa-lock me-1"></i> @Localizer["SslInfoText"]
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark" id="termsModalLabel">
                    <i class="fas fa-file-contract me-2 text-primary"></i>@Localizer["TermsModalTitle"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["CloseButton"]"></button>
            </div>
            <div class="modal-body p-4 text-secondary" style="font-size: 0.9rem; line-height: 1.7;">
                <p>@Localizer["TermsModalBody"]</p>
            </div>
            <div class="modal-footer border-top-0 px-4 pb-4">
                <button type="button" class="btn btn-light fw-bold rounded-pill px-4" data-bs-dismiss="modal">@Localizer["CloseButton"]</button>
                <button type="button" class="btn btn-primary fw-bold rounded-pill px-4" onclick="acceptTerms()">
                    <i class="fas fa-check-circle me-2"></i> @Localizer["AcceptTermsButton"]
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function acceptTerms() {
        var checkbox = document.getElementById('termsCheck');
        if (checkbox) {
            checkbox.checked = true;
        }
        var modalEl = document.getElementById('termsModal');
        var modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
    }
</script>
@model AntAbstract.Domain.Entities.Registration

@using AntAbstract.Domain.Entities
@using System
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PreRegistrationPageTitle"].Value;

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var ticket = ViewBag.Ticket as RegistrationType;
    var user = ViewBag.User as AppUser;
    var slug = ViewBag.Slug as string ?? "";

    var hasSlug = !string.IsNullOrWhiteSpace(slug);

    var conferenceTitle = ViewBag.ConferenceTitle as string
        ?? ticket?.Conference?.Title
        ?? Localizer["Congress"].Value;

    DateTime? conferenceStartDate = null;

    if (ViewBag.ConferenceStartDate is DateTime startDate)
    {
        conferenceStartDate = startDate;
    }

    var registrationBackUrl = hasSlug
        ? $"/{slug}/registration"
        : "/";

    var checkoutPostUrl = hasSlug && Model != null && Model.RegistrationTypeId != Guid.Empty
        ? $"/{slug}/registration/checkout/{Model.RegistrationTypeId}"
        : "#";

    var ticketName = isEnglish && !string.IsNullOrWhiteSpace(ticket?.NameEn)
        ? ticket.NameEn
        : ticket?.Name;

    if (string.IsNullOrWhiteSpace(ticketName))
    {
        ticketName = Localizer["ApplicationType"].Value;
    }

    if (!isEnglish && ticketName.Contains("Yazar Katılım Ücreti", StringComparison.OrdinalIgnoreCase))
    {
        ticketName = "Yazar Ön Başvurusu";
    }

    if (!isEnglish && ticketName.Contains("Ücreti", StringComparison.OrdinalIgnoreCase))
    {
        ticketName = ticketName.Replace("Ücreti", "Başvurusu");
    }

    if (!isEnglish && ticketName.Contains("Ücret", StringComparison.OrdinalIgnoreCase))
    {
        ticketName = ticketName.Replace("Ücret", "Başvuru");
    }

    if (isEnglish &&
        (
            ticketName.Contains("Author Participation Fee", StringComparison.OrdinalIgnoreCase) ||
            ticketName.Contains("Yazar Katılım Ücreti", StringComparison.OrdinalIgnoreCase)
        ))
    {
        ticketName = "Author Pre-Application";
    }

    var ticketCurrency = string.IsNullOrWhiteSpace(ticket?.Currency)
        ? "TRY"
        : ticket.Currency;

    var amount = ticket != null
        ? ticket.Price
        : Model?.Amount ?? 0;

    var amountText = amount.ToString("N2", CultureInfo.CurrentUICulture);

    var isDeadlineExpired = ticket?.Deadline != null &&
                            ticket.Deadline.Value.Date < DateTime.UtcNow.Date;

    var userFullName = user == null
        ? ""
        : $"{user.FirstName} {user.LastName}".Trim();

    if (string.IsNullOrWhiteSpace(userFullName))
    {
        userFullName = user?.UserName ?? user?.Email ?? "";
    }

    var userEmail = user?.Email ?? "";

    var canSubmit = hasSlug &&
                    Model != null &&
                    Model.RegistrationTypeId != Guid.Empty &&
                    !isDeadlineExpired;
}

<style>
    .checkout-page {
        background: #f8fafc;
        min-height: calc(100vh - 90px);
        padding: 60px 0;
    }

    .checkout-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 18px;
        border: 1px solid transparent;
        font-weight: 800;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .checkout-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .checkout-alert-info {
        background: rgba(13, 110, 253, 0.10);
        border-color: rgba(13, 110, 253, 0.20);
        color: #0d6efd;
    }

    .checkout-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .checkout-hero {
        background:
            radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 32%),
            linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        border-radius: 28px;
        padding: 42px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
        margin-bottom: 30px;
    }

    .checkout-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 900;
        font-size: 0.82rem;
        margin-bottom: 18px;
    }

    .checkout-title {
        font-size: 2.2rem;
        font-weight: 950;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    .checkout-conference-name {
        color: #38bdf8;
        font-weight: 950;
        margin-bottom: 12px;
    }

    .checkout-date {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: rgba(255, 255, 255, 0.72);
        font-weight: 800;
        margin-bottom: 1rem;
    }

    .checkout-description {
        color: rgba(255, 255, 255, 0.82);
        font-size: 1.02rem;
        line-height: 1.8;
        max-width: 900px;
        margin-bottom: 0;
        font-weight: 600;
    }

    .checkout-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
    }

    .summary-card {
        background:
            radial-gradient(circle at top right, rgba(56, 189, 248, 0.16), transparent 34%),
            linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
        border-radius: 24px;
        padding: 26px;
        height: 100%;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.14);
    }

    .summary-label {
        color: #94a3b8;
        font-size: 0.78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .summary-value {
        font-weight: 900;
        font-size: 1.05rem;
        margin-bottom: 18px;
        line-height: 1.45;
    }

    .summary-price {
        font-size: 2.1rem;
        font-weight: 950;
        color: #38bdf8;
        line-height: 1.1;
    }

    .summary-price span {
        font-size: 1rem;
        color: #e0f2fe;
    }

    .summary-note {
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.22);
        border-radius: 16px;
        padding: 14px;
        color: #e0f2fe;
        font-weight: 750;
        font-size: 0.9rem;
        line-height: 1.6;
        margin-top: 18px;
    }

    .summary-deadline {
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .summary-deadline-expired {
        color: #fecaca;
        font-weight: 900;
    }

    .process-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 24px;
    }

    .process-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 18px;
        letter-spacing: -0.035em;
    }

    .process-item {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        margin-bottom: 18px;
    }

    .process-item:last-child {
        margin-bottom: 0;
    }

    .process-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-weight: 950;
    }

    .process-text {
        color: #334155;
        font-weight: 750;
        line-height: 1.6;
        padding-top: 6px;
    }

    .info-box {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        color: #075985;
        border-radius: 18px;
        padding: 18px;
        font-weight: 750;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .warning-box {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        border-radius: 18px;
        padding: 18px;
        font-weight: 850;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .btn-create-registration {
        background: #00aeef;
        color: #ffffff;
        border: none;
        border-radius: 999px;
        padding: 13px 22px;
        font-weight: 950;
        min-height: 48px;
        transition: all 0.2s ease;
    }

    .btn-create-registration:hover {
        background: #0095cd;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-create-registration:disabled {
        background: #cbd5e1;
        color: #64748b;
        cursor: not-allowed;
        transform: none;
    }

    .btn-back-registration {
        min-height: 48px;
        border-radius: 999px;
        padding: 0 1.25rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    @@media (max-width: 768px) {
        .checkout-page {
            padding: 36px 0;
        }

        .checkout-hero {
            padding: 30px 22px;
            border-radius: 22px;
        }

        .checkout-title {
            font-size: 1.8rem;
        }

        .checkout-card,
        .summary-card {
            border-radius: 20px;
            padding: 22px;
        }

        .checkout-actions {
            flex-direction: column;
            align-items: stretch !important;
        }

        .checkout-actions .btn,
        .checkout-actions button {
            width: 100%;
        }
    }

    @@media (max-width: 575px) {
        .checkout-hero {
            padding: 22px 16px;
        }

        .checkout-title {
            font-size: 1.4rem;
        }

        .checkout-card,
        .summary-card {
            padding: 16px;
        }

        .container {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
    }
</style>

<section class="checkout-page">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert checkout-alert checkout-alert-success mb-4">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert checkout-alert checkout-alert-info mb-4">
                <i class="fas fa-info-circle"></i>
                <span>@TempData["InfoMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert checkout-alert checkout-alert-error mb-4">
                <i class="fas fa-exclamation-triangle"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="checkout-hero">
            <div class="checkout-badge">
                <i class="fas fa-clipboard-check"></i>
                @Localizer["PreRegistrationConfirmation"]
            </div>

            <h1 class="checkout-title">
                @Localizer["ConfirmYourPreRegistration"]
            </h1>

            <div class="mb-2 text-white-50 fw-bold">
                @Localizer["WelcomeText"]
            </div>

            <h2 class="checkout-conference-name">
                @conferenceTitle
            </h2>

            @if (conferenceStartDate.HasValue)
            {
                <div class="checkout-date">
                    <i class="far fa-calendar-alt"></i>
                    @conferenceStartDate.Value.ToLocalTime().ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                </div>
            }

            <p class="checkout-description">
                @Localizer["DescriptionText"]
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="summary-card">
                    <div class="summary-label">
                        @Localizer["Congress"]
                    </div>

                    <div class="summary-value">
                        @conferenceTitle
                    </div>

                    @if (!string.IsNullOrWhiteSpace(userFullName))
                    {
                        <div class="summary-label">
                            @Localizer["Applicant"]
                        </div>

                        <div class="summary-value">
                            @userFullName
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(userEmail))
                    {
                        <div class="summary-label">
                            @Localizer["Email"]
                        </div>

                        <div class="summary-value">
                            @userEmail
                        </div>
                    }

                    <div class="summary-label">
                        @Localizer["SelectedApplicationType"]
                    </div>

                    <div class="summary-value">
                        @ticketName
                    </div>

                    <div class="summary-label">
                        @Localizer["PostAcceptanceFee"]
                    </div>

                    <div class="summary-price">
                        @amountText
                        <span>@ticketCurrency</span>
                    </div>

                    <div class="summary-note">
                        <i class="fas fa-info-circle me-1"></i>
                        @Localizer["PaymentLaterText"]
                        <br />
                        @Localizer["NoImmediatePaymentText"]
                    </div>

                    @if (ticket?.Deadline != null)
                    {
                        <div class="summary-deadline">
                            <div class="summary-label">
                                @Localizer["ApplicationDeadline"]
                            </div>

                            @if (isDeadlineExpired)
                            {
                                <div class="summary-value summary-deadline-expired mb-0">
                                    @Localizer["ExpiredDeadlineText"]
                                </div>
                            }
                            else
                            {
                                <div class="summary-value mb-0">
                                    @ticket.Deadline.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                <div class="checkout-card">

                    @if (!hasSlug)
                    {
                        <div class="warning-box">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @Localizer["MissingCongressText"]
                        </div>
                    }
                    else if (isDeadlineExpired)
                    {
                        <div class="warning-box">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @Localizer["ExpiredDeadlineText"]
                        </div>
                    }
                    else
                    {
                        <div class="info-box">
                            <i class="fas fa-circle-info me-2"></i>
                            @Localizer["InfoBoxText"]
                        </div>
                    }

                    <div class="process-box mb-4">
                        <h4 class="process-title">
                            @Localizer["ProcessTitle"]
                        </h4>

                        <div class="process-item">
                            <div class="process-icon">
                                1
                            </div>

                            <div class="process-text">
                                @Localizer["Step1"]
                            </div>
                        </div>

                        <div class="process-item">
                            <div class="process-icon">
                                2
                            </div>

                            <div class="process-text">
                                @Localizer["Step2"]
                            </div>
                        </div>

                        <div class="process-item">
                            <div class="process-icon">
                                3
                            </div>

                            <div class="process-text">
                                @Localizer["Step3"]
                            </div>
                        </div>

                        <div class="process-item">
                            <div class="process-icon">
                                4
                            </div>

                            <div class="process-text">
                                @Localizer["Step4"]
                            </div>
                        </div>
                    </div>

                    <form method="post" action="@checkoutPostUrl">
                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-4 checkout-actions">
                            <a href="@registrationBackUrl" class="btn btn-outline-secondary btn-back-registration">
                                <i class="fas fa-arrow-left me-2"></i>
                                @Localizer["BackToApplicationTypes"]
                            </a>

                            <button type="submit"
                                    class="btn btn-create-registration px-4"
                                    @(canSubmit ? "" : "disabled")>
                                @Localizer["SubmitButton"]
                                <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</section>

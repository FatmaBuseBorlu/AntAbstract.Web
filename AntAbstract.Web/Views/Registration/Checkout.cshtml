@model AntAbstract.Domain.Entities.Registration
@using AntAbstract.Domain.Entities
@using System.Globalization

@{
    ViewData["Title"] = "Kongre Ön Kayıt Onayı";

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var ticket = ViewBag.Ticket as RegistrationType;
    var user = ViewBag.User as AppUser;
    var slug = ViewBag.Slug as string ?? "";

    var conferenceTitle = ViewBag.ConferenceTitle as string
        ?? ticket?.Conference?.Title
        ?? (isEnglish ? "Congress" : "Kongre");

    DateTime? conferenceStartDate = null;

    if (ViewBag.ConferenceStartDate is DateTime startDate)
    {
        conferenceStartDate = startDate;
    }

    var registrationBackUrl = string.IsNullOrWhiteSpace(slug)
        ? "/"
        : $"/{slug}/registration";

    var checkoutPostUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}/registration/checkout/{Model.RegistrationTypeId}";

    var ticketName = isEnglish && !string.IsNullOrWhiteSpace(ticket?.NameEn)
        ? ticket.NameEn
        : ticket?.Name;

    if (string.IsNullOrWhiteSpace(ticketName))
    {
        ticketName = isEnglish ? "Application Type" : "Başvuru Türü";
    }

    var ticketCurrency = string.IsNullOrWhiteSpace(ticket?.Currency)
        ? "TRY"
        : ticket.Currency;

    var amountText = ticket != null
        ? ticket.Price.ToString("N2")
        : Model.Amount.ToString("N2");

    var titleText = isEnglish
        ? "Confirm Your Congress Pre-Registration"
        : "Kongre Ön Kaydınızı Onaylayın";

    var welcomeText = isEnglish
        ? "You are creating a pre-registration for"
        : "Aşağıdaki kongre için ön kayıt oluşturuyorsunuz";

    var descriptionText = isEnglish
        ? "At this step, no payment will be collected. After your pre-registration, you will be redirected to the abstract submission screen. Payment will be requested only after your abstract is accepted."
        : "Bu aşamada ödeme alınmayacaktır. Ön kayıt sonrası bildiri gönderim ekranına yönlendirileceksiniz. Ödeme yalnızca bildiriniz kabul edildikten sonra istenecektir.";

    var submitText = isEnglish
        ? "Create Pre-Registration and Continue to Abstract Submission"
        : "Ön Kaydı Oluştur ve Bildiri Gönderimine Geç";

    var backText = isEnglish
        ? "Back to Application Types"
        : "Başvuru Türlerine Dön";

    var selectedTypeText = isEnglish
        ? "Selected Application Type"
        : "Seçilen Başvuru Türü";

    var feeLabelText = isEnglish
        ? "Post-acceptance participation fee"
        : "Kabul Sonrası Katılım Ücreti";

    var paymentLaterText = isEnglish
        ? "Payment will be requested only after your abstract is accepted."
        : "Ödeme yalnızca bildiriniz kabul edildikten sonra istenecektir.";

    var noImmediatePaymentText = isEnglish
        ? "No payment or invoice information is required at this step."
        : "Bu aşamada ödeme veya fatura bilgisi istenmez.";

    var processTitleText = isEnglish
        ? "What happens next?"
        : "Sonraki Süreç Nasıl İlerleyecek?";

    var step1Text = isEnglish
        ? "Your pre-registration will be created."
        : "Ön kaydınız oluşturulacak.";

    var step2Text = isEnglish
        ? "You will submit your abstract."
        : "Bildirinizi sisteme yükleyeceksiniz.";

    var step3Text = isEnglish
        ? "Reviewers will evaluate your abstract."
        : "Hakemler bildiriyi değerlendirecek.";

    var step4Text = isEnglish
        ? "If accepted, payment and participation steps will open."
        : "Kabul edilirse ödeme ve katılım adımları açılacak.";
}

<style>
    .checkout-page {
        background: #f8fafc;
        min-height: calc(100vh - 90px);
        padding: 60px 0;
    }

    .checkout-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.18), transparent 32%), linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 28px;
        padding: 42px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.18);
        margin-bottom: 30px;
    }

    .checkout-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.22);
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.82rem;
        margin-bottom: 18px;
    }

    .checkout-title {
        font-size: 2.2rem;
        font-weight: 900;
        letter-spacing: -1px;
        margin-bottom: 10px;
    }

    .checkout-conference-name {
        color: #38bdf8;
        font-weight: 900;
        margin-bottom: 12px;
    }

    .checkout-description {
        color: rgba(255, 255, 255, 0.82);
        font-size: 1.02rem;
        line-height: 1.8;
        max-width: 860px;
        margin-bottom: 0;
    }

    .checkout-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.06);
    }

    .summary-card {
        background: #0f172a;
        color: #fff;
        border-radius: 22px;
        padding: 26px;
        height: 100%;
    }

    .summary-label {
        color: #94a3b8;
        font-size: 0.82rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .summary-value {
        font-weight: 900;
        font-size: 1.1rem;
        margin-bottom: 18px;
    }

    .summary-price {
        font-size: 2.1rem;
        font-weight: 900;
        color: #38bdf8;
    }

    .summary-note {
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.22);
        border-radius: 16px;
        padding: 14px;
        color: #e0f2fe;
        font-weight: 700;
        font-size: 0.9rem;
        line-height: 1.6;
        margin-top: 18px;
    }

    .process-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 24px;
    }

    .process-title {
        color: #0f172a;
        font-weight: 900;
        margin-bottom: 18px;
    }

    .process-item {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        margin-bottom: 18px;
    }

        .process-item:last-child {
            margin-bottom: 0;
        }

    .process-icon {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-weight: 900;
    }

    .process-text {
        color: #334155;
        font-weight: 700;
        line-height: 1.6;
        padding-top: 6px;
    }

    .info-box {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        color: #075985;
        border-radius: 18px;
        padding: 18px;
        font-weight: 700;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .btn-create-registration {
        background: #00aeef;
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 13px 22px;
        font-weight: 900;
    }

        .btn-create-registration:hover {
            background: #0095cd;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .checkout-hero {
            padding: 30px 22px;
        }

        .checkout-title {
            font-size: 1.8rem;
        }
    }
</style>

<section class="checkout-page">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success rounded-4 fw-bold mb-4">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info rounded-4 fw-bold mb-4">
                <i class="fas fa-info-circle me-2"></i>
                @TempData["InfoMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-bold mb-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="checkout-hero">
            <div class="checkout-badge">
                <i class="fas fa-clipboard-check"></i>
                @(isEnglish ? "Pre-Registration Confirmation" : "Ön Kayıt Onayı")
            </div>

            <h1 class="checkout-title">
                @titleText
            </h1>

            <div class="mb-2 text-white-50 fw-bold">
                @welcomeText
            </div>

            <h2 class="checkout-conference-name">
                @conferenceTitle
            </h2>

            @if (conferenceStartDate.HasValue)
            {
                <div class="mb-3 fw-bold text-white-50">
                    <i class="far fa-calendar-alt me-2"></i>
                    @conferenceStartDate.Value.ToLocalTime().ToString("dd MMMM yyyy", CultureInfo.CurrentUICulture)
                </div>
            }

            <p class="checkout-description">
                @descriptionText
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="summary-card">
                    <div class="summary-label">
                        @(isEnglish ? "Congress" : "Kongre")
                    </div>

                    <div class="summary-value">
                        @conferenceTitle
                    </div>

                    <div class="summary-label">
                        @selectedTypeText
                    </div>

                    <div class="summary-value">
                        @ticketName
                    </div>

                    <div class="summary-label">
                        @feeLabelText
                    </div>

                    <div class="summary-price">
                        @amountText
                        <span style="font-size: 1rem;">@ticketCurrency</span>
                    </div>

                    <div class="summary-note">
                        <i class="fas fa-info-circle me-1"></i>
                        @paymentLaterText
                        <br />
                        @noImmediatePaymentText
                    </div>

                    @if (ticket?.Deadline != null)
                    {
                        <div class="mt-4">
                            <div class="summary-label">
                                @(isEnglish ? "Application Deadline" : "Başvuru Son Tarihi")
                            </div>

                            <div class="summary-value mb-0">
                                @ticket.Deadline.Value.ToLocalTime().ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                <div class="checkout-card">

                    <div class="info-box">
                        <i class="fas fa-circle-info me-2"></i>
                        @(isEnglish
                                                ? "This screen only creates your congress pre-registration. You will not be charged now. After your abstract is accepted, the payment step will become available."
                                                : "Bu ekran yalnızca kongre ön kaydınızı oluşturur. Şu anda ödeme alınmaz. Bildiriniz kabul edildikten sonra ödeme adımı aktif olacaktır.")
                    </div>

                    <div class="process-box mb-4">
                        <h4 class="process-title">
                            @processTitleText
                        </h4>

                        <div class="process-item">
                            <div class="process-icon">
                                1
                            </div>

                            <div class="process-text">
                                @step1Text
                            </div>
                        </div>

                        <div class="process-item">
                            <div class="process-icon">
                                2
                            </div>

                            <div class="process-text">
                                @step2Text
                            </div>
                        </div>

                        <div class="process-item">
                            <div class="process-icon">
                                3
                            </div>

                            <div class="process-text">
                                @step3Text
                            </div>
                        </div>

                        <div class="process-item">
                            <div class="process-icon">
                                4
                            </div>

                            <div class="process-text">
                                @step4Text
                            </div>
                        </div>
                    </div>

                    <form method="post" action="@checkoutPostUrl">
                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-4">
                            <a href="@registrationBackUrl" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                                <i class="fas fa-arrow-left me-2"></i>
                                @backText
                            </a>

                            <button type="submit" class="btn btn-create-registration px-4">
                                @submitText
                                <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</section>
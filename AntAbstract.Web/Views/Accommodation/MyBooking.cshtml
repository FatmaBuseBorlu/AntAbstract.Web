@model AntAbstract.Domain.Entities.AccommodationBooking
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;
        return string.Equals(value, key, StringComparison.Ordinal) ? fallback : value;
    }

    ViewData["Title"] = L("PageTitle", "Rezervasyonum");
    Layout = "_LayoutDashboard";

    var slug = ViewBag.Slug as string ?? "";
    var conferenceTitle = ViewBag.ConferenceTitle as string ?? "";
    var nights = (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days;
}

<div class="container-fluid px-4 py-4" style="max-width:700px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/@slug/Accommodation?conferenceId=@Model.ConferenceId">@L("Accommodation", "Konaklama")</a></li>
            <li class="breadcrumb-item active">@L("MyReservation", "Rezervasyonum")</li>
        </ol>
    </nav>


    <div class="card border-0 shadow-lg" style="border-radius:20px;overflow:hidden;">
        <div class="card-header p-4 text-white d-flex align-items-center gap-3"
             style="background:linear-gradient(135deg,@(Model.IsPaid ? "#16a34a,#22c55e" : "#f59e0b,#fbbf24"));">
            <i class="fas fa-@(Model.IsPaid ? "check-circle" : "clock") fa-2x"></i>
            <div>
                <h5 class="fw-bold mb-0">@(Model.IsPaid ? L("Approved", "Onaylandı") : L("PaymentPending", "Ödeme Bekleniyor"))</h5>
                <p class="mb-0 small opacity-80">@conferenceTitle</p>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-light">
                        <div class="small text-muted fw-semibold mb-1">@L("HotelAndRoom", "Otel & Oda")</div>
                        <div class="fw-bold">@Model.RoomType.Hotel.Name</div>
                        <div class="text-muted">@Model.RoomType.Name — @Model.RoomType.Price @Model.RoomType.Currency @L("PerNight", "/ gece")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light">
                        <div class="small text-muted fw-semibold mb-1">@L("CheckInDate", "Giriş Tarihi")</div>
                        <div class="fw-bold">@Model.CheckInDate.ToString("dd MMMM yyyy")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light">
                        <div class="small text-muted fw-semibold mb-1">@L("CheckOutDate", "Çıkış Tarihi")</div>
                        <div class="fw-bold">@Model.CheckOutDate.ToString("dd MMMM yyyy")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light">
                        <div class="small text-muted fw-semibold mb-1">@L("StayDuration", "Konaklama Süresi")</div>
                        <div class="fw-bold">@string.Format(L("Nights", "{0} gece"), nights)</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light">
                        <div class="small text-muted fw-semibold mb-1">@L("TotalAmount", "Toplam Tutar")</div>
                        <div class="fw-bold text-primary fs-5">@Model.TotalAmount.ToString("N2") TL</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.RoommateName))
                {
                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light">
                            <div class="small text-muted fw-semibold mb-1">@L("Roommate", "Oda Arkadaşı")</div>
                            <div class="fw-bold">@Model.RoommateName</div>
                        </div>
                    </div>
                }
                @if (Model.TransferOption != null)
                {
                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light">
                            <div class="small text-muted fw-semibold mb-1">@L("Transfer", "Transfer")</div>
                            <div class="fw-bold">@Model.TransferOption.Name — @Model.TransferOption.Price @Model.TransferOption.Currency</div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.IsPaid)
            {
                <div class="alert d-flex align-items-center gap-3 mt-4"
                     style="border-radius:12px;background:#fffbeb;border-left:4px solid #f59e0b;color:#92400e;">
                    <i class="fas fa-exclamation-triangle fa-lg"></i>
                    <div class="small">
                        @L("PaymentPendingInfo", "Rezervasyonunuz oluşturuldu. Ödeme onayı tamamlandıktan sonra konaklama kaydınız kesinleşir.")
                    </div>
                </div>
            }
        </div>
    </div>
</div>

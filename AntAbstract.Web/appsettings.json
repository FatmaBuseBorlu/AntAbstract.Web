{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "#{CONNECTION_STRING}#"
  },
  "Stripe": {
    "PublishableKey": "#{STRIPE_PUBLISHABLE_KEY}#",
    "SecretKey": "#{STRIPE_SECRET_KEY}#",
    "WebhookSecret": "#{STRIPE_WEBHOOK_SECRET}#"
  },
  "PayTR": {
    "MerchantId": "#{PAYTR_MERCHANT_ID}#",
    "MerchantKey": "#{PAYTR_MERCHANT_KEY}#",
    "MerchantSalt": "#{PAYTR_MERCHANT_SALT}#",
    "TestMode": "true"
  },
  "Plagiarism": {
    "ApiKey": "#{PLAGIARISM_API_KEY}#",
    "BaseUrl": "https://api.turnitin.com/api/v1"
  },
  "Email": {
    "SmtpServer": "#{SMTP_SERVER}#",
    "Port": 587,
    "Username": "#{SMTP_USERNAME}#",
    "Password": "#{SMTP_PASSWORD}#",
    "SenderName": "Kongre Yönetim Sistemi",
    "SenderEmail": "no-reply@antabstract.com",
    "UseSsl": true,
    "BaseUrl": "https://antabstract.com"
  },
  "Authentication": {
    "ORCID": {
      "Authority": "https://orcid.org",
      "ClientId": "#{ORCID_CLIENT_ID}#",
      "ClientSecret": "#{ORCID_CLIENT_SECRET}#"
    }
  },
  "AllowedHosts": "*",
  "Health": {
    "StatusApiKey": "SET_VIA_ENV_OR_SECRETS"
  },
  "MailReminder": {
    "IntervalHours": 6
  }
}

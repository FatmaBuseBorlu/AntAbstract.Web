{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "#{PRODUCTION_CONNECTION_STRING}#"
  },
  "Stripe": {
    "PublishableKey": "#{STRIPE_PUBLISHABLE_KEY}#",
    "SecretKey": "#{STRIPE_SECRET_KEY}#",
    "WebhookSecret": "#{STRIPE_WEBHOOK_SECRET}#",
    "BaseUrl": "#{PUBLIC_BASE_URL}#"
  },
  "Jwt": {
    "Key": "#{JWT_SECRET_KEY}#",
    "Issuer": "AntAbstract"
  },
  "PayTR": {
    "MerchantId": "#{PAYTR_MERCHANT_ID}#",
    "MerchantKey": "#{PAYTR_MERCHANT_KEY}#",
    "MerchantSalt": "#{PAYTR_MERCHANT_SALT}#",
    "TestMode": "false"
  },
  "Plagiarism": {
    "ApiKey": "#{PLAGIARISM_API_KEY}#",
    "BaseUrl": "https://api.turnitin.com/api/v1"
  },
  "Doi": {
    "Provider": "Manual",
    "Prefix": "#{DOI_PREFIX}#",
    "LandingPageBaseUrl": "#{PUBLIC_BASE_URL}#"
  },
  "Email": {
    "SmtpServer": "#{SMTP_SERVER}#",
    "Port": 587,
    "Username": "#{SMTP_USERNAME}#",
    "Password": "#{SMTP_PASSWORD}#",
    "SenderName": "Kongre Yönetim Sistemi",
    "SenderEmail": "no-reply@antabstract.com.tr",
    "UseSsl": true,
    "BaseUrl": "#{PUBLIC_BASE_URL}#"
  },
  "Authentication": {
    "ORCID": {
      "Authority": "https://orcid.org",
      "ClientId": "#{ORCID_CLIENT_ID}#",
      "ClientSecret": "#{ORCID_CLIENT_SECRET}#"
    }
  },
  "Health": {
    "StatusApiKey": "#{HEALTH_API_KEY}#"
  },
  "MailReminder": {
    "IntervalHours": 6
  }
}

@model AntAbstract.Domain.Entities.ConferencePageBlock
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = "Blok Düzenle";
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString();

    string? btnText = null, btnUrl = null, bgImage = null, sideImage = null;
    if (Model.BlockType == ConferencePageBlockType.Hero && !string.IsNullOrWhiteSpace(Model.ContentJson))
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(Model.ContentJson);
            var root = doc.RootElement;
            if (root.TryGetProperty("buttonText", out var bt)) btnText = bt.GetString();
            if (root.TryGetProperty("buttonUrl", out var bu)) btnUrl = bu.GetString();
            if (root.TryGetProperty("backgroundImageUrl", out var bgi)) bgImage = bgi.GetString();
            if (root.TryGetProperty("imageUrl", out var img)) sideImage = img.GetString();
        }
        catch { }
    }
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-dark">⚙️ Blok Düzenle</h4>
            <p class="text-muted small mb-0"><strong>@Model.Title</strong> isimli bloğun ayarlarını ve içeriğini güncelliyorsunuz.</p>
        </div>
        <a class="btn btn-light border shadow-sm px-3"
           asp-area="Admin" asp-controller="Website" asp-action="Index"
           asp-route-slug="@slug" asp-route-culture="@Model.Culture"
           asp-route-page="@Model.Page" asp-route-conferenceId="@Model.ConferenceId">
            <i class="fas fa-arrow-left me-2"></i> Listeye Dön
        </a>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7 mb-4">
            <div class="card border-0 shadow-sm rounded-4 border-top border-warning border-4">
                <div class="card-body p-4 p-md-5">

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 shadow-sm rounded-3 small" })

                    <form asp-area="Admin" asp-controller="Website" asp-action="Edit" asp-route-slug="@slug" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ConferenceId" />
                        <input type="hidden" asp-for="ContentJson" />

                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small" asp-for="Page">SAYFA (PAGE)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-file-alt"></i></span>
                                    <input class="form-control bg-light border-start-0 ps-0 text-muted" asp-for="Page" readonly />
                                </div>
                                <span class="text-danger small mt-1" asp-validation-for="Page"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small" asp-for="Culture">DİL (CULTURE)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-globe"></i></span>
                                    <select class="form-select bg-light border-start-0 ps-0 text-muted" asp-for="Culture" disabled>
                                        <option value="tr-TR">Türkçe (tr-TR)</option>
                                        <option value="en-US">English (en-US)</option>
                                    </select>
                                    <input type="hidden" asp-for="Culture" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small" asp-for="BlockType">BLOK TİPİ</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-warning"><i class="fas fa-cubes"></i></span>
                                    <select class="form-select bg-light border-start-0 ps-0 fw-bold" id="BlockType" asp-for="BlockType" asp-items="Html.GetEnumSelectList<ConferencePageBlockType>()"></select>
                                </div>
                                <span class="text-danger small mt-1" asp-validation-for="BlockType"></span>
                            </div>

                            <div class="col-md-12 mt-4">
                                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">Metin İçerikleri</h6>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small" asp-for="Title">BAŞLIK <span class="text-danger">*</span></label>
                                <input class="form-control" asp-for="Title" />
                                <span class="text-danger small mt-1" asp-validation-for="Title"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small" asp-for="Subtitle">ALT BAŞLIK / ÖZET</label>
                                <input class="form-control" asp-for="Subtitle" />
                                <span class="text-danger small mt-1" asp-validation-for="Subtitle"></span>
                            </div>

                            <div class="col-12 hero-fields" style="display: none;">
                                <div class="card bg-warning bg-opacity-10 border-0 rounded-3 p-3 mt-2">
                                    <h6 class="fw-bold text-warning mb-3"><i class="fas fa-star me-2"></i> Hero (Karşılama) Ayarları</h6>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">BUTON METNİ</label>
                                            <input class="form-control bg-white" name="btnText" value="@btnText" placeholder="Örn: Hemen Kayıt Ol" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">BUTON LİNKİ (URL)</label>
                                            <input class="form-control bg-white" name="btnUrl" value="@btnUrl" placeholder="Örn: /kayit veya https://..." />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">ARKA PLAN RESMİ URL</label>
                                            <input class="form-control bg-white" name="bgImage" value="@bgImage" placeholder="Örn: https://.../resim.jpg" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">YAN GÖRSEL URL</label>
                                            <input class="form-control bg-white" name="sideImage" value="@sideImage" placeholder="Örn: https://.../logo.png" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12 mt-4">
                                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">Görünüm Ayarları</h6>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small" asp-for="Order">SIRALAMA (ORDER)</label>
                                <div class="input-group w-50">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-sort-numeric-down"></i></span>
                                    <input class="form-control bg-light border-start-0 ps-0 fw-bold" asp-for="Order" type="number" />
                                </div>
                                <div class="form-text text-muted small mt-1">Mevcut Sıra: @Model.Order</div>
                                <span class="text-danger small mt-1" asp-validation-for="Order"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="flexSwitchCheckChecked">
                                    <label class="form-check-label fw-bold ms-2" for="flexSwitchCheckChecked">Bu Bloğu Sitede Aktif Olarak Göster</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5 opacity-50">

                        <div class="d-flex justify-content-end gap-3">
                            <a class="btn btn-light btn-lg rounded-3 fw-bold border px-4"
                               asp-area="Admin" asp-controller="Website" asp-action="Index"
                               asp-route-slug="@slug" asp-route-culture="@Model.Culture"
                               asp-route-page="@Model.Page" asp-route-conferenceId="@Model.ConferenceId">
                                İptal Et
                            </a>
                            <button class="btn btn-warning btn-lg rounded-3 fw-bold shadow-sm px-5 text-white" type="submit">
                                <i class="fas fa-sync-alt me-2"></i> Değişiklikleri Güncelle
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="card border-0 bg-dark rounded-4 p-2 h-100 text-white shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-white bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="fas fa-shield-alt fa-2x text-warning"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Düzenleme Modu</h5>
                    </div>

                    <p class="text-light opacity-75 mb-4" style="line-height: 1.8;">
                        Şu anda <strong>@Model.Page</strong> sayfasındaki bir bloğu düzenliyorsunuz. Yaptığınız değişiklikler kaydettiğiniz anda canlı siteye yansıyacaktır.
                    </p>

                    <div class="bg-white bg-opacity-10 rounded-3 p-3 mb-3">
                        <small class="d-block text-warning fw-bold mb-1">DİKKAT EDİLECEK HUSUSLAR</small>
                        <ul class="list-unstyled mb-0 small opacity-75">
                            <li class="mb-2"><i class="fas fa-exclamation-circle text-warning me-2"></i> Görsel URL'lerinin çalışan ve güvenli (https) bir link olduğundan emin olun.</li>
                            <li class="mb-2"><i class="fas fa-exclamation-circle text-warning me-2"></i> Dil ve Sayfa ayarları güvenlik nedeniyle düzenleme ekranında kilitlenmiştir.</li>
                        </ul>
                    </div>

                    <div class="mt-auto pt-3 border-top border-secondary">
                        <small class="text-muted d-block">SİSTEM ID</small>
                        <code class="text-warning">@Model.Id</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .form-control:focus, .form-select:focus {
            background-color: #fff !important;
            border-color: #ffc107;
            box-shadow: none;
        }

        .input-group-text {
            border: 1px solid #dee2e6;
        }

        .btn-warning {
            transition: all 0.3s ease;
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 193, 7, 0.4) !important;
                color: #fff !important;
            }

        .form-switch .form-check-input {
            width: 2.5em;
            height: 1.25em;
            cursor: pointer;
        }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var typeSelect = document.getElementById("BlockType");
            var heroFields = document.querySelectorAll(".hero-fields");

            function toggleFields() {
                var selectedText = typeSelect.options[typeSelect.selectedIndex].text;
                var isHero = selectedText.includes("Hero");

                heroFields.forEach(f => {
                    if(isHero){
                        f.style.display = "block";
                        f.classList.add("animate__animated", "animate__fadeInIn");
                    } else {
                        f.style.display = "none";
                    }
                });
            }

            typeSelect.addEventListener("change", toggleFields);
            toggleFields();
        });
    </script>
}
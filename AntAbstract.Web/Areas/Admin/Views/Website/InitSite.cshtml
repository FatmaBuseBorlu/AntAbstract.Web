@{
    ViewData["Title"] = "Yeni Kongre Sitesi Oluştur";
    var slug = ViewBag.Slug as string;
    var postUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Website/InitSite"
        : $"/{slug}/Admin/Website/InitSite";
    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Website"
        : $"/{slug}/Admin/Website";
}

<div class="container-fluid py-4" style="max-width:680px">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="@backUrl" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0 fw-bold">Yeni Kongre Sitesi Oluştur</h4>
            <small class="text-muted">Seçilen kongre için varsayılan site blokları otomatik oluşturulur.</small>
        </div>
    </div>

    @if (!(ViewBag.ConferenceList as SelectList)?.Any() ?? false)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            Tüm kongreler için site zaten oluşturulmuş. Yeni kongre ekledikten sonra buradan site oluşturabilirsiniz.
        </div>
        <a href="@backUrl" class="btn btn-primary">Geri Dön</a>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post" action="@postUrl">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Kongre Seç <span class="text-danger">*</span></label>
                        <select name="conferenceId" class="form-select form-select-lg" required>
                            <option value="">-- Kongre seçin --</option>
                            @foreach (SelectListItem item in (ViewBag.ConferenceList as SelectList ?? new SelectList(Enumerable.Empty<object>())))
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <div class="form-text">Listede yalnızca henüz sitesi oluşturulmamış kongreler görünür.</div>
                    </div>

                    <div class="alert alert-light border mb-4">
                        <p class="fw-semibold mb-2"><i class="fas fa-layer-group me-2 text-primary"></i>Oluşturulacak varsayılan bölümler:</p>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Hero</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Hakkında</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Konu Başlıkları</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Önemli Tarihler</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">Ücretler</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">İletişim</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">TR ve EN dilleri için ayrı ayrı oluşturulur. Oluşturduktan sonra içerikleri düzenleyebilirsiniz.</p>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-globe me-2"></i>Siteyi Oluştur
                        </button>
                        <a href="@backUrl" class="btn btn-outline-secondary px-4">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@model AntAbstract.Domain.Entities.ConferencePageBlock
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = "Blok Ekle";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString() ?? "";
    var culture = Model?.Culture ?? "tr-TR";
    var pageKey = Model?.Page ?? "Home";
}

<h2>Blok Ekle</h2>

<form asp-area="Admin"
      asp-controller="Website"
      asp-action="Create"
      asp-route-slug="@slug"
      method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="ConferenceId" />
    <input type="hidden" asp-for="TenantId" />
    <input type="hidden" asp-for="Culture" />
    <input type="hidden" asp-for="Page" />

    <div class="form-group">
        <label asp-for="Culture"></label>
        <select class="form-control" asp-for="Culture">
            <option value="tr-TR" selected="@(culture == "tr-TR")">tr-TR</option>
            <option value="en-US" selected="@(culture == "en-US")">en-US</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Page"></label>
        <input class="form-control" asp-for="Page" />
    </div>

    <div class="form-group">
        <label asp-for="BlockType"></label>
        <select class="form-control" asp-for="BlockType"
                asp-items="Html.GetEnumSelectList<ConferencePageBlockType>()">
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Title"></label>
        <input class="form-control" asp-for="Title" />
    </div>

    <div class="form-group">
        <label asp-for="Subtitle"></label>
        <input class="form-control" asp-for="Subtitle" />
    </div>

    <div class="form-group">
        <label asp-for="ContentJson">ContentJson (şimdilik textarea)</label>
        <textarea class="form-control" asp-for="ContentJson" rows="6"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="Order"></label>
        <input class="form-control" asp-for="Order" type="number" />
    </div>

    <div class="form-group">
        <label>
            <input asp-for="IsActive" /> Aktif
        </label>
    </div>

    <button class="btn btn-success" type="submit">Kaydet</button>

    <a class="btn btn-secondary"
       asp-area="Admin"
       asp-controller="Website"
       asp-action="Index"
       asp-route-slug="@slug"
       asp-route-culture="@culture"
       asp-route-page="@pageKey">
        İptal
    </a>
</form>

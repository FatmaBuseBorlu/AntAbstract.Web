@model AntAbstract.Domain.Entities.ConferencePageBlock
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = "Blok Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString();
}

<div class="container" style="max-width: 980px; margin-top: 32px;">
    <div class="card shadow-sm" style="border-radius:16px;">
        <div class="card-body p-4">

            <div class="d-flex align-items-start justify-content-between">
                <div>
                    <h3 class="mb-1">Blok Ekle</h3>
                    <div class="text-muted">Hero / diğer blok tiplerini buradan oluşturabilirsin</div>
                </div>

                <a class="btn btn-outline-secondary"
                   asp-area="Admin"
                   asp-controller="Website"
                   asp-action="Index"
                   asp-route-slug="@slug"
                   asp-route-culture="@Model.Culture"
                   asp-route-page="@Model.Page"
                   asp-route-conferenceId="@Model.ConferenceId">
                    ← Geri
                </a>
            </div>

            <hr class="my-4" />

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <form asp-area="Admin"
                  asp-controller="Website"
                  asp-action="Create"
                  asp-route-slug="@slug"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ConferenceId" />

                <input type="hidden" asp-for="ContentJson" value="{}" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Page"></label>
                        <input class="form-control" asp-for="Page" />
                        <span class="text-danger" asp-validation-for="Page"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" asp-for="Culture"></label>
                        <select class="form-select" asp-for="Culture">
                            <option value="tr-TR">tr-TR</option>
                            <option value="en-US">en-US</option>
                        </select>
                        <span class="text-danger" asp-validation-for="Culture"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" asp-for="BlockType"></label>
                        <select class="form-select" id="BlockType"
                                asp-for="BlockType"
                                asp-items="Html.GetEnumSelectList<ConferencePageBlockType>()">
                        </select>
                        <span class="text-danger" asp-validation-for="BlockType"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" asp-for="Title"></label>
                        <input class="form-control" asp-for="Title" />
                        <span class="text-danger" asp-validation-for="Title"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" asp-for="Subtitle"></label>
                        <input class="form-control" asp-for="Subtitle" />
                        <span class="text-danger" asp-validation-for="Subtitle"></span>
                    </div>

                    <div class="col-md-6 hero-fields">
                        <label class="form-label text-primary fw-bold"><i class="fas fa-mouse-pointer me-1"></i> Buton Metni</label>
                        <input class="form-control" name="btnText" placeholder="Örn: Hemen Kayıt Ol" />
                    </div>
                    <div class="col-md-6 hero-fields">
                        <label class="form-label text-primary fw-bold"><i class="fas fa-link me-1"></i> Buton Linki (URL)</label>
                        <input class="form-control" name="btnUrl" placeholder="Örn: /kayit veya https://..." />
                    </div>
                    <div class="col-md-6 hero-fields">
                        <label class="form-label text-primary fw-bold"><i class="fas fa-image me-1"></i> Arka Plan Resmi URL</label>
                        <input class="form-control" name="bgImage" placeholder="Örn: https://.../resim.jpg" />
                    </div>
                    <div class="col-md-6 hero-fields">
                        <label class="form-label text-primary fw-bold"><i class="fas fa-image me-1"></i> Yan Görsel URL</label>
                        <input class="form-control" name="sideImage" placeholder="Örn: https://.../logo.png" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" asp-for="Order"></label>
                        <input class="form-control" asp-for="Order" type="number" value="0" />
                        <span class="text-danger" asp-validation-for="Order"></span>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Aktif</label>
                        </div>
                    </div>

                    <div class="col-12 d-flex gap-2 mt-2">
                        <button class="btn btn-success" type="submit">💾 Kaydet</button>

                        <a class="btn btn-outline-secondary"
                           asp-area="Admin"
                           asp-controller="Website"
                           asp-action="Index"
                           asp-route-slug="@slug"
                           asp-route-culture="@Model.Culture"
                           asp-route-page="@Model.Page"
                           asp-route-conferenceId="@Model.ConferenceId">
                            İptal
                        </a>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var typeSelect = document.getElementById("BlockType");
            var heroFields = document.querySelectorAll(".hero-fields");

            function toggleFields() {
                var isHero = typeSelect.options[typeSelect.selectedIndex].text === "Hero";
                heroFields.forEach(f => f.style.display = isHero ? "block" : "none");
            }

            typeSelect.addEventListener("change", toggleFields);
            toggleFields();
        });
    </script>
}
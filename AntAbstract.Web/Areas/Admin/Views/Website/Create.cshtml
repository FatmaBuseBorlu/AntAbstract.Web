@model AntAbstract.Domain.Entities.ConferencePageBlock
@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Rendering
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString();

    var cultureOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = Localizer["Culture_TR"].Value, Value = "tr-TR" },
        new SelectListItem { Text = Localizer["Culture_EN"].Value, Value = "en-US" }
    };

    var blockTypeOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = Localizer["BlockType_Hero"].Value, Value = nameof(ConferencePageBlockType.Hero) },
        new SelectListItem { Text = Localizer["BlockType_About"].Value, Value = nameof(ConferencePageBlockType.About) },
        new SelectListItem { Text = Localizer["BlockType_CallForPapers"].Value, Value = nameof(ConferencePageBlockType.CallForPapers) },
        new SelectListItem { Text = Localizer["BlockType_Topics"].Value, Value = nameof(ConferencePageBlockType.Topics) },
        new SelectListItem { Text = Localizer["BlockType_Committees"].Value, Value = nameof(ConferencePageBlockType.Committees) },
        new SelectListItem { Text = Localizer["BlockType_Fees"].Value, Value = nameof(ConferencePageBlockType.Fees) }
    };
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-dark">@Localizer["PageHeading"]</h4>
            <p class="text-muted small mb-0">
                @Localizer["PageLead_Part1"] <strong>@Model.Page</strong> @Localizer["PageLead_Part2"]
            </p>
        </div>
        <a class="btn btn-light border shadow-sm px-3"
           asp-area="Admin" asp-controller="Website" asp-action="Index"
           asp-route-slug="@slug" asp-route-culture="@Model.Culture"
           asp-route-page="@Model.Page" asp-route-conferenceId="@Model.ConferenceId">
            <i class="fas fa-arrow-left me-2"></i> @Localizer["BackToListButton"]
        </a>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-7 mb-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 shadow-sm rounded-3 small" })

                    <form asp-area="Admin" asp-controller="Website" asp-action="Create" asp-route-slug="@slug" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ConferenceId" />
                        <input type="hidden" asp-for="ContentJson" value="{}" />

                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small" asp-for="Page">@Localizer["PageLabel"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-file-alt"></i></span>
                                    <input class="form-control bg-light border-start-0 ps-0" asp-for="Page" readonly />
                                </div>
                                <span class="text-danger small mt-1" asp-validation-for="Page"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small" asp-for="Culture">@Localizer["CultureLabel"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-globe"></i></span>
                                    <select class="form-select bg-light border-start-0 ps-0" asp-for="Culture" asp-items="cultureOptions"></select>
                                </div>
                                <span class="text-danger small mt-1" asp-validation-for="Culture"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small" asp-for="BlockType">@Localizer["BlockTypeLabel"] <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-primary"><i class="fas fa-cubes"></i></span>
                                    <select class="form-select bg-light border-start-0 ps-0 fw-bold" id="BlockType" asp-for="BlockType" asp-items="blockTypeOptions"></select>
                                </div>
                                <span class="text-danger small mt-1" asp-validation-for="BlockType"></span>
                            </div>

                            <div class="col-md-12 mt-4">
                                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">@Localizer["TextContentHeader"]</h6>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small" asp-for="Title">@Localizer["TitleLabel"] <span class="text-danger">*</span></label>
                                <input class="form-control" asp-for="Title" placeholder="@Localizer["TitlePlaceholder"]" />
                                <span class="text-danger small mt-1" asp-validation-for="Title"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small" asp-for="Subtitle">@Localizer["SubtitleLabel"]</label>
                                <input class="form-control" asp-for="Subtitle" placeholder="@Localizer["SubtitlePlaceholder"]" />
                                <span class="text-danger small mt-1" asp-validation-for="Subtitle"></span>
                            </div>

                            <div class="col-12 hero-fields" style="display: none;">
                                <div class="card bg-primary bg-opacity-10 border-0 rounded-3 p-3 mt-2">
                                    <h6 class="fw-bold text-primary mb-3"><i class="fas fa-star me-2"></i> @Localizer["HeroSettingsHeader"]</h6>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">@Localizer["HeroButtonTextLabel"]</label>
                                            <input class="form-control bg-white" name="btnText" placeholder="@Localizer["HeroButtonTextPlaceholder"]" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">@Localizer["HeroButtonUrlLabel"]</label>
                                            <input class="form-control bg-white" name="btnUrl" placeholder="@Localizer["HeroButtonUrlPlaceholder"]" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">@Localizer["HeroBackgroundImageLabel"]</label>
                                            <input class="form-control bg-white" name="bgImage" placeholder="@Localizer["HeroBackgroundImagePlaceholder"]" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark small">@Localizer["HeroSideImageLabel"]</label>
                                            <input class="form-control bg-white" name="sideImage" placeholder="@Localizer["HeroSideImagePlaceholder"]" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12 mt-4">
                                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">@Localizer["AppearanceHeader"]</h6>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small" asp-for="Order">@Localizer["OrderLabel"]</label>
                                <div class="input-group w-50">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-sort-numeric-down"></i></span>
                                    <input class="form-control bg-light border-start-0 ps-0" asp-for="Order" type="number" value="0" />
                                </div>
                                <div class="form-text text-muted small mt-1">@Localizer["OrderHelpText"]</div>
                                <span class="text-danger small mt-1" asp-validation-for="Order"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch mt-3">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="flexSwitchCheckChecked" checked>
                                    <label class="form-check-label fw-bold ms-2" for="flexSwitchCheckChecked">@Localizer["IsActiveLabel"]</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5 opacity-50">

                        <div class="d-flex justify-content-end gap-3">
                            <a class="btn btn-light btn-lg rounded-3 fw-bold border px-4"
                               asp-area="Admin" asp-controller="Website" asp-action="Index"
                               asp-route-slug="@slug" asp-route-culture="@Model.Culture"
                               asp-route-page="@Model.Page" asp-route-conferenceId="@Model.ConferenceId">
                                @Localizer["CancelButton"]
                            </a>
                            <button class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm px-5" type="submit">
                                <i class="fas fa-save me-2"></i> @Localizer["SaveButton"]
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5 mb-4">
            <div class="card border-0 bg-info bg-opacity-10 rounded-4 p-2 border-start border-info border-4 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-white p-3 rounded-circle shadow-sm me-3">
                            <i class="fas fa-lightbulb fa-2x text-info"></i>
                        </div>
                        <h5 class="fw-bold text-info mb-0">@Localizer["HowItWorksTitle"]</h5>
                    </div>

                    <p class="text-dark mb-4" style="line-height: 1.8;">
                        @Localizer["HowItWorksLead"]
                    </p>

                    <ul class="list-unstyled">
                        <li class="mb-3 d-flex">
                            <i class="fas fa-cube text-info mt-1 me-3"></i>
                            <span class="small text-dark"><strong>@Localizer["TipBlockTypeTitle"]</strong> @Localizer["TipBlockTypeText"]</span>
                        </li>
                        <li class="mb-3 d-flex">
                            <i class="fas fa-sort-amount-down text-info mt-1 me-3"></i>
                            <span class="small text-dark"><strong>@Localizer["TipOrderTitle"]</strong> @Localizer["TipOrderText"]</span>
                        </li>
                        <li class="mb-0 d-flex">
                            <i class="fas fa-eye-slash text-info mt-1 me-3"></i>
                            <span class="small text-dark"><strong>@Localizer["TipHideTitle"]</strong> @Localizer["TipHideText"]</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .form-control:focus, .form-select:focus {
            background-color: #fff !important;
            border-color: var(--primary-color);
            box-shadow: none;
        }

        .input-group-text {
            border: 1px solid #dee2e6;
        }

        .form-label {
            letter-spacing: 0.5px;
        }

        .btn-primary {
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 174, 239, 0.4) !important;
            }

        .form-switch .form-check-input {
            width: 2.5em;
            height: 1.25em;
            cursor: pointer;
        }
    </style>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var typeSelect = document.getElementById("BlockType");
            var heroFields = document.querySelectorAll(".hero-fields");

            function toggleFields() {
                var selectedValue = typeSelect.value;
                var isHero = selectedValue === "Hero";

                heroFields.forEach(f => {
                    if (isHero) {
                        f.style.display = "block";
                        f.classList.add("animate__animated", "animate__fadeIn");
                    } else {
                        f.style.display = "none";
                    }
                });
            }

            typeSelect.addEventListener("change", toggleFields);
            toggleFields();
        });
    </script>
}
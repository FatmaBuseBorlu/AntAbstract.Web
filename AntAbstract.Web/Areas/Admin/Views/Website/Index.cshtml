@model List<AntAbstract.Domain.Entities.ConferencePageBlock>
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = "Website Blokları";
    // TEMA (LAYOUT) BURADA EKLENİYOR:
    Layout = "~/Views/Shared/_Layout.cshtml"; // Admin teması kullanıyorsan burayı "~/Views/Shared/_AdminLayout.cshtml" yapabilirsin.

    var slug = ViewContext.RouteData.Values["slug"]?.ToString();
    var culture = (string?)ViewBag.Culture ?? "tr-TR";
    var pageKey = (string?)ViewBag.Page ?? "Home";
    Guid? selectedConferenceId = ViewBag.ConferenceId as Guid?;
}

<div class="container" style="max-width: 1100px; margin-top: 32px;">

    <h2 class="mb-1">Website Blokları</h2>
    <div class="text-muted mb-3">Seçili sayfa için blok ekle / düzenle / sırala</div>

    <div class="card shadow-sm" style="border-radius:16px;">
        <div class="card-body p-4">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form method="get"
                  asp-area="Admin"
                  asp-controller="Website"
                  asp-action="Index"
                  asp-route-slug="@slug"
                  class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label">Culture</label>
                    <select class="form-select" name="culture" asp-items="ViewBag.CultureList"></select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Page</label>
                    <select class="form-select" name="page" asp-items="ViewBag.PageList"></select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Conference</label>
                    <select class="form-select" name="conferenceId" asp-items="ViewBag.ConferenceList"></select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary w-100">Filtrele</button>
                </div>
            </form>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fw-semibold">Blok Listesi</div>

                @if (selectedConferenceId.HasValue)
                {
                    <a class="btn btn-primary"
                       asp-area="Admin"
                       asp-controller="Website"
                       asp-action="Create"
                       asp-route-slug="@slug"
                       asp-route-conferenceId="@selectedConferenceId"
                       asp-route-culture="@culture"
                       asp-route-page="@pageKey">
                        + Yeni Blok
                    </a>
                }
                else
                {
                    <span class="text-danger">Konferans bulunamadı.</span>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th style="width:90px;">Order</th>
                            <th style="width:140px;">Type</th>
                            <th>Title</th>
                            <th style="width:90px;">Active</th>
                            <th style="width:280px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-muted text-center py-4">Henüz blok yok.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var b in Model)
                            {
                                <tr>
                                    <td>@b.Order</td>
                                    <td>@b.BlockType</td>
                                    <td>@b.Title</td>
                                    <td>
                                        @if (b.IsActive)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td class="d-flex gap-2">
                                        <a class="btn btn-sm btn-warning"
                                           asp-area="Admin"
                                           asp-controller="Website"
                                           asp-action="Edit"
                                           asp-route-slug="@slug"
                                           asp-route-id="@b.Id">
                                            Düzenle
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Website"
                                              asp-action="Toggle"
                                              asp-route-slug="@slug"
                                              asp-route-id="@b.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                                @(b.IsActive ? "Pasif Yap" : "Aktif Yap")
                                            </button>
                                        </form>

                                        <form asp-area="Admin"
                                              asp-controller="Website"
                                              asp-action="Delete"
                                              asp-route-slug="@slug"
                                              asp-route-id="@b.Id"
                                              method="post"
                                              onsubmit="return confirm('Silmek istediğine emin misin?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
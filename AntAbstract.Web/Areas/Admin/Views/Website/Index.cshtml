@model List<AntAbstract.Domain.Entities.ConferencePageBlock>
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@{
    ViewData["Title"] = "Website Blokları";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString(); // null olabilir
    var hasSlug = !string.IsNullOrWhiteSpace(slug);

    var culture = (string)(ViewBag.Culture ?? "tr-TR");
    var page = (string)(ViewBag.Page ?? "Home");
    var conferenceId = ViewBag.ConferenceId as Guid?;

    IEnumerable<SelectListItem> cultureOptions = ViewBag.CultureOptions as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();

    IEnumerable<SelectListItem> pageOptions = ViewBag.PageOptions as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();

    IEnumerable<SelectListItem> conferenceOptions = ViewBag.ConferenceOptions as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();
}

<div class="container-xxl py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
            <div>
                <h4 class="mb-1">Website Blokları</h4>
                <div class="text-muted small">Seçili sayfa için blok ekle / düzenle / sırala</div>
            </div>

            <div>
                @if (conferenceId.HasValue)
                {
                    @if (hasSlug)
                    {
                        <a class="btn btn-primary"
                           asp-area="Admin"
                           asp-controller="Website"
                           asp-action="Create"
                           asp-route-slug="@slug"
                           asp-route-conferenceId="@conferenceId"
                           asp-route-culture="@culture"
                           asp-route-page="@@page">
                            + Yeni Blok
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-primary"
                           asp-area="Admin"
                           asp-controller="Website"
                           asp-action="Create"
                           asp-route-conferenceId="@conferenceId"
                           asp-route-culture="@culture"
                           asp-route-page="@@page">
                            + Yeni Blok
                        </a>
                    }
                }
            </div>
        </div>

        <div class="card-body">
            @if (!conferenceId.HasValue)
            {
                <div class="alert alert-warning mb-3">
                    Bu tenant için konferans bulunamadı. Önce bir konferans seçmelisin.
                </div>
            }

            <form method="get" class="row g-3 align-items-end mb-4">
                <div class="col-md-2">
                    <label class="form-label">Culture</label>
                    <select class="form-select" name="culture" asp-items="cultureOptions"></select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Page</label>
                    <select class="form-select" name="page" asp-items="pageOptions"></select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Conference</label>
                    <select class="form-select" name="conferenceId" asp-items="conferenceOptions"></select>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">Filtrele</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:90px;">Order</th>
                            <th style="width:140px;">Type</th>
                            <th>Title</th>
                            <th style="width:110px;">Active</th>
                            <th style="width:320px;">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-muted">Henüz blok yok.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var b in Model)
                        {
                            <tr>
                                <td>@b.Order</td>
                                <td>@b.BlockType</td>
                                <td>@b.Title</td>
                                <td>
                                    <span class="badge @(b.IsActive ? "bg-success" : "bg-secondary")">
                                        @(b.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td class="d-flex gap-2 flex-wrap">

                                    @if (hasSlug)
                                    {
                                        <a class="btn btn-sm btn-warning"
                                           asp-area="Admin"
                                           asp-controller="Website"
                                           asp-action="Edit"
                                           asp-route-slug="@slug"
                                           asp-route-id="@b.Id">
                                            Düzenle
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-warning"
                                           asp-area="Admin"
                                           asp-controller="Website"
                                           asp-action="Edit"
                                           asp-route-id="@b.Id">
                                            Düzenle
                                        </a>
                                    }

                                    <form method="post"
                                          asp-area="Admin"
                                          asp-controller="Website"
                                          asp-action="Toggle"
                                          asp-route-id="@b.Id"
                                          @@(hasSlug ? $"asp-route-slug=\"{slug}\"" : "")>
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">
                                            @(b.IsActive ? "Pasif Yap" : "Aktif Yap")
                                        </button>
                                    </form>

                                    <form method="post"
                                          asp-area="Admin"
                                          asp-controller="Website"
                                          asp-action="Delete"
                                          asp-route-id="@b.Id"
                                          @@(hasSlug ? $"asp-route-slug=\"{slug}\"" : "")
                                          onsubmit="return confirm('Silmek istediğine emin misin?');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit">
                                            Sil
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

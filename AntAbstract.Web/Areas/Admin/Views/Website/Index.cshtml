@model List<AntAbstract.Domain.Entities.ConferencePageBlock>
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = "Website Blokları";
    // TEMAYI YÖNETİM PANELİNE ÇEVİRDİK
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString();
    var culture = (string?)ViewBag.Culture ?? "tr-TR";
    var pageKey = (string?)ViewBag.Page ?? "Home";
    Guid? selectedConferenceId = ViewBag.ConferenceId as Guid?;
}

<div class="container-fluid">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-dark">🎨 Website Yönetimi</h4>
            <p class="text-muted small mb-0">Kongre web sitesinin ön yüzünde görünecek blokları buradan düzenleyebilirsiniz.</p>
        </div>
        @if (selectedConferenceId.HasValue)
        {
            <a class="btn btn-primary shadow-sm px-4 fw-bold rounded-pill"
               asp-area="Admin"
               asp-controller="Website"
               asp-action="Create"
               asp-route-slug="@slug"
               asp-route-conferenceId="@selectedConferenceId"
               asp-route-culture="@culture"
               asp-route-page="@pageKey">
                <i class="fas fa-plus-circle me-2"></i> Yeni Blok Ekle
            </a>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <form method="get"
                  asp-area="Admin"
                  asp-controller="Website"
                  asp-action="Index"
                  asp-route-slug="@slug"
                  class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted small mb-1">DİL (CULTURE)</label>
                    <select class="form-select border-0 shadow-sm" name="culture" asp-items="ViewBag.CultureList"></select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted small mb-1">SAYFA (PAGE)</label>
                    <select class="form-select border-0 shadow-sm" name="page" asp-items="ViewBag.PageList"></select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small mb-1">KONGRE (CONFERENCE)</label>
                    <select class="form-select border-0 shadow-sm" name="conferenceId" asp-items="ViewBag.ConferenceList"></select>
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-dark fw-bold shadow-sm rounded-3">
                        <i class="fas fa-filter me-2"></i> Filtrele
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-layer-group me-2 text-primary"></i> Aktif Blok Listesi</h6>
            @if (!selectedConferenceId.HasValue)
            {
                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill small">
                    <i class="fas fa-exclamation-triangle me-1"></i> Kongre Seçilmedi
                </span>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted fw-bold small" style="width: 80px;">SIRA</th>
                            <th class="py-3 text-muted fw-bold small" style="width: 150px;">BLOK TİPİ</th>
                            <th class="py-3 text-muted fw-bold small">BAŞLIK</th>
                            <th class="py-3 text-muted fw-bold small text-center" style="width: 120px;">DURUM</th>
                            <th class="pe-4 py-3 text-muted fw-bold small text-end" style="width: 250px;">İŞLEMLER</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted mb-2"><i class="fas fa-cubes fa-3x opacity-25"></i></div>
                                    <h6 class="fw-bold text-dark">Henüz Bir Blok Eklenmemiş</h6>
                                    <p class="small text-muted mb-0">Bu sayfa için yeni bir tasarım bloğu ekleyerek işe başlayın.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var b in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary px-2 py-1">#@b.Order</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark small"><i class="fas fa-cube me-1 text-primary opacity-75"></i> @b.BlockType</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@b.Title</span>
                                    </td>
                                    <td class="text-center">
                                        @if (b.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2 border border-success" style="font-size: 0.75rem;">
                                                <i class="fas fa-check-circle me-1"></i> Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2 border border-danger" style="font-size: 0.75rem;">
                                                <i class="fas fa-times-circle me-1"></i> Pasif
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-flex justify-content-end gap-2">

                                            <form asp-area="Admin" asp-controller="Website" asp-action="Toggle" asp-route-slug="@slug" asp-route-id="@b.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-sm @(b.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-3 fw-bold" type="submit" title="Durumu Değiştir">
                                                    @(b.IsActive ? "Pasife Al" : "Aktif Et")
                                                </button>
                                            </form>

                                            <div class="btn-group btn-group-sm shadow-sm rounded-3">
                                                <a asp-area="Admin" asp-controller="Website" asp-action="Edit" asp-route-slug="@slug" asp-route-id="@b.Id" class="btn btn-white text-primary border-end" title="Düzenle">
                                                    <i class="fas fa-pen"></i>
                                                </a>
                                                <form asp-area="Admin" asp-controller="Website" asp-action="Delete" asp-route-slug="@slug" asp-route-id="@b.Id" method="post" onsubmit="return confirm('Bu bloğu kalıcı olarak silmek istediğinize emin misiniz?');" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-white text-danger" title="Sil">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </div>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-white {
        background-color: #fff;
        border: 1px solid #f1f5f9;
        padding: 0.5rem 0.7rem;
    }

        .btn-white:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
            z-index: 2;
        }

    .table thead th {
        letter-spacing: 0.5px;
        border-bottom: none;
    }

    .table tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid #f8fafc;
    }

        .table tbody tr:hover {
            background-color: #fbfcfe !important;
        }
</style>
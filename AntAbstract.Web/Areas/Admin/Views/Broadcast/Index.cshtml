@using AntAbstract.Domain.Entities
@{
    ViewData["Title"] = "Toplu E-posta Gönder";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug        = ViewBag.Slug as string ?? "";
    var conferences = ViewBag.Conferences as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var scheduled   = ViewBag.ScheduledBroadcasts as List<ScheduledBroadcast> ?? new();
    var previewUrl  = string.IsNullOrWhiteSpace(slug) ? "/Admin/Broadcast/Preview" : $"/{slug}/Admin/Broadcast/Preview";
    var sendUrl     = string.IsNullOrWhiteSpace(slug) ? "/Admin/Broadcast/Send"    : $"/{slug}/Admin/Broadcast/Send";
    var cancelUrl   = string.IsNullOrWhiteSpace(slug) ? "/Admin/Broadcast/Cancel"  : $"/{slug}/Admin/Broadcast/Cancel";

    string GroupLabel(string g) => g switch
    {
        "all"        => "Tüm Bildiri Sahipleri",
        "accepted"   => "Kabul Edilenler",
        "reviewers"  => "Hakemler",
        "registered" => "Kayıt Yaptıranlar",
        "paid"       => "Ödeme Yapanlar",
        "revision"   => "Revizyon Gerekli",
        "unpaid"     => "Ödeme Bekleyenler",
        _            => g
    };

    string StatusBadge(BroadcastStatus s) => s switch
    {
        BroadcastStatus.Pending   => "<span class='badge bg-warning text-dark'>Bekliyor</span>",
        BroadcastStatus.Sent      => "<span class='badge bg-success'>Gönderildi</span>",
        BroadcastStatus.Failed    => "<span class='badge bg-danger'>Başarısız</span>",
        BroadcastStatus.Cancelled => "<span class='badge bg-secondary'>İptal</span>",
        _                         => "<span class='badge bg-light text-dark'>?</span>"
    };
}

<div class="container-fluid py-4" style="max-width:860px;">

    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fas fa-paper-plane me-2 text-primary"></i>Toplu E-posta Gönder</h4>
        <p class="text-muted mb-0">Seçilen katılımcı grubuna duyuru veya bilgilendirme e-postası gönderin.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">
            <i class="fas fa-times-circle me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form id="broadcastForm" action="@sendUrl" method="post">
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrWhiteSpace(slug))
                {
                    <input type="hidden" name="slug" value="@slug" />
                }

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Kongre <span class="text-danger">*</span></label>
                        <select name="conferenceId" id="conferenceId" class="form-select" required>
                            <option value="">— Kongre seçin —</option>
                            @foreach (var c in conferences)
                            {
                                <option value="@c.Id">@c.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Alıcı Grubu <span class="text-danger">*</span></label>
                        <select name="group" id="groupSelect" class="form-select" required>
                            <option value="all">Tüm Bildiri Sahipleri</option>
                            <option value="accepted">Kabul Edilenler</option>
                            <option value="reviewers">Hakemler</option>
                            <option value="registered">Kayıt Yaptıranlar</option>
                            <option value="paid">Ödeme Yapanlar</option>
                            <option value="revision">Revizyon Gerekli</option>
                            <option value="unpaid">Ödeme Bekleyenler</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="button" id="previewBtn" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-users me-1"></i> Alıcı Sayısını Gör
                    </button>
                    <span id="previewResult" class="ms-2 text-muted small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">E-posta Konusu <span class="text-danger">*</span></label>
                    <input type="text" name="subject" class="form-control" required
                           placeholder="Örn: Kongre programı hakkında duyuru" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        E-posta İçeriği (HTML desteklenir) <span class="text-danger">*</span>
                    </label>
                    <textarea name="body" id="emailBody" class="form-control" rows="10" required
                              placeholder="&lt;p&gt;Sayın katılımcı,&lt;/p&gt;&#10;&lt;p&gt;...&lt;/p&gt;"></textarea>
                    <div class="form-text">
                        <i class="fas fa-info-circle me-1"></i>
                        HTML etiketleri kullanabilirsiniz.
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Gönderim Zamanı</label>
                    <div class="d-flex gap-3 align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="sendMode" id="sendNow" value="now" checked
                                   onchange="document.getElementById('scheduledAtField').style.display='none';" />
                            <label class="form-check-label fw-semibold" for="sendNow">Şimdi Gönder</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="sendMode" id="sendLater" value="later"
                                   onchange="document.getElementById('scheduledAtField').style.display='block';" />
                            <label class="form-check-label fw-semibold" for="sendLater">Zamanla</label>
                        </div>
                    </div>
                    <div id="scheduledAtField" style="display:none;margin-top:8px;">
                        <input type="datetime-local" name="scheduledAt" class="form-control" style="max-width:260px;" />
                        <div class="form-text">UTC saat dilimine göre girin.</div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4"
                            onclick="return confirm('E-posta gönderilsin mi?');">
                        <i class="fas fa-paper-plane me-2"></i>Gönder
                    </button>
                    <button type="reset" class="btn btn-outline-secondary">Temizle</button>
                </div>
            </form>
        </div>
    </div>

    @* Gönderim geçmişi *@
    @if (scheduled.Any())
    {
        <h5 class="fw-bold mb-3"><i class="fas fa-history me-2 text-muted"></i>Gönderim Geçmişi</h5>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Konu</th>
                            <th>Hedef</th>
                            <th class="text-center">Alıcı</th>
                            <th>Zamanlanma</th>
                            <th class="text-center">Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in scheduled)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                        @b.Subject
                                    </div>
                                    <small class="text-muted">@(b.Conference?.Title ?? "")</small>
                                </td>
                                <td><span class="badge bg-light text-dark">@GroupLabel(b.TargetGroup)</span></td>
                                <td class="text-center fw-bold">@b.RecipientCount</td>
                                <td>
                                    <div style="font-size:0.82rem;">@b.ScheduledAt.ToString("dd.MM.yyyy HH:mm")</div>
                                    @if (b.SentAt.HasValue)
                                    {
                                        <small class="text-success">Gönderildi: @b.SentAt.Value.ToString("dd.MM.yyyy HH:mm")</small>
                                    }
                                </td>
                                <td class="text-center">@Html.Raw(StatusBadge(b.Status))</td>
                                <td class="text-end">
                                    @if (b.Status == BroadcastStatus.Pending)
                                    {
                                        <form action="@cancelUrl" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu zamanlanmış gönderim iptal edilsin mi?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="broadcastId" value="@b.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="İptal Et">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
document.getElementById('previewBtn').addEventListener('click', async function () {
    const conferenceId = document.getElementById('conferenceId').value;
    const group        = document.getElementById('groupSelect').value;
    const result       = document.getElementById('previewResult');

    if (!conferenceId) {
        result.textContent = 'Önce bir kongre seçin.';
        result.className = 'ms-2 text-warning small';
        return;
    }

    result.textContent = 'Yükleniyor...';
    result.className = 'ms-2 text-muted small';

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const resp = await fetch('@previewUrl', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `conferenceId=${conferenceId}&group=${group}`
        });
        const data = await resp.json();
        result.textContent = `${data.count} alıcı bulundu.`;
        result.className = `ms-2 ${data.count > 0 ? 'text-success' : 'text-warning'} small fw-semibold`;
    } catch (e) {
        result.textContent = 'Sorgu başarısız.';
        result.className = 'ms-2 text-danger small';
    }
});
</script>
}

@model IEnumerable<AntAbstract.Domain.Entities.Conference>

@{
    ViewData["Title"] = "Kongre Tanımları";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";
    bool isSuperAdmin = ViewBag.IsSuperAdmin ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Kongre Tanımları</h3>
        <p class="text-muted small">Sisteme kayıtlı kongreleri buradan yönetebilir, yeni kongre ekleyebilirsiniz.</p>
    </div>
    <a asp-action="Create" asp-route-slug="@slug" class="btn btn-primary rounded-pill fw-bold px-4 shadow-sm">
        <i class="fas fa-plus me-2"></i> Yeni Kongre Ekle
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center p-5 text-muted">
                <div class="mb-3">
                    <i class="fas fa-calendar-times fa-4x opacity-25 text-primary"></i>
                </div>
                <h5 class="fw-bold text-dark">Henüz Bir Kongre Yok</h5>
                <p class="small">Sisteme henüz hiçbir kongre eklenmemiş. Sağ üstteki butondan ilk kongrenizi oluşturun.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th class="ps-4">KONGRE ADI</th>
                            <th>TARİHLER</th>
                            <th>LOKASYON</th>
                            @if (isSuperAdmin)
                            {
                                <th>AİT OLDUĞU KURUM</th>
                            }
                            <th class="text-end pe-4">İŞLEMLER</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark fs-6 d-block">@item.Title</span>
                                    <span class="text-muted small">URL: /@item.Slug</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="text-success fw-bold"><i class="fas fa-play-circle me-1"></i> @item.StartDate.ToString("dd MMM yyyy HH:mm")</span> <br />
                                        <span class="text-danger fw-bold"><i class="fas fa-stop-circle me-1"></i> @item.EndDate.ToString("dd MMM yyyy HH:mm")</span>
                                    </div>
                                </td>
                                <td class="text-muted small">
                                    <i class="fas fa-map-marker-alt text-primary me-1"></i> @(string.IsNullOrEmpty(item.Venue) ? "Belirtilmemiş" : item.Venue)
                                </td>

                                @if (isSuperAdmin)
                                {
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-2">
                                            <i class="fas fa-building me-1"></i> @item.Tenant?.Name
                                        </span>
                                    </td>
                                }

                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" asp-route-slug="@slug" class="btn btn-sm btn-light text-primary me-1" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" asp-route-slug="@slug" method="post" class="d-inline" onsubmit="return confirm('Bu kongreyi silmek istediğinize emin misiniz? DİKKAT: Kongreye ait tüm kayıtlar silinebilir!');">
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Sil">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@model AntAbstract.Domain.Entities.Conference

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;
        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase) ? fallback : value;
    }
}

<div class="container-fluid py-4 conference-form-page">

    <div class="details-page-header d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fas fa-edit text-primary me-2"></i>@Localizer["CardTitle"]</h4>
            <p class="text-muted mb-0 small">@Model.Title</p>
        </div>
        <a asp-area="Admin" asp-controller="Conferences" asp-action="Index" asp-route-slug="@slug"
           class="btn btn-light border text-muted">
            <i class="fas fa-arrow-left me-1"></i> @Localizer["CancelButton"]
        </a>
    </div>

    <form asp-area="Admin"
          asp-controller="Conferences"
          asp-action="Edit"
          asp-route-slug="@slug"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TenantId" />

        <div class="row g-4 align-items-start">

            <div class="col-lg-8">

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-info">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">@Localizer["BasicInfoHeader"]</h5>
                            <p class="modern-card-text mb-0">@Localizer["ConferenceNameDateLocation"]</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["TitleLabel"] (TR)</label>
                                <input asp-for="Title" class="form-control form-control-lg" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["TitleLabel"] (EN)</label>
                                <input asp-for="TitleEn" class="form-control form-control-lg" placeholder="English title" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["StartDateLabel"]</label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["EndDateLabel"]</label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["City"] (TR)</label>
                                <input asp-for="City" class="form-control" placeholder="İstanbul" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["City"] (EN)</label>
                                <input asp-for="CityEn" class="form-control" placeholder="Istanbul" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["Country"] (TR)</label>
                                <input asp-for="Country" class="form-control" placeholder="Türkiye" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["Country"] (EN)</label>
                                <input asp-for="CountryEn" class="form-control" placeholder="Turkey" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["VenueLabel"] (TR)</label>
                                <input asp-for="Venue" class="form-control" />
                                <span asp-validation-for="Venue" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["VenueLabel"] (EN)</label>
                                <input asp-for="VenueEn" class="form-control" placeholder="English venue" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">@Localizer["ExternalWebsiteUrl"]</label>
                            <input asp-for="ExternalWebsiteUrl" class="form-control" placeholder="https://www.example.com/congress" />
                            <span asp-validation-for="ExternalWebsiteUrl" class="text-danger small"></span>
                            <small class="text-muted">@Localizer["ExternalWebsiteUrlHint"]</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["DescriptionLabel"] (TR)</label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-0">
                                <label class="form-label fw-semibold small text-muted">@Localizer["DescriptionLabel"] (EN)</label>
                                <textarea asp-for="DescriptionEn" class="form-control" rows="4" placeholder="English description"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-warning">
                            <i class="fas fa-signature"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">@L("CertificateSignersHeader", "Sertifika İmza Sahipleri")</h5>
                            <p class="modern-card-text mb-0">@L("CertificateSignersLead", "Sertifikalarda görünecek isim ve unvanlar.")</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@L("FirstSignerNameLabel", "1. İmzalayan Adı")</label>
                                <input asp-for="CertificateFirstSignerName" class="form-control"
                                       placeholder="@L("FirstSignerNamePlaceholder", "Prof. Dr. Ad Soyad")" />
                                <span asp-validation-for="CertificateFirstSignerName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@L("FirstSignerTitleLabel", "1. İmzalayan Unvanı")</label>
                                <input asp-for="CertificateFirstSignerTitle" class="form-control"
                                       placeholder="@L("FirstSignerTitlePlaceholder", "Kongre Başkanı")" />
                                <span asp-validation-for="CertificateFirstSignerTitle" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@L("SecondSignerNameLabel", "2. İmzalayan Adı")</label>
                                <input asp-for="CertificateSecondSignerName" class="form-control"
                                       placeholder="@L("SecondSignerNamePlaceholder", "Prof. Dr. Ad Soyad")" />
                                <span asp-validation-for="CertificateSecondSignerName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-0">
                                <label class="form-label fw-semibold small text-muted">@L("SecondSignerTitleLabel", "2. İmzalayan Unvanı")</label>
                                <input asp-for="CertificateSecondSignerTitle" class="form-control"
                                       placeholder="@L("SecondSignerTitlePlaceholder", "Bilim Kurulu Başkanı")" />
                                <span asp-validation-for="CertificateSecondSignerTitle" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-secondary">
                            <i class="fas fa-file-word"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">@Localizer["DocumentsHeader"]</h5>
                            <p class="modern-card-text mb-0">@Localizer["DocumentsLead"]</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="row g-3">

                            <div class="col-md-4">
                                <div class="border rounded-3 p-3 text-center h-100 d-flex flex-column justify-content-between bg-light">
                                    <div>
                                        <i class="fas fa-book-open fa-2x text-secondary mb-2"></i>
                                        <h6 class="fw-semibold small text-dark mb-2">@Localizer["WritingRulesTitle"]</h6>
                                        <input type="file" name="WritingRulesFile" class="form-control form-control-sm mb-2" accept=".doc,.docx,.pdf" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.WritingRulesPath))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle p-2 w-100">
                                            <i class="fas fa-check-circle me-1"></i> @Localizer["UploadedView"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary p-2 w-100">
                                            @Localizer["NotUploadedYet"]
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="border rounded-3 p-3 text-center h-100 d-flex flex-column justify-content-between bg-light">
                                    <div>
                                        <i class="fas fa-file-alt fa-2x text-secondary mb-2"></i>
                                        <h6 class="fw-semibold small text-dark mb-2">@Localizer["AbstractTemplateTitle"]</h6>
                                        <input type="file" name="AbstractTemplateFile" class="form-control form-control-sm mb-2" accept=".doc,.docx,.pdf" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.AbstractTemplatePath))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle p-2 w-100">
                                            <i class="fas fa-check-circle me-1"></i> @Localizer["UploadedView"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary p-2 w-100">
                                            @Localizer["NotUploadedYet"]
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="border rounded-3 p-3 text-center h-100 d-flex flex-column justify-content-between bg-light">
                                    <div>
                                        <i class="fas fa-file-word fa-2x text-secondary mb-2"></i>
                                        <h6 class="fw-semibold small text-dark mb-2">@Localizer["FullTextTemplateTitle"]</h6>
                                        <input type="file" name="FullTextTemplateFile" class="form-control form-control-sm mb-2" accept=".doc,.docx,.pdf" />
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.FullTextTemplatePath))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle p-2 w-100">
                                            <i class="fas fa-check-circle me-1"></i> @Localizer["UploadedView"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary p-2 w-100">
                                            @Localizer["NotUploadedYet"]
                                        </span>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-success">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">@Localizer["DeadlineDates"]</h5>
                            <p class="modern-card-text mb-0">@Localizer["SubmissionDeadlines"]</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Özet Son Gönderim</label>
                            <input asp-for="AbstractSubmissionDeadline" type="datetime-local" class="form-control" />
                            <div class="form-text">@Localizer["NoLimitIfEmpty"]</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-semibold small text-muted">Tam Metin Son Gönderim</label>
                            <input asp-for="FullTextSubmissionDeadline" type="datetime-local" class="form-control" />
                            <div class="form-text">@Localizer["NoLimitIfEmpty"]</div>
                        </div>
                    </div>
                </div>

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-secondary">
                            <i class="fas fa-image"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">@Localizer["Image"]</h5>
                            <p class="modern-card-text mb-0">Logo ve banner (JPG, PNG, WEBP — maks. 5 MB).</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Kongre Logosu</label>
                            @if (!string.IsNullOrEmpty(Model.LogoPath))
                            {
                                <div class="mb-2">
                                    <img src="@Model.LogoPath" alt="Logo" class="img-thumbnail" style="max-height:60px;" />
                                </div>
                            }
                            <input type="file" name="LogoFile" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-semibold small text-muted">@Localizer["BannerImage"]</label>
                            @if (!string.IsNullOrEmpty(Model.BannerPath))
                            {
                                <div class="mb-2">
                                    <img src="@Model.BannerPath" alt="Banner" class="img-thumbnail w-100" style="max-height:80px;object-fit:cover;" />
                                </div>
                            }
                            <input type="file" name="BannerFile" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                    </div>
                </div>

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-primary">
                            <i class="fas fa-toggle-on"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">Ayarlar</h5>
                            <p class="modern-card-text mb-0">Başvuru, kayıt durumları ve kota.</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">
                                @Localizer["MaxRegistrations"]
                                <small class="text-muted"></small>
                            </label>
                            <input asp-for="MaxRegistrations" type="number" min="1" class="form-control" placeholder="Örn: 500" />
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsSubmissionOpen" class="form-check-input" type="checkbox" role="switch" />
                            <label class="form-check-label fw-medium">
                                
                                <small class="text-muted d-block"></small>
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="IsRegistrationOpen" class="form-check-input" type="checkbox" role="switch" />
                            <label class="form-check-label fw-medium">
                                
                                <small class="text-muted d-block"></small>
                            </label>
                        </div>
                    </div>
                </div>

                @* ── Ödeme Yöntemi Ayarları ──────────────────────────────────── *@
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="fas fa-credit-card text-primary me-2"></i>Ödeme Yöntemleri
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="IsStripeEnabled" class="form-check-input" type="checkbox" role="switch" />
                                    <label class="form-check-label fw-medium" asp-for="IsStripeEnabled">
                                        
                                        <small class="text-muted d-block">Stripe API anahtarları sunucuda yapılandırılmış olmalıdır.</small>
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="IsPayTREnabled" class="form-check-input" type="checkbox" role="switch" />
                                    <label class="form-check-label fw-medium" asp-for="IsPayTREnabled">
                                        
                                        <small class="text-muted d-block">PayTR API anahtarları sunucuda yapılandırılmış olmalıdır.</small>
                                    </label>
                                </div>
                                <div class="form-check form-switch">
                                    <input asp-for="IsBankTransferEnabled" class="form-check-input" type="checkbox" role="switch" id="bankSwitch" />
                                    <label class="form-check-label fw-medium" asp-for="IsBankTransferEnabled">
                                        Banka Havalesi / EFT
                                        <small class="text-muted d-block">Katılımcılar makbuz yükler, admin onaylar.</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div id="bank-fields">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">@Localizer["BankName"]</label>
                                    <input asp-for="BankName" class="form-control" placeholder="Örn: Ziraat Bankası" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Hesap Sahibi</label>
                                    <input asp-for="BankAccountName" class="form-control" placeholder="Örn: Kongre Organizasyon Derneği" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">@Localizer["Branch"]</label>
                                    <input asp-for="BankBranch" class="form-control" placeholder="Örn: Kızılay Şubesi" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">IBAN</label>
                                    <input asp-for="BankIban" class="form-control font-monospace" placeholder="TR00 0000 0000 0000 0000 0000 00" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    (function () {
                        var sw = document.getElementById('bankSwitch');
                        var fields = document.getElementById('bank-fields');
                        function toggle() { fields.style.display = sw.checked ? 'block' : 'none'; }
                        if (sw) { sw.addEventListener('change', toggle); toggle(); }
                    })();
                </script>

                <div class="conference-form-actions d-grid gap-2">
                    <button type="submit" class="btn btn-primary fw-bold py-3">
                        <i class="fas fa-save me-2"></i> @Localizer["SaveButton"]
                    </button>
                    <a asp-area="Admin" asp-controller="Conferences" asp-action="Index" asp-route-slug="@slug"
                       class="btn btn-light border text-muted">
                        @Localizer["CancelButton"]
                    </a>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model AntAbstract.Domain.Entities.Conference

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";
}

<div class="container-fluid py-4 conference-form-page">

    <div class="details-page-header d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fas fa-plus-circle text-primary me-2"></i>@Localizer["CardTitle"]</h4>
            <p class="text-muted mb-0 small">Yeni bir kongre oluşturmak için aşağıdaki formu doldurun.</p>
        </div>
        <a asp-area="Admin" asp-controller="Conferences" asp-action="Index" asp-route-slug="@slug"
           class="btn btn-light border text-muted">
            <i class="fas fa-arrow-left me-1"></i> @Localizer["CancelButton"]
        </a>
    </div>

    <form asp-area="Admin" asp-controller="Conferences" asp-action="Create" asp-route-slug="@slug" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-4 align-items-start">

            <div class="col-lg-8">

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <div class="modern-card mb-4">
                        <div class="modern-card-header">
                            <div class="modern-card-icon soft-primary">
                                <i class="fas fa-building"></i>
                            </div>
                            <div>
                                <h5 class="modern-card-title mb-1">@Localizer["TenantLabel"]</h5>
                                <p class="modern-card-text mb-0">@Localizer["TenantHelpText"]</p>
                            </div>
                        </div>
                        <div class="modern-card-body">
                            <select asp-for="TenantId" asp-items="ViewBag.Tenants" class="form-select" required>
                                <option value="">@Localizer["TenantSelectPlaceholder"]</option>
                            </select>
                            <span asp-validation-for="TenantId" class="text-danger small"></span>
                        </div>
                    </div>
                }

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-info">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">Temel Bilgiler</h5>
                            <p class="modern-card-text mb-0">Kongrenin adı, tarihi ve konumu.</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">@Localizer["TitleLabel"]</label>
                            <input asp-for="Title" class="form-control form-control-lg"
                                   placeholder="@Localizer["TitlePlaceholder"]" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["StartDateLabel"]</label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">@Localizer["EndDateLabel"]</label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">Şehir</label>
                                <input asp-for="City" class="form-control" placeholder="İstanbul" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">Ülke</label>
                                <input asp-for="Country" class="form-control" placeholder="Türkiye" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">@Localizer["VenueLabel"]</label>
                            <input asp-for="Venue" class="form-control" placeholder="@Localizer["VenuePlaceholder"]" />
                            <span asp-validation-for="Venue" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-semibold small text-muted">@Localizer["DescriptionLabel"]</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="@Localizer["DescriptionPlaceholder"]"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-warning">
                            <i class="fas fa-signature"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">Sertifika İmza Sahipleri</h5>
                            <p class="modern-card-text mb-0">Sertifikalarda görünecek isim ve unvanlar.</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">1. İmzalayan Adı</label>
                                <input asp-for="CertificateFirstSignerName" class="form-control" placeholder="Prof. Dr. Ad Soyad" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">1. İmzalayan Unvanı</label>
                                <input asp-for="CertificateFirstSignerTitle" class="form-control" placeholder="Kongre Başkanı" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold small text-muted">2. İmzalayan Adı</label>
                                <input asp-for="CertificateSecondSignerName" class="form-control" placeholder="Prof. Dr. Ad Soyad" />
                            </div>
                            <div class="col-md-6 mb-0">
                                <label class="form-label fw-semibold small text-muted">2. İmzalayan Unvanı</label>
                                <input asp-for="CertificateSecondSignerTitle" class="form-control" placeholder="Bilim Kurulu Başkanı" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-success">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">Son Başvuru Tarihleri</h5>
                            <p class="modern-card-text mb-0">Bildiri ve tam metin deadline'ları.</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Bildiri Son Gönderme</label>
                            <input asp-for="AbstractSubmissionDeadline" type="datetime-local" class="form-control" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-semibold small text-muted">Tam Metin Son Gönderme</label>
                            <input asp-for="FullTextSubmissionDeadline" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-primary">
                            <i class="fas fa-toggle-on"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">Ayarlar</h5>
                            <p class="modern-card-text mb-0">Başvuru ve kayıt durumları.</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">
                                Maksimum Kayıt Sayısı
                                <small class="text-muted">(boş = sınırsız)</small>
                            </label>
                            <input asp-for="MaxRegistrations" type="number" min="1" class="form-control" placeholder="Örn: 500" />
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsSubmissionOpen" class="form-check-input" type="checkbox" role="switch" checked />
                            <label class="form-check-label fw-medium">Bildiri Gönderme Açık</label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="IsRegistrationOpen" class="form-check-input" type="checkbox" role="switch" checked />
                            <label class="form-check-label fw-medium">Kayıt Açık</label>
                        </div>
                    </div>
                </div>

                <div class="modern-card mb-4">
                    <div class="modern-card-header">
                        <div class="modern-card-icon soft-secondary">
                            <i class="fas fa-image"></i>
                        </div>
                        <div>
                            <h5 class="modern-card-title mb-1">Görsel</h5>
                            <p class="modern-card-text mb-0">Logo ve banner (JPG, PNG, WEBP — maks. 5 MB).</p>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Kongre Logosu</label>
                            <input type="file" name="LogoFile" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-semibold small text-muted">Banner Görseli</label>
                            <input type="file" name="BannerFile" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                    </div>
                </div>

                <div class="conference-form-actions d-grid gap-2">
                    <button type="submit" class="btn btn-primary fw-bold py-3">
                        <i class="fas fa-save me-2"></i> @Localizer["SaveButton"]
                    </button>
                    <a asp-area="Admin" asp-controller="Conferences" asp-action="Index" asp-route-slug="@slug"
                       class="btn btn-light border text-muted">
                        @Localizer["CancelButton"]
                    </a>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

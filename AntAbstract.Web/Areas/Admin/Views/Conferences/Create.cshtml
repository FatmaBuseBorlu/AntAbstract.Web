@model AntAbstract.Domain.Entities.Conference

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">@Localizer["CardTitle"]</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-area="Admin"
                          asp-controller="Conferences"
                          asp-action="Create"
                          asp-route-slug="@slug"
                          method="post">
                        @Html.AntiForgeryToken()

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="mb-4 p-3 bg-light border rounded-3">
                                <label class="form-label fw-bold small text-primary">
                                    @Localizer["TenantLabel"]
                                </label>

                                <select asp-for="TenantId" asp-items="ViewBag.Tenants" class="form-select form-select-lg border-primary" required>
                                    <option value="">@Localizer["TenantSelectPlaceholder"]</option>
                                </select>

                                <span asp-validation-for="TenantId" class="text-danger small"></span>

                                <small class="text-muted d-block mt-1">
                                    <i class="fas fa-info-circle"></i>
                                    @Localizer["TenantHelpText"]
                                </small>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">@Localizer["TitleLabel"]</label>
                            <input asp-for="Title"
                                   class="form-control form-control-lg"
                                   placeholder="@Localizer["TitlePlaceholder"]"
                                   required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-muted">@Localizer["StartDateLabel"]</label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-muted">@Localizer["EndDateLabel"]</label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">@Localizer["VenueLabel"]</label>
                            <input asp-for="Venue"
                                   class="form-control"
                                   placeholder="@Localizer["VenuePlaceholder"]" />
                            <span asp-validation-for="Venue" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted">@Localizer["DescriptionLabel"]</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="@Localizer["DescriptionPlaceholder"]"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-area="Admin"
                               asp-controller="Conferences"
                               asp-action="Index"
                               asp-route-slug="@slug"
                               class="btn btn-light text-muted">
                                @Localizer["CancelButton"]
                            </a>

                            <button type="submit" class="btn btn-primary fw-bold px-5">
                                <i class="fas fa-save me-2"></i> @Localizer["SaveButton"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
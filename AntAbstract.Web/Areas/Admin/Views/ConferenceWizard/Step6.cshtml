@model AntAbstract.Domain.Entities.Conference
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = ViewBag.Slug as string ?? "";
    var hasRegTypes = (bool)ViewBag.HasRegistrationTypes;
    var hasTopics = (bool)ViewBag.HasTopics;
    var hasPayment = (bool)ViewBag.HasPayment;

    var checks = new[]
    {
        (Label: "Kongre adı ve açıklaması girildi",     Ok: !string.IsNullOrWhiteSpace(Model.Title)),
        (Label: "Kongre tarihleri belirlendi",           Ok: Model.StartDate != default && Model.EndDate != default),
        (Label: "En az bir kayıt tipi tanımlandı",      Ok: hasRegTypes),
        (Label: "Bildiri konuları eklendi",              Ok: hasTopics),
        (Label: "En az bir ödeme yöntemi aktif",         Ok: hasPayment),
        (Label: "Şehir / mekan bilgisi girildi",         Ok: !string.IsNullOrWhiteSpace(Model.City) || !string.IsNullOrWhiteSpace(Model.Venue)),
    };
    var allPassed = checks.All(c => c.Ok);
}

<div class="container-fluid px-4 py-4" style="max-width:780px;">

    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fas fa-magic me-2 text-primary"></i>@Localizer["ConferenceWizard"]</h4>
        <p class="text-muted small mb-3">@Model.Title</p>
        @await Html.PartialAsync("_WizardProgress", 6)
    </div>

    <!-- Checklist -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
        <div class="card-header p-4 text-white @(allPassed ? "bg-success" : "bg-warning")"
             style="border-radius:20px 20px 0 0;">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-@(allPassed ? "check-circle" : "exclamation-triangle") me-2"></i>
                @(allPassed ? "Kongre yayına hazır!" : "Eksikler var — yine de yayınlayabilirsiniz")
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="d-flex flex-column gap-2 mb-4">
                @foreach (var (label, ok) in checks)
                {
                    <div class="d-flex align-items-center gap-3 p-3 rounded-3 @(ok ? "bg-success bg-opacity-10" : "bg-warning bg-opacity-10")">
                        <i class="fas fa-@(ok ? "check-circle text-success" : "times-circle text-warning") fa-lg"></i>
                        <span class="fw-semibold @(ok ? "" : "text-warning-emphasis")">@label</span>
                    </div>
                }
            </div>

            <form asp-action="Publish" asp-route-slug="@slug" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <hr class="mb-4" />
                <p class="fw-semibold mb-3">Yayına alırken ne açık olsun?</p>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="openSubmission"
                                   id="subCheck" value="true" checked />
                            <label class="form-check-label fw-semibold" for="subCheck">
                                <i class="fas fa-file-alt me-1 text-primary"></i> Bildiri Başvurusu Açık
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="openRegistration"
                                   id="regCheck" value="true" />
                            <label class="form-check-label fw-semibold" for="regCheck">
                                <i class="fas fa-user-check me-1 text-success"></i> Kongre Kaydı Açık
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-between">
                    <a href="/@slug/Admin/ConferenceWizard/Step5/@Model.Id" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Geri
                    </a>
                    <button type="submit" class="btn btn-@(allPassed ? "success" : "warning text-dark") px-4 fw-bold">
                        <i class="fas fa-rocket me-2"></i>
                        @(allPassed ? "" : "Yine de Yayınla")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

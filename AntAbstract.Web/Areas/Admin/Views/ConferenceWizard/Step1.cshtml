@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = ViewBag.Slug as string ?? "";
}

<div class="container-fluid px-4 py-4" style="max-width:780px;">

    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fas fa-magic me-2 text-primary"></i>@Localizer["ConferenceWizard"]</h4>
        <p class="text-muted small mb-3">Adım adım kongrenizi oluşturun. Her adım kaydedilir.</p>
        @await Html.PartialAsync("_WizardProgress", 1)
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
    }

    <div class="card border-0 shadow-sm" style="border-radius:20px;">
        <div class="card-header bg-primary text-white p-4" style="border-radius:20px 20px 0 0;">
            <h5 class="fw-bold mb-0"><i class="fas fa-info-circle me-2"></i>Temel Bilgiler</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Step1Post" asp-route-slug="@slug" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Kongre Adı <span class="text-danger">*</span></label>
                    <input type="text" name="title" class="form-control form-control-lg"
                           placeholder="Örn: 5. Uluslararası Tıp Kongresi" required maxlength="300" autofocus />
                    <div class="form-text">Kongrenin tam resmi adı. URL slug'ı otomatik oluşturulur.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">@Localizer["Description"]</label>
                    <textarea name="description" class="form-control" rows="4"
                              placeholder="Kongre hakkında kısa bir açıklama..."></textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Localizer["City"]</label>
                        <input type="text" name="city" class="form-control" placeholder="İstanbul" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">@Localizer["Country"]</label>
                        <input type="text" name="country" class="form-control" placeholder="Türkiye" maxlength="100" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Mekan / Venue</label>
                    <input type="text" name="venue" class="form-control"
                           placeholder="Hilton İstanbul Kongre Merkezi" maxlength="300" />
                </div>

                <div class="d-flex gap-2 justify-content-between">
                    <a href="/@slug/Admin/Conferences" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> Vazgeç
                    </a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        Kaydet & İleri <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

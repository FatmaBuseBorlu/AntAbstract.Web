@using AntAbstract.Web.Areas.Admin.Controllers
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var dbOk          = (bool)ViewBag.DbOk;
    var dbError       = ViewBag.DbError as string;
    var stripeOk      = (bool)ViewBag.StripeOk;
    var auditPending  = (int)ViewBag.AuditQueuePending;
    var generatedAt   = (DateTime)ViewBag.GeneratedAt;

    var missingTemplates = (List<string>)ViewBag.MissingReminderTemplates;
    var webhookErrors = (List<WebhookErrorRow>)ViewBag.RecentWebhookErrors;
    var mailErrors    = (List<MailErrorRow>)ViewBag.RecentMailErrors;
    var wStats        = (WebhookStats)ViewBag.WebhookStats;
    var mStats        = (MailStats)ViewBag.MailStats;
    var ratePolicies   = ViewBag.RateLimitPolicies as dynamic[];
    var rateRejections = ViewBag.RateLimitRejections as List<AntAbstract.Web.Infrastructure.RateLimitCounter.RateLimitRejection>
                         ?? new();

    string Badge(bool ok) => ok
        ? $"<span class=\"badge bg-success\"><i class=\"fas fa-check me-1\"></i>OK</span>"
        : $"<span class=\"badge bg-danger\"><i class=\"fas fa-times me-1\"></i>{Localizer["Error"].Value}</span>";
}

<div class="admin-hero">
    <div class="admin-hero-left">
        <div class="admin-hero-icon">
            <i class="fas fa-heartbeat"></i>
        </div>
        <div>
            <div class="admin-hero-kicker">SYSTEM</div>
            <h3 class="admin-hero-title">@Localizer["PageTitle"]</h3>
            <p class="admin-hero-lead">@generatedAt.ToString("dd.MM.yyyy HH:mm:ss") UTC</p>
        </div>
    </div>
</div>

@* ── Özet Durum Kartları ────────────────────────────────────────── *@
<div class="admin-stat-grid">
    <div class="admin-stat-card">
        <div class="admin-stat-icon @(dbOk ? "stat-green" : "stat-red")">
            <i class="fas fa-database"></i>
        </div>
        <div>
            <div class="admin-stat-value">@Html.Raw(Badge(dbOk))</div>
            <div class="admin-stat-label">@Localizer["Database"]</div>
            @if (!dbOk && dbError != null)
            {
                <div class="text-danger small mt-1" style="max-width:200px;word-break:break-all">@dbError</div>
            }
        </div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-icon @(stripeOk ? "stat-green" : "stat-yellow")">
            <i class="fab fa-stripe-s"></i>
        </div>
        <div>
            <div class="admin-stat-value">
                @if (stripeOk) { @Html.Raw(Badge(true)) } else { <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>@Localizer["NotConfigured"]</span> }
            </div>
            <div class="admin-stat-label">Stripe</div>
        </div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-icon @(auditPending < 500 ? "stat-green" : auditPending < 5000 ? "stat-yellow" : "stat-red")">
            <i class="fas fa-layer-group"></i>
        </div>
        <div>
            <div class="admin-stat-value">@(auditPending < 0 ? "—" : auditPending.ToString())</div>
            <div class="admin-stat-label">@Localizer["AuditQueue"] — @Localizer["PendingRecords"]</div>
        </div>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-icon @(wStats.Failed == 0 && mStats.Failed == 0 ? "stat-green" : "stat-yellow")">
            <i class="fas fa-bell"></i>
        </div>
        <div>
            <div class="admin-stat-value">@Localizer["Last24Hours"]</div>
            <div class="admin-stat-label">
                Webhook: <strong>@wStats.Total</strong> / <span class="text-danger">@wStats.Failed @Localizer["ErrorCount"]</span><br/>
                @Localizer["Email"]: <strong>@mStats.Total</strong> / <span class="text-danger">@mStats.Failed @Localizer["ErrorCount"]</span>
            </div>
        </div>
    </div>
</div>

@* ── Stripe Webhook Hataları ────────────────────────────────────── *@
<div class="admin-list-card" style="margin-top:1.5rem;">
    <div class="admin-list-card-header">
        <h5 class="admin-list-card-title">
            <i class="fas fa-bolt me-2 text-warning"></i>
            @Localizer["RecentWebhookErrors"]
            @if (webhookErrors.Any())
            {
                <span class="badge bg-danger ms-2">@webhookErrors.Count</span>
            }
            <a href="/Admin/Payments/WebhookLog?status=failed" class="btn btn-sm btn-outline-secondary ms-auto float-end">
                @Localizer["ViewAll"]
            </a>
        </h5>
    </div>
    <div class="card-body p-0">
        @if (!webhookErrors.Any())
        {
            <p class="text-muted p-3 mb-0"><i class="fas fa-check-circle text-success me-1"></i>@Localizer["NoRecentWebhookErrors"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["EventType"]</th>
                            <th>Stripe Event ID</th>
                            <th>@Localizer["ErrorHeader"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in webhookErrors)
                        {
                            <tr>
                                <td class="text-nowrap small">@e.ReceivedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><code class="small">@e.EventType</code></td>
                                <td><code class="small text-muted">@e.StripeEventId[..Math.Min(20, e.StripeEventId.Length)]…</code></td>
                                <td class="text-danger small">@e.ErrorMessage</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ── Mail Hataları ─────────────────────────────────────────────── *@
<div class="admin-list-card" style="margin-top:1.5rem;">
    <div class="admin-list-card-header">
        <h5 class="admin-list-card-title">
            <i class="fas fa-envelope me-2 text-primary"></i>
            @Localizer["RecentMailErrors"]
            @if (mailErrors.Any())
            {
                <span class="badge bg-danger ms-2">@mailErrors.Count</span>
            }
            <a href="/Admin/EmailTemplates/SendLog?status=failed" class="btn btn-sm btn-outline-secondary ms-auto float-end">
                @Localizer["ViewAll"]
            </a>
        </h5>
    </div>
    <div class="card-body p-0">
        @if (!mailErrors.Any())
        {
            <p class="text-muted p-3 mb-0"><i class="fas fa-check-circle text-success me-1"></i>@Localizer["NoRecentMailErrors"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Recipient"]</th>
                            <th>@Localizer["Subject"]</th>
                            <th>@Localizer["Template"]</th>
                            <th>@Localizer["ErrorHeader"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in mailErrors)
                        {
                            <tr>
                                <td class="text-nowrap small">@m.SentAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="small">@m.ToEmail</td>
                                <td class="small">@(m.Subject.Length > 40 ? m.Subject[..40] + "…" : m.Subject)</td>
                                <td><code class="small text-muted">@m.TemplateKey</code></td>
                                <td class="text-danger small">@m.ErrorMessage</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ── Eksik Hatırlatıcı Şablonları ──────────────────────────────── *@
@if (missingTemplates.Any())
{
    <div class="alert alert-warning border-0 rounded-4 mb-4" style="margin-top:1.5rem;">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>@Localizer["MissingMailTemplates"]</strong> @Localizer["MissingTemplatesDescription"]
        <ul class="mb-0 mt-2 ps-3">
            @foreach (var key in missingTemplates)
            {
                <li>
                    <code>@key</code>
                    <a href="/Admin/EmailTemplates/Create" class="btn btn-sm btn-outline-warning ms-2">@Localizer["CreateTemplate"]</a>
                </li>
            }
        </ul>
    </div>
}

@* ── Rate Limiting ───────────────────────────────────────────── *@
<div class="admin-list-card" style="margin-top:1.5rem;">
    <div class="admin-list-card-header">
        <h5 class="admin-list-card-title">
            <i class="fas fa-tachometer-alt me-2 text-warning"></i>@Localizer["RateLimitPolicies"]
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm mb-0 small">
                <thead class="table-light">
                    <tr><th class="px-3">@Localizer["Policy"]</th><th>Limit</th><th>@Localizer["Scope"]</th></tr>
                </thead>
                <tbody>
                    @if (ratePolicies != null)
                    {
                        @foreach (dynamic p in ratePolicies)
                        {
                            <tr>
                                <td class="px-3"><code>@p.Policy</code></td>
                                <td>@p.Limit</td>
                                <td class="text-muted">@p.Scope</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (rateRejections.Any())
{
    <div class="admin-list-card" style="margin-top:1.5rem;">
        <div class="admin-list-card-header">
            <h5 class="admin-list-card-title">
                <i class="fas fa-ban me-2 text-danger"></i>@Localizer["RecentRateLimitRejections"]
                <span class="badge bg-danger ms-2">@rateRejections.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0 small">
                    <thead class="table-light">
                        <tr><th class="px-3">@Localizer["Time"]</th><th>Path</th><th>IP</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rateRejections)
                        {
                            <tr>
                                <td class="px-3 text-nowrap">@r.At.ToString("dd.MM HH:mm:ss")</td>
                                <td><code>@r.Path</code></td>
                                <td class="text-muted">@(r.Ip ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ── Webhook İstatistikleri (24 saat) ─────────────────────────── *@
@if (wStats.Duplicate > 0)
{
    <div class="alert alert-info border-0 rounded-4" style="margin-top:1.5rem;">
        <i class="fas fa-copy me-2"></i>
        @Html.Raw(string.Format(Localizer["DuplicateWebhookInfo"].Value, wStats.Duplicate))
    </div>
}

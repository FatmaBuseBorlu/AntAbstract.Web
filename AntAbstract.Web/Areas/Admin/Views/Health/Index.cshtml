@using AntAbstract.Web.Areas.Admin.Controllers
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var dbOk          = (bool)ViewBag.DbOk;
    var dbError       = ViewBag.DbError as string;
    var stripeOk      = (bool)ViewBag.StripeOk;
    var auditPending  = (int)ViewBag.AuditQueuePending;
    var generatedAt   = (DateTime)ViewBag.GeneratedAt;

    var missingTemplates = (List<string>)ViewBag.MissingReminderTemplates;
    var webhookErrors = (List<WebhookErrorRow>)ViewBag.RecentWebhookErrors;
    var mailErrors    = (List<MailErrorRow>)ViewBag.RecentMailErrors;
    var wStats        = (WebhookStats)ViewBag.WebhookStats;
    var mStats        = (MailStats)ViewBag.MailStats;
    var ratePolicies   = ViewBag.RateLimitPolicies as dynamic[];
    var rateRejections = ViewBag.RateLimitRejections as List<AntAbstract.Web.Infrastructure.RateLimitCounter.RateLimitRejection>
                         ?? new();
}

<style>
    .health-page { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }

    /* ── Hero ── */
    .health-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 18px;
        padding: 2rem 2.5rem;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 2rem;
    }
    .health-hero-icon {
        width: 56px; height: 56px;
        background: rgba(255,255,255,0.12);
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
    }
    .health-hero h3 { font-size: 1.5rem; font-weight: 700; margin: 0; }
    .health-hero small { color: rgba(255,255,255,0.55); font-size: 0.82rem; }

    /* ── Stat kartları ── */
    .health-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .health-stat-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }
    .health-stat-icon {
        width: 44px; height: 44px;
        border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .si-green  { background: #dcfce7; color: #16a34a; }
    .si-red    { background: #fee2e2; color: #dc2626; }
    .si-yellow { background: #fef9c3; color: #b45309; }
    .si-blue   { background: #dbeafe; color: #2563eb; }
    .health-stat-value { font-size: 1.25rem; font-weight: 700; color: #0f172a; line-height: 1.2; }
    .health-stat-label { font-size: 0.75rem; color: #64748b; margin-top: 2px; }

    /* ── Bölüm kartları ── */
    .health-section {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 1.25rem;
    }
    .health-section-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        background: #f8fafc;
    }
    .health-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }
    .health-section-body { padding: 0; }
    .health-empty {
        display: flex; align-items: center; gap: 0.5rem;
        color: #16a34a; font-size: 0.85rem;
        padding: 1.1rem 1.5rem;
    }

    /* ── Tablo ── */
    .health-table { width: 100%; font-size: 0.82rem; border-collapse: collapse; }
    .health-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-weight: 600;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: 0.6rem 1.5rem;
        border-bottom: 1px solid #e2e8f0;
    }
    .health-table tbody td {
        padding: 0.65rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        color: #334155;
    }
    .health-table tbody tr:last-child td { border-bottom: none; }
    .health-table tbody tr:hover td { background: #f8fafc; }

    /* ── Eksik şablon uyarısı ── */
    .health-warning {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.25rem;
    }
    .health-warning-title { font-weight: 700; color: #92400e; font-size: 0.9rem; margin-bottom: 0.5rem; }
    .health-warning ul { margin: 0; padding-left: 1.25rem; }
    .health-warning li { margin-bottom: 0.4rem; color: #78350f; font-size: 0.85rem; }
</style>

<div class="health-page">

    @** Hero  *@
    <div class="health-hero">
        <div class="health-hero-icon"><i class="fas fa-heartbeat"></i></div>
        <div>
            <h3>@Localizer["PageTitle"]</h3>
            <small>@generatedAt.ToString("dd.MM.yyyy HH:mm:ss") UTC</small>
        </div>
    </div>

    @** Stat Kartları  *@
    <div class="health-stat-grid">
        <div class="health-stat-card">
            <div class="health-stat-icon @(dbOk ? "si-green" : "si-red")">
                <i class="fas fa-database"></i>
            </div>
            <div>
                <div class="health-stat-value">
                    @if (dbOk) { <span style="color:#16a34a">✓ OK</span> }
                    else { <span style="color:#dc2626">✗ Hata</span> }
                </div>
                <div class="health-stat-label">@Localizer["Database"]</div>
                @if (!dbOk && dbError != null)
                {
                    <div class="text-danger" style="font-size:0.7rem;margin-top:4px;word-break:break-all">@dbError</div>
                }
            </div>
        </div>

        <div class="health-stat-card">
            <div class="health-stat-icon @(stripeOk ? "si-green" : "si-yellow")">
                <i class="fab fa-stripe-s"></i>
            </div>
            <div>
                <div class="health-stat-value">
                    @if (stripeOk) { <span style="color:#16a34a">✓ OK</span> }
                    else { <span style="color:#b45309">Yapılandırılmamış</span> }
                </div>
                <div class="health-stat-label">Stripe</div>
            </div>
        </div>

        <div class="health-stat-card">
            <div class="health-stat-icon @(auditPending < 500 ? "si-green" : auditPending < 5000 ? "si-yellow" : "si-red")">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <div class="health-stat-value">@(auditPending < 0 ? "—" : auditPending.ToString())</div>
                <div class="health-stat-label">@Localizer["AuditQueue"] — @Localizer["PendingRecords"]</div>
            </div>
        </div>

        <div class="health-stat-card">
            <div class="health-stat-icon @(wStats.Failed == 0 && mStats.Failed == 0 ? "si-green" : "si-yellow")">
                <i class="fas fa-bell"></i>
            </div>
            <div>
                <div class="health-stat-value">@Localizer["Last24Hours"]</div>
                <div class="health-stat-label">
                    Webhook: @wStats.Total / <span class="@(wStats.Failed > 0 ? "text-danger fw-bold" : "")">@wStats.Failed hata</span><br/>
                    Mail: @mStats.Total / <span class="@(mStats.Failed > 0 ? "text-danger fw-bold" : "")">@mStats.Failed hata</span>
                </div>
            </div>
        </div>
    </div>

    @** Eksik şablon uyarısı  *@
    @if (missingTemplates.Any())
    {
        <div class="health-warning">
            <div class="health-warning-title"><i class="fas fa-exclamation-triangle me-2"></i>@Localizer["MissingMailTemplates"]</div>
            <div style="font-size:0.82rem;color:#92400e;margin-bottom:0.5rem;">@Localizer["MissingTemplatesDescription"]</div>
            <ul>
                @foreach (var key in missingTemplates)
                {
                    <li>
                        <code>@key</code>
                        <a href="/Admin/EmailTemplates/Create" class="btn btn-sm btn-outline-warning ms-2" style="font-size:0.75rem;padding:2px 10px;">@Localizer["CreateTemplate"]</a>
                    </li>
                }
            </ul>
        </div>
    }

    @** Webhook Hataları  *@
    <div class="health-section">
        <div class="health-section-header">
            <h5 class="health-section-title">
                <i class="fas fa-bolt text-warning"></i>@Localizer["RecentWebhookErrors"]
                @if (webhookErrors.Any()) { <span class="badge bg-danger" style="font-size:0.7rem;">@webhookErrors.Count</span> }
            </h5>
            <a href="/Admin/Payments/WebhookLog?status=failed" class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem;">@Localizer["ViewAll"]</a>
        </div>
        <div class="health-section-body">
            @if (!webhookErrors.Any())
            {
                <div class="health-empty"><i class="fas fa-check-circle"></i>@Localizer["NoRecentWebhookErrors"]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="health-table">
                        <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["EventType"]</th><th>Stripe Event ID</th><th>@Localizer["ErrorHeader"]</th></tr></thead>
                        <tbody>
                            @foreach (var e in webhookErrors)
                            {
                                <tr>
                                    <td style="white-space:nowrap">@e.ReceivedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><code style="font-size:0.78rem">@e.EventType</code></td>
                                    <td><code style="font-size:0.78rem;color:#94a3b8">@e.StripeEventId[..Math.Min(20, e.StripeEventId.Length)]…</code></td>
                                    <td style="color:#dc2626">@e.ErrorMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @** Mail Hataları  *@
    <div class="health-section">
        <div class="health-section-header">
            <h5 class="health-section-title">
                <i class="fas fa-envelope text-primary"></i>@Localizer["RecentMailErrors"]
                @if (mailErrors.Any()) { <span class="badge bg-danger" style="font-size:0.7rem;">@mailErrors.Count</span> }
            </h5>
            <a href="/Admin/EmailTemplates/SendLog?status=failed" class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem;">@Localizer["ViewAll"]</a>
        </div>
        <div class="health-section-body">
            @if (!mailErrors.Any())
            {
                <div class="health-empty"><i class="fas fa-check-circle"></i>@Localizer["NoRecentMailErrors"]</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="health-table">
                        <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Recipient"]</th><th>@Localizer["Subject"]</th><th>@Localizer["Template"]</th><th>@Localizer["ErrorHeader"]</th></tr></thead>
                        <tbody>
                            @foreach (var m in mailErrors)
                            {
                                <tr>
                                    <td style="white-space:nowrap">@m.SentAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@m.ToEmail</td>
                                    <td>@(m.Subject.Length > 40 ? m.Subject[..40] + "…" : m.Subject)</td>
                                    <td><code style="font-size:0.78rem;color:#94a3b8">@m.TemplateKey</code></td>
                                    <td style="color:#dc2626">@m.ErrorMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @** Rate Limiting  *@
    <div class="health-section">
        <div class="health-section-header">
            <h5 class="health-section-title">
                <i class="fas fa-tachometer-alt text-warning"></i>@Localizer["RateLimitPolicies"]
            </h5>
        </div>
        <div class="health-section-body">
            <div class="table-responsive">
                <table class="health-table">
                    <thead><tr><th>@Localizer["Policy"]</th><th>Limit</th><th>@Localizer["Scope"]</th></tr></thead>
                    <tbody>
                        @if (ratePolicies != null)
                        {
                            @foreach (dynamic p in ratePolicies)
                            {
                                <tr>
                                    <td><code style="font-size:0.78rem">@p.Policy</code></td>
                                    <td>@p.Limit</td>
                                    <td style="color:#64748b">@p.Scope</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @** Rate Limit Redler  *@
    @if (rateRejections.Any())
    {
        <div class="health-section">
            <div class="health-section-header">
                <h5 class="health-section-title">
                    <i class="fas fa-ban text-danger"></i>@Localizer["RecentRateLimitRejections"]
                    <span class="badge bg-danger" style="font-size:0.7rem;">@rateRejections.Count</span>
                </h5>
            </div>
            <div class="health-section-body">
                <div class="table-responsive">
                    <table class="health-table">
                        <thead><tr><th>@Localizer["Time"]</th><th>Path</th><th>IP</th></tr></thead>
                        <tbody>
                            @foreach (var r in rateRejections)
                            {
                                <tr>
                                    <td style="white-space:nowrap">@r.At.ToString("dd.MM HH:mm:ss")</td>
                                    <td><code style="font-size:0.78rem">@r.Path</code></td>
                                    <td style="color:#64748b">@(r.Ip ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @** Duplikat Webhook  *@
    @if (wStats.Duplicate > 0)
    {
        <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:14px;padding:1rem 1.5rem;font-size:0.85rem;color:#1e40af;">
            <i class="fas fa-copy me-2"></i>
            @Html.Raw(string.Format(Localizer["DuplicateWebhookInfo"].Value, wStats.Duplicate))
        </div>
    }

</div>

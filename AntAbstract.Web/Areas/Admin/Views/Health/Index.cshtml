@using AntAbstract.Web.Areas.Admin.Controllers
@{
    ViewData["Title"] = "Sistem Sağlığı";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var dbOk          = (bool)ViewBag.DbOk;
    var dbError       = ViewBag.DbError as string;
    var stripeOk      = (bool)ViewBag.StripeOk;
    var auditPending  = (int)ViewBag.AuditQueuePending;
    var generatedAt   = (DateTime)ViewBag.GeneratedAt;

    var missingTemplates = (List<string>)ViewBag.MissingReminderTemplates;
    var webhookErrors = (List<WebhookErrorRow>)ViewBag.RecentWebhookErrors;
    var mailErrors    = (List<MailErrorRow>)ViewBag.RecentMailErrors;
    var wStats        = (WebhookStats)ViewBag.WebhookStats;
    var mStats        = (MailStats)ViewBag.MailStats;
    var ratePolicies   = ViewBag.RateLimitPolicies as dynamic[];
    var rateRejections = ViewBag.RateLimitRejections as List<AntAbstract.Web.Infrastructure.RateLimitCounter.RateLimitRejection>
                         ?? new();

    string Badge(bool ok) => ok
        ? "<span class=\"badge bg-success\"><i class=\"fas fa-check me-1\"></i>OK</span>"
        : "<span class=\"badge bg-danger\"><i class=\"fas fa-times me-1\"></i>HATA</span>";
}

<div class="container-fluid py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="mb-0"><i class="fas fa-heartbeat me-2 text-danger"></i>Sistem Sağlığı</h4>
        <small class="text-muted">@generatedAt.ToString("dd.MM.yyyy HH:mm:ss") UTC</small>
    </div>

    @* ── Özet Durum Kartları ────────────────────────────────────────── *@
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 @(dbOk ? "text-success" : "text-danger")">
                        <i class="fas fa-database"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Veritabanı</div>
                        @Html.Raw(Badge(dbOk))
                        @if (!dbOk && dbError != null)
                        {
                            <div class="text-danger small mt-1" style="max-width:200px;word-break:break-all">@dbError</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 @(stripeOk ? "text-success" : "text-warning")">
                        <i class="fab fa-stripe-s"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Stripe</div>
                        @if (stripeOk)
                        {
                            @Html.Raw(Badge(true))
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>Yapılandırılmamış</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 @(auditPending < 500 ? "text-success" : auditPending < 5000 ? "text-warning" : "text-danger")">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Audit Kuyruğu</div>
                        <span class="fw-bold fs-5">@(auditPending < 0 ? "—" : auditPending.ToString())</span>
                        <div class="text-muted small">bekleyen kayıt</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 @(wStats.Failed == 0 && mStats.Failed == 0 ? "text-success" : "text-warning")">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Son 24 Saat</div>
                        <div class="small">
                            Webhook: <strong>@wStats.Total</strong> / <span class="text-danger">@wStats.Failed hata</span>
                        </div>
                        <div class="small">
                            E-posta: <strong>@mStats.Total</strong> / <span class="text-danger">@mStats.Failed hata</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @* ── Stripe Webhook Hataları ────────────────────────────────────── *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-3 pb-0">
            <h6 class="mb-0">
                <i class="fas fa-bolt me-2 text-warning"></i>
                Son Webhook Hataları
                @if (webhookErrors.Any())
                {
                    <span class="badge bg-danger ms-2">@webhookErrors.Count</span>
                }
                <a href="/Admin/Payments/WebhookLog?status=failed" class="btn btn-sm btn-outline-secondary ms-auto float-end">
                    Tümünü Gör
                </a>
            </h6>
        </div>
        <div class="card-body p-0">
            @if (!webhookErrors.Any())
            {
                <p class="text-muted p-3 mb-0"><i class="fas fa-check-circle text-success me-1"></i>Son dönemde webhook hatası yok.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Event Tipi</th>
                                <th>Stripe Event ID</th>
                                <th>Hata</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in webhookErrors)
                            {
                                <tr>
                                    <td class="text-nowrap small">@e.ReceivedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><code class="small">@e.EventType</code></td>
                                    <td><code class="small text-muted">@e.StripeEventId[..Math.Min(20, e.StripeEventId.Length)]…</code></td>
                                    <td class="text-danger small">@e.ErrorMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Mail Hataları ─────────────────────────────────────────────── *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-3 pb-0">
            <h6 class="mb-0">
                <i class="fas fa-envelope me-2 text-primary"></i>
                Son Mail Hataları
                @if (mailErrors.Any())
                {
                    <span class="badge bg-danger ms-2">@mailErrors.Count</span>
                }
                <a href="/Admin/EmailTemplates/SendLog?status=failed" class="btn btn-sm btn-outline-secondary ms-auto float-end">
                    Tümünü Gör
                </a>
            </h6>
        </div>
        <div class="card-body p-0">
            @if (!mailErrors.Any())
            {
                <p class="text-muted p-3 mb-0"><i class="fas fa-check-circle text-success me-1"></i>Son dönemde mail hatası yok.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Alıcı</th>
                                <th>Konu</th>
                                <th>Şablon</th>
                                <th>Hata</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in mailErrors)
                            {
                                <tr>
                                    <td class="text-nowrap small">@m.SentAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="small">@m.ToEmail</td>
                                    <td class="small">@(m.Subject.Length > 40 ? m.Subject[..40] + "…" : m.Subject)</td>
                                    <td><code class="small text-muted">@m.TemplateKey</code></td>
                                    <td class="text-danger small">@m.ErrorMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Eksik Hatırlatıcı Şablonları ──────────────────────────────── *@
    @if (missingTemplates.Any())
    {
        <div class="alert alert-warning border-0 rounded-4 mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Eksik mail şablonları:</strong> Aşağıdaki şablon key'leri tanımlı değil veya pasif —
            mail hatırlatıcıları çalışsa da bu şablon bulunamaz ve sessizce atlanır.
            <ul class="mb-0 mt-2 ps-3">
                @foreach (var key in missingTemplates)
                {
                    <li>
                        <code>@key</code>
                        <a href="/Admin/EmailTemplates/Create" class="btn btn-sm btn-outline-warning ms-2">Şablon Oluştur</a>
                    </li>
                }
            </ul>
        </div>
    }

    @* ── Rate Limiting ───────────────────────────────────────────── *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom fw-bold py-3">
            <i class="fas fa-tachometer-alt me-2 text-warning"></i>Rate Limiting Politikaları
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0 small">
                    <thead class="table-light">
                        <tr><th class="px-3">Politika</th><th>Limit</th><th>Kapsam</th></tr>
                    </thead>
                    <tbody>
                        @if (ratePolicies != null)
                        {
                            @foreach (dynamic p in ratePolicies)
                            {
                                <tr>
                                    <td class="px-3"><code>@p.Policy</code></td>
                                    <td>@p.Limit</td>
                                    <td class="text-muted">@p.Scope</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (rateRejections.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom fw-bold py-3">
                <i class="fas fa-ban me-2 text-danger"></i>Son Rate Limit Reddleri
                <span class="badge bg-danger ms-2">@rateRejections.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small">
                        <thead class="table-light">
                            <tr><th class="px-3">Zaman</th><th>Path</th><th>IP</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in rateRejections)
                            {
                                <tr>
                                    <td class="px-3 text-nowrap">@r.At.ToString("dd.MM HH:mm:ss")</td>
                                    <td><code>@r.Path</code></td>
                                    <td class="text-muted">@(r.Ip ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* ── Webhook İstatistikleri (24 saat) ─────────────────────────── *@
    @if (wStats.Duplicate > 0)
    {
        <div class="alert alert-info border-0 rounded-4">
            <i class="fas fa-copy me-2"></i>
            Son 24 saatte <strong>@wStats.Duplicate</strong> duplicate webhook eventi alındı — idempotency koruması devrede.
        </div>
    }

</div>

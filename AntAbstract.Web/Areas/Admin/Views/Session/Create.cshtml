@model AntAbstract.Web.Models.ViewModels.Admin.Sessions.SessionCreateViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var baseUrl = string.IsNullOrWhiteSpace(Model.Slug)
        ? "/Admin/Session"
        : $"/{Model.Slug}/Admin/Session";

    var backUrl = Model.ConferenceId == Guid.Empty
        ? baseUrl
        : $"{baseUrl}?conferenceId={Model.ConferenceId}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h4 class="fw-bold mb-0">@Localizer["CardTitle"]</h4>
                        <a href="@backUrl" class="btn btn-light border" title="@Localizer["BackButton"]">
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="text-danger small mb-2">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <form asp-area="Admin"
                          asp-controller="Session"
                          asp-action="Create"
                          asp-route-slug="@Model.Slug"
                          method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ConferenceId" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">@Localizer["TitleLabel"]</label>
                            <input asp-for="Title" class="form-control" placeholder="@Localizer["TitlePlaceholder"]" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">@Localizer["SessionDateLabel"]</label>
                            <input asp-for="SessionDate"
                                   class="form-control"
                                   type="datetime-local"
                                   value="@(Model.SessionDate == default ? "" : Model.SessionDate.ToString("yyyy-MM-ddTHH:mm"))" />
                            <span asp-validation-for="SessionDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">@Localizer["LocationLabel"]</label>
                            <input asp-for="Location" class="form-control" placeholder="@Localizer["LocationPlaceholder"]" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-bold">@Localizer["CreateButton"]</button>
                            <a href="@backUrl" class="btn btn-outline-secondary">@Localizer["CancelButton"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@using AntAbstract.Domain.Entities
@model List<Session>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Program Takvimi";

    var slug      = (string?)ViewBag.Slug ?? "";
    var confId    = (Guid)ViewBag.ConferenceId;
    var confTitle = (string?)ViewBag.ConferenceTitle ?? "";

    var groups = Model
        .OrderBy(s => s.SessionDate)
        .ThenBy(s => s.StartTime)
        .ThenBy(s => s.SortOrder)
        .GroupBy(s => s.SessionDate.Date)
        .ToList();

    string Url(string path) => string.IsNullOrWhiteSpace(slug) ? path : $"/{slug}{path}";
}

<style>
    .session-day-header {
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
        color: #fff;
        border-radius: 14px;
        padding: .75rem 1.25rem;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: .6rem;
    }
    .session-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        transition: box-shadow .15s;
    }
    .session-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
    .session-time-badge {
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 600;
        padding: .2rem .55rem;
        white-space: nowrap;
    }
    .session-location-badge {
        background: #f1f5f9;
        color: #475569;
        border-radius: 8px;
        font-size: .78rem;
        padding: .2rem .55rem;
    }
</style>

<div class="container-fluid py-4">

    <!-- Başlık -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fas fa-calendar-alt text-primary me-2"></i>Program Takvimi</h4>
            <p class="text-muted mb-0 small">@confTitle</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url($"/Admin/ConferenceFlow/ProgramSessions?conferenceId={confId}")"
               class="btn btn-outline-secondary">
                <i class="fas fa-th-list me-1"></i>Akış Görünümü
            </a>
            <a href="@Url($"/Admin/Session/Create?conferenceId={confId}")"
               class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Yeni Oturum
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm mb-4">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <i class="fas fa-calendar-plus fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">Henüz oturum eklenmemiş</h5>
            <p class="text-muted small mb-4">Program takvimini oluşturmak için oturum ekleyin.</p>
            <div>
                <a href="@Url($"/Admin/Session/Create?conferenceId={confId}")" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>İlk Oturumu Ekle
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Özet -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-primary">@Model.Count</div>
                    <div class="text-muted small">Toplam Oturum</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-success">@groups.Count</div>
                    <div class="text-muted small">Kongre Günü</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-info">@Model.Sum(s => s.Submissions.Count)</div>
                    <div class="text-muted small">Atanan Bildiri</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-warning">@Model.Count(s => !s.IsActive)</div>
                    <div class="text-muted small">Pasif Oturum</div>
                </div>
            </div>
        </div>

        <!-- Günlere göre oturumlar -->
        @foreach (var day in groups)
        {
            <div class="session-day-header mb-3">
                <i class="fas fa-calendar-day"></i>
                @day.Key.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                <span class="badge bg-white text-primary ms-auto">@day.Count() oturum</span>
            </div>

            <div class="row g-3 mb-4 sortable-day" data-date="@day.Key.ToString("yyyy-MM-dd")">
                @foreach (var session in day.OrderBy(s => s.StartTime).ThenBy(s => s.SortOrder))
                {
                    <div class="col-12 col-lg-6" data-session-id="@session.Id">
                        <div class="session-card p-3 h-100">
                            <div class="d-flex align-items-start gap-2 mb-2">
                                <span class="session-time-badge">
                                    <i class="fas fa-clock me-1"></i>
                                    @session.StartTime.ToString(@"hh\:mm") – @session.EndTime.ToString(@"hh\:mm")
                                </span>
                                @if (!string.IsNullOrWhiteSpace(session.Location))
                                {
                                    <span class="session-location-badge">
                                        <i class="fas fa-map-marker-alt me-1"></i>@session.Location
                                    </span>
                                }
                                @if (!session.IsActive)
                                {
                                    <span class="badge bg-secondary ms-auto">Pasif</span>
                                }
                            </div>

                            <h6 class="fw-bold mb-1">
                                <i class="fas fa-grip-vertical text-muted me-2 drag-handle" style="cursor:grab;opacity:0.4;"></i>@session.Title
                            </h6>

                            @if (!string.IsNullOrWhiteSpace(session.SpeakerName))
                            {
                                <div class="text-muted small mb-1">
                                    <i class="fas fa-user me-1"></i>@session.SpeakerName
                                </div>
                            }

                            @if (session.Submissions.Any())
                            {
                                <div class="small text-success mt-1">
                                    <i class="fas fa-file-alt me-1"></i>@session.Submissions.Count bildiri atandı
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted mt-1">
                                    <i class="fas fa-inbox me-1"></i>Bildiri atanmadı
                                </div>
                            }

                            <div class="d-flex gap-2 mt-3">
                                <a href="@Url($"/Admin/Session/Manage/{session.Id}?conferenceId={confId}")"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-tasks me-1"></i>Yönet
                                </a>
                                <a href="@Url($"/Admin/Session/Edit/{session.Id}?conferenceId={confId}")"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-edit me-1"></i>Düzenle
                                </a>
                                <form method="post" action="@Url($"/Admin/Session/Delete")" class="d-inline ms-auto"
                                      onsubmit="return confirm('Bu oturumu silmek istediğinizden emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@session.Id" />
                                    <input type="hidden" name="conferenceId" value="@confId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.sortable-day').forEach(function (container) {
        new Sortable(container, {
            handle: '.drag-handle',
            animation: 200,
            ghostClass: 'bg-primary bg-opacity-10',
            onEnd: function () {
                var ids = [];
                container.querySelectorAll('[data-session-id]').forEach(function (el) {
                    ids.push(el.dataset.sessionId);
                });
                fetch('@Url("/Admin/Session/Reorder")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        conferenceId: '@confId',
                        sessionIds: ids
                    })
                });
            }
        });
    });
});
</script>
}

@model AntAbstract.Domain.Entities.Session
@using AntAbstract.Domain.Entities
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Context.GetRouteValue("slug")?.ToString() ?? "";
    var conferenceId = ViewBag.ConferenceId;
    var unassigned = ViewBag.UnassignedSubmissions as List<Submission>;

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? (conferenceId == null
            ? "/Admin/Session"
            : $"/Admin/Session?conferenceId={conferenceId}")
        : (conferenceId == null
            ? $"/{slug}/Admin/Session"
            : $"/{slug}/Admin/Session?conferenceId={conferenceId}");
}

<div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
        <a href="@backUrl" class="btn btn-light border me-3" title="@Localizer["BackButton"]">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0">@Localizer["PageTitle"]: @Model.Title</h4>
            <small class="text-muted">@Model.SessionDate.ToString("dd MMMM yyyy HH:mm") - @Model.Location</small>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success text-white py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-check-circle me-2"></i> @Localizer["AssignedSubmissionsHeader"]
                    </h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (Model.Submissions != null && Model.Submissions.Any())
                        {
                            foreach (var sub in Model.Submissions)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                    <div>
                                        <div class="fw-bold">@sub.Title</div>
                                        <small class="text-muted">@sub.Author?.FirstName @sub.Author?.LastName</small>
                                    </div>

                                    <form asp-area="Admin"
                                          asp-controller="Session"
                                          asp-action="RemoveSubmission"
                                          asp-route-slug="@slug"
                                          asp-route-conferenceId="@conferenceId"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@Model.Id" />
                                        <input type="hidden" name="submissionId" value="@sub.Id" />

                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="@Localizer["RemoveFromSessionTitle"]">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    </form>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-center text-muted py-5">
                                @Localizer["NoSubmissionInSession"]
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-secondary text-white py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-inbox me-2"></i> @Localizer["PendingAcceptedSubmissionsHeader"]
                    </h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (unassigned != null && unassigned.Any())
                        {
                            foreach (var sub in unassigned)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                    <div>
                                        <div class="fw-bold">@sub.Title</div>
                                        <small class="text-muted">@sub.Author?.FirstName @sub.Author?.LastName</small>
                                    </div>

                                    <form asp-area="Admin"
                                          asp-controller="Session"
                                          asp-action="AddSubmission"
                                          asp-route-slug="@slug"
                                          asp-route-conferenceId="@conferenceId"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@Model.Id" />
                                        <input type="hidden" name="submissionId" value="@sub.Id" />

                                        <button type="submit" class="btn btn-sm btn-success fw-bold">
                                            @Localizer["AddButton"] <i class="fas fa-arrow-left ms-1"></i>
                                        </button>
                                    </form>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-center text-muted py-5">
                                @Localizer["NoUnassignedSubmission"]
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
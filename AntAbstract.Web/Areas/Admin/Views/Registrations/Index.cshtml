@using AntAbstract.Web.Models.ViewModels
@model AdminRegistrationsIndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">@Localizer["PageTitle"]</h3>
            <div class="text-muted">
                @Localizer["ConferenceLabel"] <span class="badge bg-light text-dark border">@Model.ConferenceTitle</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" action="/@slug/Admin/Registrations">
                <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted mb-1">@Localizer["SearchLabel"]</label>
                        <input class="form-control"
                               name="search"
                               value="@Model.Search"
                               placeholder="@Localizer["SearchPlaceholder"]" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">@Localizer["PaymentLabel"]</label>
                        <select class="form-select" name="paid">
                            @if (string.IsNullOrWhiteSpace(Model.Paid))
                            {
                                <option value="" selected="selected">@Localizer["AllOption"]</option>
                            }
                            else
                            {
                                <option value="">@Localizer["AllOption"]</option>
                            }

                            @if (Model.Paid == "Paid")
                            {
                                <option value="Paid" selected="selected">@Localizer["PaidText"]</option>
                            }
                            else
                            {
                                <option value="Paid">@Localizer["PaidText"]</option>
                            }

                            @if (Model.Paid == "Unpaid")
                            {
                                <option value="Unpaid" selected="selected">@Localizer["UnpaidText"]</option>
                            }
                            else
                            {
                                <option value="Unpaid">@Localizer["UnpaidText"]</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">@Localizer["RegistrationTypeLabel"]</label>
                        <select class="form-select" name="registrationTypeId">
                            @if (!Model.RegistrationTypeId.HasValue)
                            {
                                <option value="" selected="selected">@Localizer["AllOption"]</option>
                            }
                            else
                            {
                                <option value="">@Localizer["AllOption"]</option>
                            }

                            @foreach (var t in Model.RegistrationTypes)
                            {
                                if (Model.RegistrationTypeId.HasValue && Model.RegistrationTypeId.Value == t.Id)
                                {
                                    <option value="@t.Id" selected="selected">@t.Name</option>
                                }
                                else
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-1 d-grid">
                        <button class="btn btn-primary" type="submit" title="@Localizer["SearchButton"]">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:140px;">@Localizer["TableHeaderRegistrationDate"]</th>
                        <th>@Localizer["TableHeaderUser"]</th>
                        <th style="width:260px;">@Localizer["TableHeaderEmail"]</th>
                        <th style="width:220px;">@Localizer["TableHeaderRegistrationType"]</th>
                        <th style="width:140px;" class="text-end">@Localizer["TableHeaderAmount"]</th>
                        <th style="width:120px;">@Localizer["TableHeaderPayment"]</th>
                        <th style="width:180px;">@Localizer["TableHeaderAction"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="alert alert-info border-0 m-3">
                                    @Localizer["EmptyMessage"]
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            var detailsUrl = $"/{slug}/Admin/Registrations/Details/{item.Id}?returnUrl={Uri.EscapeDataString(currentUrl)}";

                            <tr>
                                <td>@item.RegistrationDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="fw-semibold">@item.UserFullName</td>
                                <td>@item.UserEmail</td>
                                <td>@item.RegistrationTypeName</td>
                                <td class="text-end">@item.Amount.ToString("N2") @item.Currency</td>
                                <td>
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge bg-success">@Localizer["PaidText"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["UnpaidText"]</span>
                                    }
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-dark dropdown-toggle" data-bs-toggle="dropdown" type="button">
                                            @Localizer["ActionButton"]
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="@detailsUrl">@Localizer["DetailsAction"]</a>
                                            </li>

                                            <li><hr class="dropdown-divider" /></li>

                                            @if (!item.IsPaid)
                                            {
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Registrations/MarkPaid" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button type="submit" class="dropdown-item text-success">@Localizer["MarkPaidAction"]</button>
                                                    </form>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Registrations/MarkUnpaid" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button type="submit" class="dropdown-item text-warning">@Localizer["MarkUnpaidAction"]</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
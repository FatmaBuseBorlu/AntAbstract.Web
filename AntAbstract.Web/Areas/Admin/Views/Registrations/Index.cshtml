@using AntAbstract.Web.Models.ViewModels
@model AdminRegistrationsIndexModel

@{
    ViewData["Title"] = "Kayıtlar ve Ödemeler";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">Kayıtlar ve Ödemeler</h3>
            <div class="text-muted">
                Kongre: <span class="badge bg-light text-dark border">@Model.ConferenceTitle</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" action="/@slug/Admin/Registrations">
                <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted mb-1">Arama</label>
                        <input class="form-control" name="search" value="@Model.Search" placeholder="Ad, soyad, e-posta, kayıt tipi" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">Ödeme</label>
                        <select class="form-select" name="paid">
                            <option value="" @@(string.IsNullOrWhiteSpace(Model.Paid) ? "selected" : "" )>Hepsi</option>
                            <option value="Paid" @@(Model.Paid= ="Paid" ? "selected" : "" )>Ödendi</option>
                            <option value="Unpaid" @@(Model.Paid= ="Unpaid" ? "selected" : "" )>Ödenmedi</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">Kayıt Tipi</label>
                        <select class="form-select" name="registrationTypeId">
                            <option value="" @@(!Model.RegistrationTypeId.HasValue ? "selected" : "" )>Hepsi</option>
                            @foreach (var t in Model.RegistrationTypes)
                            {
                                var isSelected = Model.RegistrationTypeId.HasValue && Model.RegistrationTypeId.Value == t.Id;
                                <option value="@t.Id" @@(isSelected ? "selected" : "" )>@t.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-1 d-grid">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:140px;">Kayıt Tarihi</th>
                        <th>Kullanıcı</th>
                        <th style="width:260px;">E-posta</th>
                        <th style="width:220px;">Kayıt Tipi</th>
                        <th style="width:140px;" class="text-end">Tutar</th>
                        <th style="width:120px;">Ödeme</th>
                        <th style="width:180px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="alert alert-info border-0 m-3">
                                    Bu kongrede kayıt bulunamadı.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            var detailsUrl = $"/{slug}/Admin/Registrations/Details/{item.Id}?returnUrl={Uri.EscapeDataString(currentUrl)}";

                            <tr>
                                <td>@item.RegistrationDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="fw-semibold">@item.UserFullName</td>
                                <td>@item.UserEmail</td>
                                <td>@item.RegistrationTypeName</td>
                                <td class="text-end">@item.Amount.ToString("N2") @item.Currency</td>
                                <td>
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge bg-success">Ödendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ödenmedi</span>
                                    }
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-dark dropdown-toggle" data-bs-toggle="dropdown">
                                            İşlem
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="@detailsUrl">Detay</a>
                                            </li>

                                            <li><hr class="dropdown-divider" /></li>

                                            @if (!item.IsPaid)
                                            {
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Registrations/MarkPaid" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button type="submit" class="dropdown-item text-success">Ödendi yap</button>
                                                    </form>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Registrations/MarkUnpaid" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button type="submit" class="dropdown-item text-warning">Ödenmedi yap</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

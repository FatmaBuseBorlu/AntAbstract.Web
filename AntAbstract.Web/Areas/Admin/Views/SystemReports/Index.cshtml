@using AntAbstract.Web.Models.ViewModels.Admin.Reports
@using System
@using System.Linq
@using System.Collections.Generic

@model SystemReportsIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var recentUsers = Model.RecentUsers ?? new List<RecentUserReportItem>();
    var recentConferences = Model.RecentConferences ?? new List<RecentConferenceReportItem>();
    var conferenceReports = Model.ConferenceSubmissionReports ?? new List<ConferenceSubmissionReportItem>();
    var tenantReports = Model.TenantConferenceReports ?? new List<TenantConferenceReportItem>();

    var maxSubmissionCount = conferenceReports.Any()
        ? Math.Max(1, conferenceReports.Max(x => x.SubmissionCount))
        : 1;

    var maxTenantConferenceCount = tenantReports.Any()
        ? Math.Max(1, tenantReports.Max(x => x.ConferenceCount))
        : 1;

    string BarWidth(int value, int max)
    {
        if (value <= 0 || max <= 0)
        {
            return "0%";
        }

        var percent = (int)Math.Round((value * 100.0) / max);

        if (percent < 8)
        {
            percent = 8;
        }

        return $"{percent}%";
    }

    string Money(decimal amount)
    {
        return amount.ToString("N2") + " ₺";
    }
}

<style>
    .system-reports-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .admin-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .admin-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .admin-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .admin-hero-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .admin-hero-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .admin-hero-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 860px;
    }

    .admin-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .admin-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .admin-hero-btn-light {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .admin-hero-btn-light:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .admin-hero-btn-primary {
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        border: none;
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.18);
    }

    .admin-hero-btn-primary:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.26);
        text-decoration: none;
    }

    .admin-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .admin-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 96px;
        transition: all 0.2s ease;
    }

    .admin-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.075);
    }

    .admin-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .admin-stat-value {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .admin-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.25rem;
        line-height: 1.25;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .stat-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .stat-teal {
        background: rgba(20, 184, 166, 0.12);
        color: #0f766e;
    }

    .stat-red {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
    }

    .stat-yellow {
        background: rgba(234, 179, 8, 0.14);
        color: #ca8a04;
    }

    .admin-report-grid {
        display: grid;
        grid-template-columns: minmax(340px, 0.85fr) minmax(0, 1.65fr);
        gap: 1.25rem;
        margin-bottom: 1.4rem;
    }

    .admin-report-grid-two {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
        margin-bottom: 1.4rem;
    }

    .admin-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
        height: 100%;
    }

    .admin-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .admin-card-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 0.25rem;
    }

    .admin-card-title {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 900;
        margin: 0;
    }

    .admin-card-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .admin-card-body {
        padding: 1.35rem;
    }

    .payment-summary-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.85rem;
        margin-bottom: 1rem;
    }

    .summary-box,
    .revenue-box {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 20px;
        padding: 1rem;
    }

    .summary-box span,
    .revenue-box span {
        display: block;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 900;
        margin-bottom: 0.35rem;
    }

    .summary-box strong {
        color: #0f172a;
        font-size: 1.7rem;
        font-weight: 900;
        line-height: 1;
    }

    .revenue-box strong {
        display: block;
        color: #0f172a;
        font-size: 1.8rem;
        font-weight: 900;
        line-height: 1;
    }

    .revenue-box small {
        display: block;
        color: #94a3b8;
        font-size: 0.76rem;
        font-weight: 700;
        line-height: 1.5;
        margin-top: 0.6rem;
    }

    .bar-report-list,
    .tenant-report-list,
    .recent-list {
        display: grid;
        gap: 0.9rem;
    }

    .bar-report-item,
    .tenant-report-item,
    .recent-list-item,
    .recent-user-card {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 20px;
        padding: 1rem;
        transition: all 0.2s ease;
    }

    .bar-report-item:hover,
    .tenant-report-item:hover,
    .recent-list-item:hover,
    .recent-user-card:hover {
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.055);
        transform: translateY(-1px);
    }

    .bar-report-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .bar-report-top strong,
    .tenant-main strong,
    .recent-content strong,
    .user-info strong {
        display: block;
        color: #0f172a;
        font-weight: 900;
        line-height: 1.35;
    }

    .bar-report-top span,
    .tenant-main span,
    .recent-content span,
    .recent-content small,
    .user-info span,
    .user-info small {
        display: block;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 700;
        margin-top: 0.15rem;
    }

    .bar-report-count {
        min-width: fit-content;
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
        background: rgba(13, 110, 253, 0.08);
        border: 1px solid rgba(13, 110, 253, 0.12);
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
    }

    .bar-track {
        height: 9px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
    }

    .mini-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.7rem;
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
        text-decoration: none;
    }

    .mini-link:hover {
        color: #0b5ed7;
        text-decoration: underline;
    }

    .tenant-main {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 0.85rem;
    }

    .tenant-avatar,
    .sysreport-user-avatar {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 17px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }

    .tenant-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
        margin-bottom: 0.85rem;
    }

    .tenant-stats div {
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid #edf2f7;
        padding: 0.75rem;
    }

    .tenant-stats strong {
        display: block;
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
        line-height: 1;
    }

    .tenant-stats span {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 800;
    }

    .recent-list-item {
        display: grid;
        grid-template-columns: 58px 1fr 42px;
        align-items: center;
        gap: 0.9rem;
    }

    .recent-date-box {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .recent-date-box strong {
        font-size: 1.18rem;
        font-weight: 900;
    }

    .recent-date-box span {
        margin-top: 0.2rem;
        font-size: 0.68rem;
        font-weight: 900;
    }

    .recent-action {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        background: #ffffff;
        border: 1px solid #dbe3ef;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .recent-action:hover {
        background: #0d6efd;
        color: #ffffff;
        text-decoration: none;
    }

    .recent-user-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.9rem;
    }

    .recent-user-card {
        display: grid;
        grid-template-columns: 48px 1fr auto;
        align-items: center;
        gap: 0.85rem;
    }

    .user-info {
        min-width: 0;
    }

    .user-info strong,
    .user-info span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .user-date {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .report-empty-mini {
        min-height: 180px;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #64748b;
        text-align: center;
        padding: 1.5rem;
    }

    .report-empty-mini i {
        color: #0d6efd;
        font-size: 2rem;
        margin-bottom: 0.85rem;
    }

    .report-empty-mini strong {
        color: #0f172a;
        font-weight: 900;
        margin-bottom: 0.25rem;
    }

    .report-empty-mini span {
        font-size: 0.9rem;
        font-weight: 650;
        line-height: 1.55;
    }

    @@media (max-width: 1400px) {
        .admin-stat-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .recent-user-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1200px) {
        .admin-report-grid,
        .admin-report-grid-two {
            grid-template-columns: 1fr;
        }

        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-left {
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .system-reports-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-stat-grid,
        .recent-user-grid,
        .payment-summary-grid {
            grid-template-columns: 1fr;
        }

        .admin-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .recent-user-card {
            grid-template-columns: 48px 1fr;
        }

        .user-date {
            grid-column: 1 / -1;
        }

        .recent-list-item {
            grid-template-columns: 54px 1fr;
        }

        .recent-action {
            grid-column: 1 / -1;
            width: 100%;
        }

        .admin-hero-btn {
            width: 100%;
        }
    }

    [data-theme="dark"] .admin-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.08), transparent 34%),
                    linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-color: #334155;
    }
    [data-theme="dark"] .admin-hero-title { color: #f1f5f9; }
    [data-theme="dark"] .admin-hero-lead { color: #94a3b8; }
    [data-theme="dark"] .admin-hero-kicker { color: #94a3b8; }
    [data-theme="dark"] .admin-hero-btn-light {
        background: #334155; color: #e2e8f0; border-color: #475569;
    }
    [data-theme="dark"] .admin-hero-btn-light:hover { background: #475569; }
    [data-theme="dark"] .admin-stat-card {
        background: #1e293b; border-color: #334155;
    }
    [data-theme="dark"] .admin-stat-label { color: #94a3b8; }
    [data-theme="dark"] .admin-stat-value { color: #f1f5f9; }
    [data-theme="dark"] .admin-card {
        background: #1e293b; border-color: #334155;
    }
    [data-theme="dark"] .admin-card-header {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        border-color: #334155;
    }
    [data-theme="dark"] .admin-card-title { color: #f1f5f9; }
    [data-theme="dark"] .admin-card-kicker { color: #94a3b8; }
    [data-theme="dark"] .admin-card-body { color: #cbd5e1; }
    [data-theme="dark"] .bar-report-item {
        background: #0f172a; border-color: #334155;
    }
    [data-theme="dark"] .bar-report-item h6 { color: #f1f5f9; }
    [data-theme="dark"] .bar-report-item small { color: #94a3b8; }
    [data-theme="dark"] .bar-report-count { color: #38bdf8; }
    [data-theme="dark"] .bar-track { background: #334155; }
    [data-theme="dark"] .mini-link { color: #38bdf8; }
    [data-theme="dark"] .tenant-report-item {
        background: #0f172a; border-color: #334155;
    }
    [data-theme="dark"] .tenant-main h6 { color: #f1f5f9; }
    [data-theme="dark"] .tenant-main small { color: #64748b; }
    [data-theme="dark"] .tenant-stats { color: #94a3b8; }
    [data-theme="dark"] .tenant-stats div {
        background: #1e293b; border-color: #334155;
    }
    [data-theme="dark"] .tenant-stats strong { color: #f1f5f9; }
    [data-theme="dark"] .tenant-stats span { color: #94a3b8; }
    [data-theme="dark"] .recent-list-item {
        background: #0f172a; border-color: #334155;
    }
    [data-theme="dark"] .recent-content h6 { color: #f1f5f9; }
    [data-theme="dark"] .recent-content small { color: #94a3b8; }
    [data-theme="dark"] .recent-date-box { background: #334155; color: #e2e8f0; }
    [data-theme="dark"] .recent-action { color: #38bdf8; }
    [data-theme="dark"] .summary-box,
    [data-theme="dark"] .revenue-box {
        background: #0f172a; border-color: #334155;
    }
    [data-theme="dark"] .summary-box strong,
    [data-theme="dark"] .revenue-box strong { color: #f1f5f9; }
    [data-theme="dark"] .summary-box span,
    [data-theme="dark"] .revenue-box span { color: #94a3b8; }
    [data-theme="dark"] .summary-box small,
    [data-theme="dark"] .revenue-box small { color: #64748b; }
    [data-theme="dark"] .payment-summary-grid { color: #cbd5e1; }
    [data-theme="dark"] .recent-user-card {
        background: #0f172a; border-color: #334155;
    }
    [data-theme="dark"] .user-info strong { color: #f1f5f9; }
    [data-theme="dark"] .user-info small,
    [data-theme="dark"] .user-date { color: #94a3b8; }
    [data-theme="dark"] .report-empty-mini { color: #64748b; }
</style>

<div class="system-reports-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    @Localizer["SuperAdminPanel"]
                </div>

                <h3 class="admin-hero-title">
                    
                </h3>

                <p class="admin-hero-lead">
                    @Localizer["PageDescription"]
                </p>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="/Admin"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToPanel"]
            </a>

            <a href="/Admin/SystemReports"
               class="admin-hero-btn admin-hero-btn-primary">
                <i class="fas fa-rotate"></i>
                @Localizer["Refresh"]
            </a>
        </div>
    </div>

    <div class="admin-stat-grid">

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-building"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalInstitutions</div>
                <div class="admin-stat-label">@Localizer["TotalInstitutions"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-calendar-check"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalConferences</div>
                <div class="admin-stat-label">@Localizer["TotalConferences"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-circle-check"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.ActiveConferences</div>
                <div class="admin-stat-label"></div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-purple">
                <i class="fas fa-users"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalUsers</div>
                <div class="admin-stat-label">@Localizer["TotalUsers"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-orange">
                <i class="fas fa-user-shield"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalAdmins</div>
                <div class="admin-stat-label">Admin</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-user-pen"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalAuthors</div>
                <div class="admin-stat-label">@Localizer["Author"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-teal">
                <i class="fas fa-user-check"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalReviewers</div>
                <div class="admin-stat-label">@Localizer["Reviewer"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-red">
                <i class="fas fa-file-lines"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalSubmissions</div>
                <div class="admin-stat-label">@Localizer["TotalSubmissions"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-user-check"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.AssignedSubmissions</div>
                <div class="admin-stat-label">@Localizer["AssignedSubmissions"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-yellow">
                <i class="fas fa-hourglass-half"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.DecisionPendingSubmissions</div>
                <div class="admin-stat-label">@Localizer["DecisionPendingSubmissions"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-gavel"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.DecisionCompletedSubmissions</div>
                <div class="admin-stat-label">@Localizer["DecisionCompletedSubmissions"]</div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-yellow">
                <i class="fas fa-clipboard-list"></i>
            </div>

            <div>
                <div class="admin-stat-value">@Model.TotalRegistrations</div>
                <div class="admin-stat-label"></div>
            </div>
        </div>

    </div>

    <div class="admin-report-grid">

        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <div class="admin-card-kicker">@Localizer["RegistrationAndPayment"]</div>
                    <h5 class="admin-card-title">@Localizer["PaymentSummary"]</h5>
                </div>

                <div class="admin-card-icon stat-green">
                    <i class="fas fa-credit-card"></i>
                </div>
            </div>

            <div class="admin-card-body">
                <div class="payment-summary-grid">
                    <div class="summary-box">
                        <span></span>
                        <strong>@Model.PaidRegistrations</strong>
                    </div>

                    <div class="summary-box">
                        <span>@Localizer["Pending"]</span>
                        <strong>@Model.PendingPayments</strong>
                    </div>
                </div>

                <div class="revenue-box">
                    <span>@Localizer["TotalRevenue"]</span>
                    <strong>@Money(Model.TotalRevenue)</strong>
                    <small>
                        @Localizer["RevenueDescription"]
                    </small>
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <div class="admin-card-kicker">@Localizer["ConferenceAnalysis"]</div>
                    <h5 class="admin-card-title">@Localizer["SubmissionsByConference"]</h5>
                </div>

                <div class="admin-card-icon stat-blue">
                    <i class="fas fa-chart-simple"></i>
                </div>
            </div>

            <div class="admin-card-body">
                @if (!conferenceReports.Any())
                {
                    <div class="report-empty-mini">
                        <i class="fas fa-file-circle-question"></i>
                        <strong>@Localizer["NoSubmissionReport"]</strong>
                        <span>@Localizer["NoSubmissionReportDesc"]</span>
                    </div>
                }
                else
                {
                    <div class="bar-report-list">
                        @foreach (var item in conferenceReports)
                        {
                            var siteUrl = string.IsNullOrWhiteSpace(item.Slug)
                                ? "#"
                                : $"/{item.Slug}";

                            <div class="bar-report-item">
                                <div class="bar-report-top">
                                    <div>
                                        <strong>@item.ConferenceTitle</strong>
                                        <span>@item.TenantName</span>
                                    </div>

                                    <div class="bar-report-count">
                                        @item.SubmissionCount @Localizer["Submission"]
                                    </div>
                                </div>

                                <div class="bar-track">
                                    <div class="bar-fill" style="width:@BarWidth(item.SubmissionCount, maxSubmissionCount)"></div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Slug))
                                {
                                    <a href="@siteUrl" target="_blank" class="mini-link">
                                        <i class="fas fa-arrow-up-right-from-square"></i>
                                        /@item.Slug @Localizer["ViewSite"]
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>

    <div class="admin-report-grid-two">

        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <div class="admin-card-kicker">@Localizer["InstitutionAnalysis"]</div>
                    <h5 class="admin-card-title">@Localizer["ConferencesByInstitution"]</h5>
                </div>

                <div class="admin-card-icon stat-cyan">
                    <i class="fas fa-building-columns"></i>
                </div>
            </div>

            <div class="admin-card-body">
                @if (!tenantReports.Any())
                {
                    <div class="report-empty-mini">
                        <i class="fas fa-building-circle-exclamation"></i>
                        <strong>@Localizer["NoInstitutionReport"]</strong>
                        <span>@Localizer["NoInstitutionReportDesc"]</span>
                    </div>
                }
                else
                {
                    <div class="tenant-report-list">
                        @foreach (var item in tenantReports)
                        {
                            <div class="tenant-report-item">
                                <div class="tenant-main">
                                    <div class="tenant-avatar">
                                        @(string.IsNullOrWhiteSpace(item.TenantName) ? "K" : item.TenantName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <strong>@item.TenantName</strong>
                                        <span>/@item.Slug</span>
                                    </div>
                                </div>

                                <div class="tenant-stats">
                                    <div>
                                        <strong>@item.ConferenceCount</strong>
                                        <span>@Localizer["Conference"]</span>
                                    </div>

                                    <div>
                                        <strong>@item.UserCount</strong>
                                        <span>@Localizer["User"]</span>
                                    </div>
                                </div>

                                <div class="bar-track tenant-track">
                                    <div class="bar-fill" style="width:@BarWidth(item.ConferenceCount, maxTenantConferenceCount)"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <div class="admin-card-kicker">@Localizer["RecentActivity"]</div>
                    <h5 class="admin-card-title">@Localizer["RecentConferences"]</h5>
                </div>

                <div class="admin-card-icon stat-purple">
                    <i class="fas fa-calendar-plus"></i>
                </div>
            </div>

            <div class="admin-card-body">
                @if (!recentConferences.Any())
                {
                    <div class="report-empty-mini">
                        <i class="fas fa-calendar-xmark"></i>
                        <strong>@Localizer["NoConferencesYet"]</strong>
                        <span>@Localizer["NoConferencesDesc"]</span>
                    </div>
                }
                else
                {
                    <div class="recent-list">
                        @foreach (var item in recentConferences)
                        {
                            var siteUrl = string.IsNullOrWhiteSpace(item.Slug)
                                ? "#"
                                : $"/{item.Slug}";

                            <div class="recent-list-item">
                                <div class="recent-date-box">
                                    <strong>@item.StartDate.ToString("dd")</strong>
                                    <span>@item.StartDate.ToString("MMM").ToUpper()</span>
                                </div>

                                <div class="recent-content">
                                    <strong>@item.Title</strong>
                                    <span>@item.TenantName</span>
                                    <small>@item.StartDate.ToString("dd.MM.yyyy") - @item.EndDate.ToString("dd.MM.yyyy")</small>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Slug))
                                {
                                    <a href="@siteUrl" target="_blank" class="recent-action">
                                        <i class="fas fa-arrow-up-right-from-square"></i>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>

    <div class="admin-card">
        <div class="admin-card-header">
            <div>
                <div class="admin-card-kicker">@Localizer["UserActivity"]</div>
                <h5 class="admin-card-title">@Localizer["UserSummary"]</h5>
            </div>

            <div class="admin-card-icon stat-orange">
                <i class="fas fa-user-plus"></i>
            </div>
        </div>

        <div class="admin-card-body">
            @if (!recentUsers.Any())
            {
                <div class="report-empty-mini">
                    <i class="fas fa-user-slash"></i>
                    <strong>@Localizer["NoUsersYet"]</strong>
                    <span>@Localizer["NoUsersDesc"]</span>
                </div>
            }
            else
            {
                <div class="recent-user-grid">
                    @foreach (var user in recentUsers)
                    {
                        <div class="recent-user-card">
                            <div class="sysreport-user-avatar">
                                @(string.IsNullOrWhiteSpace(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                            </div>

                            <div class="user-info">
                                <strong>@user.FullName</strong>
                                <span>@user.Email</span>
                                <small>@user.TenantName</small>
                            </div>

                            <div class="user-date">
                                @(user.CreatedDate.HasValue ? user.CreatedDate.Value.ToString("dd.MM.yyyy") : Localizer.GetString("NoDate").Value)
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>
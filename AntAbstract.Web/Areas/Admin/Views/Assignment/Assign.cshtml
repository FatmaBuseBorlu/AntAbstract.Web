@using AntAbstract.Web.Models.ViewModels.Admin.Assignment
@using Microsoft.AspNetCore.Http
@model AssignReviewerViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var currentSlug = ViewBag.Slug as string
                      ?? ViewContext.RouteData.Values["slug"]?.ToString()
                      ?? Context.Session.GetString("SelectedConferenceSlug")
                      ?? "";

    var conferenceId = ViewBag.ConferenceId is Guid selectedConferenceId
        ? selectedConferenceId
        : Model.Submission.ConferenceId;

    var conferenceTitle = ViewBag.ConferenceTitle as string
                          ?? Model.Submission.Conference?.Title
                          ?? "";

    var backUrl = !string.IsNullOrWhiteSpace(currentSlug)
        ? $"/{currentSlug}/Admin/Assignment?conferenceId={conferenceId}"
        : $"/Admin/Assignment?conferenceId={conferenceId}";

    var flowUrl = !string.IsNullOrWhiteSpace(currentSlug)
        ? $"/{currentSlug}/Admin/ConferenceFlow?conferenceId={conferenceId}"
        : $"/Admin/ConferenceFlow?conferenceId={conferenceId}";

    var assignPostUrl = !string.IsNullOrWhiteSpace(currentSlug)
        ? $"/{currentSlug}/Admin/Assignment/Assign"
        : "/Admin/Assignment/Assign";

    var authorName = Model.Submission.Author != null
        ? $"{Model.Submission.Author.FirstName} {Model.Submission.Author.LastName}".Trim()
        : "";

    if (string.IsNullOrWhiteSpace(authorName))
    {
        authorName = Model.Submission.Author?.Email ?? Localizer["EmptyValue"].Value;
    }

    var recommendedCount = Model.RecommendedReviewers?.Count ?? 0;
    var otherReviewerCount = Model.AllOtherReviewers?.Count ?? 0;
    var totalVisibleReviewerCount = recommendedCount + otherReviewerCount;

    var totalAccessibleReviewerCount = ViewBag.TotalAccessibleReviewerCount is int totalAccessible
        ? totalAccessible
        : totalVisibleReviewerCount;

    var assignableReviewerCount = ViewBag.AssignableReviewerCount is int assignableCount
        ? assignableCount
        : totalVisibleReviewerCount;

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    bool IsAlreadyAssigned(string reviewerId)
    {
        return Model.Submission.ReviewAssignments != null &&
               Model.Submission.ReviewAssignments.Any(x => x.ReviewerId == reviewerId);
    }

    var reviewerLoads = ViewBag.ReviewerLoads as Dictionary<string, int> ?? new Dictionary<string, int>();
    var maxLoad = (int)(ViewBag.MaxAssignmentsPerReviewer ?? 10);

    int GetReviewerLoad(string reviewerId)
        => reviewerLoads.TryGetValue(reviewerId, out var count) ? count : 0;

    bool IsOverloaded(string reviewerId)
        => GetReviewerLoad(reviewerId) >= maxLoad;

    string GetReviewerName(dynamic reviewer)
    {
        var displayName = reviewer.DisplayName as string;
        var email = reviewer.Email as string;

        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        if (!string.IsNullOrWhiteSpace(email))
        {
            return email;
        }

        return L("DefaultReviewerName", "Hakem");
    }

    string GetFirstLetter(string value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? L("DefaultReviewerInitial", "H")
            : value.Trim().Substring(0, 1).ToUpper();
    }
}


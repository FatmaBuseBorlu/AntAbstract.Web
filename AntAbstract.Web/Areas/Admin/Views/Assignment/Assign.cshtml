    }

    .load-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 900;
        color: #475569;
        margin-bottom: 0.3rem;
    }

    .load-bar-track {
        height: 8px;
        border-radius: 999px;
        background: #eef2f7;
        overflow: hidden;
        width: 100%;
    }

    .load-bar-fill {
        height: 100%;
        border-radius: 999px;

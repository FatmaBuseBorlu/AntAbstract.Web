        }

        .assign-hero-actions,
        .assign-hero-actions .btn {
            width: 100%;
        }

        .assign-page-title {
            font-size: 1.65rem;
        }
    }

    @@media (max-width: 768px) {
        .assign-hero-left {
            flex-direction: column;
        }

        .reviewer-table tbody td {
            min-width: 180px;
        }

        .assign-action-btn,
        .already-assigned-badge {
            width: 100%;
        }
    }
</style>

<div class="container-fluid assign-reviewer-page">

    <div class="assign-hero-card">
        <div class="assign-hero-left">
            <div class="assign-hero-icon">
                <i class="fas fa-user-plus"></i>
            </div>

            <div>
                <div class="assign-section-label">
                    @L("SectionLabel", "Kongre Operasyonları")
                </div>

                <h2 class="assign-page-title">
                    @Model.Submission.Title
                </h2>

                <p class="assign-page-description">
                    @L("PageLead", "Bu bildiriye uygun hakemleri seçip değerlendirme sürecini başlatabilirsiniz.")
                </p>

                <div class="info-chip-row">
                    <span class="info-chip">
                        <i class="fas fa-user"></i>
                        @authorName
                    </span>

                    @if (!string.IsNullOrWhiteSpace(conferenceTitle))
                    {
                        <span class="info-chip selected-conference-chip">
                            <i class="fas fa-calendar-check"></i>
                            @conferenceTitle
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(currentSlug))
                    {
                        <span class="info-chip">
                            <i class="fas fa-link"></i>
                            /@currentSlug
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="assign-hero-actions">
            <a href="@flowUrl"
               class="btn assign-light-btn">
                <i class="fas fa-stream"></i>
                @L("BackToFlowButton", "Kongre Akışına Dön")
            </a>

            <a href="@backUrl"
               class="btn assign-outline-btn">
                <i class="fas fa-arrow-left"></i>
                @L("BackButton", "Geri Dön")
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="assign-stat-card">
                <div class="assign-stat-icon blue">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <div class="assign-stat-value">
                        @totalAccessibleReviewerCount
                    </div>

                    <div class="assign-stat-title">
                        @L("StatTotalAccessible", "Toplam Erişilebilir Hakem")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="assign-stat-card">
                <div class="assign-stat-icon green">
                    <i class="fas fa-user-check"></i>
                </div>

                <div>
                    <div class="assign-stat-value">
                        @assignableReviewerCount
                    </div>

                    <div class="assign-stat-title">
                        @L("StatAssignable", "Atanabilir Hakem")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="assign-stat-card">
                <div class="assign-stat-icon orange">
                    <i class="fas fa-star"></i>
                </div>

                <div>
                    <div class="assign-stat-value">
                        @recommendedCount
                    </div>

                    <div class="assign-stat-title">
                        @L("StatRecommended", "Önerilen Hakem")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="keywords-panel">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="keywords-label">
                @L("KeywordsLabel", "Anahtar Kelimeler:")
            </span>

            @if (!string.IsNullOrWhiteSpace(Model.Submission.Keywords))
            {
                var keywords = Model.Submission.Keywords
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                foreach (var keyword in keywords)
                {
                    <span class="keyword-chip">
                        <i class="fas fa-tag"></i>
                        @keyword
                    </span>
                }
            }
            else
            {
                <span class="keyword-chip">
                    <i class="fas fa-minus-circle"></i>
                    @L("EmptyValue", "Belirtilmedi")
                </span>
            }
        </div>
    </div>

    <h5 class="section-heading">
        <i class="fas fa-star icon-warning"></i>
        @L("RecommendedHeader", "Önerilen Hakemler")
    </h5>

    <div class="reviewer-card">
        <div class="reviewer-card-header">
            <div>
                <div class="reviewer-card-title">
                    @L("RecommendedCardTitle", "Önerilen Hakemler")
                </div>

                <p class="reviewer-card-subtitle">
                    @L("RecommendedCardSubtitle", "Bildiri anahtar kelimelerine göre önerilen hakemler burada listelenir.")
                </p>
            </div>

            <span class="reviewer-count-pill">
                @recommendedCount @L("ReviewerCountUnit", "hakem")
            </span>
        </div>

        @if (Model.RecommendedReviewers == null || !Model.RecommendedReviewers.Any())
        {
            <div class="p-3">
                <div class="empty-box">
                    <i class="fas fa-circle-info"></i>
                    <strong>
                        @L("NoRecommendedTitle", "Önerilen hakem bulunamadı")
                    </strong>
                    <span>
                        @L("NoRecommendedMessage", "Bu bildiri için öneri eşleşmesi bulunmadı. Aşağıdaki atanabilir hakemlerden seçim yapabilirsiniz.")
                    </span>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 reviewer-table">
                    <thead>
                        <tr>
                            <th>@L("TableHeaderName", "Hakem")</th>
                            <th>@L("TableHeaderExpertise", "Uzmanlık Alanı")</th>
                            <th>@L("TableHeaderLoad", "Yük")</th>
                            <th class="text-end" style="width: 200px;">
                                @L("TableHeaderAction", "İşlem")
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reviewer in Model.RecommendedReviewers)
                        {
                            var reviewerName = GetReviewerName(reviewer);
                            var firstLetter = GetFirstLetter(reviewerName);
                            var alreadyAssigned = IsAlreadyAssigned(reviewer.Id);
                            var load = GetReviewerLoad(reviewer.Id);
                            var overloaded = IsOverloaded(reviewer.Id);
                            var loadPct = Math.Min(100, (int)Math.Round(load * 100.0 / maxLoad));
                            var loadBarClass = load >= maxLoad ? "load-bar-danger" : load >= maxLoad * 0.7 ? "load-bar-warning" : "load-bar-ok";

                            <tr class="@(overloaded ? "table-warning" : "")">
                                <td>
                                    <div class="reviewer-profile">
                                        <span class="reviewer-avatar">@firstLetter</span>
                                        <div>
                                            <div class="reviewer-name">@reviewerName</div>
                                            <div class="reviewer-email">@reviewer.Email</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="expertise-badge">
                                        <i class="fas fa-brain"></i>
                                        @(string.IsNullOrWhiteSpace(reviewer.ExpertiseAreas) ? L("NoExpertise", "Belirtilmemiş") : reviewer.ExpertiseAreas)
                                    </span>
                                </td>

                                <td>
                                    <div class="load-cell">
                                        <span class="load-label">@load / @maxLoad</span>
                                        <div class="load-bar-track">
                                            <div class="load-bar-fill @loadBarClass" style="width: @(loadPct)%"></div>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-end">
                                    @if (alreadyAssigned)
                                    {
                                        var removePostUrl = !string.IsNullOrWhiteSpace(currentSlug)
                                            ? $"/{currentSlug}/Admin/Assignment/Remove"
                                            : "/Admin/Assignment/Remove";
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <span class="already-assigned-badge">
                                                <i class="fas fa-check"></i>
                                                @L("AlreadyAssignedText", "Atanmış")
                                            </span>
                                            <form action="@removePostUrl" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                                                <input type="hidden" name="reviewerId" value="@reviewer.Id" />
                                                <input type="hidden" name="conferenceId" value="@conferenceId" />
                                                <button type="submit" class="remove-action-btn" title="Hakemi Kaldır"
                                                        onclick="return confirm('')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else if (overloaded)
                                    {
                                        <span class="overloaded-badge">
                                            <i class="fas fa-ban me-1"></i>Limit Dolu
                                        </span>
                                    }
                                    else
                                    {
                                        <form action="@assignPostUrl" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                                            <input type="hidden" name="reviewerId" value="@reviewer.Id" />
                                            <input type="hidden" name="conferenceId" value="@conferenceId" />
                                            <button type="submit" class="assign-action-btn recommended">
                                                <i class="fas fa-user-plus"></i>
                                                @L("AssignRecommendedBtn", "Ata")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <h5 class="section-heading">
        <i class="fas fa-users icon-primary"></i>
        @L("AllReviewersHeader", "Atanabilir Hakemler")
    </h5>

    <div class="reviewer-card">
        <div class="reviewer-card-header">
            <div>
                <div class="reviewer-card-title">
                    Atanabilir Hakemler
                </div>

                <p class="reviewer-card-subtitle">
                    
                </p>
            </div>

            <span class="reviewer-count-pill">
                @otherReviewerCount hakem
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0 reviewer-table">
                <thead>
                    <tr>
                        <th>@L("TableHeaderName", "Hakem")</th>
                        <th>@L("TableHeaderExpertise", "Uzmanlık Alanı")</th>
                        <th>@L("TableHeaderLoad", "Yük")</th>
                        <th class="text-end" style="width: 200px;">
                            @L("TableHeaderAction", "İşlem")
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.AllOtherReviewers == null || !Model.AllOtherReviewers.Any())
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-box">
                                    <i class="fas fa-user-slash"></i>
                                    <strong></strong>
                                    <span> </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var reviewer in Model.AllOtherReviewers)
                        {
                            var reviewerName = GetReviewerName(reviewer);
                            var firstLetter = GetFirstLetter(reviewerName);
                            var alreadyAssigned = IsAlreadyAssigned(reviewer.Id);
                            var load2 = GetReviewerLoad(reviewer.Id);
                            var overloaded2 = IsOverloaded(reviewer.Id);
                            var loadPct2 = Math.Min(100, (int)Math.Round(load2 * 100.0 / maxLoad));
                            var loadBarClass2 = load2 >= maxLoad ? "load-bar-danger" : load2 >= (int)(maxLoad * 0.7) ? "load-bar-warning" : "load-bar-ok";

                            <tr class="@(overloaded2 ? "table-warning" : "")">
                                <td>
                                    <div class="reviewer-profile">
                                        <span class="reviewer-avatar">@firstLetter</span>
                                        <div>
                                            <div class="reviewer-name">@reviewerName</div>
                                            <div class="reviewer-email">@reviewer.Email</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="expertise-badge">
                                        <i class="fas fa-brain"></i>
                                        @(string.IsNullOrWhiteSpace(reviewer.ExpertiseAreas) ? L("NoExpertise", "Belirtilmemiş") : reviewer.ExpertiseAreas)
                                    </span>
                                </td>

                                <td>
                                    <div class="load-cell">
                                        <span class="load-label">@load2 / @maxLoad</span>
                                        <div class="load-bar-track">
                                            <div class="load-bar-fill @loadBarClass2" style="width: @(loadPct2)%"></div>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-end">
                                    @if (alreadyAssigned)
                                    {
                                        var removePostUrl3 = !string.IsNullOrWhiteSpace(currentSlug)
                                            ? $"/{currentSlug}/Admin/Assignment/Remove"
                                            : "/Admin/Assignment/Remove";
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <span class="already-assigned-badge">
                                                <i class="fas fa-check"></i>
                                                @L("AlreadyAssignedText", "Atanmış")
                                            </span>
                                            <form action="@removePostUrl3" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                                                <input type="hidden" name="reviewerId" value="@reviewer.Id" />
                                                <input type="hidden" name="conferenceId" value="@conferenceId" />
                                                <button type="submit" class="remove-action-btn" title="Hakemi Kaldır"
                                                        onclick="return confirm('')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else if (overloaded2)
                                    {
                                        <span class="overloaded-badge">
                                            <i class="fas fa-ban me-1"></i>Limit Dolu
                                        </span>
                                    }
                                    else
                                    {
                                        <form action="@assignPostUrl" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="submissionId" value="@Model.Submission.Id" />
                                            <input type="hidden" name="reviewerId" value="@reviewer.Id" />
                                            <input type="hidden" name="conferenceId" value="@conferenceId" />
                                            <button type="submit" class="assign-action-btn normal">
                                                <i class="fas fa-user-plus"></i>
                                                @L("AssignBtn", "Ata")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('bulkAssignmentForm');

            if (!form) {
                return;
            }

            const checkAll = document.getElementById('bulkCheckAll');
            const checkboxes = Array.from(form.querySelectorAll('.bulk-assignment-checkbox'));
            const selectedCount = document.getElementById('bulkSelectedCount');
            const submitButton = document.getElementById('bulkAssignSubmit');
            const reviewerSelect = form.querySelector('select[name="reviewerId"]');

            function updateBulkState() {
                const count = checkboxes.filter(x => x.checked).length;

                if (selectedCount) {
                    selectedCount.textContent = count.toString();
                }

                if (checkAll) {
                    checkAll.checked = count > 0 && count === checkboxes.length;
                    checkAll.indeterminate = count > 0 && count < checkboxes.length;
                }

                if (submitButton) {
                    submitButton.disabled = count === 0 || !reviewerSelect || !reviewerSelect.value;
                }
            }

            checkAll?.addEventListener('change', () => {
                checkboxes.forEach(checkbox => {
                    checkbox.checked = checkAll.checked;
                });

                updateBulkState();
            });

            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', updateBulkState);
            });

            reviewerSelect?.addEventListener('change', updateBulkState);

            form.addEventListener('submit', (event) => {
                const count = checkboxes.filter(x => x.checked).length;

                if (count === 0 || !reviewerSelect?.value) {
                    event.preventDefault();
                    updateBulkState();
                }
            });

            updateBulkState();
        })();
    </script>
}

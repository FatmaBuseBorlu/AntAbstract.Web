@using AntAbstract.Domain.Entities
@model IEnumerable<Submission>

@{
    ViewData["Title"] = "Hakem Atama";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var submissions = Model?.ToList() ?? new List<Submission>();

    var conferenceId = ViewBag.ConferenceId is Guid vbConferenceId
        ? vbConferenceId
        : Guid.Empty;

    var conferenceTitle = ViewBag.ConferenceTitle as string ?? "";
    var slug = ViewBag.Slug as string ?? "";

    var flowUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow?conferenceId={conferenceId}"
        : $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceId}";

    var changeConferenceUrl = "/Admin/ConferenceFlow?forceSelect=true";

    string GetAuthorName(Submission submission)
    {
        if (submission.Author == null)
        {
            return "Yazar bilgisi yok";
        }

        var fullName = $"{submission.Author.FirstName} {submission.Author.LastName}".Trim();

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return submission.Author.Email ?? "Yazar bilgisi yok";
    }

    string GetAuthorEmail(Submission submission)
    {
        return submission.Author?.Email ?? "";
    }

    string GetAuthorInitial(Submission submission)
    {
        var name = GetAuthorName(submission);

        return string.IsNullOrWhiteSpace(name)
            ? "Y"
            : name.Substring(0, 1).ToUpper();
    }

    string StatusLabel(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "Yeni",
            SubmissionStatus.Pending => "Beklemede",
            SubmissionStatus.UnderReview => "Hakem Sürecinde",
            SubmissionStatus.Accepted => "Kabul Edildi",
            SubmissionStatus.Rejected => "Reddedildi",
            SubmissionStatus.RevisionRequired => "Revizyon Gerekli",
            SubmissionStatus.Presented => "Sunuldu",
            _ => status.ToString()
        };
    }

    string StatusClass(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "status-new",
            SubmissionStatus.Pending => "status-pending",
            SubmissionStatus.UnderReview => "status-review",
            SubmissionStatus.Accepted => "status-accepted",
            SubmissionStatus.Rejected => "status-rejected",
            SubmissionStatus.RevisionRequired => "status-revision",
            SubmissionStatus.Presented => "status-presented",
            _ => "status-default"
        };
    }
}

<div class="container-fluid assignment-page">

    <div class="assignment-hero-card mb-4">
        <div class="assignment-hero-left">
            <div class="assignment-hero-icon">
                <i class="fas fa-user-check"></i>
            </div>

            <div>
                <div class="assignment-section-label">
                    Kongre Operasyonları
                </div>

                <h2 class="assignment-page-title">
                    Özet Atama
                </h2>

                <p class="assignment-page-description">
                    Bu kongredeki bildirileri listeleyin ve hakem atayın.
                </p>

                <div class="selected-conference-pill">
                    <i class="fas fa-calendar-check"></i>

                    <span>Seçili Kongre:</span>

                    <strong>
                        @conferenceTitle
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <em>/@slug</em>
                    }
                </div>
            </div>
        </div>

        <div class="assignment-hero-actions">
            <a href="@changeConferenceUrl"
               class="btn assignment-outline-btn">
                <i class="fas fa-exchange-alt me-2"></i>
                Kongre Değiştir
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="assignment-list-card">
        <div class="assignment-list-header">
            <div>
                <h5>
                    Bildiri Listesi
                </h5>

                <p>
                    Hakem ataması yapılacak bildirileri buradan görüntüleyebilirsiniz.
                </p>
            </div>

            <div class="assignment-count-pill">
                @submissions.Count bildiri
            </div>
        </div>

        @if (!submissions.Any())
        {
            <div class="assignment-empty-state">
                <div class="empty-icon">
                    <i class="fas fa-file-circle-question"></i>
                </div>

                <h4>
                    Henüz bildiri bulunamadı
                </h4>

                <p>
                    Bu kongreye gönderilen bildiriler olduğunda burada listelenecek ve hakem ataması yapılabilecektir.
                </p>

                <a href="@flowUrl" class="btn assignment-light-btn">
                    <i class="fas fa-arrow-left me-2"></i>
                    Kongre Akışına Dön
                </a>
            </div>
        }
        else
        {
            <div class="assignment-table-wrap">
                <table class="assignment-table">
                    <thead>
                        <tr>
                            <th>Başlık</th>
                            <th>Yazar</th>
                            <th>Durum</th>
                            <th>Hakemler</th>
                            <th>Tarih</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var submission in submissions)
                        {
                            var reviewerCount = submission.ReviewAssignments?.Count ?? 0;

                            var assignUrl = string.IsNullOrWhiteSpace(slug)
                            ? $"/Admin/Assignment/Assign/{submission.Id}?conferenceId={conferenceId}"
                            : $"/{slug}/Admin/Assignment/Assign/{submission.Id}?conferenceId={conferenceId}";

                            <tr>
                                <td>
                                    <div class="submission-title-cell">
                                        <strong>
                                            @submission.Title
                                        </strong>

                                        <span>
                                            <i class="fas fa-tag"></i>
                                            @(string.IsNullOrWhiteSpace(submission.Topic) ? "Konu belirtilmedi" : submission.Topic)
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="author-cell">
                                        <div class="author-avatar">
                                            @GetAuthorInitial(submission)
                                        </div>

                                        <div>
                                            <strong>
                                                @GetAuthorName(submission)
                                            </strong>

                                            <span>
                                                @GetAuthorEmail(submission)
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="assignment-status @StatusClass(submission.Status)">
                                        @StatusLabel(submission.Status)
                                    </span>
                                </td>

                                <td>
                                    <span class="reviewer-count-pill">
                                        <i class="fas fa-user-check"></i>
                                        @reviewerCount hakem
                                    </span>
                                </td>

                                <td>
                                    <div class="date-cell">
                                        <strong>
                                            @submission.CreatedDate.ToString("dd MMM yyyy")
                                        </strong>

                                        <span>
                                            @submission.CreatedDate.ToString("HH:mm")
                                        </span>
                                    </div>
                                </td>

                                <td class="text-end">
                                    <a href="@assignUrl"
                                       class="btn assign-reviewer-btn">
                                        <i class="fas fa-user-plus me-2"></i>
                                        Hakem Ata
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<style>
    .assignment-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .assignment-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.15), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .assignment-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .assignment-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .assignment-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .assignment-page-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.05em;
    }

    .assignment-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 600;
        line-height: 1.65;
    }

    .selected-conference-pill {
        width: fit-content;
        margin-top: 0.75rem;
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.10);
        border: 1px solid rgba(0, 174, 239, 0.22);
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
    }

        .selected-conference-pill span {
            color: #0d6efd;
        }

        .selected-conference-pill strong {
            color: #0d6efd;
        }

        .selected-conference-pill em {
            color: #64748b;
            font-style: normal;
            font-weight: 900;
        }

    .assignment-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .assignment-light-btn,
    .assignment-outline-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 0 1.2rem;
        text-decoration: none;
        font-weight: 900;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .assignment-light-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

        .assignment-light-btn:hover {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.28);
            background: #f8fbff;
            transform: translateY(-1px);
        }

    .assignment-outline-btn {
        border: 1px solid #94a3b8;
        background: #ffffff;
        color: #475569;
    }

        .assignment-outline-btn:hover {
            color: #0f172a;
            border-color: #64748b;
            background: #f8fafc;
            transform: translateY(-1px);
        }

    .assignment-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .assignment-list-header {
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .assignment-list-header h5 {
            margin: 0 0 0.25rem;
            color: #0f172a;
            font-size: 1.25rem;
            font-weight: 900;
        }

        .assignment-list-header p {
            margin: 0;
            color: #64748b;
            font-size: 0.9rem;
            font-weight: 600;
        }

    .assignment-count-pill {
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.8rem;
        font-weight: 900;
    }

    .assignment-table-wrap {
        overflow-x: auto;
    }

    .assignment-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .assignment-table thead th {
            padding: 1rem 1.5rem;
            background: #f8fafc;
            color: #64748b;
            font-size: 0.78rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #edf2f7;
            white-space: nowrap;
        }

        .assignment-table tbody td {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #edf2f7;
            vertical-align: middle;
        }

        .assignment-table tbody tr {
            transition: all 0.2s ease;
        }

            .assignment-table tbody tr:hover {
                background: #f8fbff;
            }

            .assignment-table tbody tr:last-child td {
                border-bottom: none;
            }

    .submission-title-cell strong {
        display: block;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 900;
        line-height: 1.35;
    }

    .submission-title-cell span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.35rem;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .author-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .author-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 999px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 900;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.18);
    }

    .author-cell strong {
        display: block;
        color: #0f172a;
        font-size: 0.94rem;
        font-weight: 900;
    }

    .author-cell span {
        display: block;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .assignment-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 0 0.75rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .status-new {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .status-review {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .status-accepted {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .status-rejected {
        background: rgba(239, 68, 68, 0.10);
        color: #ef4444;
    }

    .status-revision {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .status-presented {
        background: rgba(20, 184, 166, 0.12);
        color: #14b8a6;
    }

    .status-default {
        background: #f1f5f9;
        color: #475569;
    }

    .reviewer-count-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 34px;
        padding: 0 0.8rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 900;
        white-space: nowrap;
    }

        .reviewer-count-pill i {
            color: #0d6efd;
        }

    .date-cell strong {
        display: block;
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .date-cell span {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .assign-reviewer-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 999px;
        padding: 0 1.15rem;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-weight: 900;
        white-space: nowrap;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.20);
        transition: all 0.2s ease;
    }

        .assign-reviewer-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 18px 36px rgba(13, 110, 253, 0.26);
        }

    .assignment-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
    }

    .assignment-empty-state h4 {
        color: #0f172a;
        font-size: 1.28rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .assignment-empty-state p {
        color: #64748b;
        font-weight: 600;
        margin: 0 auto 1.25rem;
        max-width: 520px;
        line-height: 1.65;
    }

    @@media (max-width: 992px) {
        .assignment-hero-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .assignment-hero-left {
            align-items: flex-start;
        }

        .assignment-hero-actions,
        .assignment-hero-actions .btn {
            width: 100%;
        }

        .assignment-page-title {
            font-size: 1.65rem;
        }
    }

    @@media (max-width: 768px) {
        .assignment-hero-left {
            flex-direction: column;
        }
    }

    .assignment-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

        .assignment-hero-actions .assignment-light-btn,
        .assignment-hero-actions .assignment-outline-btn {
            min-height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.55rem;
            border-radius: 999px;
            padding: 0 1.35rem;
            font-size: 0.95rem;
            font-weight: 900;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.045);
        }

        .assignment-hero-actions .assignment-light-btn {
            background: #ffffff;
            color: #0f172a;
            border: 1px solid #dbe3ef;
        }

            .assignment-hero-actions .assignment-light-btn:hover {
                color: #0d6efd;
                border-color: rgba(13, 110, 253, 0.32);
                background: #ffffff;
                box-shadow: 0 12px 26px rgba(13, 110, 253, 0.10);
                transform: translateY(-1px);
            }

        .assignment-hero-actions .assignment-outline-btn {
            background: #ffffff;
            color: #334155;
            border: 1px solid #cbd5e1;
        }

            .assignment-hero-actions .assignment-outline-btn:hover {
                color: #0d6efd;
                border-color: rgba(13, 110, 253, 0.32);
                background: #ffffff;
                box-shadow: 0 12px 26px rgba(13, 110, 253, 0.10);
                transform: translateY(-1px);
            }
</style>
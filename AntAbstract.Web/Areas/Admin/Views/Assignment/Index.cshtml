@model IEnumerable<AntAbstract.Domain.Entities.Submission>
@using AntAbstract.Domain.Entities
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewBag.Slug as string
               ?? ViewContext.RouteData.Values["slug"]?.ToString()
               ?? "";

    var conferenceId = ViewBag.ConferenceId as Guid?
                       ?? Guid.Empty;

    var conferenceTitle = ViewBag.ConferenceTitle as string
                          ?? Model?.FirstOrDefault()?.Conference?.Title
                          ?? "";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    string GetStatusText(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => L("Status_New", "Yeni"),
            SubmissionStatus.Pending => L("Status_Pending", "Beklemede"),
            SubmissionStatus.UnderReview => L("Status_UnderReview", "İncelemede"),
            SubmissionStatus.RevisionRequired => L("Status_RevisionRequired", "Revizyon İstendi"),
            SubmissionStatus.Accepted => L("Status_Accepted", "Kabul Edildi"),
            SubmissionStatus.Rejected => L("Status_Rejected", "Reddedildi"),
            SubmissionStatus.Presented => L("Status_Presented", "Sunuldu"),
            _ => status.ToString()
        };
    }

    string GetStatusClass(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "bg-secondary",
            SubmissionStatus.Pending => "bg-warning text-dark",
            SubmissionStatus.UnderReview => "bg-info text-dark",
            SubmissionStatus.RevisionRequired => "bg-primary",
            SubmissionStatus.Accepted => "bg-success",
            SubmissionStatus.Rejected => "bg-danger",
            SubmissionStatus.Presented => "bg-dark",
            _ => "bg-secondary"
        };
    }
}

<style>
    .assignment-page-header {
        background: linear-gradient(135deg, #ffffff, #f8fafc);
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.05);
        margin-bottom: 22px;
    }

    .assignment-title {
        color: #0f172a;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .assignment-lead {
        color: #64748b;
        font-size: 0.95rem;
    }

    .conference-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
        border: 1px solid rgba(0, 174, 239, 0.18);
        border-radius: 999px;
        padding: 8px 14px;
        font-weight: 800;
        font-size: 0.86rem;
        margin-top: 10px;
    }

    .assignment-card {
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    }

    .assignment-table thead th {
        color: #475569;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 900;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 16px;
    }

    .assignment-table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .submission-title {
        color: #0f172a;
        font-weight: 900;
        margin-bottom: 4px;
        line-height: 1.35;
    }

    .submission-meta {
        color: #64748b;
        font-size: 0.84rem;
    }

    .author-box {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .author-avatar {
        width: 38px;
        height: 38px;
        border-radius: 999px;
        background: linear-gradient(135deg, #00aeef, #0284c7);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        flex-shrink: 0;
    }

    .review-count-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 7px 11px;
        font-weight: 800;
        font-size: 0.82rem;
    }

    .assign-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 999px;
        padding: 9px 16px;
        font-weight: 800;
        white-space: nowrap;
        background: linear-gradient(135deg, #00aeef, #0284c7);
        border: none;
        color: #fff;
        text-decoration: none;
        box-shadow: 0 8px 18px rgba(0, 174, 239, 0.22);
    }

        .assign-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(0, 174, 239, 0.32);
        }

    .empty-state {
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 42px;
        text-align: center;
        background: #ffffff;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.05);
    }

        .empty-state i {
            font-size: 2.4rem;
            color: #00aeef;
            margin-bottom: 14px;
        }
</style>

<div class="container-fluid">

    <div class="assignment-page-header">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h4 class="assignment-title">
                    <i class="fas fa-user-check me-2 text-primary"></i>
                    @L("PageTitle", "Hakem Atamaları")
                </h4>

                <div class="assignment-lead">
                    @L("PageLead", "Bu sayfada seçili kongreye ait bildirileri görüntüleyebilir ve hakem ataması yapabilirsiniz.")
                </div>

                @if (!string.IsNullOrWhiteSpace(conferenceTitle))
                {
                    <div class="conference-chip">
                        <i class="fas fa-calendar-check"></i>
                        <span>@L("SelectedConferenceLabel", "Seçili Kongre:")</span>
                        <strong>@conferenceTitle</strong>

                        @if (!string.IsNullOrWhiteSpace(slug))
                        {
                            <span class="text-muted">/@slug</span>
                        }
                    </div>
                }
            </div>

            <div>
                <a href="/Admin/Assignment"
                   class="btn btn-outline-secondary rounded-pill fw-bold px-4">
                    <i class="fas fa-exchange-alt me-2"></i>
                    @L("ChangeConferenceButton", "Kongre Değiştir")
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 shadow-sm">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>

            <h5 class="fw-bold text-dark mb-2">
                @L("EmptyMessageTitle", "Henüz bildiri bulunmuyor")
            </h5>

            <p class="text-muted mb-0">
                @L("EmptyMessage", "Bu kongre için henüz hakem atanabilecek bir bildiri bulunmuyor.")
            </p>
        </div>
    }
    else
    {
        <div class="card assignment-card border-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle assignment-table">
                    <thead>
                        <tr>
                            <th>@L("TableHeaderTitle", "Bildiri")</th>
                            <th>@L("TableHeaderAuthor", "Yazar")</th>
                            <th>@L("TableHeaderStatus", "Durum")</th>
                            <th>@L("TableHeaderReviewers", "Hakemler")</th>
                            <th>@L("TableHeaderDate", "Tarih")</th>
                            <th class="text-end" style="width: 170px;">
                                @L("TableHeaderAction", "İşlem")
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var authorName = item.Author != null
                            ? $"{item.Author.FirstName} {item.Author.LastName}".Trim()
                            : "";

                            if (string.IsNullOrWhiteSpace(authorName))
                            {
                                authorName = item.Author?.Email ?? L("UnknownAuthor", "Bilinmeyen Yazar");
                            }

                            var firstLetter = !string.IsNullOrWhiteSpace(authorName)
                            ? authorName.Substring(0, 1).ToUpper()
                            : "Y";

                            var reviewerCount = item.ReviewAssignments?.Count ?? 0;

                            <tr>
                                <td>
                                    <div class="submission-title">
                                        @item.Title
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Topic))
                                    {
                                        <div class="submission-meta">
                                            <i class="fas fa-tag me-1"></i>
                                            @item.Topic
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="author-box">
                                        <span class="author-avatar">
                                            @firstLetter
                                        </span>

                                        <div>
                                            <div class="fw-bold text-dark">
                                                @authorName
                                            </div>

                                            <div class="small text-muted">
                                                @item.Author?.Email
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge rounded-pill @GetStatusClass(item.Status)">
                                        @GetStatusText(item.Status)
                                    </span>
                                </td>

                                <td>
                                    <span class="review-count-badge">
                                        <i class="fas fa-user-check"></i>
                                        @reviewerCount
                                        @L("ReviewerCountText", "hakem")
                                    </span>
                                </td>

                                <td>
                                    <div class="fw-bold text-dark">
                                        @item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>

                                    <div class="small text-muted">
                                        @item.CreatedDate.ToLocalTime().ToString("HH:mm")
                                    </div>
                                </td>

                                <td class="text-end">
                                    <a asp-area="Admin"
                                       asp-controller="Assignment"
                                       asp-action="Assign"
                                       asp-route-slug="@slug"
                                       asp-route-id="@item.Id"
                                       asp-route-conferenceId="@conferenceId"
                                       class="assign-btn">
                                        <i class="fas fa-user-plus"></i>
                                        @L("AssignReviewerButton", "Hakem Ata")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
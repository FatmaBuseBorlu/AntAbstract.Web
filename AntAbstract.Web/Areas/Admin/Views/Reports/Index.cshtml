@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Web.Models.ViewModels.Admin.Reports
@model ReportsIndexViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? Context.GetRouteValue("slug")?.ToString() ?? "";
    var returnUrl = string.IsNullOrWhiteSpace(slug) ? "/Admin/Reports" : $"/{slug}/Admin/Reports";

    var changeConferenceUrl = $"/Admin/Reports?returnUrl={Uri.EscapeDataString(returnUrl)}";
    var excelUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/Excel?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/Excel?conferenceId={Model.ConferenceId}";

    var pdfUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/Pdf?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/Pdf?conferenceId={Model.ConferenceId}";

    var refereeReportUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/Referees?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/Referees?conferenceId={Model.ConferenceId}";

    var participantsExportUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/ParticipantsExport?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/ParticipantsExport?conferenceId={Model.ConferenceId}";

    var revenueExportUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/RevenueExport?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/RevenueExport?conferenceId={Model.ConferenceId}";

    var submissionsExportUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/SubmissionsExport?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/SubmissionsExport?conferenceId={Model.ConferenceId}";

    var unregisteredAuthorsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/UnregisteredAuthors?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/UnregisteredAuthors?conferenceId={Model.ConferenceId}";

    var surveyResultsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/SurveyResults?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/SurveyResults?conferenceId={Model.ConferenceId}";

    int decidedCount = Model.AcceptedCount + Model.RejectedCount + Model.RevisionRequiredCount;
    int totalForBar = Model.TotalSubmissions > 0 ? Model.TotalSubmissions : 1;
    int acceptedPct = (int)Math.Round(Model.AcceptedCount * 100.0 / totalForBar);
    int rejectedPct = (int)Math.Round(Model.RejectedCount * 100.0 / totalForBar);
    int reviewPct   = (int)Math.Round(Model.UnderReviewCount * 100.0 / totalForBar);
    int newPct      = (int)Math.Round(Model.NewCount * 100.0 / totalForBar);
    int revisionPct = (int)Math.Round(Model.RevisionRequiredCount * 100.0 / totalForBar);
}

<div class="reports-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert reports-alert reports-alert-success mb-4">
            <i class="fas fa-check-circle"></i>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert reports-alert reports-alert-error mb-4">
            <i class="fas fa-times-circle"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    @* Hero header *@
    <div class="reports-hero-card mb-4">
        <div class="reports-hero-left">
            <div class="reports-hero-icon">
                <i class="fas fa-chart-bar"></i>
            </div>
            <div>
                <h1 class="reports-hero-title">Raporlar</h1>
                <p class="reports-hero-sub">@Model.ConferenceTitle</p>
            </div>
        </div>
        <div class="reports-hero-actions">
            <a href="@excelUrl" class="btn reports-btn-excel">
                <i class="fas fa-file-excel"></i>
                Excel
            </a>
            <a href="@pdfUrl" class="btn reports-btn-pdf">
                <i class="fas fa-file-pdf"></i>
                PDF
            </a>
            <a href="@refereeReportUrl" class="btn reports-btn-ref">
                <i class="fas fa-user-graduate"></i>
                Hakem Raporu
            </a>
            <a href="@unregisteredAuthorsUrl" class="btn btn-warning text-dark">
                <i class="fas fa-user-times"></i>
                Kayıtsız Yazarlar
            </a>
            <a href="@surveyResultsUrl" class="btn btn-info text-white">
                <i class="fas fa-poll-h"></i>
                Anket Sonuçları
            </a>
        </div>
    </div>

    @* Stat row 1: submission stats *@
    <div class="reports-stat-row mb-3">
        <div class="reports-stat-card">
            <div class="reports-stat-icon rsi-blue">
                <i class="fas fa-file-alt"></i>
            </div>
            <div class="reports-stat-body">
                <div class="reports-stat-value">@Model.TotalSubmissions</div>
                <div class="reports-stat-label">Toplam Bildiri</div>
            </div>
        </div>
        <div class="reports-stat-card">
            <div class="reports-stat-icon rsi-green">
                <i class="fas fa-check-double"></i>
            </div>
            <div class="reports-stat-body">
                <div class="reports-stat-value">@Model.AcceptedCount</div>
                <div class="reports-stat-label">Kabul Edilen</div>
            </div>
        </div>
        <div class="reports-stat-card">
            <div class="reports-stat-icon rsi-red">
                <i class="fas fa-times-circle"></i>
            </div>
            <div class="reports-stat-body">
                <div class="reports-stat-value">@Model.RejectedCount</div>
                <div class="reports-stat-label">Reddedilen</div>
            </div>
        </div>
        <div class="reports-stat-card">
            <div class="reports-stat-icon rsi-yellow">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="reports-stat-body">
                <div class="reports-stat-value">@Model.UnderReviewCount</div>
                <div class="reports-stat-label">İncelemede</div>
            </div>
        </div>
        <div class="reports-stat-card">
            <div class="reports-stat-icon rsi-purple">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="reports-stat-body">
                <div class="reports-stat-value">@Model.AssignedSubmissions</div>
                <div class="reports-stat-label">Hakem Atanmış</div>
            </div>
        </div>
        <div class="reports-stat-card">
            <div class="reports-stat-icon rsi-cyan">
                <i class="fas fa-users"></i>
            </div>
            <div class="reports-stat-body">
                <div class="reports-stat-value">@Model.TotalRegistrations</div>
                <div class="reports-stat-label">Kayıt</div>
            </div>
        </div>
        <div class="reports-stat-card">
            <div class="reports-stat-icon rsi-emerald">
                <i class="fas fa-coins"></i>
            </div>
            <div class="reports-stat-body">
                <div class="reports-stat-value">@Model.TotalRevenue.ToString("N0") ₺</div>
                <div class="reports-stat-label">Toplam Gelir</div>
            </div>
        </div>
    </div>

    @* Main content: chart + status breakdown + export *@
    <div class="reports-main-grid">

        @* Doughnut chart card *@
        <div class="reports-content-card reports-chart-card">
            <div class="reports-card-header">
                <i class="fas fa-chart-pie rch-icon-blue"></i>
                <span></span>
            </div>
            <div class="reports-chart-body">
                <canvas id="statusChart"></canvas>
            </div>
        </div>

        @* Status detail card *@
        <div class="reports-content-card">
            <div class="reports-card-header">
                <i class="fas fa-list-ul rch-icon-blue"></i>
                <span></span>
            </div>
            <div class="reports-status-list">
                <div class="status-row">
                    <div class="status-row-left">
                        <span class="status-dot sd-gray"></span>
                        <span class="status-name">Yeni</span>
                    </div>
                    <div class="status-row-right">
                        <div class="status-bar-track">
                            <div class="status-bar-fill sbf-gray" style="width: @(newPct)%"></div>
                        </div>
                        <span class="status-count">@Model.NewCount</span>
                    </div>
                </div>
                <div class="status-row">
                    <div class="status-row-left">
                        <span class="status-dot sd-yellow"></span>
                        <span class="status-name">İncelemede</span>
                    </div>
                    <div class="status-row-right">
                        <div class="status-bar-track">
                            <div class="status-bar-fill sbf-yellow" style="width: @(reviewPct)%"></div>
                        </div>
                        <span class="status-count">@Model.UnderReviewCount</span>
                    </div>
                </div>
                <div class="status-row">
                    <div class="status-row-left">
                        <span class="status-dot sd-green"></span>
                        <span class="status-name">Kabul Edildi</span>
                    </div>
                    <div class="status-row-right">
                        <div class="status-bar-track">
                            <div class="status-bar-fill sbf-green" style="width: @(acceptedPct)%"></div>
                        </div>
                        <span class="status-count">@Model.AcceptedCount</span>
                    </div>
                </div>
                <div class="status-row">
                    <div class="status-row-left">
                        <span class="status-dot sd-red"></span>
                        <span class="status-name">Reddedildi</span>
                    </div>
                    <div class="status-row-right">
                        <div class="status-bar-track">
                            <div class="status-bar-fill sbf-red" style="width: @(rejectedPct)%"></div>
                        </div>
                        <span class="status-count">@Model.RejectedCount</span>
                    </div>
                </div>
                <div class="status-row">
                    <div class="status-row-left">
                        <span class="status-dot sd-orange"></span>
                        <span class="status-name">Revizyon</span>
                    </div>
                    <div class="status-row-right">
                        <div class="status-bar-track">
                            <div class="status-bar-fill sbf-orange" style="width: @(revisionPct)%"></div>
                        </div>
                        <span class="status-count">@Model.RevisionRequiredCount</span>
                    </div>
                </div>
            </div>
        </div>

        @* Finance summary card *@
        <div class="reports-content-card" style="grid-column: 1 / -1;">
            <div class="reports-card-header">
                <i class="fas fa-coins rch-icon-green"></i>
                <span></span>
            </div>
            <div class="p-3">
                <div class="d-flex gap-4 mb-3 flex-wrap">
                    <div>
                        <div class="text-muted small">Toplam Gelir (Ödenen)</div>
                        <div class="fw-bold fs-5 text-success">@Model.TotalRevenue.ToString("N0") @Model.RevenueCurrency</div>
                    </div>
                    <div>
                        <div class="text-muted small">Bekleyen Tutar</div>
                        <div class="fw-bold fs-5 text-warning">@Model.UnpaidRevenue.ToString("N0") @Model.RevenueCurrency</div>
                    </div>
                    <div>
                        <div class="text-muted small">Ödemiş / Bekleyen Kayıt</div>
                        <div class="fw-bold fs-5">@Model.PaidRegistrations / @Model.UnpaidRegistrations</div>
                    </div>
                </div>
                @if (Model.FinanceByCategory.Any())
                {
                    <div style="height: 300px;">
                        <canvas id="financeChart"></canvas>
                    </div>
                }
                else
                {
                    <p class="text-muted">Henüz kayıt verisi bulunmuyor.</p>
                }
            </div>
        </div>

        @* Export card *@
        <div class="reports-content-card reports-export-card">
            <div class="reports-card-header">
                <i class="fas fa-download rch-icon-green"></i>
                <span></span>
            </div>
            <div class="reports-export-body">
                <div class="export-filter-row">
                    <div class="export-filter-group">
                        <label class="export-filter-label"></label>
                        <input type="date" id="exportDateFrom" class="export-filter-input" />
                    </div>
                    <div class="export-filter-group">
                        <label class="export-filter-label"></label>
                        <input type="date" id="exportDateTo" class="export-filter-input" />
                    </div>
                    <div class="export-filter-group">
                        <label class="export-filter-label">Format</label>
                        <select id="exportFormat" class="export-filter-input">
                            <option value="csv">CSV</option>
                            <option value="xlsx">Excel (XLSX)</option>
                        </select>
                    </div>
                </div>

                <noscript>
                    <div class="export-btn-row">
                        <form method="get" action="@participantsExportUrl" class="d-inline">
                            <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />
                            <button type="submit" class="export-action-btn">
                                <i class="fas fa-users"></i> Katılımcılar
                            </button>
                        </form>
                        <form method="get" action="@revenueExportUrl" class="d-inline">
                            <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />
                            <button type="submit" class="export-action-btn">
                                <i class="fas fa-coins"></i> Gelir
                            </button>
                        </form>
                        <form method="get" action="@submissionsExportUrl" class="d-inline">
                            <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />
                            <button type="submit" class="export-action-btn">
                                <i class="fas fa-file-alt"></i> Bildiriler
                            </button>
                        </form>
                    </div>
                </noscript>

                <div class="export-btn-row js-export-buttons">
                    <button type="button" class="export-action-btn" onclick="triggerExport('@participantsExportUrl')">
                        <i class="fas fa-users"></i>
                        Katılımcılar
                    </button>
                    <button type="button" class="export-action-btn" onclick="triggerExport('@revenueExportUrl')">
                        <i class="fas fa-coins"></i>
                        Gelir
                    </button>
                    <button type="button" class="export-action-btn" onclick="triggerExport('@submissionsExportUrl')">
                        <i class="fas fa-file-alt"></i>
                        Bildiriler
                    </button>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .reports-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding: 1.5rem 0 2rem;
    }

    .reports-alert {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 16px;
        border: 1px solid transparent;
        font-weight: 800;
        padding: 0.85rem 1.2rem;
    }

    .reports-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .reports-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    /* Hero */
    .reports-hero-card {
        background: radial-gradient(circle at top right, rgba(0,174,239,0.14), transparent 40%),
                    linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e2eaf4;
        border-radius: 28px;
        padding: 1.55rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 16px 40px rgba(15,23,42,0.06);
    }

    .reports-hero-left {
        display: flex;
        align-items: center;
        gap: 1.1rem;
    }

    .reports-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 20px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        box-shadow: 0 14px 30px rgba(13,110,253,0.22);
    }

    .reports-hero-title {
        font-size: 1.85rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
        line-height: 1.2;
    }

    .reports-hero-sub {
        font-size: 0.88rem;
        color: #64748b;
        font-weight: 650;
        margin: 0.2rem 0 0;
    }

    .reports-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .reports-btn-excel, .reports-btn-pdf, .reports-btn-ref {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.82rem;
        font-weight: 800;
        border: none;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.18s ease;
    }

    .reports-btn-excel {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: #fff;
        box-shadow: 0 8px 18px rgba(34,197,94,0.22);
    }

    .reports-btn-pdf {
        background: linear-gradient(135deg, #dc2626, #ef4444);
        color: #fff;
        box-shadow: 0 8px 18px rgba(239,68,68,0.22);
    }

    .reports-btn-ref {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
        color: #fff;
        box-shadow: 0 8px 18px rgba(168,85,247,0.22);
    }

    .reports-btn-excel:hover, .reports-btn-pdf:hover, .reports-btn-ref:hover {
        transform: translateY(-1px);
        color: #fff;
    }

    /* Stat row */
    .reports-stat-row {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

    .reports-stat-card {
        flex: 1;
        min-width: 130px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 20px;
        padding: 1rem 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 6px 18px rgba(15,23,42,0.05);
    }

    .reports-stat-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .rsi-blue    { background: rgba(13,110,253,0.12); color: #0d6efd; }
    .rsi-green   { background: rgba(34,197,94,0.12);  color: #16a34a; }
    .rsi-red     { background: rgba(239,68,68,0.12);  color: #dc2626; }
    .rsi-yellow  { background: rgba(245,158,11,0.12); color: #b45309; }
    .rsi-purple  { background: rgba(168,85,247,0.12); color: #7c3aed; }
    .rsi-cyan    { background: rgba(6,182,212,0.12);  color: #0891b2; }
    .rsi-emerald { background: rgba(16,185,129,0.12); color: #047857; }

    .reports-stat-value {
        font-size: 1.35rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1.1;
    }

    .reports-stat-label {
        font-size: 0.74rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-top: 0.15rem;
    }

    /* Main grid */
    .reports-main-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
        gap: 1.1rem;
    }

    .reports-content-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15,23,42,0.05);
    }

    .reports-export-card {
        grid-column: 1 / -1;
    }

    .reports-card-header {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.92rem;
        font-weight: 800;
        color: #0f172a;
    }

    .rch-icon-blue  { color: #0d6efd; font-size: 0.95rem; }
    .rch-icon-green { color: #16a34a; font-size: 0.95rem; }

    /* Chart */
    .reports-chart-body {
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 280px;
    }

    #statusChart {
        max-height: 260px;
        max-width: 260px;
    }

    /* Status list */
    .reports-status-list {
        padding: 0.5rem 0;
    }

    .status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 1.4rem;
        gap: 1rem;
        border-bottom: 1px solid #f8fafc;
    }

    .status-row:last-child {
        border-bottom: none;
    }

    .status-row-left {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-width: 110px;
    }

    .status-dot {
        width: 10px;
        height: 10px;
        min-width: 10px;
        border-radius: 50%;
    }

    .sd-gray   { background: #94a3b8; }
    .sd-yellow { background: #f59e0b; }
    .sd-green  { background: #22c55e; }
    .sd-red    { background: #ef4444; }
    .sd-orange { background: #f97316; }

    .status-name {
        font-size: 0.83rem;
        font-weight: 700;
        color: #334155;
    }

    .status-row-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex: 1;
    }

    .status-bar-track {
        flex: 1;
        height: 8px;
        border-radius: 999px;
        background: #f1f5f9;
        overflow: hidden;
    }

    .status-bar-fill {
        height: 100%;
        border-radius: 999px;
        min-width: 4px;
        transition: width 0.6s ease;
    }

    .sbf-gray   { background: #94a3b8; }
    .sbf-yellow { background: #f59e0b; }
    .sbf-green  { background: #22c55e; }
    .sbf-red    { background: #ef4444; }
    .sbf-orange { background: #f97316; }

    .status-count {
        font-size: 0.85rem;
        font-weight: 800;
        color: #0f172a;
        min-width: 30px;
        text-align: right;
    }

    /* Export */
    .reports-export-body {
        padding: 1.25rem 1.4rem 1.4rem;
    }

    .export-filter-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.1rem;
    }

    .export-filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 160px;
    }

    .export-filter-label {
        font-size: 0.76rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .export-filter-input {
        height: 38px;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        padding: 0 0.75rem;
        font-size: 0.83rem;
        font-weight: 650;
        color: #334155;
        background: #f8fafc;
        outline: none;
        transition: border-color 0.18s;
    }

    .export-filter-input:focus {
        border-color: #0d6efd;
        background: #fff;
    }

    .export-btn-row {
        display: flex;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .export-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        height: 40px;
        border-radius: 999px;
        padding: 0 1.15rem;
        font-size: 0.82rem;
        font-weight: 800;
        border: 1.5px solid #e2e8f0;
        background: #f8fafc;
        color: #334155;
        cursor: pointer;
        transition: all 0.18s ease;
    }

    .export-action-btn:hover {
        border-color: #0d6efd;
        color: #0d6efd;
        background: rgba(13,110,253,0.06);
    }

    @@media (max-width: 992px) {
        .reports-main-grid {
            grid-template-columns: 1fr;
        }

        .reports-hero-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .reports-hero-actions {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .reports-stat-row {
            gap: 0.6rem;
        }

        .reports-stat-card {
            min-width: calc(50% - 0.3rem);
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelector('.js-export-buttons').style.display = 'flex';

            var canvas = document.getElementById('statusChart');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['', '', '', '', ''],
                    datasets: [{
                        data: [@Model.NewCount, @Model.UnderReviewCount, @Model.AcceptedCount, @Model.RejectedCount, @Model.RevisionRequiredCount],
                        backgroundColor: ['#94a3b8', '#f59e0b', '#22c55e', '#ef4444', '#f97316'],
                        borderWidth: 0,
                        hoverOffset: 12
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 16, usePointStyle: true, font: { weight: '700', size: 12 } }
                        }
                    }
                }
            });

            var finCanvas = document.getElementById('financeChart');
            if (finCanvas) {
                var finCtx = finCanvas.getContext('2d');
                new Chart(finCtx, {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(",", Model.FinanceByCategory.Select(c => $"'{c.Label}'")))],
                        datasets: [
                            {
                                label: 'Ödenen (@Model.RevenueCurrency)',
                                data: [@Html.Raw(string.Join(",", Model.FinanceByCategory.Select(c => c.PaidAmount.ToString("F0"))))],
                                backgroundColor: '#22c55e',
                                borderRadius: 6
                            },
                            {
                                label: 'Bekleyen (@Model.RevenueCurrency)',
                                data: [@Html.Raw(string.Join(",", Model.FinanceByCategory.Select(c => c.UnpaidAmount.ToString("F0"))))],
                                backgroundColor: '#f59e0b',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { stacked: true, grid: { display: false } },
                            y: { stacked: true, ticks: { callback: function(v) { return v.toLocaleString('tr-TR'); } } }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { usePointStyle: true, font: { weight: '600' } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(ctx) {
                                        return ctx.dataset.label + ': ' + ctx.parsed.y.toLocaleString('tr-TR');
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });

        function triggerExport(baseUrl) {
            const dateFrom = document.getElementById('exportDateFrom').value;
            const dateTo   = document.getElementById('exportDateTo').value;
            const format   = document.getElementById('exportFormat').value;
            const params = new URLSearchParams({ conferenceId: '@Model.ConferenceId' });
            if (dateFrom) params.append('dateFrom', dateFrom);
            if (dateTo)   params.append('dateTo', dateTo);
            if (format)   params.append('format', format);
            window.location.href = baseUrl + (baseUrl.includes('?') ? '&' : '?') + params.toString();
        }
    </script>
}

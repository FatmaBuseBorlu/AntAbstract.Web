@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Web.Models.ViewModels.Admin.Reports
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model ReportsIndexViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? Context.GetRouteValue("slug")?.ToString() ?? "";
    var returnUrl = string.IsNullOrWhiteSpace(slug) ? "/Admin/Reports" : $"/{slug}/Admin/Reports";

    var changeConferenceUrl = $"/Admin/Reports?returnUrl={Uri.EscapeDataString(returnUrl)}";
    var excelUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/Excel?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/Excel?conferenceId={Model.ConferenceId}";

    var pdfUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/Pdf?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/Reports/Pdf?conferenceId={Model.ConferenceId}";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">@Localizer["PageHeading"]</h3>
            <p class="text-muted mb-0">
                @Localizer["ConferenceLabel"]
                <span class="badge bg-light text-dark border">@Model.ConferenceTitle</span>
            </p>
        </div>

        <div class="btn-group shadow-sm">
            <a href="@excelUrl" class="btn btn-success btn-sm">
                <i class="fas fa-file-excel me-1"></i> @Localizer["DownloadExcelButton"]
            </a>
            <a href="@pdfUrl" class="btn btn-danger btn-sm">
                <i class="fas fa-file-pdf me-1"></i> PDF İndir
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <i class="fas fa-times-circle me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body p-4 text-center">
                    <div class="small text-uppercase opacity-75 mb-2">@Localizer["TotalSubmissions"]</div>
                    <div class="display-5 fw-bold">@Model.TotalSubmissions</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body p-4 text-center">
                    <div class="small text-uppercase opacity-75 mb-2">@Localizer["AssignedToReviewer"]</div>
                    <div class="display-5 fw-bold">@Model.AssignedSubmissions</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body p-4 text-center">
                    <div class="small text-uppercase opacity-75 mb-2">@Localizer["DecidedSubmissions"]</div>
                    <div class="display-5 fw-bold">@Model.DecidedSubmissions</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-warning text-dark">
                <div class="card-body p-4 text-center">
                    <div class="small text-uppercase opacity-75 mb-2">@Localizer["TotalAssignments"]</div>
                    <div class="display-5 fw-bold">@Model.TotalAssignments</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 text-center">
                    <div class="small text-uppercase text-muted mb-2">@Localizer["TotalRegistrations"]</div>
                    <div class="display-6 fw-bold">@Model.TotalRegistrations</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 text-center">
                    <div class="small text-uppercase text-muted mb-2">@Localizer["TotalRevenue"]</div>
                    <div class="display-6 fw-bold">@Model.TotalRevenue.ToString("N2") ₺</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h6 class="fw-bold m-0">
                        <i class="fas fa-chart-pie me-2 text-primary"></i> @Localizer["StatusDistributionHeader"]
                    </h6>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 360px;">
                    <canvas id="statusChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h6 class="fw-bold m-0">
                        <i class="fas fa-list me-2 text-primary"></i> @Localizer["DetailedStatusesHeader"]
                    </h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-circle text-primary me-2 small"></i> @Localizer["StatusNewLabel"]</span>
                            <span class="badge bg-primary rounded-pill">@Model.NewCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-circle text-warning me-2 small"></i> @Localizer["StatusUnderReviewLabel"]</span>
                            <span class="badge bg-warning text-dark rounded-pill">@Model.UnderReviewCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-circle text-success me-2 small"></i> @Localizer["StatusAcceptedLabel"]</span>
                            <span class="badge bg-success rounded-pill">@Model.AcceptedCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-circle text-danger me-2 small"></i> @Localizer["StatusRejectedLabel"]</span>
                            <span class="badge bg-danger rounded-pill">@Model.RejectedCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4 border-bottom-0">
                            <span><i class="fas fa-circle text-secondary me-2 small"></i> @Localizer["StatusRevisionLabel"]</span>
                            <span class="badge bg-secondary rounded-pill">@Model.RevisionRequiredCount</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var canvas = document.getElementById('statusChart');
            if (!canvas) return;

            var ctx = canvas.getContext('2d');

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: [
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelNew"].Value)),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelUnderReview"].Value)),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelAccepted"].Value)),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelRejected"].Value)),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ChartLabelRevision"].Value))
                    ],
                    datasets: [{
                        data: [@Model.NewCount, @Model.UnderReviewCount, @Model.AcceptedCount, @Model.RejectedCount, @Model.RevisionRequiredCount],
                        borderWidth: 0,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 20, usePointStyle: true }
                        }
                    }
                }
            });
        });
    </script>
}
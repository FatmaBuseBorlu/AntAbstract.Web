@using AntAbstract.Domain.Entities
@model List<Submission>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var slug = (string)ViewBag.Slug;
    var conference = (Conference)ViewBag.Conference;
    var paidUserIds = (List<string?>)ViewBag.PaidUserIds;
}

<div class="container-fluid py-4">

    <!-- Başlık -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="fas fa-user-times text-warning me-2"></i>Kayıtsız Yazar Bildiri Raporu
            </h4>
            <p class="text-muted mb-0">
                Kabul edilen bildiriler — hiçbir yazarı kongre kaydı &amp; ödeme yapmamış
            </p>
        </div>
        <a href="/@slug/Admin/Reports" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Raporlar
        </a>
    </div>

    <!-- Özet -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="fs-2 fw-bold text-warning">@Model.Count</div>
                <div class="text-muted small">Kayıtsız Bildiri</div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-3">
                <p class="mb-1 text-muted small">
                    <i class="fas fa-info-circle me-1"></i>
                    Bu rapor, durumu <strong>Kabul Edildi</strong> olan ve yazarlarının hiçbiri bu kongreye ücretli kayıt yaptırmamış olan bildirilerini listeler.
                </p>
                <p class="mb-0 text-muted small">
                    Kongre bildiri kitabı veya sertifika üretiminden önce bu listeyi temizlemeniz önerilir.
                </p>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success d-flex align-items-center gap-2 shadow-sm">
            <i class="fas fa-check-circle fa-lg"></i>
            <div>
                <strong>Tüm yazarlar kayıtlı!</strong>
                Kabul edilen tüm bildirimlerin en az bir yazarı ücretli kayıt yaptırmış.
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Bildiri Başlığı</th>
                            <th>Yazarlar</th>
                            <th>Sorumlu Yazar</th>
                            <th>@Localizer["RegistrationStatus"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var s in Model)
                        {
                            i++;
                            var corresponding = s.SubmissionAuthors.FirstOrDefault(a => a.IsCorrespondingAuthor)
                                                ?? s.SubmissionAuthors.OrderBy(a => a.Order).FirstOrDefault();
                            <tr>
                                <td class="text-muted">@i</td>
                                <td>
                                    <span class="fw-semibold">@s.Title</span>
                                </td>
                                <td>
                                    @foreach (var a in s.SubmissionAuthors.OrderBy(a => a.Order))
                                    {
                                        var hasReg = a.AppUserId != null && paidUserIds.Contains(a.AppUserId);
                                        <span class="badge @(hasReg ? "bg-success" : "bg-secondary") me-1 mb-1">
                                            @a.FirstName @a.LastName
                                            @if (hasReg)
                                            {
                                                <i class="fas fa-check ms-1"></i>
                                            }
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (corresponding != null)
                                    {
                                        <div class="small">@corresponding.FirstName @corresponding.LastName</div>
                                        @if (!string.IsNullOrEmpty(corresponding.Email))
                                        {
                                            <a href="mailto:@corresponding.Email" class="text-muted small">@corresponding.Email</a>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-exclamation-triangle me-1"></i>Kayıt Yok
                                    </span>
                                </td>
                                <td>
                                    <a href="/@slug/Admin/Submissions/@s.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

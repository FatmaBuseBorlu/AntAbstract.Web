@model IEnumerable<AntAbstract.Domain.Entities.ConferencePageBlock>
@using AntAbstract.Domain.Entities
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-layer-group"></i> @Localizer["PageHeading"]</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["TableHeaderOrder"]</th>
                        <th>@Localizer["TableHeaderBlockType"]</th>
                        <th>@Localizer["TableHeaderTitle"]</th>
                        <th>@Localizer["TableHeaderStatus"]</th>
                        <th class="text-end">@Localizer["TableHeaderActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var blockTypeText = item.BlockType switch
                        {
                            ConferencePageBlockType.Hero => Localizer["BlockType_Hero"].Value,
                            ConferencePageBlockType.About => Localizer["BlockType_About"].Value,
                            ConferencePageBlockType.CallForPapers => Localizer["BlockType_CallForPapers"].Value,
                            ConferencePageBlockType.Topics => Localizer["BlockType_Topics"].Value,
                            ConferencePageBlockType.Committees => Localizer["BlockType_Committees"].Value,
                            ConferencePageBlockType.Fees => Localizer["BlockType_Fees"].Value,
                            _ => item.BlockType.ToString()
                        };

                        <tr>
                            <td><span class="badge bg-secondary">@item.Order</span></td>
                            <td>
                                <span class="fw-bold text-primary">@blockTypeText</span>
                            </td>
                            <td>@item.Title</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-eye"></i> @Localizer["StatusPublished"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-eye-slash"></i> @Localizer["StatusHidden"]
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/@ViewContext.RouteData.Values["slug"]/Admin/PageBlocks/Edit/@item.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> @Localizer["EditContentButton"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model IEnumerable<AntAbstract.Domain.Entities.ConferencePageBlock>

@{
    ViewData["Title"] = "Vitrin Yönetimi";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-layer-group"></i> Kongre Web Sitesi Vitrin Yönetimi</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sıra</th>
                        <th>Blok Tipi</th>
                        <th>Başlık</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@item.Order</span></td>
                            <td>
                                <span class="fw-bold text-primary">@item.BlockType.ToString()</span>
                            </td>
                            <td>@item.Title</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success"><i class="fas fa-eye"></i> Yayında</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fas fa-eye-slash"></i> Gizli</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/@ViewContext.RouteData.Values["slug"]/Admin/PageBlocks/Edit/@item.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> İçeriği Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
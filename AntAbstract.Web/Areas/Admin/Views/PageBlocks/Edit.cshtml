@model AntAbstract.Domain.Entities.ConferencePageBlock
@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.WebsiteBlocks

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var aboutContent = ViewBag.AboutContent as AboutBlockContent;

    var blockTypeText = Model.BlockType switch
    {
        ConferencePageBlockType.Hero => Localizer["BlockType_Hero"].Value,
        ConferencePageBlockType.About => Localizer["BlockType_About"].Value,
        ConferencePageBlockType.CallForPapers => Localizer["BlockType_CallForPapers"].Value,
        ConferencePageBlockType.Topics => Localizer["BlockType_Topics"].Value,
        ConferencePageBlockType.Committees => Localizer["BlockType_Committees"].Value,
        ConferencePageBlockType.Fees => Localizer["BlockType_Fees"].Value,
        _ => Model.BlockType.ToString()
    };

    ViewData["Title"] = $"{Localizer["PageTitlePrefix"].Value} - {blockTypeText}";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="fas fa-edit"></i> @Localizer["CardTitle", blockTypeText]
            </h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label fw-bold">@Localizer["TitleLabel"]</label>
                        <input asp-for="Title" class="form-control" placeholder="@Localizer["TitlePlaceholder"]" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Subtitle" class="form-label fw-bold">@Localizer["SubtitleLabel"]</label>
                        <input asp-for="Subtitle" class="form-control" placeholder="@Localizer["SubtitlePlaceholder"]" />
                    </div>
                </div>

                <hr class="my-4" />

                @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
                {
                    <h5 class="text-primary mb-3">@Localizer["AboutContentHeader"]</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Localizer["DescriptionLabel"]</label>
                        <textarea name="aboutContent.Description"
                              class="form-control"
                              rows="5"
                              placeholder="@Localizer["DescriptionPlaceholder"]">@aboutContent.Description</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Localizer["ImageUrlLabel"]</label>
                        <input type="text"
                               name="aboutContent.ImageUrl"
                               class="form-control"
                               value="@aboutContent.ImageUrl"
                               placeholder="@Localizer["ImageUrlPlaceholder"]" />
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <label class="form-label fw-bold">@Localizer["FeaturesLabel"]</label>
                            <p class="text-muted small">@Localizer["FeaturesLead"]</p>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted">@Localizer["Feature1Label"]</label>
                            <input type="text"
                                   name="aboutContent.Features[0]"
                                   class="form-control"
                                   value="@(aboutContent.Features.Count > 0 ? aboutContent.Features[0] : "")"
                                   placeholder="@Localizer["Feature1Placeholder"]" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted">@Localizer["Feature2Label"]</label>
                            <input type="text"
                                   name="aboutContent.Features[1]"
                                   class="form-control"
                                   value="@(aboutContent.Features.Count > 1 ? aboutContent.Features[1] : "")"
                                   placeholder="@Localizer["Feature2Placeholder"]" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted">@Localizer["Feature3Label"]</label>
                            <input type="text"
                                   name="aboutContent.Features[2]"
                                   class="form-control"
                                   value="@(aboutContent.Features.Count > 2 ? aboutContent.Features[2] : "")"
                                   placeholder="@Localizer["Feature3Placeholder"]" />
                        </div>
                    </div>
                }

                <hr class="my-4" />

                <div class="mb-4 form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="activeSwitch">
                    <label asp-for="IsActive" class="form-check-label" for="activeSwitch">
                        @Localizer["ShowOnWebsiteLabel"]
                    </label>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="/@ViewContext.RouteData.Values["slug"]/Admin/PageBlocks" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> @Localizer["BackButton"]
                    </a>

                    <button type="submit" class="btn btn-success px-5">
                        <i class="fas fa-save"></i> @Localizer["SaveButton"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
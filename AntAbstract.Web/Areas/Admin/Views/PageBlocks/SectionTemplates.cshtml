        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.16);
    }

    .template-about,
    .template-default {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .template-topics,
    .template-contact {
        background: rgba(22, 163, 74, 0.11);
        color: #15803d;
        border-color: rgba(22, 163, 74, 0.18);
    }

    .template-dates,
    .template-committees {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
        border-color: rgba(245, 158, 11, 0.18);
    }

    .template-fees {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
        border-color: rgba(239, 68, 68, 0.18);
    }

    .template-sponsors {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
        border-color: rgba(124, 58, 237, 0.18);
    }

    .badge-default {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
        border-color: rgba(0, 174, 239, 0.18);
    }

    .badge-custom {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border-color: rgba(34, 197, 94, 0.18);
    }

    .status-passive {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .actions-cell {
        min-width: 230px;
        white-space: nowrap;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        flex-wrap: nowrap;
    }

    .admin-action-btn {
        min-height: 36px;
        border-radius: 12px;
        padding: 0 0.78rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.42rem;
        font-size: 0.78rem;
        font-weight: 950;
        text-decoration: none;
        border: 1px solid transparent;
        background: #ffffff;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .admin-action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.10);
        text-decoration: none;
    }

    .admin-action-edit {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.28);
    }

    .admin-action-edit:hover {
        background: rgba(13, 110, 253, 0.08);
        color: #0b5ed7;
    }

    .admin-action-passive {
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.30);
    }

    .admin-action-passive:hover {
        background: rgba(100, 116, 139, 0.08);
        color: #334155;
    }

    .admin-action-active {
        color: #15803d;
        border-color: rgba(34, 197, 94, 0.26);
    }

    .admin-action-active:hover {
        background: rgba(34, 197, 94, 0.10);
        color: #166534;
    }

    .section-templates-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        color: #64748b;
    }

    .section-templates-empty-icon {
        width: 76px;
        height: 76px;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .section-templates-empty-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        margin-bottom: 0.35rem;
    }

    .section-templates-empty-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    @@media (max-width: 1200px) {
        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .actions-cell {
            min-width: 220px;
        }
    }

    @@media (max-width: 768px) {
        .section-templates-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-stat-grid {
            grid-template-columns: 1fr;
        }

        .section-templates-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-filter-btn,
        .admin-reset-btn,
        .admin-hero-btn,
        .admin-action-btn {
            width: 100%;
        }

        .action-buttons {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

<div class="section-templates-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    @Localizer["GlobalSystem"]
                </div>

                <h3 class="admin-hero-title">
                    @Localizer["SiteSectionTemplates"]
                </h3>

                <p class="admin-hero-lead">
                    @Localizer["PageLead"]
                </p>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="/Admin/CentralVitrin"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-globe"></i>
                @Localizer["GoToSites"]
            </a>

            <a href="/Admin/PageBlocks/Create"
               class="admin-hero-btn admin-hero-btn-primary">
                <i class="fas fa-plus"></i>
                @Localizer["AddNew"]
            </a>
        </div>
    </div>



    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @totalCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["TotalTemplates"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-check-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @activeCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["ActiveTemplates"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-star"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @defaultCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["DefaultStat"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-slate">
                <i class="fas fa-eye-slash"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @passiveCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["PassiveStat"]
                </div>
            </div>
        </div>
    </div>

    <div class="admin-filter-card">
        <form method="get"
              action="/Admin/PageBlocks"
              class="row g-3 align-items-end">

            <div class="col-lg-4">
                <label class="admin-filter-label">
                    @Localizer["Search"]
                </label>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control admin-filter-control"
                       placeholder="@Localizer["SearchPlaceholder"]" />
            </div>

            <div class="col-lg-3">
                <label class="admin-filter-label">
                    @Localizer["Status"]
                </label>

                <select name="status" class="form-select admin-filter-control">
                    @if (string.IsNullOrWhiteSpace(status) || status == "All")
                    {
                        <option value="All" selected>@Localizer["AllStatuses"]</option>
                    }
                    else
                    {
                        <option value="All">@Localizer["AllStatuses"]</option>
                    }

                    @if (status == "Active")
                    {
                        <option value="Active" selected>@Localizer["Active"]</option>
                    }
                    else
                    {
                        <option value="Active">@Localizer["Active"]</option>
                    }

                    @if (status == "Passive")
                    {
                        <option value="Passive" selected>@Localizer["Passive"]</option>
                    }
                    else
                    {
                        <option value="Passive">@Localizer["Passive"]</option>
                    }
                </select>
            </div>

            <div class="col-lg-3">
                <label class="admin-filter-label">
                    @Localizer["TemplateType"]
                </label>

                <select name="defaultFilter" class="form-select admin-filter-control">
                    @if (string.IsNullOrWhiteSpace(defaultFilter) || defaultFilter == "All")
                    {
                        <option value="All" selected>@Localizer["AllTemplates"]</option>
                    }
                    else
                    {
                        <option value="All">@Localizer["AllTemplates"]</option>
                    }

                    @if (defaultFilter == "Default")
                    {
                        <option value="Default" selected>@Localizer["Default"]</option>
                    }
                    else
                    {
                        <option value="Default">@Localizer["Default"]</option>
                    }

                    @if (defaultFilter == "Custom")
                    {
                        <option value="Custom" selected>@Localizer["Custom"]</option>
                    }
                    else
                    {
                        <option value="Custom">@Localizer["Custom"]</option>
                    }
                </select>
            </div>

            <div class="col-lg-2">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="admin-filter-btn flex-fill">
                        <i class="fas fa-search"></i>
                        @Localizer["Filter"]
                    </button>

                    <a href="/Admin/PageBlocks"
                       class="admin-reset-btn"
                       title="@Localizer["ClearFilters"]">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                </div>
            </div>

        </form>
    </div>

    <div class="section-templates-card">
        <div class="section-templates-card-header">
            <div>
                <h5 class="section-templates-card-title">
                    @Localizer["ListTitle"]
                </h5>

                <p class="section-templates-card-subtitle">
                    @Localizer["ListDescription"]
                </p>
            </div>

            <span class="section-templates-card-count">
                <i class="fas fa-list-ul"></i>
                @templates.Count @Localizer["Records"]
            </span>
        </div>

        @if (!templates.Any())
        {
            <div class="section-templates-empty-state">
                <div class="section-templates-empty-icon">
                    <i class="fas fa-layer-group"></i>
                </div>

                <h6 class="section-templates-empty-title">
                    @Localizer["EmptyTitle"]
                </h6>

                <p class="section-templates-empty-text">
                    @Localizer["EmptyDescription"]
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive section-templates-table-responsive">
                <table class="table table-hover align-middle section-template-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 7%;">
                                @Localizer["Order"]
                            </th>

                            <th style="width: 28%;">
                                @Localizer["Template"]
                            </th>

                            <th style="width: 31%;">
                                @Localizer["Description"]
                            </th>

                            <th class="text-center" style="width: 12%;">
                                @Localizer["Status"]
                            </th>

                            <th class="pe-4 text-end" style="width: 22%; min-width: 230px;">
                                @Localizer["Actions"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in templates.OrderBy(x => x.Order))
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="order-badge">
                                        @item.Order
                                    </span>
                                </td>

                                <td>
                                    <div class="template-title-wrap">
                                        <div class="template-icon">
                                            <i class="fas fa-layer-group"></i>
                                        </div>

                                        <div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                <span class="template-name">
                                                    @item.NameTr
                                                </span>

                                                @if (item.IsDefault)
                                                {
                                                    <span class="mini-badge badge-default">
                                                        <i class="fas fa-star"></i>
                                                        @Localizer["Default"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="mini-badge badge-custom">
                                                        @Localizer["Custom"]
                                                    </span>
                                                }
                                            </div>

                                            <div class="template-name-en">
                                                @item.NameEn
                                            </div>

                                            <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                                                <span class="type-badge @GetBlockTypeBadgeClass(item.BlockType)">
                                                    @GetBlockTypeLabel(item.BlockType)
                                                </span>

                                                <span class="small text-muted fw-bold">
                                                    @item.BlockType
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="template-description">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                                    </span>
                                </td>

                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fas fa-check-circle"></i>
                                            @Localizer["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-passive">
                                            <i class="fas fa-eye-slash"></i>
                                            @Localizer["Passive"]
                                        </span>
                                    }
                                </td>

                                <td class="pe-4 text-end actions-cell">
                                    <div class="action-buttons">

                                        <a href="/Admin/PageBlocks/EditTemplate/@item.Id"
                                           class="admin-action-btn admin-action-edit">
                                            <i class="fas fa-pen-to-square"></i>
                                            @Localizer["Edit"]
                                        </a>

                                        <form action="/Admin/PageBlocks/ToggleTemplate/@item.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="admin-action-btn @(item.IsActive ? "admin-action-passive" : "admin-action-active")">
                                                @if (item.IsActive)
                                                {
                                                    <i class="fas fa-eye-slash"></i>
                                                    <span>@Localizer["MakePassive"]</span>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-eye"></i>
                                                    <span>@Localizer["MakeActive"]</span>
                                                }
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
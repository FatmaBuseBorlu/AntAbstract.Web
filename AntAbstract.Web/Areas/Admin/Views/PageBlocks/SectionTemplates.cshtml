        line-height: 1.35;
    }

    .template-name-en {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        margin-top: 0.1rem;
    }

    .template-description {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        line-height: 1.6;
    }

    .type-badge,
    .mini-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .type-badge {
        padding: 0.42rem 0.72rem;
        font-size: 0.75rem;
        font-weight: 900;
    }

    .mini-badge {
        gap: 0.28rem;
        padding: 0.3rem 0.58rem;
        font-size: 0.68rem;
        font-weight: 900;
    }

    .status-badge {
        gap: 0.38rem;
        padding: 0.42rem 0.72rem;
        font-size: 0.76rem;
        font-weight: 950;
    }

    .template-hero,
    .template-call,
    .template-faq {

@model List<AntAbstract.Domain.Entities.SiteSectionTemplate>

@using System
@using System.Linq
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var templates = Model ?? new List<SiteSectionTemplate>();

    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string;
    var defaultFilter = ViewBag.DefaultFilter as string;

    var totalCount = ViewBag.TotalCount ?? templates.Count;
    var activeCount = ViewBag.ActiveCount ?? templates.Count(x => x.IsActive);
    var defaultCount = ViewBag.DefaultCount ?? templates.Count(x => x.IsDefault);
    var passiveCount = ViewBag.PassiveCount ?? templates.Count(x => !x.IsActive);
}

@functions {
    private string GetBlockTypeLabel(ConferencePageBlockType blockType)
    {
        return blockType switch
        {
            ConferencePageBlockType.Hero => Localizer.GetString("TypeHero").Value,
            ConferencePageBlockType.About => Localizer.GetString("TypeAbout").Value,
            ConferencePageBlockType.Topics => Localizer.GetString("TypeTopics").Value,
            ConferencePageBlockType.ImportantDates => Localizer.GetString("TypeDates").Value,
            ConferencePageBlockType.Fees => Localizer.GetString("TypeFees").Value,
            ConferencePageBlockType.Committees => Localizer.GetString("TypeCommittees").Value,
            ConferencePageBlockType.Sponsors => Localizer.GetString("TypeSponsors").Value,
            ConferencePageBlockType.Contact => Localizer.GetString("TypeContact").Value,
            ConferencePageBlockType.FAQ => Localizer.GetString("TypeFAQ").Value,
            ConferencePageBlockType.CallForPapers => Localizer.GetString("TypeCallForPapers").Value,
            _ => blockType.ToString()
        };
    }

    private string GetBlockTypeBadgeClass(ConferencePageBlockType blockType)
    {
        return blockType switch
        {
            ConferencePageBlockType.Hero => "template-hero",
            ConferencePageBlockType.About => "template-about",
            ConferencePageBlockType.Topics => "template-topics",
            ConferencePageBlockType.ImportantDates => "template-dates",
            ConferencePageBlockType.Fees => "template-fees",
            ConferencePageBlockType.Committees => "template-committees",
            ConferencePageBlockType.Sponsors => "template-sponsors",
            ConferencePageBlockType.Contact => "template-contact",
            ConferencePageBlockType.FAQ => "template-faq",
            ConferencePageBlockType.CallForPapers => "template-call",
            _ => "template-default"
        };
    }
}

<style>
    .section-templates-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .admin-hero {

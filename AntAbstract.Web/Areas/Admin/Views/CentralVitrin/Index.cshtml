@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Rendering

@model IEnumerable<Conference>

@{
    ViewData["Title"] = "Kongre Siteleri";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var tenants = ViewBag.Tenants as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    var totalConferenceCount = ViewBag.TotalConferenceCount is int totalCount
        ? totalCount
        : Model?.Count() ?? 0;

    var activeConferenceCount = ViewBag.ActiveConferenceCount is int activeCount
        ? activeCount
        : 0;

    var upcomingConferenceCount = ViewBag.UpcomingConferenceCount is int upcomingCount
        ? upcomingCount
        : 0;

    var completedConferenceCount = ViewBag.CompletedConferenceCount is int completedCount
        ? completedCount
        : 0;

    var now = DateTime.Now;

    string GetStatusText(Conference item)
    {
        if (item.StartDate <= now && item.EndDate >= now)
        {
            return "Devam Eden";
        }

        if (item.EndDate < now)
        {
            return "Tamamlandı";
        }

        return "Yaklaşan";
    }

    string GetStatusClass(Conference item)
    {
        if (item.StartDate <= now && item.EndDate >= now)
        {
            return "site-status-active";
        }

        if (item.EndDate < now)
        {
            return "site-status-completed";
        }

        return "site-status-upcoming";
    }

    string GetInitial(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "S"
            : value.Trim().Substring(0, 1).ToUpper();
    }
}

<style>
    .conference-sites-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .conference-sites-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        margin-bottom: 1.5rem;
    }

    .conference-sites-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .conference-sites-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .conference-sites-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .conference-sites-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
    }

    .conference-sites-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        line-height: 1.65;
        max-width: 850px;
    }

    .conference-sites-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .site-light-btn,
    .site-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0 1.15rem;
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .site-light-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #dbe3ef;
    }

    .site-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .site-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
    }

    .site-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
    }

    .site-stat-card {
        min-height: 96px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
        transition: all 0.2s ease;
    }

    .site-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    .site-stat-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .stat-gray {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
    }

    .site-stat-number {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 950;
        line-height: 1;
    }

    .site-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.3rem;
    }

    .site-filter-card,
    .site-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .site-filter-card {
        padding: 1.25rem;
        margin-bottom: 1.35rem;
    }

    .site-label {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.45rem;
    }

    .site-form-control {
        min-height: 44px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        font-weight: 700;
    }

    .site-form-control:focus {
        border-color: #00aeef;
        box-shadow: 0 0 0 0.18rem rgba(0, 174, 239, 0.12);
    }

    .site-filter-btn,
    .site-reset-btn {
        min-height: 44px;
        border-radius: 14px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
    }

    .site-filter-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }

    .site-filter-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
    }

    .site-reset-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
        min-width: 46px;
    }

    .site-reset-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
    }

    .site-list-header {
        padding: 1.35rem 1.45rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .site-list-header h5 {
        color: #0f172a;
        font-size: 1.18rem;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .site-list-header p {
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.55;
    }

    .site-count-pill {
        padding: 0.44rem 0.82rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .congress-sites-table {
        margin-bottom: 0;
    }

    .congress-sites-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .congress-sites-table tbody td {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .congress-sites-table tbody tr:hover {
        background: #f8fbff;
    }

    .congress-sites-table tbody tr:last-child td {
        border-bottom: none;
    }

    .site-profile {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .site-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 17px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 950;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }

    .site-name {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 950;
        line-height: 1.3;
    }

    .site-subtitle {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 750;
        margin-top: 0.18rem;
    }

    .site-url-pill,
    .tenant-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        padding: 0.42rem 0.72rem;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .site-url-pill {
        color: #0d6efd;
        background: rgba(13, 110, 253, 0.08);
        border-color: rgba(13, 110, 253, 0.14);
    }

    .site-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        border-radius: 999px;
        padding: 0.4rem 0.72rem;
        font-size: 0.76rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .site-status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border: 1px solid rgba(34, 197, 94, 0.18);
    }

    .site-status-upcoming {
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
        border: 1px solid rgba(0, 174, 239, 0.18);
    }

    .site-status-completed {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border: 1px solid rgba(100, 116, 139, 0.18);
    }

    .admin-action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.42rem;
        flex-wrap: nowrap;
    }

    .admin-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.84rem;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid transparent;
        background: #ffffff;
        transition: all 0.2s ease;
        line-height: 1;
        padding: 0;
    }

    .admin-action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.10);
    }

    .admin-action-manage {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.28);
    }

    .admin-action-manage:hover {
        background: rgba(13, 110, 253, 0.08);
        color: #0b5ed7;
    }

    .admin-action-site {
        color: #14b8a6;
        border-color: rgba(20, 184, 166, 0.30);
    }

    .admin-action-site:hover {
        background: rgba(20, 184, 166, 0.10);
        color: #0f766e;
    }

    .admin-action-flow {
        color: #7c3aed;
        border-color: rgba(124, 58, 237, 0.26);
    }

    .admin-action-flow:hover {
        background: rgba(124, 58, 237, 0.08);
        color: #6d28d9;
    }

    .admin-action-tenant {
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.30);
    }

    .admin-action-tenant:hover {
        background: rgba(100, 116, 139, 0.08);
        color: #334155;
    }

    .site-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        color: #64748b;
    }

    .site-empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .site-empty-state h6 {
        color: #0f172a;
        font-size: 1.1rem;
        font-weight: 950;
        margin-bottom: 0.3rem;
    }

    .site-empty-state p {
        margin-bottom: 0;
        font-weight: 650;
    }

    @@media (max-width: 992px) {
        .conference-sites-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .conference-sites-hero-left {
            align-items: flex-start;
        }

        .conference-sites-hero-actions,
        .conference-sites-hero-actions .btn {
            width: 100%;
        }

        .conference-sites-title {
            font-size: 1.65rem;
        }
    }

    @@media (max-width: 768px) {
        .conference-sites-hero-left {
            flex-direction: column;
        }

        .congress-sites-table tbody td {
            min-width: 150px;
        }

        .admin-action-group {
            flex-wrap: wrap;
        }
    }
</style>

<div class="container-fluid conference-sites-page">

    <div class="conference-sites-hero">
        <div class="conference-sites-hero-left">
            <div class="conference-sites-hero-icon">
                <i class="fas fa-globe"></i>
            </div>

            <div>
                <div class="conference-sites-section-label">
                    Global Sistem
                </div>

                <h2 class="conference-sites-title">
                    Kongre Siteleri
                </h2>

                <p class="conference-sites-description">
                    Sistemdeki tüm kongre web sitelerini buradan görüntüleyebilir, site içeriklerini yönetebilir ve kongre operasyon akışına hızlıca geçebilirsiniz.
                </p>
            </div>
        </div>

        <div class="conference-sites-hero-actions">
            <a href="/Admin/AllConferences"
               class="btn site-light-btn">
                <i class="fas fa-calendar-days"></i>
                Tüm Kongrelere Git
            </a>

            <a href="/Admin/SystemReports"
               class="btn site-primary-btn">
                <i class="fas fa-chart-line"></i>
                Sistem Raporları
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="site-stat-card">
                <div class="site-stat-icon stat-blue">
                    <i class="fas fa-globe"></i>
                </div>

                <div>
                    <div class="site-stat-number">
                        @totalConferenceCount
                    </div>

                    <div class="site-stat-label">
                        Toplam Site
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="site-stat-card">
                <div class="site-stat-icon stat-green">
                    <i class="fas fa-play-circle"></i>
                </div>

                <div>
                    <div class="site-stat-number">
                        @activeConferenceCount
                    </div>

                    <div class="site-stat-label">
                        Devam Eden
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="site-stat-card">
                <div class="site-stat-icon stat-cyan">
                    <i class="fas fa-clock"></i>
                </div>

                <div>
                    <div class="site-stat-number">
                        @upcomingConferenceCount
                    </div>

                    <div class="site-stat-label">
                        Yaklaşan
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="site-stat-card">
                <div class="site-stat-icon stat-gray">
                    <i class="fas fa-check-circle"></i>
                </div>

                <div>
                    <div class="site-stat-number">
                        @completedConferenceCount
                    </div>

                    <div class="site-stat-label">
                        Tamamlanan
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="site-filter-card">
        <form method="get"
              asp-area="Admin"
              asp-controller="CentralVitrin"
              asp-action="Index"
              class="row g-3 align-items-end">

            <div class="col-lg-4">
                <label class="site-label">
                    Arama
                </label>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control site-form-control"
                       placeholder="Kongre adı, kurum veya site adresi ara..." />
            </div>

            <div class="col-lg-3">
                <label class="site-label">
                    Kurum
                </label>

                <select name="tenantId" class="form-select site-form-control">
                    <option value="">Tüm Kurumlar</option>

                    @foreach (var tenant in tenants)
                    {
                        if (tenant.Selected)
                        {
                            <option value="@tenant.Value" selected>@tenant.Text</option>
                        }
                        else
                        {
                            <option value="@tenant.Value">@tenant.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-3">
                <label class="site-label">
                    Durum
                </label>

                <select name="status" class="form-select site-form-control">
                    <option value="All" selected="@(string.IsNullOrWhiteSpace(selectedStatus) || selectedStatus == "All")">
                        Tüm Durumlar
                    </option>

                    <option value="Active" selected="@(selectedStatus == "Active")">
                        Devam Eden
                    </option>

                    <option value="Upcoming" selected="@(selectedStatus == "Upcoming")">
                        Yaklaşan
                    </option>

                    <option value="Completed" selected="@(selectedStatus == "Completed")">
                        Tamamlanan
                    </option>
                </select>
            </div>

            <div class="col-lg-2 d-flex gap-2">
                <button type="submit"
                        class="btn site-filter-btn w-100">
                    <i class="fas fa-search"></i>
                    Filtrele
                </button>

                <a href="/Admin/CentralVitrin"
                   class="btn site-reset-btn"
                   title="Filtreleri Temizle">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>

        </form>
    </div>

    <div class="site-list-card">
        <div class="site-list-header">
            <div>
                <h5>
                    Kongre Site Listesi
                </h5>

                <p>
                    Her kongrenin web sitesi içeriklerini buradan yönetebilir, canlı siteyi açabilir veya kongre operasyon akışına geçebilirsiniz.
                </p>
            </div>

            <span class="site-count-pill">
                @(Model?.Count() ?? 0) kayıt
            </span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="site-empty-state">
                <div class="site-empty-icon">
                    <i class="fas fa-globe"></i>
                </div>

                <h6>
                    Kongre sitesi bulunamadı
                </h6>

                <p>
                    Arama veya filtre kriterlerine uygun kongre sitesi bulunamadı.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle congress-sites-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 30%;">
                                Kongre
                            </th>

                            <th style="width: 18%;">
                                Kurum
                            </th>

                            <th style="width: 14%;">
                                Tarih
                            </th>

                            <th style="width: 14%;">
                                Site Adresi
                            </th>

                            <th class="text-center" style="width: 10%;">
                                Durum
                            </th>

                            <th class="text-end pe-4" style="width: 14%; min-width: 170px;">
                                İşlemler
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var tenantName = item.Tenant?.Name ?? "-";
                            var tenantSlug = item.Tenant?.Slug;

                            var statusText = GetStatusText(item);
                            var statusClass = GetStatusClass(item);

                            var hasTenantSlug = !string.IsNullOrWhiteSpace(tenantSlug);

                            var siteUrl = hasTenantSlug
                                ? $"/{tenantSlug}"
                                : "#";

                            var flowUrl = hasTenantSlug
                                ? $"/{tenantSlug}/Admin/ConferenceFlow?conferenceId={item.Id}"
                                : $"/Admin/ConferenceFlow?conferenceId={item.Id}";

                            var tenantUrl = item.TenantId != Guid.Empty
                                ? $"/Admin/Tenants/Details/{item.TenantId}"
                                : "#";

                            <tr>
                                <td class="ps-4">
                                    <div class="site-profile">
                                        <div class="site-avatar">
                                            @GetInitial(item.Title)
                                        </div>

                                        <div>
                                            <div class="site-name">
                                                @item.Title
                                            </div>

                                            <div class="site-subtitle">
                                                Slug:
                                                @(string.IsNullOrWhiteSpace(item.Slug) ? "-" : item.Slug)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="site-name">
                                        @tenantName
                                    </div>

                                    <div class="site-subtitle">
                                        @(string.IsNullOrWhiteSpace(tenantSlug) ? "-" : "/" + tenantSlug)
                                    </div>
                                </td>

                                <td>
                                    <div class="site-name">
                                        @item.StartDate.ToString("dd.MM.yyyy")
                                    </div>

                                    <div class="site-subtitle">
                                        @item.EndDate.ToString("dd.MM.yyyy")
                                    </div>
                                </td>

                                <td>
                                    @if (hasTenantSlug)
                                    {
                                        <span class="site-url-pill">
                                            <i class="fas fa-link"></i>
                                            /@tenantSlug
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fw-bold">
                                            -
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <span class="site-status-badge @statusClass">
                                        <i class="fas fa-circle"></i>
                                        @statusText
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="admin-action-group">

                                        <a asp-area="Admin"
                                           asp-controller="CentralVitrin"
                                           asp-action="ManageBlocks"
                                           asp-route-conferenceId="@item.Id"
                                           class="admin-action-btn admin-action-manage"
                                           title="Site Bölümlerini Yönet">
                                            <i class="fas fa-pen-to-square"></i>
                                        </a>

                                        @if (hasTenantSlug)
                                        {
                                            <a href="@siteUrl"
                                               target="_blank"
                                               class="admin-action-btn admin-action-site"
                                               title="Siteyi Gör">
                                                <i class="fas fa-arrow-up-right-from-square"></i>
                                            </a>
                                        }

                                        <a href="@flowUrl"
                                           class="admin-action-btn admin-action-flow"
                                           title="Kongre Akışına Git">
                                            <i class="fas fa-stream"></i>
                                        </a>

                                        @if (item.TenantId != Guid.Empty)
                                        {
                                            <a href="@tenantUrl"
                                               class="admin-action-btn admin-action-tenant"
                                               title="Kurum Detayı">
                                                <i class="fas fa-building"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
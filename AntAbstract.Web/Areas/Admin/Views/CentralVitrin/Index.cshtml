    }

    .admin-action-site:hover {
        background: rgba(20, 184, 166, 0.10);
        color: #0f766e;
    }

    .admin-action-flow {
        color: #7c3aed;
        border-color: rgba(124, 58, 237, 0.26);
    }

    .admin-action-flow:hover {
        background: rgba(124, 58, 237, 0.08);
        color: #6d28d9;
    }

    .admin-action-tenant {
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.30);
    }

    .admin-action-tenant:hover {
        background: rgba(100, 116, 139, 0.08);
        color: #334155;
    }

    .site-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        color: #64748b;
    }

    .site-empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .site-empty-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        margin-bottom: 0.35rem;
    }

    .site-empty-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    @@media (max-width: 1200px) {
        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .central-vitrin-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-stat-grid {
            grid-template-columns: 1fr;
        }

        .admin-list-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-action-group {
            flex-wrap: wrap;
        }

        .admin-filter-btn,
        .admin-reset-btn {
            width: 100%;
        }
    }
</style>

<div class="central-vitrin-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-globe"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    Global Sistem
                </div>

                <h3 class="admin-hero-title">
                    Kongre Siteleri
                </h3>

                <p class="admin-hero-lead">
                    Sistemdeki tüm kongre web sitelerini buradan görüntüleyebilir, site içeriklerini yönetebilir ve kongre operasyon akışına hızlıca geçebilirsiniz.
                </p>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="/Admin/AllConferences"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-calendar-days"></i>
                Tüm Kongrelere Git
            </a>

            <a href="/Admin/SystemReports"
               class="admin-hero-btn admin-hero-btn-primary">
                <i class="fas fa-chart-line"></i>
                Sistem Raporları
            </a>
        </div>
    </div>

    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-globe"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @totalConferenceCount
                </div>

                <div class="admin-stat-label">
                    Toplam Site
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-play-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @activeConferenceCount
                </div>

                <div class="admin-stat-label">
                    Devam Eden
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-clock"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @upcomingConferenceCount
                </div>

                <div class="admin-stat-label">
                    Yaklaşan
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-slate">
                <i class="fas fa-check-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @completedConferenceCount
                </div>

                <div class="admin-stat-label">
                    Tamamlanan
                </div>
            </div>
        </div>
    </div>

    <div class="admin-filter-card">
        <form method="get"
              asp-area="Admin"
              asp-controller="CentralVitrin"
              asp-action="Index"
              class="row g-3 align-items-end">

            <div class="col-lg-4">
                <label class="admin-filter-label">
                    Arama
                </label>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control admin-filter-control"
                       placeholder="Kongre adı, kurum veya site adresi ara..." />
            </div>

            <div class="col-lg-3">
                <label class="admin-filter-label">
                    Kurum
                </label>

                <select name="tenantId" class="form-select admin-filter-control">
                    <option value="">Tüm Kurumlar</option>

                    @foreach (var tenant in tenants)
                    {
                        if (tenant.Selected)
                        {
                            <option value="@tenant.Value" selected>@tenant.Text</option>
                        }
                        else
                        {
                            <option value="@tenant.Value">@tenant.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-3">
                <label class="admin-filter-label">
                    Durum
                </label>

                <select name="status" class="form-select admin-filter-control">
                    @if (string.IsNullOrWhiteSpace(selectedStatus) || selectedStatus == "All")
                    {
                        <option value="All" selected>Tüm Durumlar</option>
                    }
                    else
                    {
                        <option value="All">Tüm Durumlar</option>
                    }

                    @if (selectedStatus == "Active")
                    {
                        <option value="Active" selected>Devam Eden</option>
                    }
                    else
                    {
                        <option value="Active">Devam Eden</option>
                    }

                    @if (selectedStatus == "Upcoming")
                    {
                        <option value="Upcoming" selected>Yaklaşan</option>
                    }
                    else
                    {
                        <option value="Upcoming">Yaklaşan</option>
                    }

                    @if (selectedStatus == "Completed")
                    {
                        <option value="Completed" selected>Tamamlanan</option>
                    }
                    else
                    {
                        <option value="Completed">Tamamlanan</option>
                    }
                </select>
            </div>

            <div class="col-lg-2">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="admin-filter-btn flex-fill">
                        <i class="fas fa-search"></i>
                        Filtrele
                    </button>

                    <a href="/Admin/CentralVitrin"
                       class="admin-reset-btn"
                       title="Filtreleri Temizle">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                </div>
            </div>

        </form>
    </div>

    <div class="admin-list-card">
        <div class="admin-list-card-header">
            <div>
                <h5 class="admin-list-card-title">
                    Kongre Site Listesi
                </h5>

                <p class="admin-list-card-subtitle">
                    Her kongrenin web sitesi içeriklerini buradan yönetebilir, canlı siteyi açabilir veya kongre operasyon akışına geçebilirsiniz.
                </p>
            </div>

            <span class="admin-list-count">
                <i class="fas fa-list-ul"></i>
                @conferences.Count kayıt
            </span>
        </div>

        @if (!conferences.Any())
        {
            <div class="site-empty-state">
                <div class="site-empty-icon">
                    <i class="fas fa-globe"></i>
                </div>

                <h6 class="site-empty-title">
                    Kongre sitesi bulunamadı
                </h6>

                <p class="site-empty-text">
                    Arama veya filtre kriterlerine uygun kongre sitesi bulunamadı.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive central-vitrin-table-responsive">
                <table class="table table-hover align-middle central-vitrin-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 30%;">
                                Kongre
                            </th>

                            <th style="width: 18%;">
                                Kurum
                            </th>

                            <th style="width: 14%;">
                                Tarih
                            </th>

                            <th style="width: 14%;">
                                Site Adresi
                            </th>

                            <th class="text-center" style="width: 10%;">
                                Durum
                            </th>

                            <th class="text-end pe-4" style="width: 14%; min-width: 170px;">
                                İşlemler
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in conferences)
                        {
                            var tenantName = item.Tenant?.Name ?? "-";
                            var tenantSlug = item.Tenant?.Slug;

                            var statusText = GetStatusText(item);
                            var statusClass = GetStatusClass(item);

                            var hasTenantSlug = !string.IsNullOrWhiteSpace(tenantSlug);

                            var siteUrl = hasTenantSlug
                                ? $"/{tenantSlug}"
                                : "#";

                            var flowUrl = hasTenantSlug
                                ? $"/{tenantSlug}/Admin/ConferenceFlow?conferenceId={item.Id}"
                                : $"/Admin/ConferenceFlow?conferenceId={item.Id}";

                            var tenantUrl = item.TenantId != Guid.Empty
                                ? $"/Admin/Tenants/Details/{item.TenantId}"
                                : "#";

                            <tr>
                                <td class="ps-4">
                                    <div class="site-profile">
                                        <div class="site-avatar">
                                            @GetInitial(item.Title)
                                        </div>

                                        <div>
                                            <div class="site-name">
                                                @item.Title
                                            </div>

                                            <div class="site-subtitle">
                                                Slug:
                                                @(string.IsNullOrWhiteSpace(item.Slug) ? "-" : item.Slug)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="site-name">
                                        @tenantName
                                    </div>

                                    <div class="site-subtitle">
                                        @(string.IsNullOrWhiteSpace(tenantSlug) ? "-" : "/" + tenantSlug)
                                    </div>
                                </td>

                                <td>
                                    <div class="site-name">
                                        @item.StartDate.ToString("dd.MM.yyyy")
                                    </div>

                                    <div class="site-subtitle">
                                        @item.EndDate.ToString("dd.MM.yyyy")
                                    </div>
                                </td>

                                <td>
                                    @if (hasTenantSlug)
                                    {
                                        <span class="site-url-pill">
                                            <i class="fas fa-link"></i>
                                            /@tenantSlug
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fw-bold">
                                            -
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <span class="status-badge @statusClass">
                                        <i class="fas fa-circle"></i>
                                        @statusText
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="admin-action-group">

                                        <a asp-area="Admin"
                                           asp-controller="CentralVitrin"
                                           asp-action="ManageBlocks"
                                           asp-route-conferenceId="@item.Id"
                                           class="admin-action-btn admin-action-manage"
                                           title="Site Bölümlerini Yönet">
                                            <i class="fas fa-pen-to-square"></i>
                                        </a>

                                        @if (hasTenantSlug)
                                        {
                                            <a href="@siteUrl"
                                               target="_blank"
                                               class="admin-action-btn admin-action-site"
                                               title="Siteyi Gör">
                                                <i class="fas fa-arrow-up-right-from-square"></i>
                                            </a>
                                        }

                                        <a href="@flowUrl"
                                           class="admin-action-btn admin-action-flow"
                                           title="Kongre Akışına Git">
                                            <i class="fas fa-stream"></i>
                                        </a>

                                        @if (item.TenantId != Guid.Empty)
                                        {
                                            <a href="@tenantUrl"
                                               class="admin-action-btn admin-action-tenant"
                                               title="Kurum Detayı">
                                                <i class="fas fa-building"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
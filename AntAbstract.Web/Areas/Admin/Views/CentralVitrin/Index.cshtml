@using System
@using System.Linq
@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Rendering

@model IEnumerable<Conference>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var conferences = Model?.ToList() ?? new List<Conference>();

    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var tenants = ViewBag.Tenants as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    var totalConferenceCount = ViewBag.TotalConferenceCount is int totalCount
        ? totalCount
        : conferences.Count;

    var activeConferenceCount = ViewBag.ActiveConferenceCount is int activeCount
        ? activeCount
        : 0;

    var upcomingConferenceCount = ViewBag.UpcomingConferenceCount is int upcomingCount
        ? upcomingCount
        : 0;

    var completedConferenceCount = ViewBag.CompletedConferenceCount is int completedCount
        ? completedCount
        : 0;

    var now = DateTime.Now;

    string GetStatusText(Conference item)
    {
        if (item.StartDate <= now && item.EndDate >= now)
        {
            return "Devam Eden";
        }

        if (item.EndDate < now)
        {
            return "Tamamlandı";
        }

        return "Yaklaşan";
    }

    string GetStatusClass(Conference item)
    {
        if (item.StartDate <= now && item.EndDate >= now)
        {
            return "status-active";
        }

        if (item.EndDate < now)
        {
            return "status-completed";
        }

        return "status-upcoming";
    }

    string GetInitial(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "S"
            : value.Trim().Substring(0, 1).ToUpper();
    }
}

<style>
    .central-vitrin-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .admin-hero {

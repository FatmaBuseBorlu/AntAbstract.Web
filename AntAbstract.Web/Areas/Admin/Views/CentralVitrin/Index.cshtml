        margin-bottom: 0;
    }

    .admin-list-count {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0 0.8rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .central-vitrin-table-responsive {
        overflow-x: auto;
    }

    .central-vitrin-table {
        min-width: 1180px;
        margin-bottom: 0;
    }

    .central-vitrin-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 1rem 1.15rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .central-vitrin-table tbody td {
        padding: 0.95rem 1.15rem;
        border-bottom: 1px solid #edf2f7;

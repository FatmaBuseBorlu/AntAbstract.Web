@model AntAbstract.Domain.Entities.ConferencePageBlock

@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.WebsiteBlocks

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var aboutContent = ViewBag.AboutContent as AboutBlockContent;
    var conferenceName = ViewBag.ConferenceName as string
                         ?? Model.Conference?.Title
                         ?? Localizer.GetString("ConferenceFallback");

    var conferenceSlug = ViewBag.ConferenceSlug as string ?? "";

    var siteUrl = string.IsNullOrWhiteSpace(conferenceSlug)
        ? "#"
        : $"/{conferenceSlug}";

    var flowUrl = string.IsNullOrWhiteSpace(conferenceSlug)
        ? $"/Admin/ConferenceFlow?conferenceId={Model.ConferenceId}"
        : $"/{conferenceSlug}/Admin/ConferenceFlow?conferenceId={Model.ConferenceId}";

    string GetBlockTypeLabel(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => Localizer.GetString("BlockType_Hero"),
            "CallForPapers" => Localizer.GetString("BlockType_CallForPapers"),
            "Topics" => Localizer.GetString("BlockType_Topics"),
            "Committees" => Localizer.GetString("BlockType_Committees"),
            "About" => Localizer.GetString("BlockType_About"),
            "Fees" => Localizer.GetString("BlockType_Fees"),
            _ => value
        };
    }

    string GetBlockTypeClass(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => "block-type-hero",
            "CallForPapers" => "block-type-call",
            "Topics" => "block-type-topics",
            "Committees" => "block-type-committees",
            "About" => "block-type-about",
            "Fees" => "block-type-fees",
            _ => "block-type-default"
        };
    }

    string GetBlockIcon(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => "fas fa-house-chimney",
            "CallForPapers" => "fas fa-bullhorn",
            "Topics" => "fas fa-tags",
            "Committees" => "fas fa-users",
            "About" => "fas fa-circle-info",
            "Fees" => "fas fa-credit-card",
            _ => "fas fa-layer-group"
        };
    }

    var blockTypeLabel = GetBlockTypeLabel(Model.BlockType);
    var blockTypeClass = GetBlockTypeClass(Model.BlockType);
    var blockIcon = GetBlockIcon(Model.BlockType);
}

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">

<style>
    .edit-block-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .edit-block-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        margin-bottom: 1.5rem;
    }

    .edit-block-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .edit-block-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .edit-block-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .edit-block-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
    }

    .edit-block-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        line-height: 1.65;
        max-width: 850px;
    }

    .selected-conference-chip {
        width: fit-content;
        margin-top: 0.75rem;
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.10);
        border: 1px solid rgba(0, 174, 239, 0.22);
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .selected-conference-chip em {
        color: #64748b;
        font-style: normal;
        font-weight: 900;
    }

    .edit-block-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .edit-light-btn,
    .edit-outline-btn,
    .edit-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0 1.15rem;
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .edit-light-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #dbe3ef;
    }

    .edit-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .edit-outline-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .edit-outline-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .edit-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
    }

    .edit-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
    }

    .edit-form-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
        gap: 1.25rem;
        align-items: start;
    }

    .edit-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .edit-card-header {
        padding: 1.25rem 1.35rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        background: #ffffff;
    }

    .edit-card-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 17px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .edit-card-title {
        color: #0f172a;
        font-size: 1.12rem;
        font-weight: 950;
        margin-bottom: 0.18rem;
    }

    .edit-card-subtitle {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.55;
    }

    .edit-card-body {
        padding: 1.35rem;
    }

    .edit-label {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.45rem;
    }

    .edit-form-control {
        min-height: 48px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        font-weight: 700;
    }

    .edit-form-control:focus {
        border-color: #00aeef;
        box-shadow: 0 0 0 0.18rem rgba(0, 174, 239, 0.12);
    }

    .readonly-control {
        background: #f8fafc;
        color: #64748b;
    }

    .content-panel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.2rem;
    }

    .block-type-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        border-radius: 999px;
        padding: 0.42rem 0.72rem;
        font-size: 0.78rem;
        font-weight: 900;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .block-type-hero {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.14);
    }

    .block-type-call {
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
        border-color: rgba(0, 174, 239, 0.18);
    }

    .block-type-topics {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border-color: rgba(34, 197, 94, 0.18);
    }

    .block-type-committees {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
        border-color: rgba(245, 158, 11, 0.18);
    }

    .block-type-about {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .block-type-fees {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
        border-color: rgba(239, 68, 68, 0.16);
    }

    .block-type-default {
        background: rgba(15, 23, 42, 0.08);
        color: #334155;
        border-color: rgba(15, 23, 42, 0.12);
    }

    .status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border-color: rgba(34, 197, 94, 0.18);
    }

    .status-passive {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .publish-box {
        border: 1px solid #e8eef6;
        background: #f8fafc;
        border-radius: 22px;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .publish-switch {
        width: 3.1rem;
        height: 1.55rem;
        cursor: pointer;
        box-shadow: none;
    }

    .publish-switch:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .save-btn {
        min-height: 48px;
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        padding: 0 1.4rem;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.18);
        transition: all 0.2s ease;
    }

    .save-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 18px 36px rgba(13, 110, 253, 0.24);
    }

    .side-info-list {
        display: grid;
        gap: 0.85rem;
    }

    .side-info-item {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 18px;
        padding: 0.9rem;
    }

    .side-info-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.35rem;
    }

    .side-info-value {
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 900;
        word-break: break-word;
    }

    .note-editor {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #cbd5e1 !important;
        background-color: #ffffff;
    }

    .note-toolbar {
        background-color: #f8fafc !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }

    .note-editable {
        min-height: 280px;
        color: #0f172a;
        font-weight: 600;
    }

    @@media (max-width: 992px) {
        .edit-block-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .edit-block-hero-left {
            align-items: flex-start;
        }

        .edit-block-hero-actions,
        .edit-block-hero-actions .btn {
            width: 100%;
        }

        .edit-block-title {
            font-size: 1.65rem;
        }

        .edit-form-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .edit-block-hero-left {
            flex-direction: column;
        }

        .publish-box {
            align-items: flex-start;
            flex-direction: column;
        }

        .save-btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid edit-block-page">

    <div class="edit-block-hero">
        <div class="edit-block-hero-left">
            <div class="edit-block-hero-icon">
                <i class="@blockIcon"></i>
            </div>

            <div>
                <div class="edit-block-section-label">
                    @Localizer["ContentManagement"]
                </div>

                <h2 class="edit-block-title">
                    @Localizer["PageTitle"]
                </h2>

                <p class="edit-block-description">
                    @Html.Raw(string.Format(Localizer.GetString("HeroDescription"), $"<strong>{Model.Title}</strong>"))
                </p>

                <div class="selected-conference-chip">
                    <i class="fas fa-calendar-check"></i>
                    <span>@Localizer["SelectedConference"]</span>
                    <strong>@conferenceName</strong>

                    @if (!string.IsNullOrWhiteSpace(conferenceSlug))
                    {
                        <em>/@conferenceSlug</em>
                    }
                </div>
            </div>
        </div>

        <div class="edit-block-hero-actions">
            <a asp-area="Admin"
               asp-controller="CentralVitrin"
               asp-action="ManageBlocks"
               asp-route-conferenceId="@Model.ConferenceId"
               class="btn edit-light-btn">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToBlockList"]
            </a>

            @if (!string.IsNullOrWhiteSpace(conferenceSlug))
            {
                <a href="@siteUrl"
                   target="_blank"
                   class="btn edit-outline-btn">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    @Localizer["ViewSite"]
                </a>
            }

            <a href="@flowUrl"
               class="btn edit-outline-btn">
                <i class="fas fa-stream"></i>
                @Localizer["GoToConferenceFlow"]
            </a>
        </div>
    </div>

    <form asp-area="Admin"
          asp-controller="CentralVitrin"
          asp-action="EditBlock"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ConferenceId" />

        <div class="edit-form-grid">

            <div class="edit-card">
                <div class="edit-card-header">
                    <div class="edit-card-icon">
                        <i class="fas fa-pen-to-square"></i>
                    </div>

                    <div>
                        <div class="edit-card-title">
                            @Localizer["ContentInfo"]
                        </div>

                        <p class="edit-card-subtitle">
                            @Localizer["ContentInfoSubtitle"]
                        </p>
                    </div>
                </div>

                <div class="edit-card-body">

                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <label asp-for="Title" class="edit-label">
                                @Localizer["MenuTitle"]
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Title"
                                   class="form-control edit-form-control"
                                   placeholder="@Localizer["TitlePlaceholder"]"
                                   required />

                            <span asp-validation-for="Title" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="col-md-5">
                            <label class="edit-label">
                                @Localizer["BlockType"]
                            </label>

                            <input type="text"
                                   class="form-control edit-form-control readonly-control"
                                   value="@blockTypeLabel"
                                   readonly />

                            <div class="form-text fw-semibold">
                                @Localizer["BlockTypeSystemNote"]
                            </div>
                        </div>
                    </div>

                    @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
                    {
                        <div class="content-panel mb-4">
                            <div class="d-flex align-items-start gap-3 mb-4">
                                <div class="edit-card-icon">
                                    <i class="fas fa-file-lines"></i>
                                </div>

                                <div>
                                    <div class="edit-card-title">
                                        @Localizer["DetailedContent"]
                                    </div>

                                    <p class="edit-card-subtitle">
                                        @Localizer["DetailedContentSubtitle"]
                                    </p>
                                </div>
                            </div>

                            <label class="edit-label">
                                @Localizer["ContentText"]
                            </label>

                            <textarea id="summernote"
                                      name="aboutContent.Description">@aboutContent.Description</textarea>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <label asp-for="Subtitle" class="edit-label">
                                @Localizer["ShortDescription"]
                            </label>

                            <textarea asp-for="Subtitle"
                                      class="form-control edit-form-control"
                                      rows="7"
                                      placeholder="@Localizer["DescriptionPlaceholder"]"></textarea>

                            <span asp-validation-for="Subtitle" class="text-danger small fw-bold"></span>
                        </div>
                    }

                    <div class="publish-box">
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check form-switch m-0">
                                <input asp-for="IsActive"
                                       class="form-check-input publish-switch"
                                       type="checkbox"
                                       role="switch"
                                       id="activeSwitch" />
                            </div>

                            <div>
                                <label asp-for="IsActive"
                                       class="fw-bold text-dark mb-1"
                                       for="activeSwitch"
                                       style="cursor:pointer;">
                                    @Localizer["ShowOnSite"]
                                </label>

                                <div class="text-muted small fw-semibold">
                                    
                                </div>
                            </div>
                        </div>

                        <button type="submit"
                                class="save-btn">
                            <i class="fas fa-save"></i>
                            @Localizer["SaveChanges"]
                        </button>
                    </div>

                </div>
            </div>

            <div class="edit-card">
                <div class="edit-card-header">
                    <div class="edit-card-icon">
                        <i class="fas fa-circle-info"></i>
                    </div>

                    <div>
                        <div class="edit-card-title">
                            @Localizer["BlockSummary"]
                        </div>

                        <p class="edit-card-subtitle">
                            
                        </p>
                    </div>
                </div>

                <div class="edit-card-body">
                    <div class="side-info-list">

                        <div class="side-info-item">
                            <div class="side-info-label">
                                @Localizer["BlockType"]
                            </div>

                            <div class="side-info-value">
                                <span class="block-type-badge @blockTypeClass">
                                    <i class="@blockIcon"></i>
                                    @blockTypeLabel
                                </span>
                            </div>
                        </div>

                        <div class="side-info-item">
                            <div class="side-info-label">
                                Durum
                            </div>

                            <div class="side-info-value">
                                @if (Model.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        <i class="fas fa-check-circle"></i>
                                        @Localizer["Published"]
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-passive">
                                        <i class="fas fa-eye-slash"></i>
                                        Gizli
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="side-info-item">
                            <div class="side-info-label">
                                Sıra
                            </div>

                            <div class="side-info-value">
                                @Model.Order
                            </div>
                        </div>

                        <div class="side-info-item">
                            <div class="side-info-label">
                                Kongre
                            </div>

                            <div class="side-info-value">
                                @conferenceName
                            </div>
                        </div>

                        <div class="side-info-item">
                            <div class="side-info-label">
                                Blok ID
                            </div>

                            <div class="side-info-value">
                                @Model.Id
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

        <script>
            $(document).ready(function () {
                $('#summernote').summernote({
                    placeholder: 'Vitrin sayfasında gösterilecek detaylı içeriği buraya yazın...',
                    tabsize: 2,
                    height: 300,
                    toolbar: [
                        ['style', ['style']],
                        ['font', ['bold', 'underline', 'clear']],
                        ['color', ['color']],
                        ['para', ['ul', 'ol', 'paragraph']],
                        ['table', ['table']],
                        ['insert', ['link', 'picture']],
                        ['view', ['fullscreen', 'codeview', 'help']]
                    ]
                });
            });
        </script>
    }
}
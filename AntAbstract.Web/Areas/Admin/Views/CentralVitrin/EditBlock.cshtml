@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Dinamik satır listeleri (konular, tarihler, ücretler, kurul üyeleri...).
        //
        // Alan adları (name) sayfa yüklenirken ve her gönderimde yeniden üretilir.
        // Böylece aradan satır silindiğinde indisler boşluksuz kalır ve iç içe
        // listeler (kurul -> üye) üst grubun sırasını doğru şekilde devralır.
        (function () {
            var FIELD = '[data-field]';

            // Bir satırın doğrudan kendi alanları: iç içe bir listeye ait olanlar hariç.
            function ownFields(row) {
                return Array.prototype.filter.call(
                    row.querySelectorAll(FIELD),
                    function (el) {
                        var owner = el.closest('[data-repeater]');
                        return owner === null || !row.contains(owner);
                    });
            }

            // Bir satırın doğrudan içerdiği alt listeler (daha derindekiler değil).
            function childLists(row) {
                return Array.prototype.filter.call(
                    row.querySelectorAll('[data-repeater]'),
                    function (list) {
                        var parentRow = list.parentElement
                            ? list.parentElement.closest('.repeater-row')
                            : null;
                        return parentRow === row;
                    });
            }

            function directRows(list) {
                return Array.prototype.filter.call(
                    list.children,
                    function (el) { return el.classList.contains('repeater-row'); });
            }

            // basePath örn: "committeesContent.Groups" veya "committeesContent.Groups[0].Members"
            function reindex(list, basePath) {
                directRows(list).forEach(function (row, i) {
                    var rowPath = basePath + '[' + i + ']';

                    ownFields(row).forEach(function (el) {
                        var field = el.getAttribute('data-field');
                        el.setAttribute('name', field ? rowPath + '.' + field : rowPath);
                    });

                    childLists(row).forEach(function (sub) {
                        var subName = sub.getAttribute('data-repeater-name');
                        if (subName) {
                            reindex(sub, rowPath + '.' + subName);
                        }
                    });
                });
            }

            function reindexAll(root) {
                // Yalnızca en üst seviyedeki listeler; alt listelere recursive iniliyor.
                Array.prototype.forEach.call(
                    root.querySelectorAll('[data-repeater][data-repeater-name]'),
                    function (list) {
                        if (list.parentElement && list.parentElement.closest('.repeater-row')) {
                            return; // alt liste, üstten işlenecek
                        }
                        reindex(list, list.getAttribute('data-repeater-name'));
                    });
            }

            // Şablondan yeni satır üretir. Şablon, satırın bulunduğu kapsamda aranır;
            // böylece her kurulun kendi "Üye Ekle" şablonu kullanılır.
            document.addEventListener('click', function (e) {
                var addBtn = e.target.closest('[data-repeater-add]');

                if (addBtn) {
                    e.preventDefault();

                    var key = addBtn.getAttribute('data-repeater-add');
                    var scope = addBtn.closest('.repeater-row') || document;

                    var tpl = scope.querySelector('[data-repeater-template="' + key + '"]')
                           || document.querySelector('[data-repeater-template="' + key + '"]');

                    var list = scope.querySelector('[data-repeater="' + key + '"]')
                           || document.querySelector('[data-repeater="' + key + '"]');

                    if (!tpl || !list) {
                        return;
                    }

                    var wrap = document.createElement('div');
                    wrap.innerHTML = tpl.innerHTML.trim();

                    var row = wrap.firstElementChild;

                    if (row) {
                        list.appendChild(row);
                        reindexAll(document);

                        var first = row.querySelector('input:not([type=hidden]), textarea');
                        if (first) {
                            first.focus();
                        }
                    }

                    return;
                }

                var removeBtn = e.target.closest('.repeater-remove');

                if (removeBtn) {
                    e.preventDefault();

                    var target = removeBtn.closest('.repeater-row');

                    if (target) {
                        target.remove();
                        reindexAll(document);
                    }
                }
            });

            function init() {
                reindexAll(document);

                var form = document.querySelector('[data-repeater-form]');

                if (!form) {
                    return;
                }

                form.addEventListener('submit', function () {
                    reindexAll(document);

                    // Sunucuya "adlar üretildi" işareti; bu olmadan içerik korunur.
                    var flag = form.querySelector('[data-repeater-ready]');
                    if (flag) {
                        flag.value = '1';
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>

    @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

        <script>
            $(document).ready(function () {
                $('#summernote').summernote({
                    placeholder: '',
                    tabsize: 2,
                    height: 300,
                    toolbar: [
                        ['style', ['style']],
                        ['font', ['bold', 'underline', 'clear']],
                        ['color', ['color']],
                        ['para', ['ul', 'ol', 'paragraph']],
                        ['table', ['table']],
                        ['insert', ['link', 'picture']],
                        ['view', ['fullscreen', 'codeview', 'help']]
                    ]
                });
            });
        </script>
    }
}
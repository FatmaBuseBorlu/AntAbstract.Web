    }

    @@media (max-width: 992px) {
        .edit-block-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .edit-block-hero-left {
            align-items: flex-start;
        }

        .edit-block-hero-actions,
        .edit-block-hero-actions .btn {
            width: 100%;
        }

        .edit-block-title {
            font-size: 1.65rem;
        }

        .edit-form-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .edit-block-hero-left {
            flex-direction: column;
        }

        .publish-box {
            align-items: flex-start;
            flex-direction: column;
        }

        .save-btn {
            width: 100%;
        }
    }

    /* ── Tekrarlayıcı (dinamik satır listeleri) ── */
    .repeater {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .repeater-row {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
    }

    .repeater-fields {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.5rem;
        flex: 1;
        min-width: 0;
    }

    .repeater-fields-stack {
        grid-template-columns: 1fr;
    }

    .repeater-remove {
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid #fecaca;
        background: #fff;
        color: #dc2626;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .15s ease;
    }

    .repeater-remove:hover {
        background: #fee2e2;
        border-color: #fca5a5;
    }

    .repeater-check {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        white-space: nowrap;
        padding-top: 0.55rem;
        cursor: pointer;
    }

    .repeater-add {
        margin-top: 0.85rem;
        padding: 0.6rem 1.1rem;
        border-radius: 11px;
        border: 1.5px dashed #cbd5e1;
        background: #fff;
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 800;
        transition: all .15s ease;
    }

    .repeater-add:hover {
        border-color: #0d6efd;
        background: #f8fbff;
    }

    .repeater-add-sm {
        margin-top: 0.5rem;
        padding: 0.4rem 0.8rem;
        font-size: 0.75rem;
    }

    .committee-group {
        flex-direction: column;
        align-items: stretch;
        background: #fff;
        border-radius: 14px;
    }

    .committee-group-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.75rem;
    }

    .committee-members {
        padding-left: 0.9rem;
        border-left: 3px solid #e2e8f0;
    }

    .committee-members .repeater-row {
        background: #f8fafc;
        padding: 0.55rem;
    }
</style>

<div class="container-fluid edit-block-page">

    <div class="edit-block-hero">
        <div class="edit-block-hero-left">
            <div class="edit-block-hero-icon">
                <i class="@blockIcon"></i>
            </div>

            <div>
                <div class="edit-block-section-label">
                    @Localizer["ContentManagement"]
                </div>

                <h2 class="edit-block-title">
                    @Localizer["PageTitle"]
                </h2>

                <p class="edit-block-description">
                    @Html.Raw(string.Format(Localizer.GetString("HeroDescription"), $"<strong>{Model.Title}</strong>"))
                </p>

                <div class="selected-conference-chip">
                    <i class="fas fa-calendar-check"></i>
                    <span>@Localizer["SelectedConference"]</span>
                    <strong>@conferenceName</strong>

                    @if (!string.IsNullOrWhiteSpace(conferenceSlug))
                    {
                        <em>/@conferenceSlug</em>
                    }
                </div>
            </div>
        </div>

        <div class="edit-block-hero-actions">
            <a asp-area="Admin"
               asp-controller="CentralVitrin"
               asp-action="ManageBlocks"
               asp-route-conferenceId="@Model.ConferenceId"
               class="btn edit-light-btn">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToBlockList"]
            </a>

            @if (!string.IsNullOrWhiteSpace(conferenceSlug))
            {
                <a href="@siteUrl"
                   target="_blank"
                   class="btn edit-outline-btn">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    @Localizer["ViewSite"]
                </a>
            }

            <a href="@flowUrl"
               class="btn edit-outline-btn">
                <i class="fas fa-stream"></i>
                @Localizer["GoToConferenceFlow"]
            </a>
        </div>
    </div>

    <form asp-area="Admin"
          asp-controller="CentralVitrin"
          asp-action="EditBlock"
          asp-route-id="@Model.Id"
          method="post"
          data-repeater-form>

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ConferenceId" />

        @* Satır adlarını gönderim anında JS üretiyor. JS çalışmazsa bu alan boş
           kalır ve sunucu mevcut içeriği korur — sessiz veri kaybı olmaz. *@
        <input type="hidden" name="repeaterReady" value="" data-repeater-ready />

        <div class="edit-form-grid">

            <div class="edit-card">
                <div class="edit-card-header">
                    <div class="edit-card-icon">
                        <i class="fas fa-pen-to-square"></i>
                    </div>

                    <div>
                        <div class="edit-card-title">
                            @Localizer["ContentInfo"]
                        </div>

                        <p class="edit-card-subtitle">
                            @Localizer["ContentInfoSubtitle"]
                        </p>
                    </div>
                </div>

                <div class="edit-card-body">

                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <label asp-for="Title" class="edit-label">
                                @Localizer["MenuTitle"]
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Title"
                                   class="form-control edit-form-control"
                                   placeholder="@Localizer["TitlePlaceholder"]"
                                   required />

                            <span asp-validation-for="Title" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="col-md-5">
                            <label class="edit-label">
                                @Localizer["BlockType"]
                            </label>

                            <input type="text"
                                   class="form-control edit-form-control readonly-control"
                                   value="@blockTypeLabel"
                                   readonly />

                            <div class="form-text fw-semibold">
                                @Localizer["BlockTypeSystemNote"]
                            </div>
                        </div>
                    </div>

                    @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
                    {
                        <div class="content-panel mb-4">
                            <div class="d-flex align-items-start gap-3 mb-4">
                                <div class="edit-card-icon">
                                    <i class="fas fa-file-lines"></i>
                                </div>

                                <div>
                                    <div class="edit-card-title">
                                        @Localizer["DetailedContent"]
                                    </div>

                                    <p class="edit-card-subtitle">
                                        @Localizer["DetailedContentSubtitle"]
                                    </p>
                                </div>
                            </div>

                            <label class="edit-label">
                                @Localizer["ContentText"]
                            </label>

                            <textarea id="summernote"
                                      name="aboutContent.Description">@aboutContent.Description</textarea>
                        </div>
                    }
                    else if (Model.BlockType == ConferencePageBlockType.Topics && topicsContent != null)
                    {
                        <div class="content-panel mb-4">
                            <div class="d-flex align-items-start gap-3 mb-4">
                                <div class="edit-card-icon"><i class="fas fa-tags"></i></div>
                                <div>
                                    <div class="edit-card-title">Kongre Konuları</div>
                                    <p class="edit-card-subtitle">Bildiri gönderilebilecek konu başlıklarını girin.</p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="edit-label">Giriş Metni</label>
                                <textarea name="topicsContent.Description" rows="3"
                                          class="form-control edit-form-control"
                                          placeholder="Konu başlıklarının üstünde görünecek kısa açıklama">@topicsContent.Description</textarea>
                            </div>

                            <label class="edit-label">Konu Başlıkları</label>
                            <div class="repeater" data-repeater="topics" data-repeater-name="topicsContent.Items">
                                @foreach (var (item, i) in topicsContent.Items.Select((x, i) => (x, i)))
                                {
                                    <div class="repeater-row">
                                        <div class="repeater-fields">
                                            <input data-field="Name" value="@item.Name"
                                                   class="form-control edit-form-control" placeholder="Konu başlığı" />
                                            <input data-field="Description" value="@item.Description"
                                                   class="form-control edit-form-control" placeholder="Açıklama (isteğe bağlı)" />
                                        </div>
                                        <button type="button" class="repeater-remove" title="Satırı sil">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>


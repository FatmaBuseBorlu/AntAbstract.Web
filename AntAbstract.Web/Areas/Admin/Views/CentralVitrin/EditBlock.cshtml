@model AntAbstract.Domain.Entities.ConferencePageBlock

@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.WebsiteBlocks

@{
    ViewData["Title"] = "Vitrin Bloğu Düzenle";
    Layout = "_LayoutDashboard";

    var aboutContent = ViewBag.AboutContent as AboutBlockContent;
    var blockTypeText = Model.BlockType.ToString();

    string GetBlockTypeLabel(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => "Ana Karşılama",
            "CallForPapers" => "Kongreye Çağrı",
            "Topics" => "Kongre Konuları",
            "Committees" => "Bilim Kurulu",
            "About" => "Hakkında / İçerik",
            "Fees" => "Katılım Ücreti",
            _ => value
        };
    }

    var blockTypeLabel = GetBlockTypeLabel(Model.BlockType);
}

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">

<div class="container-fluid">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="text-uppercase text-muted fw-bold small mb-1">
                Vitrin Blokları
            </div>

            <h2 class="fw-bold mb-1 text-dark">
                @Model.Title Bloğunu Düzenle
            </h2>

            <p class="text-muted mb-0">
                Bu alanda vitrin bloğunun başlığını, açıklamasını ve yayında olup olmadığını düzenleyebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="CentralVitrin"
           asp-action="ManageBlocks"
           asp-route-conferenceId="@Model.ConferenceId"
           class="btn btn-light border rounded-pill px-4">
            <i class="fas fa-arrow-left me-2 text-secondary"></i>
            Blok Listesine Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="edit-hero">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="hero-icon">
                        <i class="fas fa-pen-nib"></i>
                    </div>

                    <div>
                        <h4 class="fw-bold mb-1">
                            İçerik Düzenleme
                        </h4>

                        <p class="mb-0 text-white-50">
                            Yaptığınız değişiklikler kaydedildikten sonra vitrin tarafına yansır.
                        </p>
                    </div>
                </div>

                <span class="badge bg-light text-primary rounded-pill px-3 py-2">
                    @blockTypeLabel
                </span>
            </div>
        </div>

        <div class="card-body p-4 p-lg-5">

            <form asp-area="Admin"
                  asp-controller="CentralVitrin"
                  asp-action="EditBlock"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ConferenceId" />

                <div class="row g-4 mb-4">

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold text-dark">
                            Menüde Görünen Başlık
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Title"
                               class="form-control form-control-modern"
                               placeholder="Örn: Ana Karşılama, Kongre Konuları"
                               required />

                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-dark">
                            Blok Türü
                        </label>

                        <input type="text"
                               class="form-control form-control-modern bg-light text-muted"
                               value="@blockTypeLabel"
                               readonly />

                        <div class="form-text">
                            Blok türü sistem tarafından belirlenir, buradan değiştirilemez.
                        </div>
                    </div>

                </div>

                @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
                {
                    <div class="content-panel mb-4">
                        <div class="d-flex align-items-start gap-3 mb-4">
                            <div class="content-icon">
                                <i class="fas fa-file-alt"></i>
                            </div>

                            <div>
                                <h5 class="fw-bold mb-1">
                                    Detaylı İçerik
                                </h5>

                                <p class="text-muted small mb-0">
                                    Bu alan vitrin sayfasındaki açıklama/içerik bölümünde gösterilir.
                                </p>
                            </div>
                        </div>

                        <label class="form-label fw-bold">
                            İçerik Metni
                        </label>

                        <textarea id="summernote"
                              name="aboutContent.Description">@aboutContent.Description</textarea>
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <label asp-for="Subtitle" class="form-label fw-bold text-dark">
                            Kısa Açıklama
                        </label>

                        <textarea asp-for="Subtitle"
                                  class="form-control form-control-modern"
                                  rows="5"
                                  placeholder="Bu blok için kısa açıklama yazabilirsiniz."></textarea>

                        <span asp-validation-for="Subtitle" class="text-danger small"></span>
                    </div>
                }

                <div class="publish-box">
                    <div class="d-flex align-items-center gap-3">
                        <div class="form-check form-switch m-0">
                            <input asp-for="IsActive"
                                   class="form-check-input publish-switch"
                                   type="checkbox"
                                   role="switch"
                                   id="activeSwitch" />
                        </div>

                        <div>
                            <label asp-for="IsActive"
                                   class="fw-bold text-dark mb-1"
                                   for="activeSwitch"
                                   style="cursor:pointer;">
                                Sitede Yayında Göster
                            </label>

                            <div class="text-muted small">
                                Kapalı olursa bu blok vitrin sayfasında görünmez.
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                        <i class="fas fa-save me-2"></i>
                        Değişiklikleri Kaydet
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<style>
    .edit-hero {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        padding: 1.6rem 1.8rem;
        color: #fff;
    }

    .hero-icon {
        width: 54px;
        height: 54px;
        min-width: 54px;
        border-radius: 18px;
        background-color: rgba(0, 174, 239, 0.18);
        color: #22d3ee;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
    }

    .form-control-modern {
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        padding: 0.85rem 1rem;
        transition: all 0.2s ease;
        min-height: 54px;
    }

        .form-control-modern:focus {
            border-color: #00aeef;
            box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
        }

    .content-panel {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 1.5rem;
    }

    .content-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 15px;
        background-color: rgba(0, 174, 239, 0.12);
        color: #00aeef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .publish-box {
        border-top: 1px solid #e2e8f0;
        margin-top: 2rem;
        padding-top: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .publish-switch {
        width: 3.1rem;
        height: 1.55rem;
        cursor: pointer;
        box-shadow: none;
    }

        .publish-switch:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

    .note-editor {
        border-radius: 14px;
        overflow: hidden;
        border: 2px solid #e2e8f0 !important;
        background-color: #fff;
    }

    .note-toolbar {
        background-color: #f8fafc !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }

    .note-editable {
        min-height: 260px;
    }

    @@media (max-width: 768px) {
        .publish-box {
            align-items: flex-start;
            flex-direction: column;
        }

            .publish-box .btn {
                width: 100%;
            }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.BlockType == ConferencePageBlockType.About && aboutContent != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

        <script>
            $(document).ready(function () {
                $('#summernote').summernote({
                    placeholder: 'Vitrin sayfasında gösterilecek detaylı içeriği buraya yazın...',
                    tabsize: 2,
                    height: 300,
                    toolbar: [
                        ['style', ['style']],
                        ['font', ['bold', 'underline', 'clear']],
                        ['color', ['color']],
                        ['para', ['ul', 'ol', 'paragraph']],
                        ['table', ['table']],
                        ['insert', ['link', 'picture']],
                        ['view', ['fullscreen', 'codeview', 'help']]
                    ]
                });
            });
        </script>
    }
}
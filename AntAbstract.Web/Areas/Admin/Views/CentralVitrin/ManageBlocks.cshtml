@model IEnumerable<AntAbstract.Domain.Entities.ConferencePageBlock>

@{
    ViewData["Title"] = "Vitrin Blokları";
    Layout = "_LayoutDashboard";

    var conferenceName = ViewBag.ConferenceName as string ?? "Kongre";
    var conferenceId = ViewBag.ConferenceId;

    var blocks = Model?
        .OrderBy(x => x.Order)
        .ToList() ?? new List<AntAbstract.Domain.Entities.ConferencePageBlock>();

    var totalBlockCount = blocks.Count;
    var activeBlockCount = blocks.Count(x => x.IsActive);
    var passiveBlockCount = blocks.Count(x => !x.IsActive);
}

@functions {
    private string GetBlockTypeLabel(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => "Ana Karşılama",
            "CallForPapers" => "Kongreye Çağrı",
            "Topics" => "Kongre Konuları",
            "Committees" => "Bilim Kurulu",
            "About" => "Hakkında / İçerik",
            "Fees" => "Katılım Ücreti",
            _ => value
        };
    }

    private string GetBlockTypeBadgeClass(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => "bg-primary bg-opacity-10 text-primary",
            "CallForPapers" => "bg-info bg-opacity-10 text-info",
            "Topics" => "bg-success bg-opacity-10 text-success",
            "Committees" => "bg-warning bg-opacity-10 text-warning",
            "About" => "bg-secondary bg-opacity-10 text-secondary",
            "Fees" => "bg-danger bg-opacity-10 text-danger",
            _ => "bg-dark bg-opacity-10 text-dark"
        };
    }
}

<div class="container-fluid">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="text-uppercase text-muted fw-bold small mb-1">
                Tüm Vitrinler
            </div>

            <h2 class="fw-bold mb-1 text-dark">
                Vitrin Blokları
            </h2>

            <p class="text-muted mb-0">
                <strong>@conferenceName</strong> kongresinin vitrin sayfasında görünecek içerik bloklarını buradan yönetebilirsiniz.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Admin"
               asp-controller="CentralVitrin"
               asp-action="Index"
               class="btn btn-light border rounded-pill px-4">
                <i class="fas fa-arrow-left me-2 text-secondary"></i>
                Kongre Listesine Dön
            </a>

            <a asp-area="Admin"
               asp-controller="CentralVitrin"
               asp-action="CreateBlock"
               asp-route-conferenceId="@conferenceId"
               class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i>
                Yeni Blok Ekle
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="info-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-layer-group"></i>
                </div>

                <div>
                    <div class="info-number">@totalBlockCount</div>
                    <div class="info-label">Toplam Blok</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="info-icon bg-success bg-opacity-10 text-success">
                    <i class="fas fa-eye"></i>
                </div>

                <div>
                    <div class="info-number">@activeBlockCount</div>
                    <div class="info-label">Yayında</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="info-icon bg-secondary bg-opacity-10 text-secondary">
                    <i class="fas fa-eye-slash"></i>
                </div>

                <div>
                    <div class="info-number">@passiveBlockCount</div>
                    <div class="info-label">Pasif</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="info-card">
                <div class="info-icon bg-info bg-opacity-10 text-info">
                    <i class="fas fa-globe"></i>
                </div>

                <div>
                    <div class="info-number">Aktif</div>
                    <div class="info-label">Kongre Vitrini</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h5 class="fw-bold mb-1">
                        Blok Listesi
                    </h5>

                    <p class="text-muted small mb-0">
                        Bloklar sıra numarasına göre vitrin sayfasında gösterilir. Yayında olmayan bloklar sitede görünmez.
                    </p>
                </div>

                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                    Merkezi Yönetim
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (!blocks.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-layer-group fa-3x mb-3 opacity-25"></i>

                    <h6 class="fw-bold mb-1">
                        Henüz vitrin bloğu bulunmuyor
                    </h6>

                    <p class="mb-0">
                        Bu kongre vitrini için yeni blok ekleyebilirsiniz.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 vitrin-block-table">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-muted fw-bold small" style="width: 10%;">
                                    Sıra
                                </th>

                                <th class="py-3 text-muted fw-bold small" style="width: 20%;">
                                    Blok Türü
                                </th>

                                <th class="py-3 text-muted fw-bold small" style="width: 38%;">
                                    Menü Başlığı
                                </th>

                                <th class="py-3 text-muted fw-bold small text-center" style="width: 14%;">
                                    Durum
                                </th>

                                <th class="pe-4 py-3 text-muted fw-bold small text-end" style="width: 18%;">
                                    İşlemler
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var block in blocks)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="order-badge">
                                            @block.Order
                                        </span>
                                    </td>

                                    <td>
                                        <span class="block-type-badge @GetBlockTypeBadgeClass(block.BlockType)">
                                            @GetBlockTypeLabel(block.BlockType)
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-bold text-dark">
                                            @block.Title
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(block.Subtitle))
                                        {
                                            <small class="text-muted">
                                                @block.Subtitle
                                            </small>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (block.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                                <i class="fas fa-check-circle me-1"></i>
                                                Yayında
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">
                                                <i class="fas fa-eye-slash me-1"></i>
                                                Gizli
                                            </span>
                                        }
                                    </td>

                                    <td class="pe-4 text-end">
                                        <a asp-area="Admin"
                                           asp-controller="CentralVitrin"
                                           asp-action="EditBlock"
                                           asp-route-id="@block.Id"
                                           class="btn btn-sm btn-outline-primary rounded-3">
                                            <i class="fas fa-pen-to-square me-1"></i>
                                            Düzenle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>

<style>
    .info-card {
        background-color: #fff;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        border: 1px solid #f1f5f9;
        min-height: 95px;
    }

    .info-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .info-number {
        font-size: 1.45rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }

    .info-label {
        color: #64748b;
        font-weight: 700;
        font-size: 0.76rem;
        margin-top: 0.25rem;
    }

    .vitrin-block-table thead th {
        font-size: 0.7rem;
        letter-spacing: 0.8px;
        border-bottom: none;
        text-transform: uppercase;
    }

    .vitrin-block-table tbody tr {
        transition: background-color 0.2s ease;
        border-bottom: 1px solid #f8fafc;
    }

        .vitrin-block-table tbody tr:hover {
            background-color: #fbfcfe !important;
        }

    .order-badge {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        background-color: #f1f5f9;
        color: #0f172a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.85rem;
    }

    .block-type-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.45rem 0.75rem;
        font-weight: 700;
        font-size: 0.78rem;
        white-space: nowrap;
    }
</style>
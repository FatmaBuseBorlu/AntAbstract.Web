@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model IEnumerable<AntAbstract.Domain.Entities.ConferencePageBlock>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var conferenceName = ViewBag.ConferenceName as string ?? Localizer.GetString("ConferenceFallback");

    var conferenceId = ViewBag.ConferenceId is Guid selectedConferenceId
        ? selectedConferenceId
        : Guid.Empty;

    var conferenceSlug = ViewBag.ConferenceSlug as string ?? "";

    var blocks = Model?
        .OrderBy(x => x.Order)
        .ToList() ?? new List<AntAbstract.Domain.Entities.ConferencePageBlock>();

    var totalBlockCount = blocks.Count;
    var activeBlockCount = blocks.Count(x => x.IsActive);
    var passiveBlockCount = blocks.Count(x => !x.IsActive);

    var siteUrl = string.IsNullOrWhiteSpace(conferenceSlug)
        ? "#"
        : $"/{conferenceSlug}";

    var flowUrl = string.IsNullOrWhiteSpace(conferenceSlug)
        ? $"/Admin/ConferenceFlow?conferenceId={conferenceId}"
        : $"/{conferenceSlug}/Admin/ConferenceFlow?conferenceId={conferenceId}";
}

@functions {
    private string GetBlockTypeLabel(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => Localizer.GetString("BlockType_Hero"),
            "CallForPapers" => Localizer.GetString("BlockType_CallForPapers"),
            "Topics" => Localizer.GetString("BlockType_Topics"),
            "Committees" => Localizer.GetString("BlockType_Committees"),
            "About" => Localizer.GetString("BlockType_About"),
            "Fees" => Localizer.GetString("BlockType_Fees"),
            _ => value
        };
    }

    private string GetBlockTypeClass(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => "block-type-hero",
            "CallForPapers" => "block-type-call",
            "Topics" => "block-type-topics",
            "Committees" => "block-type-committees",
            "About" => "block-type-about",
            "Fees" => "block-type-fees",
            _ => "block-type-default"
        };
    }

    private string GetBlockIcon(object blockType)
    {
        var value = blockType?.ToString() ?? "";

        return value switch
        {
            "Hero" => "fas fa-house-chimney",
            "CallForPapers" => "fas fa-bullhorn",
            "Topics" => "fas fa-tags",
            "Committees" => "fas fa-users",
            "About" => "fas fa-circle-info",
            "Fees" => "fas fa-credit-card",
            _ => "fas fa-layer-group"
        };
    }
}

<style>
    .vitrin-blocks-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .vitrin-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        margin-bottom: 1.5rem;
    }

    .vitrin-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .vitrin-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .vitrin-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .vitrin-page-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
    }

    .vitrin-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        line-height: 1.65;
        max-width: 850px;
    }

    .selected-conference-chip {
        width: fit-content;
        margin-top: 0.75rem;
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.10);
        border: 1px solid rgba(0, 174, 239, 0.22);
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .selected-conference-chip em {
        color: #64748b;
        font-style: normal;
        font-weight: 900;
    }

    .vitrin-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .vitrin-light-btn,
    .vitrin-outline-btn,
    .vitrin-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0 1.15rem;
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .vitrin-light-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #dbe3ef;
    }

    .vitrin-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .vitrin-outline-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .vitrin-outline-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .vitrin-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
    }

    .vitrin-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
    }

    .vitrin-stat-card {
        min-height: 96px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
        transition: all 0.2s ease;
    }

    .vitrin-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    .vitrin-stat-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .stat-gray {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .vitrin-stat-number {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 950;
        line-height: 1;
    }

    .vitrin-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.3rem;
    }

    .vitrin-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .vitrin-list-header {
        padding: 1.35rem 1.45rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .vitrin-list-header h5 {
        color: #0f172a;
        font-size: 1.18rem;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .vitrin-list-header p {
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.55;
    }

    .vitrin-count-pill {
        padding: 0.44rem 0.82rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .vitrin-block-table {
        margin-bottom: 0;
    }

    .vitrin-block-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .vitrin-block-table tbody td {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .vitrin-block-table tbody tr:hover {
        background: #f8fbff;
    }

    .vitrin-block-table tbody tr:last-child td {
        border-bottom: none;
    }

    .order-badge {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 950;
        font-size: 0.85rem;
    }

    .block-profile {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .block-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 17px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }

    .block-title {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 950;
        line-height: 1.3;
    }

    .block-subtitle {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 750;
        margin-top: 0.18rem;
    }

    .block-type-badge,
    .block-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        border-radius: 999px;
        padding: 0.42rem 0.72rem;
        font-size: 0.78rem;
        font-weight: 900;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .block-type-hero {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.14);
    }

    .block-type-call {
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
        border-color: rgba(0, 174, 239, 0.18);
    }

    .block-type-topics {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border-color: rgba(34, 197, 94, 0.18);
    }

    .block-type-committees {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
        border-color: rgba(245, 158, 11, 0.18);
    }

    .block-type-about {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .block-type-fees {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
        border-color: rgba(239, 68, 68, 0.16);
    }

    .block-type-default {
        background: rgba(15, 23, 42, 0.08);
        color: #334155;
        border-color: rgba(15, 23, 42, 0.12);
    }

    .block-status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border-color: rgba(34, 197, 94, 0.18);
    }

    .block-status-passive {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .admin-action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.42rem;
        flex-wrap: nowrap;
    }

    .admin-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.84rem;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid transparent;
        background: #ffffff;
        transition: all 0.2s ease;
        line-height: 1;
        padding: 0;
    }

    .admin-action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.10);
    }

    .admin-action-edit {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.28);
    }

    .admin-action-edit:hover {
        background: rgba(13, 110, 253, 0.08);
        color: #0b5ed7;
    }

    .vitrin-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        color: #64748b;
    }

    .vitrin-empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .vitrin-empty-state h6 {
        color: #0f172a;
        font-size: 1.1rem;
        font-weight: 950;
        margin-bottom: 0.3rem;
    }

    .vitrin-empty-state p {
        margin-bottom: 0;
        font-weight: 650;
    }

    @@media (max-width: 992px) {
        .vitrin-hero-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .vitrin-hero-left {
            align-items: flex-start;
        }

        .vitrin-hero-actions,
        .vitrin-hero-actions .btn {
            width: 100%;
        }

        .vitrin-page-title {
            font-size: 1.65rem;
        }
    }

    @@media (max-width: 768px) {
        .vitrin-hero-left {
            flex-direction: column;
        }

        .vitrin-block-table tbody td {
            min-width: 150px;
        }

        .admin-action-group {
            flex-wrap: wrap;
        }
    }
</style>

<div class="container-fluid vitrin-blocks-page">

    <div class="vitrin-hero-card">
        <div class="vitrin-hero-left">
            <div class="vitrin-hero-icon">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <div class="vitrin-section-label">
                    @Localizer["ContentManagement"]
                </div>

                <h2 class="vitrin-page-title">
                    @Localizer["PageTitle"]
                </h2>

                <p class="vitrin-page-description">
                    @Html.Raw(string.Format(Localizer.GetString("HeroDescription"), $"<strong>{conferenceName}</strong>"))
                </p>

                <div class="selected-conference-chip">
                    <i class="fas fa-calendar-check"></i>
                    <span>@Localizer["SelectedConference"]</span>
                    <strong>@conferenceName</strong>

                    @if (!string.IsNullOrWhiteSpace(conferenceSlug))
                    {
                        <em>/@conferenceSlug</em>
                    }
                </div>
            </div>
        </div>

        <div class="vitrin-hero-actions">
            <a asp-area="Admin"
               asp-controller="CentralVitrin"
               asp-action="Index"
               class="btn vitrin-light-btn">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToConferenceSites"]
            </a>

            @if (!string.IsNullOrWhiteSpace(conferenceSlug))
            {
                <a href="@siteUrl"
                   target="_blank"
                   class="btn vitrin-outline-btn">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    @Localizer["ViewSite"]
                </a>
            }

            <a href="@flowUrl"
               class="btn vitrin-outline-btn">
                <i class="fas fa-stream"></i>
                @Localizer["GoToConferenceFlow"]
            </a>

            <a asp-area="Admin"
               asp-controller="CentralVitrin"
               asp-action="CreateBlock"
               asp-route-conferenceId="@conferenceId"
               class="btn vitrin-primary-btn">
                <i class="fas fa-plus"></i>
                @Localizer["AddNewBlock"]
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="vitrin-stat-card">
                <div class="vitrin-stat-icon stat-blue">
                    <i class="fas fa-layer-group"></i>
                </div>

                <div>
                    <div class="vitrin-stat-number">
                        @totalBlockCount
                    </div>

                    <div class="vitrin-stat-label">
                        @Localizer["TotalBlocks"]
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="vitrin-stat-card">
                <div class="vitrin-stat-icon stat-green">
                    <i class="fas fa-eye"></i>
                </div>

                <div>
                    <div class="vitrin-stat-number">
                        @activeBlockCount
                    </div>

                    <div class="vitrin-stat-label">
                        @Localizer["Published"]
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="vitrin-stat-card">
                <div class="vitrin-stat-icon stat-gray">
                    <i class="fas fa-eye-slash"></i>
                </div>

                <div>
                    <div class="vitrin-stat-number">
                        @passiveBlockCount
                    </div>

                    <div class="vitrin-stat-label">
                        @Localizer["Hidden"]
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="vitrin-stat-card">
                <div class="vitrin-stat-icon stat-cyan">
                    <i class="fas fa-globe"></i>
                </div>

                <div>
                    <div class="vitrin-stat-number">
                        @(string.IsNullOrWhiteSpace(conferenceSlug) ? "-" : "Aktif")
                    </div>

                    <div class="vitrin-stat-label">@Localizer["KongreVitrini"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="vitrin-list-card">
        <div class="vitrin-list-header">
            <div>
                <h5>
                    Blok Listesi
                </h5>

                <p>
                    
                </p>
            </div>

            <span class="vitrin-count-pill">
                @totalBlockCount blok
            </span>
        </div>

        @if (!blocks.Any())
        {
            <div class="vitrin-empty-state">
                <div class="vitrin-empty-icon">
                    <i class="fas fa-layer-group"></i>
                </div>

                <h6>
                    
                </h6>

                <p>
                    
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle vitrin-block-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 9%;">
                                @Localizer["Order"]
                            </th>

                            <th style="width: 24%;">
                                @Localizer["BlockType"]
                            </th>

                            <th style="width: 39%;">
                                
                            </th>

                            <th class="text-center" style="width: 14%;">@Localizer["Durum"]</th>

                            <th class="text-end pe-4" style="width: 14%;">
 
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var block in blocks)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="order-badge">
                                        @block.Order
                                    </span>
                                </td>

                                <td>
                                    <span class="block-type-badge @GetBlockTypeClass(block.BlockType)">
                                        <i class="@GetBlockIcon(block.BlockType)"></i>
                                        @GetBlockTypeLabel(block.BlockType)
                                    </span>
                                </td>

                                <td>
                                    <div class="block-profile">
                                        <div class="block-avatar">
                                            <i class="@GetBlockIcon(block.BlockType)"></i>
                                        </div>

                                        <div>
                                            <div class="block-title">
                                                @block.Title
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(block.Subtitle))
                                            {
                                                <div class="block-subtitle">
                                                    @block.Subtitle
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="block-subtitle">
                                                    @Localizer["NoSubtitle"]
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="text-center">
                                    @if (block.IsActive)
                                    {
                                        <span class="block-status-badge block-status-active">
                                            <i class="fas fa-check-circle"></i>
                                            @Localizer["Published"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="block-status-badge block-status-passive">
                                            <i class="fas fa-eye-slash"></i>
                                            Gizli
                                        </span>
                                    }
                                </td>

                                <td class="text-end pe-4">
                                    <div class="admin-action-group">
                                        <a asp-area="Admin"
                                           asp-controller="CentralVitrin"
                                           asp-action="EditBlock"
                                           asp-route-id="@block.Id"
                                           class="admin-action-btn admin-action-edit"
                                           title="">
                                            <i class="fas fa-pen-to-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
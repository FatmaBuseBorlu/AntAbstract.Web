@model IEnumerable<AntAbstract.Domain.Entities.ReviewCriterion>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
    var conference = ViewBag.Conference as AntAbstract.Domain.Entities.Conference;
    var slug = ViewBag.Slug as string;
    var createUrl = string.IsNullOrEmpty(slug)
        ? $"/Admin/ReviewCriteria/Create?conferenceId={conference?.Id}"
        : $"/{slug}/Admin/ReviewCriteria/Create?conferenceId={conference?.Id}";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0">
                <i class="fas fa-star-half-alt me-2 text-warning"></i>Değerlendirme Kriterleri
            </h4>
            @if (conference != null)
            {
                <small class="text-muted">@conference.Title</small>
            }
        </div>
        <a href="@createUrl" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Yeni Kriter
        </a>
    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Localizer["Order"]</th>
                            <th>@Localizer["CriterionName"]</th>
                            <th>@Localizer["English"]</th>
                            <th class="text-center">Ağırlık</th>
                            <th class="text-center">Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            var editUrl = string.IsNullOrEmpty(slug)
                                ? $"/Admin/ReviewCriteria/Edit/{c.Id}?conferenceId={conference?.Id}"
                                : $"/{slug}/Admin/ReviewCriteria/Edit/{c.Id}?conferenceId={conference?.Id}";
                            var deleteUrl = string.IsNullOrEmpty(slug)
                                ? $"/Admin/ReviewCriteria/Delete/{c.Id}"
                                : $"/{slug}/Admin/ReviewCriteria/Delete/{c.Id}";

                            <tr>
                                <td class="text-muted">@c.SortOrder</td>
                                <td>
                                    <strong>@c.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(c.Description))
                                    {
                                        <br /><small class="text-muted">@c.Description</small>
                                    }
                                </td>
                                <td class="text-muted">@(c.NameEn ?? "—")</td>
                                <td class="text-center">
                                    <span class="badge bg-primary">×@c.Weight</span>
                                </td>
                                <td class="text-center">
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success">@Localizer["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["Passive"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="@editUrl" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @{ var confirmDel = Localizer["ConfirmDelete"].Value; }
                                    <form method="post" action="@deleteUrl" class="d-inline"
                                          onsubmit="return confirm('@confirmDel')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }
</div>

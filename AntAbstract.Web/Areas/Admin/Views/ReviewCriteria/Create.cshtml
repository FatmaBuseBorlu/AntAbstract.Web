@model AntAbstract.Domain.Entities.ReviewCriterion
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
    var conference = ViewBag.Conference as AntAbstract.Domain.Entities.Conference;
    var slug = ViewBag.Slug as string;
    var indexUrl = string.IsNullOrEmpty(slug)
        ? $"/Admin/ReviewCriteria?conferenceId={conference?.Id}"
        : $"/{slug}/Admin/ReviewCriteria?conferenceId={conference?.Id}";
}

<div class="container-fluid py-4" style="max-width:680px">
    <div class="mb-3">
        <a href="@indexUrl" class="text-decoration-none text-muted small">
            <i class="fas fa-arrow-left me-1"></i>@Localizer["KriterlereDon"]</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header fw-bold bg-dark text-white">
            <i class="fas fa-plus me-2"></i>@Localizer["YeniDegerlendirmeKriteri"]</div>
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ConferenceId" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="@Localizer["OrOzgunluk"]" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NameEn" class="form-label fw-semibold">@Localizer["IngilizceAd"]<span class="text-muted fw-normal">(opsiyonel)</span></label>
                    <input asp-for="NameEn" class="form-control" placeholder="e.g. Originality" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">@Localizer["Aciklama"]<span class="text-muted fw-normal">(opsiyonel)</span></label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="@Localizer["HakemIcinKisaAciklama"]"></textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-4">
                        <label asp-for="Weight" class="form-label fw-semibold">@Localizer["Weight"]</label>
                        <input asp-for="Weight" type="number" min="1" max="10" class="form-control" />
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="SortOrder" class="form-label fw-semibold">@Localizer["Order"]</label>
                        <input asp-for="SortOrder" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label fw-semibold">Durum</label>
                        <div class="form-check mt-2">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">@Localizer["Active"]</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="@indexUrl" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Web.Models.ViewModels.Admin.RegistrationTypes
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model AdminRegistrationTypeFormModel

@{
    ViewData["Title"] = Model.Id.HasValue
        ? Localizer["EditPageTitle"].Value
        : Localizer["CreatePageTitle"].Value;

    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = Model.Slug ?? "";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">@ViewData["Title"]</h3>
            <div class="text-muted">
                @Localizer["ConferenceLabel"] <span class="badge bg-light text-dark border">@Model.ConferenceTitle</span>
            </div>
        </div>

        <a class="btn btn-outline-secondary btn-sm" href="@Model.ReturnUrl">@Localizer["BackButton"]</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="post" action="/@slug/Admin/RegistrationTypes/Save">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Slug" />
                <input type="hidden" asp-for="ConferenceId" />
                <input type="hidden" asp-for="ConferenceTitle" />
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["NameLabel"]</label>
                        <input class="form-control" asp-for="Name" />
                        <span class="text-danger small" asp-validation-for="Name"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@Localizer["PriceLabel"]</label>
                        <input class="form-control" asp-for="Price" />
                        <span class="text-danger small" asp-validation-for="Price"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@Localizer["CurrencyLabel"]</label>
                        <input class="form-control" asp-for="Currency" />
                        <span class="text-danger small" asp-validation-for="Currency"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">@Localizer["DescriptionLabel"]</label>
                        <textarea class="form-control" asp-for="Description" rows="4"></textarea>
                        <span class="text-danger small" asp-validation-for="Description"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-primary" type="submit">@Localizer["SaveButton"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
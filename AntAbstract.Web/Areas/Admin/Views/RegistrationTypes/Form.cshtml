@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Web.Models.ViewModels.Admin.RegistrationTypes


@model AdminRegistrationTypeFormModel

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";

    ViewData["Title"] = Model.Id.HasValue
        ? Localizer.GetString("EditPageTitle")
        : Localizer.GetString("CreatePageTitle");
}

<style>
    .form-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

        .form-section-title i {
            color: #00aeef;
        }

    .form-help-text {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 6px;
    }

    .language-info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px 16px;
        color: #475569;
        font-size: 0.92rem;
    }

    .required-star {
        color: #dc3545;
        font-weight: 700;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                @ViewData["Title"]
            </h3>

            <div class="text-muted">
                @Localizer["ConferenceLabel"]
                <span class="badge bg-light text-dark border">
                    @Model.ConferenceTitle
                </span>
            </div>
        </div>

        <a class="btn btn-outline-secondary btn-sm" href="@Model.ReturnUrl">
            <i class="fas fa-arrow-left me-1"></i>
            @Localizer["BackButton"]
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="language-info-box mb-4">
                <i class="fas fa-info-circle me-2 text-primary"></i>
                @Localizer["InfoBoxText"]
            </div>

            <form method="post" action="/@slug/Admin/RegistrationTypes/Save">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Slug" />
                <input type="hidden" asp-for="ConferenceId" />
                <input type="hidden" asp-for="ConferenceTitle" />
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="row g-4">

                    <div class="col-12">
                        <div class="form-section-title">
                            <i class="fas fa-language"></i>
                            <span>@Localizer["TurkishContentSection"]</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @Localizer["NameTrLabel"]
                            <span class="required-star">*</span>
                        </label>

                        <input class="form-control"
                               asp-for="Name"
                               placeholder="@Localizer["NameTrPlaceholder"]" />

                        <div class="form-help-text">
                            @Localizer["NameTrHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="Name"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            @Localizer["DescriptionTrLabel"]
                        </label>

                        <textarea class="form-control"
                                  asp-for="Description"
                                  rows="4"
                                  placeholder="@Localizer["DescriptionTrPlaceholder"]"></textarea>

                        <div class="form-help-text">
                            @Localizer["DescriptionTrHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="Description"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-globe"></i>
                            <span>@Localizer["EnglishContentSection"]</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @Localizer["NameEnLabel"]
                        </label>

                        <input class="form-control"
                               asp-for="NameEn"
                               placeholder="@Localizer["NameEnPlaceholder"]" />

                        <div class="form-help-text">
                            @Localizer["NameEnHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="NameEn"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            @Localizer["DescriptionEnLabel"]
                        </label>

                        <textarea class="form-control"
                                  asp-for="DescriptionEn"
                                  rows="4"
                                  placeholder="@Localizer["DescriptionEnPlaceholder"]"></textarea>

                        <div class="form-help-text">
                            @Localizer["DescriptionEnHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="DescriptionEn"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-credit-card"></i>
                            <span>@Localizer["PricingSection"]</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @Localizer["PriceLabel"]
                            <span class="required-star">*</span>
                        </label>

                        <input class="form-control"
                               asp-for="Price"
                               placeholder="1500" />

                        <div class="form-help-text">
                            @Localizer["PriceHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="Price"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @Localizer["CurrencyLabel"]
                            <span class="required-star">*</span>
                        </label>

                        <select class="form-select" asp-for="Currency">
                            <option value="TRY">TRY</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                        </select>

                        <div class="form-help-text">
                            @Localizer["CurrencyHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="Currency"></span>
                    </div>

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <div class="form-section-title mt-2">
                            <i class="fas fa-clock"></i>
                            <span>@Localizer["DeadlineSection"]</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @Localizer["DeadlineLabel"]
                        </label>
                        <input type="date" class="form-control" asp-for="Deadline"
                               value="@(Model.Deadline.HasValue ? Model.Deadline.Value.ToString("yyyy-MM-dd") : "")" />
                        <div class="form-help-text">
                            @Localizer["DeadlineHelpText"]
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        @Localizer["ParticipantRoleLabel"]
                        <span class="text-danger">*</span>
                    </label>
                    <select class="form-select" asp-for="RoleName">
                        <option value="Author">@Localizer["RoleAuthor"]</option>
                        <option value="Listener">@Localizer["RoleListener"]</option>
                    </select>
                    <div class="form-text text-muted">
                        @Localizer["ParticipantRoleHelpText"]
                    </div>
                    <span class="text-danger small" asp-validation-for="RoleName"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Model.ReturnUrl" class="btn btn-light border">
                        @Localizer["CancelButton"]
                    </a>

                    <button class="btn btn-primary px-4" type="submit">
                        <i class="fas fa-save me-1"></i>
                        @Localizer["SaveButton"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@using System.Globalization
@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Web.Models.ViewModels.Admin.RegistrationTypes

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@model AdminRegistrationTypeFormModel

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";
    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string T(string tr, string en)
    {
        return isEnglish ? en : tr;
    }

    ViewData["Title"] = Model.Id.HasValue
        ? T("Kayıt Tipi Düzenle", "Edit Registration Type")
        : T("Yeni Kayıt Tipi", "Create Registration Type");
}

<style>
    .form-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

        .form-section-title i {
            color: #00aeef;
        }

    .form-help-text {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 6px;
    }

    .language-info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px 16px;
        color: #475569;
        font-size: 0.92rem;
    }

    .required-star {
        color: #dc3545;
        font-weight: 700;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                @ViewData["Title"]
            </h3>

            <div class="text-muted">
                @T("Kongre:", "Conference:")
                <span class="badge bg-light text-dark border">
                    @Model.ConferenceTitle
                </span>
            </div>
        </div>

        <a class="btn btn-outline-secondary btn-sm" href="@Model.ReturnUrl">
            <i class="fas fa-arrow-left me-1"></i>
            @T("Geri Dön", "Go Back")
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="language-info-box mb-4">
                <i class="fas fa-info-circle me-2 text-primary"></i>
                @T(
                "Bu kayıt tipi kullanıcıların kayıt ekranında görünecektir. İngilizce alanlar boş bırakılırsa sistem Türkçe içerikleri gösterebilir.",
                                "This registration type will be shown on the user registration page. If English fields are left empty, the system may display the Turkish content."
                                )
            </div>

            <form method="post" action="/@slug/Admin/RegistrationTypes/Save">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Slug" />
                <input type="hidden" asp-for="ConferenceId" />
                <input type="hidden" asp-for="ConferenceTitle" />
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="row g-4">

                    <div class="col-12">
                        <div class="form-section-title">
                            <i class="fas fa-language"></i>
                            <span>@T("Türkçe İçerik", "Turkish Content")</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @T("Kayıt Türü Adı (TR)", "Registration Type Name (TR)")
                            <span class="required-star">*</span>
                        </label>

                        <input class="form-control"
                               asp-for="Name"
                               placeholder="@T("Örn: Yazar Katılım Ücreti", "Example: Yazar Katılım Ücreti")" />

                        <div class="form-help-text">
                            @T(
                                                        "Türkçe arayüzde görünecek kayıt tipi adıdır.",
                                                        "This is the registration type name shown in the Turkish interface."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="Name"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            @T("Açıklama (TR)", "Description (TR)")
                        </label>

                        <textarea class="form-control"
                                  asp-for="Description"
                                  rows="4"
                                  placeholder="@T("Örn: Bildiri gönderimi ve kongre katılımı için standart kayıt türüdür.", "Example: Bildiri gönderimi ve kongre katılımı için standart kayıt türüdür.")"></textarea>

                        <div class="form-help-text">
                            @T(
                                                        "Türkçe kayıt ekranında kart açıklaması olarak gösterilir.",
                                                        "This is shown as the card description on the Turkish registration page."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="Description"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-globe"></i>
                            <span>@T("İngilizce İçerik", "English Content")</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @T("Kayıt Türü Adı (EN)", "Registration Type Name (EN)")
                        </label>

                        <input class="form-control"
                               asp-for="NameEn"
                               placeholder="@T("Örn: Author Participation Fee", "Example: Author Participation Fee")" />

                        <div class="form-help-text">
                            @T(
                                                        "İngilizce arayüzde görünecek kayıt tipi adıdır.",
                                                        "This is the registration type name shown in the English interface."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="NameEn"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            @T("Açıklama (EN)", "Description (EN)")
                        </label>

                        <textarea class="form-control"
                                  asp-for="DescriptionEn"
                                  rows="4"
                                  placeholder="@T("Örn: Standard registration type for abstract submission and congress participation.", "Example: Standard registration type for abstract submission and congress participation.")"></textarea>

                        <div class="form-help-text">
                            @T(
                                                        "İngilizce kayıt ekranında kart açıklaması olarak gösterilir.",
                                                        "This is shown as the card description on the English registration page."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="DescriptionEn"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-credit-card"></i>
                            <span>@T("Ücret Bilgisi", "Pricing Information")</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @T("Ücret", "Price")
                            <span class="required-star">*</span>
                        </label>

                        <input class="form-control"
                               asp-for="Price"
                               placeholder="1500" />

                        <div class="form-help-text">
                            @T(
                                                        "Kullanıcıdan alınacak kayıt ücretidir. Örn: 1500,00",
                                                        "The registration fee to be charged to the user. Example: 1500.00"
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="Price"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @T("Para Birimi", "Currency")
                            <span class="required-star">*</span>
                        </label>

                        <select class="form-select" asp-for="Currency">
                            <option value="TRY">TRY</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                        </select>

                        <div class="form-help-text">
                            @T(
                                                        "Kayıt ücretinin para birimidir.",
                                                        "Currency of the registration fee."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="Currency"></span>
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        @T("Katılımcı Rolü", "Participant Role")
                        <span class="text-danger">*</span>
                    </label>
                    <select class="form-select" asp-for="RoleName">
                        <option value="Author">@T("Yazar (Bildiri gönderebilir)", "Author (Can submit abstracts)")</option>
                        <option value="Listener">@T("Dinleyici (Programa ve sertifikaya erişir)", "Listener (Access to program and certificate)")</option>
                    </select>
                    <div class="form-text text-muted">
                        @T("Kayıt yapan kullanıcının sisteme hangi rolde gireceğini belirler.", "Determines the role the registering user will have in the system.")
                    </div>
                    <span class="text-danger small" asp-validation-for="RoleName"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Model.ReturnUrl" class="btn btn-light border">
                        @T("Vazgeç", "Cancel")
                    </a>

                    <button class="btn btn-primary px-4" type="submit">
                        <i class="fas fa-save me-1"></i>
                        @T("Kaydet", "Save")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
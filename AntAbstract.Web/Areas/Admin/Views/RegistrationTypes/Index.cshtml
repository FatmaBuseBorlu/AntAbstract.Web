@using System.Globalization
@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Web.Models.ViewModels.Admin.RegistrationTypes


@model AdminRegistrationTypesIndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                @Localizer["PageTitle"]
            </h3>

            <div class="text-muted">
                @Localizer["ConferenceLabel"]
                <span class="badge bg-light text-dark border">
                    @Model.ConferenceTitle
                </span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary btn-sm"
               href="/@slug/Admin/RegistrationTypes/Create?returnUrl=@Uri.EscapeDataString(currentUrl)">
                @Localizer["AddNewButton"]
            </a>
        </div>
    </div>



    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>
                            @Localizer["TableHeaderName"]
                        </th>

                        <th>
                            @Localizer["TableHeaderDescription"]
                        </th>

                        <th style="width:140px;">
                            @Localizer["TableHeaderPrice"]
                        </th>

                        <th style="width:120px;">
                            @Localizer["TableHeaderCurrency"]
                        </th>

                        <th style="width:160px;">@Localizer["SonTarih"]</th>

                        <th style="width:120px;">
                            @Localizer["TableHeaderUsage"]
                        </th>

                        <th style="width:110px;">
                            Rol
                        </th>

                        <th style="width:220px;">
                            @Localizer["TableHeaderAction"]
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="alert alert-info border-0 m-3">
                                    @Localizer["EmptyMessage"]
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            var itemName = isEnglish && !string.IsNullOrWhiteSpace(item.NameEn)
                            ? item.NameEn
                            : item.Name;

                            var itemDescription = isEnglish && !string.IsNullOrWhiteSpace(item.DescriptionEn)
                            ? item.DescriptionEn
                            : item.Description;

                            var shortDescription = string.IsNullOrWhiteSpace(itemDescription)
                            ? ""
                            : itemDescription.Length > 120
                            ? itemDescription.Substring(0, 120) + "..."
                            : itemDescription;

                            <tr>
                                <td class="fw-semibold">
                                    @itemName
                                </td>

                                <td class="text-muted">
                                    @shortDescription
                                </td>

                                <td>
                                    @item.Price.ToString("N2", CultureInfo.CurrentCulture)
                                </td>

                                <td>
                                    @item.Currency
                                </td>

                                <td>
                                    @if (item.Deadline.HasValue)
                                    {
                                        var isExpired = item.Deadline.Value.Date < DateTime.UtcNow.Date;
                                        var daysLeft = (int)(item.Deadline.Value.Date - DateTime.UtcNow.Date).TotalDays;
                                        if (isExpired)
                                        {
                                            <span class="badge bg-danger">Sona Erdi</span>
                                            <div class="text-muted small">@item.Deadline.Value.ToString("dd.MM.yyyy")</div>
                                        }
                                        else if (daysLeft <= 7)
                                        {
                                            <span class="badge bg-warning text-dark">@daysLeft gün kaldı</span>
                                            <div class="text-muted small">@item.Deadline.Value.ToString("dd.MM.yyyy")</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">@Localizer["ErkenKayit"]</span>
                                            <div class="text-muted small">@item.Deadline.Value.ToString("dd.MM.yyyy")</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.UsageCount
                                    </span>
                                </td>

                                <td>
                                    @if (string.Equals(item.RoleName, "Listener", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info text-dark">Dinleyici</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Localizer["Yazar"]</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="/@slug/Admin/RegistrationTypes/Edit/@item.Id?returnUrl=@Uri.EscapeDataString(currentUrl)">
                                            @Localizer["EditButton"]
                                        </a>

                                        <form method="post"
                                              action="/@slug/Admin/RegistrationTypes/Delete"
                                              onsubmit="return confirm('@Localizer["DeleteConfirmMessage"]');">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnUrl" value="@currentUrl" />

                                            <button class="btn btn-sm btn-outline-danger" type="submit">
                                                @Localizer["DeleteButton"]
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
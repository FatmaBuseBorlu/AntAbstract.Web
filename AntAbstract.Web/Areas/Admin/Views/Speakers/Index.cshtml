@using AntAbstract.Domain.Entities
@model List<InvitedSpeaker>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var slug   = (string?)ViewBag.Slug ?? "";
    var confId = (Guid)ViewBag.ConferenceId;
    string Url(string p) => $"/{slug}{p}";
}

<div class="container-fluid py-4">

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fas fa-microphone-alt text-primary me-2"></i>Davetli Konuşmacılar</h4>
            <p class="text-muted mb-0 small">@ViewBag.ConferenceTitle</p>
        </div>
        <a href="@Url($"/Admin/Speakers/Create?conferenceId={confId}")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Konuşmacı Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm mb-4">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <i class="fas fa-user-tie fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">Henüz konuşmacı eklenmemiş</h5>
            <div class="mt-3">
                <a href="@Url($"/Admin/Speakers/Create?conferenceId={confId}")" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>İlk Konuşmacıyı Ekle
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:48px;">#</th>
                            <th>@Localizer["Speaker"]</th>
                            <th>@Localizer["Institution"]</th>
                            <th>@Localizer["TalkTitle"]</th>
                            <th style="width:80px;">@Localizer["Order"]</th>
                            <th style="width:80px;">Durum</th>
                            <th style="width:120px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var s in Model)
                        {
                            i++;
                            <tr>
                                <td class="text-muted">@i</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrWhiteSpace(s.PhotoUrl))
                                        {
                                            <img src="@s.PhotoUrl" alt="@s.FullName"
                                                 class="rounded-circle" width="36" height="36"
                                                 style="object-fit:cover;" onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center text-white fw-bold"
                                                 style="width:36px;height:36px;font-size:.8rem;flex-shrink:0;">
                                                @s.FullName.Split(' ').Select(w => w[0]).Take(2).Aggregate("", (a, c) => a + c)
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold">@s.FullName</div>
                                            @if (!string.IsNullOrWhiteSpace(s.Title))
                                            {
                                                <div class="text-muted small">@s.Title</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="small text-muted">@s.Institution</td>
                                <td class="small">
                                    @if (!string.IsNullOrWhiteSpace(s.TalkTitle))
                                    {
                                        <span>@s.TalkTitle</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">@s.SortOrder</td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success">@Localizer["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Localizer["Passive"]</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="@Url($"/Admin/Speakers/Edit/{s.Id}?conferenceId={confId}")"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="@Url($"/Admin/Speakers/Delete/{s.Id}")"
                                              onsubmit="return confirm("@Localizer["ConfirmDelete"]")">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@model AntAbstract.Web.Models.ViewModels.Website.ConferenceHomePageViewModel
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = Model.Conference?.Title ?? Localizer["DefaultPageTitle"].Value;

    var hero = Model.Blocks?.FirstOrDefault(x => x.BlockType == ConferencePageBlockType.Hero);

    var others = Model.Blocks?
        .Where(x => x.BlockType != ConferencePageBlockType.Hero && x.IsActive)
        .OrderBy(x => x.Order)
        .ToList() ?? new List<ConferencePageBlock>();

    var slug = Model.Conference?.Tenant?.Slug ?? Model.Conference?.Slug ?? "";

    var registrationUrl = string.IsNullOrWhiteSpace(slug)
        ? "/registration"
        : $"/{slug}/registration";

    var submitAbstractUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Submission/Create"
        : $"/{slug}/Submission/Create";

    var programUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Program"
        : $"/{slug}/program";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }
}

@if (Model.Conference == null)
{
    <div class="alert alert-danger mt-5 container">
        @Localizer["ConferenceNotFound"]
    </div>

    return;
}

<style>
    :root {
        --theme-primary: #0f172a;
        --theme-accent: #00aeef;
        --theme-accent-dark: #0d6efd;
        --theme-muted: #64748b;
        --theme-soft: #f8fafc;
        --theme-border: #e2e8f0;
    }

    body {
        background: #f6f8fb;
    }

    .conference-home-shell {
        background: radial-gradient(circle at 12% 8%, rgba(0, 174, 239, 0.08), transparent 28%), radial-gradient(circle at 88% 15%, rgba(13, 110, 253, 0.06), transparent 26%), #f6f8fb;
    }

    .sticky-sidebar {
        position: sticky;
        top: 30px;
        z-index: 10;
    }

    .modern-menu-list {
        background: #ffffff;
        border-radius: 24px;
        padding: 10px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        border: 1px solid #eef2f7;
    }

    .modern-menu-title {
        color: #0f172a;
        font-size: 0.82rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        padding: 12px 14px 8px;
    }

    .modern-menu-item {
        color: #475569 !important;
        font-weight: 800;
        padding: 14px 16px !important;
        margin-bottom: 5px;
        border-radius: 16px !important;
        transition: all 0.25s ease;
        border: none !important;
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

        .modern-menu-item i {
            width: 30px;
            height: 30px;
            min-width: 30px;
            border-radius: 11px;
            background: rgba(0, 174, 239, 0.09);
            color: var(--theme-accent);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            transition: all 0.25s ease;
        }

        .modern-menu-item:hover {
            background-color: rgba(0, 174, 239, 0.09) !important;
            color: var(--theme-accent) !important;
            transform: translateX(4px);
        }

            .modern-menu-item:hover i {
                background: var(--theme-accent);
                color: #ffffff;
            }

    .content-card {
        background: #ffffff;
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        border: 1px solid #eef2f7;
        margin-bottom: 40px;
        scroll-margin-top: 40px;
    }

    .content-title {
        color: var(--theme-primary);
        font-weight: 900;
        font-size: 1.75rem;
        margin-bottom: 25px;
        position: relative;
        padding-bottom: 15px;
        letter-spacing: -0.04em;
    }

        .content-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 68px;
            height: 4px;
            background: linear-gradient(135deg, var(--theme-accent), var(--theme-accent-dark));
            border-radius: 999px;
        }

    .action-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 35%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 30px;
        padding: 1.25rem;
        box-shadow: 0 22px 55px rgba(15, 23, 42, 0.08);
        margin-bottom: 1.5rem;
    }

    .action-card-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--theme-accent), var(--theme-accent-dark));
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
        margin-bottom: 1rem;
    }

    .action-card-badge {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.38rem 0.72rem;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
        font-size: 0.72rem;
        font-weight: 900;
        margin-bottom: 0.7rem;
    }

    .action-card h4 {
        color: #0f172a;
        font-size: 1.32rem;
        font-weight: 900;
        letter-spacing: -0.04em;
        margin-bottom: 0.55rem;
    }

    .action-card p {
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 600;
        line-height: 1.65;
        margin-bottom: 1rem;
    }

    .action-info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem;
        margin-bottom: 1rem;
    }

    .action-info-item {
        background: #ffffff;
        border: 1px solid #edf2f7;
        border-radius: 18px;
        padding: 0.8rem;
    }

        .action-info-item span {
            display: block;
            color: #64748b;
            font-size: 0.7rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 0.25rem;
        }

        .action-info-item strong {
            display: block;
            color: #0f172a;
            font-size: 0.88rem;
            font-weight: 900;
            line-height: 1.25;
        }

    .action-primary-btn,
    .action-secondary-btn {
        min-height: 48px;
        width: 100%;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        text-decoration: none;
        font-weight: 900;
        transition: all 0.2s ease;
    }

    .action-primary-btn {
        background: linear-gradient(135deg, var(--theme-accent), var(--theme-accent-dark));
        color: #ffffff;
        box-shadow: 0 14px 30px rgba(0, 174, 239, 0.22);
        margin-bottom: 0.65rem;
    }

        .action-primary-btn:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 18px 38px rgba(0, 174, 239, 0.30);
        }

    .action-secondary-btn {
        background: #ffffff;
        border: 1px solid #dbe3ef;
        color: #334155;
    }

        .action-secondary-btn:hover {
            color: var(--theme-accent);
            border-color: rgba(0, 174, 239, 0.30);
            background: #f8fbff;
        }

    .documents-card {
        background: #ffffff;
        border: 1px solid #eef2f7;
        border-radius: 28px;
        padding: 1.2rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .documents-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.85rem;
        margin-bottom: 1rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid #edf2f7;
    }

        .documents-card-header h5 {
            color: #0f172a;
            font-size: 1rem;
            font-weight: 900;
            margin: 0;
        }

        .documents-card-header span {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 15px;
            background: rgba(0, 174, 239, 0.10);
            color: var(--theme-accent);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

    .word-doc-card {
        display: flex;
        align-items: center;
        text-decoration: none;
        padding: 0.9rem;
        background: #f8fafc;
        border-radius: 18px;
        border: 1px solid #edf2f7;
        transition: all 0.25s ease;
        margin-bottom: 0.75rem;
    }

        .word-doc-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.07);
            border-color: rgba(0, 174, 239, 0.28);
            background: #ffffff;
        }

    .word-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2b579a 0%, #1e3c6b 100%);
        color: white;
        margin-right: 0.85rem;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .suggested-section {
        background: radial-gradient(circle at 10% 0%, rgba(0, 174, 239, 0.08), transparent 30%), #ffffff;
        border-top: 1px solid #e8eef6;
    }

    @@media (max-width: 992px) {
        .sticky-sidebar {
            position: static;
        }

        .action-info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .content-card {
            padding: 24px;
            border-radius: 24px;
        }
    }
</style>

@if (hero != null)
{
    <partial name="~/Views/Shared/Blocks/_HeroBlock.cshtml" model="hero" />
}
else
{
    <div class="bg-dark text-white text-center py-5">
        <h1 class="display-4 fw-bold">@Model.Conference.Title</h1>
        <p class="lead">@Localizer["WelcomeText"]</p>
    </div>
}

<div class="conference-home-shell">
    <div class="container py-5">
        <div class="row g-4 g-lg-5">

            <div class="col-lg-3 d-none d-lg-block">
                <div class="sticky-sidebar">
                    <div class="modern-menu-list list-group">
                        <div class="modern-menu-title">
                            @Localizer["MenuTitle"]
                        </div>

                        @if (!others.Any())
                        {
                            <div class="p-3 text-muted text-center small">
                                @Localizer["MenuComingSoon"]
                            </div>
                        }

                        @foreach (var block in others)
                        {
                            <a href="#block-@block.Id" class="list-group-item modern-menu-item">
                                <i class="fas fa-chevron-right"></i>
                                @block.Title
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                @if (!others.Any())
                {
                    <div class="content-card text-center py-5">
                        <i class="fas fa-tools fa-4x text-muted mb-3 opacity-25"></i>

                        <h4 class="text-muted fw-bold">
                            @Localizer["ContentPreparingTitle"]
                        </h4>

                        <p class="text-muted">
                            @Localizer["ContentPreparingLead"]
                        </p>
                    </div>
                }

                @foreach (var block in others)
                {
                    switch (block.BlockType)
                    {
                        case ConferencePageBlockType.About:
                            <partial name="~/Views/Shared/Blocks/_About.cshtml" model="block" />
                            break;

                        default:
                            <partial name="~/Views/Shared/Blocks/_RawBlock.cshtml" model="block" />
                            break;
                    }
                }
            </div>

            <div class="col-lg-3">
                <div class="sticky-sidebar">

                    <div class="action-card">
                        <div class="action-card-badge">
                            <i class="fas fa-circle"></i>
                            
                        </div>

                        <div class="action-card-icon">
                            <i class="fas fa-paper-plane"></i>
                        </div>

                        <h4>
                            
                        </h4>

                        <p>
                            
                        </p>

                        <div class="action-info-grid">
                            <div class="action-info-item">
                                <span>@Localizer["Attendance"]</span>
                                <strong></strong>
                            </div>

                            <div class="action-info-item">
                                <span>Durum</span>
                                <strong>@Localizer["Active"]</strong>
                            </div>
                        </div>

                        <a href="@registrationUrl" class="action-primary-btn">
                            <i class="fas fa-user-plus"></i>
                            @L("RegisterButton", "Kongreye Kayıt Ol")
                        </a>

                        <a href="@submitAbstractUrl" class="action-secondary-btn">
                            <i class="fas fa-upload"></i>
                            @L("SubmitAbstractLabel", "Özet Gönder")
                        </a>
                    </div>

                    <div class="documents-card">
                        <div class="documents-card-header">
                            <h5>
                                @Localizer["DocumentsHeader"]
                            </h5>

                            <span>
                                <i class="fas fa-file-lines"></i>
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Conference.WritingRulesPath))
                        {
                            <a href="@Model.Conference.WritingRulesPath" target="_blank" class="word-doc-card">
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div>
                                    <h6 class="text-dark fw-bold mb-0">
                                        @Localizer["WritingRulesTitle"]
                                    </h6>

                                    <small class="text-muted">
                                        @Localizer["WritingRulesSubtitle"]
                                    </small>
                                </div>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(Model.Conference.AbstractTemplatePath))
                        {
                            <a href="@Model.Conference.AbstractTemplatePath" target="_blank" class="word-doc-card" download>
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div>
                                    <h6 class="text-dark fw-bold mb-0">
                                        @Localizer["AbstractTemplateTitle"]
                                    </h6>

                                    <small class="text-muted">
                                        @Localizer["DownloadDocx"]
                                    </small>
                                </div>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(Model.Conference.FullTextTemplatePath))
                        {
                            <a href="@Model.Conference.FullTextTemplatePath" target="_blank" class="word-doc-card" download>
                                <div class="word-icon-wrapper">
                                    <i class="fas fa-file-word"></i>
                                </div>

                                <div>
                                    <h6 class="text-dark fw-bold mb-0">
                                        @Localizer["FullTextTemplateTitle"]
                                    </h6>

                                    <small class="text-muted">
                                        @Localizer["DownloadDocx"]
                                    </small>
                                </div>
                            </a>
                        }

                        @if (string.IsNullOrEmpty(Model.Conference.WritingRulesPath) &&
                                                string.IsNullOrEmpty(Model.Conference.AbstractTemplatePath) &&
                                                string.IsNullOrEmpty(Model.Conference.FullTextTemplatePath))
                        {
                            <div class="alert alert-light border text-muted small rounded-3 mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                @Localizer["TemplatesNotUploaded"]
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.SuggestedConferences != null && Model.SuggestedConferences.Any())
{
    <div class="suggested-section py-5">
        <div class="container py-4">
            <h3 class="text-center fw-bold text-dark mb-5">
                @Localizer["SuggestedConferencesHeader"]
            </h3>

            <div class="row g-4 justify-content-center">
                @foreach (var conf in Model.SuggestedConferences)
                {
                    var bannerUrl = !string.IsNullOrEmpty(conf.BannerPath)
                    ? conf.BannerPath
                    : "https://placehold.co/300x400/e2e8f0/64748b?text=Poster";

                    var suggestedSlug = conf.Tenant?.Slug ?? conf.Slug ?? "";

                    <div class="col-md-3 col-sm-6">
                        <a href="/@suggestedSlug" class="text-decoration-none">
                            <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden"
                                 style="transition: transform 0.3s;"
                                 onmouseover="this.style.transform='translateY(-10px)'"
                                 onmouseout="this.style.transform='translateY(0)'">

                                <img src="@bannerUrl"
                                     class="card-img-top"
                                     alt="@conf.Title"
                                     style="height: 350px; object-fit: cover;">

                                <div class="position-absolute bottom-0 start-0 w-100 p-3"
                                     style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);">

                                    <h6 class="text-white fw-bold mb-1"
                                        style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @conf.Title
                                    </h6>

                                    <small class="text-info fw-bold">
                                        <i class="far fa-calendar-alt me-1"></i>
                                        @conf.StartDate.ToString("dd MMM yyyy")
                                    </small>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}
@model IEnumerable<AntAbstract.Domain.Entities.EmailTemplate>
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">📧 @Localizer["PageTitle"]</h4>
        <p class="text-muted mb-0">@Localizer["PageLead"]</p>
    </div>
    <a asp-action="SendLog" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-history me-1"></i> Gönderim Geçmişi
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["TableHeaderKey"]</th>
                    <th>@Localizer["TableHeaderSubject"]</th>
                    <th>@Localizer["TableHeaderStatus"]</th>
                    <th class="text-end">@Localizer["TableHeaderActions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <code class="text-purple fw-semibold">@t.Key</code>
                        </td>
                        <td class="text-muted small">@t.Subject</td>
                        <td>
                            <form asp-action="ToggleActive" asp-route-id="@t.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-success" : "btn-outline-secondary")">
                                    @(t.IsActive ? Localizer["StatusActive"].Value : Localizer["StatusPassive"].Value)
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Preview" asp-route-id="@t.Id"
                               target="_blank" class="btn btn-sm btn-outline-info me-1" title="Önizle">
                                <i class="fas fa-eye"></i>
                            </a>
                            <form asp-action="TestSend" asp-route-id="@t.Id" method="post" class="d-inline me-1"
                                  onsubmit="return confirm('Test e-postası kendi adresinize gönderilsin mi?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Test Gönder">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                ✏️ @Localizer["EditButton"]
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@Localizer["EmptyMessage"]</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<div class="card mt-4 border-0 bg-light">
    <div class="card-body">
        <h6 class="fw-semibold mb-2">📌 @Localizer["PlaceholderTitle"]</h6>
        <div class="row g-2">
            @foreach (var ph in new[] {
                ("{FullName}", Localizer["Ph_FullName"].Value.Length > 0 ? Localizer["Ph_FullName"].Value : "Kullanıcının adı soyadı"),
                ("{ConferenceTitle}", Localizer["Ph_ConferenceTitle"].Value.Length > 0 ? Localizer["Ph_ConferenceTitle"].Value : "Kongre adı"),
                ("{SubmissionTitle}", Localizer["Ph_SubmissionTitle"].Value.Length > 0 ? Localizer["Ph_SubmissionTitle"].Value : "Bildiri başlığı"),
                ("{StatusLabel}", Localizer["Ph_StatusLabel"].Value.Length > 0 ? Localizer["Ph_StatusLabel"].Value : "Karar etiketi"),
                ("{Note}", Localizer["Ph_Note"].Value.Length > 0 ? Localizer["Ph_Note"].Value : "Yönetici notu"),
                ("{DownloadLink}", Localizer["Ph_DownloadLink"].Value.Length > 0 ? Localizer["Ph_DownloadLink"].Value : "Sertifika linki")
            })
            {
                <div class="col-auto">
                    <span class="badge bg-secondary font-monospace me-1">@ph.Item1</span>
                    <small class="text-muted">@ph.Item2</small>
                </div>
            }
        </div>
    </div>
</div>

@model IEnumerable<AntAbstract.Domain.Entities.EmailTemplate>
@{
    ViewData["Title"] = "E-posta Şablonları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">📧 E-posta Şablonları</h4>
        <p class="text-muted mb-0">Sistemin gönderdiği e-postaların içeriğini buradan özelleştirebilirsiniz.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Anahtar (Key)</th>
                    <th>Açıklama</th>
                    <th>Son Güncelleme</th>
                    <th class="text-center">Durum</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <code class="text-purple fw-semibold">@t.Key</code>
                        </td>
                        <td class="text-muted">@t.Description</td>
                        <td class="text-muted small">@t.UpdatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-center">
                            <form asp-action="ToggleActive" asp-route-id="@t.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-success" : "btn-outline-secondary")" title="Aktif/Pasif Yap">
                                    @(t.IsActive ? "Aktif" : "Pasif")
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                ✏️ Düzenle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-4 border-0 bg-light">
    <div class="card-body">
        <h6 class="fw-semibold mb-2">📌 Kullanılabilir Placeholder'lar</h6>
        <p class="text-muted small mb-2">Şablon içinde aşağıdaki etiketleri kullanabilirsiniz, sistem bunları otomatik doldurur:</p>
        <div class="row g-2">
            @foreach (var ph in new[] {
                ("{FullName}", "Kullanıcının adı soyadı"),
                ("{ConferenceTitle}", "Kongre adı"),
                ("{SubmissionTitle}", "Bildiri başlığı"),
                ("{StatusLabel}", "Karar etiketi (Kabul, Ret, Revizyon)"),
                ("{Note}", "Yönetici notu (varsa)"),
                ("{DownloadLink}", "Sertifika indirme bağlantısı")
            })
            {
                <div class="col-auto">
                    <span class="badge bg-secondary font-monospace me-1">@ph.Item1</span>
                    <small class="text-muted">@ph.Item2</small>
                </div>
            }
        </div>
    </div>
</div>

@model IEnumerable<AntAbstract.Domain.Entities.EmailTemplate>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var totalCount = Model.Count();
    var activeCount = Model.Count(t => t.IsActive);
    var inactiveCount = totalCount - activeCount;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="admin-hero">
    <div class="admin-hero-left">
        <div class="admin-hero-icon">
            <i class="fas fa-envelope-open-text"></i>
        </div>
        <div>
            <div class="admin-hero-kicker">CONFERENCE TOOLS</div>
            <h3 class="admin-hero-title">@Localizer["PageTitle"]</h3>
            <p class="admin-hero-lead">@Localizer["PageLead"]</p>
        </div>
    </div>
    <div class="admin-hero-actions">
        <a asp-action="SendLog" class="admin-hero-btn admin-hero-btn-light">
            <i class="fas fa-history"></i> @Localizer["SendLogButton"]
        </a>
    </div>
</div>

<div class="admin-stat-grid">
    <div class="admin-stat-card stat-blue">
        <div class="admin-stat-icon"><i class="fas fa-envelope"></i></div>
        <div class="admin-stat-value">@totalCount</div>
        <div class="admin-stat-label">@Localizer["StatTotal"]</div>
    </div>
    <div class="admin-stat-card stat-green">
        <div class="admin-stat-icon"><i class="fas fa-check-circle"></i></div>
        <div class="admin-stat-value">@activeCount</div>
        <div class="admin-stat-label">@Localizer["StatActive"]</div>
    </div>
    <div class="admin-stat-card stat-slate">
        <div class="admin-stat-icon"><i class="fas fa-pause-circle"></i></div>
        <div class="admin-stat-value">@inactiveCount</div>
        <div class="admin-stat-label">@Localizer["StatInactive"]</div>
    </div>
</div>

<div class="admin-list-card">
    <div class="admin-list-card-header">
        <div>
            <h5 class="admin-list-card-title">@Localizer["PageTitle"]</h5>
        </div>
        <span class="admin-list-count"><i class="fas fa-list-ul"></i> @totalCount</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["TableHeaderKey"]</th>
                    <th>@Localizer["TableHeaderSubject"]</th>
                    <th>@Localizer["TableHeaderStatus"]</th>
                    <th class="text-end">@Localizer["TableHeaderActions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <code class="text-purple fw-semibold">@t.Key</code>
                        </td>
                        <td class="text-muted small">@t.Subject</td>
                        <td>
                            <form asp-action="ToggleActive" asp-route-id="@t.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-success" : "btn-outline-secondary")">
                                    @(t.IsActive ? Localizer["StatusActive"].Value : Localizer["StatusPassive"].Value)
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <a asp-action="Preview" asp-route-id="@t.Id"
                               target="_blank" class="btn btn-sm btn-outline-info me-1" title="@Localizer["Onizle"]">
                                <i class="fas fa-eye"></i>
                            </a>
                            @{ var confirmTest = Localizer["ConfirmTestEmail"].Value; }
                            <form asp-action="TestSend" asp-route-id="@t.Id" method="post" class="d-inline me-1"
                                  onsubmit="return confirm('@confirmTest')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="@Localizer["TestGonder"]">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-edit"></i> @Localizer["EditButton"]
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@Localizer["EmptyMessage"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="admin-list-card">
    <div class="admin-list-card-header">
        <h5 class="admin-list-card-title"><i class="fas fa-thumbtack me-2"></i>@Localizer["PlaceholderTitle"]</h5>
    </div>
    <div class="p-4">
        <div class="row g-2">
            @foreach (var ph in new[] {
                ("{FullName}", Localizer["Ph_FullName"].Value.Length > 0 ? Localizer["Ph_FullName"].Value : "Kullanıcının adı soyadı"),
                ("{ConferenceTitle}", Localizer["Ph_ConferenceTitle"].Value.Length > 0 ? Localizer["Ph_ConferenceTitle"].Value : "Kongre adı"),
                ("{SubmissionTitle}", Localizer["Ph_SubmissionTitle"].Value.Length > 0 ? Localizer["Ph_SubmissionTitle"].Value : "Bildiri başlığı"),
                ("{StatusLabel}", Localizer["Ph_StatusLabel"].Value.Length > 0 ? Localizer["Ph_StatusLabel"].Value : "Karar etiketi"),
                ("{Note}", Localizer["Ph_Note"].Value.Length > 0 ? Localizer["Ph_Note"].Value : "Yönetici notu"),
                ("{DownloadLink}", Localizer["Ph_DownloadLink"].Value.Length > 0 ? Localizer["Ph_DownloadLink"].Value : "Sertifika linki")
            })
            {
                <div class="col-auto">
                    <span class="badge bg-secondary font-monospace me-1">@ph.Item1</span>
                    <small class="text-muted">@ph.Item2</small>
                </div>
            }
        </div>
    </div>
</div>

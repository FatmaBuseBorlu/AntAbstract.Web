@model AntAbstract.Domain.Entities.EmailTemplate
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">✏️ @Localizer["PageTitle"]</h4>
        <p class="text-muted mb-0"><code>@Model.Key</code> — @Model.Description</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← @Localizer["BackButton"]</a>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Key" />

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">@Localizer["LabelDescription"]</label>
                <input asp-for="Description" class="form-control" maxlength="200" />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-semibold">@Localizer["LabelSubject"]</label>
                <input asp-for="Subject" class="form-control" maxlength="300" />
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label asp-for="HtmlBody" class="form-label fw-semibold mb-0">@Localizer["LabelHtmlBody"]</label>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary active" id="btnCodeMode" onclick="switchMode('code')">
                            <i class="fas fa-code me-1"></i>Kod
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="btnWysiwygMode" onclick="switchMode('wysiwyg')">
                            <i class="fas fa-paint-brush me-1"></i>Görsel
                        </button>
                    </div>
                </div>
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertPlaceholder('{FullName}')">
                        <i class="fas fa-user me-1"></i>{FullName}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertPlaceholder('{ConferenceTitle}')">
                        <i class="fas fa-university me-1"></i>{ConferenceTitle}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertPlaceholder('{SubmissionTitle}')">
                        <i class="fas fa-file-alt me-1"></i>{SubmissionTitle}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertPlaceholder('{Note}')">
                        <i class="fas fa-sticky-note me-1"></i>{Note}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertPlaceholder('{DownloadLink}')">
                        <i class="fas fa-link me-1"></i>{DownloadLink}
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="insertPlaceholder('{Amount}')">
                        <i class="fas fa-coins me-1"></i>{Amount}
                    </button>
                </div>
                <div class="row g-3">
                    <div class="col-lg-6" id="codePanel">
                        <textarea asp-for="HtmlBody" id="htmlEditor" class="form-control font-monospace" rows="22" style="font-size:12px;tab-size:2"></textarea>
                    </div>
                    <div class="col-lg-12 d-none" id="wysiwygPanel">
                        <div id="wysiwygEditor" style="min-height:400px;border:1px solid #e2e8f0;border-radius:8px;padding:16px;background:#fff;"></div>
                    </div>
                    <div class="col-lg-6">
                        <div class="border rounded-3 bg-white p-3" style="height:100%;min-height:400px;overflow:auto;">
                            <div class="small text-muted mb-2 fw-bold">
                                <i class="fas fa-eye me-1"></i>Canlı Önizleme
                            </div>
                            <div id="livePreview" style="font-family:Arial,sans-serif;"></div>
                        </div>
                    </div>
                </div>
                <span asp-validation-for="HtmlBody" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="IsActive" class="form-check-label">@Localizer["LabelIsActive"]</label>
            </div>

        </div>
        <div class="card-footer bg-transparent d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["BackButton"]</a>
            <button type="submit" class="btn btn-primary px-4">💾 @Localizer["SaveButton"]</button>
        </div>
    </div>
</form>

<div class="card mt-4 border-0 bg-light">
    <div class="card-body">
        <h6 class="fw-semibold mb-2">📌 @Localizer["PlaceholderTitle"]</h6>
        <div class="row g-2">
            @foreach (var ph in new[] {
                ("{FullName}", Localizer["Ph_FullName"].Value),
                ("{ConferenceTitle}", Localizer["Ph_ConferenceTitle"].Value),
                ("{SubmissionTitle}", Localizer["Ph_SubmissionTitle"].Value),
                ("{StatusLabel}", Localizer["Ph_StatusLabel"].Value),
                ("{Note}", Localizer["Ph_Note"].Value),
                ("{DownloadLink}", Localizer["Ph_DownloadLink"].Value)
            })
            {
                <div class="col-auto">
                    <span class="badge bg-secondary font-monospace me-1">@ph.Item1</span>
                    <small class="text-muted">@ph.Item2</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    (function () {
        var editor = document.getElementById('htmlEditor');
        var preview = document.getElementById('livePreview');
        if (!editor || !preview) return;

        var placeholders = {
            '{FullName}': 'Örnek Kullanıcı',
            '{ConferenceTitle}': 'Örnek Kongre 2026',
            '{SubmissionTitle}': 'Örnek Bildiri Başlığı',
            '{Note}': '<p><strong>Not:</strong> Hakem değerlendirme notu burada yer alır.</p>',
            '{DownloadLink}': '#',
            '{Amount}': '500,00 TRY',
            '{TransactionId}': 'TXN-20260616',
            '{StatusLabel}': 'Kabul Edildi'
        };

        function updatePreview() {
            var html = editor.value;
            for (var key in placeholders) {
                html = html.split(key).join(placeholders[key]);
            }
            preview.innerHTML = html;
        }

        editor.addEventListener('input', updatePreview);
        updatePreview();

        window.insertPlaceholder = function (ph) {
            var start = editor.selectionStart;
            var end = editor.selectionEnd;
            var val = editor.value;
            editor.value = val.substring(0, start) + ph + val.substring(end);
            editor.selectionStart = editor.selectionEnd = start + ph.length;
            editor.focus();
            updatePreview();
        };

        editor.addEventListener('keydown', function (e) {
            if (e.key === 'Tab') {
                e.preventDefault();
                var start = this.selectionStart;
                this.value = this.value.substring(0, start) + '  ' + this.value.substring(this.selectionEnd);
                this.selectionStart = this.selectionEnd = start + 2;
                updatePreview();
            }
        });
    })();

    var tinyLoaded = false;
    window.switchMode = function (mode) {
        var codePanel = document.getElementById('codePanel');
        var previewCol = codePanel.nextElementSibling; // live preview col
        var wysiwygPanel = document.getElementById('wysiwygPanel');
        var btnCode = document.getElementById('btnCodeMode');
        var btnWysiwyg = document.getElementById('btnWysiwygMode');

        if (mode === 'wysiwyg') {
            codePanel.classList.add('d-none');
            if (previewCol) previewCol.classList.add('d-none');
            wysiwygPanel.classList.remove('d-none');
            btnCode.classList.remove('active');
            btnWysiwyg.classList.add('active');

            if (!tinyLoaded) {
                var script = document.createElement('script');
                script.src = 'https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js';
                script.referrerPolicy = 'origin';
                script.onload = function () { initTiny(); };
                document.head.appendChild(script);
                tinyLoaded = true;
            } else if (window.tinymce) {
                var inst = tinymce.get('wysiwygEditor');
                if (inst) inst.setContent(document.getElementById('htmlEditor').value);
            }
        } else {
            if (window.tinymce) {
                var inst = tinymce.get('wysiwygEditor');
                if (inst) {
                    document.getElementById('htmlEditor').value = inst.getContent();
                    updatePreview();
                }
            }
            codePanel.classList.remove('d-none');
            if (previewCol) previewCol.classList.remove('d-none');
            wysiwygPanel.classList.add('d-none');
            btnCode.classList.add('active');
            btnWysiwyg.classList.remove('active');
        }
    };

    function initTiny() {
        tinymce.init({
            target: document.getElementById('wysiwygEditor'),
            height: 450,
            menubar: false,
            plugins: 'lists link code table',
            toolbar: 'undo redo | blocks | bold italic underline | forecolor backcolor | alignleft aligncenter alignright | bullist numlist | link table | code',
            content_style: 'body { font-family: Arial, sans-serif; font-size: 14px; }',
            setup: function (ed) {
                ed.on('init', function () {
                    ed.setContent(document.getElementById('htmlEditor').value);
                });
                ed.on('change keyup', function () {
                    document.getElementById('htmlEditor').value = ed.getContent();
                });
            }
        });
    }
    </script>
}

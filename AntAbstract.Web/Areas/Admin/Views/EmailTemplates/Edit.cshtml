@model AntAbstract.Domain.Entities.EmailTemplate
@{
    ViewData["Title"] = "Şablon Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">✏️ Şablon Düzenle</h4>
        <p class="text-muted mb-0"><code>@Model.Key</code> — @Model.Description</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Listeye Dön</a>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Key" />

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                <input asp-for="Description" class="form-control" maxlength="200" />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-semibold">E-posta Konusu</label>
                <input asp-for="Subject" class="form-control" maxlength="300" />
                <div class="form-text">Placeholder kullanabilirsiniz: <code>{FullName}</code>, <code>{ConferenceTitle}</code> vb.</div>
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HtmlBody" class="form-label fw-semibold">E-posta İçeriği (HTML)</label>
                <textarea asp-for="HtmlBody" class="form-control font-monospace" rows="20" style="font-size:13px"></textarea>
                <span asp-validation-for="HtmlBody" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Aktif (şablon kullanılsın)</label>
            </div>

        </div>
        <div class="card-footer bg-transparent d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            <button type="submit" class="btn btn-primary px-4">💾 Kaydet</button>
        </div>
    </div>
</form>

<div class="card mt-4 border-0 bg-light">
    <div class="card-body">
        <h6 class="fw-semibold mb-2">📌 Kullanılabilir Placeholder'lar</h6>
        <div class="row g-2">
            @foreach (var ph in new[] {
                ("{FullName}", "Kullanıcının adı soyadı"),
                ("{ConferenceTitle}", "Kongre adı"),
                ("{SubmissionTitle}", "Bildiri başlığı"),
                ("{StatusLabel}", "Karar etiketi"),
                ("{Note}", "Yönetici notu (varsa)"),
                ("{DownloadLink}", "Sertifika indirme bağlantısı")
            })
            {
                <div class="col-auto">
                    <span class="badge bg-secondary font-monospace me-1">@ph.Item1</span>
                    <small class="text-muted">@ph.Item2</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.ViewModels.Shared
@using System.Linq

@model SelectConferenceViewModel

@{
    ViewData["Title"] = Model.Title;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var conferences = Model.Conferences?.ToList() ?? new List<Conference>();
    var returnUrl = Model.ReturnUrl ?? "";
    var submitText = string.IsNullOrWhiteSpace(Model.SubmitText) ? "Devam Et" : Model.SubmitText;
}

<div class="container-fluid select-conference-page">

    <div class="select-page-header mb-4">
        <div>
            <div class="select-section-label">
                Kongre Operasyonları
            </div>

            <h2 class="select-page-title">
                @Model.Title
            </h2>

            <p class="select-page-description">
                @Model.Lead
            </p>
        </div>

        <a href="/Admin"
           class="select-back-btn">
            <i class="fas fa-arrow-left"></i>
            Panele Dön
        </a>
    </div>

    <div class="select-filter-card mb-4">
        <div class="row g-3 align-items-end">

            <div class="col-xl-5 col-lg-5">
                <label class="select-label">
                    Arama
                </label>

                <div class="select-input-wrap">
                    <i class="fas fa-search"></i>

                    <input type="text"
                           id="conferenceSearchInput"
                           placeholder="Kongre adı, kurum veya slug ara..." />
                </div>
            </div>

            <div class="col-xl-4 col-lg-4">
                <label class="select-label">
                    Kurum
                </label>

                <select id="tenantFilterSelect" class="select-control">
                    <option value="">Tüm Kurumlar</option>

                    @foreach (var tenantSlug in conferences
                                        .Where(x => x.Tenant != null && !string.IsNullOrWhiteSpace(x.Tenant.Slug))
                                        .Select(x => x.Tenant!.Slug)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option value="@tenantSlug">
                            /@tenantSlug
                        </option>
                    }
                </select>
            </div>

            <div class="col-xl-2 col-lg-2">
                <button type="button"
                        id="filterConferenceButton"
                        class="select-filter-btn w-100">
                    <i class="fas fa-search"></i>
                    Filtrele
                </button>
            </div>

            <div class="col-xl-1 col-lg-1">
                <button type="button"
                        id="resetConferenceButton"
                        class="select-reset-btn w-100"
                        title="Temizle">
                    <i class="fas fa-rotate-left"></i>
                </button>
            </div>

        </div>
    </div>

    <form method="post" action="@Model.PostUrl" id="selectConferenceForm">
        @Html.AntiForgeryToken()

        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div class="conference-list-card">
            <div class="conference-list-header">
                <div>
                    <h5>
                        Kongre Listesi
                    </h5>

                    <p>
                        İşlem yapmak istediğiniz kongreyi seçip devam edin.
                    </p>
                </div>

                <div class="conference-count-pill">
                    <span id="visibleConferenceCount">@conferences.Count</span> / @conferences.Count kongre
                </div>
            </div>

            @if (!conferences.Any())
            {
                <div class="conference-empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-calendar-xmark"></i>
                    </div>

                    <h4>
                        Görüntülenecek kongre bulunamadı
                    </h4>

                    <p>
                        Bu işlem için erişebileceğiniz bir kongre bulunmuyor.
                    </p>
                </div>
            }
            else
            {
                <div class="conference-card-list" id="conferenceCardList">

                    @foreach (var conference in conferences)
                    {
                        var tenantSlug = conference.Tenant?.Slug ?? "";
                        var siteUrl = string.IsNullOrWhiteSpace(tenantSlug) ? "#" : $"/{tenantSlug}";

                        <label class="conference-select-card"
                               data-title="@conference.Title"
                               data-slug="@tenantSlug"
                               data-search="@($"{conference.Title} {tenantSlug} {conference.StartDate:dd.MM.yyyy} {conference.EndDate:dd.MM.yyyy}")">

                            <input type="radio"
                                   name="conferenceId"
                                   value="@conference.Id"
                                   class="conference-radio" />

                            <div class="conference-radio-visual">
                                <span></span>
                            </div>

                            <div class="conference-date-box">
                                <strong>@conference.StartDate.ToString("dd")</strong>
                                <span>@conference.StartDate.ToString("MMM").ToUpper()</span>
                            </div>

                            <div class="conference-main-info">
                                <div class="conference-title-row">
                                    <h6>
                                        @conference.Title
                                    </h6>

                                    <span class="conference-status-pill">
                                        <i class="fas fa-circle"></i>
                                        Aktif
                                    </span>
                                </div>

                                <div class="conference-meta-row">
                                    <span>
                                        <i class="fas fa-link"></i>
                                        Slug: @(string.IsNullOrWhiteSpace(tenantSlug) ? "Belirtilmedi" : tenantSlug)
                                    </span>

                                    <span>
                                        <i class="fas fa-calendar-days"></i>
                                        @conference.StartDate.ToString("dd.MM.yyyy") - @conference.EndDate.ToString("dd.MM.yyyy")
                                    </span>
                                </div>
                            </div>

                            <div class="conference-site-area">
                                @if (!string.IsNullOrWhiteSpace(tenantSlug))
                                {
                                    <a href="@siteUrl"
                                       target="_blank"
                                       class="conference-site-btn"
                                       onclick="event.stopPropagation();">
                                        <i class="fas fa-external-link-alt"></i>
                                        Siteyi Gör
                                    </a>
                                }
                                else
                                {
                                    <span class="conference-no-site">
                                        Site yok
                                    </span>
                                }
                            </div>

                        </label>
                    }

                </div>

                <div class="conference-no-result" id="conferenceNoResult" style="display:none;">
                    <div class="empty-icon">
                        <i class="fas fa-magnifying-glass"></i>
                    </div>

                    <h4>
                        Filtreye uygun kongre bulunamadı
                    </h4>

                    <p>
                        Arama metnini veya kurum filtresini değiştirerek tekrar deneyebilirsiniz.
                    </p>
                </div>
            }

            <div class="conference-list-footer">
                <div class="selected-info-text" id="selectedConferenceText">
                    Devam etmek için bir kongre seçin.
                </div>

                <div class="footer-actions">
                    <a href="/Admin" class="select-cancel-btn">
                        Vazgeç
                    </a>

                    <button type="submit"
                            id="continueButton"
                            class="select-continue-btn"
                            disabled>
                        <i class="fas fa-arrow-right"></i>
                        @submitText
                    </button>
                </div>
            </div>
        </div>
    </form>

</div>

<style>
    .select-conference-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .select-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem;
        flex-wrap: wrap;
    }

    .select-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .select-page-title {
        color: #0f172a;
        font-size: 2.1rem;
        font-weight: 900;
        letter-spacing: -0.055em;
        margin: 0 0 0.45rem;
    }

    .select-page-description {
        color: #64748b;
        font-size: 0.98rem;
        font-weight: 600;
        line-height: 1.65;
        margin: 0;
        max-width: 900px;
    }

    .select-back-btn {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0 1.25rem;
        border-radius: 999px;
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #0f172a;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
    }

        .select-back-btn:hover {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.25);
            transform: translateY(-1px);
        }

    .select-filter-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1.2rem;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    }

    .select-label {
        display: block;
        color: #0f172a;
        font-size: 0.86rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .select-input-wrap {
        min-height: 50px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1rem;
        border: 1px solid #dbe3ef;
        border-radius: 16px;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .select-input-wrap:focus-within {
            border-color: rgba(13, 110, 253, 0.45);
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.08);
        }

        .select-input-wrap i {
            color: #94a3b8;
        }

        .select-input-wrap input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            color: #0f172a;
            font-weight: 700;
        }

            .select-input-wrap input::placeholder {
                color: #94a3b8;
            }

    .select-control {
        width: 100%;
        min-height: 50px;
        border: 1px solid #dbe3ef;
        border-radius: 16px;
        padding: 0 1rem;
        background: #ffffff;
        color: #0f172a;
        font-weight: 800;
        outline: none;
    }

        .select-control:focus {
            border-color: rgba(13, 110, 253, 0.45);
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.08);
        }

    .select-filter-btn {
        min-height: 50px;
        border: none;
        border-radius: 16px;
        background: #0d6efd;
        color: #ffffff;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.20);
        transition: all 0.2s ease;
    }

        .select-filter-btn:hover {
            background: #0b5ed7;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .select-reset-btn {
        min-height: 50px;
        border: 1px solid #dbe3ef;
        border-radius: 16px;
        background: #ffffff;
        color: #0f172a;
        font-weight: 900;
        transition: all 0.2s ease;
    }

        .select-reset-btn:hover {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.25);
            background: #f8fbff;
        }

    .conference-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .conference-list-header {
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .conference-list-header h5 {
            color: #0f172a;
            font-size: 1.25rem;
            font-weight: 900;
            margin: 0 0 0.25rem;
        }

        .conference-list-header p {
            color: #64748b;
            font-size: 0.9rem;
            font-weight: 600;
            margin: 0;
        }

    .conference-count-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        padding: 0 0.9rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .conference-card-list {
        display: grid;
        gap: 0.9rem;
        padding: 1.2rem 1.5rem;
    }

    .conference-select-card {
        position: relative;
        display: grid;
        grid-template-columns: 34px 64px 1fr auto;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border-radius: 22px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .conference-select-card:hover {
            border-color: rgba(13, 110, 253, 0.30);
            background: #f8fbff;
            transform: translateY(-1px);
            box-shadow: 0 14px 32px rgba(15, 23, 42, 0.06);
        }

        .conference-select-card.is-selected {
            border-color: rgba(13, 110, 253, 0.55);
            background: linear-gradient(135deg, rgba(13, 110, 253, 0.08), rgba(0, 174, 239, 0.07));
            box-shadow: 0 16px 36px rgba(13, 110, 253, 0.12);
        }

    .conference-radio {
        display: none;
    }

    .conference-radio-visual {
        width: 24px;
        height: 24px;
        border-radius: 999px;
        border: 2px solid #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
    }

        .conference-radio-visual span {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: transparent;
            transition: all 0.2s ease;
        }

    .conference-select-card.is-selected .conference-radio-visual {
        border-color: #0d6efd;
    }

        .conference-select-card.is-selected .conference-radio-visual span {
            background: #0d6efd;
        }

    .conference-date-box {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(13, 110, 253, 0.09);
        color: #0d6efd;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

        .conference-date-box strong {
            font-size: 1.25rem;
            font-weight: 900;
        }

        .conference-date-box span {
            margin-top: 0.2rem;
            font-size: 0.7rem;
            font-weight: 900;
        }

    .conference-main-info {
        min-width: 0;
    }

    .conference-title-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-wrap: wrap;
    }

        .conference-title-row h6 {
            color: #0f172a;
            font-size: 1rem;
            font-weight: 900;
            line-height: 1.35;
            margin: 0;
        }

    .conference-status-pill {
        min-height: 26px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0 0.65rem;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
        font-size: 0.72rem;
        font-weight: 900;
    }

        .conference-status-pill i {
            font-size: 0.45rem;
        }

    .conference-meta-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 0.45rem;
    }

        .conference-meta-row span {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: #64748b;
            font-size: 0.82rem;
            font-weight: 700;
        }

        .conference-meta-row i {
            color: #0d6efd;
        }

    .conference-site-area {
        display: flex;
        justify-content: flex-end;
    }

    .conference-site-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0 0.95rem;
        border-radius: 14px;
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #475569;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 900;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .conference-site-btn:hover {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.28);
            background: #f8fbff;
        }

    .conference-no-site {
        color: #94a3b8;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .conference-list-footer {
        padding: 1.1rem 1.5rem;
        border-top: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .selected-info-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 800;
    }

    .footer-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .select-cancel-btn,
    .select-continue-btn {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0 1.35rem;
        border-radius: 999px;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .select-cancel-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #0f172a;
    }

        .select-cancel-btn:hover {
            color: #0d6efd;
            background: #f8fbff;
        }

    .select-continue-btn {
        border: none;
        background: #0d6efd;
        color: #ffffff;
        min-width: 180px;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.22);
    }

        .select-continue-btn:hover:not(:disabled) {
            color: #ffffff;
            background: #0b5ed7;
            transform: translateY(-1px);
        }

        .select-continue-btn:disabled {
            opacity: 0.48;
            cursor: not-allowed;
            box-shadow: none;
        }

    .conference-empty-state,
    .conference-no-result {
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
    }

    .conference-empty-state h4,
    .conference-no-result h4 {
        color: #0f172a;
        font-size: 1.28rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .conference-empty-state p,
    .conference-no-result p {
        color: #64748b;
        font-weight: 600;
        margin: 0 auto;
        max-width: 520px;
        line-height: 1.65;
    }

    @@media (max-width: 992px) {
        .select-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .select-back-btn {
            width: 100%;
        }

        .conference-select-card {
            grid-template-columns: 30px 58px 1fr;
        }

        .conference-site-area {
            grid-column: 1 / -1;
            justify-content: flex-start;
            padding-left: 88px;
        }

        .conference-site-btn {
            width: 100%;
        }

        .conference-list-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .footer-actions,
        .footer-actions a,
        .footer-actions button {
            width: 100%;
        }
    }

    @@media (max-width: 576px) {
        .conference-select-card {
            grid-template-columns: 28px 1fr;
        }

        .conference-date-box {
            display: none;
        }

        .conference-site-area {
            padding-left: 0;
        }

        .select-page-title {
            font-size: 1.65rem;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("conferenceSearchInput");
            const tenantFilter = document.getElementById("tenantFilterSelect");
            const filterButton = document.getElementById("filterConferenceButton");
            const resetButton = document.getElementById("resetConferenceButton");
            const cards = Array.from(document.querySelectorAll(".conference-select-card"));
            const radios = Array.from(document.querySelectorAll(".conference-radio"));
            const continueButton = document.getElementById("continueButton");
            const selectedText = document.getElementById("selectedConferenceText");
            const visibleCount = document.getElementById("visibleConferenceCount");
            const noResult = document.getElementById("conferenceNoResult");

            function normalize(value) {
                return (value || "")
                    .toString()
                    .toLocaleLowerCase("tr-TR")
                    .trim();
            }

            function updateSelection(selectedCard) {
                cards.forEach(function (card) {
                    card.classList.remove("is-selected");
                });

                if (selectedCard) {
                    selectedCard.classList.add("is-selected");

                    const radio = selectedCard.querySelector(".conference-radio");

                    if (radio) {
                        radio.checked = true;
                    }

                    const titleElement = selectedCard.querySelector(".conference-title-row h6");
                    const title = titleElement ? titleElement.innerText.trim() : "Kongre";

                    if (selectedText) {
                        selectedText.innerText = "Seçilen kongre: " + title;
                    }

                    if (continueButton) {
                        continueButton.disabled = false;
                    }
                }
            }

            function applyFilters() {
                const query = normalize(searchInput ? searchInput.value : "");
                const selectedTenant = normalize(tenantFilter ? tenantFilter.value : "");

                let count = 0;

                cards.forEach(function (card) {
                    const searchData = normalize(card.getAttribute("data-search"));
                    const slug = normalize(card.getAttribute("data-slug"));

                    const matchesSearch = !query || searchData.includes(query);
                    const matchesTenant = !selectedTenant || slug === selectedTenant;

                    const visible = matchesSearch && matchesTenant;

                    card.style.display = visible ? "" : "none";

                    if (visible) {
                        count++;
                    }
                });

                if (visibleCount) {
                    visibleCount.innerText = count;
                }

                if (noResult) {
                    noResult.style.display = count === 0 ? "block" : "none";
                }
            }

            cards.forEach(function (card) {
                card.addEventListener("click", function () {
                    updateSelection(card);
                });
            });

            radios.forEach(function (radio) {
                radio.addEventListener("change", function () {
                    const card = radio.closest(".conference-select-card");
                    updateSelection(card);
                });
            });

            if (filterButton) {
                filterButton.addEventListener("click", applyFilters);
            }

            if (searchInput) {
                searchInput.addEventListener("keyup", applyFilters);
            }

            if (tenantFilter) {
                tenantFilter.addEventListener("change", applyFilters);
            }

            if (resetButton) {
                resetButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                    }

                    if (tenantFilter) {
                        tenantFilter.value = "";
                    }

                    applyFilters();
                });
            }
        });
    </script>
}
@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.ViewModels.Shared
@using System
@using System.Collections.Generic
@using System.Linq

@model SelectConferenceViewModel

@{
    ViewData["Title"] = Model.Title;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var conferences = Model.Conferences?.ToList() ?? new List<Conference>();
    var returnUrl = Model.ReturnUrl ?? "";
    var submitText = string.IsNullOrWhiteSpace(Model.SubmitText) ? "Devam Et" : Model.SubmitText;

    var totalConferenceCount = conferences.Count;
    var tenantCount = conferences
        .Where(x => x.Tenant != null && !string.IsNullOrWhiteSpace(x.Tenant.Slug))
        .Select(x => x.Tenant!.Slug)
        .Distinct()
        .Count();

    var now = DateTime.Now;
    var activeConferenceCount = conferences.Count(x => x.StartDate <= now && x.EndDate >= now);
    var upcomingConferenceCount = conferences.Count(x => x.StartDate > now);
}

<style>
    .select-conference-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .admin-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .admin-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .admin-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .admin-hero-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .admin-hero-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .admin-hero-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 860px;
    }

    .admin-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .admin-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .admin-hero-btn-light {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .admin-hero-btn-light:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .admin-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .admin-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 96px;
        transition: all 0.2s ease;
    }

    .admin-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.075);
    }

    .admin-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .admin-stat-value {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .admin-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.25rem;
    }

    .admin-filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        padding: 1.15rem;
        margin-bottom: 1.4rem;
    }

    .admin-filter-label {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.55rem;
    }

    .admin-input-wrap {
        min-height: 48px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1rem;
        border: 1px solid #dbe4ef;
        border-radius: 15px;
        background: #ffffff;
        transition: all 0.2s ease;
    }

    .admin-input-wrap:focus-within {
        border-color: #00aeef;
        box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.10);
    }

    .admin-input-wrap i {
        color: #94a3b8;
    }

    .admin-input-wrap input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 750;
    }

    .admin-input-wrap input::placeholder {
        color: #94a3b8;
        font-weight: 700;
    }

    .admin-filter-control {
        min-height: 48px;
        border-radius: 15px;
        border: 1px solid #dbe4ef;
        background: #ffffff;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 750;
        box-shadow: none;
        transition: all 0.2s ease;
    }

    .admin-filter-control:focus {
        border-color: #00aeef;
        box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.10);
    }

    .admin-filter-btn {
        min-height: 48px;
        border-radius: 15px;
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-size: 0.9rem;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.18);
        transition: all 0.2s ease;
    }

    .admin-filter-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(13, 110, 253, 0.24);
    }

    .admin-reset-btn {
        min-width: 52px;
        min-height: 48px;
        border-radius: 15px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .admin-reset-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .conference-list-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
    }

    .conference-list-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .conference-list-header h5 {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 900;
        margin: 0 0 0.25rem;
    }

    .conference-list-header p {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.55;
        margin-bottom: 0;
    }

    .conference-count-pill {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0 0.8rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .conference-card-list {
        display: grid;
        gap: 0.85rem;
        padding: 1.25rem 1.35rem;
    }

    .conference-select-card {
        position: relative;
        display: grid;
        grid-template-columns: 34px 64px minmax(0, 1fr) auto;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border-radius: 22px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.025);
    }

    .conference-select-card:hover {
        border-color: rgba(13, 110, 253, 0.26);
        background: #f8fbff;
        transform: translateY(-1px);
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.06);
    }

    .conference-select-card.is-selected {
        border-color: rgba(13, 110, 253, 0.55);
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.08), rgba(0, 174, 239, 0.07));
        box-shadow: 0 16px 36px rgba(13, 110, 253, 0.12);
    }

    .conference-radio {
        display: none;
    }

    .conference-radio-visual {
        width: 24px;
        height: 24px;
        border-radius: 999px;
        border: 2px solid #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
    }

    .conference-radio-visual span {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: transparent;
        transition: all 0.2s ease;
    }

    .conference-select-card.is-selected .conference-radio-visual {
        border-color: #0d6efd;
    }

    .conference-select-card.is-selected .conference-radio-visual span {
        background: #0d6efd;
    }

    .conference-date-box {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(13, 110, 253, 0.09);
        color: #0d6efd;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

    .conference-date-box strong {
        font-size: 1.25rem;
        font-weight: 900;
    }

    .conference-date-box span {
        margin-top: 0.2rem;
        font-size: 0.7rem;
        font-weight: 900;
    }

    .conference-main-info {
        min-width: 0;
    }

    .conference-title-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-wrap: wrap;
    }

    .conference-title-row h6 {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        line-height: 1.35;
        margin: 0;
    }

    .conference-status-pill {
        min-height: 26px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0 0.65rem;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border: 1px solid rgba(34, 197, 94, 0.18);
        font-size: 0.72rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .conference-status-pill i {
        font-size: 0.45rem;
    }

    .conference-meta-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 0.45rem;
    }

    .conference-meta-row span {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .conference-meta-row i {
        color: #0d6efd;
    }

    .conference-site-area {
        display: flex;
        justify-content: flex-end;
    }

    .conference-site-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0 0.95rem;
        border-radius: 14px;
        border: 1px solid #dbe4ef;
        background: #ffffff;
        color: #475569;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 900;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .conference-site-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.28);
        background: #f8fbff;
        transform: translateY(-1px);
        text-decoration: none;
    }

    .conference-no-site {
        color: #94a3b8;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .conference-list-footer {
        padding: 1.1rem 1.35rem;
        border-top: 1px solid #e2e8f0;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .selected-info-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 800;
    }

    .footer-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .select-cancel-btn,
    .select-continue-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0 1.2rem;
        border-radius: 999px;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .select-cancel-btn {
        border: 1px solid #dbe4ef;
        background: #ffffff;
        color: #0f172a;
    }

    .select-cancel-btn:hover {
        color: #0d6efd;
        background: #f8fbff;
        border-color: rgba(13, 110, 253, 0.25);
        text-decoration: none;
    }

    .select-continue-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        min-width: 180px;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.22);
    }

    .select-continue-btn:hover:not(:disabled) {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 18px 34px rgba(13, 110, 253, 0.28);
    }

    .select-continue-btn:disabled {
        opacity: 0.48;
        cursor: not-allowed;
        box-shadow: none;
    }

    .conference-empty-state,
    .conference-no-result {
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
    }

    .conference-empty-state h4,
    .conference-no-result h4 {
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .conference-empty-state p,
    .conference-no-result p {
        color: #64748b;
        font-weight: 650;
        margin: 0 auto;
        max-width: 520px;
        line-height: 1.65;
    }

    @@media (max-width: 1200px) {
        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-left {
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .conference-select-card {
            grid-template-columns: 30px 58px 1fr;
        }

        .conference-site-area {
            grid-column: 1 / -1;
            justify-content: flex-start;
            padding-left: 88px;
        }

        .conference-site-btn {
            width: 100%;
        }

        .conference-list-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .footer-actions,
        .footer-actions a,
        .footer-actions button {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .select-conference-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-stat-grid {
            grid-template-columns: 1fr;
        }

        .admin-filter-btn,
        .admin-reset-btn,
        .admin-hero-btn {
            width: 100%;
        }

        .conference-list-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 576px) {
        .conference-select-card {
            grid-template-columns: 28px 1fr;
        }

        .conference-date-box {
            display: none;
        }

        .conference-site-area {
            padding-left: 0;
        }
    }

    /* ── Dark Mode ── */
    [data-theme="dark"] .admin-hero {
        background: radial-gradient(circle at top right, rgba(0,174,239,0.08), transparent 34%),
                    linear-gradient(135deg, #1e293b, #0f172a);
        border-color: #334155;
    }
    [data-theme="dark"] .admin-hero-title { color: #f1f5f9; }
    [data-theme="dark"] .admin-hero-lead { color: #94a3b8; }
    [data-theme="dark"] .admin-hero-kicker { color: #94a3b8; }
    [data-theme="dark"] .admin-hero-btn-light {
        background: #334155; color: #e2e8f0; border-color: #475569;
    }
    [data-theme="dark"] .admin-hero-btn-light:hover { background: #475569; }
    [data-theme="dark"] .admin-stat-card {
        background: #1e293b; border-color: #334155;
    }
    [data-theme="dark"] .admin-stat-value { color: #f1f5f9; }
    [data-theme="dark"] .admin-stat-label { color: #94a3b8; }
    [data-theme="dark"] .admin-filter-card {
        background: #1e293b; border-color: #334155;
    }
    [data-theme="dark"] .admin-filter-label { color: #94a3b8; }
    [data-theme="dark"] .admin-filter-control,
    [data-theme="dark"] .admin-input-wrap input {
        background: #0f172a; border-color: #334155; color: #e2e8f0;
    }
    [data-theme="dark"] .admin-input-wrap i { color: #64748b; }
    [data-theme="dark"] .admin-reset-btn {
        background: #334155; border-color: #475569; color: #94a3b8;
    }
    [data-theme="dark"] .conference-list-card {
        background: #1e293b; border-color: #334155;
    }
    [data-theme="dark"] .conference-list-header h5 { color: #f1f5f9; }
    [data-theme="dark"] .conference-list-header p { color: #94a3b8; }
    [data-theme="dark"] .conference-count-pill {
        background: #334155; color: #94a3b8;
    }
    [data-theme="dark"] .conference-select-card {
        background: #0f172a; border-color: #334155;
    }
    [data-theme="dark"] .conference-select-card:hover { border-color: #475569; }
    [data-theme="dark"] .conference-select-card h6 { color: #f1f5f9; }
    [data-theme="dark"] .conference-meta-row span { color: #94a3b8; }
    [data-theme="dark"] .conference-status-pill { color: #94a3b8; }
    [data-theme="dark"] .conference-date-box {
        background: #334155; color: #e2e8f0;
    }
    [data-theme="dark"] .conference-site-btn {
        background: #334155; border-color: #475569; color: #e2e8f0;
    }
    [data-theme="dark"] .conference-list-footer {
        background: #0f172a; border-color: #334155;
    }
    [data-theme="dark"] .conference-list-footer button {
        color: #e2e8f0;
    }
    [data-theme="dark"] .conference-empty-state { color: #64748b; }
    [data-theme="dark"] .conference-no-result {
        background: #0f172a; border-color: #334155; color: #94a3b8;
    }
</style>

<div class="select-conference-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-calendar-check"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    @Localizer["HeroKicker"]
                </div>

                <h3 class="admin-hero-title">
                    @Model.Title
                </h3>

                <p class="admin-hero-lead">
                    @Model.Lead
                </p>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="/Admin"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToPanel"]
            </a>
        </div>
    </div>

    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-calendar-days"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @totalConferenceCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["TotalConferences"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-play-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @activeConferenceCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["Ongoing"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-clock"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @upcomingConferenceCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["Upcoming"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-orange">
                <i class="fas fa-building"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @tenantCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["Institution"]
                </div>
            </div>
        </div>
    </div>

    <div class="admin-filter-card">
        <div class="row g-3 align-items-end">

            <div class="col-xl-5 col-lg-5">
                <label class="admin-filter-label">
                    @Localizer["Search"]
                </label>

                <div class="admin-input-wrap">
                    <i class="fas fa-search"></i>

                    <input type="text"
                           id="conferenceSearchInput"
                           placeholder="@Localizer["SearchPlaceholder"]" />
                </div>
            </div>

            <div class="col-xl-4 col-lg-4">
                <label class="admin-filter-label">
                    @Localizer["Institution"]
                </label>

                <select id="tenantFilterSelect" class="form-select admin-filter-control">
                    <option value="">@Localizer["AllInstitutions"]</option>

                    @foreach (var tenantSlug in conferences
                                        .Where(x => x.Tenant != null && !string.IsNullOrWhiteSpace(x.Tenant.Slug))
                                        .Select(x => x.Tenant!.Slug)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option value="@tenantSlug">
                            /@tenantSlug
                        </option>
                    }
                </select>
            </div>

            <div class="col-xl-2 col-lg-2">
                <button type="button"
                        id="filterConferenceButton"
                        class="admin-filter-btn w-100">
                    <i class="fas fa-search"></i>
                    @Localizer["Filter"]
                </button>
            </div>

            <div class="col-xl-1 col-lg-1">
                <button type="button"
                        id="resetConferenceButton"
                        class="admin-reset-btn w-100"
                        title="@Localizer["Clear"]">
                    <i class="fas fa-rotate-left"></i>
                </button>
            </div>

        </div>
    </div>

    <form method="post" action="@Model.PostUrl" id="selectConferenceForm">
        @Html.AntiForgeryToken()

        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div class="conference-list-card">
            <div class="conference-list-header">
                <div>
                    <h5>
                        @Localizer["ConferenceList"]
                    </h5>

                    <p>
                        @Localizer["SelectInstruction"]
                    </p>
                </div>

                <div class="conference-count-pill">
                    <i class="fas fa-list-ul"></i>
                    <span id="visibleConferenceCount">@conferences.Count</span> / @conferences.Count @Localizer["Conferences"]
                </div>
            </div>

            @if (!conferences.Any())
            {
                <div class="conference-empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-calendar-xmark"></i>
                    </div>

                    <h4>
                        @Localizer["EmptyTitle"]
                    </h4>

                    <p>
                        @Localizer["EmptyDescription"]
                    </p>
                </div>
            }
            else
            {
                <div class="conference-card-list" id="conferenceCardList">

                    @foreach (var conference in conferences)
                    {
                        var confSlug = !string.IsNullOrWhiteSpace(conference.Slug) ? conference.Slug : (conference.Tenant?.Slug ?? "");
                        var siteUrl = string.IsNullOrWhiteSpace(confSlug) ? "#" : $"/{confSlug}";

                        <label class="conference-select-card"
                               data-title="@conference.Title"
                               data-slug="@confSlug"
                               data-search="@($"{conference.Title} {confSlug} {conference.StartDate:dd.MM.yyyy} {conference.EndDate:dd.MM.yyyy}")">

                            <input type="radio"
                                   name="conferenceId"
                                   value="@conference.Id"
                                   class="conference-radio" />

                            <div class="conference-radio-visual">
                                <span></span>
                            </div>

                            <div class="conference-date-box">
                                <strong>@conference.StartDate.ToString("dd")</strong>
                                <span>@conference.StartDate.ToString("MMM").ToUpper()</span>
                            </div>

                            <div class="conference-main-info">
                                <div class="conference-title-row">
                                    <h6>
                                        @conference.Title
                                    </h6>

                                    <span class="conference-status-pill">
                                        <i class="fas fa-circle"></i>
                                        @Localizer["Active"]
                                    </span>
                                </div>

                                <div class="conference-meta-row">
                                    <span>
                                        <i class="fas fa-link"></i>
                                        Slug: @(string.IsNullOrWhiteSpace(confSlug) ? Localizer["NotSpecified"].Value : confSlug)
                                    </span>

                                    <span>
                                        <i class="fas fa-calendar-days"></i>
                                        @conference.StartDate.ToString("dd.MM.yyyy") - @conference.EndDate.ToString("dd.MM.yyyy")
                                    </span>
                                </div>
                            </div>

                            <div class="conference-site-area">
                                @if (!string.IsNullOrWhiteSpace(confSlug))
                                {
                                    <a href="@siteUrl"
                                       target="_blank"
                                       class="conference-site-btn"
                                       onclick="event.stopPropagation();">
                                        <i class="fas fa-external-link-alt"></i>
                                        @Localizer["ViewSite"]
                                    </a>
                                }
                                else
                                {
                                    <span class="conference-no-site">
                                        Site yok
                                    </span>
                                }
                            </div>

                        </label>
                    }

                </div>

                <div class="conference-no-result" id="conferenceNoResult" style="display:none;">
                    <div class="empty-icon">
                        <i class="fas fa-magnifying-glass"></i>
                    </div>

                    <h4>
                        @Localizer["FilterEmptyTitle"]
                    </h4>

                    <p>
                        @Localizer["FilterEmptyDescription"]
                    </p>
                </div>
            }

            <div class="conference-list-footer">
                <div class="selected-info-text" id="selectedConferenceText">
                    @Localizer["SelectPrompt"]
                </div>

                <div class="footer-actions">
                    <a href="/Admin" class="select-cancel-btn">
                        @Localizer["Cancel"]
                    </a>

                    <button type="submit"
                            id="continueButton"
                            class="select-continue-btn"
                            disabled>
                        <i class="fas fa-arrow-right"></i>
                        @submitText
                    </button>
                </div>
            </div>
        </div>
    </form>

</div>

@section Scripts {
    <script>
        // Bu metin sunucuda çözülüp JS'e sabit olarak gömülüyor. Eskiden burada
        // doğrudan C# çağrısı vardı (Localizer.GetString(...)); tarayıcıda
        // "Localizer is not defined" fırlatıyor, seçim fonksiyonu o satırda
        // kesiliyor ve hemen altındaki "Devam Et" butonunu aktifleştiren satır
        // hiç çalışmıyordu. Kongre seçilse de buton pasif kalıyordu.
        const selectedConferencePrefix = @Json.Serialize(Localizer["SelectedConference"].Value);

        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("conferenceSearchInput");
            const tenantFilter = document.getElementById("tenantFilterSelect");
            const filterButton = document.getElementById("filterConferenceButton");
            const resetButton = document.getElementById("resetConferenceButton");
            const cards = Array.from(document.querySelectorAll(".conference-select-card"));
            const radios = Array.from(document.querySelectorAll(".conference-radio"));
            const continueButton = document.getElementById("continueButton");
            const selectedText = document.getElementById("selectedConferenceText");
            const visibleCount = document.getElementById("visibleConferenceCount");
            const noResult = document.getElementById("conferenceNoResult");

            function normalize(value) {
                return (value || "")
                    .toString()
                    .toLocaleLowerCase("tr-TR")
                    .trim();
            }

            function updateSelection(selectedCard) {
                cards.forEach(function (card) {
                    card.classList.remove("is-selected");
                });

                if (selectedCard) {
                    selectedCard.classList.add("is-selected");

                    const radio = selectedCard.querySelector(".conference-radio");

                    if (radio) {
                        radio.checked = true;
                    }

                    const titleElement = selectedCard.querySelector(".conference-title-row h6");
                    const title = titleElement ? titleElement.innerText.trim() : "Kongre";

                    if (selectedText) {
                        selectedText.innerText = selectedConferencePrefix + title;
                    }

                    if (continueButton) {
                        continueButton.disabled = false;
                    }
                }
            }

            function applyFilters() {
                const query = normalize(searchInput ? searchInput.value : "");
                const selectedTenant = normalize(tenantFilter ? tenantFilter.value : "");

                let count = 0;

                cards.forEach(function (card) {
                    const searchData = normalize(card.getAttribute("data-search"));
                    const slug = normalize(card.getAttribute("data-slug"));

                    const matchesSearch = !query || searchData.includes(query);
                    const matchesTenant = !selectedTenant || slug === selectedTenant;

                    const visible = matchesSearch && matchesTenant;

                    card.style.display = visible ? "" : "none";

                    if (visible) {
                        count++;
                    }
                });

                if (visibleCount) {
                    visibleCount.innerText = count;
                }

                if (noResult) {
                    noResult.style.display = count === 0 ? "block" : "none";
                }
            }

            cards.forEach(function (card) {
                card.addEventListener("click", function () {
                    updateSelection(card);
                });
            });

            radios.forEach(function (radio) {
                radio.addEventListener("change", function () {
                    const card = radio.closest(".conference-select-card");
                    updateSelection(card);
                });
            });

            if (filterButton) {
                filterButton.addEventListener("click", applyFilters);
            }

            if (searchInput) {
                searchInput.addEventListener("keyup", applyFilters);
            }

            if (tenantFilter) {
                tenantFilter.addEventListener("change", applyFilters);
            }

            if (resetButton) {
                resetButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                    }

                    if (tenantFilter) {
                        tenantFilter.value = "";
                    }

                    applyFilters();
                });
            }
        });
    </script>
}
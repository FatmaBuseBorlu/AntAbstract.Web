@model AntAbstract.Domain.Entities.ConferencePageBlock
@using System.Text.Json
@using AntAbstract.Web.Models.ViewModels.Website
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject AntAbstract.Infrastructure.Context.TenantContext Tc

@{
    HeroBlockContentDto content = new();

    if (!string.IsNullOrWhiteSpace(Model.ContentJson))
    {
        try
        {
            content = JsonSerializer.Deserialize<HeroBlockContentDto>(
                Model.ContentJson,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }
            ) ?? new HeroBlockContentDto();
        }
        catch
        {
            content = new HeroBlockContentDto();
        }
    }

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var title = Model.Title ?? "";
    var subtitle = Model.Subtitle ?? "";

    var slug =
        ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Tc.Current?.Slug
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var registrationUrl = !string.IsNullOrWhiteSpace(slug)
        ? $"/{slug}/registration"
        : "/Home/Congresses";

    var bg = content.BackgroundImageUrl;

    /*
        Not:
        Bu hero butonu artık admin paneldeki ContentJson içindeki ButtonText/ButtonUrl değerini kullanmaz.
        Çünkü bu alanı sabit olarak "Kongreye Kayıt Ol" aksiyonuna ayırıyoruz.
        Özet/Bildiri gönderme butonu ise sağdaki kırmızı butonda kalacak.
    */
    var btnText = L("RegisterForCongressButton", "Kongreye Kayıt Ol");
    var btnUrl = registrationUrl;
}

<section class="py-5"
         style="@(string.IsNullOrWhiteSpace(bg) ? "" : $"background-image:url('{bg}'); background-size:cover; background-position:center;")">

    <div class="container">
        <div class="p-5 rounded-4 bg-white bg-opacity-75">
            <h2 class="mb-2">
                @title
            </h2>

            @if (!string.IsNullOrWhiteSpace(subtitle))
            {
                <p class="mb-4">
                    @subtitle
                </p>
            }

            <a class="btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm"
               href="@btnUrl">
                <i class="fas fa-user-plus me-2 text-info"></i>
                @btnText
            </a>
        </div>
    </div>
</section>
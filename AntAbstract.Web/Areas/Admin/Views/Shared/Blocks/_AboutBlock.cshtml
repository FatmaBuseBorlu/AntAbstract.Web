@model AntAbstract.Domain.Entities.ConferencePageBlock
@using System.Text.Json
@using AntAbstract.Web.Models.WebsiteBlocks

@{
    AboutBlockContent? content = null;

    if (!string.IsNullOrWhiteSpace(Model.ContentJson))
    {
        try
        {
            content = JsonSerializer.Deserialize<AboutBlockContent>(
                Model.ContentJson,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch { }
    }
}

<div id="block-@Model.Id" class="content-card">

    <h3 class="content-title">@Model.Title</h3>

    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 text-primary fw-bold">
            <i class="fas fa-info-circle me-2"></i> @Model.Subtitle
        </div>
    }

    <div class="row g-4 align-items-center">

        @if (content != null && !string.IsNullOrWhiteSpace(content.ImageUrl))
        {
            <div class="col-md-7">
                <div class="content-text">
                    @if (!string.IsNullOrWhiteSpace(content.Description))
                    {
                        @Html.Raw(content.Description.Replace("\n", "<br/>"))
                    }
                    else
                    {
                        <p class="text-muted"><em>@Localizer["EmptyContentMessage"]</em></p>
                    }
                </div>
            </div>
            <div class="col-md-5 text-center">
                <img src="@content.ImageUrl"
                     class="img-fluid rounded-4 shadow-sm border p-1"
                     alt="@Model.Title"
                     style="max-height: 250px; object-fit: cover;" />
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="content-text">
                    @if (content != null && !string.IsNullOrWhiteSpace(content.Description))
                    {
                        @Html.Raw(content.Description.Replace("\n", "<br/>"))
                    }
                    else
                    {
                        <p class="text-muted"><em>@Localizer["EmptyContentMessage"]</em></p>
                    }
                </div>
            </div>
        }
    </div>

    @if (content != null && content.Features != null && content.Features.Any(f => !string.IsNullOrWhiteSpace(f)))
    {
        <div class="row mt-4 g-3">
            @foreach (var feature in content.Features.Where(f => !string.IsNullOrWhiteSpace(f)))
            {
                <div class="col-sm-12">
                    <div class="d-flex align-items-center bg-light p-3 rounded-3 border">
                        <i class="fas fa-check-circle text-success fs-4 me-3"></i>
                        <span class="fw-bold text-dark">@feature</span>
                    </div>
                </div>
            }
        </div>
    }
</div>
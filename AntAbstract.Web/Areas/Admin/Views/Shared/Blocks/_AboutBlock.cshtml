@model AntAbstract.Domain.Entities.ConferencePageBlock
@using System.Text.Json
@using AntAbstract.Web.Models.WebsiteBlocks

@{
    AboutBlockContent? content = null;

    if (!string.IsNullOrWhiteSpace(Model.ContentJson))
    {
        try
        {
            content = JsonSerializer.Deserialize<AboutBlockContent>(Model.ContentJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch { }
    }
}

<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-4">

            <div class="col-md-7">
                <h2 class="fw-bold mb-3">@Model.Title</h2>

                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    <p class="text-muted mb-4 fs-5">@Model.Subtitle</p>
                }

                @if (content != null && !string.IsNullOrWhiteSpace(content.Description))
                {
                    <p class="lead" style="text-align: justify;">@content.Description</p>
                }
                else
                {
                    <p class="text-muted"><em>Hakkımızda içeriği henüz girilmedi.</em></p>
                }

                @if (content != null && content.Features != null && content.Features.Any(f => !string.IsNullOrWhiteSpace(f)))
                {
                    <ul class="list-unstyled mt-4 fs-5">
                        @foreach (var feature in content.Features.Where(f => !string.IsNullOrWhiteSpace(f)))
                        {
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i> @feature
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="col-md-5 text-center">
                @if (content != null && !string.IsNullOrWhiteSpace(content.ImageUrl))
                {
                    <img src="@content.ImageUrl" class="img-fluid rounded-4 shadow-lg" alt="Hakkımızda Görseli" style="max-height: 400px; object-fit: cover;" />
                }
                else
                {
                    <div class="p-5 bg-light rounded-4 shadow-sm border border-dashed">
                        <i class="fas fa-image fa-3x text-muted mb-2"></i>
                        <p class="text-muted mb-0">Görsel Yüklenmedi</p>
                    </div>
                }
            </div>

        </div>
    </div>
</section>
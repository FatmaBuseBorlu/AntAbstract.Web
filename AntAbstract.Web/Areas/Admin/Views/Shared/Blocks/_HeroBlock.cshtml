@model AntAbstract.Domain.Entities.ConferencePageBlock
@using System.Text.Json
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string? buttonText = null;
    string? buttonUrl = null;
    string? imageUrl = null;
    string? backgroundImageUrl = null;

    string? ResolveUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return url;

        if (url.StartsWith("~/"))
            return Url.Content(url);

        if (url.StartsWith("/"))
            return url;

        return "/" + url.TrimStart('/');
    }

    string? GetStringProp(JsonElement root, params string[] names)
    {
        foreach (var n in names)
        {
            if (root.TryGetProperty(n, out var v) && v.ValueKind == JsonValueKind.String)
                return v.GetString();
        }
        return null;
    }

    if (!string.IsNullOrWhiteSpace(Model.ContentJson))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.ContentJson);
            var root = doc.RootElement;

            buttonText = GetStringProp(root, "buttonText", "ButtonText");
            buttonUrl = GetStringProp(root, "buttonUrl", "ButtonUrl");
            imageUrl = GetStringProp(root, "imageUrl", "ImageUrl");
            backgroundImageUrl = GetStringProp(root, "backgroundImageUrl", "BackgroundImageUrl");
        }
        catch
        {
        }
    }

    var bg = ResolveUrl(backgroundImageUrl);
    var img = ResolveUrl(imageUrl);
    var btnUrl = ResolveUrl(buttonUrl);

    var bgStyle = !string.IsNullOrWhiteSpace(bg)
        ? $"background-image:url('{bg}'); background-size:cover; background-position:center;"
        : "background:#f6f7fb;";
}

<section class="p-5 rounded-4 mb-4" style="@bgStyle">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <h1 class="display-6 fw-bold mb-2">@Model.Title</h1>

                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    <p class="lead mb-4">@Model.Subtitle</p>
                }

                @if (!string.IsNullOrWhiteSpace(buttonText) && !string.IsNullOrWhiteSpace(btnUrl))
                {
                    <a class="btn btn-primary btn-lg" href="@btnUrl">@buttonText</a>
                }
            </div>

            <div class="col-md-5 text-center">
                @if (!string.IsNullOrWhiteSpace(img))
                {
                    <img src="@img" class="img-fluid rounded-4 shadow" alt="@Localizer["HeroImageAlt"]" />
                }
            </div>
        </div>
    </div>
</section>
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var slug = ViewBag.Slug as string ?? "";
    var isSuperAdmin = User.IsInRole("SuperAdmin");

    // Modül tanımları: (ModülAdı, Açıklama, SuperAdmin, Admin, Author, Referee, Listener)
    // Değerler: "full" | "read" | "own" | "-"
    var modules = new[]
    {
        // Sistem yönetimi
        new { Group = Localizer.GetString("PM_GroupSystem").Value, Name = Localizer.GetString("PM_TenantMgmt").Value,       Desc = Localizer.GetString("PM_TenantDesc").Value,       SA = "full", Ad = "-",      Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSystem").Value, Name = Localizer.GetString("PM_UserMgmt").Value,    Desc = Localizer.GetString("PM_UserDesc").Value,     SA = "full", Ad = "-",      Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSystem").Value, Name = Localizer.GetString("PM_AllConf").Value,         Desc = Localizer.GetString("PM_AllConfDesc").Value,  SA = "full", Ad = "-",      Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSystem").Value, Name = Localizer.GetString("PM_Stats").Value,      Desc = Localizer.GetString("PM_StatsDesc").Value,         SA = "full", Ad = "-",      Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSystem").Value, Name = Localizer.GetString("PM_EmailTemplates").Value,    Desc = Localizer.GetString("PM_EmailDesc").Value,       SA = "full", Ad = "-",      Au = "-",    Re = "-",    Li = "-"    },
        // Kongre yönetimi
        new { Group = Localizer.GetString("PM_GroupConference").Value, Name = Localizer.GetString("PM_ConferenceMgmt").Value,       Desc = Localizer.GetString("PM_ConferenceMgmtDesc").Value,            SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupConference").Value, Name = Localizer.GetString("PM_Wizard").Value, Desc = Localizer.GetString("PM_WizardDesc").Value,       SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupConference").Value, Name = Localizer.GetString("PM_RegTypes").Value,         Desc = Localizer.GetString("PM_RegTypesDesc").Value,            SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupConference").Value, Name = Localizer.GetString("PM_Sessions").Value,       Desc = Localizer.GetString("PM_SessionsDesc").Value,             SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupConference").Value, Name = Localizer.GetString("PM_Speakers").Value,  Desc = "Speaker CRUD",                   SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupConference").Value, Name = Localizer.GetString("PM_Sponsors").Value,             Desc = "Sponsor CRUD",                   SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupConference").Value, Name = Localizer.GetString("PM_Website").Value,      Desc = Localizer.GetString("PM_WebsiteDesc").Value,      SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        // Bildiri süreci
        new { Group = Localizer.GetString("PM_GroupSubmission").Value, Name = Localizer.GetString("PM_SubmissionsAdmin").Value, Desc = Localizer.GetString("PM_AllSubDesc").Value,  SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSubmission").Value, Name = Localizer.GetString("PM_Submit").Value,    Desc = Localizer.GetString("PM_SubmitDesc").Value,       SA = "full", Ad = "full",   Au = "own",  Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSubmission").Value, Name = Localizer.GetString("PM_RefAssign").Value,          Desc = Localizer.GetString("PM_RefAssignDesc").Value,             SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSubmission").Value, Name = Localizer.GetString("PM_Review").Value,  Desc = Localizer.GetString("PM_ReviewDesc").Value, SA = "full", Ad = "read",   Au = "-",    Re = "own",  Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSubmission").Value, Name = Localizer.GetString("PM_Decision").Value,       Desc = Localizer.GetString("PM_DecisionDesc").Value,               SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupSubmission").Value, Name = Localizer.GetString("PM_ProceedingBook").Value,       Desc = Localizer.GetString("PM_BookDesc").Value,          SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        // Kayıt & ödeme
        new { Group = Localizer.GetString("PM_GroupRegistration").Value, Name = Localizer.GetString("PM_RegPaymentAdmin").Value, Desc = Localizer.GetString("PM_RegPaymentAdminDesc").Value,            SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupRegistration").Value, Name = Localizer.GetString("PM_RegUser").Value, Desc = Localizer.GetString("PM_RegUserDesc").Value,   SA = "full", Ad = "full",   Au = "own",  Re = "own",  Li = "own"  },
        new { Group = Localizer.GetString("PM_GroupRegistration").Value, Name = Localizer.GetString("PM_Accommodation").Value, Desc = Localizer.GetString("PM_AccommodationDesc").Value,         SA = "full", Ad = "full",   Au = "own",  Re = "own",  Li = "own"  },
        new { Group = Localizer.GetString("PM_GroupRegistration").Value, Name = Localizer.GetString("PM_Finance").Value,       Desc = Localizer.GetString("PM_FinanceDesc").Value,            SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        //  & 
        new { Group = Localizer.GetString("PM_GroupOther").Value, Name = Localizer.GetString("PM_Certificate").Value,              Desc = Localizer.GetString("PM_CertificateDesc").Value,    SA = "full", Ad = "full",   Au = "own",  Re = "own",  Li = "own"  },
        new { Group = Localizer.GetString("PM_GroupOther").Value, Name = Localizer.GetString("PM_ReportsAdmin").Value,       Desc = Localizer.GetString("PM_ReportsAdminDesc").Value,               SA = "full", Ad = "full",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupOther").Value, Name = Localizer.GetString("PM_Survey").Value,                  Desc = Localizer.GetString("PM_SurveyDesc").Value,              SA = "full", Ad = "read",   Au = "own",  Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupOther").Value, Name = Localizer.GetString("PM_Notifications").Value,            Desc = Localizer.GetString("PM_NotificationsDesc").Value,            SA = "full", Ad = "full",   Au = "own",  Re = "own",  Li = "own"  },
        new { Group = Localizer.GetString("PM_GroupOther").Value, Name = Localizer.GetString("PM_ActivityLog").Value,       Desc = "Audit log",                      SA = "full", Ad = "read",   Au = "-",    Re = "-",    Li = "-"    },
        new { Group = Localizer.GetString("PM_GroupOther").Value, Name = Localizer.GetString("PM_Profile").Value,                 Desc = Localizer.GetString("PM_ProfileDesc").Value,        SA = "full", Ad = "full",   Au = "own",  Re = "own",  Li = "own"  },
    };

    var groups = modules.Select(m => m.Group).Distinct().ToList();

    string Badge(string val) => val switch
    {
        "full" => $"<span class='pm-badge pm-full'>{Localizer.GetString("PM_FullAccess").Value}</span>",
        "read" => $"<span class='pm-badge pm-read'>{Localizer.GetString("PM_ReadOnly").Value}</span>",
        "own"  => $"<span class='pm-badge pm-own'>{Localizer.GetString("PM_OwnOnly").Value}</span>",
        _      => "<span class='pm-badge pm-none'>—</span>"
    };
}

<style>
    .pm-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .pm-full { background: #dcfce7; color: #15803d; }
    .pm-read { background: #dbeafe; color: #1d4ed8; }
    .pm-own  { background: #fef9c3; color: #92400e; }
    .pm-none { background: #f1f5f9; color: #94a3b8; }

    .pm-group-header th {
        background: #f8fafc;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #64748b;
        padding: 10px 16px !important;
    }

    .pm-table th, .pm-table td { vertical-align: middle; }
    .pm-role-col { text-align: center; min-width: 110px; }
    .pm-name { font-weight: 600; font-size: 0.9rem; }
    .pm-desc { font-size: 0.78rem; color: #94a3b8; }

    .pm-legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.8rem; }
</style>

<div class="container-fluid px-4 py-4">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div>
                <div class="admin-hero-kicker">SYSTEM</div>
                <h3 class="admin-hero-title">@Localizer["PermissionMatrix"]</h3>
                <p class="admin-hero-lead">@Localizer["PermissionMatrixDesc"]</p>
            </div>
        </div>
        @if (isSuperAdmin)
        {
            <div class="admin-hero-actions">
                <a href="/@slug/Admin/Users" class="admin-hero-btn admin-hero-btn-primary">
                    <i class="fas fa-users"></i> @Localizer["UserRoleManagement"]
                </a>
            </div>
        }
    </div>

    <!-- Efsane -->
    <div class="pm-legend mb-4">
        <span class="pm-badge pm-full">@Localizer["PM_FullAccess"]</span> — @Localizer["LegendFull"]
        <span class="pm-badge pm-read">@Localizer["PM_ReadOnly"]</span> — @Localizer["LegendRead"]
        <span class="pm-badge pm-own">@Localizer["PM_OwnOnly"]</span> — @Localizer["LegendOwn"]
        <span class="pm-badge pm-none">—</span> — @Localizer["LegendNone"]
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0 pm-table">
                <thead>
                    <tr class="table-dark">
                        <th style="min-width:220px;">@Localizer["Module"]</th>
                        <th class="pm-role-col"><i class="fas fa-crown me-1 text-warning"></i>SuperAdmin</th>
                        <th class="pm-role-col"><i class="fas fa-user-shield me-1 text-primary"></i>Admin</th>
                        <th class="pm-role-col"><i class="fas fa-pen me-1 text-info"></i>Author</th>
                        <th class="pm-role-col"><i class="fas fa-user-graduate me-1 text-success"></i>Referee</th>
                        <th class="pm-role-col"><i class="fas fa-user me-1 text-secondary"></i>Listener</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in groups)
                    {
                        <tr class="pm-group-header">
                            <th colspan="6">@group</th>
                        </tr>
                        @foreach (var m in modules.Where(x => x.Group == group))
                        {
                            <tr>
                                <td>
                                    <div class="pm-name">@m.Name</div>
                                    <div class="pm-desc">@m.Desc</div>
                                </td>
                                <td class="pm-role-col">@Html.Raw(Badge(m.SA))</td>
                                <td class="pm-role-col">@Html.Raw(Badge(m.Ad))</td>
                                <td class="pm-role-col">@Html.Raw(Badge(m.Au))</td>
                                <td class="pm-role-col">@Html.Raw(Badge(m.Re))</td>
                                <td class="pm-role-col">@Html.Raw(Badge(m.Li))</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-3">
        <i class="fas fa-info-circle me-1"></i>
        @Localizer["MatrixFootnote"]
        <a href="/@slug/Admin/Users">@Localizer["UserManagement"]</a>
    </p>
</div>

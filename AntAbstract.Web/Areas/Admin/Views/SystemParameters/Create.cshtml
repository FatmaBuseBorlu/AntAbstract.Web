@model AntAbstract.Domain.Entities.SystemParameter
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var groups = new List<SelectListItem>
    {
        new SelectListItem
        {
            Text = isEnglish ? "University / Institution" : "Üniversite / Kurum",
            Value = "University"
        },
        new SelectListItem
        {
            Text = isEnglish ? "Faculty" : "Fakülte",
            Value = "Faculty"
        },
        new SelectListItem
        {
            Text = isEnglish ? "Department / Specialty" : "Bölüm / Uzmanlık",
            Value = "Department"
        },
        new SelectListItem
        {
            Text = isEnglish ? "Academic Title" : "Akademik Ünvan",
            Value = "Title"
        }
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">
            @Localizer["PageTitle"]
        </h3>

        <p class="text-muted small mb-0">
            @Localizer["PageLead"]
        </p>
    </div>

    <a asp-action="Index"
       asp-route-group="@Model.Group"
       class="btn btn-light shadow-sm rounded-pill fw-bold px-4">
        <i class="fas fa-arrow-left me-2"></i>
        @Localizer["BackToListButton"]
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4"></div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Group" class="form-label fw-bold text-muted small">
                                @Localizer["GroupLabel"]
                            </label>

                            <select asp-for="Group"
                                    asp-items="groups"
                                    class="form-select bg-light border-0 py-2">
                            </select>

                            <span asp-validation-for="Group" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Order" class="form-label fw-bold text-muted small">
                                @Localizer["OrderLabel"]
                            </label>

                            <input asp-for="Order"
                                   type="number"
                                   class="form-control bg-light border-0 py-2"
                                   placeholder="@Localizer["OrderPlaceholder"]" />

                            <span asp-validation-for="Order" class="text-danger small"></span>

                            <small class="text-muted" style="font-size:0.75rem;">
                                @Localizer["OrderHelpText"]
                            </small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-muted small">
                            Name TR <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Name"
                               class="form-control bg-light border-0 py-3 fw-bold fs-5"
                               placeholder="Örn: Ankara Üniversitesi"
                               required />

                        <span asp-validation-for="Name" class="text-danger small"></span>

                        <small class="text-muted" style="font-size:0.75rem;">
                            Türkçe ekranda görünecek resmi ad.
                        </small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NameEn" class="form-label fw-bold text-muted small">
                            Name EN
                        </label>

                        <input asp-for="NameEn"
                               class="form-control bg-light border-0 py-3 fw-bold fs-5"
                               placeholder="Example: Ankara University" />

                        <span asp-validation-for="NameEn" class="text-danger small"></span>

                        <small class="text-muted" style="font-size:0.75rem;">
                            İngilizce ekranda gösterilecek karşılık. Boş bırakılırsa Türkçe ad gösterilir.
                        </small>
                    </div>

                    <div class="mb-5">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input"
                                   type="checkbox"
                                   asp-for="IsActive"
                                   id="IsActiveSwitch"
                                   style="cursor: pointer;" />

                            <label class="form-check-label ms-2 fs-6 text-dark"
                                   for="IsActiveSwitch"
                                   style="cursor: pointer;">
                                @Localizer["IsActiveLabel"]
                            </label>
                        </div>
                    </div>

                    <hr class="border-light mb-4" />

                    <div class="d-flex justify-content-end">
                        <button type="submit"
                                class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                            <i class="fas fa-save me-2"></i>
                            @Localizer["SaveButton"]
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 sticky-top"
             style="top: 100px;">
            <div class="card-body p-4">
                <h6 class="fw-bold text-primary mb-3">
                    <i class="fas fa-lightbulb me-2"></i>
                    Bilgilendirme
                </h6>

                <p class="text-dark opacity-75 small mb-3">
                    Sistem parametreleri kayıt formunda, profil alanlarında ve filtrelerde kullanılır.
                </p>

                <ul class="list-unstyled text-dark opacity-75 small mb-0">
                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        <strong>Name TR:</strong> Türkçe ekranda gösterilir.
                    </li>

                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        <strong>Name EN:</strong> İngilizce ekranda gösterilir.
                    </li>

                    <li class="mb-2">
                        <i class="fas fa-check text-success me-2"></i>
                        <strong>Order:</strong> Listede sıralama için kullanılır.
                    </li>

                    <li>
                        <i class="fas fa-check text-success me-2"></i>
                        <strong>Aktif:</strong> Pasif kayıtlar kullanıcıya gösterilmez.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<AntAbstract.Domain.Entities.SystemParameter>

@using System
@using System.Linq
@using AntAbstract.Domain.Entities


@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var parameters = Model?.ToList() ?? new List<SystemParameter>();

    var activeGroup = ViewBag.ActiveGroup?.ToString() ?? "University";
    var deleteConfirmMessage = Localizer["DeleteConfirmMessage"].Value;

    var totalCount = parameters.Count;
    var activeCount = parameters.Count(x => x.IsActive);
    var passiveCount = parameters.Count(x => !x.IsActive);
    var selectedGroupCount = parameters.Count(x => x.Group == activeGroup);

    var tabData = new[]
    {
        new
        {
            Id = "university",
            Title = Localizer["Tab_University"].Value,
            Icon = "fa-university",
            Group = "University",
            EmptyMsg = Localizer["Empty_University"].Value
        },
        new
        {
            Id = "faculty",
            Title = Localizer["Tab_Faculty"].Value,
            Icon = "fa-building",
            Group = "Faculty",
            EmptyMsg = Localizer["Empty_Faculty"].Value
        },
        new
        {
            Id = "department",
            Title = Localizer["Tab_Department"].Value,
            Icon = "fa-microscope",
            Group = "Department",
            EmptyMsg = Localizer["Empty_Department"].Value
        },
        new
        {
            Id = "title",
            Title = Localizer["Tab_Title"].Value,
            Icon = "fa-user-tag",
            Group = "Title",
            EmptyMsg = Localizer["Empty_Title"].Value
        }
    };
}

<style>
    .system-parameters-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .admin-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .admin-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .admin-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .admin-hero-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .admin-hero-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .admin-hero-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 860px;
    }

    .admin-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .admin-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .admin-hero-btn-light {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .admin-hero-btn-light:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .admin-hero-btn-primary {
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        border: none;
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.18);
    }

    .admin-hero-btn-primary:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.26);
        text-decoration: none;
    }

    .admin-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .admin-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 96px;
    }

    .admin-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .stat-slate {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
    }

    .admin-stat-value {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .admin-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.25rem;
    }

    .system-parameters-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .system-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .system-card-title {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 900;
        margin: 0 0 0.25rem;
    }

    .system-card-subtitle {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.55;
        margin-bottom: 0;
    }

    .system-card-count {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0 0.8rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .system-tabs {
        border-bottom: 1px solid #edf2f7;
        background: #ffffff;
    }

    .system-tabs .nav-link {
        border: none;
        border-radius: 0;
        color: #64748b;
        min-height: 58px;
        font-size: 0.86rem;
        font-weight: 900;
        transition: all 0.2s ease;
        position: relative;
    }

    .system-tabs .nav-link i {
        color: #64748b;
        transition: all 0.2s ease;
    }

    .system-tabs .nav-link:hover {
        color: #0d6efd;
        background: #f8fbff;
    }

    .system-tabs .nav-link:hover i {
        color: #0d6efd;
    }

    .system-tabs .nav-link.active {
        color: #0d6efd;
        background: #f8fbff;
    }

    .system-tabs .nav-link.active i {
        color: #0d6efd;
    }

    .system-tabs .nav-link.active::after {
        content: "";
        position: absolute;
        left: 18%;
        right: 18%;
        bottom: 0;
        height: 3px;
        border-radius: 999px 999px 0 0;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
    }

    .system-tab-toolbar {
        padding: 1.15rem 1.35rem;
        background: #f8fafc;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .system-total-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.48rem 0.85rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .system-create-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border: none;
        border-radius: 999px;
        padding: 0 1rem;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-size: 0.86rem;
        font-weight: 950;
        text-decoration: none;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.18);
        transition: all 0.2s ease;
    }

    .system-create-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(13, 110, 253, 0.24);
    }

    .system-table {
        margin-bottom: 0;
    }

    .system-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 1rem 1.15rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .system-table tbody td {
        padding: 0.95rem 1.15rem;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .system-table tbody tr:hover {
        background: #f8fbff;
    }

    .system-table tbody tr:last-child td {
        border-bottom: none;
    }

    .system-order-badge {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.82rem;
        font-weight: 950;
    }

    .system-param-name {
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 950;
    }

    .system-param-name-en {
        color: #334155;
        font-size: 0.88rem;
        font-weight: 650;
    }

    .system-empty-en {
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 700;
        font-style: italic;
    }

    .system-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        border-radius: 999px;
        padding: 0.4rem 0.72rem;
        font-size: 0.76rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .system-status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border: 1px solid rgba(34, 197, 94, 0.18);
    }

    .system-status-passive {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border: 1px solid rgba(100, 116, 139, 0.18);
    }

    .admin-action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.42rem;
    }

    .admin-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.84rem;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid transparent;
        background: #ffffff;
        transition: all 0.2s ease;
        line-height: 1;
        padding: 0;
    }

    .admin-action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.10);
    }

    .admin-action-edit {
        color: #f59e0b;
        border-color: rgba(245, 158, 11, 0.35);
    }

    .admin-action-edit:hover {
        background: rgba(245, 158, 11, 0.10);
        color: #d97706;
    }

    .admin-action-sync {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.28);
    }

    .admin-action-sync:hover {
        background: rgba(13, 110, 253, 0.08);
        color: #0b5ed7;
    }

    .admin-action-delete {
        color: #dc3545;
        border-color: rgba(220, 53, 69, 0.30);
    }

    .admin-action-delete:hover {
        background: rgba(220, 53, 69, 0.08);
        color: #bb2d3b;
    }

    .system-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        color: #64748b;
    }

    .system-empty-state-icon {
        width: 76px;
        height: 76px;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .system-empty-state p {
        margin-bottom: 0;
        font-size: 0.92rem;
        font-weight: 700;
    }

    @@media (max-width: 1200px) {
        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .system-parameters-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-stat-grid {
            grid-template-columns: 1fr;
        }

        .system-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .system-tabs .nav-link {
            font-size: 0.78rem;
            padding-left: 0.35rem;
            padding-right: 0.35rem;
        }

        .system-table tbody td {
            min-width: 140px;
        }
    }
</style>

<div class="system-parameters-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-sliders-h"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    Sistem
                </div>

                <h3 class="admin-hero-title">
                    @Localizer["PageTitle"]
                </h3>

                <p class="admin-hero-lead">
                    @Localizer["PageLead"]
                </p>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a asp-action="Create"
               asp-route-group="@activeGroup"
               class="admin-hero-btn admin-hero-btn-primary">
                <i class="fas fa-plus"></i>
                @Localizer["AddNewButton"]
            </a>

            <a href="/Admin/AllConferences"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-calendar-alt"></i>
                Tüm Kongreler
            </a>
        </div>
    </div>

    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-database"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @totalCount
                </div>

                <div class="admin-stat-label">
                    Toplam Parametre
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-check-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @activeCount
                </div>

                <div class="admin-stat-label">
                    Aktif Parametre
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-slate">
                <i class="fas fa-circle-minus"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @passiveCount
                </div>

                <div class="admin-stat-label">
                    Pasif Parametre
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @selectedGroupCount
                </div>

                <div class="admin-stat-label">
                    Seçili Grup
                </div>
            </div>
        </div>
    </div>

    <div class="system-parameters-card">
        <div class="system-card-header">
            <div>
                <h5 class="system-card-title">
                    Parametre Listesi
                </h5>

                <p class="system-card-subtitle">
                    Üniversite, fakülte, bölüm ve unvan parametrelerini sekmeler üzerinden yönetebilirsiniz.
                </p>
            </div>

            <span class="system-card-count">
                <i class="fas fa-list-ul"></i>
                @totalCount kayıt
            </span>
        </div>

        <div class="system-tabs">
            <ul class="nav nav-tabs nav-justified border-0"
                id="paramTabs"
                role="tablist">

                @foreach (var tab in tabData)
                {
                    var isActiveTab = string.Equals(
                        tab.Group,
                        activeGroup,
                        StringComparison.OrdinalIgnoreCase);

                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(isActiveTab ? "active" : "")"
                                id="@tab.Id-tab"
                                data-bs-toggle="tab"
                                data-bs-target="#@tab.Id"
                                type="button"
                                role="tab"
                                aria-controls="@tab.Id"
                                aria-selected="@(isActiveTab ? "true" : "false")">
                            <i class="fas @tab.Icon me-2"></i>
                            @tab.Title
                        </button>
                    </li>
                }

            </ul>
        </div>

        <div class="tab-content" id="paramTabsContent">

            @foreach (var tab in tabData)
            {
                var isActiveTab = string.Equals(
                    tab.Group,
                    activeGroup,
                    StringComparison.OrdinalIgnoreCase);

                var items = parameters
                    .Where(x => x.Group == tab.Group)
                    .OrderBy(x => x.Order)
                    .ThenBy(x => x.Name)
                    .ToList();

                <div class="tab-pane fade @(isActiveTab ? "show active" : "")"
                     id="@tab.Id"
                     role="tabpanel"
                     aria-labelledby="@tab.Id-tab">

                    <div class="system-tab-toolbar">
                        <span class="system-total-pill">
                            <i class="fas fa-list-ul"></i>
                            @Localizer["TotalCountLabel", items.Count]
                        </span>

                        <a asp-action="Create"
                           asp-route-group="@tab.Group"
                           class="system-create-btn">
                            <i class="fas fa-plus"></i>
                            @Localizer["AddNewButton"]
                        </a>
                    </div>

                    @if (!items.Any())
                    {
                        <div class="system-empty-state">
                            <div class="system-empty-state-icon">
                                <i class="fas fa-folder-open"></i>
                            </div>

                            <p>
                                @tab.EmptyMsg
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle system-table">
                                <thead>
                                    <tr>
                                        <th class="ps-4" style="width: 90px;">
                                            @Localizer["TableHeaderOrder"]
                                        </th>

                                        <th>
                                            Name TR
                                        </th>

                                        <th>
                                            Name EN
                                        </th>

                                        <th style="width: 140px;">
                                            @Localizer["TableHeaderStatus"]
                                        </th>

                                        <th class="text-end pe-4" style="width: 180px;">
                                            @Localizer["TableHeaderActions"]
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in items)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <span class="system-order-badge">
                                                    @item.Order
                                                </span>
                                            </td>

                                            <td>
                                                <div class="system-param-name">
                                                    @item.Name
                                                </div>
                                            </td>

                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.NameEn))
                                                {
                                                    <span class="system-param-name-en">
                                                        @item.NameEn
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="system-empty-en">
                                                        İngilizce karşılık girilmedi
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="system-status-badge system-status-active">
                                                        <i class="fas fa-check-circle"></i>
                                                        @Localizer["StatusActive"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="system-status-badge system-status-passive">
                                                        <i class="fas fa-circle-minus"></i>
                                                        @Localizer["StatusPassive"]
                                                    </span>
                                                }
                                            </td>

                                            <td class="text-end pe-4">
                                                <div class="admin-action-group">
                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.Id"
                                                       class="admin-action-btn admin-action-edit"
                                                       title="Düzenle">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    <form asp-action="Toggle"
                                                          asp-route-id="@item.Id"
                                                          method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="admin-action-btn admin-action-sync"
                                                                title="@Localizer["ToggleTitle"]">
                                                            <i class="fas fa-sync-alt"></i>
                                                        </button>
                                                    </form>

                                                    <form asp-action="Delete"
                                                          asp-route-id="@item.Id"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm(systemParameterDeleteConfirmText);">
                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="admin-action-btn admin-action-delete"
                                                                title="@Localizer["DeleteTitle"]">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

        </div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tabButtons = Array.from(document.querySelectorAll(".decision-tab"));
            const panels = Array.from(document.querySelectorAll(".decision-panel"));

            tabButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const target = button.getAttribute("data-tab-target");

                    tabButtons.forEach(function (item) {
                        item.classList.remove("active");
                    });

                    panels.forEach(function (panel) {
                        panel.classList.remove("active");
                    });

                    button.classList.add("active");

                    const targetPanel = document.getElementById(target);

                    if (targetPanel) {
                        targetPanel.classList.add("active");
                    }
                });
            });
        });
    </script>

    <script>
        function updateBulkToolbar() {
            const checked = document.querySelectorAll('.bulk-cb:checked');
            const toolbar = document.getElementById('bulkToolbar');
            const countEl = document.getElementById('bulkSelectedCount');
            if (checked.length > 0) {
                toolbar.classList.remove('d-none');
                toolbar.classList.add('d-flex');
                countEl.textContent = checked.length + ' bildiri ';
            } else {
                toolbar.classList.add('d-none');
                toolbar.classList.remove('d-flex');
            }
            // checkAll durumunu güncelle
            const allCbs = document.querySelectorAll('.bulk-cb');
            document.getElementById('checkAll').indeterminate =
                checked.length > 0 && checked.length < allCbs.length;
            document.getElementById('checkAll').checked =
                allCbs.length > 0 && checked.length === allCbs.length;
        }

        function toggleAllCheckboxes(master) {
            document.querySelectorAll('.bulk-cb').forEach(cb => {
                cb.checked = master.checked;
            });
            updateBulkToolbar();
        }

        function clearBulkSelection() {
            document.querySelectorAll('.bulk-cb').forEach(cb => cb.checked = false);
            document.getElementById('checkAll').checked = false;
            updateBulkToolbar();
        }

        function submitBulk(decision) {
            const checked = document.querySelectorAll('.bulk-cb:checked');
            if (checked.length === 0) return;

            const labels = { Accept: '@Localizer["BulkAccept"]', Reject: '@Localizer["BulkReject"]', Revision: '@Localizer["BulkRevision"]' };
            if (!confirm(checked.length + ' @Localizer["SubmissionsFor"] ' + (labels[decision] || '@Localizer["BulkProcess"]') + ' @Localizer["AreYouSure"]')) return;

            const container = document.getElementById('bulkHiddenInputs');
            container.innerHTML = '';
            checked.forEach(cb => {
                const inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'submissionIds';
                inp.value = cb.value;
                container.appendChild(inp);
            });
            document.getElementById('bulkDecisionValue').value = decision;
            document.getElementById('bulkForm').submit();
        }
    </script>
}
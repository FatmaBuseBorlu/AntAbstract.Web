@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.ViewModels.Admin.Decision
@using System
@using System.Collections.Generic
@using System.Linq

@model DecisionIndexViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var awaitingDecision = Model?.AwaitingDecision?.ToList() ?? new List<Submission>();
    var alreadyDecided = Model?.AlreadyDecided?.ToList() ?? new List<Submission>();

    var conferenceId = ViewBag.ConferenceId is Guid vbConferenceId
        ? vbConferenceId
        : Guid.Empty;

    var conferenceTitle = ViewBag.ConferenceTitle as string ?? "";
    var slug = ViewBag.Slug as string ?? "";

    var hasSlug = !string.IsNullOrWhiteSpace(slug);

    var flowUrl = hasSlug
        ? $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceId}"
        : $"/Admin/ConferenceFlow?conferenceId={conferenceId}";

    var changeConferenceUrl = "/Dashboard/MyConferences";

    var decisionPostUrl = hasSlug
        ? $"/{slug}/Admin/Decision/MakeDecision"
        : "#";

    var bulkDecisionUrl = hasSlug
        ? $"/{slug}/Admin/Decision/BulkDecision"
        : "#";

    string StatusLabel(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => Localizer.GetString("StatusNew").Value,
            SubmissionStatus.Pending => Localizer.GetString("StatusPending").Value,
            SubmissionStatus.UnderReview => Localizer.GetString("StatusUnderReview").Value,
            SubmissionStatus.Accepted => Localizer.GetString("StatusAccepted").Value,
            SubmissionStatus.Rejected => Localizer.GetString("StatusRejected").Value,
            SubmissionStatus.RevisionRequired => Localizer.GetString("StatusRevision").Value,
            SubmissionStatus.Presented => Localizer.GetString("StatusPresented").Value,
            _ => status.ToString()
        };
    }

    string StatusClass(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "status-new",
            SubmissionStatus.Pending => "status-pending",
            SubmissionStatus.UnderReview => "status-review",
            SubmissionStatus.Accepted => "status-accepted",
            SubmissionStatus.Rejected => "status-rejected",
            SubmissionStatus.RevisionRequired => "status-revision",
            SubmissionStatus.Presented => "status-presented",
            _ => "status-default"
        };
    }

    string GetAuthorName(Submission submission)
    {
        if (submission.Author == null)
        {
            return "Yazar bilgisi yok";
        }

        var fullName = $"{submission.Author.FirstName} {submission.Author.LastName}".Trim();

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return submission.Author.Email ?? "Yazar bilgisi yok";
    }

    string GetAuthorInitial(Submission submission)
    {
        var name = GetAuthorName(submission);

        return string.IsNullOrWhiteSpace(name)
            ? "Y"
            : name.Substring(0, 1).ToUpper();
    }

    string GetReviewerInfo(Submission submission)
    {
        var assignments = submission.ReviewAssignments?.ToList() ?? new List<ReviewAssignment>();
        var reviewCount = assignments.Count(x => x.Review != null);
        var totalReviewerCount = assignments.Count;

        if (totalReviewerCount == 0)
        {
            return Localizer.GetString("NoRefereeAssigned").Value;
        }

        return $"{reviewCount} / {totalReviewerCount} " + Localizer.GetString("Reviews").Value;
    }

    string GetDecisionHelpText(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.Accepted => Localizer.GetString("HelpAccepted").Value,
            SubmissionStatus.Rejected => Localizer.GetString("HelpRejected").Value,
            SubmissionStatus.RevisionRequired => Localizer.GetString("HelpRevision").Value,
            SubmissionStatus.Presented => Localizer.GetString("HelpPresented").Value,
            _ => Localizer.GetString("HelpOngoing").Value
        };
    }

    var waitingCount = awaitingDecision.Count;
    var decidedCount = alreadyDecided.Count;
    var acceptedCount = alreadyDecided.Count(x => x.Status == SubmissionStatus.Accepted || x.Status == SubmissionStatus.Presented);
    var rejectedCount = alreadyDecided.Count(x => x.Status == SubmissionStatus.Rejected);
    var revisionCount = alreadyDecided.Count(x => x.Status == SubmissionStatus.RevisionRequired);
}

<div class="container-fluid decision-page">

    <div class="decision-hero-card mb-4">
        <div class="decision-hero-left">
            <div class="decision-hero-icon">
                <i class="fas fa-gavel"></i>
            </div>

            <div>
                <div class="decision-section-label">
                    @Localizer["ConferenceOps"]
                </div>

                <h2 class="decision-page-title">
                    @Localizer["PageTitle"]
                </h2>

                <p class="decision-page-description">
                    @Localizer["PageDescription"]
                </p>

                @if (!string.IsNullOrWhiteSpace(conferenceTitle) || !string.IsNullOrWhiteSpace(slug))
                {
                    <div class="selected-conference-pill">
                        <i class="fas fa-calendar-check"></i>

                        <span>@Localizer["SelectedConference"]</span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(conferenceTitle) ? Localizer["NoConferenceSelected"].Value : conferenceTitle)
                        </strong>

                        @if (!string.IsNullOrWhiteSpace(slug))
                        {
                            <em>/@slug</em>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="decision-hero-actions">
            <a href="@flowUrl"
               class="btn decision-light-btn">
                <i class="fas fa-arrow-left me-2"></i>
                @Localizer["BackToFlow"]
            </a>

            <a href="@changeConferenceUrl"
               class="btn decision-outline-btn">
                <i class="fas fa-exchange-alt me-2"></i>
                @Localizer["ChangeConference"]
            </a>
        </div>
    </div>



    @if (!hasSlug)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-triangle-exclamation me-2"></i>
            @Localizer["NoConferenceLink"]
        </div>
    }

    <div class="decision-flow-info mb-4">
        <div class="decision-flow-item flow-accept">
            <div class="flow-icon">
                <i class="fas fa-check"></i>
            </div>

            <div>
                <strong>@Localizer["Accept"]</strong>
                <span>@Localizer["AcceptDesc"]</span>
            </div>
        </div>

        <div class="decision-flow-item flow-revision">
            <div class="flow-icon">
                <i class="fas fa-rotate"></i>
            </div>

            <div>
                <strong>@Localizer["Revision"]</strong>
                <span>@Localizer["RevisionDesc"]</span>
            </div>
        </div>

        <div class="decision-flow-item flow-reject">
            <div class="flow-icon">
                <i class="fas fa-xmark"></i>
            </div>

            <div>
                <strong>@Localizer["Reject"]</strong>
                <span>@Localizer["RejectDesc"]</span>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="decision-stat-card">
                <div class="stat-icon stat-orange">
                    <i class="fas fa-hourglass-half"></i>
                </div>

                <div>
                    <div class="stat-number">@waitingCount</div>
                    <div class="stat-label">@Localizer["PendingDecisions"]</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="decision-stat-card">
                <div class="stat-icon stat-green">
                    <i class="fas fa-circle-check"></i>
                </div>

                <div>
                    <div class="stat-number">@acceptedCount</div>
                    <div class="stat-label">@Localizer["AcceptedCount"]</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="decision-stat-card">
                <div class="stat-icon stat-purple">
                    <i class="fas fa-rotate"></i>
                </div>

                <div>
                    <div class="stat-number">@revisionCount</div>
                    <div class="stat-label">@Localizer["RevisionRequested"]</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="decision-stat-card">
                <div class="stat-icon stat-red">
                    <i class="fas fa-circle-xmark"></i>
                </div>

                <div>
                    <div class="stat-number">@rejectedCount</div>
                    <div class="stat-label">@Localizer["RejectedCount"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="decision-tabs-card mb-4">
        <button type="button"
                class="decision-tab active"
                data-tab-target="waitingPanel">
            <i class="fas fa-hourglass-half"></i>
            @Localizer["PendingDecisionsTab"]
            <span>@waitingCount</span>
        </button>

        <button type="button"
                class="decision-tab"
                data-tab-target="decidedPanel">
            <i class="fas fa-check-circle"></i>
            @Localizer["DecidedTab"]
            <span>@decidedCount</span>
        </button>
    </div>

    <div class="decision-panel active" id="waitingPanel">
        <div class="decision-list-card">
            <div class="decision-list-header">
                <div>
                    <h5>@Localizer["AwaitingDecision"]</h5>
                    <p>@Localizer["AwaitingDecisionDesc"]</p>
                </div>

                <div class="decision-count-pill">
                    @waitingCount @Localizer["Submissions"]
                </div>
            </div>

            @if (!awaitingDecision.Any())
            {
                <div class="decision-empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-clipboard-check"></i>
                    </div>

                    <h4>@Localizer["NoPendingDecisions"]</h4>

                    <p>
                        @Localizer["NoPendingMessage"]
                    </p>

                    <a href="@flowUrl"
                       class="btn decision-light-btn">
                        <i class="fas fa-arrow-left me-2"></i>
                        @Localizer["BackToFlow"]
                    </a>
                </div>
            }
            else
            {
                <!-- Toplu işlem toolbar -->
                <div id="bulkToolbar" class="d-none mb-3 p-3 bg-light border rounded d-flex align-items-center gap-3 flex-wrap">
                    <span id="bulkSelectedCount" class="fw-semibold text-secondary">0 </span>
                    <form method="post" action="@bulkDecisionUrl" id="bulkForm" class="d-flex gap-2 flex-wrap">
                        @Html.AntiForgeryToken()
                        <div id="bulkHiddenInputs"></div>
                        <input type="hidden" name="decision" id="bulkDecisionValue" value="" />
                        <button type="button" class="btn btn-sm btn-success"
                                onclick="submitBulk('Accept')"
                                title="@Localizer["AcceptSelected"]">
                            <i class="fas fa-check me-1"></i> @Localizer["AcceptBtn"]
                        </button>
                        <button type="button" class="btn btn-sm btn-warning text-white"
                                onclick="submitBulk('Revision')"
                                title="@Localizer["RequestRevision"]">
                            <i class="fas fa-rotate me-1"></i> @Localizer["RevisionBtn"]
                        </button>
                        <button type="button" class="btn btn-sm btn-danger"
                                onclick="submitBulk('Reject')"
                                title="@Localizer["RejectSelected"]">
                            <i class="fas fa-xmark me-1"></i> @Localizer["RejectBtn"]
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                onclick="clearBulkSelection()">
                            @Localizer["ClearSelection"]
                        </button>
                    </form>
                </div>

                <div class="decision-table-wrap">
                    <table class="decision-table">
                        <thead>
                            <tr>
                                <th style="width:40px;">
                                    <input type="checkbox" id="checkAll" class="form-check-input"
                                           title="@Localizer["SelectAll"]" onchange="toggleAllCheckboxes(this)" />
                                </th>
                                <th>@Localizer["Submission"]</th>
                                <th>@Localizer["Author"]</th>
                                <th>@Localizer["RefereeStatus"]</th>
                                <th>@Localizer["CurrentStatus"]</th>
                                <th class="text-end">@Localizer["Decision"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in awaitingDecision)
                            {
                                var detailUrl = hasSlug
                                    ? $"/{slug}/Admin/Submissions/Details/{item.Id}?conferenceId={conferenceId}"
                                    : $"/Admin/Submissions/Details/{item.Id}?conferenceId={conferenceId}";

                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input bulk-cb"
                                               value="@item.Id" onchange="updateBulkToolbar()" />
                                    </td>
                                    <td>
                                        <div class="submission-title-cell">
                                            <div class="submission-mini-icon">
                                                <i class="fas fa-file-lines"></i>
                                            </div>

                                            <div>
                                                <strong>@item.Title</strong>
                                                <span>Ref: #@item.Id.ToString().Substring(0, 8).ToUpper()</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="author-cell">
                                            <div class="author-avatar">
                                                @GetAuthorInitial(item)
                                            </div>

                                            <span>@GetAuthorName(item)</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="review-info-pill">
                                            <i class="fas fa-user-check"></i>
                                            @GetReviewerInfo(item)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="decision-status @StatusClass(item.Status)">
                                            @StatusLabel(item.Status)
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="decision-actions">
                                            <a href="@detailUrl"
                                               class="btn decision-view-btn">
                                                <i class="fas fa-eye me-2"></i>
                                                @Localizer["Review"]
                                            </a>

                                            <form method="post"
                                                  action="@decisionPostUrl"
                                                  class="d-inline decision-form"
                                                  onsubmit="return confirm('@Localizer["ConfirmAccept"]');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="submissionId" value="@item.Id" />
                                                <input type="hidden" name="decision" value="Accept" />
                                                <input type="hidden" name="note" value="" />

                                                <button type="submit"
                                                        class="btn decision-accept-btn"
                                                        title="Kabul Et"
                                                        @(hasSlug ? "" : "disabled")>
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>

                                            <form method="post"
                                                  action="@decisionPostUrl"
                                                  class="d-inline decision-form"
                                                  onsubmit="return confirm('@Localizer["ConfirmRevision"]');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="submissionId" value="@item.Id" />
                                                <input type="hidden" name="decision" value="Revision" />
                                                <input type="hidden" name="note" value="" />

                                                <button type="submit"
                                                        class="btn decision-revision-btn"
                                                        title="@Localizer["RequestRevision"]"
                                                        @(hasSlug ? "" : "disabled")>
                                                    <i class="fas fa-rotate"></i>
                                                </button>
                                            </form>

                                            <form method="post"
                                                  action="@decisionPostUrl"
                                                  class="d-inline decision-form"
                                                  onsubmit="return confirm('@Localizer["ConfirmReject"]');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="submissionId" value="@item.Id" />
                                                <input type="hidden" name="decision" value="Reject" />
                                                <input type="hidden" name="note" value="" />

                                                <button type="submit"
                                                        class="btn decision-reject-btn"
                                                        title="Reddet"
                                                        @(hasSlug ? "" : "disabled")>
                                                    <i class="fas fa-xmark"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="decision-panel" id="decidedPanel">
        <div class="decision-list-card">
            <div class="decision-list-header">
                <div>
                    <h5>@Localizer["DecidedSubmissions"]</h5>
                    <p>@Localizer["DecidedSubmissionsDesc"]</p>
                </div>

                <div class="decision-count-pill">
                    @decidedCount @Localizer["Submissions"]
                </div>
            </div>

            @if (!alreadyDecided.Any())
            {
                <div class="decision-empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>

                    <h4>@Localizer["NoDecidedSubmissions"]</h4>

                    <p>
                        @Localizer["NoDecidedMessage"]
                    </p>

                    <a href="@flowUrl"
                       class="btn decision-light-btn">
                        <i class="fas fa-arrow-left me-2"></i>
                        @Localizer["BackToFlow"]
                    </a>
                </div>
            }
            else
            {
                <div class="decision-table-wrap">
                    <table class="decision-table">
                        <thead>
                            <tr>
                                <th>@Localizer["Submission"]</th>
                                <th>@Localizer["Author"]</th>
                                <th>@Localizer["RefereeStatus"]</th>
                                <th>@Localizer["Decision"]</th>
                                <th>@Localizer["Result"]</th>
                                <th class="text-end">@Localizer["Action"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in alreadyDecided)
                            {
                                var detailUrl = hasSlug
                                    ? $"/{slug}/Admin/Submissions/Details/{item.Id}?conferenceId={conferenceId}"
                                    : $"/Admin/Submissions/Details/{item.Id}?conferenceId={conferenceId}";

                                <tr>
                                    <td>
                                        <div class="submission-title-cell">
                                            <div class="submission-mini-icon">
                                                <i class="fas fa-file-lines"></i>
                                            </div>

                                            <div>
                                                <strong>@item.Title</strong>
                                                <span>
                                                    Ref: #@item.Id.ToString().Substring(0, 8).ToUpper()
                                                    @if (item.DecisionDate.HasValue)
                                                    {
                                                        <text> · @item.DecisionDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</text>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="author-cell">
                                            <div class="author-avatar">
                                                @GetAuthorInitial(item)
                                            </div>

                                            <span>@GetAuthorName(item)</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="review-info-pill">
                                            <i class="fas fa-user-check"></i>
                                            @GetReviewerInfo(item)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="decision-status @StatusClass(item.Status)">
                                            @StatusLabel(item.Status)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="decision-help-pill @StatusClass(item.Status)">
                                            @GetDecisionHelpText(item.Status)
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a href="@detailUrl"
                                           class="btn decision-view-btn">
                                            <i class="fas fa-eye me-2"></i>
                                            @Localizer["Review"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

<style>
    .decision-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .decision-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.15), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .decision-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .decision-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .decision-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .decision-page-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.05em;
    }

    .decision-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 600;
        line-height: 1.65;
    }

    .selected-conference-pill {
        width: fit-content;
        margin-top: 0.75rem;
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.10);
        border: 1px solid rgba(0, 174, 239, 0.22);
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .selected-conference-pill span,
    .selected-conference-pill strong {
        color: #0d6efd;
    }

    .selected-conference-pill em {
        color: #64748b;
        font-style: normal;
        font-weight: 900;
    }

    .decision-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .decision-light-btn,
    .decision-outline-btn,
    .decision-view-btn {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0 1.35rem;
        font-size: 0.95rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.045);
    }

    .decision-light-btn {
        background: #ffffff;
        color: #0f172a;
        border: 1px solid #dbe3ef;
    }

    .decision-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.10);
        transform: translateY(-1px);
    }

    .decision-outline-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .decision-outline-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.10);
        transform: translateY(-1px);
    }

    .decision-flow-info {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .decision-flow-item {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 22px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.045);
    }

    .flow-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .decision-flow-item strong {
        display: block;
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.15rem;
    }

    .decision-flow-item span {
        display: block;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .flow-accept .flow-icon {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;

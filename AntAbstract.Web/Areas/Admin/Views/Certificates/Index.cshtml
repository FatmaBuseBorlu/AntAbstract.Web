@using AntAbstract.Domain.Entities
@model List<Certificate>

@{
    ViewData["Title"] = "Sertifika Yönetimi";
}

<h3 class="mb-3">@ViewData["Title"]</h3>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="userEmail" class="form-control" placeholder="Kullanıcı email filtre" value="@Context.Request.Query["userEmail"]" />
    </div>
    <div class="col-md-2">
        <select name="type" class="form-select">
            <option value="">Tür (Hepsi)</option>
            <option value="Author">Author</option>
            <option value="Reviewer">Reviewer</option>
        </select>
    </div>
    <div class="col-md-2 form-check mt-2">
        <input class="form-check-input" type="checkbox" name="onlyMissingFile" value="true" />
        <label class="form-check-label">Dosya yok</label>
    </div>
    <div class="col-md-2 form-check mt-2">
        <input class="form-check-input" type="checkbox" name="onlyEmailNotSent" value="true" />
        <label class="form-check-label">Mail gitmemiş</label>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary">Filtrele</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Tür</th>
            <th>Kullanıcı</th>
            <th>Konferans</th>
            <th>Dosya</th>
            <th>Mail</th>
            <th style="width:280px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Type</td>
                <td>@(c.User?.Email ?? c.UserId)</td>
                <td>@(c.Conference?.Title ?? c.ConferenceId.ToString())</td>
                <td>@(string.IsNullOrWhiteSpace(c.FilePath) ? "Yok" : "Var")</td>
                <td>@(c.EmailSentAt == null ? "Gönderilmemiş" : c.EmailSentAt.Value.ToString("dd.MM.yyyy HH:mm"))</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Download" asp-route-id="@c.Id">İndir</a>

                    <form asp-action="Regenerate" asp-route-id="@c.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-warning">Yeniden Üret</button>
                    </form>

                    <form asp-action="ResendEmail" asp-route-id="@c.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-success">Mail Tekrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

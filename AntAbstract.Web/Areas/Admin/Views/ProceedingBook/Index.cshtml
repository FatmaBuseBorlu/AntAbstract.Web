        font-size: 0.78rem;
        font-weight: 700;
        margin-top: 0.55rem;
        line-height: 1.45;
    }

    .admin-switch-card {
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.2rem;
    }

    .admin-switch-title {
        color: #0f172a;
        font-size: 0.93rem;
        font-weight: 900;
        margin-bottom: 0.15rem;
    }

    .admin-switch-text {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .form-check-input {
        width: 3rem;
        height: 1.55rem;
        cursor: pointer;
    }

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1.4rem;
        padding-top: 1.3rem;
        border-top: 1px solid #e2e8f0;
    }

    .admin-save-btn,
    .admin-cancel-btn {
        min-height: 46px;
        border-radius: 999px;
        padding: 0 1.2rem;
        font-size: 0.84rem;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .admin-save-btn {
        border: none;
        color: #ffffff;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.22);
    }

    .admin-save-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 34px rgba(13, 110, 253, 0.30);
    }

    .admin-cancel-btn {
        color: #334155;
        background: #ffffff;
        border: 1px solid #dbe4ef;
    }

    .admin-cancel-btn:hover {
        color: #0d6efd;
        background: #f8fbff;
        border-color: rgba(13, 110, 253, 0.28);
        text-decoration: none;
    }

    .side-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.25rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        position: sticky;
        top: 92px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 34px;
        border-radius: 999px;
        padding: 0 0.85rem;
        font-size: 0.78rem;
        font-weight: 900;
        margin-bottom: 1rem;
    }

    .status-published {
        color: #059669;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.20);
    }

    .status-draft {
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.22);
    }

    .side-title {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .side-text {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        line-height: 1.55;
        margin-bottom: 1rem;
    }

    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .info-list li {
        display: flex;
        gap: 0.65rem;
        color: #475569;
        font-size: 0.82rem;
        font-weight: 750;
        margin-bottom: 0.85rem;
        line-height: 1.45;
    }

    .info-list li i {
        color: #00aeef;
        margin-top: 0.15rem;
    }

    .validation-summary-errors {
        border: none;
        border-radius: 18px;
        background: rgba(239, 68, 68, 0.08);
        color: #b91c1c;
        font-weight: 800;
        padding: 1rem 1.1rem;
        margin-bottom: 1.25rem;
    }

    .remove-modal-content {
        border: none;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(15, 23, 42, 0.28);
    }

    .remove-modal-header {
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        padding: 1.35rem 1.45rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .remove-modal-header .btn-close {
        margin-left: auto;
    }

    .remove-modal-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 18px;
        background: rgba(239, 68, 68, 0.10);
        color: #ef4444;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .remove-modal-title {
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 900;
        margin: 0;
    }

    .remove-modal-subtitle {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        margin: 0.15rem 0 0;
    }

    .remove-modal-body {
        padding: 1.45rem;
    }

    .remove-warning {
        border: 1px solid rgba(245, 158, 11, 0.24);
        background: rgba(245, 158, 11, 0.08);
        color: #92400e;
        border-radius: 18px;
        padding: 0.9rem 1rem;
        display: flex;
        gap: 0.65rem;
        font-size: 0.82rem;
        font-weight: 800;
        line-height: 1.45;
    }

    .remove-modal-footer {
        border-top: 1px solid #e2e8f0;
        background: #ffffff;
        padding: 1rem 1.45rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .remove-cancel-btn,
    .remove-confirm-btn {
        min-height: 44px;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1.15rem;
    }

    .remove-cancel-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

    .remove-confirm-btn {
        border: none;
        background: #ef4444;
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(239, 68, 68, 0.24);
    }

    .remove-confirm-btn:hover {
        background: #dc2626;
        color: #ffffff;
    }

    .generate-confirm-btn {
        background: #0d6efd;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.24);
    }

    .generate-confirm-btn:hover {
        background: #0b5ed7;
        color: #ffffff;
    }

    @@media (max-width: 1200px) {
        .admin-detail-grid {
            grid-template-columns: 1fr;
        }

        .side-card {
            position: static;
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-left {
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .proceeding-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-card-body {
            padding: 1.15rem;
        }

        .admin-action-panel {
            align-items: stretch;
        }

        .admin-action-panel form,
        .admin-primary-action-btn,
        .admin-hero-btn,
        .admin-mini-btn,
        .file-status-actions,
        .pdf-preview-actions,
        .pdf-preview-actions a {
            width: 100%;
        }

        .file-status-card {
            align-items: stretch;
            flex-direction: column;
        }

        .file-status-left,
        .admin-action-panel-left {
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .admin-save-btn,
        .admin-cancel-btn {
            width: 100%;
        }

        .pdf-modern-body {
            grid-template-columns: 1fr;
        }

        .pdf-cover-art {
            min-height: 300px;
        }

        .pdf-modern-actions,
        .pdf-modern-actions a {
            width: 100%;
        }

        .pdf-viewer-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .pdf-preview-frame {
            height: 520px;
        }

        .admin-switch-card {
            align-items: flex-start;
            flex-direction: column;
        }

        .remove-modal-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .remove-modal-footer form,
        .remove-cancel-btn,
        .remove-confirm-btn {
            width: 100%;
        }
    }
</style>

<div class="proceeding-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert admin-alert admin-alert-success mb-4">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert admin-alert admin-alert-info mb-4">
            <i class="fas fa-info-circle"></i>
            <span>@TempData["InfoMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert admin-alert admin-alert-error mb-4">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-book-open"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    @Localizer["ConferenceOperations"]
                </div>

                <h3 class="admin-hero-title">
                    @Localizer["PageTitle"]
                </h3>

                <p class="admin-hero-lead">
                    @Localizer["PageLead"]
                </p>

                <div class="admin-chip-row">
                    <span class="admin-chip admin-chip-primary">
                        <i class="fas fa-calendar-check"></i>
                        @Localizer["SelectedConference"]
                    </span>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <span class="admin-chip">
                            <i class="fas fa-link"></i>
                            /@slug
                        </span>
                    }

                    <span class="admin-chip">
                        <i class="fas @fileStatusIconClass"></i>
                        @(hasFile ? Localizer["PdfUploaded"].Value : Localizer["NoPdf"].Value)
                    </span>
                </div>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="@backUrl" class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToFlowButton"]
            </a>

            <a href="@changeConferenceUrl" class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-exchange-alt"></i>
                @Localizer["ChangeConferenceButton"]
            </a>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <a href="@publicSiteUrl"
                   target="_blank"
                   class="admin-hero-btn admin-hero-btn-primary">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    @Localizer["ViewSiteButton"]
                </a>
            }
        </div>
    </div>

    <div class="admin-detail-grid">
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title-wrap">
                    <div class="admin-card-icon">
                        <i class="fas fa-file-pdf"></i>
                    </div>

                    <div>
                        <h5 class="admin-card-title">
                            @Localizer["PdfAndPublishSettings"]
                        </h5>

                        <p class="admin-card-subtitle">
                            @Localizer["PdfAndPublishSettingsLead"]
                        </p>
                    </div>
                </div>
            </div>

            <div class="admin-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
                }

                <div class="conference-mini-card">
                    <div class="conference-mini-icon">
                        <i class="fas fa-building-columns"></i>
                    </div>

                    <div>
                        <div class="conference-mini-label">
                            @Localizer["SelectedConference"]
                        </div>

                        <div class="conference-mini-title">
                            @Model.ConferenceTitle
                        </div>
                    </div>
                </div>

                <div class="admin-action-panel">
                    <div class="admin-action-panel-left">
                        <div class="admin-action-panel-icon">
                            <i class="fas fa-wand-magic-sparkles"></i>
                        </div>

                        <div>
                            <div class="admin-action-panel-title">
                                @Localizer["AutoGenerateTitle"]
                            </div>

                            <div class="admin-action-panel-text">
                                @Localizer["AutoGenerateText"]
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="admin-primary-action-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#generateProceedingBookModal">
                        <i class="fas fa-file-circle-plus"></i>
                        @Localizer["AutoGenerateButton"]
                    </button>
                </div>

                @if (hasFile)
                {
                    <div class="file-status-card">
                        <div class="file-status-left">
                            <div class="file-status-icon">
                                <i class="fas fa-file-pdf"></i>
                            </div>

                            <div class="min-w-0">
                                <div class="file-status-title">
                                    @Localizer["ExistingPdfUploaded"]
                                </div>

                                <div class="file-status-path">
                                    @Model.ProceedingBookFilePath
                                </div>
                            </div>
                        </div>

                        <div class="file-status-actions">
                            <a href="@Model.ProceedingBookFilePath"
                               target="_blank"
                               class="admin-mini-btn admin-mini-btn-primary">
                                <i class="fas fa-eye"></i>
                                @Localizer["ViewButton"]
                            </a>

                            <button type="button"
                                    class="admin-mini-btn admin-mini-btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#removeProceedingBookModal">
                                <i class="fas fa-trash"></i>
                                @Localizer["RemoveButton"]
                            </button>
                        </div>
                    </div>

                    <div class="pdf-modern-showcase">
                        <div class="pdf-modern-topbar">
                            <div class="pdf-modern-title">
                                <div class="pdf-modern-icon">
                                    <i class="fas fa-file-pdf"></i>
                                </div>

                                <div>
                                    <strong>@Localizer["ProceedingBookPreview"]</strong>
                                    <span>@Localizer["ProceedingBookPreviewLead"]</span>
                                </div>
                            </div>

                            <div class="pdf-modern-actions">
                                <a href="@Model.ProceedingBookFilePath"
                                   target="_blank"
                                   class="admin-mini-btn admin-mini-btn-primary">
                                    <i class="fas fa-up-right-from-square"></i>
                                    @Localizer["OpenInNewTab"]
                                </a>

                                <a href="@Model.ProceedingBookFilePath"
                                   download
                                   class="admin-mini-btn admin-mini-btn-primary">
                                    <i class="fas fa-download"></i>
                                    @Localizer["DownloadButton"]
                                </a>
                            </div>
                        </div>

                        <div class="pdf-modern-body">
                            <div class="pdf-cover-panel">
                                <div class="pdf-cover-art">
                                    <div class="pdf-cover-badge">
                                        <i class="fas fa-file-pdf"></i>
                                        @Localizer["PdfProceedingBook"]
                                    </div>

                                    <div class="pdf-cover-center">
                                        <div class="pdf-cover-file-icon">
                                            <i class="fas fa-book-open"></i>
                                        </div>

                                        <h4>
                                            @Localizer["ProceedingBook"]
                                        </h4>

                                        <p>
                                            @Model.ConferenceTitle
                                        </p>
                                    </div>

                                    <div class="pdf-cover-footer">
                                        <span>ANT ABSTRACT</span>
                                        <span class="pdf-cover-year">@proceedingYear</span>
                                    </div>
                                </div>

                                <div class="pdf-cover-meta">
                                    <div class="pdf-cover-meta-item">
                                        <i class="fas fa-calendar-check"></i>
                                        <span>@Localizer["PublishDate"]: <strong>@publishedDateText</strong></span>
                                    </div>

                                    <div class="pdf-cover-meta-item">
                                        <i class="fas fa-eye"></i>
                                        <span>@(Model.IsProceedingBookPublished ? Localizer.GetString("VisibleToAuthors").Value : Localizer.GetString("HiddenFromAuthors").Value)</span>
                                    </div>
                                </div>
                            </div>

                            <div class="pdf-viewer-shell">
                                <div class="pdf-viewer-toolbar">
                                    <div class="pdf-viewer-toolbar-left">
                                        <span class="pdf-live-dot"></span>
                                        <span>@Localizer["LivePreview"]</span>
                                    </div>

                                    <div class="pdf-modern-actions">
                                        <a href="@Model.ProceedingBookFilePath"
                                           target="_blank"
                                           class="admin-mini-btn admin-mini-btn-primary">
                                            <i class="fas fa-maximize"></i>
                                            Tam Ekran
                                        </a>
                                    </div>
                                </div>

                                <iframe src="@pdfPreviewUrl"
                                        class="pdf-preview-frame">
                                </iframe>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-upload-card">
                        <div class="empty-upload-icon">
                            <i class="fas fa-file-circle-xmark"></i>
                        </div>

                        <div class="empty-upload-title">
                            @Localizer["NoPdfYet"]
                        </div>

                        <p class="empty-upload-text">
                            PDF dosyasını manuel yükleyebilir veya kabul edilmiş bildirilerden otomatik bildiri kitabı oluşturabilirsiniz.
                        </p>
                    </div>
                }

                <form action="@postUrl"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="ConferenceId" value="@Model.ConferenceId" />
                    <input type="hidden" name="Slug" value="@Model.Slug" />
                    <input type="hidden" name="ConferenceTitle" value="@Model.ConferenceTitle" />
                    <input type="hidden" name="ProceedingBookFilePath" value="@Model.ProceedingBookFilePath" />
                    <input type="hidden" name="ProceedingBookPublishedDate" value="@(Model.ProceedingBookPublishedDate?.ToString("O") ?? "")" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                    <div class="mb-4">
                        <label for="ProceedingBookFile" class="form-label-modern">
                            @Localizer["NewPdfFile"]
                        </label>

                        <div class="file-upload-box">
                            <input id="ProceedingBookFile"
                                   name="ProceedingBookFile"
                                   type="file"
                                   accept="application/pdf,.pdf"
                                   class="form-control form-control-modern" />

                            <div class="file-upload-help">
                                Sadece PDF dosyası yükleyiniz. Maksimum dosya boyutu 50 MB olarak kontrol edilir.
                                Yeni PDF yüklerseniz eski dosya otomatik olarak değiştirilecektir.
                            </div>
                        </div>

                        @Html.ValidationMessageFor(x => x.ProceedingBookFile, "", new { @class = "text-danger small fw-bold" })
                    </div>

                    <div class="admin-switch-card">
                        <div>
                            <div class="admin-switch-title">
                                @Localizer["PublishToggle"]
                            </div>

                            <div class="admin-switch-text">
                                Bu seçenek aktif olduğunda yazar panelindeki Bildiri Kitabı ekranında PDF görüntülenir ve indirilebilir.
                            </div>
                        </div>

                        <div class="form-check form-switch m-0">
                            @if (Model.IsProceedingBookPublished)
                            {
                                <input id="IsProceedingBookPublished"
                                       name="IsProceedingBookPublished"
                                       class="form-check-input"
                                       type="checkbox"
                                       value="true"
                                       checked="checked" />
                            }
                            else
                            {
                                <input id="IsProceedingBookPublished"
                                       name="IsProceedingBookPublished"
                                       class="form-check-input"
                                       type="checkbox"
                                       value="true" />
                            }

                            <input type="hidden" name="IsProceedingBookPublished" value="false" />
                        </div>
                    </div>

                    @Html.ValidationMessageFor(x => x.IsProceedingBookPublished, "", new { @class = "text-danger small fw-bold" })

                    <div class="form-actions">
                        <a href="@backUrl" class="admin-cancel-btn">
                            <i class="fas fa-times"></i>
                            Vazgeç
                        </a>

                        <button type="submit" class="admin-save-btn">
                            <i class="fas fa-save"></i>
                            Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <aside class="side-card">
            @if (Model.IsProceedingBookPublished)
            {
                <div class="status-badge status-published">
                    <i class="fas fa-circle-check"></i>
                    @Localizer["Published"]
                </div>
            }
            else
            {
                <div class="status-badge status-draft">
                    <i class="fas fa-clock"></i>
                    @Localizer["NotPublished"]
                </div>
            }

            <h5 class="side-title">
                @Localizer["PublishInfo"]
            </h5>

            <p class="side-text">
                Bildiri kitabı yayınlandığında yazar ve katılımcılar ilgili kongre panelinden PDF dosyasına erişebilir.
            </p>

            <ul class="info-list">
                <li>
                    <i class="fas fa-calendar-check"></i>
                    <span>
                        @Localizer["PublishDate"]
                        <strong>@publishedDateText</strong>
                    </span>
                </li>

                <li>
                    <i class="fas fa-file-pdf"></i>
                    <span>
                        Dosya Durumu:
                        <strong>@(hasFile ? "PDF yüklü" : "PDF yüklenmedi")</strong>
                    </span>
                </li>

                <li>
                    <i class="fas fa-eye"></i>
                    <span>
                        Görünürlük:
                        <strong>@(Model.IsProceedingBookPublished ? Localizer.GetString("VisibleToAuthors").Value : Localizer.GetString("HiddenFromAuthors").Value)</strong>
                    </span>
                </li>

                <li>
                    <i class="fas fa-circle-info"></i>
                    <span>
                        Yayına almak için manuel PDF yükleyebilir veya otomatik oluşturma seçeneğini kullanabilirsiniz.
                    </span>
                </li>
            </ul>
        </aside>
    </div>
</div>

<div class="modal fade"
     id="generateProceedingBookModal"
     tabindex="-1"
     aria-labelledby="generateProceedingBookModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content remove-modal-content">
            <div class="modal-header remove-modal-header">
                <div class="remove-modal-icon" style="background: rgba(13, 110, 253, 0.10); color: #0d6efd;">
                    <i class="fas fa-wand-magic-sparkles"></i>
                </div>

                <div>
                    <h5 class="remove-modal-title" id="generateProceedingBookModalLabel">
                        Otomatik Bildiri Kitabı Oluştur
                    </h5>

                    <p class="remove-modal-subtitle">
                        Sistem kabul edilmiş bildirilerden PDF oluşturacak.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Kapat"></button>
            </div>

            <div class="modal-body remove-modal-body">
                <p class="mb-3 fw-bold text-secondary">
                    Bu kongreye ait kabul edilmiş bildirilerden otomatik bildiri kitabı oluşturulsun mu?
                </p>

                <div class="remove-warning">
                    <i class="fas fa-circle-info"></i>
                    <span>
                        Mevcut PDF varsa yeni oluşturulan dosya ile değiştirilecektir.
                        Sadece kabul edilmiş bildiriler bildiri kitabına eklenir.
                    </span>
                </div>
            </div>

            <div class="modal-footer remove-modal-footer">
                <button type="button"
                        class="btn remove-cancel-btn"
                        data-bs-dismiss="modal">
                    Vazgeç
                </button>

                <form action="@generateUrl"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />

                    <button type="submit"
                            class="btn remove-confirm-btn generate-confirm-btn">
                        <i class="fas fa-file-circle-plus me-2"></i>
                        Evet, Oluştur
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (hasFile)
{
    <div class="modal fade"
         id="removeProceedingBookModal"
         tabindex="-1"
         aria-labelledby="removeProceedingBookModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content remove-modal-content">
                <div class="modal-header remove-modal-header">
                    <div class="remove-modal-icon">
                        <i class="fas fa-trash"></i>
                    </div>

                    <div>
                        <h5 class="remove-modal-title" id="removeProceedingBookModalLabel">
                            PDF Dosyasını Kaldır
                        </h5>

                        <p class="remove-modal-subtitle">
                            Bu işlem mevcut bildiri kitabını yayından kaldırır.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Kapat"></button>
                </div>

                <div class="modal-body remove-modal-body">
                    <p class="mb-3 fw-bold text-secondary">
                         PDF dosyasını kaldırmak istediğinize emin misiniz?
                    </p>

                    <div class="remove-warning">
                        <i class="fas fa-circle-info"></i>
                        <span>
                            
                            Yazar panelinde artık görüntülenmez.
                        </span>
                    </div>
                </div>

                <div class="modal-footer remove-modal-footer">
                    <button type="button"
                            class="btn remove-cancel-btn"
                            data-bs-dismiss="modal">
                        Vazgeç
                    </button>

                    <form action="@removeFileUrl"
                          method="post"
                          class="m-0">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />

                        <button type="submit" class="btn remove-confirm-btn">
                            <i class="fas fa-trash me-2"></i>
                            Evet, Kaldır
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
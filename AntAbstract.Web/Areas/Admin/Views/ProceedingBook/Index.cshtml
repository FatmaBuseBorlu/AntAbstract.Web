@model AntAbstract.Web.Models.ViewModels.Admin.ProceedingBooks.ProceedingBookViewModel

@{
    ViewData["Title"] = "Bildiri Kitabı Yönetimi";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = !string.IsNullOrWhiteSpace(Model.Slug)
        ? Model.Slug
        : Context.GetRouteValue("slug")?.ToString() ?? "";

    var conferenceIdText = Model.ConferenceId == Guid.Empty
        ? Context.Request.Query["conferenceId"].ToString()
        : Model.ConferenceId.ToString();

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow?conferenceId={conferenceIdText}"
        : $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceIdText}";

    var postUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/ProceedingBook"
        : $"/{slug}/Admin/ProceedingBook";

    var removeFileUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/ProceedingBook/RemoveFile"
        : $"/{slug}/Admin/ProceedingBook/RemoveFile";

    var generateUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/ProceedingBook/Generate"
        : $"/{slug}/Admin/ProceedingBook/Generate";

    var hasFile = !string.IsNullOrWhiteSpace(Model.ProceedingBookFilePath);

    var publishedDateText = Model.ProceedingBookPublishedDate.HasValue
        ? Model.ProceedingBookPublishedDate.Value.ToString("dd MMMM yyyy HH:mm")
        : "Henüz yayınlanmadı";
}


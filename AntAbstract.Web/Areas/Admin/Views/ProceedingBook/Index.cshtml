            width: 100%;
        }

        .remove-modal-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .remove-modal-footer form,
            .remove-cancel-btn,
            .remove-confirm-btn {
                width: 100%;
            }
    }
</style>

<div class="proceeding-page">
    <div class="proceeding-shell">

        <div class="proceeding-hero">
            <div class="proceeding-hero-left">
                <div class="proceeding-hero-icon">
                    <i class="fas fa-book-open"></i>
                </div>

                <div>
                    <h3 class="proceeding-title">
                        Bildiri Kitabı Yönetimi
                    </h3>

                    <p class="proceeding-lead">
                        Kongreye ait bildiri kitabı PDF dosyasını yükleyebilir, yayına alabilir veya yayından kaldırabilirsiniz.
                    </p>
                </div>
            </div>

            <a href="@backUrl" class="proceeding-back-btn">
                <i class="fas fa-arrow-left"></i>
                Kongre Akışına Dön
            </a>
        </div>

        <div class="proceeding-grid">
            <div class="proceeding-card">
                <div class="proceeding-card-header">
                    <div class="proceeding-card-title-wrap">
                        <div class="proceeding-step-icon">
                            <i class="fas fa-file-pdf"></i>
                        </div>

                        <div>
                            <div class="proceeding-card-title">
                                PDF ve Yayın Ayarları
                            </div>

                            <div class="proceeding-card-subtitle">
                                Bildiri kitabı dosyasını yükleyin, otomatik oluşturun ve yazar panelinde görünürlüğünü yönetin.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="proceeding-card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="validation-summary-errors"></div>
                    }

                    <div class="conference-mini-card">
                        <div class="conference-mini-icon">
                            <i class="fas fa-building-columns"></i>
                        </div>

                        <div>
                            <div class="conference-mini-label">
                                Seçili Kongre
                            </div>

                            <div class="conference-mini-title">
                                @Model.ConferenceTitle
                            </div>
                        </div>
                    </div>

                    <div class="auto-generate-card">
                        <div class="auto-generate-left">
                            <div class="auto-generate-icon">
                                <i class="fas fa-wand-magic-sparkles"></i>
                            </div>

                            <div>
                                <div class="auto-generate-title">
                                    Sistemden Otomatik Bildiri Kitabı Oluştur
                                </div>

                                <div class="auto-generate-text">
                                    Sistem bu kongreye ait kabul edilmiş bildirileri alır ve otomatik PDF bildiri kitabı oluşturur.
                                    Mevcut PDF varsa yeni oluşturulan dosya ile değiştirilir.
                                </div>
                            </div>
                        </div>

                        <button type="button"
                                class="auto-generate-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#generateProceedingBookModal">
                            <i class="fas fa-file-circle-plus"></i>
                            Otomatik Oluştur
                        </button>
                    </div>

                    @if (hasFile)
                    {
                        <div class="current-file-card">
                            <div class="current-file-left">
                                <div class="current-file-icon">
                                    <i class="fas fa-file-pdf"></i>
                                </div>

                                <div class="min-w-0">
                                    <div class="current-file-title">
                                        Mevcut bildiri kitabı PDF’i yüklü
                                    </div>

                                    <div class="current-file-path">
                                        @Model.ProceedingBookFilePath
                                    </div>
                                </div>
                            </div>

                            <div class="current-file-actions">
                                <a href="@Model.ProceedingBookFilePath"
                                   target="_blank"
                                   class="file-view-btn">
                                    <i class="fas fa-eye"></i>
                                    Görüntüle
                                </a>

                                <button type="button"
                                        class="file-remove-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#removeProceedingBookModal">
                                    <i class="fas fa-trash"></i>
                                    Kaldır
                                </button>
                            </div>
                        </div>

                        <div class="pdf-preview-card">
                            <div class="pdf-preview-header">
                                <div class="pdf-preview-title">
                                    <div class="pdf-preview-icon">
                                        <i class="fas fa-file-pdf"></i>
                                    </div>

                                    <div>
                                        <strong>Bildiri Kitabı Önizleme</strong>
                                        <span>Oluşturulan veya yüklenen PDF dosyasını buradan kontrol edebilirsiniz.</span>
                                    </div>
                                </div>

                                <div class="pdf-preview-actions">
                                    <a href="@Model.ProceedingBookFilePath"
                                       target="_blank"
                                       class="pdf-preview-btn">
                                        <i class="fas fa-up-right-from-square"></i>
                                        Yeni Sekmede Aç
                                    </a>

                                    <a href="@Model.ProceedingBookFilePath"
                                       download
                                       class="pdf-preview-btn">
                                        <i class="fas fa-download"></i>
                                        İndir
                                    </a>
                                </div>
                            </div>

                            <div class="pdf-preview-body">
                                <iframe src="@($"{Model.ProceedingBookFilePath}#toolbar=1&navpanes=0&scrollbar=1")"
                                        class="pdf-preview-frame">
                                </iframe>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="no-file-card">
                            <div class="no-file-icon">
                                <i class="fas fa-file-circle-xmark"></i>
                            </div>

                            <div class="no-file-title">
                                Henüz PDF yüklenmedi
                            </div>

                            <p class="no-file-text">
                                PDF dosyasını manuel yükleyebilir veya kabul edilmiş bildirilerden otomatik bildiri kitabı oluşturabilirsiniz.
                            </p>
                        </div>
                    }

                    <form action="@postUrl"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ConferenceId" />
                        <input type="hidden" asp-for="Slug" />
                        <input type="hidden" asp-for="ConferenceTitle" />
                        <input type="hidden" asp-for="ProceedingBookFilePath" />
                        <input type="hidden" asp-for="ProceedingBookPublishedDate" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-4">
                            <label asp-for="ProceedingBookFile" class="form-label-modern">
                                Yeni PDF Dosyası
                            </label>

                            <div class="file-upload-box">
                                <input asp-for="ProceedingBookFile"
                                       type="file"
                                       accept="application/pdf,.pdf"
                                       class="form-control form-control-modern" />

                                <div class="file-upload-help">
                                    Sadece PDF dosyası yükleyiniz. Maksimum dosya boyutu 50 MB olarak kontrol edilir.
                                    Yeni PDF yüklerseniz eski dosya otomatik olarak değiştirilecektir.
                                </div>
                            </div>

                            <span asp-validation-for="ProceedingBookFile" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="modern-switch-card">
                            <div>
                                <div class="modern-switch-title">
                                    Bildiri kitabı yayında olsun
                                </div>

                                <div class="modern-switch-text">
                                    Bu seçenek aktif olduğunda yazar panelindeki Bildiri Kitabı ekranında PDF görüntülenir ve indirilebilir.
                                </div>
                            </div>

                            <div class="form-check form-switch m-0">
                                <input asp-for="IsProceedingBookPublished"
                                       class="form-check-input"
                                       type="checkbox" />
                            </div>
                        </div>

                        <span asp-validation-for="IsProceedingBookPublished" class="text-danger small fw-bold"></span>

                        <div class="proceeding-actions">
                            <a href="@backUrl" class="cancel-btn">
                                <i class="fas fa-times"></i>
                                Vazgeç
                            </a>

                            <button type="submit" class="save-btn">
                                <i class="fas fa-save"></i>
                                Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <aside class="side-card">
                @if (Model.IsProceedingBookPublished)
                {
                    <div class="status-badge status-published">
                        <i class="fas fa-circle-check"></i>
                        Yayında
                    </div>
                }
                else
                {
                    <div class="status-badge status-draft">
                        <i class="fas fa-clock"></i>
                        Yayında Değil
                    </div>
                }

                <h5 class="side-title">
                    Yayın Bilgisi
                </h5>

                <p class="side-text">
                    Bildiri kitabı yayınlandığında yazar ve katılımcılar ilgili kongre panelinden PDF dosyasına erişebilir.
                </p>

                <ul class="info-list">
                    <li>
                        <i class="fas fa-calendar-check"></i>
                        <span>
                            Yayın Tarihi:
                            <strong>@publishedDateText</strong>
                        </span>
                    </li>

                    <li>
                        <i class="fas fa-file-pdf"></i>
                        <span>
                            Dosya Durumu:
                            <strong>@(hasFile ? "PDF yüklü" : "PDF yüklenmedi")</strong>
                        </span>
                    </li>

                    <li>
                        <i class="fas fa-eye"></i>
                        <span>
                            Görünürlük:
                            <strong>@(Model.IsProceedingBookPublished ? "Yazar panelinde görünür" : "Yazar panelinde gizli")</strong>
                        </span>
                    </li>

                    <li>
                        <i class="fas fa-circle-info"></i>
                        <span>
                            Yayına almak için manuel PDF yükleyebilir veya otomatik oluşturma seçeneğini kullanabilirsiniz.
                        </span>
                    </li>
                </ul>
            </aside>
        </div>

    </div>
</div>

<div class="modal fade"
     id="generateProceedingBookModal"
     tabindex="-1"
     aria-labelledby="generateProceedingBookModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content remove-modal-content">
            <div class="modal-header remove-modal-header">
                <div class="remove-modal-icon" style="background: rgba(13, 110, 253, 0.10); color: #0d6efd;">
                    <i class="fas fa-wand-magic-sparkles"></i>
                </div>

                <div>
                    <h5 class="remove-modal-title" id="generateProceedingBookModalLabel">
                        Otomatik Bildiri Kitabı Oluştur
                    </h5>

                    <p class="remove-modal-subtitle">
                        Sistem kabul edilmiş bildirilerden PDF oluşturacak.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Kapat"></button>
            </div>

            <div class="modal-body remove-modal-body">
                <p class="mb-3 fw-bold text-secondary">
                    Bu kongreye ait kabul edilmiş bildirilerden otomatik bildiri kitabı oluşturulsun mu?
                </p>

                <div class="remove-warning">
                    <i class="fas fa-circle-info"></i>
                    <span>
                        Mevcut PDF varsa yeni oluşturulan dosya ile değiştirilecektir.
                        Sadece kabul edilmiş bildiriler bildiri kitabına eklenir.
                    </span>
                </div>
            </div>

            <div class="modal-footer remove-modal-footer">
                <button type="button"
                        class="btn remove-cancel-btn"
                        data-bs-dismiss="modal">
                    Vazgeç
                </button>

                <form action="@generateUrl"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />

                    <button type="submit"
                            class="btn remove-confirm-btn"
                            style="background: #0d6efd; box-shadow: 0 12px 26px rgba(13, 110, 253, 0.24);">
                        <i class="fas fa-file-circle-plus me-2"></i>
                        Evet, Oluştur
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (hasFile)
{
    <div class="modal fade"
         id="removeProceedingBookModal"
         tabindex="-1"
         aria-labelledby="removeProceedingBookModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content remove-modal-content">
                <div class="modal-header remove-modal-header">
                    <div class="remove-modal-icon">
                        <i class="fas fa-trash"></i>
                    </div>

                    <div>
                        <h5 class="remove-modal-title" id="removeProceedingBookModalLabel">
                            PDF Dosyasını Kaldır
                        </h5>

                        <p class="remove-modal-subtitle">
                            Bu işlem mevcut bildiri kitabını yayından kaldırır.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Kapat"></button>
                </div>

                <div class="modal-body remove-modal-body">
                    <p class="mb-3 fw-bold text-secondary">
                        Mevcut bildiri kitabı PDF dosyasını kaldırmak istediğinize emin misiniz?
                    </p>

                    <div class="remove-warning">
                        <i class="fas fa-circle-info"></i>
                        <span>
                            PDF dosyası kaldırılırsa bildiri kitabı otomatik olarak yayından kaldırılır.
                            Yazar panelinde artık görüntülenmez.
                        </span>
                    </div>
                </div>

                <div class="modal-footer remove-modal-footer">
                    <button type="button"
                            class="btn remove-cancel-btn"
                            data-bs-dismiss="modal">
                        Vazgeç
                    </button>

                    <form action="@removeFileUrl"
                          method="post"
                          class="m-0">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />

                        <button type="submit" class="btn remove-confirm-btn">
                            <i class="fas fa-trash me-2"></i>
                            Evet, Kaldır
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
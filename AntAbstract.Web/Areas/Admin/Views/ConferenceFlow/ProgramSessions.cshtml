@model IEnumerable<AntAbstract.Domain.Entities.Session>
@using System
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = "Program / Oturumlar";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var sessions = Model?.ToList() ?? new List<Session>();

    var conferenceId = ViewBag.ConferenceId;
    var conferenceTitle = ViewBag.ConferenceTitle as string ?? "";
    var slug = ViewBag.Slug as string ?? "";

    var totalSessions = ViewBag.TotalSessions as int? ?? sessions.Count;

    var speakerCount = ViewBag.SpeakerCount as int? ?? sessions
        .Where(x => !string.IsNullOrWhiteSpace(x.SpeakerName))
        .Select(x => x.SpeakerName!.Trim().ToLower())
        .Distinct()
        .Count();

    var hallCount = ViewBag.HallCount as int? ?? sessions
        .Where(x => !string.IsNullOrWhiteSpace(x.Location))
        .Select(x => x.Location!.Trim().ToLower())
        .Distinct()
        .Count();

    var programDayCount = ViewBag.ProgramDayCount as int? ?? sessions
        .Select(x => x.SessionDate.Date)
        .Distinct()
        .Count();

    var conferenceIdText = conferenceId?.ToString() ?? Context.Request.Query["conferenceId"].ToString();

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow?conferenceId={conferenceIdText}"
        : $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceIdText}";

    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var createSessionUrl = !string.IsNullOrWhiteSpace(slug)
        ? string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}/Admin/Session/Create?returnUrl={Uri.EscapeDataString(currentUrl)}"
            : $"/{slug}/Admin/Session/Create?conferenceId={conferenceIdText}&returnUrl={Uri.EscapeDataString(currentUrl)}"
        : string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/Admin/Session"
            : $"/Admin/Session?conferenceId={conferenceIdText}";

    var printProgramUrl = !string.IsNullOrWhiteSpace(slug)
        ? string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}/Admin/ConferenceFlow/ProgramSessions/Print"
            : $"/{slug}/Admin/ConferenceFlow/ProgramSessions/Print?conferenceId={conferenceIdText}"
        : string.IsNullOrWhiteSpace(conferenceIdText)
            ? "/Admin/ConferenceFlow/ProgramSessions/Print"
            : $"/Admin/ConferenceFlow/ProgramSessions/Print?conferenceId={conferenceIdText}";

    var deleteSessionUrl = string.IsNullOrWhiteSpace(slug)
        ? string.IsNullOrWhiteSpace(conferenceIdText)
            ? "/Admin/Session/Delete"
            : $"/Admin/Session/Delete?conferenceId={conferenceIdText}"
        : string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}/Admin/Session/Delete"
            : $"/{slug}/Admin/Session/Delete?conferenceId={conferenceIdText}";

    var groupedSessions = sessions
        .OrderBy(x => x.SessionDate)
        .ThenBy(x => x.StartTime)
        .ThenBy(x => x.SortOrder)
        .GroupBy(x => x.SessionDate.Date)
        .ToList();

    string BuildSessionUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return string.IsNullOrWhiteSpace(conferenceIdText)
                ? path
                : $"{path}?conferenceId={conferenceIdText}";
        }

        return string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}{path}"
            : $"/{slug}{path}?conferenceId={conferenceIdText}";
    }
}

<div class="container-fluid program-session-page">

    <div class="operation-header-card mb-4">
        <div class="operation-header-left">
            <div class="operation-section-label">
                Kongre Operasyonları
            </div>

            <h2 class="operation-title">
                Program / Oturumlar
            </h2>

            <p class="operation-description">
                <strong>@conferenceTitle</strong> kongresine ait program akışını, oturumları, salon bilgilerini ve konuşmacı planlamasını buradan yönetebilirsiniz.
            </p>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <div class="mt-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                        /@slug
                    </span>
                </div>
            }
        </div>

        <div class="operation-header-right">
            <a href="@backUrl"
               class="btn btn-outline-secondary rounded-pill px-4 operation-back-btn">
                <i class="fas fa-arrow-left me-2"></i>
                Kongre Akışına Dön
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-blue">
                    <i class="fas fa-calendar-days"></i>
                </div>

                <div>
                    <div class="operation-stat-number">@totalSessions</div>
                    <div class="operation-stat-label">Toplam Oturum</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-green">
                    <i class="fas fa-microphone"></i>
                </div>

                <div>
                    <div class="operation-stat-number">@speakerCount</div>
                    <div class="operation-stat-label">Konuşmacı</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-orange">
                    <i class="fas fa-door-open"></i>
                </div>

                <div>
                    <div class="operation-stat-number">@hallCount</div>
                    <div class="operation-stat-label">Salon</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-purple">
                    <i class="fas fa-clock"></i>
                </div>

                <div>
                    <div class="operation-stat-number">@programDayCount</div>
                    <div class="operation-stat-label">Program Günü</div>
                </div>
            </div>
        </div>

    </div>

    <div class="operation-filter-card mb-4">
        <div class="row g-3 align-items-end">

            <div class="col-xl-5 col-lg-5">
                <label class="operation-label">
                    Arama
                </label>

                <div class="operation-input-wrap">
                    <i class="fas fa-search"></i>

                    <input type="text"
                           id="sessionSearchInput"
                           placeholder="Oturum adı, salon, konuşmacı veya sunum başlığı ara..." />
                </div>
            </div>

            <div class="col-xl-3 col-lg-3">
                <label class="operation-label">
                    Program Günü
                </label>

                <select id="sessionDayFilter" class="operation-select">
                    <option value="">Tüm Günler</option>

                    @for (int i = 0; i < groupedSessions.Count; i++)
                    {
                        <option value="@(i + 1)">@(i + 1). Gün</option>
                    }
                </select>
            </div>

            <div class="col-xl-2 col-lg-2">
                <button type="button"
                        id="filterSessionButton"
                        class="btn operation-primary-btn w-100">
                    <i class="fas fa-search me-2"></i>
                    Filtrele
                </button>
            </div>

            <div class="col-xl-2 col-lg-2">
                <button type="button"
                        id="resetSessionButton"
                        class="btn operation-reset-btn w-100">
                    <i class="fas fa-rotate-left me-2"></i>
                    Temizle
                </button>
            </div>

        </div>
    </div>

    <div class="operation-main-card">
        <div class="operation-main-card-header">
            <div>
                <h5>
                    Oturum Listesi
                </h5>

                <p>
                    Kongre programına ait oturumlar, salonlar ve saat aralıkları burada listelenir.
                </p>
            </div>

            <div class="operation-header-actions">
                <a href="@printProgramUrl"
                   target="_blank"
                   class="btn operation-light-btn">
                    <i class="fas fa-file-pdf me-2"></i>
                    PDF Olarak Aktar
                </a>

                <a href="@createSessionUrl"
                   class="btn operation-primary-btn">
                    <i class="fas fa-plus me-2"></i>
                    Yeni Oturum Ekle
                </a>
            </div>
        </div>

        @if (groupedSessions.Any())
        {
            <div class="program-timeline-list">
                @for (int i = 0; i < groupedSessions.Count; i++)
                {
                    var dayGroup = groupedSessions[i];
                    var dayNumber = i + 1;

                    <div class="timeline-day-card real-day-card session-day-item"
                         data-day="@dayNumber">
                        <div class="timeline-day-header">
                            <div>
                                <span class="timeline-day-badge">
                                    @dayNumber. Gün
                                </span>

                                <span class="timeline-day-date">
                                    @dayGroup.Key.ToString("dd MMMM yyyy")
                                </span>
                            </div>

                            <span class="day-session-count">
                                @dayGroup.Count() oturum
                            </span>
                        </div>

                        <div class="session-timeline-items">
                            @foreach (var item in dayGroup.OrderBy(x => x.StartTime).ThenBy(x => x.SortOrder))
                            {
                                var manageUrl = BuildSessionUrl($"/Admin/Session/Manage/{item.Id}");
                                var editUrl = BuildSessionUrl($"/Admin/Session/Edit/{item.Id}");
                                var submissionCount = item.Submissions?.Count ?? 0;

                                var searchableText = $"{item.Title} {item.TitleEn} {item.Location} {item.SpeakerName} {item.PresentationTitle} {item.Description}".ToLower();

                                <div class="session-row-item"
                                     data-search="@searchableText"
                                     data-day="@dayNumber">
                                    <div class="session-time-column">
                                        <div class="session-time-range">
                                            @item.StartTime.ToString(@"hh\:mm")
                                            <span></span>
                                            @item.EndTime.ToString(@"hh\:mm")
                                        </div>

                                        <div class="session-status @(item.IsActive ? "active" : "passive")">
                                            @(item.IsActive ? "Aktif" : "Pasif")
                                        </div>
                                    </div>

                                    <div class="session-content-column">
                                        <div class="session-title-row">
                                            <h6>
                                                @item.Title
                                            </h6>

                                            @if (item.SortOrder > 0)
                                            {
                                                <span class="sort-badge">
                                                    Sıra @item.SortOrder
                                                </span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="session-description">
                                                @item.Description
                                            </p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.PresentationTitle))
                                        {
                                            <p class="session-description">
                                                @item.PresentationTitle
                                            </p>
                                        }

                                        <div class="session-meta-list">
                                            <span class="session-meta">
                                                <i class="fas fa-location-dot"></i>
                                                @(string.IsNullOrWhiteSpace(item.Location) ? "Konum belirtilmedi" : item.Location)
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(item.SpeakerName))
                                            {
                                                <span class="session-meta">
                                                    <i class="fas fa-microphone"></i>
                                                    @item.SpeakerName
                                                </span>
                                            }

                                            <span class="session-meta">
                                                <i class="fas fa-file-lines"></i>
                                                @submissionCount bildiri
                                            </span>
                                        </div>
                                    </div>

                                    <div class="session-action-column">
                                        <a href="@manageUrl"
                                           class="btn session-action-btn manage">
                                            <i class="fas fa-list-check"></i>
                                            Yönet
                                        </a>

                                        <a href="@editUrl"
                                           class="btn session-action-btn edit">
                                            <i class="fas fa-pen"></i>
                                            Düzenle
                                        </a>

                                        <button type="button"
                                                class="btn session-action-btn delete js-open-delete-session-modal"
                                                data-session-id="@item.Id"
                                                data-session-title="@item.Title"
                                                data-session-date="@item.SessionDate.ToString("dd MMMM yyyy")"
                                                data-session-time="@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="operation-empty-state d-none" id="sessionNoResultState">
                <div class="empty-state-icon">
                    <i class="fas fa-magnifying-glass"></i>
                </div>

                <h4>
                    Aramaya uygun oturum bulunamadı
                </h4>

                <p>
                    Arama metnini veya gün filtresini değiştirerek tekrar deneyebilirsiniz.
                </p>
            </div>
        }
        else
        {
            <div class="program-timeline-preview">
                <div class="timeline-day-card">
                    <div class="timeline-day-header">
                        <span class="timeline-day-badge">
                            1. Gün
                        </span>

                        <span class="timeline-day-date">
                            Program akışı oluşturulmadı
                        </span>
                    </div>

                    <div class="timeline-empty-line">
                        <span></span>
                        <div></div>
                    </div>

                    <div class="timeline-empty-line short">
                        <span></span>
                        <div></div>
                    </div>
                </div>

                <div class="timeline-day-card">
                    <div class="timeline-day-header">
                        <span class="timeline-day-badge">
                            2. Gün
                        </span>

                        <span class="timeline-day-date">
                            Program akışı oluşturulmadı
                        </span>
                    </div>

                    <div class="timeline-empty-line">
                        <span></span>
                        <div></div>
                    </div>

                    <div class="timeline-empty-line short">
                        <span></span>
                        <div></div>
                    </div>
                </div>
            </div>

            <div class="operation-empty-state" id="sessionEmptyState">
                <div class="empty-state-icon">
                    <i class="fas fa-calendar-plus"></i>
                </div>

                <h4>
                    Henüz oturum eklenmedi
                </h4>

                <p>
                    Bu kongreye ait program, oturum, salon veya konuşmacı bilgisi eklendiğinde burada görüntülenecek.
                </p>

                <div class="empty-state-actions">
                    <a href="@backUrl"
                       class="btn operation-light-btn">
                        <i class="fas fa-arrow-left me-2"></i>
                        Kongre Akışına Dön
                    </a>

                    <a href="@createSessionUrl"
                       class="btn operation-primary-btn">
                        <i class="fas fa-plus me-2"></i>
                        İlk Oturumu Ekle
                    </a>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <a href="/@slug"
                           target="_blank"
                           class="btn operation-light-btn">
                            <i class="fas fa-external-link-alt me-2"></i>
                            Kongre Sitesini Gör
                        </a>
                    }
                </div>
            </div>
        }
    </div>

</div>

<div class="modal fade session-delete-modal"
     id="deleteSessionModal"
     tabindex="-1"
     aria-labelledby="deleteSessionModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content session-delete-modal-content">
            <div class="modal-header session-delete-modal-header">
                <div class="session-delete-icon">
                    <i class="fas fa-trash"></i>
                </div>

                <div>
                    <h5 class="modal-title" id="deleteSessionModalLabel">
                        Oturumu Sil
                    </h5>

                    <p class="session-delete-subtitle">
                        Bu işlem geri alınamaz.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Kapat"></button>
            </div>

            <div class="modal-body session-delete-modal-body">
                <p class="session-delete-text">
                    Aşağıdaki oturumu silmek istediğinize emin misiniz?
                </p>

                <div class="session-delete-preview">
                    <div class="session-delete-preview-icon">
                        <i class="fas fa-calendar-xmark"></i>
                    </div>

                    <div>
                        <div class="session-delete-preview-title" id="deleteSessionTitle">
                            -
                        </div>

                        <div class="session-delete-preview-meta">
                            <span id="deleteSessionDate">-</span>
                            <span>•</span>
                            <span id="deleteSessionTime">-</span>
                        </div>
                    </div>
                </div>

                <div class="session-delete-warning">
                    <i class="fas fa-circle-info"></i>
                    <span>
                        Oturum silinir; bu oturuma bağlı bildiriler silinmez, sadece oturum bağlantıları kaldırılır.
                    </span>
                </div>
            </div>

            <div class="modal-footer session-delete-modal-footer">
                <button type="button"
                        class="btn session-delete-cancel-btn"
                        data-bs-dismiss="modal">
                    Vazgeç
                </button>

                <form action="@deleteSessionUrl"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" id="deleteSessionId" />

                    <button type="submit"
                            class="btn session-delete-confirm-btn">
                        <i class="fas fa-trash me-2"></i>
                        Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("sessionSearchInput");
            const dayFilter = document.getElementById("sessionDayFilter");
            const filterButton = document.getElementById("filterSessionButton");
            const resetButton = document.getElementById("resetSessionButton");
            const noResultState = document.getElementById("sessionNoResultState");

            const filterSessions = function () {
                const searchText = searchInput ? searchInput.value.trim().toLowerCase() : "";
                const selectedDay = dayFilter ? dayFilter.value : "";

                const sessionRows = document.querySelectorAll(".session-row-item");
                const dayCards = document.querySelectorAll(".session-day-item");

                let visibleSessionCount = 0;

                sessionRows.forEach(function (row) {
                    const rowText = row.dataset.search || "";
                    const rowDay = row.dataset.day || "";

                    const searchMatch = !searchText || rowText.includes(searchText);
                    const dayMatch = !selectedDay || rowDay === selectedDay;

                    const isVisible = searchMatch && dayMatch;

                    row.classList.toggle("d-none", !isVisible);

                    if (isVisible) {
                        visibleSessionCount++;
                    }
                });

                dayCards.forEach(function (card) {
                    const visibleRows = card.querySelectorAll(".session-row-item:not(.d-none)");
                    card.classList.toggle("d-none", visibleRows.length === 0);
                });

                if (noResultState) {
                    noResultState.classList.toggle("d-none", visibleSessionCount !== 0);
                }
            };

            if (filterButton) {
                filterButton.addEventListener("click", filterSessions);
            }

            if (searchInput) {
                searchInput.addEventListener("keyup", function (event) {
                    if (event.key === "Enter") {
                        filterSessions();
                    }
                });
            }

            if (dayFilter) {
                dayFilter.addEventListener("change", filterSessions);
            }

            if (resetButton) {
                resetButton.addEventListener("click", function () {
                    if (searchInput) {
                        searchInput.value = "";
                    }

                    if (dayFilter) {
                        dayFilter.value = "";
                    }

                    filterSessions();
                });
            }

            const deleteModalElement = document.getElementById("deleteSessionModal");
            const deleteSessionIdInput = document.getElementById("deleteSessionId");
            const deleteSessionTitle = document.getElementById("deleteSessionTitle");
            const deleteSessionDate = document.getElementById("deleteSessionDate");
            const deleteSessionTime = document.getElementById("deleteSessionTime");

            if (deleteModalElement) {
                const deleteModal = new bootstrap.Modal(deleteModalElement);

                document.querySelectorAll(".js-open-delete-session-modal").forEach(function (button) {
                    button.addEventListener("click", function () {
                        const sessionId = button.dataset.sessionId || "";
                        const sessionTitle = button.dataset.sessionTitle || "-";
                        const sessionDate = button.dataset.sessionDate || "-";
                        const sessionTime = button.dataset.sessionTime || "-";

                        if (deleteSessionIdInput) {
                            deleteSessionIdInput.value = sessionId;
                        }

                        if (deleteSessionTitle) {
                            deleteSessionTitle.textContent = sessionTitle;
                        }

                        if (deleteSessionDate) {
                            deleteSessionDate.textContent = sessionDate;
                        }

                        if (deleteSessionTime) {
                            deleteSessionTime.textContent = sessionTime;
                        }

                        deleteModal.show();
                    });
                });
            }
        });
    </script>

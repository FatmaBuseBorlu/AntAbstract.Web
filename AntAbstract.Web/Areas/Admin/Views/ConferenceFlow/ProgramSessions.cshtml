@model IEnumerable<AntAbstract.Domain.Entities.Session>

@using System
@using System.Collections.Generic
@using System.Linq
@using AntAbstract.Domain.Entities

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var sessions = Model?.ToList() ?? new List<Session>();

    var conferenceId = ViewBag.ConferenceId is Guid selectedConferenceId
        ? selectedConferenceId
        : Guid.Empty;

    var conferenceTitle = ViewBag.ConferenceTitle as string ?? "";
    var slug = ViewBag.Slug as string ?? "";

    var totalSessions = ViewBag.TotalSessions as int? ?? sessions.Count;

    var speakerCount = ViewBag.SpeakerCount as int? ?? sessions
        .Where(x => !string.IsNullOrWhiteSpace(x.SpeakerName))
        .Select(x => x.SpeakerName!.Trim().ToLower())
        .Distinct()
        .Count();

    var hallCount = ViewBag.HallCount as int? ?? sessions
        .Where(x => !string.IsNullOrWhiteSpace(x.Location))
        .Select(x => x.Location!.Trim().ToLower())
        .Distinct()
        .Count();

    var programDayCount = ViewBag.ProgramDayCount as int? ?? sessions
        .Select(x => x.SessionDate.Date)
        .Distinct()
        .Count();

    var conferenceIdText = conferenceId != Guid.Empty
        ? conferenceId.ToString()
        : Context.Request.Query["conferenceId"].ToString();

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow?conferenceId={conferenceIdText}"
        : $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceIdText}";

    var changeConferenceUrl = "/Admin/ConferenceFlow?forceSelect=true";

    var publicSiteUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}";

    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var createSessionUrl = !string.IsNullOrWhiteSpace(slug)
        ? string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}/Admin/Session/Create?returnUrl={Uri.EscapeDataString(currentUrl)}"
            : $"/{slug}/Admin/Session/Create?conferenceId={conferenceIdText}&returnUrl={Uri.EscapeDataString(currentUrl)}"
        : string.IsNullOrWhiteSpace(conferenceIdText)
            ? "/Admin/Session"
            : $"/Admin/Session?conferenceId={conferenceIdText}";

    var printProgramUrl = !string.IsNullOrWhiteSpace(slug)
        ? string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}/Admin/ConferenceFlow/ProgramSessions/Print"
            : $"/{slug}/Admin/ConferenceFlow/ProgramSessions/Print?conferenceId={conferenceIdText}"
        : string.IsNullOrWhiteSpace(conferenceIdText)
            ? "/Admin/ConferenceFlow/ProgramSessions/Print"
            : $"/Admin/ConferenceFlow/ProgramSessions/Print?conferenceId={conferenceIdText}";

    var deleteSessionUrl = string.IsNullOrWhiteSpace(slug)
        ? string.IsNullOrWhiteSpace(conferenceIdText)
            ? "/Admin/Session/Delete"
            : $"/Admin/Session/Delete?conferenceId={conferenceIdText}"
        : string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}/Admin/Session/Delete"
            : $"/{slug}/Admin/Session/Delete?conferenceId={conferenceIdText}";

    var groupedSessions = sessions
        .OrderBy(x => x.SessionDate)
        .ThenBy(x => x.StartTime)
        .ThenBy(x => x.SortOrder)
        .GroupBy(x => x.SessionDate.Date)
        .ToList();

    string BuildSessionUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return string.IsNullOrWhiteSpace(conferenceIdText)
                ? path
                : $"{path}?conferenceId={conferenceIdText}";
        }

        return string.IsNullOrWhiteSpace(conferenceIdText)
            ? $"/{slug}{path}"
            : $"/{slug}{path}?conferenceId={conferenceIdText}";
    }
}

<div class="container-fluid program-session-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-success mb-4">
            <i class="fas fa-circle-check"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-info mb-4">
            <i class="fas fa-circle-info"></i>
            <span>@TempData["InfoMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-error mb-4">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="operation-header-card mb-4">
        <div class="operation-header-left">
            <div class="operation-header-icon">
                <i class="fas fa-microphone-lines"></i>
            </div>

            <div>
                <div class="operation-section-label">
                    @Localizer["ConferenceOperations"]
                </div>

                <h2 class="operation-title">
                    @Localizer["ProgramSessions"]
                </h2>

                <p class="operation-description">
                    <strong>@conferenceTitle</strong> @Localizer["HeaderDescriptionSuffix"]
                </p>

                <div class="operation-chip-row">
                    <span class="operation-chip operation-chip-primary">
                        <i class="fas fa-calendar-check"></i>
                        @Localizer["SelectedConference"]
                    </span>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <span class="operation-chip">
                            <i class="fas fa-link"></i>
                            /@slug
                        </span>
                    }

                    <span class="operation-chip">
                        <i class="fas fa-calendar-days"></i>
                        @totalSessions @Localizer["SessionCount"]
                    </span>
                </div>
            </div>
        </div>

        <div class="operation-header-right">
            <a href="@backUrl"
               class="btn operation-light-btn">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToConferenceFlow"]
            </a>

            <a href="@changeConferenceUrl"
               class="btn operation-outline-btn">
                <i class="fas fa-exchange-alt"></i>
                @Localizer["ChangeConference"]
            </a>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <a href="@publicSiteUrl"
                   target="_blank"
                   class="btn operation-outline-btn">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    @Localizer["ViewSite"]
                </a>
            }

            <a href="@createSessionUrl"
               class="btn operation-primary-btn">
                <i class="fas fa-plus"></i>
                @Localizer["AddNewSession"]
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-blue">
                    <i class="fas fa-calendar-days"></i>
                </div>

                <div>
                    <div class="operation-stat-number">
                        @totalSessions
                    </div>

                    <div class="operation-stat-label">
                        @Localizer["TotalSessions"]
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-green">
                    <i class="fas fa-microphone"></i>
                </div>

                <div>
                    <div class="operation-stat-number">
                        @speakerCount
                    </div>

                    <div class="operation-stat-label">
                        @Localizer["Speaker"]
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-orange">
                    <i class="fas fa-door-open"></i>
                </div>

                <div>
                    <div class="operation-stat-number">
                        @hallCount
                    </div>

                    <div class="operation-stat-label">
                        @Localizer["Hall"]
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-purple">
                    <i class="fas fa-clock"></i>
                </div>

                <div>
                    <div class="operation-stat-number">
                        @programDayCount
                    </div>

                    <div class="operation-stat-label">
                        @Localizer["ProgramDay"]
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="operation-filter-card mb-4">
        <div class="row g-3 align-items-end">

            <div class="col-xl-5 col-lg-5">
                <label class="operation-label">
                    @Localizer["Search"]
                </label>

                <div class="operation-input-wrap">
                    <i class="fas fa-search"></i>

                    <input type="text"
                           id="sessionSearchInput"
                           placeholder="@Localizer["SearchPlaceholder"].Value" />
                </div>
            </div>

            <div class="col-xl-3 col-lg-3">
                <label class="operation-label">
                    @Localizer["ProgramDay"]
                </label>

                <select id="sessionDayFilter" class="operation-select">
                    <option value="">@Localizer["AllDays"]</option>

                    @for (int i = 0; i < groupedSessions.Count; i++)
                    {
                        <option value="@(i + 1)">@(i + 1). Gün</option>
                    }
                </select>
            </div>

            <div class="col-xl-2 col-lg-2">
                <button type="button"
                        id="filterSessionButton"
                        class="btn operation-primary-btn w-100">
                    <i class="fas fa-search"></i>
                    Filtrele
                </button>
            </div>

            <div class="col-xl-2 col-lg-2">
                <button type="button"
                        id="resetSessionButton"
                        class="btn operation-reset-btn w-100">
                    <i class="fas fa-rotate-left"></i>
                    Temizle
                </button>
            </div>

        </div>
    </div>

    <div class="operation-main-card">
        <div class="operation-main-card-header">
            <div>
                <h5>
                    Oturum Listesi
                </h5>

                <p>
                    Kongre programına ait @Localizer["Sessions"]lar, salonlar ve saat aralıkları burada listelenir.
                </p>
            </div>

            <div class="operation-header-actions">
                <a href="@printProgramUrl"
                   target="_blank"
                   class="btn operation-light-btn">
                    <i class="fas fa-print"></i>
                    Programı Yazdır
                </a>

                <a href="@createSessionUrl"
                   class="btn operation-primary-btn">
                    <i class="fas fa-plus"></i>
                    @Localizer["AddNewSession"]
                </a>
            </div>
        </div>

        @if (groupedSessions.Any())
        {
            <div class="program-timeline-list">
                @for (int i = 0; i < groupedSessions.Count; i++)
                {
                    var dayGroup = groupedSessions[i];
                    var dayNumber = i + 1;

                    <div class="timeline-day-card real-day-card session-day-item"
                         data-day="@dayNumber">
                        <div class="timeline-day-header">
                            <div>
                                <span class="timeline-day-badge">
                                    @dayNumber. Gün
                                </span>

                                <span class="timeline-day-date">
                                    @dayGroup.Key.ToString("dd MMMM yyyy")
                                </span>
                            </div>

                            <span class="day-session-count">
                                @dayGroup.Count() @Localizer["Sessions"]
                            </span>
                        </div>

                        <div class="session-timeline-items">
                            @foreach (var item in dayGroup.OrderBy(x => x.StartTime).ThenBy(x => x.SortOrder))
                            {
                                var manageUrl = BuildSessionUrl($"/Admin/Session/Manage/{item.Id}");
                                var editUrl = BuildSessionUrl($"/Admin/Session/Edit/{item.Id}");
                                var submissionCount = item.Submissions?.Count ?? 0;

                                var searchableText = $"{item.Title} {item.TitleEn} {item.Location} {item.SpeakerName} {item.PresentationTitle} {item.Description}".ToLower();

                                <div class="session-row-item"
                                     data-search="@searchableText"
                                     data-day="@dayNumber">
                                    <div class="session-time-column">
                                        <div class="session-time-range">
                                            @item.StartTime.ToString(@"hh\:mm")
                                            <span></span>
                                            @item.EndTime.ToString(@"hh\:mm")
                                        </div>

                                        <div class="session-status @(item.IsActive ? "active" : "passive")">
                                            @(item.IsActive ? "Aktif" : "Pasif")
                                        </div>
                                    </div>

                                    <div class="session-content-column">
                                        <div class="session-title-row">
                                            <h6>
                                                @item.Title
                                            </h6>

                                            @if (item.SortOrder > 0)
                                            {
                                                <span class="sort-badge">
                                                    Sıra @item.SortOrder
                                                </span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="session-description">
                                                @item.Description
                                            </p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.PresentationTitle))
                                        {
                                            <p class="session-description">
                                                @item.PresentationTitle
                                            </p>
                                        }

                                        <div class="session-meta-list">
                                            <span class="session-meta">
                                                <i class="fas fa-location-dot"></i>
                                                @(string.IsNullOrWhiteSpace(item.Location) ? "Konum belirtilmedi" : item.Location)
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(item.SpeakerName))
                                            {
                                                <span class="session-meta">
                                                    <i class="fas fa-microphone"></i>
                                                    @item.SpeakerName
                                                </span>
                                            }

                                            <span class="session-meta">
                                                <i class="fas fa-file-lines"></i>
                                                @submissionCount bildiri
                                            </span>
                                        </div>
                                    </div>

                                    <div class="session-action-column">
                                        <a href="@manageUrl"
                                           class="btn session-action-btn manage">
                                            <i class="fas fa-list-check"></i>
                                            Yönet
                                        </a>

                                        <a href="@editUrl"
                                           class="btn session-action-btn edit">
                                            <i class="fas fa-pen"></i>
                                            Düzenle
                                        </a>

                                        <button type="button"
                                                class="btn session-action-btn delete js-open-delete-session-modal"
                                                data-session-id="@item.Id"
                                                data-session-title="@item.Title"
                                                data-session-date="@item.SessionDate.ToString("dd MMMM yyyy")"
                                                data-session-time="@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")">
                                            <i class="fas fa-trash"></i>
                                            Sil
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="operation-empty-state d-none" id="sessionNoResultState">
                <div class="empty-state-icon">
                    <i class="fas fa-magnifying-glass"></i>
                </div>

                <h4>
                    Aramaya uygun @Localizer["Sessions"] bulunamadı
                </h4>

                <p>
                    Arama metnini veya gün filtresini değiştirerek tekrar deneyebilirsiniz.
                </p>
            </div>
        }
        else
        {
            <div class="program-timeline-preview">
                <div class="timeline-day-card">
                    <div class="timeline-day-header">
                        <span class="timeline-day-badge">
                            1. Gün
                        </span>

                        <span class="timeline-day-date">
                            Program akışı oluşturulmadı
                        </span>
                    </div>

                    <div class="timeline-empty-line">
                        <span></span>
                        <div></div>
                    </div>

                    <div class="timeline-empty-line short">
                        <span></span>
                        <div></div>
                    </div>
                </div>

                <div class="timeline-day-card">
                    <div class="timeline-day-header">
                        <span class="timeline-day-badge">
                            2. Gün
                        </span>

                        <span class="timeline-day-date">
                            Program akışı oluşturulmadı
                        </span>
                    </div>

                    <div class="timeline-empty-line">
                        <span></span>
                        <div></div>
                    </div>

                    <div class="timeline-empty-line short">
                        <span></span>
                        <div></div>
                    </div>
                </div>
            </div>

            <div class="operation-empty-state" id="sessionEmptyState">
                <div class="empty-state-icon">
                    <i class="fas fa-calendar-plus"></i>
                </div>

                <h4>
                    Henüz @Localizer["Sessions"] eklenmedi
                </h4>

                <p>
                    Bu kongreye ait program, @Localizer["Sessions"], salon veya konuşmacı bilgisi eklendiğinde burada görüntülenecek.
                </p>

                <div class="empty-state-actions">
                    <a href="@backUrl"
                       class="btn operation-light-btn">
                        <i class="fas fa-arrow-left"></i>
                        Kongre Akışına Dön
                    </a>

                    <a href="@createSessionUrl"
                       class="btn operation-primary-btn">
                        <i class="fas fa-plus"></i>
                        İlk Oturumu Ekle
                    </a>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <a href="@publicSiteUrl"
                           target="_blank"
                           class="btn operation-light-btn">
                            <i class="fas fa-arrow-up-right-from-square"></i>
                            Kongre Sitesini Gör
                        </a>
                    }
                </div>
            </div>
        }
    </div>

</div>

<div class="modal fade session-delete-modal"
     id="deleteSessionModal"
     tabindex="-1"
     aria-labelledby="deleteSessionModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content session-delete-modal-content">
            <div class="modal-header session-delete-modal-header">
                <div class="session-delete-icon">
                    <i class="fas fa-trash"></i>
                </div>

                <div>
                    <h5 class="modal-title" id="deleteSessionModalLabel">
                        Oturumu Sil
                    </h5>

                    <p class="session-delete-subtitle">
                        Bu işlem geri alınamaz.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Kapat"></button>
            </div>

            <div class="modal-body session-delete-modal-body">
                <p class="session-delete-text">
                    Aşağıdaki @Localizer["Sessions"]u silmek istediğinize emin misiniz?
                </p>

                <div class="session-delete-preview">
                    <div class="session-delete-preview-icon">
                        <i class="fas fa-calendar-xmark"></i>
                    </div>

                    <div>
                        <div class="session-delete-preview-title" id="deleteSessionTitle">
                            -
                        </div>

                        <div class="session-delete-preview-meta">
                            <span id="deleteSessionDate">-</span>
                            <span>•</span>
                            <span id="deleteSessionTime">-</span>
                        </div>
                    </div>
                </div>

                <div class="session-delete-warning">
                    <i class="fas fa-circle-info"></i>

                    <span>
                        Oturum silinir; bu @Localizer["Sessions"]a bağlı bildiriler silinmez, sadece oturum bağlantıları kaldırılır.
                    </span>
                </div>
            </div>

            <div class="modal-footer session-delete-modal-footer">
                <button type="button"
                        class="btn session-delete-cancel-btn"
                        data-bs-dismiss="modal">
                    Vazgeç
                </button>

                <form action="@deleteSessionUrl"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" id="deleteSessionId" />

                    <button type="submit"
                            class="btn session-delete-confirm-btn">
                        <i class="fas fa-trash"></i>
                        Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .program-session-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .operation-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 18px;
        border: 1px solid transparent;
        font-weight: 800;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .operation-alert i {
        font-size: 1rem;
    }

    .operation-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .operation-alert-info {
        background: rgba(13, 110, 253, 0.10);
        border-color: rgba(13, 110, 253, 0.20);
        color: #0d6efd;
    }

    .operation-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .operation-header-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .operation-header-left {
        flex: 1;
        min-width: 300px;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .operation-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .operation-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .operation-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.45rem;
    }

    .operation-title {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
        margin: 0 0 0.4rem;
        line-height: 1.2;
    }

    .operation-description {
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        margin: 0;
        max-width: 860px;
        line-height: 1.65;
    }

    .operation-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.8rem;
    }

    .operation-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border-radius: 999px;
        padding: 0.48rem 0.78rem;
        font-size: 0.78rem;
        font-weight: 900;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .operation-chip-primary {
        background: rgba(0, 174, 239, 0.10);
        border-color: rgba(0, 174, 239, 0.22);
        color: #0d6efd;
    }

    .operation-light-btn,
    .operation-outline-btn,
    .operation-primary-btn,
    .operation-reset-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1.15rem;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .operation-light-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

    .operation-light-btn:hover {
        color: #0d6efd;
        background: #f8fbff;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .operation-outline-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;

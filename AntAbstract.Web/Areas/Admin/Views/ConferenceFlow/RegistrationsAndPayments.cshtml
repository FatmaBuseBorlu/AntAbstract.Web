@using AntAbstract.Web.Models.ViewModels.Admin.ConferenceFlow
@using System
@using System.Linq

@model RegistrationsAndPaymentsViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var conferenceId = Model.ConferenceId;
    var conferenceTitle = Model.ConferenceTitle ?? "";
    var slug = Model.Slug ?? "";

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow?conferenceId={conferenceId}"
        : $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceId}";

    var listUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/RegistrationsAndPayments?conferenceId={conferenceId}"
        : $"/{slug}/Admin/ConferenceFlow/RegistrationsAndPayments?conferenceId={conferenceId}";

    var approvePaymentUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/ConferenceFlow/RegistrationsAndPayments/ApprovePayment"
        : $"/{slug}/Admin/ConferenceFlow/RegistrationsAndPayments/ApprovePayment";

    var changeConferenceUrl = "/Admin/ConferenceFlow?forceSelect=true";

    var publicSiteUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}";

    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string Money(decimal amount, string currency = "TRY")
    {
        return amount.ToString("N2") + " " + currency;
    }

    string PaymentStatusText(bool isPaid)
    {
        return isPaid ? Localizer.GetString("Paid").Value : Localizer.GetString("Pending").Value;
    }

    string PaymentStatusClass(bool isPaid)
    {
        return isPaid ? "payment-paid" : "payment-pending";
    }

    string GetParticipantInitial(string fullName)
    {
        return string.IsNullOrWhiteSpace(fullName)
            ? "K"
            : fullName.Trim().Substring(0, 1).ToUpper();
    }

    var revokePaymentUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/ConferenceFlow/RegistrationsAndPayments/RevokePayment"
        : $"/{slug}/Admin/ConferenceFlow/RegistrationsAndPayments/RevokePayment";

    var exportUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/RegistrationsAndPayments/Export?conferenceId={conferenceId}&search={Model.Search}&paymentStatus={Model.PaymentStatus}&registrationTypeId={Model.RegistrationTypeId}"
        : $"/{slug}/Admin/ConferenceFlow/RegistrationsAndPayments/Export?conferenceId={conferenceId}&search={Model.Search}&paymentStatus={Model.PaymentStatus}&registrationTypeId={Model.RegistrationTypeId}";

    var totalFilteredCount = Model.FilteredCount;
}

<div class="container-fluid registration-payment-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-success mb-4">
            <i class="fas fa-circle-check"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-info mb-4">
            <i class="fas fa-circle-info"></i>
            <span>@TempData["InfoMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-error mb-4">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="operation-header-card mb-4">
        <div class="operation-header-left">
            <div class="operation-header-icon">
                <i class="fas fa-credit-card"></i>
            </div>

            <div>
                <div class="operation-section-label">
                    @Localizer["ConferenceOperations"]
                </div>

                <h2 class="operation-title">
                    @Localizer["RegistrationsAndPayments"]
                </h2>

                <p class="operation-description">
                    <strong>@conferenceTitle</strong> @Localizer["HeaderDescriptionSuffix"]
                </p>

                <div class="operation-chip-row">
                    <span class="operation-chip operation-chip-primary">
                        <i class="fas fa-calendar-check"></i>
                        @Localizer["SelectedConference"]
                    </span>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <span class="operation-chip">
                            <i class="fas fa-link"></i>
                            /@slug
                        </span>
                    }

                    <span class="operation-chip">
                        <i class="fas fa-receipt"></i>
                        @Model.TotalRegistrations @Localizer["RegistrationCount"]
                    </span>
                </div>
            </div>
        </div>

        <div class="operation-header-right">
            <a href="@backUrl"
               class="btn operation-light-btn">
                <i class="fas fa-arrow-left"></i>
                @Localizer["BackToConferenceFlow"]
            </a>

            <a href="@changeConferenceUrl"
               class="btn operation-outline-btn">
                <i class="fas fa-exchange-alt"></i>
                @Localizer["ChangeConference"]
            </a>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <a href="@publicSiteUrl"
                   target="_blank"
                   class="btn operation-primary-btn">
                    <i class="fas fa-arrow-up-right-from-square"></i>
                    @Localizer["ViewSite"]
                </a>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <a href="@listUrl" class="operation-stat-card @(string.IsNullOrEmpty(Model.PaymentStatus) ? "stat-active" : "")">
                <div class="operation-stat-icon stat-blue">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <div class="operation-stat-number">@Model.TotalRegistrations</div>
                    <div class="operation-stat-label">@Localizer["TotalRegistrations"]</div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="@(listUrl)&paymentStatus=paid" class="operation-stat-card @(Model.PaymentStatus == "paid" ? "stat-active" : "")">
                <div class="operation-stat-icon stat-green">
                    <i class="fas fa-circle-check"></i>
                </div>
                <div>
                    <div class="operation-stat-number">@Model.PaidRegistrations</div>
                    <div class="operation-stat-label">@Localizer["PaymentCompleted"]</div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="@(listUrl)&paymentStatus=pending" class="operation-stat-card @(Model.PaymentStatus == "pending" ? "stat-active" : "")">
                <div class="operation-stat-icon stat-orange">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <div class="operation-stat-number">@Model.PendingPayments</div>
                    <div class="operation-stat-label">@Localizer["PaymentPending"]</div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="operation-stat-card">
                <div class="operation-stat-icon stat-purple">
                    <i class="fas fa-wallet"></i>
                </div>
                <div>
                    <div class="operation-stat-number revenue-number">@Money(Model.TotalRevenue)</div>
                    <div class="operation-stat-label">@Localizer["TotalRevenue"]</div>
                </div>
            </div>
        </div>

    </div>

    <div class="operation-filter-card mb-4">
        <form method="get" action="@listUrl">
            <input type="hidden" name="conferenceId" value="@conferenceId" />

            <div class="row g-3 align-items-end">

                <div class="col-xl-4 col-lg-4">
                    <label class="operation-label">
                        @Localizer["Search"]
                    </label>

                    <div class="operation-input-wrap">
                        <i class="fas fa-search"></i>

                        <input type="text"
                               name="search"
                               id="registrationSearchInput"
                               value="@Model.Search"
                               placeholder="@Localizer["SearchPlaceholder"].Value" />
                    </div>
                </div>

                <div class="col-xl-3 col-lg-3">
                    <label class="operation-label">
                        @Localizer["PaymentStatus"]
                    </label>

                    <select name="paymentStatus"
                            id="paymentStatusFilter"
                            class="operation-select">
                        @if (string.IsNullOrWhiteSpace(Model.PaymentStatus))
                        {
                            <option value="" selected>@Localizer["AllStatuses"]</option>
                        }
                        else
                        {
                            <option value="">@Localizer["AllStatuses"]</option>
                        }

                        @if (Model.PaymentStatus == "paid")
                        {
                            <option value="paid" selected>@Localizer["Paid"]</option>
                        }
                        else
                        {
                            <option value="paid">@Localizer["Paid"]</option>
                        }

                        @if (Model.PaymentStatus == "pending")
                        {
                            <option value="pending" selected>@Localizer["Pending"]</option>
                        }
                        else
                        {
                            <option value="pending">@Localizer["Pending"]</option>
                        }
                    </select>
                </div>

                <div class="col-xl-3 col-lg-3">
                    <label class="operation-label">
                        @Localizer["RegistrationType"]
                    </label>

                    <select name="registrationTypeId"
                            id="registrationTypeFilter"
                            class="operation-select">
                        @if (!Model.RegistrationTypeId.HasValue)
                        {
                            <option value="" selected>@Localizer["AllRegistrationTypes"]</option>
                        }
                        else
                        {
                            <option value="">@Localizer["AllRegistrationTypes"]</option>
                        }

                        @foreach (var type in Model.RegistrationTypes)
                        {
                            if (Model.RegistrationTypeId.HasValue && Model.RegistrationTypeId.Value == type.Id)
                            {
                                <option value="@type.Id" selected>
                                    @type.Name - @Money(type.Price, type.Currency)
                                </option>
                            }
                            else
                            {
                                <option value="@type.Id">
                                    @type.Name - @Money(type.Price, type.Currency)
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-1 col-lg-1">
                    <button type="submit"
                            id="filterRegistrationButton"
                            class="btn operation-primary-btn w-100"
                            title="Filtrele">
                        <i class="fas fa-search"></i>
                    </button>
                </div>

                <div class="col-xl-1 col-lg-1">
                    <a href="@listUrl"
                       id="resetRegistrationButton"
                       class="btn operation-reset-btn w-100"
                       title="Temizle">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                </div>

            </div>
        </form>
    </div>

    <div class="operation-main-card">
        <div class="operation-main-card-header">
            <div>
                <h5>
                    @Localizer["RegistrationList"]
                </h5>

                <p>
                    @Localizer["RegistrationListSubtitle"]
                </p>
            </div>

            <div class="operation-header-actions">
                <span class="operation-count-pill">
                    @totalFilteredCount kayıt
                </span>

                <a href="@exportUrl" class="btn operation-light-btn">
                    <i class="fas fa-file-csv"></i>
                    CSV Aktar
                </a>
            </div>
        </div>

        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="operation-empty-state" id="registrationEmptyState">
                <div class="empty-state-icon">
                    <i class="fas fa-receipt"></i>
                </div>

                <h4>
                    
                </h4>

                <p>
                    Bu kongreye ait kayıt oluştuğunda veya filtreye uygun sonuç bulunduğunda kayıt ve ödeme detayları burada görüntülenecek.
                </p>

                <div class="empty-state-actions">
                    <a href="@backUrl"
                       class="btn operation-light-btn">
                        <i class="fas fa-arrow-left"></i>
                        @Localizer["BackToFlow"]
                    </a>

                    <a href="@listUrl"
                       class="btn operation-primary-btn">
                        <i class="fas fa-rotate-left"></i>
                        Filtreleri Temizle
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="registration-table-wrap">
                <table class="registration-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th>Tutar</th>
                            <th></th>
                            <th>@Localizer["Action"]</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="date-box">
                                        <strong>
                                            @item.RegistrationDate.ToString("dd.MM.yyyy")
                                        </strong>

                                        <span>
                                            @item.RegistrationDate.ToString("HH:mm")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="participant-cell">
                                        <div class="participant-avatar">
                                            @GetParticipantInitial(item.FullName)
                                        </div>

                                        <div class="participant-info">
                                            <strong>
                                                @(string.IsNullOrWhiteSpace(item.FullName) ? Localizer.GetString("User").Value : item.FullName)
                                            </strong>

                                            <span>
                                                @(string.IsNullOrWhiteSpace(item.Email) ? "E-posta yok" : item.Email)
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="registration-type-pill">
                                        <i class="fas fa-tag"></i>
                                        @item.RegistrationTypeName
                                    </div>
                                </td>

                                <td>
                                    <div class="amount-cell">
                                        <strong>
                                            @Money(item.Amount, item.Currency)
                                        </strong>

                                        <span>
                                            @item.Currency
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="payment-status @PaymentStatusClass(item.IsPaid)">
                                        <i class="fas @(item.IsPaid ? "fa-circle-check" : "fa-clock")"></i>
                                        @PaymentStatusText(item.IsPaid)
                                    </span>
                                </td>

                                <td>
                                    <div class="payment-action-cell">
                                        @if (!item.IsPaid)
                                        {
                                            <form method="post"
                                                  action="@approvePaymentUrl"
                                                  onsubmit="return confirm('Bu kaydın ödemesini onaylamak istediğinize emin misiniz?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="registrationId" value="@item.RegistrationId" />
                                                <input type="hidden" name="conferenceId" value="@conferenceId" />
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />

                                                <button type="submit" class="approve-payment-btn">
                                                    <i class="fas fa-circle-check"></i>
                                                    Ödemeyi Onayla
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="payment-approved-pill">
                                                    <i class="fas fa-check"></i>
                                                    Onaylandı
                                                </span>
                                                <form method="post"
                                                      action="@revokePaymentUrl"
                                                      onsubmit="return confirm('Bu kaydın ödeme onayını geri almak istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="registrationId" value="@item.RegistrationId" />
                                                    <input type="hidden" name="conferenceId" value="@conferenceId" />
                                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                    <button type="submit" class="revoke-payment-btn" title="Ödeme onayını geri al">
                                                        <i class="fas fa-rotate-left"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </td>

                                <td>
                                    @if (item.PaymentDate.HasValue)
                                    {
                                        <div class="date-box">
                                            <strong>
                                                @item.PaymentDate.Value.ToString("dd.MM.yyyy")
                                            </strong>

                                            <span>
                                                @item.PaymentDate.Value.ToString("HH:mm")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="muted-pill">
                                            Ödeme yok
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="billing-cell">
                                        <strong>
                                            @(string.IsNullOrWhiteSpace(item.BillingName) ? "Fatura adı yok" : item.BillingName)
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(item.PaymentTransactionId))
                                        {
                                            <span>
                                                İşlem ID: @item.PaymentTransactionId
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                İşlem ID yok
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.TaxNumber))
                                        {
                                            <small>
                                                Vergi / T.C.: @item.TaxNumber
                                            </small>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                var baseUrl = Url.Action("RegistrationsAndPayments", "ConferenceFlow", new { area = "Admin", slug = Model.Slug, search = Model.Search, paymentStatus = Model.PaymentStatus, registrationTypeId = Model.RegistrationTypeId });
                <nav class="operation-pagination">
                    @if (Model.HasPrev)
                    {
                        <a href="@(baseUrl)&page=@(Model.Page - 1)" class="page-btn page-btn-nav">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    else
                    {
                        <span class="page-btn page-btn-nav page-btn-disabled"><i class="fas fa-chevron-left"></i></span>
                    }

                    @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                    {
                        if (p == Model.Page)
                        {
                            <span class="page-btn page-btn-active">@p</span>
                        }
                        else
                        {
                            <a href="@(baseUrl)&page=@p" class="page-btn">@p</a>
                        }
                    }

                    @if (Model.HasNext)
                    {
                        <a href="@(baseUrl)&page=@(Model.Page + 1)" class="page-btn page-btn-nav">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="page-btn page-btn-nav page-btn-disabled"><i class="fas fa-chevron-right"></i></span>
                    }

                    <span class="page-info">@Model.Page / @Model.TotalPages sayfa &mdash; @Model.FilteredCount kayıt</span>
                </nav>
            }
        }
    </div>

</div>

<style>
    .registration-payment-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .operation-alert {
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-radius: 18px;
        border: 1px solid transparent;
        font-weight: 800;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .operation-alert i {
        font-size: 1rem;
    }

    .operation-alert-success {
        background: rgba(34, 197, 94, 0.10);
        border-color: rgba(34, 197, 94, 0.20);
        color: #15803d;
    }

    .operation-alert-info {
        background: rgba(13, 110, 253, 0.10);
        border-color: rgba(13, 110, 253, 0.20);
        color: #0d6efd;
    }

    .operation-alert-error {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .operation-header-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .operation-header-left {
        flex: 1;
        min-width: 300px;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .operation-header-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .operation-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .operation-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.45rem;
    }

    .operation-title {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
        margin: 0 0 0.4rem;
        line-height: 1.2;
    }

    .operation-description {
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        margin: 0;
        max-width: 860px;
        line-height: 1.65;
    }

    .operation-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.8rem;
    }

    .operation-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border-radius: 999px;
        padding: 0.48rem 0.78rem;
        font-size: 0.78rem;
        font-weight: 900;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .operation-chip-primary {
        background: rgba(0, 174, 239, 0.10);
        border-color: rgba(0, 174, 239, 0.22);
        color: #0d6efd;
    }

    .operation-light-btn,
    .operation-outline-btn,
    .operation-primary-btn,
    .operation-reset-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1.15rem;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .operation-light-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

    .operation-light-btn:hover {
        color: #0d6efd;
        background: #f8fbff;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
    }

    .operation-outline-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
    }

    .operation-outline-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .operation-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
    }

    .operation-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
    }

    .operation-primary-btn:disabled,
    .operation-light-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
    }

    .operation-reset-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

    .operation-reset-btn:hover {
        color: #0d6efd;
        background: #f8fbff;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
    }

    .operation-stat-card {
        min-height: 104px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1.15rem;

@using AntAbstract.Web.Models.ViewModels.Admin.Assignment

@model ConferenceFlowIndexViewModel

@{
    ViewData["Title"] = "Kongre Akışı";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var slug = Model.Slug ?? "";
    var isSuperAdmin = User.IsInRole("SuperAdmin");

    var changeConferenceUrl = "/Admin/ConferenceFlow?forceSelect=true";

    var submissionUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Submissions"
        : $"/{slug}/Admin/Submissions?conferenceId={Model.ConferenceId}";

    var assignmentUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Assignment"
        : $"/{slug}/Admin/Assignment?conferenceId={Model.ConferenceId}";

    var decisionUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Decision"
        : $"/{slug}/Admin/Decision?conferenceId={Model.ConferenceId}";

    var reviewersUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Referee"
        : $"/{slug}/Admin/Referee?conferenceId={Model.ConferenceId}";

    var registrationsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/RegistrationsAndPayments?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/ConferenceFlow/RegistrationsAndPayments?conferenceId={Model.ConferenceId}";

    var sessionsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/ProgramSessions?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/ConferenceFlow/ProgramSessions?conferenceId={Model.ConferenceId}";

    var proceedingBookUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ProceedingBook?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/ProceedingBook?conferenceId={Model.ConferenceId}";

    var conferenceFlowReturnUrl = $"/Admin/ConferenceFlow?conferenceId={Model.ConferenceId}";

    var currentFlowUrl = $"/Admin/ConferenceFlow?conferenceId={Model.ConferenceId}";

    var encodedReturnUrl = System.Net.WebUtility.UrlEncode(currentFlowUrl);

    var tenantAdminAssignUrl = $"/Admin/Tenants/AssignManager/{Model.TenantId}?returnUrl={encodedReturnUrl}";}

<div class="container-fluid conference-flow-page">

    <div class="flow-hero-card mb-4">
        <div class="flow-hero-left">
            <div class="flow-hero-icon">
                <i class="fas fa-stream"></i>
            </div>

            <div>
                <div class="flow-section-label">
                    Kongre Operasyonları
                </div>

                <h2 class="flow-page-title">
                    Kongre Akışı
                </h2>

                <p class="flow-page-description">
                    <strong>@Model.ConferenceTitle</strong> kongresinin bildiri, hakem atama, karar, program ve bildiri kitabı süreçlerini buradan takip edebilirsiniz.
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Slug))
                {
                    <div class="flow-slug-badge">
                        /@Model.Slug
                    </div>
                }
            </div>
        </div>

        <div class="flow-hero-actions">
            <a href="@changeConferenceUrl"
               class="btn flow-outline-btn">
                <i class="fas fa-exchange-alt me-2"></i>
                Kongre Değiştir
            </a>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <a href="/@slug"
                   target="_blank"
                   class="btn flow-primary-btn">
                    <i class="fas fa-external-link-alt me-2"></i>
                    Siteyi Gör
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-file-alt"></i>
                </div>

                <div>
                    <div class="info-number">@Model.SubmissionCount</div>
                    <div class="info-label">Toplam Bildiri</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-success bg-opacity-10 text-success">
                    <i class="fas fa-user-check"></i>
                </div>

                <div>
                    <div class="info-number">@Model.AssignedSubmissionCount</div>
                    <div class="info-label">Hakeme Atanan</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-user-clock"></i>
                </div>

                <div>
                    <div class="info-number">@Model.WaitingAssignmentCount</div>
                    <div class="info-label">Atama Bekleyen</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="info-card">
                <div class="info-icon bg-danger bg-opacity-10 text-danger">
                    <i class="fas fa-gavel"></i>
                </div>

                <div>
                    <div class="info-number">@Model.DecidedSubmissionCount</div>
                    <div class="info-label">Karar Verilen</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="@(isSuperAdmin ? "col-lg-7" : "col-12")">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 px-4 py-3">
                    <h5 class="fw-bold mb-1">
                        Süreç Özeti
                    </h5>

                    <p class="text-muted small mb-0">
                        Bildirilerin hakem atama ve karar aşamalarındaki ilerleme durumunu gösterir.
                    </p>
                </div>

                <div class="card-body px-4 pb-4">

                    <div class="progress-block mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <div class="fw-bold text-dark">
                                    Hakem Atama İlerlemesi
                                </div>

                                <div class="text-muted small">
                                    @Model.AssignedSubmissionCount / @Model.SubmissionCount bildiri hakeme atanmış.
                                </div>
                            </div>

                            <span class="progress-percent">
                                %@Model.AssignmentProgressPercent
                            </span>
                        </div>

                        <div class="progress progress-modern">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @(Model.AssignmentProgressPercent)%;">
                            </div>
                        </div>
                    </div>

                    <div class="progress-block">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <div class="fw-bold text-dark">
                                    Karar İlerlemesi
                                </div>

                                <div class="text-muted small">
                                    @Model.DecidedSubmissionCount / @Model.SubmissionCount bildiri için karar verilmiş.
                                </div>
                            </div>

                            <span class="progress-percent">
                                %@Model.DecisionProgressPercent
                            </span>
                        </div>

                        <div class="progress progress-modern">
                            <div class="progress-bar bg-danger"
                                 role="progressbar"
                                 style="width: @(Model.DecisionProgressPercent)%;">
                            </div>
                        </div>
                    </div>

                    <div class="flow-note mt-4">
                        <i class="fas fa-circle-info me-2"></i>
                        Akışın tamamlanması için bildirilerin hakeme atanması, karar ekranından sonuçlandırılması ve kabul edilen bildirilerin program/bildiri kitabı süreçlerine alınması gerekir.
                    </div>

                </div>
            </div>
        </div>

        @if (isSuperAdmin)
        {
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 px-4 py-3">
                        <h5 class="fw-bold mb-1">
                            Hızlı İşlemler
                        </h5>

                        <p class="text-muted small mb-0">
                            Seçili kongreyle ilgili operasyon ekranlarına hızlı geçiş yapabilirsiniz.
                        </p>
                    </div>

                    <div class="card-body p-4">
                        <div class="quick-actions-grid">

                            <a href="@submissionUrl" class="quick-action-card">
                                <div class="quick-action-icon bg-primary bg-opacity-10 text-primary">
                                    <i class="fas fa-file-alt"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Bildiri Yönetimi
                                    </div>

                                    <div class="text-muted small">
                                        Gönderilen bildirileri incele.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                            <a href="@assignmentUrl" class="quick-action-card">
                                <div class="quick-action-icon bg-success bg-opacity-10 text-success">
                                    <i class="fas fa-tasks"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Hakem Atama
                                    </div>

                                    <div class="text-muted small">
                                        Bildirilere hakem ata.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                            <a href="@decisionUrl" class="quick-action-card">
                                <div class="quick-action-icon bg-danger bg-opacity-10 text-danger">
                                    <i class="fas fa-gavel"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Karar Ekranı
                                    </div>

                                    <div class="text-muted small">
                                        Kabul, ret veya revizyon kararı ver.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                            <a href="@reviewersUrl" class="quick-action-card">
                                <div class="quick-action-icon bg-warning bg-opacity-10 text-warning">
                                    <i class="fas fa-user-check"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Hakemler
                                    </div>

                                    <div class="text-muted small">
                                        Hakem listesini yönet.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                            <a href="@registrationsUrl" class="quick-action-card">
                                <div class="quick-action-icon bg-info bg-opacity-10 text-info">
                                    <i class="fas fa-credit-card"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Kayıtlar ve Ödemeler
                                    </div>

                                    <div class="text-muted small">
                                        Katılımcı kayıtlarını kontrol et.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                            <a href="@tenantAdminAssignUrl" class="quick-action-card">
                                <div class="quick-action-icon bg-dark bg-opacity-10 text-dark">
                                    <i class="fas fa-user-shield"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Kurum Yöneticisi Ata
                                    </div>

                                    <div class="text-muted small">
                                        Bu kongrenin bağlı olduğu kuruma admin ata.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                            <a href="@sessionsUrl" class="quick-action-card">
                                <div class="quick-action-icon bg-secondary bg-opacity-10 text-secondary">
                                    <i class="fas fa-microphone-alt"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Program / Oturumlar
                                    </div>

                                    <div class="text-muted small">
                                        Kongre programını düzenle.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                            <a href="@proceedingBookUrl" class="quick-action-card quick-action-highlight">
                                <div class="quick-action-icon proceeding-book-icon">
                                    <i class="fas fa-book-open"></i>
                                </div>

                                <div>
                                    <div class="fw-bold text-dark">
                                        Bildiri Kitabı
                                    </div>

                                    <div class="text-muted small">
                                        Kabul edilen bildirilerden PDF oluştur veya mevcut kitabı yönet.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

</div>

<style>
    .conference-flow-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .flow-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.055);
    }

    .flow-hero-left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-width: 300px;
        flex: 1;
    }

    .flow-hero-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        border-radius: 19px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.20);
    }

    .flow-section-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.3rem;
    }

    .flow-page-title {
        margin: 0 0 0.25rem;
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1.2;
    }

    .flow-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.55;
    }

    .flow-slug-badge {
        width: fit-content;
        margin-top: 0.45rem;
        padding: 0.32rem 0.7rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.09);
        color: #0d6efd;
        font-size: 0.74rem;
        font-weight: 900;
    }

    .flow-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .flow-primary-btn,
    .flow-outline-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1rem;
        text-decoration: none;
        font-size: 0.88rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .flow-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 10px 24px rgba(13, 110, 253, 0.20);
    }

        .flow-primary-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
        }

    .flow-outline-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.045);
    }

        .flow-outline-btn:hover {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.32);
            background: #ffffff;
            box-shadow: 0 12px 26px rgba(13, 110, 253, 0.10);
            transform: translateY(-1px);
        }

    .info-card {
        background-color: #fff;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        border: 1px solid #f1f5f9;
        min-height: 95px;
    }

    .info-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .info-number {
        font-size: 1.55rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }

    .info-label {
        color: #64748b;
        font-weight: 700;
        font-size: 0.76rem;
        margin-top: 0.25rem;
    }

    .progress-modern {
        height: 10px;
        border-radius: 999px;
        background-color: #eef2f7;
        overflow: hidden;
    }

        .progress-modern .progress-bar {
            border-radius: 999px;
        }

    .progress-percent {
        background-color: #f1f5f9;
        color: #0f172a;
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .flow-note {
        background-color: #f8fafc;
        color: #64748b;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 0.9rem 1rem;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .quick-action-card {
        display: grid;
        grid-template-columns: 42px 1fr 32px;
        align-items: center;
        gap: 0.85rem;
        padding: 0.95rem;
        border-radius: 16px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .quick-action-card:hover {
            background-color: #ffffff;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
            transform: translateY(-1px);
        }

    .quick-action-highlight {
        background: linear-gradient(135deg, rgba(0, 174, 239, 0.10), #f8fafc);
        border-color: rgba(0, 174, 239, 0.24);
    }

        .quick-action-highlight:hover {
            background: #ffffff;
            border-color: rgba(13, 110, 253, 0.32);
        }

    .quick-action-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .proceeding-book-icon {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .quick-action-arrow {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background-color: #ffffff;
        color: #94a3b8;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        transition: all 0.2s ease;
    }

    .quick-action-card:hover .quick-action-arrow {
        background-color: #0d6efd;
        color: #ffffff;
        transform: translateX(2px);
    }

    @@media (max-width: 992px) {
        .flow-hero-card {
            padding: 1rem;
        }

        .flow-hero-left {
            min-width: 100%;
        }

        .flow-hero-actions {
            width: 100%;
        }

            .flow-hero-actions .btn {
                width: 100%;
            }
    }
</style>
@using System
@using AntAbstract.Web.Models.ViewModels.Admin.ConferenceFlow

@model ConferenceFlowIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var slug = Model.Slug ?? "";
    var isSuperAdmin = User.IsInRole("SuperAdmin");

    var changeConferenceUrl = "/Admin/ConferenceFlow?forceSelect=true";

    var conferenceQuery = $"?conferenceId={Model.ConferenceId}";

    var submissionUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Submissions{conferenceQuery}"
        : $"/{slug}/Admin/Submissions{conferenceQuery}";

    var assignmentUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Assignment{conferenceQuery}"
        : $"/{slug}/Admin/Assignment{conferenceQuery}";

    var decisionUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Decision{conferenceQuery}"
        : $"/{slug}/Admin/Decision{conferenceQuery}";

    var reviewersUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Referee{conferenceQuery}"
        : $"/{slug}/Admin/Referee{conferenceQuery}";

    var registrationsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/RegistrationsAndPayments{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow/RegistrationsAndPayments{conferenceQuery}";

    var sessionsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/ProgramSessions{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow/ProgramSessions{conferenceQuery}";

    var sessionsPrintUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/ProgramSessions/Print{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow/ProgramSessions/Print{conferenceQuery}";

    var proceedingBookUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ProceedingBook{conferenceQuery}"
        : $"/{slug}/Admin/ProceedingBook{conferenceQuery}";

    var incompleteUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Submissions/Incomplete{conferenceQuery}"
        : $"/{slug}/Admin/Submissions/Incomplete{conferenceQuery}";

    var publicSiteUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : Model.ConferenceId != Guid.Empty
            ? $"/{slug}?conferenceId={Model.ConferenceId}"
            : $"/{slug}";

    var currentFlowUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow{conferenceQuery}";

    var encodedReturnUrl = System.Net.WebUtility.UrlEncode(currentFlowUrl);

    var tenantAdminAssignUrl = $"/Admin/Tenants/AssignManager/{Model.TenantId}?returnUrl={encodedReturnUrl}";

    var waitingAssignmentCount = Math.Max(0, Model.SubmissionCount - Model.AssignedSubmissionCount);

    int GetPercent(int value, int total)
    {
        if (total <= 0)
        {
            return 0;
        }

        var percent = (int)Math.Round((value * 100.0) / total);

        if (percent < 0)
        {
            return 0;
        }

        if (percent > 100)
        {
            return 100;
        }

        return percent;
    }

    var assignmentProgressPercent = GetPercent(Model.AssignedSubmissionCount, Model.SubmissionCount);
    var decisionProgressPercent = GetPercent(Model.DecidedSubmissionCount, Model.SubmissionCount);
}

<style>
    .conference-flow-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .admin-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .admin-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .admin-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .admin-hero-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .admin-hero-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .admin-hero-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 860px;
    }

    .admin-hero-lead strong {
        color: #334155;
        font-weight: 950;
    }

    .admin-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .admin-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .admin-hero-btn-light {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .admin-hero-btn-light:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .admin-hero-btn-primary {
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        border: none;
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.18);
    }

    .admin-hero-btn-primary:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.26);
        text-decoration: none;
    }

    .flow-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.8rem;
    }

    .flow-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border-radius: 999px;
        padding: 0.48rem 0.78rem;
        font-size: 0.78rem;
        font-weight: 900;
        background: #ffffff;
        color: #475569;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.035);
    }

    .flow-chip-primary {
        background: rgba(0, 174, 239, 0.10);
        border-color: rgba(0, 174, 239, 0.22);
        color: #0d6efd;
    }

    .flow-chip-success {
        background: rgba(16, 185, 129, 0.10);
        border-color: rgba(16, 185, 129, 0.24);
        color: #059669;
    }

    .flow-chip-muted {
        background: #f1f5f9;
        border-color: #e2e8f0;
        color: #94a3b8;
    }

    .flow-chip-warning {
        background: rgba(245, 158, 11, 0.10);
        border-color: rgba(245, 158, 11, 0.28);
        color: #b45309;
    }

    .flow-chip-btn {
        border: none;
        cursor: pointer;
        font-family: inherit;
        font-size: inherit;
    }

    .flow-chip-btn:hover {
        filter: brightness(0.93);
    }

    .flow-chip-danger {
        background: rgba(239, 68, 68, 0.10);
        border-color: rgba(239, 68, 68, 0.24);
        color: #dc2626;
    }

    .admin-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .admin-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 96px;
        transition: all 0.2s ease;
    }

    .admin-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.075);
    }

    .admin-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .stat-red {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
    }

    .stat-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .stat-slate {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
    }

    .stat-dark {
        background: rgba(15, 23, 42, 0.10);
        color: #0f172a;
    }

    .admin-stat-value {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .admin-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.25rem;
    }

    .admin-flow-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
        gap: 1.25rem;
        align-items: start;
    }

    .admin-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
        height: 100%;
    }

    .admin-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .admin-card-title {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 900;
        margin: 0 0 0.25rem;
    }

    .admin-card-subtitle {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.55;
        margin-bottom: 0;
    }

    .admin-card-header-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .admin-card-body {
        padding: 1.35rem;
    }

    .progress-block {
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: #ffffff;
        padding: 1.1rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.035);
    }

    .progress-title {
        color: #0f172a;
        font-size: 0.94rem;
        font-weight: 950;
        margin-bottom: 0.16rem;
    }

    .progress-subtitle {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        line-height: 1.55;
    }

    .progress-percent {
        background-color: #f1f5f9;
        color: #0f172a;
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
        border: 1px solid #e2e8f0;
    }

    .progress-modern {
        height: 11px;
        border-radius: 999px;
        background-color: #eef2f7;
        overflow: hidden;
    }

    .progress-modern .progress-bar {
        border-radius: 999px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
    }

    .progress-modern .progress-bar-danger {
        background: linear-gradient(135deg, #ef4444, #f97316);
    }

    .flow-note {
        background-color: #f8fafc;
        color: #64748b;
        border: 1px dashed #cbd5e1;
        border-radius: 20px;
        padding: 1rem;
        font-size: 0.86rem;
        font-weight: 700;
        line-height: 1.6;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .quick-action-card {
        display: grid;
        grid-template-columns: 46px 1fr 34px;
        align-items: center;
        gap: 0.85rem;
        padding: 0.95rem;
        border-radius: 20px;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.035);
    }

    .quick-action-card:hover {
        background-color: #ffffff;
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.075);
        transform: translateY(-2px);
        border-color: rgba(13, 110, 253, 0.22);
        text-decoration: none;
    }

    .quick-action-card:hover .quick-action-title,
    .quick-action-card:hover .quick-action-desc {
        text-decoration: none;
    }

    .quick-action-highlight {
        background: linear-gradient(135deg, rgba(0, 174, 239, 0.10), #ffffff);
        border-color: rgba(0, 174, 239, 0.24);
    }

    .quick-action-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .quick-action-title {
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 950;
        margin-bottom: 0.15rem;
    }

    .quick-action-desc {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 650;
        line-height: 1.45;
    }

    .quick-action-arrow {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        background-color: #f8fafc;
        color: #94a3b8;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        transition: all 0.2s ease;
        border: 1px solid #e2e8f0;
    }

    .quick-action-card:hover .quick-action-arrow {
        background-color: #0d6efd;
        color: #ffffff;
        transform: translateX(2px);
        border-color: #0d6efd;
    }

    .proceeding-book-icon {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .admin-alert {
        border: none;
        border-radius: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.055);
        font-weight: 850;
    }

    @@media (max-width: 1200px) {
        .admin-flow-grid {
            grid-template-columns: 1fr;
        }

        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-left {
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .conference-flow-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-stat-grid {
            grid-template-columns: 1fr;
        }

        .admin-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .quick-action-card {
            grid-template-columns: 46px 1fr;
        }

        .quick-action-arrow {
            grid-column: 1 / -1;
            width: 100%;
        }

        .admin-hero-btn {
            width: 100%;
        }
    }
</style>

<div class="conference-flow-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-stream"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    @Localizer["HeroKicker"]
                </div>

                <h3 class="admin-hero-title">
                    Kongre Akışı
                </h3>

                <p class="admin-hero-lead">
                    <strong>@Model.ConferenceTitle</strong> kongresinin bildiri, hakem atama, karar, kayıt, program ve bildiri kitabı süreçlerini buradan takip edebilirsiniz.
                </p>

                <div class="flow-chip-row">
                    @if (!string.IsNullOrWhiteSpace(Model.Slug))
                    {
                        <span class="flow-chip flow-chip-primary">
                            <i class="fas fa-link"></i>
                            /@Model.Slug
                        </span>
                    }

                    <span class="flow-chip">
                        <i class="fas fa-calendar-alt"></i>
                        @Model.ConferenceStartDate.ToString("dd MMM yyyy") – @Model.ConferenceEndDate.ToString("dd MMM yyyy")
                    </span>

                    @if (Model.AbstractSubmissionDeadline.HasValue)
                    {
                        <span class="flow-chip @(Model.AbstractSubmissionDeadline.Value < DateTime.Now ? "flow-chip-danger" : "flow-chip-warning")">
                            <i class="fas fa-hourglass-half"></i>
                            @Localizer["Deadline"] @Model.AbstractSubmissionDeadline.Value.ToString("dd MMM yyyy")
                        </span>
                    }

                    <span class="flow-chip @(Model.IsSubmissionOpen ? "flow-chip-success" : "flow-chip-muted")">
                        <i class="fas @(Model.IsSubmissionOpen ? "fa-check-circle" : "fa-lock")"></i>
                        @Localizer["SubmissionStatus"] @(Model.IsSubmissionOpen ? Localizer.GetString("Open").Value : Localizer.GetString("Closed").Value)
                    </span>

                    <span class="flow-chip @(Model.IsRegistrationOpen ? "flow-chip-success" : "flow-chip-muted")">
                        <i class="fas @(Model.IsRegistrationOpen ? "fa-check-circle" : "fa-lock")"></i>
                        @Localizer["RegistrationStatus"] @(Model.IsRegistrationOpen ? Localizer.GetString("Open").Value : Localizer.GetString("Closed").Value)
                    </span>

                    <form method="post" action="/@Model.Slug/Admin/ConferenceFlow/ToggleBidding" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />
                        <button type="submit" class="flow-chip flow-chip-btn @(Model.IsBiddingOpen ? "flow-chip-success" : "flow-chip-muted")">
                            <i class="fas @(Model.IsBiddingOpen ? "fa-hand-pointer" : "fa-hand")"></i>
                            @Localizer["BiddingPhase"] @(Model.IsBiddingOpen ? Localizer.GetString("Open").Value : Localizer.GetString("Closed").Value)
                        </button>
                    </form>

                    <form method="post" action="/@Model.Slug/Admin/ConferenceFlow/ToggleFullText" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />
                        <button type="submit" class="flow-chip flow-chip-btn @(Model.IsFullTextOpen ? "flow-chip-success" : "flow-chip-muted")">
                            <i class="fas @(Model.IsFullTextOpen ? "fa-file-word" : "fa-file")"></i>
                            @Localizer["FullText"] @(Model.IsFullTextOpen ? Localizer.GetString("Open").Value : Localizer.GetString("Closed").Value)
                        </button>
                    </form>

                    <span class="flow-chip">
                        <i class="fas @(isSuperAdmin ? "fa-user-gear" : "fa-user-shield")"></i>
                        @(isSuperAdmin ? "SuperAdmin" : "Kurum Admini")
                    </span>
                </div>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="@changeConferenceUrl"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-exchange-alt"></i>
                @Localizer["ChangeConference"]
            </a>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <a href="@publicSiteUrl"
                   target="_blank"
                   class="admin-hero-btn admin-hero-btn-primary">
                    <i class="fas fa-external-link-alt"></i>
                    @Localizer["ViewSite"]
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show admin-alert mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show admin-alert mb-4">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat"></button>
        </div>
    }

    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-file-alt"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @Model.SubmissionCount
                </div>

                <div class="admin-stat-label">
                    Toplam Bildiri
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-user-check"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @Model.AssignedSubmissionCount
                </div>

                <div class="admin-stat-label">
                    Hakeme Atanan
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-orange">
                <i class="fas fa-user-clock"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @waitingAssignmentCount
                </div>

                <div class="admin-stat-label">
                    Atama Bekleyen
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-red">
                <i class="fas fa-gavel"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @Model.DecidedSubmissionCount
                </div>

                <div class="admin-stat-label">
                    Karar Verilen
                </div>
            </div>
        </div>
    </div>

    <div class="admin-stat-grid" style="margin-top: -0.4rem;">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-check-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @Model.AcceptedCount
                </div>

                <div class="admin-stat-label">
                    Kabul Edilen
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-red">
                <i class="fas fa-times-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @Model.RejectedCount
                </div>

                <div class="admin-stat-label">
                    Reddedilen
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-id-badge"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @Model.RegistrationCount
                    @if (Model.PaidRegistrationCount > 0)
                    {
                        <span style="font-size:0.72rem;font-weight:700;color:#10b981;margin-left:4px;">(@Model.PaidRegistrationCount ödedi)</span>
                    }
                </div>

                <div class="admin-stat-label">
                    @Localizer["TotalRegistrations"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-purple">
                <i class="fas fa-user-graduate"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @Model.ReviewerCount
                </div>

                <div class="admin-stat-label">
                    Aktif Hakem
                </div>
            </div>
        </div>
    </div>

    <div class="admin-flow-grid">

        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <h5 class="admin-card-title">
                        @Localizer["ProcessSummary"]
                    </h5>

                    <p class="admin-card-subtitle">
                        Bildirilerin hakem atama ve karar aşamalarındaki ilerleme durumunu gösterir.
                    </p>
                </div>

                <div class="admin-card-header-icon stat-blue">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>

            <div class="admin-card-body">

                <div class="progress-block mb-4">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                        <div>
                            <div class="progress-title">
                                @Localizer["AssignmentProgress"]
                            </div>

                            <div class="progress-subtitle">
                                @Model.AssignedSubmissionCount / @Model.SubmissionCount bildiri hakeme atanmış.
                            </div>
                        </div>

                        <span class="progress-percent">
                            %@assignmentProgressPercent
                        </span>
                    </div>

                    <div class="progress progress-modern">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width: @(assignmentProgressPercent)%;">
                        </div>
                    </div>
                </div>

                <div class="progress-block">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                        <div>
                            <div class="progress-title">
                                @Localizer["DecisionProgress"]
                            </div>

                            <div class="progress-subtitle">
                                @Model.DecidedSubmissionCount / @Model.SubmissionCount bildiri için karar verilmiş.
                            </div>
                        </div>

                        <span class="progress-percent">
                            %@decisionProgressPercent
                        </span>
                    </div>

                    <div class="progress progress-modern">
                        <div class="progress-bar progress-bar-danger"
                             role="progressbar"
                             style="width: @(decisionProgressPercent)%;">
                        </div>
                    </div>
                </div>

                <div class="flow-note mt-4">
                    <i class="fas fa-circle-info me-2"></i>
                    Akışın tamamlanması için bildirilerin hakeme atanması, karar ekranından sonuçlandırılması ve kabul edilen bildirilerin program/bildiri kitabı süreçlerine alınması gerekir.
                </div>

            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <div>
                    <h5 class="admin-card-title">
                        @Localizer["QuickActions"]
                    </h5>

                    <p class="admin-card-subtitle">
                        Seçili kongreyle ilgili operasyon ekranlarına hızlı geçiş yapabilirsiniz.
                    </p>
                </div>

                <div class="admin-card-header-icon stat-green">
                    <i class="fas fa-bolt"></i>
                </div>
            </div>

            <div class="admin-card-body">
                <div class="quick-actions-grid">

                    <a href="@submissionUrl" class="quick-action-card">
                        <div class="quick-action-icon stat-blue">
                            <i class="fas fa-file-alt"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Bildiri Yönetimi
                            </div>

                            <div class="quick-action-desc">
                                Gönderilen bildirileri incele.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@assignmentUrl" class="quick-action-card">
                        <div class="quick-action-icon stat-green">
                            <i class="fas fa-tasks"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Hakem Atama
                            </div>

                            <div class="quick-action-desc">
                                Bildirilere hakem ata.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@decisionUrl" class="quick-action-card">
                        <div class="quick-action-icon stat-red">
                            <i class="fas fa-gavel"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Karar Ekranı
                            </div>

                            <div class="quick-action-desc">
                                Kabul, ret veya revizyon kararı ver.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@reviewersUrl" class="quick-action-card">
                        <div class="quick-action-icon stat-orange">
                            <i class="fas fa-user-check"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Hakemler
                            </div>

                            <div class="quick-action-desc">
                                Hakem havuzunu ve hakem listesini yönet.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@registrationsUrl" class="quick-action-card">
                        <div class="quick-action-icon stat-cyan">
                            <i class="fas fa-credit-card"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Kayıtlar ve Ödemeler
                            </div>

                            <div class="quick-action-desc">
                                Katılımcı kayıtlarını ve ödeme durumlarını kontrol et.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@sessionsUrl" class="quick-action-card">
                        <div class="quick-action-icon stat-purple">
                            <i class="fas fa-microphone-alt"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Program / Oturumlar
                            </div>

                            <div class="quick-action-desc">
                                Kongre programını ve oturumları düzenle.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@sessionsPrintUrl" class="quick-action-card">
                        <div class="quick-action-icon stat-slate">
                            <i class="fas fa-print"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Programı Yazdır
                            </div>

                            <div class="quick-action-desc">
                                Yayındaki oturum programının yazdırılabilir halini aç.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@proceedingBookUrl" class="quick-action-card quick-action-highlight">
                        <div class="quick-action-icon proceeding-book-icon">
                            <i class="fas fa-book-open"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Bildiri Kitabı
                            </div>

                            <div class="quick-action-desc">
                                Kabul edilen bildirilerden PDF oluştur veya mevcut kitabı yönet.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    <a href="@incompleteUrl" class="quick-action-card">
                        <div class="quick-action-icon" style="background:rgba(245,158,11,0.12);color:#d97706;">
                            <i class="fas fa-triangle-exclamation"></i>
                        </div>

                        <div>
                            <div class="quick-action-title">
                                Eksik Bildiriler
                            </div>

                            <div class="quick-action-desc">
                                Başlatılmış ancak tamamlanmamış bildirileri takip edin.
                            </div>
                        </div>

                        <div class="quick-action-arrow">
                            <i class="fas fa-arrow-right"></i>
                        </div>
                    </a>

                    @if (isSuperAdmin)
                    {
                        <a href="@tenantAdminAssignUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-dark">
                                <i class="fas fa-user-shield"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Kurum Yöneticisi Ata
                                </div>

                                <div class="quick-action-desc">
                                    Bu kongrenin bağlı olduğu kuruma admin ata.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>
                    }

                </div>
            </div>
        </div>

    </div>

</div>
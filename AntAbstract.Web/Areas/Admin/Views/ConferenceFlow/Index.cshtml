@using AntAbstract.Web.Models.ViewModels.Admin.ConferenceFlow

@model ConferenceFlowIndexViewModel

@{
    ViewData["Title"] = "Kongre Akışı";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var slug = Model.Slug ?? "";
    var isSuperAdmin = User.IsInRole("SuperAdmin");

    var changeConferenceUrl = "/Admin/ConferenceFlow?forceSelect=true";

    var conferenceQuery = $"?conferenceId={Model.ConferenceId}";

    var submissionUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Submissions{conferenceQuery}"
        : $"/{slug}/Admin/Submissions{conferenceQuery}";

    var assignmentUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Assignment{conferenceQuery}"
        : $"/{slug}/Admin/Assignment{conferenceQuery}";

    var decisionUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Decision{conferenceQuery}"
        : $"/{slug}/Admin/Decision{conferenceQuery}";

    var reviewersUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Referee{conferenceQuery}"
        : $"/{slug}/Admin/Referee{conferenceQuery}";

    var registrationsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/RegistrationsAndPayments{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow/RegistrationsAndPayments{conferenceQuery}";

    var sessionsUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/ProgramSessions{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow/ProgramSessions{conferenceQuery}";

    var sessionsPrintUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow/ProgramSessions/Print{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow/ProgramSessions/Print{conferenceQuery}";

    var proceedingBookUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ProceedingBook{conferenceQuery}"
        : $"/{slug}/Admin/ProceedingBook{conferenceQuery}";

    var publicSiteUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}";

    var currentFlowUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow{conferenceQuery}"
        : $"/{slug}/Admin/ConferenceFlow{conferenceQuery}";

    var encodedReturnUrl = System.Net.WebUtility.UrlEncode(currentFlowUrl);

    var tenantAdminAssignUrl = $"/Admin/Tenants/AssignManager/{Model.TenantId}?returnUrl={encodedReturnUrl}";

    var waitingAssignmentCount = Math.Max(0, Model.SubmissionCount - Model.AssignedSubmissionCount);

    int GetPercent(int value, int total)
    {
        if (total <= 0)
        {
            return 0;
        }

        var percent = (int)Math.Round((value * 100.0) / total);

        if (percent < 0)
        {
            return 0;
        }

        if (percent > 100)
        {
            return 100;
        }

        return percent;
    }

    var assignmentProgressPercent = GetPercent(Model.AssignedSubmissionCount, Model.SubmissionCount);
    var decisionProgressPercent = GetPercent(Model.DecidedSubmissionCount, Model.SubmissionCount);
}

<div class="container-fluid conference-flow-page">

    <div class="flow-hero-card mb-4">
        <div class="flow-hero-left">
            <div class="flow-hero-icon">
                <i class="fas fa-stream"></i>
            </div>

            <div>
                <div class="flow-section-label">
                    Kongre Operasyonları
                </div>

                <h2 class="flow-page-title">
                    Kongre Akışı
                </h2>

                <p class="flow-page-description">
                    <strong>@Model.ConferenceTitle</strong> kongresinin bildiri, hakem atama, karar, kayıt, program ve bildiri kitabı süreçlerini buradan takip edebilirsiniz.
                </p>

                <div class="flow-chip-row">
                    @if (!string.IsNullOrWhiteSpace(Model.Slug))
                    {
                        <span class="flow-chip flow-chip-primary">
                            <i class="fas fa-link"></i>
                            /@Model.Slug
                        </span>
                    }

                    <span class="flow-chip">
                        <i class="fas fa-calendar-check"></i>
                        Seçili Kongre
                    </span>

                    <span class="flow-chip">
                        <i class="fas @(isSuperAdmin ? "fa-user-gear" : "fa-user-shield")"></i>
                        @(isSuperAdmin ? "SuperAdmin" : "Kurum Admini")
                    </span>
                </div>
            </div>
        </div>

        <div class="flow-hero-actions">
            <a href="@changeConferenceUrl"
               class="btn flow-outline-btn">
                <i class="fas fa-exchange-alt"></i>
                Kongre Değiştir
            </a>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <a href="@publicSiteUrl"
                   target="_blank"
                   class="btn flow-primary-btn">
                    <i class="fas fa-external-link-alt"></i>
                    Siteyi Gör
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="flow-stat-card">
                <div class="flow-stat-icon stat-blue">
                    <i class="fas fa-file-alt"></i>
                </div>

                <div>
                    <div class="flow-stat-number">
                        @Model.SubmissionCount
                    </div>

                    <div class="flow-stat-label">
                        Toplam Bildiri
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="flow-stat-card">
                <div class="flow-stat-icon stat-green">
                    <i class="fas fa-user-check"></i>
                </div>

                <div>
                    <div class="flow-stat-number">
                        @Model.AssignedSubmissionCount
                    </div>

                    <div class="flow-stat-label">
                        Hakeme Atanan
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="flow-stat-card">
                <div class="flow-stat-icon stat-orange">
                    <i class="fas fa-user-clock"></i>
                </div>

                <div>
                    <div class="flow-stat-number">
                        @waitingAssignmentCount
                    </div>

                    <div class="flow-stat-label">
                        Atama Bekleyen
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="flow-stat-card">
                <div class="flow-stat-icon stat-red">
                    <i class="fas fa-gavel"></i>
                </div>

                <div>
                    <div class="flow-stat-number">
                        @Model.DecidedSubmissionCount
                    </div>

                    <div class="flow-stat-label">
                        Karar Verilen
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-xl-7">
            <div class="flow-card h-100">
                <div class="flow-card-header">
                    <div>
                        <h5 class="flow-card-title">
                            Süreç Özeti
                        </h5>

                        <p class="flow-card-text">
                            Bildirilerin hakem atama ve karar aşamalarındaki ilerleme durumunu gösterir.
                        </p>
                    </div>

                    <div class="flow-card-header-icon stat-blue">
                        <i class="fas fa-chart-line"></i>
                    </div>
                </div>

                <div class="flow-card-body">

                    <div class="progress-block mb-4">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                            <div>
                                <div class="progress-title">
                                    Hakem Atama İlerlemesi
                                </div>

                                <div class="progress-subtitle">
                                    @Model.AssignedSubmissionCount / @Model.SubmissionCount bildiri hakeme atanmış.
                                </div>
                            </div>

                            <span class="progress-percent">
                                %@assignmentProgressPercent
                            </span>
                        </div>

                        <div class="progress progress-modern">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @(assignmentProgressPercent)%;">
                            </div>
                        </div>
                    </div>

                    <div class="progress-block">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                            <div>
                                <div class="progress-title">
                                    Karar İlerlemesi
                                </div>

                                <div class="progress-subtitle">
                                    @Model.DecidedSubmissionCount / @Model.SubmissionCount bildiri için karar verilmiş.
                                </div>
                            </div>

                            <span class="progress-percent">
                                %@decisionProgressPercent
                            </span>
                        </div>

                        <div class="progress progress-modern">
                            <div class="progress-bar progress-bar-danger"
                                 role="progressbar"
                                 style="width: @(decisionProgressPercent)%;">
                            </div>
                        </div>
                    </div>

                    <div class="flow-note mt-4">
                        <i class="fas fa-circle-info me-2"></i>
                        Akışın tamamlanması için bildirilerin hakeme atanması, karar ekranından sonuçlandırılması ve kabul edilen bildirilerin program/bildiri kitabı süreçlerine alınması gerekir.
                    </div>

                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="flow-card h-100">
                <div class="flow-card-header">
                    <div>
                        <h5 class="flow-card-title">
                            Hızlı İşlemler
                        </h5>

                        <p class="flow-card-text">
                            Seçili kongreyle ilgili operasyon ekranlarına hızlı geçiş yapabilirsiniz.
                        </p>
                    </div>

                    <div class="flow-card-header-icon stat-green">
                        <i class="fas fa-bolt"></i>
                    </div>
                </div>

                <div class="flow-card-body">
                    <div class="quick-actions-grid">

                        <a href="@submissionUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-blue">
                                <i class="fas fa-file-alt"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Bildiri Yönetimi
                                </div>

                                <div class="quick-action-desc">
                                    Gönderilen bildirileri incele.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        <a href="@assignmentUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-green">
                                <i class="fas fa-tasks"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Hakem Atama
                                </div>

                                <div class="quick-action-desc">
                                    Bildirilere hakem ata.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        <a href="@decisionUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-red">
                                <i class="fas fa-gavel"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Karar Ekranı
                                </div>

                                <div class="quick-action-desc">
                                    Kabul, ret veya revizyon kararı ver.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        <a href="@reviewersUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-orange">
                                <i class="fas fa-user-check"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Hakemler
                                </div>

                                <div class="quick-action-desc">
                                    Hakem havuzunu ve hakem listesini yönet.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        <a href="@registrationsUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-cyan">
                                <i class="fas fa-credit-card"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Kayıtlar ve Ödemeler
                                </div>

                                <div class="quick-action-desc">
                                    Katılımcı kayıtlarını ve ödeme durumlarını kontrol et.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        <a href="@sessionsUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-purple">
                                <i class="fas fa-microphone-alt"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Program / Oturumlar
                                </div>

                                <div class="quick-action-desc">
                                    Kongre programını ve oturumları düzenle.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        <a href="@sessionsPrintUrl" class="quick-action-card">
                            <div class="quick-action-icon stat-gray">
                                <i class="fas fa-print"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Programı Yazdır
                                </div>

                                <div class="quick-action-desc">
                                    Yayındaki oturum programının yazdırılabilir halini aç.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        <a href="@proceedingBookUrl" class="quick-action-card quick-action-highlight">
                            <div class="quick-action-icon proceeding-book-icon">
                                <i class="fas fa-book-open"></i>
                            </div>

                            <div>
                                <div class="quick-action-title">
                                    Bildiri Kitabı
                                </div>

                                <div class="quick-action-desc">
                                    Kabul edilen bildirilerden PDF oluştur veya mevcut kitabı yönet.
                                </div>
                            </div>

                            <div class="quick-action-arrow">
                                <i class="fas fa-arrow-right"></i>
                            </div>
                        </a>

                        @if (isSuperAdmin)
                        {
                            <a href="@tenantAdminAssignUrl" class="quick-action-card">
                                <div class="quick-action-icon stat-dark">
                                    <i class="fas fa-user-shield"></i>
                                </div>

                                <div>
                                    <div class="quick-action-title">
                                        Kurum Yöneticisi Ata
                                    </div>

                                    <div class="quick-action-desc">
                                        Bu kongrenin bağlı olduğu kuruma admin ata.
                                    </div>
                                </div>

                                <div class="quick-action-arrow">
                                    <i class="fas fa-arrow-right"></i>
                                </div>
                            </a>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .conference-flow-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .flow-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .flow-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .flow-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .flow-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .flow-page-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
        line-height: 1.2;
    }

    .flow-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        line-height: 1.65;
        max-width: 850px;
    }

    .flow-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.8rem;
    }

    .flow-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        border-radius: 999px;
        padding: 0.48rem 0.78rem;
        font-size: 0.78rem;
        font-weight: 900;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .flow-chip-primary {
        background: rgba(0, 174, 239, 0.10);
        border-color: rgba(0, 174, 239, 0.22);
        color: #0d6efd;
    }

    .flow-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .flow-primary-btn,
    .flow-outline-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1.15rem;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .flow-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
    }

    .flow-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
    }

    .flow-outline-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
    }

    .flow-outline-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .flow-stat-card {
        min-height: 104px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1.15rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
        transition: all 0.2s ease;
    }

    .flow-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    .flow-stat-icon,
    .flow-card-header-icon,
    .quick-action-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .flow-stat-number {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 950;
        line-height: 1;
    }

    .flow-stat-label {
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 850;
        margin-top: 0.3rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .stat-red {
        background: rgba(239, 68, 68, 0.10);
        color: #ef4444;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .stat-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .stat-gray {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
    }

    .stat-dark {
        background: rgba(15, 23, 42, 0.10);
        color: #0f172a;
    }

    .flow-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .flow-card-header {
        padding: 1.25rem 1.35rem;
        border-bottom: 1px solid #edf2f7;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .flow-card-title {
        color: #0f172a;
        font-size: 1.12rem;
        font-weight: 950;
        margin-bottom: 0.2rem;
    }

    .flow-card-text {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.55;
    }

    .flow-card-body {
        padding: 1.35rem;
    }

    .progress-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.15rem;
    }

    .progress-subtitle {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
    }

    .progress-modern {
        height: 11px;
        border-radius: 999px;
        background-color: #eef2f7;
        overflow: hidden;
    }

    .progress-modern .progress-bar {
        border-radius: 999px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
    }

    .progress-modern .progress-bar-danger {
        background: linear-gradient(135deg, #ef4444, #f97316);
    }

    .progress-percent {
        background-color: #f1f5f9;
        color: #0f172a;
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
        border: 1px solid #e2e8f0;
    }

    .flow-note {
        background-color: #f8fafc;
        color: #64748b;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 0.95rem 1rem;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.6;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .quick-action-card {
        display: grid;
        grid-template-columns: 50px 1fr 34px;

@using AntAbstract.Web.Models.ViewModels
@using AntAbstract.Web.Models.ViewModels.Admin.Users
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model UserWithRolesViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">@Localizer["PageHeading"]</h4>
            <small class="text-muted">@Localizer["UserLabel"] <strong>@Model.UserEmail</strong></small>
        </div>

        <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            @Localizer["BackToListButton"]
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0">@TempData["ErrorMessage"]</div>
    }

    <form asp-area="Admin" asp-controller="Users" asp-action="ManageRoles" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="row row-cols-1 row-cols-md-2 g-2">
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        var localizedRole = Model.Roles[i].RoleName switch
                        {
                            "Admin" => Localizer["Role_Admin"].Value,
                            "Organizator" => Localizer["Role_Organizer"].Value,
                            "Author" => Localizer["Role_Author"].Value,
                            "Referee" => Localizer["Role_Referee"].Value,
                            _ => Model.Roles[i].RoleName
                        };

                        <div class="col">
                            <div class="form-check">
                                <input asp-for="Roles[i].RoleName" type="hidden" />
                                <input asp-for="Roles[i].IsSelected" class="form-check-input" />
                                <label class="form-check-label" asp-for="Roles[i].IsSelected">
                                    @localizedRole
                                </label>
                            </div>
                        </div>
                    }
                </div>

            </div>

            <div class="card-footer bg-white border-0 d-flex gap-2 justify-content-end p-3">
                <button type="submit" class="btn btn-primary">
                    @Localizer["SaveButton"]
                </button>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-light">
                    @Localizer["CancelButton"]
                </a>
            </div>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
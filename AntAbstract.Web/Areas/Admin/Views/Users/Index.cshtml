@model List<AntAbstract.Web.Models.ViewModels.Admin.Users.UserListItemViewModel>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_LayoutDashboard";

    var search = ViewBag.Search as string;
    var selectedRole = ViewBag.SelectedRole as string;
    var allowedRoles = ViewBag.AllowedRoles as string[] ?? new[]
    {
        "SuperAdmin",
        "Admin",
        "Author",
        "Listener",
        "Referee"
    };

    var totalUserCount = ViewBag.TotalUserCount ?? 0;
    var superAdminCount = ViewBag.SuperAdminCount ?? 0;
    var adminCount = ViewBag.AdminCount ?? 0;
    var authorCount = ViewBag.AuthorCount ?? 0;
    var refereeCount = ViewBag.RefereeCount ?? 0;
    var listenerCount = ViewBag.ListenerCount ?? 0;
}

@functions {
    private string GetRoleLabel(string role)
    {
        return role switch
        {
            "SuperAdmin" => "Süper Admin",
            "Admin" => "Admin",
            "Author" => "Yazar",
            "Listener" => "Dinleyici",
            "Referee" => "Hakem",
            _ => role
        };
    }

    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "SuperAdmin" => "bg-dark text-white",
            "Admin" => "bg-danger bg-opacity-10 text-danger",
            "Author" => "bg-primary bg-opacity-10 text-primary",
            "Listener" => "bg-info bg-opacity-10 text-info",
            "Referee" => "bg-warning bg-opacity-10 text-warning",
            _ => "bg-secondary bg-opacity-10 text-secondary"
        };
    }
}

<div class="container-fluid">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="text-uppercase text-muted fw-bold small mb-1">
                Yönetim
            </div>

            <h2 class="fw-bold mb-1 text-dark">
                Kullanıcı Yönetimi
            </h2>

            <p class="text-muted mb-0">
                Sistemdeki kullanıcıları görüntüleyin, rolleri düzenleyin ve yetki atamalarını yönetin.
            </p>
        </div>
        <div class="page-header-right">
            <a href="/Admin/Tenants" class="btn btn-light border rounded-pill px-4 header-action-btn">
                <i class="fas fa-building me-2 text-primary"></i>
            Kurumlara Git
        </a>
    </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-2 col-6">
            <div class="info-card">
                <div class="info-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <div class="info-number">@totalUserCount</div>
                    <div class="info-label">Toplam Kullanıcı</div>
                </div>
            </div>
        </div>

        <div class="col-md-2 col-6">
            <div class="info-card">
                <div class="info-icon bg-dark bg-opacity-10 text-dark">
                    <i class="fas fa-shield-halved"></i>
                </div>

                <div>
                    <div class="info-number">@superAdminCount</div>
                    <div class="info-label">Süper Admin</div>
                </div>
            </div>
        </div>

        <div class="col-md-2 col-6">
            <div class="info-card">
                <div class="info-icon bg-danger bg-opacity-10 text-danger">
                    <i class="fas fa-user-tie"></i>
                </div>

                <div>
                    <div class="info-number">@adminCount</div>
                    <div class="info-label">Admin</div>
                </div>
            </div>
        </div>

        <div class="col-md-2 col-6">
            <div class="info-card">
                <div class="info-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-pen-nib"></i>
                </div>

                <div>
                    <div class="info-number">@authorCount</div>
                    <div class="info-label">Yazar</div>
                </div>
            </div>
        </div>

        <div class="col-md-2 col-6">
            <div class="info-card">
                <div class="info-icon bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-gavel"></i>
                </div>

                <div>
                    <div class="info-number">@refereeCount</div>
                    <div class="info-label">Hakem</div>
                </div>
            </div>
        </div>

        <div class="col-md-2 col-6">
            <div class="info-card">
                <div class="info-icon bg-info bg-opacity-10 text-info">
                    <i class="fas fa-headphones"></i>
                </div>

                <div>
                    <div class="info-number">@listenerCount</div>
                    <div class="info-label">Dinleyici</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="get"
                  asp-area="Admin"
                  asp-controller="Users"
                  asp-action="Index"
                  class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Arama</label>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control rounded-3"
                           placeholder="Ad, soyad veya e-posta ara..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Rol</label>

                    <select name="role" class="form-select rounded-3">
                        @if (string.IsNullOrWhiteSpace(selectedRole) || selectedRole == "All")
                        {
                            <option value="All" selected>Tüm Roller</option>
                        }
                        else
                        {
                            <option value="All">Tüm Roller</option>
                        }

                        @foreach (var role in allowedRoles)
                        {
                            if (selectedRole == role)
                            {
                                <option value="@role" selected>@GetRoleLabel(role)</option>
                            }
                            else
                            {
                                <option value="@role">@GetRoleLabel(role)</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-3 w-100">
                        <i class="fas fa-search me-1"></i>
                        Filtrele
                    </button>

                    <a href="/Admin/Users" class="btn btn-light border rounded-3">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                </div>

            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-visible">
        <div class="card-header bg-white border-0 px-4 py-3">
            <h5 class="fw-bold mb-1">
                Kullanıcı Listesi
            </h5>

            <p class="text-muted small mb-0">
                Kullanıcı rolleri bu ekrandan düzenlenir. Süper Admin kendi Süper Admin rolünü kaldıramaz.
            </p>
        </div>

        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-user-slash fa-3x mb-3 opacity-25"></i>

                    <h6 class="fw-bold mb-1">
                        Kullanıcı bulunamadı
                    </h6>

                    <p class="mb-0">
                        Arama veya filtre kriterlerine uygun kullanıcı yok.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive users-table-responsive">
                    <table class="table table-hover align-middle mb-0 users-table">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-muted fw-bold small" style="width: 28%;">
                                    Kullanıcı
                                </th>

                                <th class="py-3 text-muted fw-bold small" style="width: 24%;">
                                    E-posta
                                </th>

                                <th class="py-3 text-muted fw-bold small" style="width: 28%;">
                                    Mevcut Roller
                                </th>

                                <th class="py-3 text-muted fw-bold small text-center" style="width: 10%;">
                                    Durum
                                </th>

                                <th class="pe-4 py-3 text-muted fw-bold small text-end" style="min-width: 280px;">
                                    İşlemler
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                var displayName = string.IsNullOrWhiteSpace(item.Name)
                                ? item.Email
                                : item.Name;

                                var firstLetter = !string.IsNullOrWhiteSpace(displayName)
                                ? displayName.Trim().Substring(0, 1).ToUpper()
                                : "?";

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold">
                                                @firstLetter
                                            </div>

                                            <div>
                                                <span class="fw-bold d-block text-dark">
                                                    @displayName
                                                </span>

                                                <small class="text-muted">
                                                    ID: @item.UserId.Substring(0, 8)...
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.Roles != null && item.Roles.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var role in item.Roles)
                                                {
                                                    <span class="role-badge @GetRoleBadgeClass(role)">
                                                        @GetRoleLabel(role)

                                                        <form asp-area="Admin"
                                                              asp-controller="Users"
                                                              asp-action="RemoveRole"
                                                              method="post"
                                                              class="d-inline ms-1">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden" name="userId" value="@item.UserId" />
                                                            <input type="hidden" name="roleName" value="@role" />

                                                            <button type="submit"
                                                                    class="role-remove-btn"
                                                                    title="@GetRoleLabel(role) rolünü kaldır">
                                                                ×
                                                            </button>
                                                        </form>
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Rol atanmamış
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Aktif
                                        </span>
                                    </td>

                                    <td class="pe-4 text-end actions-cell">
                                        <div class="action-buttons">

                                            <a asp-area="Admin"
                                               asp-controller="Users"
                                               asp-action="ManageRoles"
                                               asp-route-userId="@item.UserId"
                                               class="btn btn-sm btn-outline-secondary rounded-3 action-btn">
                                                <i class="fas fa-user-gear me-1"></i>
                                                Roller
                                            </a>

                                            <div class="dropdown user-role-dropdown-wrapper">
                                                <button class="btn btn-sm btn-outline-primary rounded-3 dropdown-toggle action-btn"
                                                        type="button"
                                                        data-bs-toggle="dropdown"
                                                        data-bs-boundary="viewport"
                                                        aria-expanded="false">
                                                    Yetki Ver
                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end user-role-dropdown shadow border-0 rounded-3 p-2">
                                                    @{
                                                        var availableRoles = allowedRoles
                                                        .Where(role => item.Roles == null ||
                                                        !item.Roles.Contains(role, StringComparer.OrdinalIgnoreCase))
                                                        .ToList();
                                                    }

                                                    @if (availableRoles.Any())
                                                    {
                                                        foreach (var role in availableRoles)
                                                        {
                                                            <li>
                                                                <form asp-area="Admin"
                                                                      asp-controller="Users"
                                                                      asp-action="AssignRole"
                                                                      method="post">

                                                                    @Html.AntiForgeryToken()

                                                                    <input type="hidden" name="userId" value="@item.UserId" />
                                                                    <input type="hidden" name="roleName" value="@role" />

                                                                    <button type="submit" class="dropdown-item rounded-2 role-dropdown-item">
                                                                        <i class="fas fa-plus text-primary"></i>
                                                                        <span>@GetRoleLabel(role)</span>
                                                                    </button>
                                                                </form>
                                                            </li>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <li>
                                                            <span class="dropdown-item text-muted small">
                                                                Tüm roller atanmış
                                                            </span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>

<style>
    .info-card {
        background-color: #fff;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        border: 1px solid #f1f5f9;
        min-height: 95px;
    }

    .info-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .info-number {
        font-size: 1.55rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }

    .info-label {
        color: #64748b;
        font-weight: 700;
        font-size: 0.76rem;
        margin-top: 0.25rem;
    }

    .users-table-responsive {
        overflow: visible;
    }

    .users-table thead th {
        font-size: 0.7rem;
        letter-spacing: 0.8px;
        border-bottom: none;
        text-transform: uppercase;
    }

    .users-table tbody tr {
        position: relative;
        z-index: 1;
        transition: background-color 0.2s ease;
        border-bottom: 1px solid #f8fafc;
    }

        .users-table tbody tr:hover {
            background-color: #fbfcfe !important;
        }

        .users-table tbody tr:has(.dropdown-menu.show) {
            z-index: 9999;
        }

    .avatar-sm {
        width: 42px;
        height: 42px;
        min-width: 42px;
        font-size: 0.95rem;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        border-radius: 999px;
        padding: 0.35rem 0.6rem;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .role-remove-btn {
        border: none;
        background: transparent;
        color: inherit;
        font-weight: 900;
        line-height: 1;
        padding: 0;
        cursor: pointer;
        opacity: 0.8;
    }

        .role-remove-btn:hover {
            opacity: 1;
            transform: scale(1.15);
        }

    .actions-cell {
        position: relative;
        min-width: 280px;
        white-space: nowrap;
        overflow: visible;
    }

    .action-buttons {
        position: relative;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: nowrap;
        overflow: visible;
    }

    .action-btn {
        min-width: 96px;
        white-space: nowrap;
    }

    .user-role-dropdown-wrapper {
        position: relative;
    }

    .user-role-dropdown {
        min-width: 210px;
        z-index: 10000 !important;
        background-color: #fff;
    }

    .dropdown-menu.show {
        z-index: 10000 !important;
    }

    .role-dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-weight: 600;
        padding: 0.55rem 0.8rem;
    }

        .role-dropdown-item i {
            width: 16px;
            text-align: center;
        }

    .page-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.65rem;
        flex-wrap: nowrap;
        flex: 0 0 auto;
    }

    .header-action-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: none;
    }
</style>
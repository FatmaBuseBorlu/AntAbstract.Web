@model List<AntAbstract.Web.Models.ViewModels.Admin.Users.UserListItemViewModel>

@using System
@using System.Linq

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var users = Model ?? new List<AntAbstract.Web.Models.ViewModels.Admin.Users.UserListItemViewModel>();

    var search = ViewBag.Search as string;
    var selectedRole = ViewBag.SelectedRole as string;
    var allowedRoles = ViewBag.AllowedRoles as string[] ?? new[]
    {
        "SuperAdmin",
        "Admin",
        "Author",
        "Listener",
        "Referee"
    };

    var totalUserCount = ViewBag.TotalUserCount ?? users.Count;
    var superAdminCount = ViewBag.SuperAdminCount ?? users.Count(x => x.Roles != null && x.Roles.Contains("SuperAdmin"));
    var adminCount = ViewBag.AdminCount ?? users.Count(x => x.Roles != null && x.Roles.Contains("Admin"));
    var authorCount = ViewBag.AuthorCount ?? users.Count(x => x.Roles != null && x.Roles.Contains("Author"));
    var refereeCount = ViewBag.RefereeCount ?? users.Count(x => x.Roles != null && x.Roles.Contains("Referee"));
    var listenerCount = ViewBag.ListenerCount ?? users.Count(x => x.Roles != null && x.Roles.Contains("Listener"));
}

@functions {
    private string GetRoleLabel(string role)
    {
        return role switch
        {
            "SuperAdmin" => Localizer["SuperAdmin"].Value,
            "Admin" => Localizer["Admin"].Value,
            "Author" => Localizer["Author"].Value,
            "Listener" => Localizer["Listener"].Value,
            "Referee" => Localizer["Referee"].Value,
            _ => role
        };
    }

    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "SuperAdmin" => "role-super-admin",
            "Admin" => "role-admin",
            "Author" => "role-author",
            "Listener" => "role-listener",
            "Referee" => "role-referee",
            _ => "role-default"
        };
    }
}

<style>
    .users-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .admin-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%),
                    linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .admin-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .admin-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .admin-hero-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .admin-hero-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .admin-hero-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
        max-width: 860px;
    }

    .admin-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .admin-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .admin-hero-btn-light {
        background: #ffffff;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .admin-hero-btn-light:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .admin-stat-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .admin-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.05rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 96px;
    }

    .admin-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-dark {
        background: rgba(15, 23, 42, 0.10);
        color: #0f172a;
    }

    .stat-red {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
    }

    .admin-stat-value {
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .admin-stat-label {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 850;
        margin-top: 0.25rem;
        line-height: 1.25;
    }

    .users-filter-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        padding: 1.15rem;
        margin-bottom: 1.4rem;
    }

    .filter-label {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.55rem;
    }

    .filter-control {
        min-height: 48px;
        border-radius: 15px;
        border: 1px solid #dbe4ef;
        background: #ffffff;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 750;
        box-shadow: none;
        transition: all 0.2s ease;
    }

    .filter-control:focus {
        border-color: #00aeef;
        box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.10);
    }

    .filter-btn {
        min-height: 48px;
        border-radius: 15px;
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-size: 0.9rem;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.18);
        transition: all 0.2s ease;
    }

    .filter-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(13, 110, 253, 0.24);
    }

    .reset-btn {
        min-width: 52px;
        min-height: 48px;
        border-radius: 15px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .reset-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .users-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: visible;
        position: relative;
        z-index: 1;
    }

    .users-card-header {
        padding: 1.15rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        border-radius: 26px 26px 0 0;
    }

    .users-card-title {
        color: #0f172a;
        font-size: 1.08rem;
        font-weight: 900;
        margin: 0 0 0.25rem;
    }

    .users-card-subtitle {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.55;
        margin-bottom: 0;
    }

    .users-card-count {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0 0.8rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .users-table-responsive {
        overflow: visible;
        position: relative;
    }

    .users-table {
        min-width: 1180px;
        margin-bottom: 0;
        position: relative;
    }

    .users-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 1rem 1.15rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .users-table tbody td {
        padding: 0.95rem 1.15rem;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .users-table tbody tr {
        position: relative;
        z-index: 1;
    }

    .users-table tbody tr:hover {
        background: #f8fbff;
    }

    .users-table tbody tr:has(.dropdown-menu.show) {
        z-index: 9999;
    }

    .users-table tbody tr:last-child td {
        border-bottom: none;
    }

    .user-main {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-width: 0;
    }

    .user-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 16px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        font-weight: 950;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }

    .user-name {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 950;
        line-height: 1.35;
    }

    .user-id {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 750;
        margin-top: 0.15rem;
    }

    .user-email {
        color: #475569;
        font-size: 0.86rem;
        font-weight: 750;
        word-break: break-word;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.32rem;
        border-radius: 999px;
        padding: 0.42rem 0.72rem;
        font-size: 0.75rem;
        font-weight: 900;
        border: 1px solid transparent;
    }

    .role-super-admin {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
    }

    .role-admin {
        background: rgba(239, 68, 68, 0.10);
        color: #dc2626;
        border-color: rgba(239, 68, 68, 0.18);
    }

    .role-author {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.16);
    }

    .role-listener {
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
        border-color: rgba(0, 174, 239, 0.16);
    }

    .role-referee {
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
        border-color: rgba(245, 158, 11, 0.18);
    }

    .role-default {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.18);
    }

    .role-remove-btn {
        border: none;
        background: transparent;
        color: inherit;
        font-weight: 950;
        line-height: 1;
        padding: 0;
        cursor: pointer;
        opacity: 0.75;
        transition: all 0.15s ease;
    }

    .role-remove-btn:hover {
        opacity: 1;
        transform: scale(1.16);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        border-radius: 999px;
        padding: 0.42rem 0.72rem;
        font-size: 0.76rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border: 1px solid rgba(34, 197, 94, 0.18);
    }

    .actions-cell {
        position: relative;
        min-width: 360px;
        white-space: nowrap;
        overflow: visible;
    }

    .action-buttons {
        position: relative;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 0.38rem;
        flex-wrap: nowrap;
        overflow: visible;
    }

    .user-action-btn {
        min-height: 34px;
        border-radius: 10px;
        padding: 0 0.65rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.38rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid transparent;
        background: #ffffff;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .user-action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.10);
        text-decoration: none;
    }

    .user-action-roles {
        color: #475569;
        border-color: #e2e8f0;
    }

    .user-action-roles:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
        background: #f8fbff;
    }

    .user-action-permission {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.26);
    }

    .user-action-permission:hover {
        color: #0a58ca;
        background: rgba(13, 110, 253, 0.08);
    }

    .user-role-dropdown-wrapper {
        position: relative;
    }

    .user-role-dropdown {
        min-width: 220px;
        z-index: 10000 !important;
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.14) !important;
    }

    .dropdown-menu.show {
        z-index: 10000 !important;
    }

    .role-dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-weight: 800;
        padding: 0.58rem 0.8rem;
        color: #334155;
    }

    .role-dropdown-item:hover {
        background: #f8fbff;
        color: #0d6efd;
    }

    .role-dropdown-item i {
        width: 16px;
        text-align: center;
    }

    .users-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        color: #64748b;
    }

    .users-empty-icon {
        width: 76px;
        height: 76px;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .users-empty-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        margin-bottom: 0.35rem;
    }

    .users-empty-text {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    @@media (max-width: 1400px) {
        .admin-stat-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .admin-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .users-page {
            padding: 1.5rem 1rem 3rem;
        }

        .admin-hero-left {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-hero-title {
            font-size: 1.45rem;
        }

        .admin-stat-grid {
            grid-template-columns: 1fr;
        }

        .users-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .filter-btn,
        .reset-btn {
            width: 100%;
        }
    }
</style>

<div class="users-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-users"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    @Localizer["Kicker"]
                </div>

                <h3 class="admin-hero-title">
                    @Localizer["PageTitle"]
                </h3>

                <p class="admin-hero-lead">
                    @Localizer["PageDescription"]
                </p>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="/Admin/Tenants" class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-building"></i>
                @Localizer["GoToInstitutions"]
            </a>
        </div>
    </div>

    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-users"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @totalUserCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["TotalUsers"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-dark">
                <i class="fas fa-shield-halved"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @superAdminCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["SuperAdmin"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-red">
                <i class="fas fa-user-tie"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @adminCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["Admin"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-pen-nib"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @authorCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["Author"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-orange">
                <i class="fas fa-gavel"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @refereeCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["Referee"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-headphones"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @listenerCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["Listener"]
                </div>
            </div>
        </div>
    </div>

    <div class="users-filter-card">
        <form method="get"
              asp-area="Admin"
              asp-controller="Users"
              asp-action="Index"
              class="row g-3 align-items-end">

            <div class="col-lg-6">
                <label class="filter-label">
                    @Localizer["Search"]
                </label>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control filter-control"
                       placeholder="@Localizer["SearchPlaceholder"]" />
            </div>

            <div class="col-lg-3">
                <label class="filter-label">
                    @Localizer["Role"]
                </label>

                <select name="role" class="form-select filter-control">
                    @if (string.IsNullOrWhiteSpace(selectedRole) || selectedRole == "All")
                    {
                        <option value="All" selected>@Localizer["AllRoles"]</option>
                    }
                    else
                    {
                        <option value="All">@Localizer["AllRoles"]</option>
                    }

                    @foreach (var role in allowedRoles)
                    {
                        if (selectedRole == role)
                        {
                            <option value="@role" selected>@GetRoleLabel(role)</option>
                        }
                        else
                        {
                            <option value="@role">@GetRoleLabel(role)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="filter-btn flex-fill">
                        <i class="fas fa-search"></i>
                        @Localizer["Filter"]
                    </button>

                    <a href="/Admin/Users" class="reset-btn" title="@Localizer["ClearFilter"]">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="users-card">
        <div class="users-card-header">
            <div>
                <h5 class="users-card-title">
                    @Localizer["UserList"]
                </h5>

                <p class="users-card-subtitle">
                    @Localizer["UserListDescription"]
                </p>
            </div>

            <span class="users-card-count">
                <i class="fas fa-list-ul"></i>
                @users.Count @Localizer["Records"]
            </span>
        </div>

        @{
            int pgTotalPages = (int)(ViewBag.TotalPages ?? 1);
            int pgCurrentPage = (int)(ViewBag.Page ?? 1);
            int pgPageSize = (int)(ViewBag.PageSize ?? 50);
            int pgFilteredCount = (int)(ViewBag.FilteredCount ?? 0);
            string pgSearchVal = (string?)(ViewBag.Search) ?? "";
            string pgRoleVal = (string?)(ViewBag.SelectedRole) ?? "";
            string pgBaseUrl = $"/Admin/Users?search={pgSearchVal}&role={pgRoleVal}";
        }

        @if (!users.Any())
        {
            <div class="users-empty-state">
                <div class="users-empty-icon">
                    <i class="fas fa-user-slash"></i>
                </div>

                <h6 class="users-empty-title">
                    @Localizer["NoUsersFound"]
                </h6>

                <p class="users-empty-text">
                    @Localizer["NoUsersDescription"]
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive users-table-responsive">
                <table class="table table-hover align-middle users-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 28%;">
                                @Localizer["User"]
                            </th>

                            <th style="width: 24%;">
                                @Localizer["Email"]
                            </th>

                            <th style="width: 28%;">
                                @Localizer["CurrentRoles"]
                            </th>

                            <th class="text-center" style="width: 10%;">
                                @Localizer["Status"]
                            </th>

                            <th class="pe-4 text-end" style="min-width: 280px;">
                                @Localizer["Actions"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in users)
                        {
                            var displayName = string.IsNullOrWhiteSpace(item.Name)
                                ? item.Email
                                : item.Name;

                            var firstLetter = !string.IsNullOrWhiteSpace(displayName)
                                ? displayName.Trim().Substring(0, 1).ToUpper()
                                : "?";

                            var shortId = !string.IsNullOrWhiteSpace(item.UserId) && item.UserId.Length >= 8
                                ? item.UserId.Substring(0, 8)
                                : item.UserId;

                            <tr>
                                <td class="ps-4">
                                    <div class="user-main">
                                        <div class="user-avatar">
                                            @firstLetter
                                        </div>

                                        <div>
                                            <div class="user-name">
                                                @displayName
                                            </div>

                                            <div class="user-id">
                                                ID: @shortId...
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="user-email">
                                        @(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)
                                    </span>
                                </td>

                                <td>
                                    @if (item.Roles != null && item.Roles.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var role in item.Roles)
                                            {
                                                <span class="role-badge @GetRoleBadgeClass(role)">
                                                    @GetRoleLabel(role)

                                                    <form asp-area="Admin"
                                                          asp-controller="Users"
                                                          asp-action="RemoveRole"
                                                          method="post"
                                                          class="d-inline ms-1">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="userId" value="@item.UserId" />
                                                        <input type="hidden" name="roleName" value="@role" />

                                                        <button type="submit"
                                                                class="role-remove-btn"
                                                                title="@string.Format(Localizer["RemoveRoleTitle"].Value, GetRoleLabel(role))">
                                                            ×
                                                        </button>
                                                    </form>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fw-bold">
                                            @Localizer["NoRoleAssigned"]
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (item.IsLockedOut)
                                    {
                                        <span class="badge bg-danger rounded-pill">
                                            <i class="fas fa-ban me-1"></i>@Localizer["Suspended"]
                                        </span>
                                    }
                                    else if (!item.EmailConfirmed)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">
                                            <i class="fas fa-envelope me-1"></i>@Localizer["Unverified"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fas fa-check-circle"></i>
                                            @Localizer["Active"]
                                        </span>
                                    }
                                </td>

                                <td class="pe-4 text-end actions-cell">
                                    <div class="action-buttons">
                                        <a asp-area="Admin"
                                           asp-controller="Users"
                                           asp-action="Details"
                                           asp-route-userId="@item.UserId"
                                           class="user-action-btn user-action-roles">
                                            <i class="fas fa-eye"></i>
                                            @Localizer["Details"]
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Users"
                                           asp-action="ManageRoles"
                                           asp-route-userId="@item.UserId"
                                           class="user-action-btn user-action-roles">
                                            <i class="fas fa-user-gear"></i>
                                            @Localizer["Roles"]
                                        </a>

                                        @if (item.IsLockedOut)
                                        {
                                            <form asp-area="Admin" asp-controller="Users"
                                                  asp-action="Unlock" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@item.UserId" />
                                                <button type="submit" class="user-action-btn"
                                                        style="background:#d1fae5;color:#065f46;border:1.5px solid #a7f3d0;">
                                                    <i class="fas fa-lock-open"></i> @Localizer["Activate"]
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Admin" asp-controller="Users"
                                                  asp-action="Lock" method="post" class="d-inline"
                                                  onsubmit="return confirm(Localizer.GetString('ConfirmSuspend').Value);">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@item.UserId" />
                                                <button type="submit" class="user-action-btn"
                                                        style="background:#fef3c7;color:#92400e;border:1.5px solid #fde68a;">
                                                    <i class="fas fa-ban"></i> @Localizer["Suspend"]
                                                </button>
                                            </form>
                                        }

                                        <div class="dropdown user-role-dropdown-wrapper">
                                            <button class="user-action-btn user-action-permission dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    data-bs-boundary="viewport"
                                                    aria-expanded="false">
                                                @Localizer["AssignPermission"]
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end user-role-dropdown rounded-3 p-2">
                                                @{
                                                    var availableRoles = allowedRoles
                                                        .Where(role => item.Roles == null ||
                                                            !item.Roles.Contains(role, StringComparer.OrdinalIgnoreCase))
                                                        .ToList();
                                                }

                                                @if (availableRoles.Any())
                                                {
                                                    foreach (var role in availableRoles)
                                                    {
                                                        <li>
                                                            <form asp-area="Admin"
                                                                  asp-controller="Users"
                                                                  asp-action="AssignRole"
                                                                  method="post">

                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden" name="userId" value="@item.UserId" />
                                                                <input type="hidden" name="roleName" value="@role" />

                                                                <button type="submit" class="dropdown-item rounded-2 role-dropdown-item">
                                                                    <i class="fas fa-plus text-primary"></i>
                                                                    <span>@GetRoleLabel(role)</span>
                                                                </button>
                                                            </form>
                                                        </li>
                                                    }
                                                }
                                                else
                                                {
                                                    <li>
                                                        <span class="dropdown-item text-muted small fw-bold">
                                                            @Localizer["AllRolesAssigned"]
                                                        </span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (pgTotalPages > 1)
            {
                <nav aria-label="@Localizer["UserPagination"]" class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        <li class="page-item @(pgCurrentPage > 1 ? "" : "disabled")">
                            <a class="page-link" href="@pgBaseUrl&page=@(pgCurrentPage - 1)">‹</a>
                        </li>
                        @for (var p = Math.Max(1, pgCurrentPage - 2); p <= Math.Min(pgTotalPages, pgCurrentPage + 2); p++)
                        {
                            <li class="page-item @(p == pgCurrentPage ? "active" : "")">
                                <a class="page-link" href="@pgBaseUrl&page=@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(pgCurrentPage < pgTotalPages ? "" : "disabled")">
                            <a class="page-link" href="@pgBaseUrl&page=@(pgCurrentPage + 1)">›</a>
                        </li>
                    </ul>
                    <p class="text-center text-muted small">
                        @string.Format(Localizer["PaginationInfo"].Value, pgFilteredCount, (pgCurrentPage - 1) * pgPageSize + 1, Math.Min(pgCurrentPage * pgPageSize, pgFilteredCount))
                    </p>
                </nav>
            }
        }
    </div>
</div>
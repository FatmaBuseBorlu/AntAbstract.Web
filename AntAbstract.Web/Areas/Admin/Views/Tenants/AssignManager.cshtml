@model AntAbstract.Web.Models.ViewModels.Admin.Tenants.TenantAssignManagerViewModel

@{
    ViewData["Title"] = "Kurum Yöneticisi Ata";
    Layout = "_LayoutDashboard";
}

<style>
    .tenant-manager-page {
        padding: 1rem 0 3rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .tenant-manager-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .tenant-manager-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.04em;
        margin-bottom: 0.25rem;
    }

    .tenant-manager-lead {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0;
    }

    .tenant-manager-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.8fr);
        gap: 1.25rem;
        align-items: start;
    }

    .tenant-manager-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.055);
        overflow: hidden;
    }

    .tenant-manager-card-body {
        padding: 1.35rem;
    }

    .assign-mode-box {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .assign-mode-option {
        position: relative;
    }

        .assign-mode-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .assign-mode-label {
        height: 100%;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 18px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .assign-mode-label:hover {
            border-color: rgba(0, 174, 239, 0.35);
            background: #f0f9ff;
        }

    .assign-mode-option input:checked + .assign-mode-label {
        background: rgba(0, 174, 239, 0.08);
        border-color: rgba(0, 174, 239, 0.45);
        box-shadow: 0 12px 26px rgba(0, 174, 239, 0.10);
    }

    .assign-mode-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .assign-mode-title {
        display: block;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 900;
        margin-bottom: 0.18rem;
    }

    .assign-mode-desc {
        display: block;
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 600;
        line-height: 1.45;
    }

    .manager-form-section {
        display: none;
    }

        .manager-form-section.active {
            display: block;
        }

    .manager-label {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.45rem;
    }

    .manager-form-control {
        min-height: 46px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        font-weight: 700;
        color: #0f172a;
    }

        .manager-form-control:focus {
            border-color: #00aeef;
            box-shadow: 0 0 0 0.18rem rgba(0, 174, 239, 0.12);
        }

    .manager-help {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
        margin-top: 0.45rem;
    }

    .manager-submit-btn {
        width: 100%;
        min-height: 50px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #198754, #0f9f6e);
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        box-shadow: 0 14px 30px rgba(25, 135, 84, 0.18);
        transition: all 0.2s ease;
    }

        .manager-submit-btn:hover {
            transform: translateY(-1px);
            color: #ffffff;
            box-shadow: 0 18px 36px rgba(25, 135, 84, 0.24);
        }

    .manager-info-card {
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.12), rgba(255, 255, 255, 0.92));
        border-left: 4px solid #198754;
    }

    .manager-info-icon {
        width: 56px;
        height: 56px;
        border-radius: 999px;
        background: #ffffff;
        color: #198754;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
        margin-bottom: 0.85rem;
    }

    .manager-info-title {
        color: #047857;
        font-size: 1.15rem;
        font-weight: 900;
        margin-bottom: 0.75rem;
    }

    .manager-info-list {
        display: grid;
        gap: 0.7rem;
        margin-top: 1rem;
    }

    .manager-info-item {
        display: flex;
        gap: 0.65rem;
        align-items: flex-start;
        color: #0f172a;
        font-size: 0.84rem;
        font-weight: 600;
        line-height: 1.55;
    }

        .manager-info-item i {
            margin-top: 0.15rem;
            width: 18px;
            text-align: center;
        }

        .manager-info-item.success i {
            color: #198754;
        }

        .manager-info-item.danger i {
            color: #ef4444;
        }

    .validation-summary-errors {
        border-radius: 14px;
        background: #fef2f2;
        color: #b91c1c;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
        font-weight: 700;
    }

    .field-validation-error {
        color: #dc2626;
        font-size: 0.78rem;
        font-weight: 700;
        margin-top: 0.35rem;
        display: block;
    }

    @@media (max-width: 992px) {
        .tenant-manager-grid {
            grid-template-columns: 1fr;
        }

        .assign-mode-box {
            grid-template-columns: 1fr;
        }

        .tenant-manager-header {
            flex-direction: column;
        }
    }
</style>

<div class="tenant-manager-page">
    <div class="tenant-manager-header">
        <div>
            <h2 class="tenant-manager-title">
                <i class="fas fa-user-shield text-success me-2"></i>
                Kurum Yöneticisi Ata
            </h2>

            <p class="tenant-manager-lead">
                <strong>@Model.TenantName</strong> kurumu için admin hesabı oluşturabilir veya mevcut bir kullanıcıyı admin yapabilirsiniz.
            </p>
        </div>

<a href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Url.Action("Index", "Tenants", new { area = "Admin" }) : Model.ReturnUrl)"
   class="btn btn-light border rounded-pill fw-bold px-4">
    <i class="fas fa-arrow-left me-2"></i>
    Listeye Dön
</a>
    </div>

    <div class="tenant-manager-grid">
        <div class="tenant-manager-card">
            <div class="tenant-manager-card-body">
                <form asp-action="AssignManager" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="TenantId" />
                    <input type="hidden" asp-for="TenantName" />
<                   input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="assign-mode-box">
                        <div class="assign-mode-option">
                            <input type="radio"
                                   asp-for="AssignmentMode"
                                   id="modeExisting"
                                   value="Existing" />

                            <label for="modeExisting" class="assign-mode-label">
                                <span class="assign-mode-icon">
                                    <i class="fas fa-users"></i>
                                </span>

                                <span>
                                    <span class="assign-mode-title">
                                        Mevcut Kullanıcıyı Ata
                                    </span>

                                    <span class="assign-mode-desc">
                                        Sistemde kayıtlı bir kullanıcıyı bu kuruma admin yap.
                                    </span>
                                </span>
                            </label>
                        </div>

                        <div class="assign-mode-option">
                            <input type="radio"
                                   asp-for="AssignmentMode"
                                   id="modeNew"
                                   value="New" />

                            <label for="modeNew" class="assign-mode-label">
                                <span class="assign-mode-icon">
                                    <i class="fas fa-user-plus"></i>
                                </span>

                                <span>
                                    <span class="assign-mode-title">
                                        Yeni Admin Oluştur
                                    </span>

                                    <span class="assign-mode-desc">
                                        Yeni kullanıcı oluştur ve bu kuruma admin olarak bağla.
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div id="existingUserSection" class="manager-form-section">
                        <div class="mb-3">
                            <label asp-for="ExistingUserId" class="manager-label">
                                Admin Yapılacak Kullanıcı
                            </label>

                            <select asp-for="ExistingUserId"
                                    asp-items="Model.AvailableUsers"
                                    class="form-select manager-form-control">
                                <option value="">Kullanıcı seçiniz...</option>
                            </select>

                            <span asp-validation-for="ExistingUserId"></span>

                            <div class="manager-help">
                                Listede Süper Admin kullanıcıları gösterilmez. Seçilen kullanıcı bu kuruma bağlanır ve Admin rolü alır.
                            </div>
                        </div>
                    </div>

                    <div id="newUserSection" class="manager-form-section">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="manager-label">
                                    Yönetici Adı
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control manager-form-control"
                                       placeholder="Örn: Ahmet" />

                                <span asp-validation-for="FirstName"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="manager-label">
                                    Soyadı
                                </label>

                                <input asp-for="LastName"
                                       class="form-control manager-form-control"
                                       placeholder="Örn: Yılmaz" />

                                <span asp-validation-for="LastName"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="manager-label">
                                    E-posta Adresi
                                </label>

                                <input asp-for="Email"
                                       class="form-control manager-form-control"
                                       placeholder="Örn: yonetici@kurum.edu.tr" />

                                <span asp-validation-for="Email"></span>

                                <div class="manager-help">
                                    Yönetici sisteme bu e-posta adresi ile giriş yapacaktır.
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Password" class="manager-label">
                                    Giriş Şifresi
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control manager-form-control"
                                       placeholder="En az 6 karakterli şifre belirleyin" />

                                <span asp-validation-for="Password"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <button type="submit" class="manager-submit-btn">
                        <i class="fas fa-user-check"></i>
                        Kaydet ve Yetkilendir
                    </button>
                </form>
            </div>
        </div>

        <div class="tenant-manager-card manager-info-card">
            <div class="tenant-manager-card-body">
                <div class="manager-info-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>

                <h4 class="manager-info-title">
                    Yetkilendirme Hakkında
                </h4>

                <p class="mb-0">
                    Buradan atanan kullanıcı otomatik olarak <strong>Admin</strong> rolüne sahip olur.
                </p>

                <div class="manager-info-list">
                    <div class="manager-info-item success">
                        <i class="fas fa-check-circle"></i>
                        <span>Kendi kurumuna ait tüm kongreleri görebilir.</span>
                    </div>

                    <div class="manager-info-item success">
                        <i class="fas fa-check-circle"></i>
                        <span>Kendi kurumunun bildirilerini, hakemlerini, kayıtlarını ve programını yönetebilir.</span>
                    </div>

                    <div class="manager-info-item danger">
                        <i class="fas fa-times-circle"></i>
                        <span>Başka kurumlara ait verilere erişemez.</span>
                    </div>

                    <div class="manager-info-item danger">
                        <i class="fas fa-times-circle"></i>
                        <span>Yeni kurum tanımlayamaz veya kurum silemez.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateAssignModeSections() {
            const selectedMode = document.querySelector('input[name="AssignmentMode"]:checked')?.value || "Existing";
            const existingUserSection = document.getElementById("existingUserSection");
            const newUserSection = document.getElementById("newUserSection");

            if (selectedMode === "Existing") {
                existingUserSection.classList.add("active");
                newUserSection.classList.remove("active");
            } else {
                existingUserSection.classList.remove("active");
                newUserSection.classList.add("active");
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const checkedMode = document.querySelector('input[name="AssignmentMode"]:checked');

            if (!checkedMode) {
                document.getElementById("modeExisting").checked = true;
            }

            updateAssignModeSections();

            document.querySelectorAll('input[name="AssignmentMode"]').forEach(function (radio) {
                radio.addEventListener("change", updateAssignModeSections);
            });
        });
    </script>
}
@model IEnumerable<AntAbstract.Domain.Entities.Tenant>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = L("PageTitle", "Kurum Yönetimi");
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var totalInstitutionCount = Model?.Count() ?? 0;
}

<div class="container-fluid">

    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                @L("PageTitle", "Kurum Yönetimi")
            </h2>

            <p class="text-muted mb-0">
                @L("PageLead", "Sistemdeki tüm alt kurumları ve kiracıları buradan yönetebilirsiniz.")
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Tenants"
           asp-action="Create"
           class="btn btn-primary shadow-sm px-4 rounded-pill">
            <i class="fas fa-plus me-2"></i>
            @L("AddInstitutionButton", "Yeni Kurum Ekle")
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="info-card">
                <div class="info-icon bg-primary-subtle text-primary">
                    <i class="fas fa-building"></i>
                </div>

                <div>
                    <div class="info-number">@totalInstitutionCount</div>
                    <div class="info-label">@L("TotalInstitutions", "Toplam Kurum")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                <div>
                    <h5 class="fw-bold mb-1">
                        @L("InstitutionListTitle", "Kurum Listesi")
                    </h5>

                    <p class="text-muted small mb-0">
                        @L("InstitutionListLead", "Bu listede sistemde kayıtlı tüm kurumlar görüntülenir.")
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted fw-bold small" style="width: 34%;">
                                @L("TableHeaderInstitutionName", "Kurum Adı")
                            </th>

                            <th class="py-3 text-muted fw-bold small">
                                @L("TableHeaderSlug", "URL Adresi")
                            </th>

                            <th class="py-3 text-muted fw-bold small text-center">
                                @L("TableHeaderStatus", "Durum")
                            </th>

                            <th class="pe-4 py-3 text-muted fw-bold small text-end">
                                @L("TableHeaderActions", "İşlemler")
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="fas fa-building"></i>
                                            </div>

                                            <div>
                                                <span class="fw-bold d-block text-dark">
                                                    @item.Name
                                                </span>

                                                <small class="text-muted" style="font-size: 0.72rem;">
                                                    @L("IdLabel", "ID:")
                                                    @item.Id.ToString().Substring(0, 8)...
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <code class="bg-light px-2 py-1 rounded text-primary fw-bold" style="font-size: 0.85rem;">
                                            /@item.Slug
                                        </code>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2" style="font-size: 0.75rem;">
                                            <i class="fas fa-check-circle me-1"></i>
                                            @L("StatusActive", "Aktif")
                                        </span>
                                    </td>

                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm shadow-sm rounded-3">

                                            <a asp-area="Admin"
                                               asp-controller="Tenants"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-white text-info border-end"
                                               title="@L("DetailsTitle", "Detay")">
                                                <i class="fas fa-search-plus"></i>
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Tenants"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-white text-warning border-end"
                                               title="@L("EditTitle", "Düzenle")">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Tenants"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-white text-danger"
                                               title="@L("DeleteTitle", "Sil")">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="fas fa-building fa-2x mb-3 opacity-25"></i>

                                    <h6 class="fw-bold mb-1">
                                        @L("EmptyTitle", "Henüz kurum bulunmuyor")
                                    </h6>

                                    <p class="mb-0">
                                        @L("EmptyMessage", "Sisteme kurum eklemek için Yeni Kurum Ekle butonunu kullanabilirsiniz.")
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .info-card {
        background-color: #fff;
        border-radius: 1rem;
        padding: 1.2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        border: 1px solid #f1f5f9;
    }

    .info-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .info-number {
        font-size: 1.8rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }

    .info-label {
        color: #64748b;
        font-weight: 700;
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .btn-white {
        background-color: #fff;
        border: 1px solid #f1f5f9;
        padding: 0.5rem 0.7rem;
        min-width: 42px;
    }

        .btn-white:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
            z-index: 2;
            transform: translateY(-1px);
        }

    .table thead th {
        font-size: 0.7rem;
        letter-spacing: 0.8px;
        border-bottom: none;
        text-transform: uppercase;
    }

    .table tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid #f8fafc;
    }

        .table tbody tr:hover {
            background-color: #fbfcfe !important;
            transform: scale(1.001);
        }

    .avatar-sm {
        width: 40px;
        height: 40px;
        min-width: 40px;
    }

        .avatar-sm i {
            font-size: 1rem;
        }
</style>
@model IEnumerable<AntAbstract.Domain.Entities.Tenant>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-dark">@Localizer["PageTitle"]</h4>
            <p class="text-muted small mb-0">@Localizer["PageLead"]</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
            <i class="fas fa-plus me-2"></i> @Localizer["AddInstitutionButton"]
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-muted fw-bold small" style="width: 35%;">@Localizer["TableHeaderInstitutionName"]</th>
                            <th class="py-3 text-muted fw-bold small">@Localizer["TableHeaderSlug"]</th>
                            <th class="py-3 text-muted fw-bold small text-center">@Localizer["TableHeaderStatus"]</th>
                            <th class="pe-4 py-3 text-muted fw-bold small text-end">@Localizer["TableHeaderActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-3 bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; min-width: 40px;">
                                                <i class="fas fa-building"></i>
                                            </div>
                                            <div>
                                                <span class="fw-bold d-block text-dark">@item.Name</span>
                                                <small class="text-muted" style="font-size: 0.7rem;">@Localizer["IdLabel"] @item.Id.ToString().Substring(0, 8)...</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <code class="bg-light px-2 py-1 rounded text-primary fw-bold" style="font-size: 0.85rem;">/@item.Slug</code>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2" style="font-size: 0.75rem;">
                                            <i class="fas fa-check-circle me-1"></i> @Localizer["StatusActive"]
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm shadow-sm rounded-3">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white text-info border-end" title="@Localizer["DetailsTitle"]">
                                                <i class="fas fa-search-plus"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white text-warning border-end" title="@Localizer["EditTitle"]">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-white text-danger" title="@Localizer["DeleteTitle"]">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">@Localizer["EmptyMessage"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-white {
        background-color: #fff;
        border: 1px solid #f1f5f9;
        padding: 0.5rem 0.7rem;
    }

        .btn-white:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
            z-index: 2;
        }

    .table thead th {
        font-size: 0.7rem;
        letter-spacing: 0.8px;
        border-bottom: none;
    }

    .table tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid #f8fafc;
    }

        .table tbody tr:hover {
            background-color: #fbfcfe !important;
            transform: scale(1.001);
        }

    .avatar-sm i {
        font-size: 1rem;
    }
</style>
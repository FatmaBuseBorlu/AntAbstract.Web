@model IEnumerable<AntAbstract.Domain.Entities.Tenant>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = "Müşteri (Kurum) Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="max-width: 1200px; margin-top: 32px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Localizer["PageTitle"]</h2>
            <div class="text-muted">Sistemi kiralayan tüm kurumları (Tenant) buradan yönetebilirsiniz.</div>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm" style="border-radius: 8px;">
            <i class="fas fa-plus me-2"></i> @Localizer["CreateNewButton"]
        </a>
    </div>

    <div class="card shadow-sm" style="border-radius:16px; border:none;">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["TableHeaderName"]</th>
                            <th>@Localizer["TableHeaderField"]</th>
                            <th>@Localizer["TableHeaderType"]</th>
                            <th class="text-end" style="width: 28%;">@Localizer["TableHeaderActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@item.Name</div>
                                    <div class="text-muted small">
                                        <i class="fas fa-link me-1"></i> /@item.Slug
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                        @(item.ScientificField?.Name ?? "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info border">
                                        @(item.CongressType?.Name ?? "-")
                                    </span>
                                </td>
                                <td class="text-end">

                                    <a asp-action="AssignManager" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success me-1" title="Kurum Yöneticisi Ata">
                                        <i class="fas fa-user-tie"></i> Yönetici Ata
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white" title="@Localizer["EditButton"]">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="@Localizer["DetailsButton"]">
                                        <i class="fas fa-search"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger text-white" title="@Localizer["DeleteButton"]">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-building fs-1 mb-3 opacity-50"></i>
                    <h5>Henüz hiç kurum eklenmemiş</h5>
                    <p>Sistemi kiralayacak ilk müşterinizi eklemek için yukarıdaki butonu kullanın.</p>
                </div>
            }

        </div>
    </div>
</div>
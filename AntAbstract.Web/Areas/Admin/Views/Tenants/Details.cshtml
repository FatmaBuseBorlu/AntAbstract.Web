@model AntAbstract.Domain.Entities.Tenant

@{
    ViewData["Title"] = "Kurum Detayları";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/Admin/Tenants" class="text-decoration-none">Kurumlar</a></li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>
            <h4 class="mb-0 fw-bold text-dark">🏢 @Model.Name</h4>
        </div>
        <a href="/Admin/Tenants" class="btn btn-light border shadow-sm px-3">
            <i class="fas fa-arrow-left me-2"></i> Listeye Dön
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-xl-5 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-info-circle me-2 text-primary"></i> Kurum Bilgileri</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="small text-muted d-block fw-bold">KURUM ADI</label>
                        <span class="fw-bold text-dark fs-5">@Model.Name</span>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted d-block fw-bold">URL ADRESİ (SLUG)</label>
                        <code class="text-primary fw-bold px-2 py-1 bg-light rounded fs-6">/@Model.Slug</code>
                    </div>
                    <div class="mb-4">
                        <label class="small text-muted d-block fw-bold">SİSTEM ID</label>
                        <small class="text-secondary">@Model.Id</small>
                    </div>

                    <div class="d-grid mt-auto pt-3 border-top">
                        <a href="/Admin/Tenants/Edit/@Model.Id" class="btn btn-outline-warning rounded-3 fw-bold py-2">
                            <i class="fas fa-edit me-1"></i> Bilgileri Düzenle
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-7 mb-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-primary bg-opacity-10 border-start border-primary border-4">
                <div class="card-body p-4 p-md-5 d-flex flex-column justify-content-center align-items-center text-center">

                    <div class="bg-white p-4 rounded-circle shadow-sm mb-4">
                        <i class="fas fa-calendar-plus fa-3x text-primary"></i>
                    </div>

                    <h3 class="fw-bold text-dark mb-3">Yeni Kongre Başlat</h3>
                    <p class="text-muted mb-4" style="max-width: 400px;">
                        Bu kuruma (müşteriye) ait yeni bir kongre veya etkinlik oluşturmak için aşağıdaki butonu kullanabilirsiniz.
                    </p>

                    <a href="/Admin/Tenants/AddConference/@Model.Id" class="btn btn-primary btn-lg rounded-pill shadow px-5 py-3 fw-bold">
                        <i class="fas fa-plus me-2"></i> Bu Kuruma Kongre Ekle
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .breadcrumb-item {
        font-size: 0.85rem;
        font-weight: 600;
    }

    .card-header {
        background-color: transparent !important;
    }

    .btn-primary {
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 174, 239, 0.3) !important;
        }
</style>
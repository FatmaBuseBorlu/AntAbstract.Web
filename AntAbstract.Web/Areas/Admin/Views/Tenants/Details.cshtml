@model AntAbstract.Domain.Entities.Tenant
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<h1 class="display-5">@Localizer["PageTitle"]</h1>
<h4 class="text-muted fw-light">@Model.Name</h4>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-3 fw-bold">
            @Localizer["NameLabel"]
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class="col-sm-3 fw-bold">
            @Localizer["SlugLabel"]
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Slug)
        </dd>
        <dt class="col-sm-3 fw-bold">
            @Localizer["FieldLabel"]
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ScientificField.Name)
        </dd>
        <dt class="col-sm-3 fw-bold">
            @Localizer["TypeLabel"]
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CongressType.Name)
        </dd>
        <dt class="col-sm-3 fw-bold">
            @Localizer["ThemeLabel"]
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ThemeJson)
        </dd>
    </dl>
</div>

<div class="mt-4 pt-3 border-top">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm fw-bold">
        <i class="fas fa-edit me-1"></i> @Localizer["EditLink"]
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary fw-bold ms-2">
        <i class="fas fa-arrow-left me-1"></i> @Localizer["BackToListLink"]
    </a>

    <a href="/Admin/Tenants/AddConference/@Model.Id" class="btn btn-success fw-bold shadow-sm ms-2 float-md-end">
        <i class="fas fa-plus-circle me-1"></i> Bu Kuruma Yeni Kongre Ekle
    </a>
</div>
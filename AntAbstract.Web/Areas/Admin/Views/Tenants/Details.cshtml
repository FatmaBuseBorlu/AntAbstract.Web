@model AntAbstract.Domain.Entities.Tenant
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }
}

<div class="container-fluid tenant-details-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="@L("CloseLabel", "Kapat")">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="@L("CloseLabel", "Kapat")">
            </button>
        </div>
    }

    <div class="details-page-header d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin"
                           asp-controller="Tenants"
                           asp-action="Index"
                           class="text-decoration-none">
                            @L("BreadcrumbInstitutions", "Kurumlar")
                        </a>
                    </li>

                    <li class="breadcrumb-item active" aria-current="page">
                        @Model.Name
                    </li>
                </ol>
            </nav>

            <div class="page-title-wrap d-flex align-items-start gap-3">
                <div class="page-title-icon">
                    <i class="fas fa-building"></i>
                </div>

                <div>
                    <h1 class="page-title mb-1">
                        @Model.Name
                    </h1>

                    <p class="page-subtitle mb-0">
                        @L("PageLead", "Bu kurumun temel bilgilerini buradan görüntüleyebilir ve düzenleyebilirsiniz.")
                    </p>
                </div>
            </div>
        </div>

        <a asp-area="Admin"
           asp-controller="Tenants"
           asp-action="Index"
           class="btn btn-light border shadow-sm rounded-pill px-4 py-2 fw-bold back-btn">
            <i class="fas fa-arrow-left me-2"></i>
            @L("BackToListButton", "Kurum Listesine Dön")
        </a>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-xl-7 col-lg-9">
            <div class="modern-card info-card h-100">
                <div class="modern-card-header">
                    <div class="modern-card-icon soft-primary">
                        <i class="fas fa-building"></i>
                    </div>

                    <div>
                        <h5 class="modern-card-title mb-1">
                            @L("InfoCardTitle", "Kurum Bilgileri")
                        </h5>

                        <p class="modern-card-text mb-0">
                            @L("InfoCardLead", "Bu kurumun temel sistem bilgileri.")
                        </p>
                    </div>
                </div>

                <div class="modern-card-body">
                    <div class="info-box">
                        <div class="info-box-icon soft-orange">
                            <i class="fas fa-signature"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @L("NameLabel", "Kurum Adı")
                            </div>

                            <div class="info-value">
                                @Model.Name
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-box-icon soft-blue">
                            <i class="fas fa-link"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @L("SlugLabel", "URL Adresi")
                            </div>

                            <div class="info-value">
                                <span class="slug-badge">
                                    /@Model.Slug
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-box-icon soft-gray">
                            <i class="fas fa-fingerprint"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @L("SystemIdLabel", "Sistem ID")
                            </div>

                            <div class="info-value system-id">
                                @Model.Id
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modern-card-footer">
                    <a asp-area="Admin"
                       asp-controller="Tenants"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn edit-btn rounded-pill fw-bold w-100">
                        <i class="fas fa-pen-to-square me-2"></i>
                        @L("EditButton", "Bilgileri Düzenle")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tenant-details-page {
        padding-bottom: 1rem;
    }

    .breadcrumb-item {
        font-size: 0.86rem;
        font-weight: 700;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        color: #94a3b8;
    }

    .breadcrumb-item a {
        color: #2563eb;
    }

    .page-title-wrap {
        max-width: 950px;
    }

    .page-title-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
        font-size: 1.25rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
    }

    .page-title {
        color: #0f172a;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 950;
        letter-spacing: -0.04em;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.75;
        font-weight: 600;
    }

    .back-btn {
        white-space: nowrap;
        transition: all 0.25s ease;
    }

    .back-btn:hover {
        transform: translateY(-2px);
        background: #f8fafc;
    }

    .modern-card {
        background: #ffffff;
        border: 1px solid #dbeafe;
        border-radius: 30px;
        box-shadow: 0 22px 60px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    .modern-card-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1.85rem 1.85rem 1.45rem 1.85rem;
    }

    .modern-card-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .modern-card-icon.soft-primary {
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
    }

    .modern-card-title {
        color: #0f172a;
        font-weight: 950;
        letter-spacing: -0.03em;
        font-size: 1.25rem;
    }

    .modern-card-text {
        color: #64748b;
        line-height: 1.65;
        font-weight: 600;
    }

    .modern-card-body {
        padding: 0 1.85rem 1.4rem 1.85rem;
        display: grid;
        gap: 1rem;
    }

    .modern-card-footer {
        padding: 1.4rem 1.85rem 1.85rem 1.85rem;
        border-top: 1px solid #e2e8f0;
    }

    .info-box {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.15rem;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: #f8fafc;
    }

    .info-box-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .info-box-icon.soft-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .info-box-icon.soft-blue {
        background: rgba(37, 99, 235, 0.10);
        color: #2563eb;
    }

    .info-box-icon.soft-gray {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
    }

    .info-box-content {
        min-width: 0;
    }

    .info-label {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.35rem;
    }

    .info-value {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        line-height: 1.45;
        word-break: break-word;
    }

    .slug-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.42rem 0.72rem;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        font-weight: 950;
    }

    .system-id {
        color: #64748b;
        font-size: 0.92rem;
        word-break: break-all;
    }

    .edit-btn {
        min-height: 52px;
        border: 2px solid #f59e0b;
        color: #f59e0b;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
    }

    .edit-btn:hover {
        color: #ffffff;
        background: #f59e0b;
        transform: translateY(-2px);
        box-shadow: 0 16px 30px rgba(245, 158, 11, 0.22);
    }

    @@media (max-width: 991.98px) {
        .modern-card-header {
            padding: 1.4rem 1.4rem 1.1rem 1.4rem;
        }

        .modern-card-body {
            padding-left: 1.4rem;
            padding-right: 1.4rem;
        }

        .modern-card-footer {
            padding-left: 1.4rem;
            padding-right: 1.4rem;
        }
    }

    @@media (max-width: 575.98px) {
        .page-title-wrap {
            flex-direction: column;
        }

        .info-box {
            align-items: flex-start;
        }
    }
</style>
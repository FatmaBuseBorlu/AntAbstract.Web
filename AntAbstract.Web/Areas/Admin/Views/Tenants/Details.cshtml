@model AntAbstract.Web.Models.ViewModels.Admin.Tenants.TenantDetailViewModel

@{
    var tenant = Model!;

    ViewData["Title"] = string.IsNullOrWhiteSpace(tenant.Name)
        ? Localizer.GetString("PageTitle").Value
        : $"{tenant.Name} - {Localizer.GetString("PageTitle").Value}";

    Layout = "_LayoutDashboard";
}

@functions {
    private string GetRoleLabel(string role)
    {
        return role switch
        {
            "SuperAdmin" => Localizer.GetString("RoleSuperAdmin").Value,
            "Admin" => "Admin",
            "Author" => Localizer.GetString("RoleAuthor").Value,
            "Listener" => Localizer.GetString("RoleListener").Value,
            "Referee" => Localizer.GetString("RoleReferee").Value,
            _ => role
        };
    }

    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "SuperAdmin" => "bg-dark text-white",
            "Admin" => "bg-danger bg-opacity-10 text-danger",
            "Author" => "bg-primary bg-opacity-10 text-primary",
            "Listener" => "bg-info bg-opacity-10 text-info",
            "Referee" => "bg-warning bg-opacity-10 text-warning",
            _ => "bg-secondary bg-opacity-10 text-secondary"
        };
    }
}

<div class="container-fluid tenant-details-page">

    <div class="details-page-header d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin"
                           asp-controller="Tenants"
                           asp-action="Index"
                           class="text-decoration-none">
                            @Localizer["BreadcrumbInstitutions"]
                        </a>
                    </li>

                    <li class="breadcrumb-item active" aria-current="page">
                        @(tenant.Name ?? "")
                    </li>
                </ol>
            </nav>

            <div class="page-title-wrap d-flex align-items-start gap-3">
                <div class="page-title-icon">
                    <i class="fas fa-building"></i>
                </div>

                <div>
                    <div class="text-uppercase text-muted fw-bold small mb-1">
                        @Localizer["GlobalSystem"]
                    </div>

                    <h1 class="page-title mb-1">
                        @(tenant.Name ?? "")
                    </h1>

                    <p class="page-subtitle mb-0">
                        @Localizer["PageSubtitle"]
                    </p>
                </div>
            </div>
        </div>

        <div class="details-header-actions">
            <a asp-area="Admin"
               asp-controller="Tenants"
               asp-action="Index"
               class="btn btn-light border shadow-sm rounded-pill px-4 py-2 fw-bold">
                <i class="fas fa-arrow-left me-2"></i>
                @Localizer["BackToListButton"]
            </a>

            <a asp-area="Admin"
               asp-controller="Tenants"
               asp-action="Edit"
               asp-route-id="@Model?.Id"
               class="btn btn-warning rounded-pill px-4 py-2 fw-bold text-white">
                <i class="fas fa-pen-to-square me-2"></i>
                @Localizer["EditButton"]
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="summary-card">
                <div class="summary-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-building"></i>
                </div>

                <div>
                    <div class="summary-title">
                        @Localizer["InstitutionStatus"]
                    </div>

                    <div class="summary-value">
                        @Localizer["Active"]
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="summary-card">
                <div class="summary-icon bg-success bg-opacity-10 text-success">
                    <i class="fas fa-user-shield"></i>
                </div>

                <div>
                    <div class="summary-title">
                        @Localizer["InstitutionAdmin"]
                    </div>

                    <div class="summary-value">
                        @tenant.AdminCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="summary-card">
                <div class="summary-icon bg-info bg-opacity-10 text-info">
                    <i class="fas fa-calendar-alt"></i>
                </div>

                <div>
                    <div class="summary-title">
                        @Localizer["LinkedConference"]
                    </div>

                    <div class="summary-value">
                        @tenant.ConferenceCount
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="summary-card">
                <div class="summary-icon bg-warning bg-opacity-10 text-warning">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <div class="summary-title">
                        @Localizer["LinkedUser"]
                    </div>

                    <div class="summary-value">
                        @tenant.UserCount
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-xl-7">
            <div class="modern-card h-100">
                <div class="modern-card-header">
                    <div class="modern-card-icon soft-primary">
                        <i class="fas fa-circle-info"></i>
                    </div>

                    <div>
                        <h5 class="modern-card-title mb-1">
                            @Localizer["InfoCardTitle"]
                        </h5>

                        <p class="modern-card-text mb-0">
                            @Localizer["InfoCardSubtitle"]
                        </p>
                    </div>
                </div>

                <div class="modern-card-body">
                    <div class="info-box">
                        <div class="info-box-icon soft-orange">
                            <i class="fas fa-signature"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @Localizer["NameLabel"]
                            </div>

                            <div class="info-value">
                                @tenant.Name
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-box-icon soft-blue">
                            <i class="fas fa-link"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @Localizer["UrlAddressLabel"]
                            </div>

                            <div class="info-value">
                                @if (!string.IsNullOrWhiteSpace(tenant.Slug))
                                {
                                    <a href="@tenant.PublicSiteUrl"
                                       target="_blank"
                                       class="slug-badge text-decoration-none">
                                        @tenant.SlugPath
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        @Localizer["SlugNotDefined"]
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-box-icon soft-green">
                            <i class="fas fa-flask"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @Localizer["ScientificField"]
                            </div>

                            <div class="info-value">
                                @(tenant.ScientificFieldName ?? Localizer.GetString("NotDefined").Value)
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-box-icon soft-purple">
                            <i class="fas fa-tag"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @Localizer["CongressType"]
                            </div>

                            <div class="info-value">
                                @(tenant.CongressTypeName ?? Localizer.GetString("NotDefined").Value)
                            </div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-box-icon soft-gray">
                            <i class="fas fa-fingerprint"></i>
                        </div>

                        <div class="info-box-content">
                            <div class="info-label">
                                @Localizer["SystemIdLabel"]
                            </div>

                            <div class="info-value system-id">
                                @tenant.Id
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="modern-card h-100">
                <div class="modern-card-header">
                    <div class="modern-card-icon soft-success">
                        <i class="fas fa-bolt"></i>
                    </div>

                    <div>
                        <h5 class="modern-card-title mb-1">
                            @Localizer["QuickActions"]
                        </h5>

                        <p class="modern-card-text mb-0">
                            @Localizer["QuickActionsSubtitle"]
                        </p>
                    </div>
                </div>

                <div class="modern-card-body">

                    <a asp-area="Admin"
                       asp-controller="Tenants"
                       asp-action="AssignManager"
                       asp-route-id="@tenant.Id"
                       asp-route-returnUrl="@tenant.AssignManagerReturnUrl"
                       class="quick-action-card text-decoration-none">
                        <div class="quick-action-icon soft-success">
                            <i class="fas fa-user-shield"></i>
                        </div>

                        <div class="quick-action-content">
                            <div class="quick-action-title">
                                @Localizer["AssignManagerAction"]
                            </div>

                            <div class="quick-action-desc">
                                @Localizer["AssignManagerDesc"]
                            </div>
                        </div>

                        <i class="fas fa-arrow-right quick-action-arrow"></i>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Tenants"
                       asp-action="AssignUser"
                       asp-route-id="@tenant.Id"
                       asp-route-returnUrl="@tenant.AssignManagerReturnUrl"
                       class="quick-action-card text-decoration-none">
                        <div class="quick-action-icon soft-user">
                            <i class="fas fa-user-plus"></i>
                        </div>

                        <div class="quick-action-content">
                            <div class="quick-action-title">
                                @Localizer["AssignUserAction"]
                            </div>

                            <div class="quick-action-desc">
                                @Localizer["AssignUserDesc"]
                            </div>
                        </div>

                        <i class="fas fa-arrow-right quick-action-arrow"></i>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="Tenants"
                       asp-action="Edit"
                       asp-route-id="@tenant.Id"
                       class="quick-action-card text-decoration-none">
                        <div class="quick-action-icon soft-warning">
                            <i class="fas fa-pen-to-square"></i>
                        </div>

                        <div class="quick-action-content">
                            <div class="quick-action-title">
                                @Localizer["EditInfoAction"]
                            </div>

                            <div class="quick-action-desc">
                                @Localizer["EditInfoDesc"]
                            </div>
                        </div>

                        <i class="fas fa-arrow-right quick-action-arrow"></i>
                    </a>

                    @if (!string.IsNullOrWhiteSpace(tenant.Slug))
                    {
                        <a href="@tenant.PublicSiteUrl"
                           target="_blank"
                           class="quick-action-card text-decoration-none">
                            <div class="quick-action-icon soft-blue">
                                <i class="fas fa-external-link-alt"></i>
                            </div>

                            <div class="quick-action-content">
                                <div class="quick-action-title">
                                    @Localizer["ViewSiteAction"]
                                </div>

                                <div class="quick-action-desc">
                                    @Localizer["ViewSiteDesc"]
                                </div>
                            </div>

                            <i class="fas fa-arrow-right quick-action-arrow"></i>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(tenant.ConferenceFlowUrl))
                    {
                        <a href="@tenant.ConferenceFlowUrl"
                           class="quick-action-card text-decoration-none">
                            <div class="quick-action-icon soft-primary">
                                <i class="fas fa-stream"></i>
                            </div>

                            <div class="quick-action-content">
                                <div class="quick-action-title">
                                    @Localizer["GoToConferenceFlow"]
                                </div>

                                <div class="quick-action-desc">
                                    @Localizer["GoToConferenceFlowDesc"]
                                </div>
                            </div>

                            <i class="fas fa-arrow-right quick-action-arrow"></i>
                        </a>
                    }
                    else
                    {
                        <div class="quick-action-card disabled-action">
                            <div class="quick-action-icon soft-gray">
                                <i class="fas fa-stream"></i>
                            </div>

                            <div class="quick-action-content">
                                <div class="quick-action-title">
                                    @Localizer["NoConferenceFlow"]
                                </div>

                                <div class="quick-action-desc">
                                    @Localizer["NoConferenceFlowDesc"]
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-xl-6">
            <div class="modern-card h-100">
                <div class="modern-card-header">
                    <div class="modern-card-icon soft-success">
                        <i class="fas fa-user-shield"></i>
                    </div>

                    <div>
                        <h5 class="modern-card-title mb-1">
                            @Localizer["InstitutionAdmins"]
                        </h5>

                        <p class="modern-card-text mb-0">
                            @Localizer["InstitutionAdminsSubtitle"]
                        </p>
                    </div>
                </div>

                <div class="modern-card-body">
                    @if (tenant.Admins != null && tenant.Admins.Any())
                    {
                        <div class="simple-list">
                            @foreach (var admin in tenant.Admins)
                            {
                                <div class="simple-list-item">
                                    <div class="list-avatar bg-success bg-opacity-10 text-success">
                                        @admin.DisplayName.Substring(0, 1).ToUpper()
                                    </div>

                                    <div class="list-content">
                                        <div class="list-title">
                                            @admin.DisplayName
                                        </div>

                                        <div class="list-subtitle">
                                            @(admin.Email ?? "-")
                                        </div>
                                    </div>

                                    <span class="role-badge bg-danger bg-opacity-10 text-danger">
                                        Admin
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            <i class="fas fa-user-shield"></i>

                            <h6>
                                @Localizer["NoAdminAssigned"]
                            </h6>

                            <p>
                                @Localizer["NoAdminAssignedDesc"]
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Tenants"
                               asp-action="AssignManager"
                               asp-route-id="@tenant.Id"
                               asp-route-returnUrl="@tenant.AssignManagerReturnUrl"
                               class="btn btn-sm btn-success rounded-pill px-3 fw-bold">
                                <i class="fas fa-user-plus me-1"></i>
                                @Localizer["AssignAdminButton"]
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="modern-card h-100">
                <div class="modern-card-header">
                    <div class="modern-card-icon soft-primary">
                        <i class="fas fa-calendar-alt"></i>
                    </div>

                    <div>
                        <h5 class="modern-card-title mb-1">
                            @Localizer["LinkedConferences"]
                        </h5>

                        <p class="modern-card-text mb-0">
                            @Localizer["LinkedConferencesSubtitle"]
                        </p>
                    </div>

                    <a href="/@tenant.Slug/Admin/Conferences/Create" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i> @Localizer["AddConferenceButton"]
                    </a>
                </div>

                <div class="modern-card-body">
                    @if (tenant.Conferences != null && tenant.Conferences.Any())
                    {
                        <div class="simple-list">
                            @foreach (var conference in tenant.Conferences)
                            {
                                <div class="simple-list-item">
                                    <div class="list-avatar bg-primary bg-opacity-10 text-primary">
                                        <i class="fas fa-calendar-alt"></i>
                                    </div>

                                    <div class="list-content">
                                        <div class="list-title">
                                            @conference.Title
                                        </div>

                                        <div class="list-subtitle">
                                            @conference.SlugPath
                                            @if (conference.StartDate.HasValue)
                                            {
                                                <span>
                                                    • @conference.StartDate.Value.ToString("dd.MM.yyyy")
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <span class="role-badge bg-success bg-opacity-10 text-success">
                                        @conference.StatusText
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            <i class="fas fa-calendar-alt"></i>

                            <h6>
                                @Localizer["NoConference"]
                            </h6>

                            <p>
                                @Localizer["NoConferenceDesc"]
                            </p>

                            <a href="/@tenant.Slug/Admin/Conferences/Create" class="btn btn-sm btn-primary mt-2">
                                <i class="fas fa-plus me-1"></i> @Localizer["AddFirstConference"]
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="modern-card">
        <div class="modern-card-header users-card-header">
            <div class="modern-card-header-left">
                <div class="modern-card-icon soft-warning">
                    <i class="fas fa-users"></i>
                </div>

                <div>
                    <h5 class="modern-card-title mb-1">
                        @Localizer["LinkedUsers"]
                    </h5>

                    <p class="modern-card-text mb-0">
                        @Localizer["LinkedUsersSubtitle"]
                    </p>
                </div>
            </div>

            <a asp-area="Admin"
               asp-controller="Tenants"
               asp-action="AssignUser"
               asp-route-id="@tenant.Id"
               asp-route-returnUrl="@tenant.AssignManagerReturnUrl"
               class="btn btn-primary rounded-pill px-4 fw-bold add-user-btn">
                <i class="fas fa-user-plus me-2"></i>
                @Localizer["AssignUserAction"]
            </a>
        </div>

        <div class="modern-card-body">
            @if (tenant.Users != null && tenant.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 users-table">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3 text-muted fw-bold small">
                                    @Localizer["UserTableHeader"]
                                </th>

                                <th class="py-3 text-muted fw-bold small">
                                    @Localizer["EmailTableHeader"]
                                </th>

                                <th class="py-3 text-muted fw-bold small">
                                    @Localizer["RolesTableHeader"]
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in tenant.Users)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="table-avatar me-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold">
                                                @user.DisplayName.Substring(0, 1).ToUpper()
                                            </div>

                                            <div>
                                                <span class="fw-bold d-block text-dark">
                                                    @user.DisplayName
                                                </span>

                                                <small class="text-muted">
                                                    ID: @user.UserId.Substring(0, 8)...
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @(user.Email ?? "-")
                                        </span>
                                    </td>

                                    <td>
                                        @if (user.Roles != null && user.Roles.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var role in user.Roles)
                                                {
                                                    <span class="role-badge @GetRoleBadgeClass(role)">
                                                        @GetRoleLabel(role)
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                @Localizer["NoRole"]
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="fas fa-users"></i>

                    <h6>
                        @Localizer["NoUser"]
                    </h6>

                    <p class="mb-3">
                        @Localizer["NoUserDesc"]
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Tenants"
                       asp-action="AssignUser"
                       asp-route-id="@tenant.Id"
                       asp-route-returnUrl="@tenant.AssignManagerReturnUrl"
                       class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                        <i class="fas fa-user-plus me-1"></i>
                        @Localizer["AssignUserAction"]
                    </a>
                </div>
            }
        </div>
    </div>

</div>

<style>
    .tenant-details-page {
        padding-bottom: 1rem;
    }

    .breadcrumb-item {
        font-size: 0.86rem;
        font-weight: 700;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        color: #94a3b8;
    }

    .breadcrumb-item a {
        color: #2563eb;
    }

    .details-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .page-title-wrap {
        max-width: 950px;
    }

    .page-title-icon {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
        font-size: 1.25rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
    }

    .page-title {
        color: #0f172a;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
        font-weight: 950;
        letter-spacing: -0.04em;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.75;
        font-weight: 600;
    }

    .summary-card {
        background-color: #ffffff;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        border: 1px solid #f1f5f9;
        min-height: 95px;
    }

    .summary-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .summary-title {
        color: #64748b;
        font-weight: 800;
        font-size: 0.75rem;
        margin-bottom: 0.2rem;
    }

    .summary-value {
        color: #0f172a;
        font-weight: 900;
        font-size: 1rem;
        line-height: 1.25;
    }

    .modern-card {
        background: #ffffff;
        border: 1px solid #dbeafe;
        border-radius: 30px;
        box-shadow: 0 22px 60px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    .modern-card-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1.85rem 1.85rem 1.45rem 1.85rem;
    }

    .modern-card-header.users-card-header {
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .modern-card-header-left {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .modern-card-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .modern-card-icon.soft-primary {
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
    }

    .modern-card-icon.soft-success {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
    }

    .modern-card-icon.soft-warning {
        background: rgba(245, 158, 11, 0.12);

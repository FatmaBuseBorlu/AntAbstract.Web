@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.WebUtilities
@using System
@using System.Linq

@model AntAbstract.Web.Models.ViewModels.Admin.Tenants.TenantAssignUserViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewBag.Slug as string
               ?? ViewContext.RouteData.Values["slug"]?.ToString()
               ?? Context.Session.GetString("SelectedConferenceSlug")
               ?? "";

    var rawReturnUrl = Model.ReturnUrl ?? "";

    if (string.IsNullOrWhiteSpace(slug) && !string.IsNullOrWhiteSpace(rawReturnUrl))
    {
        var pathPart = rawReturnUrl.Split('?')[0].Trim('/');
        var segments = pathPart.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segments.Length > 1 &&
            !string.Equals(segments[0], "Admin", StringComparison.OrdinalIgnoreCase))
        {
            slug = segments[0];
        }
    }

    var conferenceId = Guid.Empty;

    if (!string.IsNullOrWhiteSpace(rawReturnUrl))
    {
        var queryStartIndex = rawReturnUrl.IndexOf("?", StringComparison.Ordinal);

        if (queryStartIndex >= 0)
        {
            var queryString = rawReturnUrl.Substring(queryStartIndex);
            var parsedQuery = QueryHelpers.ParseQuery(queryString);

            if (parsedQuery.TryGetValue("conferenceId", out var conferenceIdValues))
            {
                Guid.TryParse(conferenceIdValues.FirstOrDefault(), out conferenceId);
            }
        }
    }

    if (conferenceId == Guid.Empty)
    {
        var selectedConferenceIdFromSession = Context.Session.GetString("SelectedConferenceId");

        if (!string.IsNullOrWhiteSpace(selectedConferenceIdFromSession))
        {
            Guid.TryParse(selectedConferenceIdFromSession, out conferenceId);
        }
    }

    var normalizedReturnUrl = rawReturnUrl.ToLowerInvariant();

    var backUrl = !string.IsNullOrWhiteSpace(rawReturnUrl)
        ? rawReturnUrl
        : Url.Action("Details", "Tenants", new { area = "Admin", id = Model.TenantId });

    var backButtonText = Localizer.GetString("GoBack").Value;
    var backButtonIcon = "fas fa-arrow-left";

    if (normalizedReturnUrl.Contains("conferenceflow"))
    {
        backButtonText = Localizer.GetString("BackToConferenceFlow").Value;
        backButtonIcon = "fas fa-stream";

        backUrl = conferenceId != Guid.Empty
            ? string.IsNullOrWhiteSpace(slug)
                ? $"/Admin/ConferenceFlow?conferenceId={conferenceId}"
                : $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceId}"
            : string.IsNullOrWhiteSpace(slug)
                ? "/Admin/ConferenceFlow"
                : $"/{slug}/Admin/ConferenceFlow";
    }
    else if (normalizedReturnUrl.Contains("/tenants/details"))
    {
        backButtonText = Localizer.GetString("BackToTenantDetails").Value;
        backButtonIcon = "fas fa-building";
    }
    else if (normalizedReturnUrl.Contains("/tenants"))
    {
        backButtonText = Localizer.GetString("BackToTenantList").Value;
        backButtonIcon = "fas fa-list";
    }
    else if (normalizedReturnUrl.Contains("/referee"))
    {
        backButtonText = Localizer.GetString("BackToRefereePool").Value;
        backButtonIcon = "fas fa-user-tie";
    }

    var currentAssignmentMode = string.IsNullOrWhiteSpace(Model.AssignmentMode)
        ? "Existing"
        : Model.AssignmentMode;

    var existingSectionClass = string.Equals(
        currentAssignmentMode,
        "Existing",
        StringComparison.OrdinalIgnoreCase)
            ? "tenant-user-form-section active"
            : "tenant-user-form-section";

    var newSectionClass = string.Equals(
        currentAssignmentMode,
        "New",
        StringComparison.OrdinalIgnoreCase)
            ? "tenant-user-form-section active"
            : "tenant-user-form-section";
}

<style>
    .tenant-user-page {
        padding: 1rem 0 3rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .tenant-user-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .tenant-user-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.04em;
        margin-bottom: 0.25rem;
    }

    .tenant-user-lead {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0;
        line-height: 1.65;
    }

    .tenant-user-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.8fr);
        gap: 1.25rem;
        align-items: start;
    }

    .tenant-user-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.055);
        overflow: hidden;
    }

    .tenant-user-card-body {
        padding: 1.35rem;
    }

    .assign-mode-box {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .assign-mode-option {
        position: relative;
    }

    .assign-mode-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .assign-mode-label {
        height: 100%;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 18px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .assign-mode-label:hover {
        border-color: rgba(0, 174, 239, 0.35);
        background: #f0f9ff;
    }

    .assign-mode-option input:checked + .assign-mode-label {
        background: rgba(0, 174, 239, 0.08);
        border-color: rgba(0, 174, 239, 0.45);
        box-shadow: 0 12px 26px rgba(0, 174, 239, 0.10);
    }

    .assign-mode-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .assign-mode-title {
        display: block;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 900;
        margin-bottom: 0.18rem;
    }

    .assign-mode-desc {
        display: block;
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 600;
        line-height: 1.45;
    }

    .tenant-user-form-section {
        display: none;
    }

    .tenant-user-form-section.active {
        display: block;
    }

    .tenant-user-label {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.45rem;
    }

    .tenant-user-form-control {
        min-height: 46px;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        font-weight: 700;
        color: #0f172a;
    }

    .tenant-user-form-control:focus {
        border-color: #00aeef;
        box-shadow: 0 0 0 0.18rem rgba(0, 174, 239, 0.12);
    }

    .tenant-user-help {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
        margin-top: 0.45rem;
        line-height: 1.55;
    }

    .tenant-user-submit-btn {
        width: 100%;
        min-height: 50px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.18);
        transition: all 0.2s ease;
    }

    .tenant-user-submit-btn:hover {
        transform: translateY(-1px);
        color: #ffffff;
        box-shadow: 0 18px 36px rgba(13, 110, 253, 0.24);
    }

    .tenant-user-info-card {
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.11), rgba(255, 255, 255, 0.92));
        border-left: 4px solid #0d6efd;
    }

    .tenant-user-info-icon {
        width: 56px;
        height: 56px;
        border-radius: 999px;
        background: #ffffff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
        margin-bottom: 0.85rem;
    }

    .tenant-user-info-title {
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 900;
        margin-bottom: 0.75rem;
    }

    .tenant-user-info-list {
        display: grid;
        gap: 0.7rem;
        margin-top: 1rem;
    }

    .tenant-user-info-item {
        display: flex;
        gap: 0.65rem;
        align-items: flex-start;
        color: #0f172a;
        font-size: 0.84rem;
        font-weight: 600;
        line-height: 1.55;
    }

    .tenant-user-info-item i {
        margin-top: 0.15rem;
        width: 18px;
        text-align: center;
    }

    .tenant-user-info-item.success i {
        color: #198754;
    }

    .tenant-user-info-item.warning i {
        color: #f59e0b;
    }

    .tenant-user-info-item.danger i {
        color: #ef4444;
    }

    .validation-summary-errors {
        border-radius: 14px;
        background: #fef2f2;
        color: #b91c1c;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
        font-weight: 700;
    }

    .field-validation-error {
        color: #dc2626;
        font-size: 0.78rem;
        font-weight: 700;
        margin-top: 0.35rem;
        display: block;
    }

    @@media (max-width: 992px) {
        .tenant-user-grid {
            grid-template-columns: 1fr;
        }

        .assign-mode-box {
            grid-template-columns: 1fr;
        }

        .tenant-user-header {
            flex-direction: column;
        }
    }
</style>

<div class="tenant-user-page">
    <div class="tenant-user-header">
        <div>
            <h2 class="tenant-user-title">
                <i class="fas fa-user-plus text-primary me-2"></i>
                @Localizer["PageHeading"]
            </h2>

            <p class="tenant-user-lead">
                <strong>@Model.TenantName</strong> @Localizer["PageLeadSuffix"]
            </p>
        </div>

        <a href="@backUrl"
           class="btn btn-light border rounded-pill fw-bold px-4">
            <i class="@(backButtonIcon) me-2"></i>
            @backButtonText
        </a>
    </div>

    <div class="tenant-user-grid">
        <div class="tenant-user-card">
            <div class="tenant-user-card-body">
                <form asp-area="Admin"
                      asp-controller="Tenants"
                      asp-action="AssignUser"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="TenantId" />
                    <input type="hidden" asp-for="TenantName" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="mb-4">
                        <label asp-for="SelectedRole" class="tenant-user-label">
                            @Localizer["RoleToAssign"]
                        </label>

                        <select asp-for="SelectedRole"
                                asp-items="Model.AvailableRoles"
                                class="form-select tenant-user-form-control">
                            <option value="">@Localizer["SelectRole"]</option>
                        </select>

                        <span asp-validation-for="SelectedRole"></span>

                        <div class="tenant-user-help">
                            @Html.Raw(Localizer["RoleHelpText"].Value)
                        </div>
                    </div>

                    <div class="assign-mode-box">
                        <div class="assign-mode-option">
                            <input type="radio"
                                   asp-for="AssignmentMode"
                                   id="modeExisting"
                                   value="Existing" />

                            <label for="modeExisting" class="assign-mode-label">
                                <span class="assign-mode-icon">
                                    <i class="fas fa-users"></i>
                                </span>

                                <span>
                                    <span class="assign-mode-title">
                                        @Localizer["AssignExistingUser"]
                                    </span>

                                    <span class="assign-mode-desc">
                                        @Localizer["AssignExistingUserDesc"]
                                    </span>
                                </span>
                            </label>
                        </div>

                        <div class="assign-mode-option">
                            <input type="radio"
                                   asp-for="AssignmentMode"
                                   id="modeNew"
                                   value="New" />

                            <label for="modeNew" class="assign-mode-label">
                                <span class="assign-mode-icon">
                                    <i class="fas fa-user-plus"></i>
                                </span>

                                <span>
                                    <span class="assign-mode-title">
                                        @Localizer["CreateNewUser"]
                                    </span>

                                    <span class="assign-mode-desc">
                                        @Localizer["CreateNewUserDesc"]
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div id="existingUserSection" class="@existingSectionClass">
                        <div class="mb-3">
                            <label asp-for="ExistingUserId" class="tenant-user-label">
                                Kuruma Bağlanacak Kullanıcı
                            </label>

                            <select asp-for="ExistingUserId"
                                    asp-items="Model.AvailableUsers"
                                    class="form-select tenant-user-form-control">
                                <option value="">Kullanıcı seçiniz...</option>
                            </select>

                            <span asp-validation-for="ExistingUserId"></span>

                            <div class="tenant-user-help">
                                Listede Süper Admin kullanıcıları gösterilmez. Seçilen kullanıcı bu kuruma bağlanır ve seçilen rolü alır.
                            </div>
                        </div>
                    </div>

                    <div id="newUserSection" class="@newSectionClass">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="tenant-user-label">
                                    Ad
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control tenant-user-form-control"
                                       placeholder="Örn: Ayşe" />

                                <span asp-validation-for="FirstName"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LastName" class="tenant-user-label">
                                    Soyad
                                </label>

                                <input asp-for="LastName"
                                       class="form-control tenant-user-form-control"
                                       placeholder="Örn: Yılmaz" />

                                <span asp-validation-for="LastName"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="tenant-user-label">
                                    E-posta Adresi
                                </label>

                                <input asp-for="Email"
                                       class="form-control tenant-user-form-control"
                                       placeholder="Örn: kullanici@kurum.edu.tr" />

                                <span asp-validation-for="Email"></span>

                                <div class="tenant-user-help">
                                    Kullanıcı sisteme bu e-posta adresi ile giriş yapacaktır.
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Password" class="tenant-user-label">
                                    Giriş Şifresi
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control tenant-user-form-control"
                                       placeholder="En az 6 karakterli şifre belirleyin" />

                                <span asp-validation-for="Password"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <button type="submit" class="tenant-user-submit-btn">
                        <i class="fas fa-user-check"></i>
                        Kaydet ve Kuruma Bağla
                    </button>
                </form>
            </div>
        </div>

        <div class="tenant-user-card tenant-user-info-card">
            <div class="tenant-user-card-body">
                <div class="tenant-user-info-icon">
                    <i class="fas fa-circle-info"></i>
                </div>

                <h4 class="tenant-user-info-title">
                    Rol Bağlama Hakkında
                </h4>

                <p class="mb-0">
                    Bu ekran, bir kullanıcıyı kuruma bağlamak ve gerekli rolü vermek için kullanılır.
                </p>

                <div class="tenant-user-info-list">
                    <div class="tenant-user-info-item success">
                        <i class="fas fa-check-circle"></i>
                        <span><strong>Hakem</strong> rolü verilen kullanıcı, aynı kuruma bağlı kongrelerde hakem atama ekranında görünür.</span>
                    </div>

                    <div class="tenant-user-info-item success">
                        <i class="fas fa-check-circle"></i>
                        <span><strong>Yazar</strong> rolü verilen kullanıcı, bildiri gönderme süreçlerinde kullanılabilir.</span>
                    </div>

                    <div class="tenant-user-info-item success">
                        <i class="fas fa-check-circle"></i>
                        <span><strong>Dinleyici</strong> rolü verilen kullanıcı, katılımcı/dinleyici işlemlerinde kullanılabilir.</span>
                    </div>

                    <div class="tenant-user-info-item warning">
                        <i class="fas fa-triangle-exclamation"></i>
                        <span>Bir kullanıcı başka kuruma bağlıysa, bu işlem kullanıcının kurum bağlantısını yeni kurumla değiştirir.</span>
                    </div>

                    <div class="tenant-user-info-item danger">
                        <i class="fas fa-times-circle"></i>
                        <span>Süper Admin kullanıcıları bu ekrandan kuruma bağlanamaz.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateAssignUserModeSections() {
            const selectedMode = document.querySelector('input[name="AssignmentMode"]:checked')?.value || "Existing";
            const existingUserSection = document.getElementById("existingUserSection");
            const newUserSection = document.getElementById("newUserSection");

            if (!existingUserSection || !newUserSection) {
                return;
            }

            if (selectedMode === "Existing") {
                existingUserSection.classList.add("active");
                newUserSection.classList.remove("active");
            } else {
                existingUserSection.classList.remove("active");
                newUserSection.classList.add("active");
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const checkedMode = document.querySelector('input[name="AssignmentMode"]:checked');

            if (!checkedMode) {
                const existingMode = document.getElementById("modeExisting");

                if (existingMode) {
                    existingMode.checked = true;
                }
            }

            updateAssignUserModeSections();

            document.querySelectorAll('input[name="AssignmentMode"]').forEach(function (radio) {
                radio.addEventListener("change", updateAssignUserModeSections);
            });
        });
    </script>
}
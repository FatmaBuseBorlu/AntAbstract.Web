@model AntAbstract.Domain.Entities.Tenant
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-dark">@Localizer["PageHeading"]</h4>
            <p class="text-muted small mb-0">
                <strong>@Model.Name</strong> @Localizer["PageLead"]
            </p>
        </div>
        <a asp-action="Index" class="btn btn-light border shadow-sm px-3">
            <i class="fas fa-arrow-left me-2"></i> @Localizer["BackToListButton"]
        </a>
    </div>

    <div class="row">
        <div class="col-xl-6 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 small"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-dark small">@Localizer["NameLabel"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fas fa-university"></i>
                                </span>
                                <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="@Localizer["NamePlaceholder"]" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Slug" class="form-label fw-bold text-dark small">@Localizer["SlugLabel"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fas fa-link"></i>
                                </span>
                                <input asp-for="Slug" class="form-control border-start-0 ps-0" placeholder="@Localizer["SlugPlaceholder"]" />
                            </div>
                            <div class="form-text text-warning small">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                @Localizer["SlugWarningText"]
                            </div>
                            <span asp-validation-for="Slug" class="text-danger small mt-1"></span>
                        </div>

                        <hr class="my-4 opacity-50">

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning btn-lg rounded-3 fw-bold shadow flex-grow-1 text-white">
                                <i class="fas fa-save me-2"></i> @Localizer["SaveButton"]
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light btn-lg rounded-3 border">
                                @Localizer["CancelButton"]
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 border-start border-warning border-4 mb-3">
                <div class="card-body">
                    <h6 class="fw-bold text-warning mb-2">
                        <i class="fas fa-shield-alt me-2"></i> @Localizer["SecurityCardTitle"]
                    </h6>
                    <p class="small text-muted mb-0">
                        @Localizer["SecurityCardText"]
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-2">
                <div class="card-body">
                    <small class="d-block opacity-50">@Localizer["SystemIdCardTitle"]</small>
                    <code class="text-info" style="font-size: 0.75rem;">@Model.Id</code>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #ffc107;
        box-shadow: none;
    }

    .input-group-text {
        border-color: #dee2e6;
    }

    .btn-warning:hover {
        background-color: #eab000;
        transform: translateY(-2px);
    }
</style>
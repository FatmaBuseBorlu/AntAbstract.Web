@model AntAbstract.Domain.Entities.Tenant

@{
    ViewData["Title"] = "Kurumu Sil";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-danger">🗑️ Kurum Silme Onayı</h4>
            <p class="text-muted small mb-0">Bu işlem kalıcıdır ve kesinlikle geri alınamaz.</p>
        </div>
        <a href="/Admin/Tenants" class="btn btn-light border shadow-sm px-3 btn-sm">
            <i class="fas fa-arrow-left me-2"></i> Listeye Dön
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">

            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 p-3 d-flex align-items-start">
                <i class="fas fa-exclamation-triangle fa-2x me-3 mt-1 opacity-75"></i>
                <div>
                    <h6 class="fw-bold mb-1">Kritik Uyarı!</h6>
                    <p class="mb-0 small">
                        <strong>@Model.Name</strong> kurumunu sistemden tamamen silmek üzeresiniz. Bu işlemi onayladığınızda,
                        kuruma ait veriler kalıcı olarak silinecektir. Emin misiniz?
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 border-top border-danger border-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-building me-2 text-danger"></i> Silinecek Kurum Bilgileri</h6>
                </div>
                <div class="card-body p-4">

                    <div class="row mb-3 align-items-center border-bottom pb-3">
                        <div class="col-sm-4 text-muted fw-bold" style="font-size: 0.8rem;">KURUM ADI</div>
                        <div class="col-sm-8 fw-bold text-dark">@Model.Name</div>
                    </div>

                    <div class="row mb-3 align-items-center border-bottom pb-3">
                        <div class="col-sm-4 text-muted fw-bold" style="font-size: 0.8rem;">URL ADRESİ (SLUG)</div>
                        <div class="col-sm-8">
                            <code class="text-danger fw-bold px-2 py-1 bg-danger bg-opacity-10 rounded">/@Model.Slug</code>
                        </div>
                    </div>

                    <div class="row mb-4 align-items-center">
                        <div class="col-sm-4 text-muted fw-bold" style="font-size: 0.8rem;">SİSTEM ID</div>
                        <div class="col-sm-8 text-secondary" style="font-size: 0.85rem;">@Model.Id</div>
                    </div>

                    <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <a href="/Admin/Tenants" class="btn btn-light rounded-3 border fw-bold px-3 py-2">
                            İptal
                        </a>

                        <button type="submit" class="btn btn-danger rounded-3 fw-bold shadow-sm px-4 py-2">
                            <i class="fas fa-trash-alt me-2"></i> Kalıcı Olarak Sil
                        </button>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .btn-danger {
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #dc3545;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4) !important;
        }
</style>
@model AntAbstract.Domain.Entities.Tenant

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-bold text-dark">@Localizer["PageHeading"]</h4>
            <p class="text-muted small mb-0">@Localizer["PageLead"]</p>
        </div>
        <a asp-action="Index" class="btn btn-light border shadow-sm px-3">
            <i class="fas fa-arrow-left me-2"></i> @Localizer["BackToListButton"]
        </a>
    </div>

    <div class="row">
        <div class="col-xl-6 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 small"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-dark small">@Localizer["NameLabel"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="fas fa-university"></i>
                                </span>
                                <input asp-for="Name" class="form-control bg-light border-start-0 ps-0" placeholder="@Localizer["NamePlaceholder"]" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Slug" class="form-label fw-bold text-dark small">@Localizer["SlugLabel"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="fas fa-link"></i>
                                </span>
                                <input asp-for="Slug" class="form-control bg-light border-start-0 ps-0" placeholder="@Localizer["SlugPlaceholder"]" />
                            </div>
                            <div class="form-text text-muted small">
                                <i class="fas fa-info-circle me-1"></i> @Localizer["SlugHelpText"]
                            </div>
                            <span asp-validation-for="Slug" class="text-danger small mt-1"></span>
                        </div>

                        <hr class="my-4 opacity-50">

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow">
                                <i class="fas fa-save me-2"></i> @Localizer["CreateButton"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4">
            <div class="card border-0 bg-primary bg-opacity-10 rounded-4 p-3 border-start border-primary border-4">
                <div class="card-body">
                    <h6 class="fw-bold text-primary mb-3"><i class="fas fa-lightbulb me-2"></i> @Localizer["TipHeader"]</h6>
                    <p class="small text-dark mb-0">
                        @Localizer["TipText"]
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        background-color: #fff !important;
        border-color: var(--primary-color);
        box-shadow: none;
    }

    .input-group-text {
        border: 1px solid #dee2e6;
    }

    .form-label {
        letter-spacing: 0.5px;
    }

    .btn-primary {
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 174, 239, 0.3) !important;
        }
</style>
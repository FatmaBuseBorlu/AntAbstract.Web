@using AntAbstract.Web.Models.ViewModels.Admin.Referee
@model RefereeCreateViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">@Localizer["CardTitle"]</h5>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Localizer["FirstNameLabel"]</label>
                            <input asp-for="FirstName" class="form-control" placeholder="@Localizer["FirstNamePlaceholder"]" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Localizer["LastNameLabel"]</label>
                            <input asp-for="LastName" class="form-control" placeholder="@Localizer["LastNamePlaceholder"]" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["EmailLabel"]</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="@Localizer["EmailPlaceholder"]" />
                        <div class="form-text">@Localizer["EmailHelpText"]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["InstitutionLabel"]</label>
                        <input asp-for="Institution" class="form-control" placeholder="@Localizer["InstitutionPlaceholder"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Localizer["PasswordLabel"]</label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <div class="form-text">@Localizer["PasswordHelpText"]</div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary fw-bold">
                            <i class="fas fa-save me-2"></i> @Localizer["SaveButton"]
                        </button>

                        <a asp-action="Index" class="btn btn-link text-muted mt-2">
                            @Localizer["BackToListButton"]
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
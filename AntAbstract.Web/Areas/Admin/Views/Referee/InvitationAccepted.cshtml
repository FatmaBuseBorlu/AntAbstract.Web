@{
    Layout = null;
    var email = (string?)ViewBag.InvitationEmail ?? "";
    var conferenceTitle = (string?)ViewBag.ConferenceTitle ?? "";
    var userExists = (bool?)ViewBag.UserExists ?? false;
    var slug = (string?)ViewBag.Slug ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Davet Kabul Edildi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh;
min-height:100dvh;">
    <div class="card border-0 shadow-lg text-center p-5" style="max-width:480px;width:100%;">
        <div class="mb-4">
            <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;">
                <i class="fas fa-check-circle fa-3x text-success"></i>
            </div>
            <h3 class="fw-bold text-success">Davet Kabul Edildi!</h3>
            <p class="text-muted mt-2">
                <strong>@conferenceTitle</strong> 
            </p>
        </div>

        @if (!userExists)
        {
            <div class="alert alert-info text-start">
                <i class="fas fa-info-circle me-2"></i>
                Sisteme giriş yapabilmek için <a href="/@slug/Account/Register?email=@Uri.EscapeDataString(email)" class="alert-link">kayıt olmanız</a> gerekmektedir.
            </div>
        }
        else
        {
            <div class="alert alert-success text-start">
                <i class="fas fa-check me-2"></i>
                Hesabınıza hakem rolü eklendi. <a href="/@slug/Account/Login" class="alert-link">Giriş yapabilirsiniz.</a>
            </div>
        }

        <a href="/@slug" class="btn btn-outline-secondary mt-2">
            <i class="fas fa-home me-2"></i>Ana Sayfaya Git
        </a>
    </div>
</body>
</html>

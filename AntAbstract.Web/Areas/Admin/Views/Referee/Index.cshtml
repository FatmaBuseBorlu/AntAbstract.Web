@model IEnumerable<AntAbstract.Domain.Entities.AppUser>

@using System
@using System.Collections.Generic
@using System.Linq


@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var referees = Model?.ToList() ?? new List<AntAbstract.Domain.Entities.AppUser>();

    var conferenceId = ViewBag.ConferenceId is Guid vbConferenceId
        ? vbConferenceId
        : Guid.Empty;

    var conferenceTitle = ViewBag.ConferenceTitle as string ?? "";
    var slug = ViewBag.Slug as string ?? "";

    var targetTenantId = ViewBag.TargetTenantId is Guid vbTenantId
        ? vbTenantId
        : Guid.Empty;

    var flowUrl = string.IsNullOrWhiteSpace(slug)
        ? conferenceId != Guid.Empty
            ? $"/Admin/ConferenceFlow?conferenceId={conferenceId}"
            : "/Admin/ConferenceFlow"
        : conferenceId != Guid.Empty
            ? $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceId}"
            : $"/{slug}/Admin/ConferenceFlow";

    var changeConferenceUrl = "/Admin/ConferenceFlow?forceSelect=true";

    var returnUrlForAssignUser = string.IsNullOrWhiteSpace(slug)
        ? conferenceId != Guid.Empty
            ? $"/Admin/Referee?conferenceId={conferenceId}"
            : "/Admin/Referee"
        : conferenceId != Guid.Empty
            ? $"/{slug}/Admin/Referee?conferenceId={conferenceId}"
            : $"/{slug}/Admin/Referee";

    var assignUserUrl = targetTenantId != Guid.Empty
        ? $"/Admin/Tenants/AssignUser/{targetTenantId}?returnUrl={Uri.EscapeDataString(returnUrlForAssignUser)}"
        : "/Admin/ConferenceFlow?forceSelect=true";

    var deletePostUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Referee/Delete"
        : $"/{slug}/Admin/Referee/Delete";

    var deleteConfirmText = "Bu kullanıcının Referee / Hakem / Reviewer hakem rollerini kaldırmak istediğinize emin misiniz? Kullanıcı silinmez, sadece hakem yetkileri kaldırılır.";

    string GetFullName(AntAbstract.Domain.Entities.AppUser user)
    {
        var fullName = $"{user.FirstName} {user.LastName}".Trim();

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return fullName;
        }

        return user.Email ?? user.UserName ?? "Hakem";
    }

    string GetInitial(AntAbstract.Domain.Entities.AppUser user)
    {
        var fullName = GetFullName(user);

        return string.IsNullOrWhiteSpace(fullName)
            ? "H"
            : fullName.Substring(0, 1).ToUpper();
    }
}

<div class="container-fluid referee-page">

    <div class="referee-hero-card mb-4">
        <div class="referee-hero-left">
            <div class="referee-hero-icon">
                <i class="fas fa-user-tie"></i>
            </div>

            <div>
                <div class="referee-section-label">
                    Kongre Operasyonları
                </div>

                <h2 class="referee-page-title">
                    Hakem Havuzu
                </h2>

                <p class="referee-page-description">
                    Seçili kongrenin kurumuna bağlı <strong>Referee / Hakem / Reviewer</strong> rolündeki kullanıcıları buradan görüntüleyebilirsiniz.
                </p>

                @if (!string.IsNullOrWhiteSpace(conferenceTitle) || !string.IsNullOrWhiteSpace(slug))
                {
                    <div class="selected-conference-pill">
                        <i class="fas fa-calendar-check"></i>

                        <span>Seçili Kongre:</span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(conferenceTitle) ? "Kongre seçilmedi" : conferenceTitle)
                        </strong>

                        @if (!string.IsNullOrWhiteSpace(slug))
                        {
                            <em>/@slug</em>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="referee-hero-actions">

            <a href="@flowUrl"
               class="btn referee-light-btn">
                <i class="fas fa-arrow-left me-2"></i>
                Kongre Akışına Dön
            </a>

            <a href="@changeConferenceUrl"
               class="btn referee-outline-btn">
                <i class="fas fa-exchange-alt me-2"></i>
                Kongre Değiştir
            </a>

            <a href="@assignUserUrl"
               class="btn referee-primary-btn">
                <i class="fas fa-user-plus me-2"></i>
                Kullanıcı / Hakem Bağla
            </a>

            @{
                var inviteUrl = string.IsNullOrWhiteSpace(slug)
                    ? conferenceId != Guid.Empty ? $"/Admin/Referee/InviteByEmail?conferenceId={conferenceId}" : "/Admin/Referee/InviteByEmail"
                    : conferenceId != Guid.Empty ? $"/{slug}/Admin/Referee/InviteByEmail?conferenceId={conferenceId}" : $"/{slug}/Admin/Referee/InviteByEmail";
                var invitationsUrl = string.IsNullOrWhiteSpace(slug)
                    ? conferenceId != Guid.Empty ? $"/Admin/Referee/Invitations?conferenceId={conferenceId}" : "/Admin/Referee/Invitations"
                    : conferenceId != Guid.Empty ? $"/{slug}/Admin/Referee/Invitations?conferenceId={conferenceId}" : $"/{slug}/Admin/Referee/Invitations";
            }
            <a href="@inviteUrl" class="btn referee-outline-btn">
                <i class="fas fa-envelope-open-text me-2"></i>
                E-posta ile Davet Et
            </a>

            <a href="@invitationsUrl" class="btn referee-light-btn">
                <i class="fas fa-list me-2"></i>
                Davetler
            </a>

        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4">
            <i class="fas fa-times-circle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="referee-stat-card">
                <div class="referee-stat-icon stat-blue">
                    <i class="fas fa-user-tie"></i>
                </div>

                <div>
                    <div class="referee-stat-number">
                        @referees.Count
                    </div>

                    <div class="referee-stat-label">
                        Toplam Hakem
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="referee-stat-card">
                <div class="referee-stat-icon stat-green">
                    <i class="fas fa-building"></i>
                </div>

                <div>
                    <div class="referee-stat-number">
                        @(targetTenantId == Guid.Empty ? "-" : "Aktif")
                    </div>

                    <div class="referee-stat-label">
                        Kurum Bağlantısı
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="referee-stat-card">
                <div class="referee-stat-icon stat-purple">
                    <i class="fas fa-id-badge"></i>
                </div>

                <div>
                    <div class="referee-stat-number">
                        3
                    </div>

                    <div class="referee-stat-label">
                        Desteklenen Hakem Rolü
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="role-info-card mb-4">
        <div class="role-info-icon">
            <i class="fas fa-circle-info"></i>
        </div>

        <div>
            <div class="role-info-title">
                Hakem rolleri birlikte desteklenir
            </div>

            <p class="role-info-text">
                Bu havuzda <strong>Referee</strong>, <strong>Hakem</strong> veya <strong>Reviewer</strong> rollerinden herhangi birine sahip kullanıcılar listelenir.
                Rol kaldırma işleminde kullanıcı silinmez; sadece varsa bu hakem rolleri kaldırılır.
            </p>
        </div>
    </div>

    <div class="referee-list-card">
        <div class="referee-list-header">
            <div>
                <h5>
                    Hakem Listesi
                </h5>

                <p>
                    Bu listede seçili kongrenin kurumuna bağlı hakem rolündeki kullanıcılar görüntülenir.
                </p>
            </div>

            <div class="referee-count-pill">
                @referees.Count hakem
            </div>
        </div>

        @if (!referees.Any())
        {
            <div class="referee-empty-state">
                <div class="empty-icon">
                    <i class="fas fa-user-slash"></i>
                </div>

                <h4>
                    Bu kongrenin kurumuna bağlı hakem bulunmuyor
                </h4>

                <p>
                    Hakem atama ekranında kullanıcıların görünebilmesi için kullanıcının
                    <strong>Referee</strong>, <strong>Hakem</strong> veya <strong>Reviewer</strong>
                    rollerinden en az birine sahip olması ve seçili kongrenin kurumuna bağlı olması gerekir.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a href="@assignUserUrl"
                       class="btn referee-primary-btn">
                        <i class="fas fa-user-plus me-2"></i>
                        Kullanıcı / Hakem Bağla
                    </a>

                    <a href="@flowUrl"
                       class="btn referee-light-btn">
                        <i class="fas fa-arrow-left me-2"></i>
                        Kongre Akışına Dön
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 referee-table">
                    <thead>
                        <tr>
                            <th class="ps-4">
                                Hakem
                            </th>

                            <th>
                                E-posta
                            </th>

                            <th>
                                Kurum
                            </th>

                            <th>
                                Rol Bilgisi
                            </th>

                            <th class="text-end pe-4">
                                İşlem
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in referees)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="referee-profile">
                                        <div class="referee-avatar">
                                            @GetInitial(item)
                                        </div>

                                        <div>
                                            <div class="referee-name">
                                                @GetFullName(item)
                                            </div>

                                            <div class="referee-subtitle">
                                                ID: @(item.Id.Length >= 8 ? item.Id.Substring(0, 8) : item.Id)...
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="referee-email">
                                        @(item.Email ?? "-")
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Institution))
                                    {
                                        <span class="institution-badge">
                                            <i class="fas fa-building me-1"></i>
                                            @item.Institution
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fw-bold">
                                            Kurum bilgisi yok
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="reviewer-role-badge">
                                        <i class="fas fa-user-tie"></i>
                                        Hakem Rolü
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <form action="@deletePostUrl"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm(deleteConfirmText);">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@item.Id" />

                                        @if (conferenceId != Guid.Empty)
                                        {
                                            <input type="hidden" name="conferenceId" value="@conferenceId" />
                                        }

                                        <button type="submit"
                                                class="btn referee-remove-btn">
                                            <i class="fas fa-user-minus me-1"></i>
                                            Hakem Rollerini Kaldır
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<style>
    .referee-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .referee-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.15), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .referee-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .referee-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .referee-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .referee-page-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.05em;
    }

    .referee-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 600;
        line-height: 1.65;
    }

    .selected-conference-pill {
        width: fit-content;
        margin-top: 0.75rem;
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0.85rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.10);
        border: 1px solid rgba(0, 174, 239, 0.22);
        color: #0d6efd;
        font-size: 0.82rem;
        font-weight: 900;
    }

    .selected-conference-pill span,
    .selected-conference-pill strong {
        color: #0d6efd;
    }

    .selected-conference-pill em {
        color: #64748b;
        font-style: normal;
        font-weight: 900;
    }

    .referee-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .referee-light-btn,
    .referee-outline-btn,
    .referee-primary-btn {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 0 1.2rem;
        text-decoration: none;
        font-weight: 900;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .referee-light-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

    .referee-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.28);
        background: #f8fbff;
        transform: translateY(-1px);
    }

    .referee-outline-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
    }

    .referee-outline-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .referee-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.18);
    }

    .referee-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 18px 36px rgba(13, 110, 253, 0.24);
    }

    .referee-stat-card {
        background: #ffffff;
        border-radius: 1rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        border: 1px solid #f1f5f9;
        min-height: 95px;
    }

    .referee-stat-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .stat-purple {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .referee-stat-number {
        font-size: 1.45rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1;
    }

    .referee-stat-label {
        color: #64748b;
        font-weight: 800;
        font-size: 0.76rem;
        margin-top: 0.25rem;
    }

    .role-info-card {
        background: rgba(13, 110, 253, 0.06);
        border: 1px solid rgba(13, 110, 253, 0.14);
        border-radius: 24px;
        padding: 1rem 1.15rem;
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.04);
    }

    .role-info-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 15px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .role-info-title {
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .role-info-text {
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 650;
        line-height: 1.6;
        margin-bottom: 0;
    }

    .referee-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
    }

    .referee-list-header {
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .referee-list-header h5 {
        margin: 0 0 0.25rem;
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
    }

    .referee-list-header p {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .referee-count-pill {
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.8rem;
        font-weight: 900;
    }

    .referee-table thead th {
        padding: 1rem 1.5rem;
        background: #f8fafc;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .referee-table tbody td {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .referee-table tbody tr:hover {
        background: #f8fbff;
    }

    .referee-table tbody tr:last-child td {
        border-bottom: none;
    }

    .referee-profile {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .referee-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 999px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 900;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.18);
    }

    .referee-name {
        color: #0f172a;
        font-size: 0.94rem;
        font-weight: 900;
    }

    .referee-subtitle {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        margin-top: 0.15rem;
    }

    .referee-email {
        color: #475569;
        font-size: 0.86rem;
        font-weight: 700;
    }

    .institution-badge,
    .reviewer-role-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.42rem 0.72rem;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .institution-badge {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
    }

    .reviewer-role-badge {
        gap: 0.42rem;
        background: rgba(13, 110, 253, 0.10);
        border: 1px solid rgba(13, 110, 253, 0.16);
        color: #0d6efd;
    }

    .referee-remove-btn {
        min-height: 38px;
        border-radius: 999px;
        border: 1px solid rgba(239, 68, 68, 0.26);
        background: #ffffff;
        color: #ef4444;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .referee-remove-btn:hover {
        background: #ef4444;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(239, 68, 68, 0.18);
    }

    .referee-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
    }

    .referee-empty-state h4 {
        color: #0f172a;
        font-size: 1.28rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .referee-empty-state p {
        color: #64748b;
        font-weight: 600;
        margin: 0 auto 1.25rem;
        max-width: 640px;
        line-height: 1.65;
    }


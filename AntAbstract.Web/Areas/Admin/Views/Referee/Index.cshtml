@model IEnumerable<AntAbstract.Domain.Entities.AppUser>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">
            <i class="fas fa-user-tie text-primary me-2"></i> @Localizer["CardTitle"]
        </h5>

        <a asp-action="Create" class="btn btn-primary btn-sm fw-bold">
            <i class="fas fa-plus me-1"></i> @Localizer["AddReviewerButton"]
        </a>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">@Localizer["TableHeaderFullName"]</th>
                        <th>@Localizer["TableHeaderEmail"]</th>
                        <th>@Localizer["TableHeaderInstitution"]</th>
                        <th class="text-end pe-4">@Localizer["TableHeaderAction"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                @Localizer["EmptyMessage"]
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.FirstName @item.LastName</td>
                            <td>@item.Email</td>
                            <td>@item.Institution</td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" method="post" onsubmit="return confirm('@Localizer["DeleteConfirmMessage"]');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i> @Localizer["DeleteButton"]
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
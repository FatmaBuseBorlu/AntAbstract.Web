@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    Layout = null;
    var slug = (string?)ViewBag.Slug ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Davet Reddedildi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh;
min-height:100dvh;">
    <div class="card border-0 shadow-lg text-center p-5" style="max-width:480px;width:100%;">
        <div class="mb-4">
            <div class="rounded-circle bg-secondary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;">
                <i class="fas fa-times-circle fa-3x text-secondary"></i>
            </div>
            <h3 class="fw-bold">Davet Reddedildi</h3>
            <p class="text-muted mt-2">@Localizer["TesekkurEderizYanitinizKaydedildi"]</p>
        </div>
        <a href="/@slug" class="btn btn-outline-secondary">
            <i class="fas fa-home me-2"></i>@Localizer["AnaSayfayaGit"]</a>
    </div>
</body>
</html>

@{
    Layout = null;
    var token = (string?)ViewBag.Token ?? "";
    var slug = (string?)ViewBag.Slug ?? "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Daveti Reddet</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh;">
    <div class="card border-0 shadow-lg p-5" style="max-width:480px;width:100%;">
        <div class="text-center mb-4">
            <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;">
                <i class="fas fa-times-circle fa-3x text-danger"></i>
            </div>
            <h3 class="fw-bold">Daveti Reddet</h3>
            <p class="text-muted">İsterseniz bir neden belirtebilirsiniz (isteğe bağlı).</p>
        </div>

        <form method="post" action="/@slug/Referee/DeclineInvitation">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@token" />

            <div class="mb-3">
                <label class="form-label">Reddetme Nedeni (isteğe bağlı)</label>
                <textarea name="reason" class="form-control" rows="3" placeholder="Örn: Zaman yetersizliği, alan uzmanlığı uyuşmazlığı..."></textarea>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-times me-2"></i>Daveti Reddet
                </button>
                <a href="/@slug" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</body>
</html>

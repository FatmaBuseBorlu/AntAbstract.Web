@using Microsoft.AspNetCore.Mvc.Rendering
@using AntAbstract.WebUI.Models.ViewModels.Admin.AllConferences

@model List<AllConferenceListItemViewModel>

@{
    ViewData["Title"] = "Tüm Kongreler";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var search = ViewBag.Search as string;
    var selectedTenantId = ViewBag.TenantId as Guid?;
    var tenants = ViewBag.Tenants as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    var now = DateTime.Now;

    var totalConferenceCount = Model?.Count ?? 0;
    var activeConferenceCount = Model?.Count(x => x.StartDate <= now && x.EndDate >= now) ?? 0;
    var upcomingConferenceCount = Model?.Count(x => x.StartDate > now) ?? 0;
    var completedConferenceCount = Model?.Count(x => x.EndDate < now) ?? 0;

    string GetStatusText(AllConferenceListItemViewModel item)
    {
        if (item.StartDate <= now && item.EndDate >= now)
        {
            return "Devam Ediyor";
        }

        if (item.EndDate < now)
        {
            return "Tamamlandı";
        }

        return "Yaklaşan";
    }

    string GetStatusClass(AllConferenceListItemViewModel item)
    {
        if (item.StartDate <= now && item.EndDate >= now)
        {
            return "conference-status-active";
        }

        if (item.EndDate < now)
        {
            return "conference-status-completed";
        }

        return "conference-status-upcoming";
    }

    string GetInitial(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "K"
            : value.Trim().Substring(0, 1).ToUpper();
    }

    string GetLocation(AllConferenceListItemViewModel item)
    {
        var city = string.IsNullOrWhiteSpace(item.City) ? "" : item.City.Trim();
        var country = string.IsNullOrWhiteSpace(item.Country) ? "" : item.Country.Trim();

        if (!string.IsNullOrWhiteSpace(city) && !string.IsNullOrWhiteSpace(country))
        {
            return $"{city}, {country}";
        }

        if (!string.IsNullOrWhiteSpace(city))
        {
            return city;
        }

        if (!string.IsNullOrWhiteSpace(country))
        {
            return country;
        }

        return "-";
    }
}

<style>
    .all-conferences-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
        padding-bottom: 2rem;
    }

    .all-conferences-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 28px;
        padding: 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        flex-wrap: wrap;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        margin-bottom: 1.5rem;
    }

    .all-conferences-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 300px;
        flex: 1;
    }

    .all-conferences-hero-icon {
        width: 64px;
        height: 64px;
        min-width: 64px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.22);
    }

    .all-conferences-section-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .all-conferences-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        letter-spacing: -0.05em;
    }

    .all-conferences-description {
        margin: 0;
        color: #64748b;
        font-size: 0.96rem;
        font-weight: 650;
        line-height: 1.65;
        max-width: 850px;
    }

    .all-conferences-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .conference-light-btn,
    .conference-primary-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        border-radius: 999px;
        padding: 0 1.15rem;
        font-size: 0.9rem;
        font-weight: 900;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .conference-light-btn {
        background: #ffffff;
        color: #334155;
        border: 1px solid #dbe3ef;
    }

    .conference-light-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.32);
        background: #ffffff;
        transform: translateY(-1px);
    }

    .conference-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(13, 110, 253, 0.18);
    }

    .conference-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 16px 32px rgba(13, 110, 253, 0.24);
    }

    .conference-stat-card {
        min-height: 96px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
        transition: all 0.2s ease;
    }

    .conference-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
    }

    .conference-stat-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .stat-gray {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
    }

    .conference-stat-number {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 950;
        line-height: 1;
    }

    .conference-stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 850;
        margin-top: 0.3rem;
    }

    .conference-filter-card,
    .conference-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .conference-filter-card {
        padding: 1.25rem;
        margin-bottom: 1.35rem;
    }

    .conference-label {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.45rem;
    }

    .conference-form-control {
        min-height: 44px;
        border-radius: 14px;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        font-weight: 700;
    }

    .conference-form-control:focus {
        border-color: #00aeef;
        box-shadow: 0 0 0 0.18rem rgba(0, 174, 239, 0.12);
    }

    .conference-filter-btn,
    .conference-reset-btn {
        min-height: 44px;
        border-radius: 14px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
    }

    .conference-filter-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }

    .conference-filter-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
    }

    .conference-reset-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
        min-width: 46px;
    }

    .conference-reset-btn:hover {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.25);
    }

    .conference-list-header {
        padding: 1.35rem 1.45rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .conference-list-header h5 {
        color: #0f172a;
        font-size: 1.18rem;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .conference-list-header p {
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.55;
    }

    .conference-count-pill {
        padding: 0.44rem 0.82rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .all-conferences-table {
        margin-bottom: 0;
    }

    .all-conferences-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #edf2f7;
        white-space: nowrap;
    }

    .all-conferences-table tbody td {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .all-conferences-table tbody tr:hover {
        background: #f8fbff;
    }

    .all-conferences-table tbody tr:last-child td {
        border-bottom: none;
    }

    .conference-profile {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .conference-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 17px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 950;
        box-shadow: 0 12px 24px rgba(13, 110, 253, 0.16);
    }

    .conference-name {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 950;
        line-height: 1.3;
    }

    .conference-subtitle {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 750;
        margin-top: 0.18rem;
    }

    .tenant-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        padding: 0.42rem 0.72rem;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .metric-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        border-radius: 999px;
        padding: 0.4rem 0.68rem;
        font-size: 0.78rem;
        font-weight: 950;
    }

    .metric-submission {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        border: 1px solid rgba(13, 110, 253, 0.14);
    }

    .metric-registration {
        background: rgba(245, 158, 11, 0.12);
        color: #d97706;
        border: 1px solid rgba(245, 158, 11, 0.18);
    }

    .conference-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        border-radius: 999px;
        padding: 0.4rem 0.72rem;
        font-size: 0.76rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .conference-status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #15803d;
        border: 1px solid rgba(34, 197, 94, 0.18);
    }

    .conference-status-upcoming {
        background: rgba(0, 174, 239, 0.12);
        color: #0284c7;
        border: 1px solid rgba(0, 174, 239, 0.18);
    }

    .conference-status-completed {
        background: rgba(100, 116, 139, 0.12);
        color: #64748b;
        border: 1px solid rgba(100, 116, 139, 0.18);
    }

    .admin-action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.42rem;
        flex-wrap: nowrap;
    }

    .admin-action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.84rem;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid transparent;
        background: #ffffff;
        transition: all 0.2s ease;
        line-height: 1;
        padding: 0;
    }

    .admin-action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.10);
    }

    .admin-action-flow {
        color: #0d6efd;
        border-color: rgba(13, 110, 253, 0.28);
    }

    .admin-action-flow:hover {
        background: rgba(13, 110, 253, 0.08);
        color: #0b5ed7;
    }

    .admin-action-site {
        color: #14b8a6;
        border-color: rgba(20, 184, 166, 0.30);
    }

    .admin-action-site:hover {
        background: rgba(20, 184, 166, 0.10);
        color: #0f766e;
    }

    .admin-action-edit {
        color: #f59e0b;
        border-color: rgba(245, 158, 11, 0.35);
    }

    .admin-action-edit:hover {
        background: rgba(245, 158, 11, 0.10);
        color: #d97706;
    }

    .admin-action-tenant {
        color: #64748b;
        border-color: rgba(100, 116, 139, 0.30);
    }

    .admin-action-tenant:hover {
        background: rgba(100, 116, 139, 0.08);
        color: #334155;
    }

    .conference-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        color: #64748b;
    }

    .conference-empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 26px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .conference-empty-state h6 {
        color: #0f172a;
        font-size: 1.1rem;
        font-weight: 950;
        margin-bottom: 0.3rem;
    }

    .conference-empty-state p {
        margin-bottom: 0;
        font-weight: 650;
    }

    @@media (max-width: 992px) {
        .all-conferences-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .all-conferences-hero-left {
            align-items: flex-start;
        }

        .all-conferences-hero-actions,
        .all-conferences-hero-actions .btn {
            width: 100%;
        }

        .all-conferences-title {
            font-size: 1.65rem;
        }
    }

    @@media (max-width: 768px) {
        .all-conferences-hero-left {
            flex-direction: column;
        }

        .all-conferences-table tbody td {
            min-width: 150px;
        }

        .admin-action-group {
            flex-wrap: wrap;
        }
    }
</style>

<div class="container-fluid all-conferences-page">

    <div class="all-conferences-hero">
        <div class="all-conferences-hero-left">
            <div class="all-conferences-hero-icon">
                <i class="fas fa-calendar-days"></i>
            </div>

            <div>
                <div class="all-conferences-section-label">
                    Global Sistem
                </div>

                <h2 class="all-conferences-title">
                    Tüm Kongreler
                </h2>

                <p class="all-conferences-description">
                    Sistemdeki tüm kurumlara bağlı kongreleri buradan izleyebilir, kongre sitesine veya kongre operasyon akışına hızlıca geçebilirsiniz.
                </p>
            </div>
        </div>

        <div class="all-conferences-hero-actions">
            <a href="/Admin/Tenants"
               class="btn conference-light-btn">
                <i class="fas fa-building"></i>
                Kurumlara Git
            </a>

            <a href="/Admin/SystemReports"
               class="btn conference-primary-btn">
                <i class="fas fa-chart-line"></i>
                Sistem Raporları
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="conference-stat-card">
                <div class="conference-stat-icon stat-blue">
                    <i class="fas fa-calendar-alt"></i>
                </div>

                <div>
                    <div class="conference-stat-number">
                        @totalConferenceCount
                    </div>

                    <div class="conference-stat-label">
                        Toplam Kongre
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="conference-stat-card">
                <div class="conference-stat-icon stat-green">
                    <i class="fas fa-play-circle"></i>
                </div>

                <div>
                    <div class="conference-stat-number">
                        @activeConferenceCount
                    </div>

                    <div class="conference-stat-label">
                        Devam Eden
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="conference-stat-card">
                <div class="conference-stat-icon stat-cyan">
                    <i class="fas fa-clock"></i>
                </div>

                <div>
                    <div class="conference-stat-number">
                        @upcomingConferenceCount
                    </div>

                    <div class="conference-stat-label">
                        Yaklaşan
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="conference-stat-card">
                <div class="conference-stat-icon stat-gray">
                    <i class="fas fa-check-circle"></i>
                </div>

                <div>
                    <div class="conference-stat-number">
                        @completedConferenceCount
                    </div>

                    <div class="conference-stat-label">
                        Tamamlanan
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="conference-filter-card">
        <form method="get"
              asp-area="Admin"
              asp-controller="AllConferences"
              asp-action="Index"
              class="row g-3 align-items-end">

            <div class="col-lg-5">
                <label class="conference-label">
                    Arama
                </label>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control conference-form-control"
                       placeholder="Kongre adı, kurum, şehir, ülke veya slug ara..." />
            </div>

            <div class="col-lg-4">
                <label class="conference-label">
                    Kurum
                </label>

                <select name="tenantId" class="form-select conference-form-control">
                    <option value="">Tüm Kurumlar</option>

                    @foreach (var tenant in tenants)
                    {
                        if (tenant.Selected)
                        {
                            <option value="@tenant.Value" selected>@tenant.Text</option>
                        }
                        else
                        {
                            <option value="@tenant.Value">@tenant.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-3 d-flex gap-2">
                <button type="submit"
                        class="btn conference-filter-btn w-100">
                    <i class="fas fa-search"></i>
                    Filtrele
                </button>

                <a href="/Admin/AllConferences"
                   class="btn conference-reset-btn"
                   title="Filtreleri Temizle">
                    <i class="fas fa-rotate-left"></i>
                </a>
            </div>

        </form>
    </div>

    <div class="conference-list-card">
        <div class="conference-list-header">
            <div>
                <h5>
                    Kongre Listesi
                </h5>

                <p>
                    Bu liste SuperAdmin için genel izleme ekranıdır. İşlem ikonlarıyla siteye, ayarlara ve kongre operasyon akışına hızlıca geçebilirsiniz.
                </p>
            </div>

            <span class="conference-count-pill">
                @totalConferenceCount kayıt
            </span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="conference-empty-state">
                <div class="conference-empty-icon">
                    <i class="fas fa-calendar-xmark"></i>
                </div>

                <h6>
                    Kongre bulunamadı
                </h6>

                <p>
                    Arama kriterlerine uygun kongre yok.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle all-conferences-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 25%;">
                                Kongre
                            </th>

                            <th style="width: 18%;">
                                Kurum
                            </th>

                            <th style="width: 12%;">
                                Konum
                            </th>

                            <th style="width: 12%;">
                                Tarih
                            </th>

                            <th class="text-center" style="width: 8%;">
                                Bildiri
                            </th>

                            <th class="text-center" style="width: 8%;">
                                Kayıt
                            </th>

                            <th class="text-center" style="width: 10%;">
                                Durum
                            </th>

                            <th class="text-end pe-4" style="width: 12%; min-width: 180px;">
                                İşlem
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusText = GetStatusText(item);
                            var statusClass = GetStatusClass(item);

                            var hasTenantSlug = !string.IsNullOrWhiteSpace(item.TenantSlug);

                            var siteUrl = hasTenantSlug
                                ? $"/{item.TenantSlug}"
                                : "#";

                            var flowUrl = hasTenantSlug
                                ? $"/{item.TenantSlug}/Admin/ConferenceFlow?conferenceId={item.Id}"
                                : $"/Admin/ConferenceFlow?conferenceId={item.Id}";

                            var editUrl = hasTenantSlug
                                ? $"/{item.TenantSlug}/Admin/Conferences/Edit/{item.Id}"
                                : "#";

                            var tenantUrl = item.TenantId.HasValue
                                ? $"/Admin/Tenants/Details/{item.TenantId.Value}"
                                : "#";

                            <tr>
                                <td class="ps-4">
                                    <div class="conference-profile">
                                        <div class="conference-avatar">
                                            @GetInitial(item.Title)
                                        </div>

                                        <div>
                                            <div class="conference-name">
                                                @item.Title
                                            </div>

                                            <div class="conference-subtitle">
                                                Slug:
                                                @(string.IsNullOrWhiteSpace(item.Slug) ? "-" : item.Slug)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="conference-name">
                                        @item.TenantName
                                    </div>

                                    <div class="conference-subtitle">
                                        @(string.IsNullOrWhiteSpace(item.TenantSlug) ? "-" : "/" + item.TenantSlug)
                                    </div>
                                </td>

                                <td>
                                    <span class="tenant-pill">
                                        <i class="fas fa-location-dot"></i>
                                        @GetLocation(item)
                                    </span>
                                </td>

                                <td>
                                    <div class="conference-name">
                                        @item.StartDate.ToString("dd.MM.yyyy")
                                    </div>

                                    <div class="conference-subtitle">
                                        @item.EndDate.ToString("dd.MM.yyyy")
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="metric-pill metric-submission">
                                        @item.SubmissionCount
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="metric-pill metric-registration">
                                        @item.RegistrationCount
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="conference-status-badge @statusClass">
                                        <i class="fas fa-circle"></i>
                                        @statusText
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="admin-action-group">

                                        <a href="@flowUrl"
                                           class="admin-action-btn admin-action-flow"
                                           title="Kongre Akışına Git">
                                            <i class="fas fa-stream"></i>
                                        </a>

                                        @if (hasTenantSlug)
                                        {
                                            <a href="@siteUrl"
                                               target="_blank"
                                               class="admin-action-btn admin-action-site"
                                               title="Siteyi Gör">
                                                <i class="fas fa-arrow-up-right-from-square"></i>
                                            </a>

                                            <a href="@editUrl"
                                               class="admin-action-btn admin-action-edit"
                                               title="Kongre Ayarları">
                                                <i class="fas fa-gear"></i>
                                            </a>
                                        }

                                        @if (item.TenantId.HasValue)
                                        {
                                            <a href="@tenantUrl"
                                               class="admin-action-btn admin-action-tenant"
                                               title="Kurum Detayı">
                                                <i class="fas fa-building"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
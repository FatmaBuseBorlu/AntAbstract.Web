<div class="all-conferences-page">

    <div class="admin-hero">
        <div class="admin-hero-left">
            <div class="admin-hero-icon">
                <i class="fas fa-calendar-days"></i>
            </div>

            <div>
                <div class="admin-hero-kicker">
                    @Localizer["HeroKicker"]
                </div>

                <h3 class="admin-hero-title">
                    @Localizer["HeroTitle"]
                </h3>

                <p class="admin-hero-lead">
                    @Localizer["HeroDescription"]
                </p>
            </div>
        </div>

        <div class="admin-hero-actions">
            <a href="/Admin/Tenants"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-building"></i>
                @Localizer["GoToTenants"]
            </a>

            <a href="/Admin/AllConferences/Create"
               class="admin-hero-btn admin-hero-btn-light">
                <i class="fas fa-plus"></i>@Localizer["YeniKongreEkle"]</a>

            <a href="/Admin/SystemReports"
               class="admin-hero-btn admin-hero-btn-primary">
                <i class="fas fa-chart-line"></i>
                @Localizer["SystemReports"]
            </a>
        </div>
    </div>

    <div class="admin-stat-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-blue">
                <i class="fas fa-calendar-alt"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @totalConferenceCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["StatTotal"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-green">
                <i class="fas fa-play-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @activeConferenceCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["StatActive"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-cyan">
                <i class="fas fa-clock"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @upcomingConferenceCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["StatUpcoming"]
                </div>
            </div>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-icon stat-slate">
                <i class="fas fa-check-circle"></i>
            </div>

            <div>
                <div class="admin-stat-value">
                    @completedConferenceCount
                </div>

                <div class="admin-stat-label">
                    @Localizer["StatCompleted"]
                </div>
            </div>
        </div>
    </div>

    <div class="admin-filter-card">
        <form method="get"
              asp-area="Admin"
              asp-controller="AllConferences"
              asp-action="Index"
              class="row g-3 align-items-end">

            <div class="col-lg-5">
                <label class="admin-filter-label">
                    @Localizer["FilterSearch"]
                </label>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control admin-filter-control"
                       placeholder="@Localizer["FilterSearchPlaceholder"]" />
            </div>

            <div class="col-lg-4">
                <label class="admin-filter-label">
                    @Localizer["FilterTenant"]
                </label>

                <select name="tenantId" class="form-select admin-filter-control">
                    <option value="">@Localizer["AllTenants"]</option>

                    @foreach (var tenant in tenants)
                    {
                        if (tenant.Selected)
                        {
                            <option value="@tenant.Value" selected>@tenant.Text</option>
                        }
                        else
                        {
                            <option value="@tenant.Value">@tenant.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-3">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="admin-filter-btn flex-fill">
                        <i class="fas fa-search"></i>
                        @Localizer["FilterButton"]
                    </button>

                    <a href="/Admin/AllConferences"
                       class="admin-reset-btn"
                       title="@Localizer["ClearFilters"]">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                </div>
            </div>

        </form>
    </div>

    <div class="admin-list-card">
        <div class="admin-list-card-header">
            <div>
                <h5 class="admin-list-card-title">
                    @Localizer["ListTitle"]
                </h5>

                <p class="admin-list-card-subtitle">
                    @Localizer["ListDescription"]
                </p>
            </div>

            <span class="admin-list-count">
                <i class="fas fa-list-ul"></i>
                @totalConferenceCount @Localizer["Records"]
            </span>
        </div>

        @{
            int pgTotal = (int)(ViewBag.TotalPages ?? 1);
            int pgCur   = (int)(ViewBag.Page ?? 1);
            int pgSize  = (int)(ViewBag.PageSize ?? 50);
            int pgCount = (int)(ViewBag.TotalCount ?? 0);
            string pgBase = $"/Admin/AllConferences?search={search}&tenantId={selectedTenantId}";
        }

        @if (!conferences.Any())
        {
            <div class="conference-empty-state">
                <div class="conference-empty-icon">
                    <i class="fas fa-calendar-xmark"></i>
                </div>

                <h6 class="conference-empty-title">
                    @Localizer["EmptyTitle"]
                </h6>

                <p class="conference-empty-text">
                    @Localizer["EmptyDescription"]
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive all-conferences-table-responsive">
                <table class="table table-hover align-middle all-conferences-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 25%;">
                                @Localizer["ThConference"]
                            </th>

                            <th style="width: 18%;">
                                @Localizer["ThTenant"]
                            </th>

                            <th style="width: 12%;">
                                @Localizer["ThLocation"]
                            </th>

                            <th style="width: 12%;">
                                @Localizer["ThDate"]
                            </th>

                            <th class="text-center" style="width: 8%;">
                                @Localizer["ThSubmission"]
                            </th>

                            <th class="text-center" style="width: 8%;">
                                @Localizer["ThRegistration"]
                            </th>

                            <th class="text-center" style="width: 10%;">
                                @Localizer["ThStatus"]
                            </th>

                            <th class="text-end pe-4" style="width: 12%; min-width: 180px;">
                                @Localizer["ThActions"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in conferences)
                        {
                            var statusText = GetStatusText(item);
                            var statusClass = GetStatusClass(item);

                            // Siteye giden bağlantı kongrenin kendi slug'ını kullanır.
                            var confSlug = !string.IsNullOrWhiteSpace(item.Slug) ? item.Slug : item.TenantSlug;
                            var hasSlug = !string.IsNullOrWhiteSpace(confSlug);

                            // Admin route'ları kurum slug'ına göre çözülüyor; buraya
                            // kongre slug'ı verilirse aksiyonlar yönlendirip geri atıyor.
                            var adminSlug = item.TenantSlug;
                            var hasAdminSlug = !string.IsNullOrWhiteSpace(adminSlug);

                            var siteUrl = hasSlug
                                ? $"/{confSlug}"
                                : "#";

                            var flowUrl = hasAdminSlug
                                ? $"/{adminSlug}/Admin/ConferenceFlow?conferenceId={item.Id}"
                                : $"/Admin/ConferenceFlow?conferenceId={item.Id}";

                            var editUrl = hasAdminSlug
                                ? $"/{adminSlug}/Admin/Conferences/Edit/{item.Id}"
                                : "#";

                            var tenantUrl = item.TenantId.HasValue
                                ? $"/Admin/Tenants/Details/{item.TenantId.Value}"
                                : "#";

                            <tr>
                                <td class="ps-4">
                                    <div class="conference-profile">
                                        <div class="conference-avatar">
                                            @GetInitial(item.Title)
                                        </div>

                                        <div>
                                            <div class="conference-name">
                                                @item.Title
                                            </div>

                                            <div class="conference-subtitle">
                                                Slug:
                                                @(string.IsNullOrWhiteSpace(item.Slug) ? "-" : item.Slug)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="conference-name">
                                        @item.TenantName
                                    </div>

                                    <div class="conference-subtitle">
                                        @(string.IsNullOrWhiteSpace(item.TenantSlug) ? "-" : "/" + item.TenantSlug)
                                    </div>
                                </td>

                                <td>
                                    <span class="location-pill">
                                        <i class="fas fa-location-dot"></i>
                                        @GetLocation(item)
                                    </span>
                                </td>

                                <td>
                                    <div class="conference-name">
                                        @item.StartDate.ToString("dd.MM.yyyy")
                                    </div>

                                    <div class="conference-subtitle">
                                        @item.EndDate.ToString("dd.MM.yyyy")
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="metric-pill metric-submission">
                                        @item.SubmissionCount
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="metric-pill metric-registration">
                                        @item.RegistrationCount
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="status-badge @statusClass">
                                        <i class="fas fa-circle"></i>
                                        @statusText
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="admin-action-group">

                                        <a href="@flowUrl"
                                           class="admin-action-btn admin-action-flow"
                                           title="@Localizer["ActionFlow"]">
                                            <i class="fas fa-stream"></i>
                                        </a>

                                        @if (hasSlug)
                                        {
                                            <a href="@siteUrl"
                                               target="_blank"
                                               class="admin-action-btn admin-action-site"
                                               title="@Localizer["ActionViewSite"]">
                                                <i class="fas fa-arrow-up-right-from-square"></i>
                                            </a>
                                        }

                                        @if (hasAdminSlug)
                                        {
                                            <a href="@editUrl"
                                               class="admin-action-btn admin-action-edit"
                                               title="@Localizer["ActionSettings"]">
                                                <i class="fas fa-gear"></i>
                                            </a>
                                        }

                                        @if (item.TenantId.HasValue)
                                        {
                                            <a href="@tenantUrl"
                                               class="admin-action-btn admin-action-tenant"
                                               title="@Localizer["ActionTenantDetails"]">
                                                <i class="fas fa-building"></i>
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (pgTotal > 1)
            {
                <nav aria-label="@Localizer["PaginationLabel"]" class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        <li class="page-item @(pgCur > 1 ? "" : "disabled")">
                            <a class="page-link" href="@pgBase&page=@(pgCur - 1)">‹</a>
                        </li>
                        @for (var p = Math.Max(1, pgCur - 2); p <= Math.Min(pgTotal, pgCur + 2); p++)
                        {
                            <li class="page-item @(p == pgCur ? "active" : "")">
                                <a class="page-link" href="@pgBase&page=@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(pgCur < pgTotal ? "" : "disabled")">
                            <a class="page-link" href="@pgBase&page=@(pgCur + 1)">›</a>
                        </li>
                    </ul>
                    <p class="text-center text-muted small">
                        @string.Format(Localizer["PaginationInfo"].Value, pgCount, (pgCur - 1) * pgSize + 1, Math.Min(pgCur * pgSize, pgCount))
                    </p>
                </nav>
            }
        }
    </div>

</div>
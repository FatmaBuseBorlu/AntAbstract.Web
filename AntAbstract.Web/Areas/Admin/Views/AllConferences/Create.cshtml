@using AntAbstract.Domain.Entities
@model Conference
@{
    ViewData["Title"] = "Yeni Kongre Ekle";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var tenants = ViewBag.Tenants as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="container-fluid py-4" style="max-width:760px;">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/Admin/AllConferences" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Tüm Kongreler
        </a>
        <h4 class="fw-bold mb-0">Yeni Kongre Ekle</h4>
    </div>


    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="fw-bold mb-0"><i class="fas fa-calendar-plus me-2 text-primary"></i>Kongre Bilgileri</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert alert-danger border-0 small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Kurum <span class="text-danger">*</span></label>
                    <select asp-for="TenantId" asp-items="tenants" class="form-select">
                        <option value="">— Kurum Seçin —</option>
                    </select>
                    <span asp-validation-for="TenantId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Kongre Adı (TR) <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="Kongre adını girin" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Kongre Adı (EN)</label>
                    <input asp-for="TitleEn" class="form-control" placeholder="Congress name in English" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Slug <span class="text-danger">*</span></label>
                    <input asp-for="Slug" class="form-control" placeholder="ornek-kongre-2026" required />
                    <div class="form-text">URL'de kullanılır — sadece küçük harf, rakam ve tire</div>
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Başlangıç Tarihi <span class="text-danger">*</span></label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Bitiş Tarihi <span class="text-danger">*</span></label>
                        <input asp-for="EndDate" type="date" class="form-control" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Şehir</label>
                        <input asp-for="City" class="form-control" placeholder="İstanbul" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ülke</label>
                        <input asp-for="Country" class="form-control" placeholder="Türkiye" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Mekan</label>
                    <input asp-for="Venue" class="form-control" placeholder="Kongre Merkezi Adı" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-plus me-1"></i> Kongreyi Oluştur
                    </button>
                    <a href="/Admin/AllConferences" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Slug otomatik üret
        document.querySelector('[name="Title"]')?.addEventListener('input', function () {
            const slugInput = document.querySelector('[name="Slug"]');
            if (!slugInput.dataset.touched) {
                slugInput.value = this.value
                    .toLowerCase()
                    .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's')
                    .replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ç/g, 'c')
                    .replace(/[^a-z0-9]+/g, '-')
                    .replace(/^-+|-+$/g, '');
            }
        });
        document.querySelector('[name="Slug"]')?.addEventListener('input', function () {
            this.dataset.touched = '1';
        });
    </script>
}

@model IEnumerable<AntAbstract.Domain.Entities.Registration>
@{
    var conference = ViewBag.Conference as AntAbstract.Domain.Entities.Conference;
    var slug       = ViewBag.Slug as string ?? "";
    var status     = ViewBag.Status as string ?? "all";
    var search     = ViewBag.Search as string ?? "";
    var returnUrl  = Context.Request.Path + Context.Request.QueryString;
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string TabClass(string s) => status == s ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">💳 @Localizer["PageTitle"]</h4>
        <p class="text-muted mb-0">@(conference?.Title ?? "Kongre")</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show">@TempData["InfoMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- İstatistik Kartları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-primary">@ViewBag.TotalCount</div>
            <div class="text-muted small">@Localizer["StatTotal"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-success">@ViewBag.PaidCount</div>
            <div class="text-muted small">@Localizer["StatPaid"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-warning">@ViewBag.ReceiptCount</div>
            <div class="text-muted small">@Localizer["StatReceipt"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-secondary">@ViewBag.PendingCount</div>
            <div class="text-muted small">@Localizer["StatPending"]</div>
        </div>
    </div>
</div>

<!-- Filtreler -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="all"   asp-route-search="@search" class="@TabClass("all")">@Localizer["TabAll"] <span class="badge bg-light text-dark ms-1">@ViewBag.TotalCount</span></a>
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="receipt" asp-route-search="@search" class="@TabClass("receipt")">⚠️ Makbuz Bekleyen <span class="badge bg-warning text-dark ms-1">@ViewBag.ReceiptCount</span></a>
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="paid"    asp-route-search="@search" class="@TabClass("paid")">✅ @Localizer["TabPaid"] <span class="badge bg-success ms-1">@ViewBag.PaidCount</span></a>
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="pending" asp-route-search="@search" class="@TabClass("pending")">⏳ Bekliyor</a>

        <form method="get" class="ms-auto d-flex gap-2">
            <input type="hidden" name="slug" value="@slug" />
            <input type="hidden" name="conferenceId" value="@conference?.Id" />
            <input type="hidden" name="status" value="@status" />
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Ad, e-posta ara..." style="width:220px" />
            <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["SearchButton"]</button>
        </form>
    </div>
</div>

<!-- Kayıt Listesi -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1">💳</div>
                <p>Bu filtreye uygun kayıt bulunamadı.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["ColParticipant"]</th>
                            <th>Kayıt Türü</th>
                            <th class="text-end">@Localizer["ColAmount"]</th>
                            <th class="text-center">@Localizer["ColStatus"]</th>
                            <th class="text-center">Makbuz</th>
                            <th class="text-end">@Localizer["ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model)
                        {
                            var fullName = $"{reg.AppUser?.FirstName} {reg.AppUser?.LastName}".Trim();
                            if (string.IsNullOrWhiteSpace(fullName)) fullName = reg.AppUser?.Email ?? "-";
                            var initial = fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "?";

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                             style="width:36px;height:36px;min-width:36px;background:#1a2d5a;font-size:14px">@initial</div>
                                        <div>
                                            <div class="fw-semibold">@fullName</div>
                                            <small class="text-muted">@reg.AppUser?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>@(reg.RegistrationType?.Name ?? "-")</div>
                                    <small class="text-muted">@reg.RegistrationDate.ToString("dd.MM.yyyy")</small>
                                </td>
                                <td class="text-end fw-semibold">@reg.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    @{
                                        var statusBadge = reg.Status switch
                                        {
                                            AntAbstract.Domain.Entities.RegistrationStatus.Confirmed       => "<span class='badge bg-success'>✅ Onaylandı</span>",
                                            AntAbstract.Domain.Entities.RegistrationStatus.AwaitingApproval => "<span class='badge bg-warning text-dark'>⏳ Onay Bekliyor</span>",
                                            AntAbstract.Domain.Entities.RegistrationStatus.PaymentRejected  => "<span class='badge bg-danger'>❌ Makbuz Reddedildi</span>",
                                            AntAbstract.Domain.Entities.RegistrationStatus.Cancelled        => "<span class='badge bg-dark'>İptal</span>",
                                            _ => reg.IsPaid
                                                ? "<span class='badge bg-success'>✅ Ödendi</span>"
                                                : (reg.ReceiptFilePath != null
                                                    ? "<span class='badge bg-warning text-dark'>⏳ Makbuz Yüklendi</span>"
                                                    : "<span class='badge bg-secondary'>Bekliyor</span>")
                                        };
                                    }
                                    @Html.Raw(statusBadge)
                                    @if (reg.PaymentDate.HasValue && reg.IsPaid)
                                    {
                                        <div><small class="text-muted">@reg.PaymentDate.Value.ToString("dd.MM.yyyy")</small></div>
                                    }
                                    else if (reg.ReceiptUploadedAt.HasValue)
                                    {
                                        <div><small class="text-muted">@reg.ReceiptUploadedAt.Value.ToString("dd.MM.yyyy HH:mm")</small></div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (reg.ReceiptFilePath != null)
                                    {
                                        <a href="/download/receipt/@reg.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                            📄 Görüntüle
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (reg.Status == AntAbstract.Domain.Entities.RegistrationStatus.Cancelled)
                                    {
                                        <span class="text-muted small">İptal edildi</span>
                                    }
                                    else if (!reg.IsPaid)
                                    {
                                        <button type="button" class="btn btn-sm btn-success"
                                                data-bs-toggle="modal" data-bs-target="#approveModal"
                                                data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                            ✅ Onayla
                                        </button>
                                        if (reg.ReceiptFilePath != null)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                    data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                                ❌ Reddet
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-dark ms-1"
                                                data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                            🚫 İptal
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-success small">Tamamlandı</span>
                                        <button type="button" class="btn btn-sm btn-outline-dark ms-1"
                                                data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                            🚫 İptal
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Onay Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">✅ Ödemeyi Onayla</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrationId" id="approveRegId" />
                <input type="hidden" name="returnUrl" id="approveReturnUrl" />
                <div class="modal-body">
                    <p><strong id="approveName"></strong> adlı katılımcının ödemesi onaylanacak.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Yönetici Notu (opsiyonel)</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="Onay açıklaması..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success px-4">Onayla</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reddet Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">❌ Makbuzu Reddet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrationId" id="rejectRegId" />
                <input type="hidden" name="returnUrl" id="rejectReturnUrl" />
                <div class="modal-body">
                    <p><strong id="rejectName"></strong> adlı katılımcının makbuzu reddedilecek ve yeniden yüklemesi istenecek.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Red Nedeni</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="Neden reddedildi?"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-danger px-4">Reddet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- İptal Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">🚫 Kaydı İptal Et</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrationId" id="cancelRegId" />
                <input type="hidden" name="returnUrl" id="cancelReturnUrl" />
                <div class="modal-body">
                    <div class="alert alert-warning py-2 mb-3">
                        <strong id="cancelName"></strong> adlı katılımcının kaydı iptal edilecek. Bu işlem geri alınamaz.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">İptal Nedeni (opsiyonel)</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="İptal açıklaması..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-dark px-4">İptal Et</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('approveModal').addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        document.getElementById('approveRegId').value    = btn.dataset.regId;
        document.getElementById('approveReturnUrl').value = btn.dataset.return;
        document.getElementById('approveName').textContent = btn.dataset.name;
    });
    document.getElementById('rejectModal').addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        document.getElementById('rejectRegId').value    = btn.dataset.regId;
        document.getElementById('rejectReturnUrl').value = btn.dataset.return;
        document.getElementById('rejectName').textContent = btn.dataset.name;
    });
    document.getElementById('cancelModal').addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        document.getElementById('cancelRegId').value    = btn.dataset.regId;
        document.getElementById('cancelReturnUrl').value = btn.dataset.return;
        document.getElementById('cancelName').textContent = btn.dataset.name;
    });
});
</script>
}

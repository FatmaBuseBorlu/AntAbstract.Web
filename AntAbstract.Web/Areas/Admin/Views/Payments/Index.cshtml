@model IEnumerable<AntAbstract.Domain.Entities.Registration>
@{
    var conference = ViewBag.Conference as AntAbstract.Domain.Entities.Conference;
    var slug       = ViewBag.Slug as string ?? "";
    var status     = ViewBag.Status as string ?? "all";
    var search     = ViewBag.Search as string ?? "";
    var returnUrl  = Context.Request.Path + Context.Request.QueryString;
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    string TabClass(string s) => status == s ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">💳 @Localizer["PageTitle"]</h4>
        <p class="text-muted mb-0">@(conference?.Title ?? "Kongre")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="FinanceSummary" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" class="btn btn-outline-success btn-sm">
            <i class="fas fa-chart-line me-1"></i> @Localizer["FinanceSummary"]
        </a>
        <a asp-action="WebhookLog" class="btn btn-outline-primary btn-sm">
            <i class="fab fa-stripe-s me-1"></i> Stripe Webhook Log
        </a>
    </div>
</div>


<!-- İstatistik Kartları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-primary">@ViewBag.TotalCount</div>
            <div class="text-muted small">@Localizer["StatTotal"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-success">@ViewBag.PaidCount</div>
            <div class="text-muted small">@Localizer["StatPaid"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-warning">@ViewBag.ReceiptCount</div>
            <div class="text-muted small">@Localizer["StatReceipt"]</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-secondary">@ViewBag.PendingCount</div>
            <div class="text-muted small">@Localizer["StatPending"]</div>
        </div>
    </div>
</div>

<!-- Filtreler -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="all"   asp-route-search="@search" class="@TabClass("all")">@Localizer["TabAll"] <span class="badge bg-light text-dark ms-1">@ViewBag.TotalCount</span></a>
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="receipt" asp-route-search="@search" class="@TabClass("receipt")">⚠️ @Localizer["TabReceiptPending"] <span class="badge bg-warning text-dark ms-1">@ViewBag.ReceiptCount</span></a>
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="paid"    asp-route-search="@search" class="@TabClass("paid")">✅ @Localizer["TabPaid"] <span class="badge bg-success ms-1">@ViewBag.PaidCount</span></a>
        <a asp-action="Index" asp-route-slug="@slug" asp-route-conferenceId="@conference?.Id" asp-route-status="pending" asp-route-search="@search" class="@TabClass("pending")">⏳ @Localizer["TabPending"]</a>

        <form method="get" class="ms-auto d-flex gap-2">
            <input type="hidden" name="slug" value="@slug" />
            <input type="hidden" name="conferenceId" value="@conference?.Id" />
            <input type="hidden" name="status" value="@status" />
            <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="@Localizer["SearchPlaceholder"]" style="width:220px" />
            <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["SearchButton"]</button>
        </form>
    </div>
</div>

<!-- Kayıt Listesi -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <div class="fs-1">💳</div>
                <p>@Localizer["EmptyMessage"]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["ColParticipant"]</th>
                            <th>@Localizer["ColRegistrationType"]</th>
                            <th class="text-end">@Localizer["ColAmount"]</th>
                            <th class="text-center">@Localizer["ColStatus"]</th>
                            <th class="text-center">@Localizer["ColReceipt"]</th>
                            <th class="text-end">@Localizer["ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reg in Model)
                        {
                            var fullName = $"{reg.AppUser?.FirstName} {reg.AppUser?.LastName}".Trim();
                            if (string.IsNullOrWhiteSpace(fullName)) fullName = reg.AppUser?.Email ?? "-";
                            var initial = fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "?";

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                             style="width:36px;height:36px;min-width:36px;background:#1a2d5a;font-size:14px">@initial</div>
                                        <div>
                                            <div class="fw-semibold">@fullName</div>
                                            <small class="text-muted">@reg.AppUser?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>@(reg.RegistrationType?.Name ?? "-")</div>
                                    <small class="text-muted">@reg.RegistrationDate.ToString("dd.MM.yyyy")</small>
                                </td>
                                <td class="text-end fw-semibold">@reg.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    @{
                                        var statusBadge = reg.Status switch
                                        {
                                            AntAbstract.Domain.Entities.RegistrationStatus.Confirmed       => $"<span class='badge bg-success'>✅ {Localizer["StatusConfirmed"].Value}</span>",
                                            AntAbstract.Domain.Entities.RegistrationStatus.AwaitingApproval => $"<span class='badge bg-warning text-dark'>⏳ {Localizer["StatusAwaitingApproval"].Value}</span>",
                                            AntAbstract.Domain.Entities.RegistrationStatus.PaymentRejected  => $"<span class='badge bg-danger'>❌ {Localizer["StatusReceiptRejected"].Value}</span>",
                                            AntAbstract.Domain.Entities.RegistrationStatus.Cancelled        => $"<span class='badge bg-dark'>{Localizer["StatusCancelled"].Value}</span>",
                                            _ => reg.IsPaid
                                                ? $"<span class='badge bg-success'>✅ {Localizer["StatusPaid"].Value}</span>"
                                                : (reg.ReceiptFilePath != null
                                                    ? $"<span class='badge bg-warning text-dark'>⏳ {Localizer["StatusReceiptUploaded"].Value}</span>"
                                                    : $"<span class='badge bg-secondary'>{Localizer["StatusPending"].Value}</span>")
                                        };
                                    }
                                    @Html.Raw(statusBadge)
                                    @if (reg.PaymentDate.HasValue && reg.IsPaid)
                                    {
                                        <div><small class="text-muted">@reg.PaymentDate.Value.ToString("dd.MM.yyyy")</small></div>
                                    }
                                    else if (reg.ReceiptUploadedAt.HasValue)
                                    {
                                        <div><small class="text-muted">@reg.ReceiptUploadedAt.Value.ToString("dd.MM.yyyy HH:mm")</small></div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (reg.ReceiptFilePath != null)
                                    {
                                        <a href="/download/receipt/@reg.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                            📄 @Localizer["ViewReceiptLink"]
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (reg.Status == AntAbstract.Domain.Entities.RegistrationStatus.Cancelled)
                                    {
                                        <span class="text-muted small">@Localizer["CancelledText"]</span>
                                    }
                                    else if (!reg.IsPaid)
                                    {
                                        <button type="button" class="btn btn-sm btn-success"
                                                data-bs-toggle="modal" data-bs-target="#approveModal"
                                                data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                            ✅ @Localizer["ApproveButton"]
                                        </button>
                                        if (reg.ReceiptFilePath != null)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                    data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                                ❌ @Localizer["RejectButton"]
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-dark ms-1"
                                                data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                            🚫 @Localizer["CancelButton"]
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-success small">@Localizer["CompletedText"]</span>
                                        <a href="@(string.IsNullOrWhiteSpace(slug) ? $"/Admin/Payments/DownloadInvoice/{reg.Id}" : $"/{slug}/Admin/Payments/DownloadInvoice/{reg.Id}")" target="_blank"
                                           class="btn btn-sm btn-outline-success ms-1" title="@Localizer["DownloadInvoice"]">
                                            <i class="fas fa-file-invoice"></i>
                                        </a>
                                        @if (reg.PaymentTransactionId != null)
                                        {
                                            var histPayment = ViewBag.PaymentMap as System.Collections.Generic.Dictionary<string, System.Guid?>;
                                            var payId = histPayment != null && histPayment.ContainsKey(reg.AppUserId ?? "") ? histPayment[reg.AppUserId!] : (System.Guid?)null;
                                            if (payId.HasValue)
                                            {
                                                <a asp-action="History" asp-route-paymentId="@payId"
                                                   class="btn btn-sm btn-outline-info ms-1" title="@Localizer["StatusHistory"]">
                                                    <i class="fas fa-history"></i>
                                                </a>
                                            }
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-dark ms-1"
                                                data-bs-toggle="modal" data-bs-target="#cancelModal"
                                                data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl">
                                            🚫 @Localizer["CancelButton"]
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-info ms-1"
                                                data-bs-toggle="modal" data-bs-target="#refundModal"
                                                data-reg-id="@reg.Id" data-name="@fullName" data-return="@returnUrl"
                                                title="@Localizer["RefundButton"]">
                                            💸 @Localizer["RefundButton"]
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Onay Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">✅ @Localizer["ModalApproveTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrationId" id="approveRegId" />
                <input type="hidden" name="returnUrl" id="approveReturnUrl" />
                <div class="modal-body">
                    <p><strong id="approveName"></strong> @Localizer["ModalApproveBody"]</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">@Localizer["AdminNoteLabel"]</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="@Localizer["ApproveNotePlaceholder"]"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["ModalCancel"]</button>
                    <button type="submit" class="btn btn-success px-4">@Localizer["ApproveButton"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reddet Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">❌ @Localizer["ModalRejectTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrationId" id="rejectRegId" />
                <input type="hidden" name="returnUrl" id="rejectReturnUrl" />
                <div class="modal-body">
                    <p><strong id="rejectName"></strong> @Localizer["ModalRejectBody"]</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">@Localizer["RejectReasonLabel"]</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="@Localizer["RejectReasonPlaceholder"]"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["ModalCancel"]</button>
                    <button type="submit" class="btn btn-danger px-4">@Localizer["RejectButton"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- İptal Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">🚫 @Localizer["ModalCancelTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrationId" id="cancelRegId" />
                <input type="hidden" name="returnUrl" id="cancelReturnUrl" />
                <div class="modal-body">
                    <div class="alert alert-warning py-2 mb-3">
                        <strong id="cancelName"></strong> @Localizer["ModalCancelBody"]
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">@Localizer["CancelReasonLabel"]</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="@Localizer["CancelReasonPlaceholder"]"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["ModalDismiss"]</button>
                    <button type="submit" class="btn btn-dark px-4">@Localizer["CancelConfirmButton"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- İade Modal -->
<div class="modal fade" id="refundModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">💸 @Localizer["ModalRefundTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Refund" asp-route-slug="@slug" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrationId" id="refundRegId" />
                <input type="hidden" name="returnUrl" id="refundReturnUrl" />
                <div class="modal-body">
                    <div class="alert alert-info py-2 mb-3">
                        <strong id="refundName"></strong> @Localizer["ModalRefundBody"]
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">@Localizer["RefundReasonLabel"]</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="@Localizer["RefundReasonPlaceholder"]"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["ModalDismiss"]</button>
                    <button type="submit" class="btn btn-info text-white px-4">@Localizer["RefundConfirmButton"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('approveModal').addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        document.getElementById('approveRegId').value    = btn.dataset.regId;
        document.getElementById('approveReturnUrl').value = btn.dataset.return;
        document.getElementById('approveName').textContent = btn.dataset.name;
    });
    document.getElementById('rejectModal').addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        document.getElementById('rejectRegId').value    = btn.dataset.regId;
        document.getElementById('rejectReturnUrl').value = btn.dataset.return;
        document.getElementById('rejectName').textContent = btn.dataset.name;
    });
    document.getElementById('cancelModal').addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        document.getElementById('cancelRegId').value    = btn.dataset.regId;
        document.getElementById('cancelReturnUrl').value = btn.dataset.return;
        document.getElementById('cancelName').textContent = btn.dataset.name;
    });
    document.getElementById('refundModal').addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        document.getElementById('refundRegId').value    = btn.dataset.regId;
        document.getElementById('refundReturnUrl').value = btn.dataset.return;
        document.getElementById('refundName').textContent = btn.dataset.name;
    });
});
</script>
}

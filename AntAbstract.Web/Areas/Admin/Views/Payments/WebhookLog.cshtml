@using AntAbstract.Domain.Entities
@model List<StripeWebhookEvent>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    int page       = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    int total      = (int)ViewBag.Total;
    string? filterType   = ViewBag.EventType as string;
    string? filterStatus = ViewBag.Status as string;

    var processed = Model.Count(e => e.Status == "processed");
    var failed = Model.Count(e => e.Status == "failed");
    var skipped = Model.Count(e => e.Status == "skipped");
    var stripeCount = Model.Count(e => e.Provider == "Stripe");
    var paytrCount = Model.Count(e => e.Provider == "PayTR");

    string StatusBadge(string s) => s switch
    {
        "processed" => "bg-success",
        "skipped"   => "bg-secondary",
        "failed"    => "bg-danger",
        _           => "bg-light text-dark"
    };

    string ProviderBadge(string p) => p switch
    {
        "PayTR"  => "bg-warning text-dark",
        "Stripe" => "bg-primary",
        _        => "bg-secondary"
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="fas fa-satellite-dish me-2 text-primary"></i>Webhook & Callback Log
            </h3>
            <p class="text-muted mb-0">Toplam <strong>@total</strong> kayıt</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Ödemeler
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fw-bold fs-4 text-success">@processed</div>
                    <div class="text-muted small">Başarılı</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fw-bold fs-4 text-danger">@failed</div>
                    <div class="text-muted small">Başarısız</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fw-bold fs-4 text-primary">@stripeCount</div>
                    <div class="text-muted small">Stripe</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <div class="fw-bold fs-4 text-warning">@paytrCount</div>
                    <div class="text-muted small">PayTR</div>
                </div>
            </div>
        </div>
    </div>

    @* Filtre *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
                <div>
                    <label class="form-label small mb-1">Event Tipi</label>
                    <input name="eventType" value="@filterType" class="form-control form-control-sm"
                           placeholder="checkout.session..." style="width:220px" />
                </div>
                <div>
                    <label class="form-label small mb-1">Durum</label>
                    <select name="status" class="form-select form-select-sm" style="width:140px">
                        <option value="">@Localizer["All"]</option>
                        @if (filterStatus == "processed") { <option value="processed" selected>processed</option> } else { <option value="processed">processed</option> }
                        @if (filterStatus == "skipped")   { <option value="skipped" selected>skipped</option> }   else { <option value="skipped">skipped</option> }
                        @if (filterStatus == "failed")    { <option value="failed" selected>failed</option> }     else { <option value="failed">failed</option> }
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fas fa-search me-1"></i> Filtrele
                    </button>
                    <a href="@Url.Action("WebhookLog")" class="btn btn-outline-secondary btn-sm ms-1">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">@Localizer["Date"]</th>
                            <th>Sağlayıcı</th>
                            <th>Event Tipi</th>
                            <th>Event ID</th>
                            <th>Object ID</th>
                            <th>Payment ID</th>
                            <th>Durum</th>
                            <th>Dup</th>
                            <th>Hata</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">Kayıt bulunamadı.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 text-nowrap">
                                    @item.ReceivedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")
                                </td>
                                <td>
                                    <span class="badge @ProviderBadge(item.Provider)" style="font-size:0.7rem;">@item.Provider</span>
                                </td>
                                <td>
                                    <code class="small">@item.EventType</code>
                                </td>
                                <td>
                                    <span class="text-muted font-monospace" style="font-size:11px">
                                        @item.StripeEventId
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.StripeObjectId))
                                    {
                                        <span class="font-monospace" style="font-size:11px">@item.StripeObjectId</span>
                                    }
                                </td>
                                <td>
                                    @if (item.PaymentId.HasValue)
                                    {
                                        <a asp-action="History"
                                           asp-route-paymentId="@item.PaymentId"
                                           class="font-monospace text-decoration-none"
                                           style="font-size:11px">
                                            @item.PaymentId.Value.ToString("N")[..8]…
                                        </a>
                                    }
                                </td>
                                <td>
                                    <span class="badge @StatusBadge(item.Status)">@item.Status</span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsDuplicate)
                                    {
                                        <i class="fas fa-copy text-warning" title="Tekrar geldi"></i>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                                    {
                                        <span class="text-danger" title="@item.ErrorMessage">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            @(item.ErrorMessage.Length > 60
                                                ? item.ErrorMessage[..60] + "…"
                                                : item.ErrorMessage)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-end mb-0">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("WebhookLog", new { page = p, eventType = filterType, status = filterStatus })">
                            @p
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

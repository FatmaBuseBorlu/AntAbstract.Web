@{
    ViewData["Title"] = "Finans Özeti";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug         = ViewBag.Slug as string ?? "";
    var conference   = ViewBag.Conference as AntAbstract.Domain.Entities.Conference;
    decimal totalRev = (decimal)ViewBag.TotalRevenue;
    decimal pendRev  = (decimal)ViewBag.PendingRevenue;
    int paidCnt      = (int)ViewBag.PaidCount;
    int pendCnt      = (int)ViewBag.PendingCount;
    int cancelCnt    = (int)ViewBag.CancelledCount;
    string currency  = ViewBag.Currency as string ?? "TRY";

    var byMethod = ViewBag.ByMethod as List<object> ?? new();
    var byType   = ViewBag.ByType   as List<object> ?? new();
    var monthly  = ViewBag.Monthly  as List<object> ?? new();

    string IndexUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Payments?conferenceId={conference?.Id}"
        : $"/{slug}/Admin/Payments?conferenceId={conference?.Id}";

    string ExportUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Reports/RevenueExport?format=xlsx"
        : $"/{slug}/Admin/Reports/RevenueExport?format=xlsx";
}

<style>
    .fin-stat-card {
        background: #fff; border: 1px solid #e8eef6; border-radius: 20px;
        padding: 1.25rem 1.5rem; box-shadow: 0 4px 14px rgba(15,23,42,0.04);
    }
    .fin-stat-icon {
        width: 46px; height: 46px; min-width: 46px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    .fin-stat-value { font-size: 1.7rem; font-weight: 900; color: #0f172a; line-height: 1.1; }
    .fin-stat-label { font-size: 0.7rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }
    .fin-stat-sub   { font-size: 0.78rem; color: #94a3b8; font-weight: 600; margin-top: 2px; }

    .fin-section-title { font-size: 0.8rem; font-weight: 800; letter-spacing: 0.04em;
                         text-transform: uppercase; color: #64748b; margin-bottom: 0.75rem; }

    .fin-bar-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .fin-bar-label { min-width: 140px; font-size: 0.83rem; font-weight: 700; color: #334155;
                     white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fin-bar-track { flex: 1; height: 10px; border-radius: 999px; background: #f1f5f9; overflow: hidden; }
    .fin-bar-fill  { height: 100%; border-radius: 999px; }
    .fin-bar-amount{ min-width: 100px; text-align: right; font-size: 0.8rem; font-weight: 800; color: #0f172a; }

    .fin-month-chart { display: flex; align-items: flex-end; gap: 6px; height: 120px; padding-top: 8px; }
    .fin-month-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; height: 100%; }
    .fin-month-bar {
        width: 100%; border-radius: 6px 6px 0 0;
        background: linear-gradient(180deg, #3b82f6, #1d4ed8);
        min-height: 4px; transition: height 0.3s;
    }
    .fin-month-label { font-size: 0.62rem; font-weight: 700; color: #94a3b8; text-align: center; }
</style>

<div class="container-fluid px-4 py-4">

    @* Header *@
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="fas fa-chart-line me-2 text-success"></i>Finans Özeti
            </h4>
            <p class="text-muted small mb-0">@(conference?.Title ?? "")</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@ExportUrl" class="btn btn-outline-success btn-sm">
                <i class="fas fa-file-excel me-1"></i> Excel İndir
            </a>
            <a href="@IndexUrl" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Ödemelere Dön
            </a>
        </div>
    </div>

    @* Stat kartları *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="fin-stat-card">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="fin-stat-icon" style="background:rgba(34,197,94,0.12);color:#16a34a;">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                    <div class="fin-stat-label">Toplam Gelir</div>
                </div>
                <div class="fin-stat-value">@totalRev.ToString("N0")</div>
                <div class="fin-stat-sub">@currency · @paidCnt kayıt</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fin-stat-card">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="fin-stat-icon" style="background:rgba(249,115,22,0.12);color:#ea580c;">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <div class="fin-stat-label">Beklenen Gelir</div>
                </div>
                <div class="fin-stat-value">@pendRev.ToString("N0")</div>
                <div class="fin-stat-sub">@currency · @pendCnt kayıt</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fin-stat-card">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="fin-stat-icon" style="background:rgba(13,110,253,0.12);color:#1d4ed8;">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="fin-stat-label">Ödeme Oranı</div>
                </div>
                @{
                    int total = paidCnt + pendCnt + cancelCnt;
                    int paidPct = total > 0 ? (int)(paidCnt * 100.0 / total) : 0;
                }
                <div class="fin-stat-value">%@paidPct</div>
                <div class="fin-stat-sub">@total toplam kayıt</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fin-stat-card">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="fin-stat-icon" style="background:rgba(239,68,68,0.10);color:#dc2626;">
                        <i class="fas fa-ban"></i>
                    </div>
                    <div class="fin-stat-label">İptal / İade</div>
                </div>
                <div class="fin-stat-value">@cancelCnt</div>
                <div class="fin-stat-sub">kayıt iptal edildi</div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        @* Kayıt tipine göre gelir *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius:16px;">
                <div class="fin-section-title"><i class="fas fa-tags me-1"></i> Kayıt Tipine Göre Gelir</div>
                @if (!byType.Any())
                {
                    <p class="text-muted small">Veri yok.</p>
                }
                else
                {
                    var dynTypes = byType.Select(x => (dynamic)x).ToList();
                    decimal maxType = dynTypes.Max(x => (decimal)x.Total);
                    @foreach (var t in dynTypes)
                    {
                        decimal pct = maxType > 0 ? (decimal)t.Total / maxType * 100 : 0;
                        string tPct = pct.ToString("F0");
                        string tAmt = ((decimal)t.Total).ToString("N0");
                        <div class="fin-bar-row">
                            <div class="fin-bar-label" title="@t.Type">@t.Type</div>
                            <div class="fin-bar-track">
                                <div class="fin-bar-fill" style="width:@(tPct)%;background:linear-gradient(90deg,#3b82f6,#1d4ed8);"></div>
                            </div>
                            <div class="fin-bar-amount">@tAmt <span style="font-size:0.65rem;color:#94a3b8;">@t.Currency</span></div>
                        </div>
                        <div style="font-size:0.72rem;color:#94a3b8;margin:-6px 0 10px 150px;">@t.Count kayıt</div>
                    }
                }
            </div>
        </div>

        @* Ödeme yöntemi dağılımı *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius:16px;">
                <div class="fin-section-title"><i class="fas fa-credit-card me-1"></i> Ödeme Yöntemine Göre</div>
                @if (!byMethod.Any())
                {
                    <p class="text-muted small">Henüz ödeme kaydı yok.</p>
                }
                else
                {
                    var dynMethods = byMethod.Select(x => (dynamic)x).ToList();
                    decimal maxMethod = dynMethods.Max(x => (decimal)x.Total);

                    string MethodColor(string methodName) => methodName switch
                    {
                        var s when s.Contains("Stripe", StringComparison.OrdinalIgnoreCase) => "linear-gradient(90deg,#635bff,#7c6eff)",
                        var s when s.Contains("PayTR",  StringComparison.OrdinalIgnoreCase) => "linear-gradient(90deg,#f59e0b,#d97706)",
                        var s when s.Contains("Banka",  StringComparison.OrdinalIgnoreCase)
                                || s.Contains("Bank",   StringComparison.OrdinalIgnoreCase) => "linear-gradient(90deg,#22c55e,#16a34a)",
                        _ => "linear-gradient(90deg,#64748b,#475569)"
                    };
                    @foreach (var m in dynMethods)
                    {
                        decimal pct = maxMethod > 0 ? (decimal)m.Total / maxMethod * 100 : 0;
                        string mPct   = pct.ToString("F0");
                        string mAmt   = ((decimal)m.Total).ToString("N0");
                        string mColor = MethodColor((string)m.Method);
                        <div class="fin-bar-row">
                            <div class="fin-bar-label" title="@m.Method">@m.Method</div>
                            <div class="fin-bar-track">
                                <div class="fin-bar-fill" style="width:@(mPct)%;background:@mColor;"></div>
                            </div>
                            <div class="fin-bar-amount">@mAmt</div>
                        </div>
                        <div style="font-size:0.72rem;color:#94a3b8;margin:-6px 0 10px 150px;">@m.Count işlem</div>
                    }
                }
            </div>
        </div>

        @* Aylık gelir grafiği *@
        @if (monthly.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4" style="border-radius:16px;">
                    <div class="fin-section-title"><i class="fas fa-chart-bar me-1"></i> Aylık Gelir Trendi</div>
                    @{
                        var dynMonthly = monthly.Select(x => (dynamic)x).ToList();
                        decimal maxMonth = dynMonthly.Max(x => (decimal)x.Total);
                    }
                    <div class="fin-month-chart">
                        @foreach (var m in dynMonthly)
                        {
                            decimal heightPct = maxMonth > 0 ? (decimal)m.Total / maxMonth * 100 : 0;
                            string mLabel = (string)m.Label;
                            string mAmount = ((decimal)m.Total).ToString("N0");
                            string mTitle = $"{mLabel}: {mAmount} {currency}";
                            string mHeight = heightPct.ToString("F0");
                            <div class="fin-month-bar-wrap">
                                <div style="flex:1;display:flex;align-items:flex-end;">
                                    <div class="fin-month-bar" style="height:@(mHeight)%;" title="@mTitle"></div>
                                </div>
                                <div class="fin-month-label">@mLabel</div>
                            </div>
                        }
                    </div>
                    <div class="text-muted" style="font-size:0.75rem;margin-top:6px;">Son 12 ay · @currency</div>
                </div>
            </div>
        }
    </div>
</div>

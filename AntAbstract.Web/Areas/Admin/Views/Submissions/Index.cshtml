@using AntAbstract.Domain.Entities
@using AntAbstract.Web.Models.ViewModels.Admin.Submissions
@using System

@model AdminSubmissionsIndexModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var slug = Model.Slug ?? "";
    var conferenceId = Model.ConferenceId;

    var listUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Submissions?conferenceId={conferenceId}"
        : $"/{slug}/Admin/Submissions?conferenceId={conferenceId}";

    var flowUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow?conferenceId={conferenceId}"
        : $"/{slug}/Admin/ConferenceFlow?conferenceId={conferenceId}";

    var forceSelectUrl = "/Admin/ConferenceFlow?forceSelect=true";

    var siteUrl = string.IsNullOrWhiteSpace(slug)
        ? "#"
        : $"/{slug}";

    string StatusLabel(string? status)
    {
        return status switch
        {
            nameof(SubmissionStatus.New) => Localizer.GetString("StatusNew").Value,
            nameof(SubmissionStatus.Pending) => Localizer.GetString("StatusPending").Value,
            nameof(SubmissionStatus.UnderReview) => Localizer.GetString("StatusUnderReview").Value,
            nameof(SubmissionStatus.Accepted) => Localizer.GetString("StatusAccepted").Value,
            nameof(SubmissionStatus.Rejected) => Localizer.GetString("StatusRejected").Value,
            nameof(SubmissionStatus.RevisionRequired) => Localizer.GetString("StatusRevision").Value,
            nameof(SubmissionStatus.Presented) => Localizer.GetString("StatusPresented").Value,
            _ => string.IsNullOrWhiteSpace(status) ? "Bilinmiyor" : status
        };
    }

    string StatusClass(string? status)
    {
        return status switch
        {
            nameof(SubmissionStatus.New) => "status-new",
            nameof(SubmissionStatus.Pending) => "status-pending",
            nameof(SubmissionStatus.UnderReview) => "status-review",
            nameof(SubmissionStatus.Accepted) => "status-accepted",
            nameof(SubmissionStatus.Rejected) => "status-rejected",
            nameof(SubmissionStatus.RevisionRequired) => "status-revision",
            nameof(SubmissionStatus.Presented) => "status-presented",
            _ => "status-default"
        };
    }

    var totalCount = Model.TotalCount;
}

<div class="container-fluid submissions-index-page">

    <div class="submission-hero-card mb-4">
        <div class="submission-hero-left">
            <div class="submission-hero-icon">
                <i class="fas fa-file-lines"></i>
            </div>

            <div>
                <div class="submission-section-label">
                    @Localizer["ConferenceOps"]
                </div>

                <h2 class="submission-page-title">
                    @Localizer["PageTitle"]
                </h2>

                <p class="submission-page-description">
                    <strong>@Model.ConferenceTitle</strong> @Localizer["PageDescription"]
                </p>

                <div class="selected-conference-pill">
                    <i class="fas fa-calendar-check"></i>

                    <span>
                        @Localizer["SelectedConference"]
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.ConferenceTitle) ? Localizer["NoConferenceSelected"].Value : Model.ConferenceTitle)
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(slug))
                    {
                        <em>
                            /@slug
                        </em>
                    }
                </div>
            </div>
        </div>

        <div class="submission-hero-actions">

            <a href="@flowUrl"
               class="btn submission-light-btn">
                <i class="fas fa-arrow-left me-2"></i>
                @Localizer["BackToFlow"]
            </a>

            <a href="@forceSelectUrl"
               class="btn submission-outline-btn">
                <i class="fas fa-exchange-alt me-2"></i>
                @Localizer["ChangeConference"]
            </a>

            @if (!string.IsNullOrWhiteSpace(slug))
            {
                <a href="@siteUrl"
                   target="_blank"
                   class="btn submission-primary-btn">
                    <i class="fas fa-external-link-alt me-2"></i>
                    @Localizer["ViewSite"]
                </a>
            }

        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl col-md-6">
            <div class="submission-stat-card">
                <div class="stat-icon stat-blue">
                    <i class="fas fa-file-alt"></i>
                </div>

                <div>
                    <div class="stat-number">@Model.AllCount</div>
                    <div class="stat-label">@Localizer["TotalSubmissions"]</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="submission-stat-card">
                <div class="stat-icon stat-cyan">
                    <i class="fas fa-sparkles"></i>
                </div>

                <div>
                    <div class="stat-number">@Model.NewCount</div>
                    <div class="stat-label">@Localizer["NewApplications"]</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="submission-stat-card">
                <div class="stat-icon stat-orange">
                    <i class="fas fa-user-clock"></i>
                </div>

                <div>
                    <div class="stat-number">@Model.UnderReviewCount</div>
                    <div class="stat-label">@Localizer["UnderReview"]</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="submission-stat-card">
                <div class="stat-icon stat-green">
                    <i class="fas fa-circle-check"></i>
                </div>

                <div>
                    <div class="stat-number">@Model.AcceptedCount</div>
                    <div class="stat-label">@Localizer["Accepted"]</div>
                </div>
            </div>
        </div>

        <div class="col-xl col-md-6">
            <div class="submission-stat-card">
                <div class="stat-icon stat-red">
                    <i class="fas fa-times-circle"></i>
                </div>

                <div>
                    <div class="stat-number">@Model.RejectedCount</div>
                    <div class="stat-label">@Localizer["Rejected"]</div>
                </div>
            </div>
        </div>
    </div>

    <div class="submission-filter-card mb-4">
        <form method="get" action="@listUrl">
            <input type="hidden" name="conferenceId" value="@conferenceId" />

            <div class="row g-3 align-items-end">
                <div class="col-xl-4 col-lg-4">
                    <label class="submission-label">
                        @Localizer["Search"]
                    </label>

                    <div class="submission-input-wrap">
                        <i class="fas fa-search"></i>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               placeholder="@Localizer["SearchPlaceholder"]" />
                    </div>
                </div>

                <div class="col-xl-3 col-lg-3">
                    <label class="submission-label">
                        @Localizer["SubmissionStatus"]
                    </label>

                    <select name="status" class="submission-select">
                        <option value="">@Localizer["AllStatuses"]</option>

                        @{
                            var statusOptions = Enum.GetValues(typeof(SubmissionStatus))
                                .Cast<SubmissionStatus>()
                                .ToList();
                        }

                        @foreach (var statusItem in statusOptions)
                        {
                            var value = statusItem.ToString();

                            if (Model.Status == value)
                            {
                                <option value="@value" selected>@StatusLabel(value)</option>
                            }
                            else
                            {
                                <option value="@value">@StatusLabel(value)</option>
                            }
                        }
                    </select>
                </div>

                @if (Model.AvailableTopics.Any())
                {
                    <div class="col-xl-2 col-lg-3">
                        <label class="submission-label">
                            @Localizer["TopicArea"]
                        </label>

                        <select name="topic" class="submission-select">
                            <option value="">@Localizer["AllTopics"]</option>

                            @foreach (var t in Model.AvailableTopics)
                            {
                                if (Model.Topic == t)
                                {
                                    <option value="@t" selected>@t</option>
                                }
                                else
                                {
                                    <option value="@t">@t</option>
                                }
                            }
                        </select>
                    </div>
                }

                <div class="col-xl-2 col-lg-2">
                    <button type="submit" class="btn submission-primary-btn w-100">
                        <i class="fas fa-filter me-2"></i>
                        @Localizer["Filter"]
                    </button>
                </div>

                <div class="col-xl-1 col-lg-1">
                    <a href="@listUrl" class="btn submission-reset-btn w-100" title="@Localizer["ClearFilters"]">
                        <i class="fas fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="submission-list-card">
        <div class="submission-list-header">
            <div>
                <h5>
                    @Localizer["SubmissionList"]
                </h5>

                <p>
                    @Localizer["SubmissionListDesc"]
                </p>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                @{
                    var exportUrl = string.IsNullOrWhiteSpace(slug)
                        ? $"/Admin/Submissions/Export?conferenceId={conferenceId}&search={Model.Search}&status={Model.Status}&topic={Model.Topic}"
                        : $"/{slug}/Admin/Submissions/Export?conferenceId={conferenceId}&search={Model.Search}&status={Model.Status}&topic={Model.Topic}";
                }
                <a href="@exportUrl" class="btn submission-export-btn" title="CSV olarak indir">
                    <i class="fas fa-file-csv me-1"></i>
                    @Localizer["Export"]
                </a>
                <div class="submission-count-pill">
                    @totalCount @Localizer["Submissions"]
                </div>
            </div>
        </div>

        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="submission-empty-state">
                <div class="empty-icon">
                    <i class="fas fa-file-circle-question"></i>
                </div>

                <h4>@Localizer["NoSubmissionsFound"]</h4>

                <p>
                    @Localizer["NoSubmissionsMessage"]
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a href="@listUrl" class="btn submission-primary-btn">
                        <i class="fas fa-rotate-left me-2"></i>
                        @Localizer["ClearFilters"]
                    </a>

                    <a href="@flowUrl" class="btn submission-light-btn">
                        <i class="fas fa-arrow-left me-2"></i>
                        @Localizer["BackToFlow"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="submission-table-wrap">
                <table class="submission-table">
                    <thead>
                        <tr>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Submission"]</th>
                            <th>@Localizer["Author"]</th>
                            <th>@Localizer["Reviewers"]</th>
                            <th>@Localizer["Status"]</th>
                            <th class="text-end actions-cell">@Localizer["Actions"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var detailsUrl = string.IsNullOrWhiteSpace(slug)
                                ? $"/Admin/Submissions/Details/{item.Id}?conferenceId={conferenceId}"
                                : $"/{slug}/Admin/Submissions/Details/{item.Id}?conferenceId={conferenceId}";

                            var assignUrl = string.IsNullOrWhiteSpace(slug)
                                ? $"/Admin/Assignment/Assign/{item.Id}?conferenceId={conferenceId}"
                                : $"/{slug}/Admin/Assignment/Assign/{item.Id}?conferenceId={conferenceId}";

                            var decisionUrl = string.IsNullOrWhiteSpace(slug)
                                ? $"/Admin/Decision?conferenceId={conferenceId}"
                                : $"/{slug}/Admin/Decision?conferenceId={conferenceId}";

                            <tr>
                                <td>
                                    <div class="date-box">
                                        <strong>@item.CreatedAt.ToString("dd.MM.yyyy")</strong>
                                        <span>@item.CreatedAt.ToString("HH:mm")</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="submission-title-cell">
                                        <div class="submission-mini-icon">
                                            <i class="fas fa-file-lines"></i>
                                        </div>

                                        <div>
                                            <strong>@item.Title</strong>
                                            <span>Ref: #@item.Id.ToString().Substring(0, 8).ToUpper()</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="author-cell">
                                        <div class="author-avatar">
                                            <i class="fas fa-user"></i>
                                        </div>

                                        <span>@(string.IsNullOrWhiteSpace(item.AuthorName) ? Localizer["NoAuthorInfo"].Value : item.AuthorName)</span>
                                    </div>
                                </td>

                                <td>
                                    @if (item.AssignedReviewerCount > 0)
                                    {
                                        <span class="reviewer-badge reviewer-badge-assigned">
                                            <i class="fas fa-user-check"></i>
                                            @item.AssignedReviewerCount @Localizer["Referee"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="reviewer-badge reviewer-badge-none">
                                            <i class="fas fa-user-slash"></i>
                                            @Localizer["NotAssigned"]
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="submission-status @StatusClass(item.Status)">
                                        @StatusLabel(item.Status)
                                    </span>
                                </td>

                                <td class="text-end actions-cell">
                                    <div class="submission-actions">
                                        <a href="@detailsUrl" class="btn action-view-btn">
                                            <i class="fas fa-eye"></i>
                                            <span>@Localizer["Review"]</span>
                                        </a>

                                        <button type="button"
                                                class="btn action-more-btn"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            <i class="fas fa-ellipsis-vertical"></i>
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end modern-dropdown">
                                            <li>
                                                <a class="dropdown-item" href="@detailsUrl">
                                                    <i class="fas fa-magnifying-glass me-2"></i>
                                                    @Localizer["ViewDetails"]
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" href="@assignUrl">
                                                    <i class="fas fa-user-check me-2"></i>
                                                    @Localizer["AssignReferee"]
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item" href="@decisionUrl">
                                                    <i class="fas fa-gavel me-2"></i>
                                                    @Localizer["DecisionScreen"]
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                var baseUrl = $"/{Model.Slug}/Admin/Submissions?conferenceId={Model.ConferenceId}&search={Model.Search}&status={Model.Status}";
                <nav aria-label="Bildirim sayfalaması" class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        <li class="page-item @(Model.HasPrev ? "" : "disabled")">
                            <a class="page-link" href="@baseUrl&page=@(Model.Page - 1)">‹</a>
                        </li>
                        @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@baseUrl&page=@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link" href="@baseUrl&page=@(Model.Page + 1)">›</a>
                        </li>
                    </ul>
                    <p class="text-center text-muted small">
                        @Model.TotalCount  @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) 
                    </p>
                </nav>
            }
        }
    </div>

</div>

<style>
    .submissions-index-page {
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .submission-hero-card {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fcff 100%);
        border: 1px solid #e8eef6;
        border-radius: 24px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.055);
    }

    .submission-hero-left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-width: 300px;
        flex: 1;
    }

    .submission-hero-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        border-radius: 19px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.20);
    }

    .submission-section-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.3rem;
    }

    .submission-page-title {
        margin: 0 0 0.25rem;
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1.2;
    }

    .submission-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.55;
    }

    .selected-conference-pill {
        width: fit-content;
        margin-top: 0.55rem;
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        background: rgba(0, 174, 239, 0.10);
        border: 1px solid rgba(0, 174, 239, 0.22);
        color: #0d6efd;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .selected-conference-pill span,
    .selected-conference-pill strong {
        color: #0d6efd;
    }

    .selected-conference-pill em {
        color: #64748b;
        font-style: normal;
        font-weight: 900;
    }

    .submission-hero-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .submission-primary-btn,
    .submission-light-btn,
    .submission-reset-btn,
    .submission-outline-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1rem;
        text-decoration: none;
        font-size: 0.88rem;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .submission-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 10px 24px rgba(13, 110, 253, 0.20);
    }

    .submission-primary-btn:hover {
        color: #ffffff;
        transform: translateY(-1px);
    }

    .submission-light-btn,
    .submission-reset-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

    .submission-light-btn:hover,
    .submission-reset-btn:hover {
        color: #0d6efd;
        background: #f8fbff;
        border-color: rgba(13, 110, 253, 0.25);
        transform: translateY(-1px);
    }

    .submission-outline-btn {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.045);
    }

    .submission-outline-btn:hover {
        color: #0d6efd;
        background: #ffffff;
        border-color: rgba(13, 110, 253, 0.32);
        transform: translateY(-1px);
    }

    .submission-stat-card {
        min-height: 94px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 22px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.045);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .stat-green {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .stat-red {
        background: rgba(239, 68, 68, 0.11);
        color: #dc2626;
    }

    .stat-number {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 0.2rem;
    }

    .stat-label {
        color: #64748b;
        font-size: 0.94rem;
        font-weight: 700;
    }

    .submission-filter-card,
    .submission-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.05);
    }

    .submission-filter-card {
        padding: 1.1rem;
    }

    .submission-label {
        display: block;
        margin-bottom: 0.55rem;
        color: #0f172a;
        font-size: 0.88rem;
        font-weight: 900;
    }

    .submission-input-wrap {
        position: relative;
    }

    .submission-input-wrap i {
        position: absolute;
        top: 50%;
        left: 1rem;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 0.92rem;
    }

    .submission-input-wrap input,
    .submission-select {
        width: 100%;
        min-height: 50px;
        border-radius: 18px;
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 700;
        padding: 0.75rem 1rem;
        outline: none;
        transition: all 0.18s ease;
    }

    .submission-input-wrap input {
        padding-left: 2.65rem;
    }

    .submission-input-wrap input:focus,
    .submission-select:focus {
        border-color: rgba(13, 110, 253, 0.28);
        box-shadow: 0 0 0 0.22rem rgba(13, 110, 253, 0.10);
    }

    .submission-list-header {
        padding: 1.2rem 1.2rem 0.85rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        flex-wrap: wrap;
    }

    .submission-list-header h5 {
        margin: 0 0 0.15rem;
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
    }

    .submission-list-header p {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .submission-count-pill {
        padding: 0.55rem 0.95rem;
        border-radius: 999px;
        border: 1px solid #dbe3ef;
        background: #f8fbff;
        color: #475569;
        font-size: 0.84rem;
        font-weight: 900;
    }

    .submission-empty-state {
        padding: 2.2rem 1.5rem 2rem;
        text-align: center;
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 1rem;
        border-radius: 24px;

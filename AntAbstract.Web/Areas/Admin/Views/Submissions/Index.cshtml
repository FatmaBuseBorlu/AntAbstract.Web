        border-radius: 24px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.055);
    }

    .submission-hero-left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-width: 300px;
        flex: 1;
    }

    .submission-hero-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        border-radius: 19px;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.20);
    }

    .submission-section-label {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.3rem;
    }

    .submission-page-title {
        margin: 0 0 0.25rem;
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1.2;
    }

    .submission-page-description {
        margin: 0;
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.55;
    }

    .submission-slug-badge {
        width: fit-content;
        margin-top: 0.45rem;
        padding: 0.32rem 0.7rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.09);
        color: #0d6efd;
        font-size: 0.74rem;
        font-weight: 900;
    }

    .submission-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .submission-primary-btn,
    .submission-light-btn,
    .submission-reset-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-weight: 900;
        padding: 0 1rem;
        text-decoration: none;
        font-size: 0.88rem;
    }

    .submission-primary-btn {
        border: none;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        box-shadow: 0 10px 24px rgba(13, 110, 253, 0.20);
    }

        .submission-primary-btn:hover {
            color: #ffffff;
            transform: translateY(-1px);
        }

    .submission-light-btn,
    .submission-reset-btn {
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #334155;
    }

        .submission-light-btn:hover,
        .submission-reset-btn:hover {
            color: #0d6efd;
            background: #f8fbff;
            border-color: rgba(13, 110, 253, 0.25);
        }

    .submission-stat-card {
        min-height: 94px;
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 22px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.045);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
    }

    .stat-blue {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .stat-cyan {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .stat-orange {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .stat-green {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .stat-number {
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 900;
        line-height: 1;
    }

    .stat-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 800;
        margin-top: 0.25rem;
    }

    .submission-filter-card,
    .submission-list-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 24px;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.055);
    }

    .submission-filter-card {
        padding: 1.1rem;
    }

    .submission-label {
        display: block;
        color: #0f172a;
        font-size: 0.84rem;
        font-weight: 900;
        margin-bottom: 0.4rem;
    }

    .submission-input-wrap {
        min-height: 46px;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0 0.95rem;
        border: 1px solid #dbe3ef;
        border-radius: 15px;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .submission-input-wrap:focus-within {
            border-color: rgba(13, 110, 253, 0.45);
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.08);
        }

        .submission-input-wrap i {
            color: #94a3b8;
        }

        .submission-input-wrap input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            color: #0f172a;
            font-weight: 700;
            font-size: 0.9rem;
        }

    .submission-select {
        width: 100%;
        min-height: 46px;
        border: 1px solid #dbe3ef;
        border-radius: 15px;
        padding: 0 0.95rem;
        background: #ffffff;
        color: #0f172a;
        font-weight: 800;
        outline: none;
        font-size: 0.9rem;
    }

    .submission-list-card {
        overflow: hidden;
    }

    .submission-list-header {
        padding: 1.2rem 1.35rem;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .submission-list-header h5 {
            margin: 0 0 0.2rem;
            color: #0f172a;
            font-size: 1.15rem;
            font-weight: 900;
        }

        .submission-list-header p {
            margin: 0;
            color: #64748b;
            font-size: 0.86rem;
            font-weight: 600;
        }

    .submission-count-pill {
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .submission-table-wrap {
        overflow-x: auto;
    }

    .submission-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .submission-table thead th {
            padding: 0.9rem 1.25rem;
            background: #f8fafc;
            color: #64748b;
            font-size: 0.74rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #edf2f7;
            white-space: nowrap;
        }

        .submission-table tbody td {
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid #edf2f7;
            vertical-align: middle;
        }

        .submission-table tbody tr {
            transition: all 0.2s ease;
        }

            .submission-table tbody tr:hover {
                background: #f8fbff;
            }

    .date-box strong {
        display: block;
        color: #0f172a;
        font-size: 0.84rem;
        font-weight: 900;
    }

    .date-box span {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 700;
    }

    .submission-title-cell,
    .author-cell,
    .submission-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .submission-actions {
        justify-content: flex-end;
    }

    .submission-mini-icon,
    .author-avatar {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.88rem;
    }

    .submission-mini-icon {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .author-avatar {
        background: rgba(0, 174, 239, 0.10);
        color: #00aeef;
    }

    .submission-title-cell strong {
        display: block;
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 900;
        line-height: 1.35;
    }

    .submission-title-cell span {
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 700;
    }

    .author-cell span {
        color: #334155;
        font-size: 0.88rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .submission-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 28px;
        padding: 0 0.7rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .status-new {
        background: rgba(0, 174, 239, 0.12);
        color: #00aeef;
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .status-review {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .status-accepted {
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
    }

    .status-rejected {
        background: rgba(239, 68, 68, 0.10);
        color: #ef4444;
    }

    .status-revision {
        background: rgba(124, 58, 237, 0.10);
        color: #7c3aed;
    }

    .status-presented {
        background: rgba(20, 184, 166, 0.12);
        color: #14b8a6;
    }

    .status-default {
        background: #f1f5f9;
        color: #475569;
    }

    .action-view-btn {
        min-height: 34px;
        padding: 0 0.75rem;
        border-radius: 11px;
        border: 1px solid rgba(13, 110, 253, 0.22);
        background: rgba(13, 110, 253, 0.06);
        color: #0d6efd;
        font-size: 0.78rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        line-height: 1;
        white-space: nowrap;
    }

        .action-view-btn i {
            font-size: 0.78rem;
            margin: 0 !important;
        }

        .action-view-btn:hover {
            background: #0d6efd;
            color: #ffffff;
        }

    .action-more-btn {
        width: 34px;
        height: 34px;
        min-width: 34px;
        border-radius: 11px;
        border: 1px solid #dbe3ef;
        background: #ffffff;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .action-more-btn:hover {
            color: #0d6efd;
            background: #f8fbff;
            border-color: rgba(13, 110, 253, 0.25);
        }

    .modern-dropdown {

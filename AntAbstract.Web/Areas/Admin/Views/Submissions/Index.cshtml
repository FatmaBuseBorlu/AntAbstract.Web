@using AntAbstract.Web.Models.ViewModels
@model AdminSubmissionsIndexModel

@{
    ViewData["Title"] = "Tüm Başvurular";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">Tüm Başvurular</h3>
            <div class="text-muted">
                Kongre: <span class="badge bg-light text-dark border">@Model.ConferenceTitle</span>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <i class="fas fa-times-circle me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" action="/@slug/Admin/Submissions">
                <input type="hidden" name="conferenceId" value="@Model.ConferenceId" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">Arama</label>
                        <input class="form-control" name="search" value="@Model.Search" placeholder="Başlık, yazar adı, e-posta" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">Durum</label>
                        <select class="form-select" name="status">
                            <option value="">Hepsi</option>
                            <option value="New" selected="@(Model.Status == "New")">New</option>
                            <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                            <option value="UnderReview" selected="@(Model.Status == "UnderReview")">UnderReview</option>
                            <option value="Accepted" selected="@(Model.Status == "Accepted")">Accepted</option>
                            <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                            <option value="RevisionRequired" selected="@(Model.Status == "RevisionRequired")">RevisionRequired</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-grid">
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search me-1"></i> Filtrele
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:140px;">Tarih</th>
                        <th>Başlık</th>
                        <th style="width:260px;">Yazar</th>
                        <th style="width:160px;">Durum</th>
                        <th style="width:220px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="alert alert-info border-0 m-3">
                                    Bu kongrede henüz başvuru yok.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="fw-semibold">@item.Title</td>
                                <td>@item.AuthorName</td>
                                <td>
                                    <span class="badge bg-secondary">@item.Status</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="/@slug/Admin/Submissions/Details/@item.Id?returnUrl=@Uri.EscapeDataString(currentUrl)">
                                            İncele
                                        </a>

                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-dark dropdown-toggle" data-bs-toggle="dropdown">
                                                Durum
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Submissions/ChangeStatus">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="UnderReview" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button class="dropdown-item" type="submit">UnderReview</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Submissions/ChangeStatus">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="Accepted" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button class="dropdown-item text-success" type="submit">Accepted</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Submissions/ChangeStatus">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="Rejected" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button class="dropdown-item text-danger" type="submit">Rejected</button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form method="post" action="/@slug/Admin/Submissions/Delete" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                        <button class="dropdown-item text-danger" type="submit">Sil</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

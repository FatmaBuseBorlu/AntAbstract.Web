@using AntAbstract.Domain.Entities
@using AntAbstract.Infrastructure.Services.Doi
@using System.Linq

@model Submission

@{
    ViewData["Title"] = "Bildiri İnceleme";
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "_LayoutDashboard";

    var slug = ViewBag.Slug as string ?? Model.Conference?.Tenant?.Slug ?? "";
    var conferenceId = ViewBag.ConferenceId is Guid vbConferenceId
        ? vbConferenceId
        : Model.ConferenceId;

    var conferenceTitle = ViewBag.ConferenceTitle as string ?? Model.Conference?.Title ?? "";
    var returnUrl = ViewBag.ReturnUrl as string;

    var listUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : string.IsNullOrWhiteSpace(slug)
            ? $"/Admin/Submissions?conferenceId={conferenceId}"
            : $"/{slug}/Admin/Submissions?conferenceId={conferenceId}";

    var changeStatusUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Submissions/ChangeStatus"
        : $"/{slug}/Admin/Submissions/ChangeStatus";

    var deleteUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Submissions/Delete"
        : $"/{slug}/Admin/Submissions/Delete";

    var assignUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/Assignment/Assign/{Model.Id}?conferenceId={conferenceId}"
        : $"/{slug}/Admin/Assignment/Assign/{Model.Id}?conferenceId={conferenceId}";

    string StatusLabel(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "Yeni",
            SubmissionStatus.Pending => "Beklemede",
            SubmissionStatus.UnderReview => "Hakem Değerlendirmesinde",
            SubmissionStatus.Accepted => "Kabul Edildi",
            SubmissionStatus.Rejected => "Reddedildi",
            SubmissionStatus.RevisionRequired => "Revizyon Gerekli",
            SubmissionStatus.Presented => "Sunuldu",
            _ => status.ToString()
        };
    }

    string StatusClass(SubmissionStatus status)
    {
        return status switch
        {
            SubmissionStatus.New => "status-new",
            SubmissionStatus.Pending => "status-pending",
            SubmissionStatus.UnderReview => "status-review",
            SubmissionStatus.Accepted => "status-accepted",
            SubmissionStatus.Rejected => "status-rejected",
            SubmissionStatus.RevisionRequired => "status-revision",
            SubmissionStatus.Presented => "status-presented",
            _ => "status-default"
        };
    }

    string DoiStatusLabel(DoiStatus status)
    {
        return status switch
        {
            DoiStatus.None => "Hazırlanmadı",
            DoiStatus.Ready => "Metadata Hazır",
            DoiStatus.Assigned => "Atandı",
            DoiStatus.Failed => "Hatalı",
            DoiStatus.ConfigMissing => "Ayar Eksik",
            _ => status.ToString()
        };
    }

    string DoiBadgeClass(DoiStatus status)
    {
        return status switch
        {
            DoiStatus.Ready => "bg-info text-dark",
            DoiStatus.Assigned => "bg-success",
            DoiStatus.Failed => "bg-danger",
            DoiStatus.ConfigMissing => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    var authorFullName = Model.Author == null
        ? "Yazar bilgisi yok"
        : $"{Model.Author.FirstName} {Model.Author.LastName}".Trim();

    if (string.IsNullOrWhiteSpace(authorFullName))
    {
        authorFullName = Model.Author?.Email ?? "Yazar bilgisi yok";
    }

    var files = Model.Files?.ToList() ?? new List<SubmissionFile>();
    var authors = Model.SubmissionAuthors?.OrderBy(x => x.Order).ToList() ?? new List<SubmissionAuthor>();
    var allAssignments   = Model.ReviewAssignments?.ToList() ?? new List<ReviewAssignment>();
    var assignments      = allAssignments.Where(a => !a.IsDeclined).ToList();
    var declinedAssignments = allAssignments.Where(a => a.IsDeclined).ToList();
    var doiMetadata = ViewBag.DoiMetadata as DoiMetadataPreview;
}

<div class="container-fluid submission-detail-page">

    <div class="detail-hero-card mb-4">
        <div class="detail-hero-left">
            <div class="detail-hero-icon">
                <i class="fas fa-magnifying-glass-chart"></i>
            </div>

            <div>
                <div class="detail-section-label">
                    Bildiri İnceleme
                </div>

                <h2 class="detail-page-title">
                    @Model.Title
                </h2>

                <p class="detail-page-description">
                    Ref: #@Model.Id.ToString().Substring(0, 8).ToUpper()
                    @if (!string.IsNullOrWhiteSpace(conferenceTitle))
                    {
                        <span> · @conferenceTitle</span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(slug))
                {
                    <div class="detail-slug-badge">
                        /@slug
                    </div>
                }
            </div>
        </div>

        <div class="detail-hero-actions">
            <a href="@listUrl" class="btn detail-light-btn">
                <i class="fas fa-arrow-left me-2"></i>
                Listeye Dön
            </a>

            <a href="@assignUrl" class="btn detail-primary-btn">
                <i class="fas fa-user-check me-2"></i>
                Hakem Ata
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="detail-card">
                <div class="modern-tabs">
                    <button type="button" class="modern-tab active" data-tab-target="summary">
                        <i class="fas fa-file-lines"></i>
                        Özet
                    </button>

                    <button type="button" class="modern-tab" data-tab-target="authors">
                        <i class="fas fa-users"></i>
                        Yazarlar
                    </button>

                    <button type="button" class="modern-tab" data-tab-target="files">
                        <i class="fas fa-paperclip"></i>
                        Dosyalar
                    </button>
                </div>

                <div class="tab-panel active" id="summary">
                    <div class="submission-summary-box">
                        <h3>@Model.Title</h3>

                        <div class="summary-meta-grid">
                            <div>
                                <span>Konu</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.Topic) ? "Belirtilmedi" : Model.Topic)</strong>
                            </div>

                            <div>
                                <span>Sunum Türü</span>
                                <strong>@Model.PresentationType</strong>
                            </div>

                            <div>
                                <span>Gönderim Tarihi</span>
                                <strong>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</strong>
                            </div>

                            <div>
                                <span>Mevcut Durum</span>
                                <strong>@StatusLabel(Model.Status)</strong>
                            </div>
                        </div>

                        <div class="abstract-box">
                            <div class="content-label">
                                Bildiri Özeti
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(Model.Abstract) ? "Özet bilgisi bulunmuyor." : Model.Abstract)
                            </p>
                        </div>

                        <div class="keywords-box">
                            <span>Anahtar Kelimeler</span>

                            @if (string.IsNullOrWhiteSpace(Model.Keywords))
                            {
                                <strong>Belirtilmedi</strong>
                            }
                            else
                            {
                                var keywords = Model.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries);

                                foreach (var keyword in keywords)
                                {
                                    <strong>@keyword.Trim()</strong>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-panel" id="authors">
                    @if (!authors.Any())
                    {
                        <div class="mini-empty">
                            <i class="fas fa-user-slash"></i>
                            <strong>Yazar bilgisi bulunamadı</strong>
                            <span>Bu bildiriye ait yazar listesi henüz oluşmamış.</span>
                        </div>
                    }
                    else
                    {
                        <div class="author-list">
                            @foreach (var author in authors)
                            {
                                <div class="author-list-item">
                                    <div class="author-avatar">
                                        @(string.IsNullOrWhiteSpace(author.FirstName) ? "Y" : author.FirstName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div class="author-info">
                                        <strong>@author.FirstName @author.LastName</strong>
                                        <span>@author.Email</span>
                                        <small>@author.Institution</small>
                                    </div>

                                    @if (author.IsCorrespondingAuthor)
                                    {
                                        <div class="corresponding-badge">
                                            Sorumlu Yazar
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="tab-panel" id="files">
                    @if (!files.Any())
                    {
                        <div class="mini-empty">
                            <i class="fas fa-file-circle-xmark"></i>
                            <strong>Dosya bulunamadı</strong>
                            <span>Bu bildiriye ait yüklenmiş dosya yok.</span>
                        </div>
                    }
                    else
                    {
                        string TypeLabel(SubmissionFileType t) => t switch
                            {
                                SubmissionFileType.FullText => "Tam Metin",
                                SubmissionFileType.Abstract => "Özet",
                                SubmissionFileType.Presentation => "Sunum",
                                SubmissionFileType.Supplementary => "Ek Dosya",
                                _ => "Dosya"
                            };
                            string TypeIcon(SubmissionFileType t) => t switch
                            {
                                SubmissionFileType.FullText => "fa-file-pdf",
                                SubmissionFileType.Abstract => "fa-file-lines",
                                SubmissionFileType.Presentation => "fa-file-powerpoint",
                                SubmissionFileType.Supplementary => "fa-file-zipper",
                                _ => "fa-file"
                            };
                            string TypeColor(SubmissionFileType t) => t switch
                            {
                                SubmissionFileType.FullText => "#dc2626",
                                SubmissionFileType.Abstract => "#2563eb",
                                SubmissionFileType.Presentation => "#ea580c",
                                SubmissionFileType.Supplementary => "#64748b",
                                _ => "#64748b"
                            };
                            var grouped = files.GroupBy(f => f.Type).OrderBy(g => g.Key);

                        @foreach (var group in grouped)
                        {
                            var sortedVersions = group.OrderByDescending(f => f.Version).ToList();
                            var latest = sortedVersions.First();
                            var hasMultiple = sortedVersions.Count > 1;
                            var collapseId = $"ver-{group.Key}";

                            <div style="margin-bottom:12px;">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                                    <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:@(TypeColor(group.Key))15;color:@TypeColor(group.Key);font-size:0.85rem;">
                                        <i class="fas @TypeIcon(group.Key)"></i>
                                    </span>
                                    <span style="font-weight:800;font-size:0.82rem;color:#334155;">@TypeLabel(group.Key)</span>
                                    <span style="background:#f1f5f9;border-radius:999px;padding:1px 8px;font-size:0.68rem;font-weight:700;color:#64748b;">
                                        @sortedVersions.Count versiyon
                                    </span>
                                </div>

                                @* Son versiyon *@
                                <div class="file-list-item" style="border-left:3px solid @TypeColor(group.Key);">
                                    <div class="file-icon" style="color:@TypeColor(group.Key);">
                                        <i class="fas @TypeIcon(group.Key)"></i>
                                    </div>
                                    <div class="file-info">
                                        <strong>@latest.FileName</strong>
                                        <span>
                                            v@latest.Version · @latest.UploadedAt.ToString("dd.MM.yyyy HH:mm")
                                            <span style="background:#dcfce7;color:#15803d;border-radius:999px;padding:1px 6px;font-size:0.62rem;font-weight:800;margin-left:4px;">Son</span>
                                        </span>
                                    </div>
                                    <a href="/download/submission/@latest.Id" target="_blank" class="btn file-view-btn">
                                        <i class="fas fa-download me-2"></i>Aç
                                    </a>
                                </div>

                                @* Eski versiyonlar *@
                                @if (hasMultiple)
                                {
                                    <div style="margin-top:4px;margin-left:14px;">
                                        <button type="button" class="btn btn-sm btn-link text-muted p-0"
                                                style="font-size:0.74rem;font-weight:700;text-decoration:none;"
                                                data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                            <i class="fas fa-history me-1"></i> Önceki versiyonlar (@(sortedVersions.Count - 1))
                                        </button>
                                        <div class="collapse" id="@collapseId">
                                            @foreach (var older in sortedVersions.Skip(1))
                                            {
                                                <div class="file-list-item" style="opacity:0.7;margin-top:4px;">
                                                    <div class="file-icon" style="color:#94a3b8;">
                                                        <i class="fas @TypeIcon(group.Key)"></i>
                                                    </div>
                                                    <div class="file-info">
                                                        <strong>@older.FileName</strong>
                                                        <span>v@older.Version · @older.UploadedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                                    </div>
                                                    <a href="/download/submission/@older.Id" target="_blank" class="btn file-view-btn">
                                                        <i class="fas fa-download me-2"></i>Aç
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }

                    @{
                        var plagReport = ViewBag.PlagiarismReport as AntAbstract.Domain.Entities.PlagiarismReport;
                        var plagConfigured = (bool)(ViewBag.PlagiarismConfigured ?? false);
                        var hasFullText = files.Any(f => f.Type == SubmissionFileType.FullText);
                        var plagSlug = ViewBag.Slug as string ?? "";
                        var plagReturnUrl = ViewBag.ReturnUrl as string ?? "";
                    }

                    <div style="margin-top:16px;padding:16px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                            <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:#7c3aed15;color:#7c3aed;font-size:0.85rem;">
                                <i class="fas fa-shield-halved"></i>
                            </span>
                            <span style="font-weight:800;font-size:0.85rem;color:#334155;">İntihal Kontrolü</span>
                        </div>

                        @if (plagReport != null)
                        {
                            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                @if (plagReport.Status == AntAbstract.Domain.Entities.PlagiarismStatus.Completed && plagReport.SimilarityScore.HasValue)
                                {
                                    var score = plagReport.SimilarityScore.Value;
                                    var color = score <= 15 ? "#16a34a" : score <= 30 ? "#f59e0b" : "#dc2626";
                                    <div style="display:flex;align-items:center;gap:8px;">
                                        <span style="font-size:1.5rem;font-weight:900;color:@color;">%@score</span>
                                        <span style="font-size:0.75rem;color:#64748b;">benzerlik oranı</span>
                                    </div>
                                    if (!string.IsNullOrWhiteSpace(plagReport.ReportUrl))
                                    {
                                        <a href="@plagReport.ReportUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-external-link-alt me-1"></i>Rapor
                                        </a>
                                    }
                                    <span style="font-size:0.68rem;color:#94a3b8;">@plagReport.CompletedAt?.ToString("dd.MM.yyyy HH:mm")</span>
                                }
                                else if (plagReport.Status == AntAbstract.Domain.Entities.PlagiarismStatus.Processing)
                                {
                                    <span class="spinner-border spinner-border-sm text-primary"></span>
                                    <span style="font-size:0.8rem;color:#64748b;">İşleniyor...</span>
                                    <form method="post" action="@(string.IsNullOrWhiteSpace(plagSlug) ? $"/Admin/Submissions/RefreshPlagiarism/{plagReport.Id}" : $"/{plagSlug}/Admin/Submissions/RefreshPlagiarism/{plagReport.Id}")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@plagReturnUrl" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-sync me-1"></i>Güncelle
                                        </button>
                                    </form>
                                }
                                else if (plagReport.Status == AntAbstract.Domain.Entities.PlagiarismStatus.Failed)
                                {
                                    <span style="font-size:0.8rem;color:#dc2626;">
                                        <i class="fas fa-exclamation-triangle me-1"></i>@(plagReport.ErrorMessage ?? "Hata oluştu")
                                    </span>
                                }
                            </div>
                        }
                        else if (hasFullText && plagConfigured)
                        {
                            <form method="post" action="@(string.IsNullOrWhiteSpace(plagSlug) ? $"/Admin/Submissions/CheckPlagiarism/{Model.Id}" : $"/{plagSlug}/Admin/Submissions/CheckPlagiarism/{Model.Id}")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@plagReturnUrl" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-search me-1"></i>İntihal Kontrolü Başlat
                                </button>
                            </form>
                        }
                        else if (!plagConfigured)
                        {
                            <span style="font-size:0.78rem;color:#94a3b8;">
                                <i class="fas fa-info-circle me-1"></i>İntihal kontrol servisi yapılandırılmamış.
                            </span>
                        }
                        else
                        {
                            <span style="font-size:0.78rem;color:#94a3b8;">
                                <i class="fas fa-info-circle me-1"></i>Tam metin dosyası yüklendikten sonra kontrol başlatılabilir.
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="side-card status-side-card mb-4">
                <div class="side-card-header">
                    <div>
                        <span>Durum Yönetimi</span>
                        <h5>Bildiri Durumu</h5>
                    </div>

                    <div class="status-icon">
                        <i class="fas fa-sliders"></i>
                    </div>
                </div>

                <div class="current-status-box @StatusClass(Model.Status)">
                    <span>Mevcut Durum</span>
                    <strong>@StatusLabel(Model.Status)</strong>
                </div>

                <form method="post" action="@changeStatusUrl" class="status-form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="conferenceId" value="@conferenceId" />
                    <input type="hidden" name="returnUrl" value="@listUrl" />

                    <label>Durumu Değiştir</label>

                    <select name="status" class="detail-select">
                        @foreach (SubmissionStatus statusItem in Enum.GetValues(typeof(SubmissionStatus)))
                        {
                            if (Model.Status == statusItem)
                            {
                                <option value="@statusItem" selected>@StatusLabel(statusItem)</option>
                            }
                            else
                            {
                                <option value="@statusItem">@StatusLabel(statusItem)</option>
                            }
                        }
                    </select>

                    <div class="mt-3">
                        <label class="form-label small fw-semibold text-muted">
                            Yazara Not <small class="fw-normal">(isteğe bağlı)</small>
                        </label>
                        <textarea name="adminNote" class="form-control form-control-sm" rows="3"
                                  placeholder="Karar hakkında yazara iletilecek açıklama..."
                                  maxlength="1000">@(Model.AdminDecisionNote ?? "")</textarea>
                        <div class="form-text">Bu not bildiri detayında yazara gösterilecektir.</div>
                    </div>

                    <button type="submit" class="btn detail-primary-btn w-100 mt-3">
                        <i class="fas fa-save me-2"></i>
                        Durumu Kaydet
                    </button>
                </form>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.RebuttalText))
            {
                <div class="side-card mb-4" style="border-color:rgba(245,158,11,0.28);background:linear-gradient(135deg,rgba(245,158,11,0.06),rgba(249,115,22,0.04));">
                    <div class="side-card-header" style="border-color:rgba(245,158,11,0.18);">
                        <div>
                            <span>Yazar Yanıtı</span>
                            <h5>Rebuttal</h5>
                        </div>
                        <div class="status-icon" style="background:linear-gradient(135deg,#f59e0b,#f97316);">
                            <i class="fas fa-reply"></i>
                        </div>
                    </div>
                    <div style="padding:1rem;">
                        <div style="font-size:0.74rem;color:#94a3b8;font-weight:900;margin-bottom:0.5rem;">
                            @Model.RebuttalDate?.ToString("dd.MM.yyyy HH:mm")
                        </div>
                        <p style="margin:0;color:#334155;font-size:0.88rem;line-height:1.6;">@Model.RebuttalText</p>
                    </div>
                </div>
            }

            @if (Model.Status == SubmissionStatus.Accepted || Model.Status == SubmissionStatus.Presented)
            {
                var doiSlug = ViewBag.Slug as string ?? "";
                var prepareDoiUrl = string.IsNullOrWhiteSpace(doiSlug)
                    ? $"/Admin/Submissions/PrepareDoi/{Model.Id}"
                    : $"/{doiSlug}/Admin/Submissions/PrepareDoi/{Model.Id}";
                var setDoiUrl = string.IsNullOrWhiteSpace(doiSlug)
                    ? $"/Admin/Submissions/SetDoi/{Model.Id}"
                    : $"/{doiSlug}/Admin/Submissions/SetDoi/{Model.Id}";
                <div class="side-card mb-4" style="border-color:rgba(99,102,241,0.28);background:linear-gradient(135deg,rgba(99,102,241,0.06),rgba(139,92,246,0.04));">
                    <div class="side-card-header" style="border-color:rgba(99,102,241,0.18);">
                        <div>
                            <span>Dijital Tanımlayıcı</span>
                            <h5>DOI</h5>
                        </div>
                        <div class="status-icon" style="background:rgba(99,102,241,0.12);color:#6366f1;">
                            <i class="fas fa-fingerprint"></i>
                        </div>
                    </div>

                    <div class="p-3">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                            <span class="badge @DoiBadgeClass(Model.DoiStatus)">
                                @DoiStatusLabel(Model.DoiStatus)
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.DoiProvider))
                            {
                                <span class="text-muted" style="font-size:0.78rem;font-weight:800;">
                                    Provider: @Model.DoiProvider
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.DoiUrl))
                        {
                            <a href="@Model.DoiUrl" target="_blank" class="text-decoration-none fw-bold d-block mb-3" style="font-size:0.85rem;word-break:break-all;">
                                <i class="fas fa-external-link-alt me-1"></i>@Model.DoiUrl
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.DoiErrorMessage))
                        {
                            <div class="alert alert-warning py-2 px-3 mb-3" style="font-size:0.78rem;">
                                <i class="fas fa-triangle-exclamation me-1"></i>@Model.DoiErrorMessage
                            </div>
                        }

                        @if (doiMetadata != null)
                        {
                            <div class="rounded-3 border bg-white p-3 mb-3" style="font-size:0.78rem;">
                                <div class="fw-bold text-muted mb-2">Metadata Önizleme</div>
                                <div class="mb-1"><strong>Başlık:</strong> @doiMetadata.Title</div>
                                <div class="mb-1"><strong>Kongre:</strong> @doiMetadata.ConferenceTitle</div>
                                <div class="mb-1"><strong>Yazarlar:</strong> @(doiMetadata.Authors.Any() ? string.Join(", ", doiMetadata.Authors) : "-")</div>
                                @if (!string.IsNullOrWhiteSpace(doiMetadata.SuggestedDoiUrl))
                                {
                                    <div class="mb-1" style="word-break:break-all;"><strong>Önerilen DOI:</strong> @doiMetadata.SuggestedDoiUrl</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(doiMetadata.LandingUrl))
                                {
                                    <div style="word-break:break-all;"><strong>Landing URL:</strong> @doiMetadata.LandingUrl</div>
                                }
                                @if (doiMetadata.MissingSettings.Any())
                                {
                                    <div class="text-warning fw-bold mt-2">
                                        Eksik ayarlar: @string.Join(", ", doiMetadata.MissingSettings)
                                    </div>
                                }
                            </div>
                        }

                        <form method="post" action="@prepareDoiUrl" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                <i class="fas fa-rotate me-1"></i>Metadata Hazırla / Kontrol Et
                            </button>
                        </form>

                        <form method="post" action="@setDoiUrl">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            <div class="input-group input-group-sm">
                                <input type="url"
                                       name="doiUrl"
                                       class="form-control"
                                       value="@(string.IsNullOrWhiteSpace(Model.DoiUrl) ? doiMetadata?.SuggestedDoiUrl : Model.DoiUrl)"
                                       placeholder="https://doi.org/10.xxxx/..."
                                       required />
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="fas fa-save me-1"></i>Kaydet
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="side-card mb-4">
                <div class="side-card-header">
                    <div>
                        <span>Hakem Değerlendirmeleri</span>
                        <h5>Atama Durumu</h5>
                    </div>

                    <div class="status-icon review-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                </div>

                @if (!assignments.Any())
                {
                    <div class="review-empty">
                        <i class="fas fa-user-clock"></i>
                        <strong>Henüz atama yapılmamış</strong>
                        <span>Bu bildiriye henüz hakem atanmamış.</span>
                    </div>
                }
                else
                {
                    <div class="review-list">
                        @foreach (var assignment in assignments)
                        {
                            var reviewerName = assignment.Reviewer == null
                            ? "Hakem bilgisi yok"
                            : $"{assignment.Reviewer.FirstName} {assignment.Reviewer.LastName}".Trim();

                            if (string.IsNullOrWhiteSpace(reviewerName))
                            {
                                reviewerName = assignment.Reviewer?.Email ?? "Hakem bilgisi yok";
                            }

                            <div class="review-list-item">
                                <div class="reviewer-avatar">
                                    <i class="fas fa-user-check"></i>
                                </div>

                                <div>
                                    <strong>@reviewerName</strong>
                                    <span>
                                        @(assignment.Review == null ? "Değerlendirme bekliyor" : "Değerlendirildi")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (declinedAssignments.Any())
                {
                    <hr class="my-3" />
                    <div class="mb-2">
                        <small class="text-muted fw-semibold">
                            <i class="fas fa-ban me-1 text-danger"></i> Reddeden Hakemler (@declinedAssignments.Count)
                        </small>
                    </div>
                    <div class="review-list">
                        @foreach (var da in declinedAssignments)
                        {
                            var dName = da.Reviewer == null ? "Hakem bilgisi yok"
                                : $"{da.Reviewer.FirstName} {da.Reviewer.LastName}".Trim();
                            if (string.IsNullOrWhiteSpace(dName))
                                dName = da.Reviewer?.Email ?? "Hakem bilgisi yok";

                            <div class="review-list-item" style="opacity:.7">
                                <div class="reviewer-avatar" style="background:#fee2e2;color:#dc2626">
                                    <i class="fas fa-ban"></i>
                                </div>
                                <div>
                                    <strong>@dName</strong>
                                    <span class="text-danger">
                                        Reddetti — @da.DeclinedAt?.ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(da.DeclineReason))
                                    {
                                        <small class="d-block text-muted">@da.DeclineReason</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <a href="@assignUrl" class="btn detail-light-btn w-100 mt-3">
                    <i class="fas fa-plus me-2"></i>
                    Yeni Hakem Ata
                </a>
            </div>

            <div class="side-card danger-card">
                <div class="side-card-header">
                    <div>
                        <span>Silme İşlemi</span>
                        <h5>Bildiri Sil</h5>
                    </div>

                    <div class="status-icon danger-icon">
                        <i class="fas fa-trash"></i>
                    </div>
                </div>

                <p>
                    Bu işlem geri alınamaz. Bildiri ve ilişkili dosya kayıtları silinebilir.
                </p>

                <form method="post" action="@deleteUrl" onsubmit="return confirm('Bu bildiriyi silmek istediğinize emin misiniz?');">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="conferenceId" value="@conferenceId" />
                    <input type="hidden" name="returnUrl" value="@listUrl" />

                    <button type="submit" class="btn danger-delete-btn w-100">
                        <i class="fas fa-trash me-2"></i>
                        Bildiriyi Sil
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>


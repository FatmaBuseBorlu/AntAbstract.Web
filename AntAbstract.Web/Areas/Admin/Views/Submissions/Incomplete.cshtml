@model AntAbstract.Web.Models.ViewModels.Admin.Submissions.IncompleteSubmissionsViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@using Microsoft.AspNetCore.Routing
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["HideSelectedConferenceBar"] = true;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = !string.IsNullOrWhiteSpace(Model.Slug)
        ? Model.Slug
        : Context.GetRouteValue("slug")?.ToString() ?? "";

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? $"/Admin/ConferenceFlow?conferenceId={Model.ConferenceId}"
        : $"/{slug}/Admin/ConferenceFlow?conferenceId={Model.ConferenceId}";

    var baseUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Admin/Submissions/Incomplete"
        : $"/{slug}/Admin/Submissions/Incomplete";

    string FilterUrl(string? missing, int pg = 1)
    {
        var qs = $"?conferenceId={Model.ConferenceId}&page={pg}";
        if (!string.IsNullOrWhiteSpace(missing)) qs += $"&missingFilter={missing}";
        return baseUrl + qs;
    }

    string DetailUrl(Guid id)
    {
        return string.IsNullOrWhiteSpace(slug)
            ? $"/Admin/Submissions/Details/{id}?conferenceId={Model.ConferenceId}"
            : $"/{slug}/Admin/Submissions/Details/{id}?conferenceId={Model.ConferenceId}";
    }

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;
        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }
}

<style>
    .incomplete-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .inc-hero {
        background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.14), transparent 32%),
                    linear-gradient(135deg, #ffffff 0%, #fffdf5 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .inc-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .inc-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(245, 158, 11, 0.28);
    }

    .inc-hero-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .inc-hero-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .inc-hero-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .inc-hero-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .inc-hero-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 1rem;
        font-size: 0.84rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #334155;
    }

    .inc-hero-btn:hover {
        color: #f59e0b;
        border-color: rgba(245, 158, 11, 0.28);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .inc-stat-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.4rem;
    }

    .inc-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        padding: 1.15rem 1.25rem;
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.04);
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: block;
    }

    .inc-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 42px rgba(15, 23, 42, 0.08);
        text-decoration: none;
    }

    .inc-stat-card.active {
        border-color: rgba(245, 158, 11, 0.38);
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.08), rgba(249, 115, 22, 0.05));
    }

    .inc-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .inc-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .inc-si-orange { background: rgba(245, 158, 11, 0.12); color: #d97706; }
    .inc-si-red    { background: rgba(239, 68, 68, 0.12);  color: #dc2626; }
    .inc-si-blue   { background: rgba(13, 110, 253, 0.10); color: #0d6efd; }
    .inc-si-purple { background: rgba(139, 92, 246, 0.12); color: #7c3aed; }

    .inc-stat-val {
        font-size: 1.95rem;
        font-weight: 950;
        color: #0f172a;
        line-height: 1;
    }

    .inc-stat-label {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 850;
        margin-top: 0.3rem;
    }

    .inc-filter-bar {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 0.85rem 1rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-wrap: wrap;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.035);
    }

    .inc-filter-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-right: 0.25rem;
    }

    .inc-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        min-height: 34px;
        border-radius: 999px;
        padding: 0 0.85rem;
        font-size: 0.78rem;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        transition: all 0.18s ease;
    }

    .inc-chip:hover {
        border-color: rgba(245, 158, 11, 0.30);
        color: #d97706;
        background: rgba(245, 158, 11, 0.07);
        text-decoration: none;
    }

    .inc-chip.chip-active {
        background: rgba(245, 158, 11, 0.12);
        border-color: rgba(245, 158, 11, 0.30);
        color: #d97706;
    }

    .inc-table-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .inc-table-header {
        padding: 1.1rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #fffdf5);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .inc-table-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .inc-table-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        box-shadow: 0 10px 22px rgba(245, 158, 11, 0.24);
    }

    .inc-table-title h5 {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        margin: 0 0 0.18rem;
    }

    .inc-table-title p {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 700;
        margin: 0;
    }

    .inc-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 30px;
        padding: 0 0.75rem;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.24);
        color: #d97706;
        font-size: 0.78rem;
        font-weight: 950;
    }

    .inc-table {
        width: 100%;
        border-collapse: collapse;
    }

    .inc-table thead th {
        padding: 0.78rem 1rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        white-space: nowrap;
    }

    .inc-table tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: background 0.15s ease;
    }

    .inc-table tbody tr:hover {
        background: #fffdf5;
    }

    .inc-table tbody tr:last-child {
        border-bottom: none;
    }

    .inc-table td {
        padding: 0.9rem 1rem;
        vertical-align: middle;
        color: #334155;
        font-size: 0.88rem;
        font-weight: 750;
    }

    .submission-id-code {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.22rem 0.65rem;
        color: #475569;
        font-size: 0.74rem;
        font-weight: 900;
        font-family: monospace;
        white-space: nowrap;
    }

    .submission-title-cell {
        max-width: 240px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 850;
        color: #0f172a;
    }

    .author-info {
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
    }

    .author-name {
        color: #0f172a;
        font-weight: 850;
        font-size: 0.86rem;
    }

    .author-email {
        color: #94a3b8;
        font-size: 0.76rem;
        font-weight: 700;
    }

    .missing-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .missing-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        padding: 0.18rem 0.6rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 900;
    }

    .pill-missing {
        background: rgba(239, 68, 68, 0.10);
        border: 1px solid rgba(239, 68, 68, 0.20);
        color: #dc2626;
    }

    .pill-ok {
        background: rgba(34, 197, 94, 0.08);
        border: 1px solid rgba(34, 197, 94, 0.18);
        color: #16a34a;
    }

    .days-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.22rem 0.65rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .days-chip-ok     { background: rgba(34, 197, 94, 0.08);   border: 1px solid rgba(34, 197, 94, 0.18);   color: #16a34a; }
    .days-chip-warn   { background: rgba(245, 158, 11, 0.10);  border: 1px solid rgba(245, 158, 11, 0.22);  color: #d97706; }
    .days-chip-danger { background: rgba(239, 68, 68, 0.10);   border: 1px solid rgba(239, 68, 68, 0.20);   color: #dc2626; }

    .inc-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        min-height: 34px;
        padding: 0 0.8rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 900;
        text-decoration: none;
        border: 1px solid rgba(13, 110, 253, 0.20);
        background: rgba(13, 110, 253, 0.07);
        color: #0d6efd;
        transition: all 0.18s ease;
    }

    .inc-action-btn:hover {
        background: rgba(13, 110, 253, 0.12);
        color: #0b5ed7;
        text-decoration: none;
        transform: translateY(-1px);
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
    }

    .empty-state-icon {
        width: 80px;
        height: 80px;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.10);
        color: #16a34a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1rem;
    }

    .empty-state h5 {
        color: #0f172a;
        font-weight: 900;
        margin-bottom: 0.4rem;
    }

    .empty-state p {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 650;
        max-width: 380px;
        margin: 0 auto;
    }

    .inc-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.35rem;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
        flex-wrap: wrap;
    }

    .inc-page-info {
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 800;
    }

    .inc-page-btns {
        display: flex;
        gap: 0.4rem;
    }

    .inc-page-btn {
        min-height: 34px;
        min-width: 34px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #475569;
        font-size: 0.8rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.6rem;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .inc-page-btn:hover {
        color: #f59e0b;
        border-color: rgba(245, 158, 11, 0.28);
        text-decoration: none;
    }

    .inc-page-btn.disabled {
        opacity: 0.38;
        pointer-events: none;
    }

    @@media (max-width: 992px) {
        .inc-stat-row { grid-template-columns: repeat(2, 1fr); }
        .inc-hero { flex-direction: column; align-items: flex-start; }
    }

    @@media (max-width: 768px) {
        .incomplete-page { padding: 1.5rem 1rem 3rem; }
        .inc-stat-row { grid-template-columns: repeat(2, 1fr); }
        .inc-hero-title { font-size: 1.45rem; }
    }
</style>

<div class="incomplete-page">

    <div class="inc-hero">
        <div class="inc-hero-left">
            <div class="inc-hero-icon">
                <i class="fas fa-triangle-exclamation"></i>
            </div>

            <div>
                <div class="inc-hero-kicker">@L("SectionLabel", "Bildiri Takibi")</div>
                <h3 class="inc-hero-title">@L("PageHeading", "Eksik Bildiriler")</h3>
                <p class="inc-hero-lead">
                    @L("PageLead", "Başlatılmış ancak henüz tamamlanmamış bildirileri takip edin. Eksik alanları tespit edin, yazarlara hatırlatma yapın.")
                </p>
            </div>
        </div>

        <div class="inc-hero-actions">
            <a href="@backUrl" class="inc-hero-btn">
                <i class="fas fa-arrow-left"></i>
                @L("BackToFlowButton", "Kongre Akışına Dön")
            </a>
        </div>
    </div>

    <div class="inc-stat-row">
        <a href="@FilterUrl(null)" class="inc-stat-card @(Model.MissingFilter == null ? "active" : "")">
            <div class="inc-stat-top">
                <div class="inc-stat-icon inc-si-orange">
                    <i class="fas fa-list-check"></i>
                </div>
            </div>
            <div class="inc-stat-val">@Model.TotalCount</div>
            <div class="inc-stat-label">@L("StatTotalIncomplete", "Toplam Eksik Bildiri")</div>
        </a>

        <a href="@FilterUrl("abstract")" class="inc-stat-card @(Model.MissingFilter == "abstract" ? "active" : "")">
            <div class="inc-stat-top">
                <div class="inc-stat-icon inc-si-red">
                    <i class="fas fa-align-left"></i>
                </div>
            </div>
            <div class="inc-stat-val">@Model.NoAbstractCount</div>
            <div class="inc-stat-label">Özet Yazılmamış</div>
        </a>

        <a href="@FilterUrl("file")" class="inc-stat-card @(Model.MissingFilter == "file" ? "active" : "")">
            <div class="inc-stat-top">
                <div class="inc-stat-icon inc-si-blue">
                    <i class="fas fa-file-circle-xmark"></i>
                </div>
            </div>
            <div class="inc-stat-val">@Model.NoFileCount</div>
            <div class="inc-stat-label">Dosya Yüklenmemiş</div>
        </a>

        <a href="@FilterUrl("stale")" class="inc-stat-card @(Model.MissingFilter == "stale" ? "active" : "")">
            <div class="inc-stat-top">
                <div class="inc-stat-icon inc-si-purple">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
            <div class="inc-stat-val">@Model.StaleCount</div>
            <div class="inc-stat-label">7+ Gün Hareketsiz</div>
        </a>
    </div>

    <div class="inc-filter-bar">
        <span class="inc-filter-label">Filtre:</span>
        <a href="@FilterUrl(null)" class="inc-chip @(Model.MissingFilter == null ? "chip-active" : "")">
            <i class="fas fa-list"></i> Tümü (@Model.TotalCount)
        </a>
        <a href="@FilterUrl("abstract")" class="inc-chip @(Model.MissingFilter == "abstract" ? "chip-active" : "")">
            <i class="fas fa-align-left"></i>  (@Model.NoAbstractCount)
        </a>
        <a href="@FilterUrl("file")" class="inc-chip @(Model.MissingFilter == "file" ? "chip-active" : "")">
            <i class="fas fa-file-xmark"></i>  (@Model.NoFileCount)
        </a>
        <a href="@FilterUrl("keywords")" class="inc-chip @(Model.MissingFilter == "keywords" ? "chip-active" : "")">
            <i class="fas fa-tags"></i>  (@Model.NoKeywordsCount)
        </a>
        <a href="@FilterUrl("stale")" class="inc-chip @(Model.MissingFilter == "stale" ? "chip-active" : "")">
            <i class="fas fa-clock"></i> 7+ Gün Hareketsiz (@Model.StaleCount)
        </a>
    </div>

    <div class="inc-table-card">
        <div class="inc-table-header">
            <div class="inc-table-title">
                <div class="inc-table-icon">
                    <i class="fas fa-triangle-exclamation"></i>
                </div>
                <div>
                    <h5>Eksik Bildiri Listesi</h5>
                    <p></p>
                </div>
            </div>
            <span class="inc-count-badge">
                <i class="fas fa-layer-group"></i>
                @Model.FilteredCount kayıt
            </span>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-circle-check"></i>
                </div>
                <h5>Harika! .</h5>
                <p></p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="inc-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>@Localizer["Title"]</th>
                            <th></th>
                            <th>lar</th>
                            <th>Son Aktivite</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="submission-id-code">
                                        #@row.SubmissionIdCode
                                    </span>
                                </td>
                                <td>
                                    <div class="submission-title-cell"
                                         title="@row.Title">
                                        @(string.IsNullOrWhiteSpace(row.Title) ? "" : row.Title)
                                    </div>
                                    <div style="color:#94a3b8;font-size:0.74rem;margin-top:0.15rem;">
                                         @row.CreatedDate.ToString("dd.MM.yyyy")
                                    </div>
                                </td>
                                <td>
                                    <div class="author-info">
                                        <span class="author-name">@(string.IsNullOrWhiteSpace(row.AuthorName) ? "—" : row.AuthorName)</span>
                                        <span class="author-email">@row.AuthorEmail</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="missing-pills">
                                        @if (!row.HasAbstract)
                                        {
                                            <span class="missing-pill pill-missing">
                                                <i class="fas fa-xmark"></i> Özet
                                            </span>
                                        }
                                        @if (!row.HasKeywords)
                                        {
                                            <span class="missing-pill pill-missing">
                                                <i class="fas fa-xmark"></i> Anahtar
                                            </span>
                                        }
                                        @if (!row.HasFile)
                                        {
                                            <span class="missing-pill pill-missing">
                                                <i class="fas fa-xmark"></i> Dosya
                                            </span>
                                        }
                                        @if (!row.HasTopic)
                                        {
                                            <span class="missing-pill pill-missing">
                                                <i class="fas fa-xmark"></i> Konu
                                            </span>
                                        }
                                        @if (!row.HasPresentationType)
                                        {
                                            <span class="missing-pill pill-missing">
                                                <i class="fas fa-xmark"></i> Sunum
                                            </span>
                                        }
                                        @if (row.MissingCount == 0)
                                        {
                                            <span class="missing-pill pill-ok">
                                                <i class="fas fa-check"></i> Tam
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var days = row.DaysSinceActivity;
                                        var daysClass = days >= 14 ? "days-chip-danger" : days >= 7 ? "days-chip-warn" : "days-chip-ok";
                                        var daysIcon = days >= 14 ? "fa-circle-exclamation" : days >= 7 ? "fa-clock" : "fa-circle-check";
                                    }
                                    <span class="days-chip @daysClass">
                                        <i class="fas @daysIcon"></i>
                                        @days gün önce
                                    </span>
                                </td>
                                <td>
                                    <a href="@DetailUrl(row.Id)" class="inc-action-btn">
                                        <i class="fas fa-arrow-up-right-from-square"></i>
                                        İncele
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="inc-pagination">
                    <span class="inc-page-info">
                        @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.FilteredCount)) / @Model.FilteredCount kayıt
                    </span>
                    <div class="inc-page-btns">
                        @if (Model.HasPrev)
                        {
                            <a href="@FilterUrl(Model.MissingFilter, Model.Page - 1)" class="inc-page-btn">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inc-page-btn disabled"><i class="fas fa-chevron-left"></i></span>
                        }

                        @for (int pg = Math.Max(1, Model.Page - 2); pg <= Math.Min(Model.TotalPages, Model.Page + 2); pg++)
                        {
                            if (pg == Model.Page)
                            {
                                <span class="inc-page-btn" style="background:rgba(245,158,11,0.12);border-color:rgba(245,158,11,0.30);color:#d97706;">@pg</span>
                            }
                            else
                            {
                                <a href="@FilterUrl(Model.MissingFilter, pg)" class="inc-page-btn">@pg</a>
                            }
                        }

                        @if (Model.HasNext)
                        {
                            <a href="@FilterUrl(Model.MissingFilter, Model.Page + 1)" class="inc-page-btn">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <span class="inc-page-btn disabled"><i class="fas fa-chevron-right"></i></span>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

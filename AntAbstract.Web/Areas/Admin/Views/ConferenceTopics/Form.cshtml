@using System.Globalization
@using AntAbstract.Web.Models.ViewModels.Admin.ConferenceTopics

@model AdminConferenceTopicFormModel

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";
    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string T(string tr, string en)
    {
        return isEnglish ? en : tr;
    }

    ViewData["Title"] = Model.Id.HasValue
        ? T("Bildiri Konusunu Düzenle", "Edit Abstract Topic")
        : T("Yeni Bildiri Konusu", "Create Abstract Topic");
}

<style>
    .form-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

        .form-section-title i {
            color: #00aeef;
        }

    .form-help-text {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 6px;
    }

    .required-star {
        color: #dc3545;
        font-weight: 700;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px 16px;
        color: #475569;
        font-size: 0.92rem;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                @ViewData["Title"]
            </h3>

            <div class="text-muted">
                @T("Kongre:", "Conference:")
                <span class="badge bg-light text-dark border">
                    @Model.ConferenceTitle
                </span>
            </div>
        </div>

        <a class="btn btn-outline-secondary btn-sm" href="@Model.ReturnUrl">
            <i class="fas fa-arrow-left me-1"></i>
            @T("Geri Dön", "Go Back")
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="info-box mb-4">
                <i class="fas fa-info-circle me-2 text-primary"></i>
                @T(
                "Buraya eklenen konular, yazarın bildiri gönderme formunda seçenek olarak görünecektir.",
                                "Topics added here will appear as selectable options in the author's abstract submission form."
                                )
            </div>

            <form method="post" action="/@slug/Admin/ConferenceTopics/Save">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Slug" />
                <input type="hidden" asp-for="ConferenceId" />
                <input type="hidden" asp-for="ConferenceTitle" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="row g-4">

                    <div class="col-12">
                        <div class="form-section-title">
                            <i class="fas fa-language"></i>
                            <span>@T("Türkçe İçerik", "Turkish Content")</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @T("Konu Adı (TR)", "Topic Name (TR)")
                            <span class="required-star">*</span>
                        </label>

                        <input class="form-control"
                               asp-for="Name"
                               placeholder="@T("Örn: Kırsal Turizm", "Example: Kırsal Turizm")" />

                        <div class="form-help-text">
                            @T(
                                                        "Türkçe arayüzde görünecek konu adıdır.",
                                                        "This is the topic name shown in the Turkish interface."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="Name"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @T("Açıklama (TR)", "Description (TR)")
                        </label>

                        <textarea class="form-control"
                                  asp-for="Description"
                                  rows="3"
                                  placeholder="@T("Örn: Kırsal turizm ve yerel kalkınma üzerine bildiriler.", "Example: Kırsal turizm ve yerel kalkınma üzerine bildiriler.")"></textarea>

                        <div class="form-help-text">
                            @T(
                                                        "İsteğe bağlıdır. Adminin konuyu açıklaması için kullanılabilir.",
                                                        "Optional. It can be used to describe the topic for admins."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="Description"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-globe"></i>
                            <span>@T("İngilizce İçerik", "English Content")</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @T("Konu Adı (EN)", "Topic Name (EN)")
                        </label>

                        <input class="form-control"
                               asp-for="NameEn"
                               placeholder="@T("Örn: Rural Tourism", "Example: Rural Tourism")" />

                        <div class="form-help-text">
                            @T(
                                                        "İngilizce arayüzde görünecek konu adıdır. Boş bırakılırsa Türkçe ad gösterilir.",
                                                        "This is the topic name shown in the English interface. If left empty, the Turkish name will be shown."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="NameEn"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @T("Açıklama (EN)", "Description (EN)")
                        </label>

                        <textarea class="form-control"
                                  asp-for="DescriptionEn"
                                  rows="3"
                                  placeholder="@T("Örn: Abstracts on rural tourism and local development.", "Example: Abstracts on rural tourism and local development.")"></textarea>

                        <div class="form-help-text">
                            @T(
                                                        "İsteğe bağlıdır.",
                                                        "Optional."
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="DescriptionEn"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-sliders-h"></i>
                            <span>@T("Görünürlük ve Sıralama", "Visibility and Ordering")</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @T("Sıralama", "Sort Order")
                        </label>

                        <input class="form-control"
                               asp-for="SortOrder"
                               type="number"
                               min="0"
                               max="9999" />

                        <div class="form-help-text">
                            @T(
                                                        "Küçük sayı daha üstte görünür. Örn: 0, 1, 2",
                                                        "Lower numbers appear first. Example: 0, 1, 2"
                                                        )
                        </div>

                        <span class="text-danger small" asp-validation-for="SortOrder"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input"
                                   asp-for="IsActive"
                                   type="checkbox"
                                   role="switch" />

                            <label class="form-check-label fw-semibold" asp-for="IsActive">
                                @T("Aktif olarak göster", "Show as active")
                            </label>

                            <div class="form-help-text">
                                @T(
                                                                "Pasif yapılırsa yazar bildiri gönderirken bu konuyu seçemez.",
                                                                "If passive, authors cannot select this topic when submitting an abstract."
                                                                )
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Model.ReturnUrl" class="btn btn-light border">
                        @T("Vazgeç", "Cancel")
                    </a>

                    <button class="btn btn-primary px-4" type="submit">
                        <i class="fas fa-save me-1"></i>
                        @T("Kaydet", "Save")
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
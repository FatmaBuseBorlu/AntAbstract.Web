@using AntAbstract.Web.Models.ViewModels.Admin.ConferenceTopics

@model AdminConferenceTopicFormModel

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var slug = Model.Slug ?? "";

    ViewData["Title"] = Model.Id.HasValue
        ? Localizer.GetString("EditPageTitle")
        : Localizer.GetString("CreatePageTitle");
}

<style>
    .form-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

        .form-section-title i {
            color: #00aeef;
        }

    .form-help-text {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 6px;
    }

    .required-star {
        color: #dc3545;
        font-weight: 700;
    }

    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px 16px;
        color: #475569;
        font-size: 0.92rem;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                @ViewData["Title"]
            </h3>

            <div class="text-muted">
                @Localizer["ConferenceLabel"]
                <span class="badge bg-light text-dark border">
                    @Model.ConferenceTitle
                </span>
            </div>
        </div>

        <a class="btn btn-outline-secondary btn-sm" href="@Model.ReturnUrl">
            <i class="fas fa-arrow-left me-1"></i>
            @Localizer["BackButton"]
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <div class="info-box mb-4">
                <i class="fas fa-info-circle me-2 text-primary"></i>
                @Localizer["InfoBoxText"]
            </div>

            <form method="post" action="/@slug/Admin/ConferenceTopics/Save">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Slug" />
                <input type="hidden" asp-for="ConferenceId" />
                <input type="hidden" asp-for="ConferenceTitle" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="row g-4">

                    <div class="col-12">
                        <div class="form-section-title">
                            <i class="fas fa-language"></i>
                            <span>@Localizer["TurkishContentSection"]</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @Localizer["NameTrLabel"]
                            <span class="required-star">*</span>
                        </label>

                        <input class="form-control"
                               asp-for="Name"
                               placeholder="@Localizer["NameTrPlaceholder"]" />

                        <div class="form-help-text">
                            @Localizer["NameTrHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="Name"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @Localizer["DescriptionTrLabel"]
                        </label>

                        <textarea class="form-control"
                                  asp-for="Description"
                                  rows="3"
                                  placeholder="@Localizer["DescriptionTrPlaceholder"]"></textarea>

                        <div class="form-help-text">
                            @Localizer["DescriptionTrHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="Description"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-globe"></i>
                            <span>@Localizer["EnglishContentSection"]</span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @Localizer["NameEnLabel"]
                        </label>

                        <input class="form-control"
                               asp-for="NameEn"
                               placeholder="@Localizer["NameEnPlaceholder"]" />

                        <div class="form-help-text">
                            @Localizer["NameEnHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="NameEn"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">
                            @Localizer["DescriptionEnLabel"]
                        </label>

                        <textarea class="form-control"
                                  asp-for="DescriptionEn"
                                  rows="3"
                                  placeholder="@Localizer["DescriptionEnPlaceholder"]"></textarea>

                        <div class="form-help-text">
                            @Localizer["DescriptionEnHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="DescriptionEn"></span>
                    </div>

                    <div class="col-12 mt-2">
                        <div class="form-section-title">
                            <i class="fas fa-sliders-h"></i>
                            <span>@Localizer["VisibilitySection"]</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            @Localizer["SortOrderLabel"]
                        </label>

                        <input class="form-control"
                               asp-for="SortOrder"
                               type="number"
                               min="0"
                               max="9999" />

                        <div class="form-help-text">
                            @Localizer["SortOrderHelpText"]
                        </div>

                        <span class="text-danger small" asp-validation-for="SortOrder"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input"
                                   asp-for="IsActive"
                                   type="checkbox"
                                   role="switch" />

                            <label class="form-check-label fw-semibold" asp-for="IsActive">
                                @Localizer["IsActiveLabel"]
                            </label>

                            <div class="form-help-text">
                                @Localizer["IsActiveHelpText"]
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Model.ReturnUrl" class="btn btn-light border">
                        @Localizer["CancelButton"]
                    </a>

                    <button class="btn btn-primary px-4" type="submit">
                        <i class="fas fa-save me-1"></i>
                        @Localizer["SaveButton"]
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
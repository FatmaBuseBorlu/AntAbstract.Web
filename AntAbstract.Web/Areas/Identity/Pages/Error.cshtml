@page
@model ErrorModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<h1 class="text-danger">@Localizer["ErrorHeading"]</h1>
<h2 class="text-danger">@Localizer["ErrorDescription"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestIdLabel"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["DevelopmentModeTitle"]</h3>
<p>
    @Localizer["DevelopmentModeText1_Part1"] <strong>Development</strong> @Localizer["DevelopmentModeText1_Part2"]
</p>
<p>
    <strong>@Localizer["DevelopmentModeWarningTitle"]</strong> @Localizer["DevelopmentModeWarningText"]
</p>
@page
@model LogoutModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Çıkış Yapılıyor...";

    HttpContext.Session.Clear();
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Çıkış işlemini tamamlamak için tıklayın</button>
            </form>
        }
        else
        {
            <script>
                // Hafızayı temizledikten sonra kullanıcıyı otomatik olarak Ana Sayfaya (Home) yönlendir.
                window.location.href = "/";
            </script>
            <p>Sistemden başarıyla çıkış yaptınız. Yönlendiriliyorsunuz...</p>
        }
    }
</header>
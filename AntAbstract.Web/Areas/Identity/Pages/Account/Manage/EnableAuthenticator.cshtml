@page
@model EnableAuthenticatorModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="container" style="max-width:720px">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#7c3aed,#a78bfa);display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-shield-halved text-white fs-5"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">@Localizer["PageTitle"]</h4>
                    <p class="text-muted mb-0 small">Google Authenticator veya benzeri bir uygulama kullanın</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2">
                            <span class="badge bg-primary rounded-pill me-1">1</span>
                            Uygulama İndirin
                        </h6>
                        <p class="text-muted small mb-2">
                            Aşağıdaki uygulamalardan birini telefonunuza indirin:
                        </p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" target="_blank"
                               class="btn btn-sm btn-outline-dark">
                                <i class="fab fa-google-play me-1"></i> Google Authenticator
                            </a>
                            <a href="https://apps.apple.com/app/microsoft-authenticator/id983156458" target="_blank"
                               class="btn btn-sm btn-outline-dark">
                                <i class="fab fa-microsoft me-1"></i> Microsoft Authenticator
                            </a>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold mb-2">
                            <span class="badge bg-primary rounded-pill me-1">2</span>
                            QR Kodu Tarayın
                        </h6>
                        <div class="border rounded-3 p-3 text-center bg-white" style="max-width:200px;">
                            <div id="qrCode"></div>
                            <div id="qrCodeData" data-url="@Model.AuthenticatorUri" class="d-none"></div>
                        </div>
                        <div class="mt-2">
                            <details class="small">
                                <summary class="text-muted fw-semibold" style="cursor:pointer">
                                    QR tarayamıyorsanız anahtarı elle girin
                                </summary>
                                <code class="d-block mt-1 p-2 bg-light rounded" style="word-break:break-all;font-size:0.8rem;">
                                    @Model.SharedKey
                                </code>
                            </details>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-bold mb-3">
                        <span class="badge bg-primary rounded-pill me-1">3</span>
                        Doğrulama Kodunu Girin
                    </h6>
                    <p class="text-muted small">
                        Authenticator uygulamanızda görünen 6 haneli kodu aşağıya girin:
                    </p>

                    <form id="send-code" method="post">
                        <div class="mb-3">
                            <input asp-for="Input.Code"
                                   class="form-control form-control-lg text-center fw-bold"
                                   style="letter-spacing:0.3em;font-size:1.5rem;"
                                   autocomplete="off"
                                   maxlength="7"
                                   inputmode="numeric"
                                   placeholder="000 000" />
                            <span asp-validation-for="Input.Code" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                            <i class="fas fa-check-circle me-2"></i>Doğrula ve Etkinleştir
                        </button>

                        <div asp-validation-summary="ModelOnly" class="text-danger mt-2" role="alert"></div>
                    </form>

                    <div class="alert alert-info border-0 mt-4 small">
                        <i class="fas fa-info-circle me-1"></i>
                        2FA etkinleştirdikten sonra her girişte authenticator kodunuz istenecektir.
                        Kurtarma kodlarınızı güvenli bir yerde saklayın.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
            integrity="sha512-CNgIRecGo7nphbeZ04Sc13ka07paqdeTu0WR1IM4kNcpmBAUSHSQX0FslNhTDadL4zsAx4CcQdxOmgPNq5iEg=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        var dataEl = document.getElementById('qrCodeData');
        if (dataEl && dataEl.dataset.url) {
            new QRCode(document.getElementById('qrCode'), {
                text: dataEl.dataset.url,
                width: 160,
                height: 160,
                colorDark: '#1e293b',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.M
            });
        }
    </script>
}

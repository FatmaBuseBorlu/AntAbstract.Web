@page
@model EnableAuthenticatorModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div>
    <p>@Localizer["IntroText"]</p>

    <ol class="list">
        <li>
            <p>
                @Localizer["Step1_Part1"]
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a>
                @Localizer["AndText"]
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>
                @Localizer["Step1_Part2"]
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a>
                @Localizer["AndText"]
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
            </p>
        </li>

        <li>
            <p>
                @Localizer["Step2_Part1"] <kbd>@Model.SharedKey</kbd> @Localizer["Step2_Part2"]
            </p>

            <div class="alert alert-info">
                @Localizer["LearnHowToText"]
                <a href="https://go.microsoft.com/fwlink/?Linkid=852423">@Localizer["EnableQrCodeLink"]</a>.
            </div>

            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>

        <li>
            <p>
                @Localizer["Step3Text"]
            </p>

            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="@Localizer["CodePlaceholder"]" />
                            <label asp-for="Input.Code" class="control-label form-label">
                                @Localizer["VerificationCodeLabel"]
                            </label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>

                        <button type="submit" class="w-100 btn btn-lg btn-primary">
                            @Localizer["VerifyButton"]
                        </button>

                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
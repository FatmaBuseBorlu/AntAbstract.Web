@page
@model PersonalDataModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@Localizer["PageDescription"]</p>
        <p>
            <strong>@Localizer["DeleteWarning"]</strong>
        </p>

        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-primary" type="submit">@Localizer["DownloadButton"]</button>
        </form>

        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">@Localizer["DeleteButton"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();

    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>@Localizer["NoRecoveryCodesTitle"]</strong>
                    <p>
                        @Localizer["NoRecoveryCodesText_Part1"]
                        <a asp-page="./GenerateRecoveryCodes">@Localizer["GenerateRecoveryCodesLink"]</a>
                        @Localizer["NoRecoveryCodesText_Part2"]
                    </p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>@Localizer["OneRecoveryCodeLeftTitle"]</strong>
                    <p>
                        @Localizer["OneRecoveryCodeLeftText_Part1"]
                        <a asp-page="./GenerateRecoveryCodes">@Localizer["GenerateRecoveryCodesLink"]</a>
                        @Localizer["OneRecoveryCodeLeftText_Part2"]
                    </p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>@Localizer["FewRecoveryCodesLeftTitle", Model.RecoveryCodesLeft]</strong>
                    <p>
                        @Localizer["FewRecoveryCodesLeftText_Part1"]
                        <a asp-page="./GenerateRecoveryCodes">@Localizer["GenerateRecoveryCodesLink"]</a>
                        @Localizer["FewRecoveryCodesLeftText_Part2"]
                    </p>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="btn btn-primary">@Localizer["ForgetBrowserButton"]</button>
                </form>
            }

            <a asp-page="./Disable2fa" class="btn btn-primary">@Localizer["Disable2faButton"]</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">@Localizer["ResetRecoveryCodesButton"]</a>
        }

        <h4>@Localizer["AuthenticatorAppHeader"]</h4>

        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">
                @Localizer["AddAuthenticatorAppButton"]
            </a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">
                @Localizer["SetupAuthenticatorAppButton"]
            </a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">
                @Localizer["ResetAuthenticatorAppButton"]
            </a>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>@Localizer["PrivacyPolicyNotAcceptedTitle"]</strong>
            <p>@Localizer["PrivacyPolicyNotAcceptedText"]</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model Disable2faModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@Localizer["WarningTitle"]</strong>
    </p>
    <p>
        @Localizer["WarningText_Part1"]
        <a asp-page="./ResetAuthenticator">@Localizer["ResetAuthenticatorLink"]</a>
        @Localizer["WarningText_Part2"]
    </p>
</div>

<div>
    <form method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-danger" type="submit">@Localizer["DisableButton"]</button>
    </form>
</div>
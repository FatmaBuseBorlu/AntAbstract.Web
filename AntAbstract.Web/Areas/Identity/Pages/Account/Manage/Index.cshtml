@page
@model IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    string T(string key, string fallback)
    {
        var value = Localizer[key]?.Value;

        return string.IsNullOrWhiteSpace(value) || string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    ViewData["Title"] = T("PageTitle", "Hesap Ayarları");
    ViewData["ActivePage"] = ManageNavPages.Index;
    ViewData["HideSelectedConferenceBar"] = true;

    Layout = "_LayoutDashboard";

    var routeSlug = ViewContext.RouteData.Values["slug"]?.ToString();

    var backUrl = User.IsInRole("SuperAdmin")
        ? "/Dashboard/SuperAdmin"
        : string.IsNullOrWhiteSpace(routeSlug)
            ? "/Dashboard"
            : $"/{routeSlug}/Dashboard";

    var profileImage = !string.IsNullOrWhiteSpace(Model.CurrentProfileImage)
        ? Model.CurrentProfileImage
        : null;
}

<div class="profile-settings-page">

    <div class="profile-page-header mb-4">
        <div>
            <div class="text-uppercase text-muted fw-bold small mb-1">
                @T("AccountSectionLabel", "Hesap")
            </div>

            <h2 class="fw-bold mb-2 text-dark">
                @T("PageHeading", "Hesap Ayarları")
            </h2>

            <p class="text-muted mb-0">
                @T("PageDescription", "Profil bilgilerinizi buradan güncelleyebilir ve yönetebilirsiniz.")
            </p>
        </div>

        <a href="@backUrl" class="btn btn-light border rounded-pill px-4 profile-back-btn">
            <i class="fas fa-arrow-left me-2"></i>
            @T("BackToPanelButton", "Panele Dön")
        </a>
    </div>

    <partial name="_StatusMessage" model="Model.StatusMessage" />

    <div class="profile-card">
        <form id="profile-form" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

            <div class="profile-photo-section">
                <div class="avatar-upload">
                    <div class="avatar-edit">
                        <input asp-for="Input.ProfileImage"
                               type="file"
                               id="imageUpload"
                               accept=".png,.jpg,.jpeg,.webp"
                               class="d-none"
                               data-downscale
                               onchange="previewProfileImage(this)" />

                        <label for="imageUpload" aria-label="@T("ChangeProfilePhotoAriaLabel", "Profil fotoğrafını değiştir")">
                            <i class="fas fa-camera"></i>
                        </label>
                    </div>

                    <div class="avatar-preview">
                        @if (!string.IsNullOrWhiteSpace(profileImage))
                        {
                            <img id="imagePreview"
                                 src="@profileImage"
                                 alt="@T("ProfilePhotoAlt", "Profil fotoğrafı")" />
                        }
                        else
                        {
                            <div id="imagePreview" class="avatar-placeholder">
                                <i class="fas fa-user"></i>
                            </div>
                        }
                    </div>
                </div>

                <div class="profile-photo-info">
                    <h5 class="fw-bold text-dark mb-1">
                        @T("ProfilePhotoTitle", "Profil Fotoğrafı")
                    </h5>

                    <p class="text-muted mb-2">
                        @T("ProfilePhotoDescription", "Önerilen: 400x400px kare resim. JPG veya PNG formatında.")
                    </p>

                    <div class="small text-muted">
                        <i class="fas fa-circle-info me-1 text-primary"></i>
                        @T("ProfilePhotoLimitText", "Maksimum dosya boyutu 2 MB olmalıdır.")
                    </div>

                    <span asp-validation-for="Input.ProfileImage" class="text-danger small d-block mt-2"></span>
                </div>
            </div>

            <div class="profile-form-section">
                <div class="section-title">
                    <div>
                        <h5 class="fw-bold mb-1">
                            @T("PersonalInfoTitle", "Kişisel Bilgiler")
                        </h5>

                        <p class="text-muted small mb-0">
                            @T("PersonalInfoDescription", "Panelde görünen temel kullanıcı bilgilerinizi düzenleyin.")
                        </p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-12">
                        <label class="form-label-custom">
                            @T("UsernameEmailLabel", "Kullanıcı Adı / E-Posta")
                        </label>

                        <div class="input-group modern-input-group">
                            <span class="input-group-text">
                                <i class="fas fa-envelope"></i>
                            </span>

                            <input asp-for="Username"
                                   class="form-control form-control-modern"
                                   disabled />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.FirstName" class="form-label-custom">
                            @T("FirstNameLabel", "Adınız")
                        </label>

                        <input asp-for="Input.FirstName"
                               class="form-control form-control-modern"
                               placeholder="@T("FirstNamePlaceholder", "Adınızı yazınız")" />

                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.LastName" class="form-label-custom">
                            @T("LastNameLabel", "Soyadınız")
                        </label>

                        <input asp-for="Input.LastName"
                               class="form-control form-control-modern"
                               placeholder="@T("LastNamePlaceholder", "Soyadınızı yazınız")" />

                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Input.Title" class="form-label-custom">
                            @T("AcademicTitleLabel", "Ünvan")
                        </label>

                        <input asp-for="Input.Title"
                               class="form-control form-control-modern"
                               placeholder="@T("AcademicTitlePlaceholder", "Örn: Dr., Prof. Dr., Super Admin")" />

                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-7">
                        <label asp-for="Input.University" class="form-label-custom">
                            @T("UniversityInstitutionLabel", "Üniversite / Kurum")
                        </label>

                        <input asp-for="Input.University"
                               class="form-control form-control-modern"
                               placeholder="@T("UniversityInstitutionPlaceholder", "Kurum adınızı yazınız")" />

                        <span asp-validation-for="Input.University" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.PhoneNumber" class="form-label-custom">
                            @T("PhoneNumberLabel", "Telefon Numarası")
                        </label>

                        <input asp-for="Input.PhoneNumber"
                               class="form-control form-control-modern"
                               placeholder="@T("PhoneNumberPlaceholder", "Telefon numaranızı yazınız")" />

                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.ExpertiseAreas" class="form-label-custom">
                            @T("ExpertiseAreasLabel", "Uzmanlık Alanları")
                        </label>

                        <textarea asp-for="Input.ExpertiseAreas"
                                  class="form-control form-control-modern"
                                  rows="4"
                                  placeholder="@T("ExpertiseAreasPlaceholder", "Örn: Yapay zeka, web teknolojileri, veri bilimi")"></textarea>

                        <div class="form-text small text-muted mt-2">
                            <i class="fas fa-info-circle me-1"></i>
                            @T("ExpertiseAreasHelpText", "Birden fazla uzmanlık alanını virgül ile ayırabilirsiniz.")
                        </div>

                        <span asp-validation-for="Input.ExpertiseAreas" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @* Akademik Kimlik *@
            <div class="row g-3 mt-1">
                <div class="col-12">
                    <h6 class="fw-semibold text-muted mb-2" style="border-bottom:1px solid #dee2e6;padding-bottom:6px;">
                        <i class="fas fa-id-badge me-1"></i> Akademik Kimlik
                    </h6>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Input.Faculty" class="form-label fw-medium">Fakülte</label>
                        <input asp-for="Input.Faculty" class="form-control" placeholder="Örn: Mühendislik Fakültesi" />
                        <span asp-validation-for="Input.Faculty" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Input.Department" class="form-label fw-medium">Bölüm</label>
                        <input asp-for="Input.Department" class="form-control" placeholder="Örn: Bilgisayar Mühendisliği" />
                        <span asp-validation-for="Input.Department" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="Input.OrcidId" class="form-label fw-medium">
                            ORCID ID
                            <a href="https://orcid.org" target="_blank" rel="noopener" class="text-muted ms-1" title="ORCID nedir?">
                                <i class="fas fa-circle-question small"></i>
                            </a>
                        </label>
                        <input asp-for="Input.OrcidId" class="form-control font-monospace" placeholder="0000-0000-0000-0000" />
                        <span asp-validation-for="Input.OrcidId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="Input.ResearcherId" class="form-label fw-medium">ResearcherID</label>
                        <input asp-for="Input.ResearcherId" class="form-control font-monospace" placeholder="A-0000-0000" />
                        <span asp-validation-for="Input.ResearcherId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label asp-for="Input.GoogleScholarLink" class="form-label fw-medium">Google Scholar</label>
                        <input asp-for="Input.GoogleScholarLink" class="form-control" placeholder="https://scholar.google.com/..." />
                        <span asp-validation-for="Input.GoogleScholarLink" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="profile-actions">
                <a href="@backUrl" class="btn btn-light border rounded-pill px-4">
                    @T("CancelButton", "Vazgeç")
                </a>

                <button id="update-profile-button"
                        type="submit"
                        class="btn btn-primary rounded-pill px-5 profile-save-btn">
                    <i class="fas fa-save me-2"></i>
                    @T("SaveChangesButton", "Değişiklikleri Kaydet")
                </button>
            </div>

            <div class="profile-info-note">
                <div class="profile-info-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>

                <div>
                    <h6 class="fw-bold mb-1">
                        @T("ImportantReminderTitle", "Bilgilendirme")
                    </h6>

                    <div class="small">
                        @T("ImportantReminderText", "Profil bilgileriniz panel genelinde görünen kullanıcı bilgilerinizi etkiler. Profil fotoğrafınız güncellendikten sonra üst menüde de yenilenir.")
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    .profile-settings-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .profile-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .profile-back-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        font-weight: 700;
        color: #64748b;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
    }

    .profile-card {
        background-color: #fff;
        border-radius: 1.4rem;
        border: 1px solid #f1f5f9;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
        padding: 2.5rem;
    }

    .profile-photo-section {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding-bottom: 2rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .avatar-upload {
        position: relative;
        width: 132px;
        min-width: 132px;
    }

    .avatar-preview {
        width: 132px;
        height: 132px;
        border-radius: 50%;
        border: 6px solid #fff;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
        overflow: hidden;
        background-color: #f8fafc;
    }

        .avatar-preview img,
        .avatar-preview .avatar-placeholder {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #cbd5e1;
            font-size: 3rem;
            background: #f8fafc;
        }

    .avatar-edit {
        position: absolute;
        right: 2px;
        bottom: 8px;
        z-index: 2;
    }

        .avatar-edit label {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background-color: #00aeef;
            color: #fff;
            border: 4px solid #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(0, 174, 239, 0.25);
            transition: all 0.2s ease;
        }

            .avatar-edit label:hover {
                background-color: #0095cd;
                transform: scale(1.06);
            }

    .profile-photo-info {
        flex: 1;
        min-width: 240px;
    }

    .profile-form-section {
        margin-top: 1rem;
    }

    .section-title {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .form-label-custom {
        font-weight: 800;
        color: #334155;
        font-size: 0.82rem;
        margin-bottom: 0.45rem;
    }

    .form-control-modern {
        border-radius: 14px;
        padding: 0.85rem 1rem;
        border: 1px solid #dbe3ef;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s ease;
        min-height: 48px;
    }

        .form-control-modern:focus {
            border-color: #00aeef;
            box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.11);
            background-color: #fff;
        }

    .modern-input-group .input-group-text {
        border-radius: 14px 0 0 14px;
        border: 1px solid #dbe3ef;
        border-right: none;
        background-color: #f8fafc;
        color: #64748b;
        padding-left: 1rem;
        padding-right: 0.85rem;
    }

    .modern-input-group .form-control {
        border-left: none;
        border-radius: 0 14px 14px 0;
        background-color: #f8fafc;
    }

    .profile-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        padding-top: 2rem;
        margin-top: 2rem;
        border-top: 1px solid #e2e8f0;
    }

        .profile-actions .btn {
            min-height: 46px;
            font-weight: 800;
        }

    .profile-save-btn {
        background-color: #00aeef;
        border-color: #00aeef;
        box-shadow: 0 10px 22px rgba(0, 174, 239, 0.22);
    }

        .profile-save-btn:hover {
            background-color: #0095cd;
            border-color: #0095cd;
        }

    .profile-info-note {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        margin-top: 2rem;
        padding: 1rem;
        border-radius: 18px;
        background-color: rgba(0, 174, 239, 0.08);
        color: #0369a1;
        border: 1px solid rgba(0, 174, 239, 0.12);
    }

    .profile-info-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 50%;
        background-color: #00aeef;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @@media (max-width: 768px) {
        .profile-card {
            padding: 1.5rem;
        }

        .profile-photo-section {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .profile-actions .btn {
                width: 100%;
            }
    }

    /* Dark Mode */
    [data-theme="dark"] .profile-card {
        background-color: #1e293b; border-color: #334155; color: #cbd5e1;
    }
    [data-theme="dark"] .profile-photo-section { border-color: #334155; }
    [data-theme="dark"] .avatar-preview {
        border-color: #334155; background-color: #0f172a;
    }
    [data-theme="dark"] .avatar-placeholder { color: #475569; }
    [data-theme="dark"] .profile-photo-info h5 { color: #f1f5f9; }
    [data-theme="dark"] .profile-photo-info p,
    [data-theme="dark"] .profile-photo-info small { color: #94a3b8; }
    [data-theme="dark"] .profile-info-note { color: #94a3b8; }
    [data-theme="dark"] .section-title { color: #f1f5f9; }
    [data-theme="dark"] .form-label-modern { color: #94a3b8; }
    [data-theme="dark"] .form-control-modern {
        background-color: #0f172a; border-color: #334155; color: #e2e8f0;
    }
    [data-theme="dark"] .form-control-modern:focus {
        border-color: #38bdf8; box-shadow: 0 0 0 4px rgba(56,189,248,0.1);
        background-color: #0f172a;
    }
    [data-theme="dark"] .modern-input-group .input-group-text {
        background-color: #0f172a; border-color: #334155; color: #64748b;
    }
    [data-theme="dark"] .profile-info-icon { color: #38bdf8; }
</style>

@section Scripts {
    <script src="~/js/image-downscale.js" asp-append-version="true"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewProfileImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    var preview = document.getElementById('imagePreview');

                    if (preview.tagName === 'DIV') {
                        var img = document.createElement('img');
                        img.id = 'imagePreview';
                        img.src = e.target.result;
                        img.alt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T("ProfilePhotoAlt", "Profil fotoğrafı")));

                        preview.parentNode.replaceChild(img, preview);
                    } else {
                        preview.src = e.target.result;
                    }
                };

                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
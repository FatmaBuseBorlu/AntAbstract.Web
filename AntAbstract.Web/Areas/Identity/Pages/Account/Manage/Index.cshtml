@page
@model IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.Index;
    Layout = "_LayoutDashboard";
}

<style>
    .avatar-upload {
        position: relative;
        max-width: 120px;
    }

    .avatar-preview {
        width: 120px;
        height: 120px;
        position: relative;
        border-radius: 50%;
        border: 4px solid #fff;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        overflow: hidden;
    }

        .avatar-preview img, .avatar-preview .avatar-placeholder {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            color: #cbd5e1;
            font-size: 3rem;
        }

    .avatar-edit {
        position: absolute;
        right: 0;
        bottom: 5px;
        z-index: 1;
    }

        .avatar-edit label {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            margin-bottom: 0;
            border-radius: 50%;
            background: #00aeef;
            border: 3px solid #fff;
            color: white;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
        }

            .avatar-edit label:hover {
                background: #008cc1;
                transform: scale(1.1);
            }

    .profile-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        background: #fff;
    }

    .form-control-modern {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #e2e8f0;
        background-color: #fcfcfc;
        transition: all 0.3s;
    }

        .form-control-modern:focus {
            border-color: #00aeef;
            box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
            background-color: #fff;
        }

    .form-label-custom {
        font-weight: 600;
        color: #475569;
        font-size: 0.85rem;
        margin-bottom: 5px;
        margin-left: 5px;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">@Localizer["PageHeading"]</h3>
                    <p class="text-muted mb-0">@Localizer["PageDescription"]</p>
                </div>
                <a href="/Dashboard" class="btn btn-light border fw-bold text-muted rounded-pill px-4 shadow-sm">
                    <i class="fas fa-arrow-left me-2"></i> @Localizer["BackToPanelButton"]
                </a>
            </div>

            <partial name="_StatusMessage" model="Model.StatusMessage" />

            <div class="profile-card p-4 p-md-5">
                <form id="profile-form" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="row align-items-center mb-5 border-bottom pb-5">
                        <div class="col-md-auto text-center mb-3 mb-md-0">
                            <div class="avatar-upload mx-auto">
                                <div class="avatar-edit">
                                    <input asp-for="Input.ProfileImage" type="file" id="imageUpload" accept=".png, .jpg, .jpeg" class="d-none" onchange="previewProfileImage(this)" />
                                    <label for="imageUpload" aria-label="@Localizer["ChangeProfilePhotoAriaLabel"]"><i class="fas fa-camera"></i></label>
                                </div>
                                <div class="avatar-preview shadow-sm">
                                    @if (ViewData["CurrentProfileImage"] != null)
                                    {
                                        <img id="imagePreview" src="@ViewData["CurrentProfileImage"]" alt="@Localizer["ProfilePhotoAlt"]" />
                                    }
                                    else
                                    {
                                        <div id="imagePreview" class="avatar-placeholder">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md">
                            <h5 class="fw-bold text-dark mb-1">@Localizer["ProfilePhotoTitle"]</h5>
                            <p class="text-muted small mb-0">@Localizer["ProfilePhotoDescription"]</p>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            <label class="form-label-custom">@Localizer["UsernameEmailLabel"]</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Username" class="form-control form-control-modern border-start-0 ps-0 bg-light" disabled />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.FirstName" class="form-label-custom">@Localizer["FirstNameLabel"]</label>
                            <input asp-for="Input.FirstName" class="form-control form-control-modern" placeholder="@Localizer["FirstNamePlaceholder"]" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.LastName" class="form-label-custom">@Localizer["LastNameLabel"]</label>
                            <input asp-for="Input.LastName" class="form-control form-control-modern" placeholder="@Localizer["LastNamePlaceholder"]" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.Title" class="form-label-custom">@Localizer["AcademicTitleLabel"]</label>
                            <input asp-for="Input.Title" class="form-control form-control-modern" placeholder="@Localizer["AcademicTitlePlaceholder"]" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Input.University" class="form-label-custom">@Localizer["UniversityInstitutionLabel"]</label>
                            <input asp-for="Input.University" class="form-control form-control-modern" placeholder="@Localizer["UniversityInstitutionPlaceholder"]" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.PhoneNumber" class="form-label-custom">@Localizer["PhoneNumberLabel"]</label>
                            <input asp-for="Input.PhoneNumber" class="form-control form-control-modern" placeholder="@Localizer["PhoneNumberPlaceholder"]" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.ExpertiseAreas" class="form-label-custom">@Localizer["ExpertiseAreasLabel"]</label>
                            <textarea asp-for="Input.ExpertiseAreas" class="form-control form-control-modern" style="height: 100px" placeholder="@Localizer["ExpertiseAreasPlaceholder"]"></textarea>
                            <div class="form-text small text-muted">
                                <i class="fas fa-info-circle me-1"></i> @Localizer["ExpertiseAreasHelpText"]
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-top mt-5">
                        <button id="update-profile-button" type="submit" class="btn btn-primary px-5 py-3 fw-bold rounded-pill shadow-lg transition-all" style="background-color: #00aeef; border: none;">
                            <i class="fas fa-save me-2"></i> @Localizer["SaveChangesButton"]
                        </button>
                    </div>

                    <div class="alert alert-primary bg-opacity-10 border-0 rounded-4 p-4 mt-5 d-flex align-items-start">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center p-2 me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <div class="small text-primary">
                            <h6 class="fw-bold mb-1">@Localizer["ImportantReminderTitle"]</h6>
                            @Localizer["ImportantReminderText"]
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewProfileImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var preview = document.getElementById('imagePreview');
                    if (preview.tagName === 'DIV') {
                        var img = document.createElement('img');
                        img.id = 'imagePreview';
                        img.src = e.target.result;
                        img.alt = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ProfilePhotoAlt"].Value));
                        preview.parentNode.replaceChild(img, preview);
                    } else {
                        preview.src = e.target.result;
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
@page
@model ResetAuthenticatorModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@Localizer["WarningTitle"]</strong>
    </p>
    <p>
        @Localizer["WarningText"]
    </p>
</div>

<div>
    <form id="reset-authenticator-form" method="post">
        @Html.AntiForgeryToken()
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">
            @Localizer["ResetButton"]
        </button>
    </form>
</div>
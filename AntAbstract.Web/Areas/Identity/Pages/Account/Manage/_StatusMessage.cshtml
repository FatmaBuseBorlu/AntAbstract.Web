@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model string

@if (!string.IsNullOrEmpty(Model))
{
    var isError =
        Model.StartsWith("Error", StringComparison.OrdinalIgnoreCase) ||
        Model.StartsWith("Hata", StringComparison.OrdinalIgnoreCase);

    var statusMessageClass = isError ? "danger" : "success";

    <div class="alert alert-@statusMessageClass alert-dismissible" role="alert">
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="@Localizer["CloseAriaLabel"]"></button>
        @Model
    </div>
}
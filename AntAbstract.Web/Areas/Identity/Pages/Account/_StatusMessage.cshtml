@model string
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@if (!string.IsNullOrEmpty(Model))
{
    var isError =
        Model.StartsWith("Error", StringComparison.OrdinalIgnoreCase) ||
        Model.StartsWith("Hata", StringComparison.OrdinalIgnoreCase);

    var statusMessageClass = isError ? "danger" : "success";

    <div class="alert alert-@statusMessageClass alert-dismissible fade show" role="alert">
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="@Localizer["Close"]"></button>
        @Model
    </div>
}
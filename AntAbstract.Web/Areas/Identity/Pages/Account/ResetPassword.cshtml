@page
@model ResetPasswordModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using System
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = null;

    var requestCulture = HttpContext.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var isTurkishCulture = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
    var isEnglishCulture = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var currentReturnUrl = string.IsNullOrEmpty(HttpContext.Request.Path.Value)
        ? "/Identity/Account/ResetPassword"
        : $"{HttpContext.Request.Path.Value}{HttpContext.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc;
            min-height: 100vh;
        }

        .reset-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
        }

        .reset-card {
            width: 100%;
            max-width: 500px;
            background: #fff;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
            border: 1px solid #e2e8f0;
        }

        .brand-logo {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-dark);
            text-decoration: none;
            display: inline-block;
            margin-bottom: 1.5rem;
        }

        .form-control {
            padding: 0.9rem 1rem;
            border-radius: 0.75rem;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
            }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.9rem;
            font-weight: 700;
            border-radius: 0.75rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
            }

        .auth-top-actions {
            position: fixed;
            top: 24px;
            right: 28px;
            z-index: 50;
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .auth-language-switcher {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            border: 1px solid var(--border-color);
            border-radius: 999px;
            background-color: #ffffff;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        }

            .auth-language-switcher form {
                margin: 0;
            }

        .auth-lang-btn {
            border: none;
            background-color: transparent;
            color: #64748b;
            font-size: 0.86rem;
            font-weight: 800;
            padding: 0.55rem 0.9rem;
            border-radius: 999px;
            cursor: pointer;
            transition: all 0.2s ease;
            line-height: 1;
        }

            .auth-lang-btn:hover {
                background-color: #f1f5f9;
                color: var(--primary-color);
            }

            .auth-lang-btn.active {
                background-color: var(--primary-color);
                color: #ffffff;
                box-shadow: 0 6px 16px rgba(0, 174, 239, 0.25);
            }

        .auth-close-link {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.55rem 0.9rem;
            border-radius: 999px;
            color: #64748b;
            background-color: transparent;
            font-size: 0.9rem;
            font-weight: 800;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .auth-close-link:hover {
                color: #ef4444;
                background-color: rgba(239, 68, 68, 0.08);
            }

        @@media (max-width: 768px) {
            .auth-top-actions {
                top: 16px;
                right: 16px;
                gap: 0.5rem;
            }

            .auth-close-link span {
                display: none;
            }

            .auth-language-switcher {
                padding: 3px;
            }

            .auth-lang-btn {
                padding: 0.5rem 0.75rem;
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>

    <div class="auth-top-actions">
        <div class="auth-language-switcher">
            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="culture" value="tr-TR" />
                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                <button type="submit"
                        class="auth-lang-btn @(isTurkishCulture ? "active" : "")">
                    TR
                </button>
            </form>

            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="culture" value="en-US" />
                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                <button type="submit"
                        class="auth-lang-btn @(isEnglishCulture ? "active" : "")">
                    EN
                </button>
            </form>
        </div>

        <a href="/" class="auth-close-link">
            <i class="fas fa-times"></i>
            <span>@Localizer["Close"]</span>
        </a>
    </div>

    <div class="reset-wrapper">
        <div class="reset-card">
            <a href="/" class="brand-logo">
                ANT<span style="color: #00aeef;">ABSTRACT</span>
            </a>

            <div class="mb-4">
                <h1 class="h3 fw-bold text-dark mb-2">@Localizer["PageTitle"]</h1>
                <p class="text-muted mb-0">@Localizer["PageDescription"]</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger border-0 rounded-3 small mb-4"
                     role="alert">
                </div>

                <input asp-for="Input.Code" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-bold text-muted">
                        @Localizer["EmailAddress"]
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="@Localizer["EmailPlaceholder"]" />

                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-bold text-muted">
                        @Localizer["NewPassword"]
                    </label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="@Localizer["NewPasswordPlaceholder"]" />

                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-bold text-muted">
                        @Localizer["ConfirmPassword"]
                    </label>

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="@Localizer["ConfirmPasswordPlaceholder"]" />

                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">
                    @Localizer["ResetButton"]
                </button>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
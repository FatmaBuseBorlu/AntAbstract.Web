@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #fff;
            height: 100vh;
            overflow: hidden;
        }

        .register-wrapper {
            height: 100vh;
            display: flex;
            width: 100%;
        }

        .register-sidebar {
            width: 40%;
            background: url('https://images.unsplash.com/photo-1523580494863-6f3031224c94?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 3rem;
            color: white;
        }

            .register-sidebar::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(to bottom, rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.95));
            }

        .sidebar-content {
            position: relative;
            z-index: 2;
        }

        .register-form-container {
            width: 60%;
            display: flex;
            justify-content: center;
            padding: 2rem;
            background-color: #fff;
            position: relative;
            overflow-y: auto;
        }

        .register-card {
            width: 100%;
            max-width: 700px;
            padding-top: 1rem;
            padding-bottom: 2rem;
        }

        .form-control, .custom-select {
            padding: 0.7rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            font-weight: 500;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

            .form-control:focus, .custom-select:focus {
                background-color: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
                outline: none;
            }

        .form-label {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.8rem;
            font-weight: 700;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
            }

        .brand-logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 1.5rem;
            display: inline-block;
            text-decoration: none;
        }

        @@media (max-width: 991px) {
            .register-sidebar {
                display: none;
            }

            .register-form-container {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="register-wrapper">

        <div class="register-sidebar animate__animated animate__fadeIn">
            <div class="sidebar-content">
                <div class="mb-4">
                    <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fas fa-users me-2"></i>Akademik Ağ
                    </span>
                    <h1 class="display-5 fw-bold mb-3">Bilim Dünyasının <br> Parçası Olun.</h1>
                    <p class="lead opacity-75 fs-6">
                        Hesabınızı oluşturun ve binlerce akademisyenin yer aldığı bu büyük ağa hemen katılın.
                    </p>
                </div>
                <div class="d-flex gap-2 opacity-50 small">
                    <span>&copy; @DateTime.Now.Year AntAbstract</span>
                </div>
            </div>
        </div>

        <div class="register-form-container">
            <a href="/" class="position-absolute top-0 end-0 m-4 text-muted text-decoration-none small fw-bold">
                <i class="fas fa-times me-1"></i> KAPAT
            </a>

            <div class="register-card animate__animated animate__fadeInRight">

                <a href="/" class="brand-logo">
                    ANT<span style="color: var(--primary-color);">ABSTRACT</span>
                </a>

                <div class="mb-4">
                    <h3 class="fw-bold text-dark">Aramıza Katılın 🚀</h3>
                    <p class="text-muted small">Kongre sistemine tam erişim için formu eksiksiz doldurunuz.</p>
                </div>

                <form asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.FirstName" class="form-label">İsim <span class="text-danger">*</span></label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="Adınız" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.LastName" class="form-label">Soyisim <span class="text-danger">*</span></label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="Soyadınız" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.IdentityNumber" class="form-label">TC / Pasaport <span class="text-danger">*</span></label>
                            <input asp-for="Input.IdentityNumber" class="form-control" placeholder="Kimlik No" />
                            <span asp-validation-for="Input.IdentityNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.Email" class="form-label">E-Posta <span class="text-danger">*</span></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="ornek@email.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.AlternativeEmail" class="form-label">Alt. E-Posta</label>
                            <input asp-for="Input.AlternativeEmail" class="form-control" placeholder="Opsiyonel" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.PhoneNumber" class="form-label">Telefon</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="555 123 45 67" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.University" class="form-label">Kurum / Üniversite <span class="text-danger">*</span></label>
                            <select asp-for="Input.University" asp-items="Model.UniversityList" class="form-select custom-select">
                                <option value="">Seçiniz...</option>
                            </select>
                            <span asp-validation-for="Input.University" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Title" class="form-label">Ünvan <span class="text-danger">*</span></label>
                            <select asp-for="Input.Title" asp-items="Model.TitleList" class="form-select custom-select">
                                <option value="">Seçiniz...</option>
                            </select>
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Faculty" class="form-label">Fakülte <span class="text-danger">*</span></label>
                            <select asp-for="Input.Faculty" asp-items="Model.FacultyList" class="form-select custom-select">
                                <option value="">Seçiniz...</option>
                            </select>
                            <span asp-validation-for="Input.Faculty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Department" class="form-label">Bölüm <span class="text-danger">*</span></label>
                            <select asp-for="Input.Department" asp-items="Model.DepartmentList" class="form-select custom-select">
                                <option value="">Seçiniz...</option>
                            </select>
                            <span asp-validation-for="Input.Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="form-label">Şifre <span class="text-danger">*</span></label>
                            <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Şifre Tekrar <span class="text-danger">*</span></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 align-items-center mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.ProfileImage" class="form-label">Profil Resmi</label>
                            <input asp-for="Input.ProfileImage" type="file" class="form-control form-control-sm" />
                            <small class="text-muted" style="font-size: 0.7rem;">(Opsiyonel) Vesikalık formatında.</small>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input asp-for="Input.TermsAccepted" class="form-check-input" type="checkbox" id="termsCheckbox" />
                                <label class="form-check-label small text-muted">
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal" class="text-decoration-none fw-bold" style="color: var(--primary-color);">Kullanım Koşullarını</a> okudum.
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            KAYDI TAMAMLA
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            Zaten hesabınız var mı?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none">
                                Giriş Yapın
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="termsModalLabel">Kullanım Koşulları ve KVKK</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body text-muted small" style="line-height: 1.8;">
                    <p>
                        <strong>1. Kapsam ve Kabul</strong><br>
                        Bu sistemi kullanarak, AntAbstract platformunun belirlediği kuralları ve akademik dürüstlük ilkelerini kabul etmiş sayılırsınız.
                    </p>

                    <p>
                        <strong>2. KVKK ve Veri Gizliliği</strong><br>
                        Sisteme girdiğiniz kişisel veriler (Ad, Soyad, TC No, İletişim bilgileri vb.) 6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında, sadece kongre/etkinlik süreçlerinin yürütülmesi amacıyla işlenmektedir. Üçüncü şahıslarla reklam amacıyla kesinlikle paylaşılmaz.
                    </p>

                    <p>
                        <strong>3. Hesap Güvenliği</strong><br>
                        Hesap şifrenizin güvenliğinden tamamen siz sorumlusunuz. Şifrenizin üçüncü kişilerle paylaşılması durumunda doğacak sorunlardan AntAbstract sorumlu tutulamaz.
                    </p>

                    <p>
                        <strong>4. İptal ve İade Şartları</strong><br>
                        Kayıt olduğunuz kongrelere dair ücret iadesi ve iptal kuralları, ilgili kongrenin Düzenleme Kurulu tarafından belirlenir. Sistem sağlayıcı olarak AntAbstract sadece ödeme altyapısını sunar.
                    </p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" id="btnAcceptTerms" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-dismiss="modal">Okudum, Anladım</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var acceptBtn = document.getElementById("btnAcceptTerms");
            var termsCheckbox = document.getElementById("termsCheckbox");

            if (acceptBtn && termsCheckbox) {
                acceptBtn.addEventListener("click", function () {
                    termsCheckbox.checked = true;
                });
            }
        });
    </script>
</body>
</html>
@page
@model RegisterModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = null;

    var requestCulture = HttpContext.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var currentReturnUrl = string.IsNullOrEmpty(HttpContext.Request.Path.Value)
        ? "/Identity/Account/Register"
        : $"{HttpContext.Request.Path.Value}{HttpContext.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .register-wrapper {
            min-height: 100vh;
            display: flex;
            width: 100%;
        }

        .register-sidebar {
            width: 40%;
            background: url('https://images.unsplash.com/photo-1523580494863-6f3031224c94?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 3rem;
            color: white;
        }

            .register-sidebar::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.95));
            }

        .sidebar-content {
            position: relative;
            z-index: 2;
        }

        .register-form-container {
            width: 60%;
            display: flex;
            justify-content: center;
            padding: 2rem;
            background-color: #fff;
            position: relative;
            overflow-y: auto;
        }

        .register-card {
            width: 100%;
            max-width: 700px;
            padding-top: 1rem;
            padding-bottom: 2rem;
        }

        .form-control, .custom-select {
            padding: 0.7rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            font-weight: 500;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

            .form-control:focus, .custom-select:focus {
                background-color: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
                outline: none;
            }

        .form-label {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.8rem;
            font-weight: 700;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
            }

        .brand-logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 1.5rem;
            display: inline-block;
            text-decoration: none;
        }

        .language-switcher {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            background: #fff;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        }

            .language-switcher form {
                margin: 0;
            }

        .lang-btn {
            border: none;
            background: transparent;
            color: #64748b;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 8px 14px;
            border-radius: 999px;
            cursor: pointer;
            transition: all 0.2s ease;
            line-height: 1;
        }

            .lang-btn:hover {
                background: #f1f5f9;
                color: var(--primary-color);
            }

            .lang-btn.active {
                background: var(--primary-color);
                color: white;
                box-shadow: 0 4px 12px rgba(0, 174, 239, 0.25);
            }

        @@media (max-width: 991px) {
            .register-sidebar {
                display: none;
            }

            .register-form-container {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="register-wrapper">

        <div class="register-sidebar animate__animated animate__fadeIn">
            <div class="sidebar-content">
                <div class="mb-4">
                    <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fas fa-users me-2"></i>@Localizer["AcademicNetwork"]
                    </span>
                    <h1 class="display-5 fw-bold mb-3">@Localizer["HeroTitleLine1"] <br>@Localizer["HeroTitleLine2"]</h1>
                    <p class="lead opacity-75 fs-6">
                        @Localizer["HeroDescription"]
                    </p>
                </div>
                <div class="d-flex gap-2 opacity-50 small">
                    <span>&copy; @DateTime.Now.Year AntAbstract</span>
                </div>
            </div>
        </div>

        <div class="register-form-container">
            <div class="position-absolute top-0 end-0 m-4 d-flex align-items-center gap-3">
                <div class="language-switcher">
                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        <input type="hidden" name="culture" value="tr-TR" />
                        <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                        <button type="submit" class="lang-btn @(currentCulture == "tr-TR" ? "active" : "")">TR</button>
                    </form>

                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        <input type="hidden" name="culture" value="en-US" />
                        <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                        <button type="submit" class="lang-btn @(currentCulture == "en-US" ? "active" : "")">EN</button>
                    </form>
                </div>

                <a href="/" class="text-muted text-decoration-none small fw-bold">
                    <i class="fas fa-times me-1"></i> @Localizer["Close"]
                </a>
            </div>

            <div class="register-card animate__animated animate__fadeInRight">

                <a href="/" class="brand-logo">
                    ANT<span style="color: var(--primary-color);">ABSTRACT</span>
                </a>

                <div class="mb-4">
                    <h3 class="fw-bold text-dark">@Localizer["JoinUs"]</h3>
                    <p class="text-muted small">@Localizer["RegisterIntro"]</p>
                </div>

                <form asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.FirstName" class="form-label">@Localizer["FirstName"] <span class="text-danger">*</span></label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="@Localizer["FirstNamePlaceholder"]" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.LastName" class="form-label">@Localizer["LastName"] <span class="text-danger">*</span></label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="@Localizer["LastNamePlaceholder"]" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.IdentityNumber" class="form-label">@Localizer["IdentityNumber"] <span class="text-danger">*</span></label>
                            <input asp-for="Input.IdentityNumber" class="form-control" placeholder="@Localizer["IdentityNumberPlaceholder"]" />
                            <span asp-validation-for="Input.IdentityNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.Email" class="form-label">@Localizer["Email"] <span class="text-danger">*</span></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="@Localizer["EmailPlaceholder"]" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.AlternativeEmail" class="form-label">@Localizer["AlternativeEmail"]</label>
                            <input asp-for="Input.AlternativeEmail" class="form-control" placeholder="@Localizer["Optional"]" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.PhoneNumber" class="form-label">@Localizer["Phone"]</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="@Localizer["PhonePlaceholder"]" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.University" class="form-label">@Localizer["University"] <span class="text-danger">*</span></label>
                            <select asp-for="Input.University" asp-items="Model.UniversityList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.University" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Title" class="form-label">@Localizer["AcademicTitle"] <span class="text-danger">*</span></label>
                            <select asp-for="Input.Title" asp-items="Model.TitleList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Faculty" class="form-label">@Localizer["Faculty"] <span class="text-danger">*</span></label>
                            <select asp-for="Input.Faculty" asp-items="Model.FacultyList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.Faculty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Department" class="form-label">@Localizer["Department"] <span class="text-danger">*</span></label>
                            <select asp-for="Input.Department" asp-items="Model.DepartmentList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="form-label">@Localizer["Password"] <span class="text-danger">*</span></label>
                            <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label">@Localizer["ConfirmPassword"] <span class="text-danger">*</span></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 align-items-center mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.ProfileImage" class="form-label">@Localizer["ProfileImage"]</label>
                            <input asp-for="Input.ProfileImage" type="file" class="form-control form-control-sm" />
                            <small class="text-muted" style="font-size: 0.7rem;">@Localizer["ProfileImageHint"]</small>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input asp-for="Input.TermsAccepted" class="form-check-input" type="checkbox" id="termsCheckbox" />
                                <label class="form-check-label small text-muted">
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal" class="text-decoration-none fw-bold" style="color: var(--primary-color);">@Localizer["TermsLink"]</a> @Localizer["TermsAcceptedText"]
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            @Localizer["CompleteRegistration"]
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            @Localizer["AlreadyHaveAccount"]
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none">
                                @Localizer["LoginNow"]
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark" id="termsModalLabel">@Localizer["TermsModalTitle"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
                </div>
                <div class="modal-body text-muted small" style="line-height: 1.8;">
                    <p>
                        <strong>@Localizer["TermsSection1Title"]</strong><br>
                        @Localizer["TermsSection1Text"]
                    </p>

                    <p>
                        <strong>@Localizer["TermsSection2Title"]</strong><br>
                        @Localizer["TermsSection2Text"]
                    </p>

                    <p>
                        <strong>@Localizer["TermsSection3Title"]</strong><br>
                        @Localizer["TermsSection3Text"]
                    </p>

                    <p>
                        <strong>@Localizer["TermsSection4Title"]</strong><br>
                        @Localizer["TermsSection4Text"]
                    </p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" id="btnAcceptTerms" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-dismiss="modal">
                        @Localizer["TermsAcceptButton"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var acceptBtn = document.getElementById("btnAcceptTerms");
            var termsCheckbox = document.getElementById("termsCheckbox");

            if (acceptBtn && termsCheckbox) {
                acceptBtn.addEventListener("click", function () {
                    termsCheckbox.checked = true;
                });
            }
        });
    </script>
</body>
</html>
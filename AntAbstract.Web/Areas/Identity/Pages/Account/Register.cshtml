@page
@model RegisterModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@using System.Linq
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = null;

    var requestCulture = HttpContext.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var currentReturnUrl = string.IsNullOrEmpty(HttpContext.Request.Path.Value)
        ? "/register"
        : $"{HttpContext.Request.Path.Value}{HttpContext.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --soft-bg: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .register-wrapper {
            min-height: 100vh;
            display: flex;
            width: 100%;
        }

        .register-sidebar {
            width: 36%;
            background: url('https://images.unsplash.com/photo-1523580494863-6f3031224c94?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 2.5rem;
            color: white;
        }

            .register-sidebar::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.95));
            }

        .sidebar-content {
            position: relative;
            z-index: 2;
        }

            .sidebar-content h1 {
                font-size: 2.35rem;
            }

            .sidebar-content .lead {
                font-size: 0.95rem !important;
            }

        .register-form-container {
            width: 64%;
            display: flex;
            justify-content: center;
            padding: 1.4rem 2rem;
            background-color: #fff;
            position: relative;
            overflow-y: auto;
        }

        .register-card {
            width: 100%;
            max-width: 620px;
            padding-top: 0.5rem;
            padding-bottom: 1.5rem;
        }

        .form-control,
        .custom-select,
        .form-select {
            padding: 0.55rem 0.85rem;
            min-height: 42px;
            border-radius: 0.45rem;
            border: 1px solid var(--border-color);
            background-color: var(--soft-bg);
            font-weight: 500;
            transition: all 0.3s ease;
            font-size: 0.88rem;
        }

            .form-control:focus,
            .custom-select:focus,
            .form-select:focus {
                background-color: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
                outline: none;
            }

        .form-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 0.28rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.8rem;
            font-weight: 700;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
            }

            .btn-primary.btn-lg {
                padding: 0.65rem 1rem;
                font-size: 1rem;
                border-radius: 0.55rem;
            }

        .brand-logo {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 1rem;
            display: inline-block;
            text-decoration: none;
        }

        .register-card h3 {
            font-size: 1.55rem;
            margin-bottom: 0.35rem;
        }

        .register-card .text-muted.small {
            font-size: 0.82rem;
        }

        .register-card .mb-3 {
            margin-bottom: 0.75rem !important;
        }

        .register-card .mb-4 {
            margin-bottom: 1rem !important;
        }

        .row.g-3 {
            --bs-gutter-x: 0.85rem;
            --bs-gutter-y: 0.75rem;
        }

        .language-switcher {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            border: 1px solid var(--border-color);
            border-radius: 999px;
            background: #fff;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        }

            .language-switcher form {
                margin: 0;
            }

        .lang-btn {
            border: none;
            background: transparent;
            color: #64748b;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 8px 14px;
            border-radius: 999px;
            cursor: pointer;
            transition: all 0.2s ease;
            line-height: 1;
        }

            .lang-btn:hover {
                background: #f1f5f9;
                color: var(--primary-color);
            }

            .lang-btn.active {
                background: var(--primary-color);
                color: white;
                box-shadow: 0 4px 12px rgba(0, 174, 239, 0.25);
            }

        .legal-consent-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 14px;
        }

        .legal-consent-title {
            font-size: 0.84rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legal-check-item {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 12px;
            margin-bottom: 8px;
        }

            .legal-check-item:last-child {
                margin-bottom: 0;
            }

            .legal-check-item .form-check-input {
                margin-top: 0.25rem;
            }

            .legal-check-item .form-check-label {
                font-size: 0.8rem;
                color: #475569;
                line-height: 1.45;
            }

            .legal-check-item a {
                color: var(--primary-color);
                font-weight: 800;
                text-decoration: none;
            }

                .legal-check-item a:hover {
                    color: var(--primary-hover);
                    text-decoration: underline;
                }

        .legal-consent-box .small {
            font-size: 0.76rem;
        }

        /* LEGAL MODAL */
        .legal-modal-link {
            color: var(--primary-color);
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
        }

            .legal-modal-link:hover {
                color: var(--primary-hover);
                text-decoration: underline;
            }

        .legal-modal-dialog {
            max-width: 1100px;
        }

        .legal-modal-content {
            border: none;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 90px rgba(15, 23, 42, 0.25);
        }

        .legal-modal-header {
            border-bottom: 1px solid #e2e8f0;
            padding: 18px 22px;
            background: #fff;
        }

        .legal-modal-title {
            font-weight: 800;
            color: #0f172a;
            font-size: 1.05rem;
        }

        .legal-modal-body {
            padding: 0;
            background: #f8fafc;
        }

        .legal-modal-iframe {
            width: 100%;
            height: 72vh;
            border: none;
            display: block;
            background: #fff;
        }

        .legal-modal-footer {
            border-top: 1px solid #e2e8f0;
            background: #fff;
            padding: 14px 22px;
        }

        .legal-modal-close-btn {
            border: none;
            background: var(--primary-color);
            color: #fff;
            font-weight: 800;
            border-radius: 999px;
            padding: 10px 22px;
        }

            .legal-modal-close-btn:hover {
                background: var(--primary-hover);
                color: #fff;
            }

        @@media (max-width: 991px) {
            .register-sidebar {
                display: none;
            }

            .register-form-container {
                width: 100%;
                padding: 1.5rem 1rem;
            }

            .register-card {
                max-width: 680px;
            }
        }

        @@media (max-width: 768px) {
            .legal-modal-dialog {
                max-width: 96%;
                margin: 12px auto;
            }

            .legal-modal-iframe {
                height: 70vh;
            }
        }

        @@media (max-width: 576px) {
            .register-form-container {
                padding: 1.5rem 1rem;
            }

            .position-absolute.top-0.end-0 {
                position: static !important;
                justify-content: flex-end;
                margin: 1rem 0 1.5rem !important;
            }
        }
    </style>
</head>
<body>

    <div class="register-wrapper">

        <div class="register-sidebar animate__animated animate__fadeIn">
            <div class="sidebar-content">
                <div class="mb-4">
                    <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fas fa-users me-2"></i>@Localizer["AcademicNetwork"]
                    </span>

                    <h1 class="display-5 fw-bold mb-3">
                        @Localizer["HeroTitleLine1"] <br>@Localizer["HeroTitleLine2"]
                    </h1>

                    <p class="lead opacity-75 fs-6">
                        @Localizer["HeroDescription"]
                    </p>
                </div>

                <div class="d-flex gap-2 opacity-50 small">
                    <span>&copy; @DateTime.Now.Year AntAbstract</span>
                </div>
            </div>
        </div>

        <div class="register-form-container">
            <div class="position-absolute top-0 end-0 m-4 d-flex align-items-center gap-3">
                <div class="language-switcher">
                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        <input type="hidden" name="culture" value="tr-TR" />
                        <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                        <button type="submit" class="lang-btn @(currentCulture == "tr-TR" ? "active" : "")">TR</button>
                    </form>

                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        <input type="hidden" name="culture" value="en-US" />
                        <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                        <button type="submit" class="lang-btn @(currentCulture == "en-US" ? "active" : "")">EN</button>
                    </form>
                </div>

                <a href="/" class="text-muted text-decoration-none small fw-bold">
                    <i class="fas fa-times me-1"></i> @Localizer["Close"]
                </a>
            </div>

            <div class="register-card animate__animated animate__fadeInRight">

                <a href="/" class="brand-logo">
                    ANT<span style="color: var(--primary-color);">ABSTRACT</span>
                </a>

                <div class="mb-4">
                    <h3 class="fw-bold text-dark">@Localizer["JoinUs"]</h3>
                    <p class="text-muted small">@Localizer["RegisterIntro"]</p>
                </div>

                <form asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">

                    @{
                        var hasValidationErrors =
                        !ViewData.ModelState.IsValid &&
                        ViewData.ModelState.Values.Any(v =>
                        v.Errors.Any(e =>
                        !string.IsNullOrWhiteSpace(e.ErrorMessage) ||
                        e.Exception != null
                        )
                        );
                    }

                    @if (hasValidationErrors)
                    {
                        <div asp-validation-summary="All"
                             class="alert alert-danger border-0 rounded-3 small mb-4"
                             role="alert">
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.FirstName" class="form-label">
                                @Localizer["FirstName"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="@Localizer["FirstNamePlaceholder"]" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.LastName" class="form-label">
                                @Localizer["LastName"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="@Localizer["LastNamePlaceholder"]" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.IdentityNumber" class="form-label">
                                @Localizer["IdentityNumber"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.IdentityNumber" class="form-control" placeholder="@Localizer["IdentityNumberPlaceholder"]" />
                            <span asp-validation-for="Input.IdentityNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.Email" class="form-label">
                                @Localizer["Email"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Email" class="form-control" placeholder="@Localizer["EmailPlaceholder"]" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.AlternativeEmail" class="form-label">
                                @Localizer["AlternativeEmail"]
                            </label>
                            <input asp-for="Input.AlternativeEmail" class="form-control" placeholder="@Localizer["Optional"]" />
                            <span asp-validation-for="Input.AlternativeEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.PhoneNumber" class="form-label">
                                @Localizer["Phone"]
                            </label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="@Localizer["PhonePlaceholder"]" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.University" class="form-label">
                                @Localizer["University"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Input.University" asp-items="Model.UniversityList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.University" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Title" class="form-label">
                                @Localizer["AcademicTitle"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Input.Title" asp-items="Model.TitleList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.Title" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Faculty" class="form-label">
                                @Localizer["Faculty"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Input.Faculty" asp-items="Model.FacultyList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.Faculty" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Department" class="form-label">
                                @Localizer["Department"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Input.Department" asp-items="Model.DepartmentList" class="form-select custom-select">
                                <option value="">@Localizer["SelectOption"]</option>
                            </select>
                            <span asp-validation-for="Input.Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="form-label">
                                @Localizer["Password"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label">
                                @Localizer["ConfirmPassword"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 align-items-center mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.ProfileImage" class="form-label">
                                @Localizer["ProfileImage"]
                            </label>
                            <input asp-for="Input.ProfileImage" type="file" class="form-control form-control-sm" />
                            <small class="text-muted" style="font-size: 0.7rem;">
                                @Localizer["ProfileImageHint"]
                            </small>
                            <span asp-validation-for="Input.ProfileImage" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <div class="legal-consent-box mb-4">
                        <div class="legal-consent-title">
                            <i class="fas fa-shield-alt text-primary"></i>
                            @Localizer["LegalConsentsTitle"]
                        </div>

                        <div class="legal-check-item">
                            <div class="form-check">
                                <input asp-for="Input.TermsAccepted"
                                       class="form-check-input"
                                       type="checkbox"
                                       id="termsCheckbox" />

                                <label class="form-check-label" for="termsCheckbox">
                                    <a href="/terms"
                                       class="legal-modal-link"
                                       data-legal-title='@Localizer["TermsOfUseLinkText"]'
                                       data-legal-url="/terms?embed=true">
                                        @Localizer["TermsOfUseLinkText"]
                                    </a>
                                    @Localizer["TermsAcceptedText"]
                                    <span class="text-danger">*</span>
                                </label>
                            </div>

                            <span asp-validation-for="Input.TermsAccepted" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="legal-check-item">
                            <div class="form-check">
                                <input asp-for="Input.KvkkAccepted"
                                       class="form-check-input"
                                       type="checkbox"
                                       id="kvkkCheckbox" />

                                <label class="form-check-label" for="kvkkCheckbox">
                                    <a href="/kvkk"
                                       class="legal-modal-link"
                                       data-legal-title='@Localizer["KvkkLinkText"]'
                                       data-legal-url="/kvkk?embed=true">
                                        @Localizer["KvkkLinkText"]
                                    </a>
                                    @Localizer["AndText"]
                                    <a href="/privacy"
                                       class="legal-modal-link"
                                       data-legal-title='@Localizer["PrivacyPolicyLinkText"]'
                                       data-legal-url="/privacy?embed=true">
                                        @Localizer["PrivacyPolicyLinkText"]
                                    </a>
                                    @Localizer["KvkkAcceptedText"]
                                    <span class="text-danger">*</span>
                                </label>
                            </div>

                            <span asp-validation-for="Input.KvkkAccepted" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="legal-check-item">
                            <div class="form-check">
                                <input asp-for="Input.MarketingConsent"
                                       class="form-check-input"
                                       type="checkbox"
                                       id="marketingCheckbox" />

                                <label class="form-check-label" for="marketingCheckbox">
                                    @Localizer["MarketingConsentText"]
                                    <span class="text-muted">
                                        @Localizer["OptionalText"]
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div class="small text-muted mt-3" style="line-height: 1.6;">
                            @Localizer["LegalConsentInfoText"]
                            <a href="/cookies"
                               class="legal-modal-link text-decoration-none fw-bold"
                               data-legal-title='@Localizer["CookiePolicyLinkText"]'
                               data-legal-url="/cookies?embed=true">
                                @Localizer["CookiePolicyLinkText"]
                            </a>
                            @Localizer["LegalConsentInfoTextEnd"]
                        </div>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            @Localizer["CompleteRegistration"]
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            @Localizer["AlreadyHaveAccount"]
                            <a href="/login" class="text-primary fw-bold text-decoration-none">
                                @Localizer["LoginNow"]
                            </a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade"
         id="legalTextModal"
         tabindex="-1"
         aria-labelledby="legalTextModalTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-xl legal-modal-dialog">
            <div class="modal-content legal-modal-content">

                <div class="modal-header legal-modal-header">
                    <h5 class="modal-title legal-modal-title" id="legalTextModalTitle">
                        @Localizer["LegalConsentsTitle"]
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label='@Localizer["Close"]'>
                    </button>
                </div>

                <div class="modal-body legal-modal-body">
                    <iframe id="legalTextIframe"
                            class="legal-modal-iframe"
                            src="about:blank"
                            title='@Localizer["LegalConsentsTitle"]'>
                    </iframe>
                </div>

                <div class="modal-footer legal-modal-footer">
                    <button type="button"
                            class="legal-modal-close-btn"
                            data-bs-dismiss="modal">
                        @Localizer["Close"]
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const legalModalElement = document.getElementById("legalTextModal");
            const legalModalTitle = document.getElementById("legalTextModalTitle");
            const legalIframe = document.getElementById("legalTextIframe");

            if (!legalModalElement || !legalModalTitle || !legalIframe) {
                return;
            }

            const legalModal = new bootstrap.Modal(legalModalElement);

            document.querySelectorAll(".legal-modal-link").forEach(function (link) {
                link.addEventListener("click", function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    const title = this.getAttribute("data-legal-title") || this.textContent.trim();
                    const url = this.getAttribute("data-legal-url") || this.getAttribute("href");

                    legalModalTitle.textContent = title;
                    legalIframe.setAttribute("src", url);

                    legalModal.show();
                });
            });

            legalModalElement.addEventListener("hidden.bs.modal", function () {
                legalIframe.setAttribute("src", "about:blank");
            });
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
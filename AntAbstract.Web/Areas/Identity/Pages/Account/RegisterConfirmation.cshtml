@page
@model RegisterConfirmationModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;

    var requestCulture = HttpContext.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var currentReturnUrl = string.IsNullOrEmpty(HttpContext.Request.Path.Value)
        ? "/Identity/Account/RegisterConfirmation"
        : $"{HttpContext.Request.Path.Value}{HttpContext.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --info-color: #2563eb;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc;
            min-height: 100vh;
            min-height: 100dvh;
        }

        .confirmation-wrapper {
            min-height: 100vh;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
        }

        .confirmation-card {
            width: 100%;
            max-width: 620px;
            background: #fff;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
            border: 1px solid #e2e8f0;
            text-align: center;
        }

        .brand-logo {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-dark);
            text-decoration: none;
            display: inline-block;
            margin-bottom: 1.5rem;
        }

        .info-icon {
            width: 84px;
            height: 84px;
            margin: 0 auto 1.5rem auto;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(37, 99, 235, 0.10);
            color: var(--info-color);
            font-size: 2rem;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.9rem 1.25rem;
            font-weight: 700;
            border-radius: 0.75rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
            }

        .btn-outline-secondary {
            border-radius: 0.75rem;
            font-weight: 700;
            padding: 0.9rem 1.25rem;
        }

        .language-switcher {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            background: #fff;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        }

            .language-switcher form {
                margin: 0;
            }

        .lang-btn {
            border: none;
            background: transparent;
            color: #64748b;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 8px 14px;
            border-radius: 999px;
            cursor: pointer;
            transition: all 0.2s ease;
            line-height: 1;
        }

            .lang-btn:hover {
                background: #f1f5f9;
                color: var(--primary-color);
            }

            .lang-btn.active {
                background: var(--primary-color);
                color: white;
                box-shadow: 0 4px 12px rgba(0, 174, 239, 0.25);
            }

        .top-actions {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .doc-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1rem;
            text-align: left;
            margin-top: 1rem;
        }

            .doc-box a {
                word-break: break-all;
            }
    </style>
</head>
<body>

    <div class="top-actions">
        <div class="language-switcher">
            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                <input type="hidden" name="culture" value="tr-TR" />
                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                <button type="submit" class="lang-btn @(currentCulture == "tr-TR" ? "active" : "")">TR</button>
            </form>

            <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                <input type="hidden" name="culture" value="en-US" />
                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                <button type="submit" class="lang-btn @(currentCulture == "en-US" ? "active" : "")">EN</button>
            </form>
        </div>

        <a href="/" class="text-muted text-decoration-none small fw-bold">
            <i class="fas fa-times me-1"></i> @Localizer["Close"]
        </a>
    </div>

    <div class="confirmation-wrapper">
        <div class="confirmation-card">
            <a href="/" class="brand-logo">
                ANT<span style="color: #00aeef;">ABSTRACT</span>
            </a>

            <div class="info-icon">
                <i class="fas fa-envelope-circle-check"></i>
            </div>

            <h1 class="h3 fw-bold text-dark mb-3">@Localizer["PageTitle"]</h1>

            @if (Model.DisplayConfirmAccountLink)
            {
                <p class="text-muted mb-3">
                    @Localizer["DevModeDescription"]
                </p>

                <div class="doc-box mb-4">
                    <div class="fw-bold text-dark mb-2">@Localizer["NormallyEmailedLabel"]</div>
                    <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="fw-bold text-decoration-none">
                        @Localizer["ConfirmAccountLinkText"]
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted mb-4">
                    @Localizer["CheckEmailDescription"]
                </p>
            }

            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-page="./Login" class="btn btn-primary">
                    @Localizer["GoToLoginButton"]
                </a>

                <a href="/" class="btn btn-outline-secondary">
                    @Localizer["BackToHomeButton"]
                </a>
            </div>
        </div>
    </div>
</body>
</html>
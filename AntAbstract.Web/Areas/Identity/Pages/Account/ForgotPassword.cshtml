@page
@model AntAbstract.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using System
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    Layout = null;

    Func<string, string, string> L = (key, fallback) =>
    {
        var text = Localizer[key].Value;
        return string.Equals(text, key, StringComparison.OrdinalIgnoreCase) ? fallback : text;
    };

    ViewData["Title"] = L("ForgotPasswordPageTitle", "Şifremi Unuttum");

    var requestCulture = HttpContext.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var isTurkishCulture = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
    var isEnglishCulture = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var currentShortCulture = isEnglishCulture ? "EN" : "TR";

    var currentReturnUrl = string.IsNullOrEmpty(HttpContext.Request.Path.Value)
        ? "/Identity/Account/ForgotPassword"
        : $"{HttpContext.Request.Path.Value}{HttpContext.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-dark: #008fc4;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --page-bg: #f8fafc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-dark);
            background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 30%), radial-gradient(circle at bottom left, rgba(0, 174, 239, 0.12), transparent 28%), linear-gradient(135deg, #f8fafc 0%, #eef3f8 100%);
            overflow-x: hidden;
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 88px 16px 28px;
            position: relative;
            overflow: hidden;
        }

            .auth-page::before,
            .auth-page::after {
                content: "";
                position: absolute;
                width: 380px;
                height: 380px;
                border-radius: 50%;
                background: rgba(0, 174, 239, 0.08);
                filter: blur(2px);
                z-index: 0;
            }

            .auth-page::before {
                top: -170px;
                right: -115px;
            }

            .auth-page::after {
                bottom: -180px;
                left: -130px;
            }

        .auth-layout {
            width: 100%;
            max-width: 1040px;
            display: grid;
            grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
            gap: 22px;
            align-items: stretch;
            position: relative;
            z-index: 1;
        }

        .auth-side-panel {
            position: relative;
            overflow: hidden;
            border-radius: 28px;
            padding: 34px;
            color: #ffffff;
            background:
                radial-gradient(circle at 18% 14%, rgba(255, 255, 255, 0.24), transparent 27%),
                linear-gradient(145deg, #0f172a 0%, #0369a1 58%, #00aeef 100%);
            box-shadow: 0 28px 70px rgba(15, 23, 42, 0.22);
        }

            .auth-side-panel::after {
                content: "";
                position: absolute;
                width: 210px;
                height: 210px;
                right: -70px;
                bottom: -70px;
                border-radius: 50%;
                border: 34px solid rgba(255, 255, 255, 0.12);
            }

        .side-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.16);
            border: 1px solid rgba(255, 255, 255, 0.22);
            font-size: 0.78rem;
            font-weight: 900;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            margin-bottom: 22px;
        }

        .side-title {
            font-size: clamp(1.85rem, 4vw, 2.8rem);
            line-height: 1.05;
            font-weight: 900;
            letter-spacing: -1.2px;
            margin-bottom: 16px;
        }

        .side-description {
            color: rgba(255, 255, 255, 0.82);
            line-height: 1.75;
            margin-bottom: 28px;
            max-width: 420px;
        }

        .security-step-list {
            display: grid;
            gap: 12px;
            position: relative;
            z-index: 1;
        }

        .security-step {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            padding: 14px;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            backdrop-filter: blur(10px);
        }

            .security-step i {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.18);
                flex-shrink: 0;
            }

            .security-step strong {
                display: block;
                font-size: 0.92rem;
                margin-bottom: 2px;
            }

            .security-step span {
                color: rgba(255, 255, 255, 0.76);
                font-size: 0.82rem;
                line-height: 1.5;
            }

        .auth-card {
            width: 100%;
            max-width: none;
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(226, 232, 240, 0.95);
            border-radius: 24px;
            box-shadow: 0 26px 70px rgba(15, 23, 42, 0.12);
            padding: 34px;
            position: relative;
            z-index: 1;
        }

        .auth-logo {
            font-size: 1.75rem;
            font-weight: 900;
            letter-spacing: -0.9px;
            color: #1e293b;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 26px;
        }

            .auth-logo span {
                color: var(--primary-color);
            }

        .auth-icon {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: rgba(0, 174, 239, 0.12);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.55rem;
            margin-bottom: 20px;
        }

        .auth-title {
            font-size: 1.75rem;
            font-weight: 900;
            letter-spacing: -0.7px;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .auth-description {
            color: var(--text-muted);
            font-size: 0.94rem;
            line-height: 1.65;
            margin-bottom: 24px;
        }

        .info-box {
            background: #f1f9fd;
            border: 1px solid rgba(0, 174, 239, 0.20);
            color: #0f5f7a;
            border-radius: 15px;
            padding: 12px 14px;
            font-size: 0.86rem;
            line-height: 1.55;
            margin-bottom: 22px;
        }

        .reset-assurance-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 22px;
        }

        .reset-assurance {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px 12px;
            border-radius: 15px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #475569;
            font-size: 0.8rem;
            font-weight: 800;
        }

            .reset-assurance i {
                color: var(--primary-color);
            }

        .form-label {
            font-weight: 800;
            color: #475569;
            margin-bottom: 9px;
            font-size: 0.9rem;
        }

        .input-group-modern {
            position: relative;
        }

            .input-group-modern .input-icon {
                position: absolute;
                top: 50%;
                left: 17px;
                transform: translateY(-50%);
                color: #94a3b8;
                z-index: 3;
                font-size: 0.95rem;
            }

        .form-control-modern {
            height: 56px;
            border-radius: 15px;
            border: 1px solid var(--border-color);
            background: #f8fafc;
            padding-left: 50px;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-dark);
            transition: all 0.2s ease;
        }

            .form-control-modern:focus {
                background: #ffffff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.12);
            }

        .btn-reset {
            height: 56px;
            border-radius: 15px;
            border: none;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #ffffff;
            font-size: 1rem;
            font-weight: 900;
            box-shadow: 0 12px 28px rgba(0, 174, 239, 0.26);
            transition: all 0.25s ease;
        }

            .btn-reset:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 34px rgba(0, 174, 239, 0.32);
                color: #ffffff;
            }

        .auth-links {
            margin-top: 22px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.7;
        }

            .auth-links a {
                color: #0d6efd;
                text-decoration: none;
                font-weight: 900;
            }

                .auth-links a:hover {
                    text-decoration: underline;
                }

        .auth-top-actions {
            position: fixed;
            top: 24px;
            right: 28px;
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .auth-language-dropdown {
            position: relative;
        }

        .auth-language-current-btn {
            height: 44px;
            min-width: 92px;
            padding: 0 16px;
            border: 1px solid #dbe3ef;
            border-radius: 999px;
            background: #ffffff;
            color: #475569;
            font-weight: 900;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
            transition: all 0.2s ease;
        }

            .auth-language-current-btn:hover {
                color: var(--primary-color);
                border-color: rgba(0, 174, 239, 0.35);
                box-shadow: 0 10px 28px rgba(0, 174, 239, 0.12);
            }

            .auth-language-current-btn::after {
                margin-left: 2px;
                font-size: 0.72rem;
            }

            .auth-language-current-btn i {
                color: #475569;
                font-size: 0.95rem;
            }

        .auth-language-menu {
            min-width: 160px;
            padding: 8px;
            border: none !important;
            border-radius: 20px !important;
            background-color: #ffffff;
            box-shadow: 0 14px 32px rgba(15, 23, 42, 0.12);
            overflow: hidden;
            margin-top: 8px !important;
        }

            .auth-language-menu form {
                margin: 0;
            }

                .auth-language-menu form + form {
                    margin-top: 4px;
                }

        .auth-language-menu-item {
            width: 100%;
            min-height: 42px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            border: none;
            background: transparent;
            border-radius: 14px;
            padding: 0.58rem 0.75rem;
            color: #475569;
            transition: all 0.2s ease;
        }

            .auth-language-menu-item:hover,
            .auth-language-menu-item.active {
                background-color: rgba(0, 174, 239, 0.12);
                color: var(--primary-color);
            }

        .auth-language-code {
            min-width: 22px;
            font-size: 0.74rem;
            font-weight: 900;
            color: var(--primary-color);
            letter-spacing: 0.25px;
        }

        .auth-language-name {
            font-size: 0.92rem;
            font-weight: 800;
            color: inherit;
        }

        .auth-close-link {
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0 1rem;
            border-radius: 999px;
            color: #64748b;
            background: transparent;
            border: none;
            font-size: 0.92rem;
            font-weight: 900;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .auth-close-link:hover {
                color: var(--primary-color);
                background-color: rgba(0, 174, 239, 0.08);
            }

            .auth-close-link i {
                font-size: 0.85rem;
            }

        .validation-summary-errors {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #be123c;
            border-radius: 16px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

            .validation-summary-errors ul {
                margin-bottom: 0;
                padding-left: 18px;
            }

        .field-validation-error {
            color: #dc2626;
            font-size: 0.85rem;
            font-weight: 700;
            margin-top: 8px;
            display: block;
        }

        @@media (max-width: 768px) {
            .auth-top-actions {
                top: 16px;
                right: 16px;
                gap: 0.5rem;
            }

            .auth-language-current-btn {
                height: 40px;
                min-width: 82px;
                padding: 0 13px;
                font-size: 0.84rem;
            }

            .auth-language-menu {
                min-width: 150px;
                padding: 7px;
                border-radius: 18px !important;
            }

            .auth-language-menu-item {
                min-height: 40px;
                padding: 0.54rem 0.7rem;
                border-radius: 13px;
            }

            .auth-language-name {
                font-size: 0.88rem;
            }

            .auth-close-link {
                height: 40px;
                width: 40px;
                padding: 0;
            }

                .auth-close-link span {
                    display: none;
                }
        }

        @@media (max-width: 991px) {
            .auth-layout {
                max-width: 560px;
                grid-template-columns: 1fr;
            }

            .auth-side-panel {
                padding: 28px;
            }
        }

        @@media (max-width: 576px) {
            .auth-page {
                padding-top: 82px;
            }

            .auth-side-panel {
                display: none;
            }

            .auth-card {
                max-width: 100%;
                padding: 28px 22px;
                border-radius: 22px;
            }

            .reset-assurance-grid {
                grid-template-columns: 1fr;
            }

            .auth-title {
                font-size: 1.55rem;
            }

            .auth-logo {
                font-size: 1.55rem;
                margin-bottom: 24px;
            }

            .auth-icon {
                width: 52px;
                height: 52px;
                border-radius: 17px;
                font-size: 1.45rem;
                margin-bottom: 18px;
            }

            .auth-description {
                font-size: 0.9rem;
            }

            .form-control-modern,
            .btn-reset {
                height: 54px;
            }
        }
    </style>
</head>

<body>

    <div class="auth-top-actions">
        <div class="dropdown auth-language-dropdown">
            <button class="auth-language-current-btn dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <i class="fas fa-globe"></i>
                <span>@currentShortCulture</span>
            </button>

            <div class="dropdown-menu dropdown-menu-end auth-language-menu">
                <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="culture" value="tr-TR" />
                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                    <button type="submit"
                            class="auth-language-menu-item @(isTurkishCulture ? "active" : "")">
                        <span class="auth-language-code">TR</span>
                        <span class="auth-language-name">Türkçe</span>
                    </button>
                </form>

                <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="culture" value="en-US" />
                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                    <button type="submit"
                            class="auth-language-menu-item @(isEnglishCulture ? "active" : "")">
                        <span class="auth-language-code">GB</span>
                        <span class="auth-language-name">English</span>
                    </button>
                </form>
            </div>
        </div>

        <a href="/login" class="auth-close-link">
            <i class="fas fa-arrow-left"></i>
            <span>@L("BackToLogin", "Girişe Dön")</span>
        </a>
    </div>

    <main class="auth-page">
        <div class="auth-layout">
            <aside class="auth-side-panel">
                <div class="side-kicker">
                    <i class="fas fa-shield-halved"></i>
                    @L("PasswordResetKicker", "Güvenli hesap kurtarma")
                </div>

                <h2 class="side-title">
                    @L("PasswordResetSideTitle", "Hesabınıza güvenli şekilde geri dönün.")
                </h2>

                <p class="side-description">
                    @L("PasswordResetSideDescription", "Sıfırlama bağlantısı yalnızca doğrulanmış e-posta adresine gönderilir ve işlem kaydı güvenlik için tutulur.")
                </p>

                <div class="security-step-list">
                    <div class="security-step">
                        <i class="fas fa-envelope-open-text"></i>
                        <div>
                            <strong>@L("PasswordResetStep1Title", "E-posta doğrulanır")</strong>
                            <span>@L("PasswordResetStep1Text", "Sistemde kayıtlı ve onaylı e-posta dışında bilgi paylaşılmaz.")</span>
                        </div>
                    </div>

                    <div class="security-step">
                        <i class="fas fa-link"></i>
                        <div>
                            <strong>@L("PasswordResetStep2Title", "Tek kullanımlık bağlantı")</strong>
                            <span>@L("PasswordResetStep2Text", "Şifre değişimi yalnızca size özel güvenli bağlantı ile yapılır.")</span>
                        </div>
                    </div>

                    <div class="security-step">
                        <i class="fas fa-clock-rotate-left"></i>
                        <div>
                            <strong>@L("PasswordResetStep3Title", "İşlem kaydı tutulur")</strong>
                            <span>@L("PasswordResetStep3Text", "Başarılı işlemler denetim kayıtlarına eklenir.")</span>
                        </div>
                    </div>
                </div>
            </aside>

            <div class="auth-card">

            <a href="/" class="auth-logo">
                ANT<span>ABSTRACT</span>
            </a>

            <div class="auth-icon">
                <i class="fas fa-key"></i>
            </div>

            <h1 class="auth-title">
                @L("ForgotPasswordTitle", "Şifrenizi mi unuttunuz?")
            </h1>

            <p class="auth-description">
                @L("ForgotPasswordDescription", "Endişelenmeyin. E-posta adresinizi girin, hesabınız için güvenli bir şifre sıfırlama bağlantısı gönderelim.")
            </p>

            <div class="info-box">
                <i class="fas fa-circle-info me-2"></i>
                @L("ForgotPasswordInfo", "Bağlantı yalnızca kayıtlı ve doğrulanmış e-posta adreslerine gönderilir.")
            </div>

            <div class="reset-assurance-grid">
                <div class="reset-assurance">
                    <i class="fas fa-user-lock"></i>
                    @L("ResetAssurance1", "Hesap bilgisi gizli kalır")
                </div>

                <div class="reset-assurance">
                    <i class="fas fa-bolt"></i>
                    @L("ResetAssurance2", "Hızlı e-posta akışı")
                </div>
            </div>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">
                        @L("EmailAddress", "E-posta Adresi")
                    </label>

                    <div class="input-group-modern">
                        <i class="fas fa-envelope input-icon"></i>

                        <input asp-for="Input.Email"
                               class="form-control form-control-modern"
                               autocomplete="email"
                               placeholder="ornek@email.com" />
                    </div>

                    <span asp-validation-for="Input.Email"></span>
                </div>

                <button type="submit" class="btn btn-reset w-100">
                    <i class="fas fa-paper-plane me-2"></i>
                    @L("SendResetLinkButton", "Sıfırlama Bağlantısı Gönder")
                </button>
            </form>

            <div class="auth-links">
                @L("RememberPassword", "Şifrenizi hatırladınız mı?")
                <a href="/login">@L("LoginNow", "Giriş Yap")</a>

                <span class="mx-2">•</span>

                @L("NoAccount", "Hesabınız yok mu?")
                <a href="/register">@L("RegisterNow", "Kayıt Ol")</a>
            </div>

            </div>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>

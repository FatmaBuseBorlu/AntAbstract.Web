@page
@model AntAbstract.Web.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-dark: #008fc4;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --page-bg: #f8fafc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: radial-gradient(circle at top left, rgba(0, 174, 239, 0.12), transparent 35%), linear-gradient(135deg, #f8fafc 0%, #eef3f8 100%);
            color: var(--text-dark);
        }

        .auth-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
            position: relative;
            overflow: hidden;
        }

            .auth-page::before,
            .auth-page::after {
                content: "";
                position: absolute;
                width: 380px;
                height: 380px;
                border-radius: 50%;
                background: rgba(0, 174, 239, 0.08);
                filter: blur(3px);
                z-index: 0;
            }

            .auth-page::before {
                top: -160px;
                right: -120px;
            }

            .auth-page::after {
                bottom: -180px;
                left: -130px;
            }

        .auth-card {
            width: 100%;
            max-width: 560px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 28px;
            box-shadow: 0 30px 80px rgba(15, 23, 42, 0.12);
            padding: 42px;
            position: relative;
            z-index: 1;
        }

        .auth-logo {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
            color: #1e293b;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 32px;
        }

            .auth-logo span {
                color: var(--primary-color);
            }

        .auth-icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: rgba(0, 174, 239, 0.12);
            color: var(--primary-color);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 22px;
        }

        .auth-title {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.8px;
            margin-bottom: 10px;
            color: var(--text-dark);
        }

        .auth-description {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .form-label {
            font-weight: 700;
            color: #475569;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .input-group-modern {
            position: relative;
        }

            .input-group-modern .input-icon {
                position: absolute;
                top: 50%;
                left: 18px;
                transform: translateY(-50%);
                color: #94a3b8;
                z-index: 3;
                font-size: 1rem;
            }

        .form-control-modern {
            height: 62px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            background: #f8fafc;
            padding-left: 52px;
            font-size: 1rem;
            font-weight: 500;
            color: var(--text-dark);
            transition: all 0.2s ease;
        }

            .form-control-modern:focus {
                background: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.12);
            }

        .btn-reset {
            height: 62px;
            border-radius: 16px;
            border: none;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #fff;
            font-size: 1.1rem;
            font-weight: 800;
            box-shadow: 0 14px 30px rgba(0, 174, 239, 0.28);
            transition: all 0.25s ease;
        }

            .btn-reset:hover {
                transform: translateY(-2px);
                box-shadow: 0 18px 36px rgba(0, 174, 239, 0.34);
                color: #fff;
            }

        .auth-links {
            margin-top: 28px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.95rem;
        }

            .auth-links a {
                color: #0d6efd;
                text-decoration: none;
                font-weight: 800;
            }

                .auth-links a:hover {
                    text-decoration: underline;
                }

        .back-link {
            position: absolute;
            top: 24px;
            right: 28px;
            color: #475569;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            z-index: 2;
        }

            .back-link:hover {
                color: var(--primary-color);
            }

        .info-box {
            background: #f1f9fd;
            border: 1px solid rgba(0, 174, 239, 0.18);
            color: #0f5f7a;
            border-radius: 16px;
            padding: 14px 16px;
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 24px;
        }

        .validation-summary-errors {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #be123c;
            border-radius: 16px;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

            .validation-summary-errors ul {
                margin-bottom: 0;
                padding-left: 18px;
            }

        .field-validation-error {
            color: #dc2626;
            font-size: 0.85rem;
            font-weight: 600;
            margin-top: 8px;
            display: block;
        }

        @@media (max-width: 576px) {
            .auth-card {
                padding: 30px 22px;
                border-radius: 22px;
            }

            .auth-title {
                font-size: 1.65rem;
            }

            .auth-logo {
                font-size: 1.65rem;
                margin-bottom: 26px;
            }

            .back-link {
                top: 16px;
                right: 18px;
            }
        }
    </style>
</head>
<body>

    <main class="auth-page">

        <a href="/login" class="back-link">
            <i class="fas fa-arrow-left"></i>
            Girişe Dön
        </a>

        <div class="auth-card">

            <a href="/" class="auth-logo">
                ANT<span>ABSTRACT</span>
            </a>

            <div class="auth-icon">
                <i class="fas fa-key"></i>
            </div>

            <h1 class="auth-title">
                Şifrenizi mi unuttunuz?
            </h1>

            <p class="auth-description">
                Endişelenmeyin. E-posta adresinizi girin, hesabınız için güvenli bir şifre sıfırlama bağlantısı gönderelim.
            </p>

            <div class="info-box">
                <i class="fas fa-circle-info me-2"></i>
                Bağlantı yalnızca kayıtlı ve doğrulanmış e-posta adreslerine gönderilir.
            </div>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">
                        E-posta Adresi
                    </label>

                    <div class="input-group-modern">
                        <i class="fas fa-envelope input-icon"></i>

                        <input asp-for="Input.Email"
                               class="form-control form-control-modern"
                               autocomplete="email"
                               placeholder="ornek@email.com" />
                    </div>

                    <span asp-validation-for="Input.Email"></span>
                </div>

                <button type="submit" class="btn btn-reset w-100">
                    <i class="fas fa-paper-plane me-2"></i>
                    Sıfırlama Bağlantısı Gönder
                </button>
            </form>

            <div class="auth-links">
                Şifrenizi hatırladınız mı?
                <a href="/login">Giriş Yap</a>
                <span class="mx-2">•</span>
                Hesabınız yok mu?
                <a href="/register">Kayıt Ol</a>
            </div>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
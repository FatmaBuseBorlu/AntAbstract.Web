@page
@model LoginModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = null;

    var requestCulture = HttpContext.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var currentReturnUrl = string.IsNullOrEmpty(HttpContext.Request.Path.Value)
        ? "/Identity/Account/Login"
        : $"{HttpContext.Request.Path.Value}{HttpContext.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/brands.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --text-dark: #1e293b;
            --text-muted: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            width: 100%;
        }

        .login-sidebar {
            width: 50%;
            background: url('https://images.unsplash.com/photo-1544531586-fde5298cdd40?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 4rem;
            color: white;
        }

            .login-sidebar::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.95));
            }

        .sidebar-content {
            position: relative;
            z-index: 2;
        }

        .login-form-container {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background-color: #fff;
            position: relative;
            overflow-y: auto;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
        }

        .form-control {
            padding: 0.8rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
            }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.8rem;
            font-weight: 700;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
            }

        .brand-logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 2rem;
            display: inline-block;
            text-decoration: none;
        }

        .btn-orcid {
            background-color: #f8f9fa;
            border: 1px solid #e2e8f0;
            color: #333;
            transition: all 0.3s ease;
        }

            .btn-orcid:hover {
                background-color: #eef6df;
                border-color: #A6CE39;
                transform: translateY(-1px);
                box-shadow: 0 10px 20px rgba(166, 206, 57, 0.15);
            }

        .orcid-icon-circle {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #A6CE39;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 800;
            line-height: 1;
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: #94a3b8;
            font-size: 0.85rem;
        }

            .divider::before,
            .divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #e2e8f0;
            }

            .divider:not(:empty)::before {
                margin-right: .5em;
            }

            .divider:not(:empty)::after {
                margin-left: .5em;
            }

        .language-switcher {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px;
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            background: #fff;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        }

            .language-switcher form {
                margin: 0;
            }

        .lang-btn {
            border: none;
            background: transparent;
            color: #64748b;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 8px 14px;
            border-radius: 999px;
            cursor: pointer;
            transition: all 0.2s ease;
            line-height: 1;
        }

            .lang-btn:hover {
                background: #f1f5f9;
                color: var(--primary-color);
            }

            .lang-btn.active {
                background: var(--primary-color);
                color: white;
                box-shadow: 0 4px 12px rgba(0, 174, 239, 0.25);
            }

        @@media (max-width: 991px) {
            .login-sidebar {
                display: none;
            }

            .login-form-container {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="login-wrapper">

        <div class="login-sidebar animate__animated animate__fadeIn">
            <div class="sidebar-content">
                <div class="mb-4">
                    <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fas fa-rocket me-2"></i>@Localizer["ScientificProcesses"]
                    </span>

                    <h1 class="display-4 fw-bold mb-3">
                        @Localizer["HeroTitleLine1"] <br> @Localizer["HeroTitleLine2"]
                    </h1>

                    <p class="lead opacity-75">
                        @Localizer["HeroDescription"]
                    </p>
                </div>

                <div class="d-flex gap-2 opacity-50 small">
                    <span>&copy; @DateTime.Now.Year AntAbstract</span>
                    <span>&bull;</span>
                    <a href="/privacy" class="text-white text-decoration-none">
                        @Localizer["PrivacyPolicy"]
                    </a>
                </div>
            </div>
        </div>

        <div class="login-form-container">
            <div class="position-absolute top-0 end-0 m-4 d-flex align-items-center gap-3">
                <div class="language-switcher">
                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        <input type="hidden" name="culture" value="tr-TR" />
                        <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                        <button type="submit" class="lang-btn @(currentCulture == "tr-TR" ? "active" : "")">TR</button>
                    </form>

                    <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                        <input type="hidden" name="culture" value="en-US" />
                        <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                        <button type="submit" class="lang-btn @(currentCulture == "en-US" ? "active" : "")">EN</button>
                    </form>
                </div>

                <a href="/" class="text-muted text-decoration-none small fw-bold">
                    <i class="fas fa-times me-1"></i> @Localizer["Close"]
                </a>
            </div>

            <div class="login-card animate__animated animate__fadeInRight">

                <a href="/" class="brand-logo">
                    ANT<span style="color: var(--primary-color);">ABSTRACT</span>
                </a>

                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-2">@Localizer["WelcomeBack"]</h2>
                    <p class="text-muted">@Localizer["LoginIntro"]</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger border-0 rounded-3 small mb-4"
                         role="alert">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label text-muted small fw-bold text-uppercase">
                            @Localizer["EmailAddress"]
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted border border-secondary border-opacity-10 rounded-start-2">
                                <i class="fas fa-envelope"></i>
                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="@Localizer["EmailPlaceholder"]"
                                   autocomplete="username" />
                        </div>

                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Input.Password"
                                   class="form-label text-muted small fw-bold text-uppercase mb-0">
                                @Localizer["Password"]
                            </label>

                            <a id="forgot-password"
                               asp-page="./ForgotPassword"
                               class="text-primary text-decoration-none small fw-bold">
                                @Localizer["ForgotPasswordShort"]
                            </a>
                        </div>

                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted border border-secondary border-opacity-10 rounded-start-2">
                                <i class="fas fa-lock"></i>
                            </span>

                            <input asp-for="Input.Password"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="••••••••"
                                   autocomplete="current-password" />
                        </div>

                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />

                        <label class="form-check-label text-muted small" asp-for="Input.RememberMe">
                            @Localizer["RememberMe"]
                        </label>
                    </div>

                    <div class="d-grid mb-3">
                        <button id="login-submit" type="submit" class="btn btn-primary btn-lg shadow-sm">
                            @Localizer["LoginButton"]
                        </button>
                    </div>

                    <div class="text-center mb-4">
                        <p class="text-muted small mb-1">
                            @Localizer["NoAccount"]

                            <a asp-page="./Register"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="text-primary fw-bold text-decoration-none">
                                @Localizer["RegisterNow"]
                            </a>
                        </p>

                        <a asp-page="./ResendEmailConfirmation"
                           class="text-muted text-decoration-none"
                           style="font-size: 0.75rem;">
                            @Localizer["ResendConfirmationEmail"]
                        </a>
                    </div>
                </form>

                <div class="divider">
                    @Localizer["OrContinueWith"]
                </div>

                <form asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post"
                      class="w-100">

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-orcid fw-bold py-2 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                name="provider"
                                value="ORCID"
                                title="ORCID">

                            <span class="orcid-icon-circle">
                                iD
                            </span>

                            <span>
                                @Localizer["LoginWithOrcid"]
                            </span>
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
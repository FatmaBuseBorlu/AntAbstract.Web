@page
@model LoginModel
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@using System.Linq
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = null;

    var requestCulture = HttpContext.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr-TR";

    var isTurkishCulture = currentCulture.StartsWith("tr", StringComparison.OrdinalIgnoreCase);
    var isEnglishCulture = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    var currentShortCulture = isEnglishCulture ? "EN" : "TR";

    var currentReturnUrl = string.IsNullOrEmpty(HttpContext.Request.Path.Value)
        ? "/Identity/Account/Login"
        : $"{HttpContext.Request.Path.Value}{HttpContext.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AntAbstract</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/brands.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --primary-color: #00aeef;
            --primary-hover: #0095cd;
            --primary-dark: #0284c7;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --soft-bg: #f8fafc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
            margin: 0;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            width: 100%;
        }

        .login-sidebar {
            width: 50%;
            background: url('https://images.unsplash.com/photo-1544531586-fde5298cdd40?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 4rem;
            color: white;
        }

            .login-sidebar::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.95));
            }

        .sidebar-content {
            position: relative;
            z-index: 2;
        }

        .login-form-container {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background-color: #fff;
            position: relative;
            overflow-y: auto;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
        }

        .form-control {
            padding: 0.8rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background-color: #fff;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.1);
            }

        .btn-primary {
            background-color: var(--primary-color);
            border: none;
            padding: 0.8rem;
            font-weight: 800;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(0, 174, 239, 0.2);
            }

        .brand-logo {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--text-dark);
            margin-bottom: 2rem;
            display: inline-block;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .btn-orcid {
            background-color: #f8f9fa;
            border: 1px solid #e2e8f0;
            color: #333;
            transition: all 0.3s ease;
        }

            .btn-orcid:hover {
                background-color: #eef6df;
                border-color: #A6CE39;
                transform: translateY(-1px);
                box-shadow: 0 10px 20px rgba(166, 206, 57, 0.15);
            }

        .orcid-icon-circle {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #A6CE39;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 900;
            line-height: 1;
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: #94a3b8;
            font-size: 0.85rem;
        }

            .divider::before,
            .divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #e2e8f0;
            }

            .divider:not(:empty)::before {
                margin-right: .5em;
            }

            .divider:not(:empty)::after {
                margin-left: .5em;
            }

        .auth-top-actions {
            position: fixed;
            top: 24px;
            right: 28px;
            z-index: 9999;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .auth-language-dropdown {
            position: relative;
        }

        .auth-language-current-btn {
            height: 36px;
            min-width: 68px;
            padding: 0 12px;
            border: 1px solid #dbe3ef;
            border-radius: 999px;
            background: #ffffff;
            color: #475569;
            font-weight: 900;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
            transition: all 0.2s ease;
        }

            .auth-language-current-btn:hover {
                color: var(--primary-color);
                border-color: rgba(0, 174, 239, 0.35);
                box-shadow: 0 10px 28px rgba(0, 174, 239, 0.12);
            }

            .auth-language-current-btn::after {
                margin-left: 2px;
                font-size: 0.72rem;
            }

            .auth-language-current-btn i {
                color: #475569;
                font-size: 0.95rem;
            }

        .auth-language-menu {
            min-width: 150px;
            padding: 8px;
            border: none !important;
            border-radius: 20px !important;
            background-color: #ffffff;
            box-shadow: 0 14px 32px rgba(15, 23, 42, 0.12);
            overflow: hidden;
            margin-top: 8px !important;
        }

            .auth-language-menu form {
                margin: 0;
            }

                .auth-language-menu form + form {
                    margin-top: 4px;
                }

        .auth-language-menu-item {
            width: 100%;
            min-height: 42px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            border: none;
            background: transparent;
            border-radius: 14px;
            padding: 0.58rem 0.75rem;
            color: #475569;
            transition: all 0.2s ease;
        }

            .auth-language-menu-item:hover,
            .auth-language-menu-item.active {
                background-color: rgba(0, 174, 239, 0.12);
                color: var(--primary-color);
            }

        .auth-language-code {
            min-width: 22px;
            font-size: 0.74rem;
            font-weight: 900;
            color: var(--primary-color);
            letter-spacing: 0.25px;
        }

        .auth-language-name {
            font-size: 0.92rem;
            font-weight: 800;
            color: inherit;
        }

        .auth-close-link {
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0 1rem;
            border-radius: 999px;
            color: #64748b;
            background: transparent;
            border: none;
            font-size: 0.92rem;
            font-weight: 900;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .auth-close-link:hover {
                color: #ef4444;
                background-color: rgba(239, 68, 68, 0.08);
            }

            .auth-close-link i {
                font-size: 0.85rem;
            }

        @@media (max-width: 991px) {
            .login-sidebar {
                display: none;
            }

            .login-form-container {
                width: 100%;
            }
        }

        @@media (max-width: 768px) {
            .auth-top-actions {
                top: 16px;
                right: 16px;
                gap: 0.5rem;
            }

            .auth-language-current-btn {
                height: 40px;
                min-width: 82px;
                padding: 0 13px;
                font-size: 0.84rem;
            }

            .auth-language-menu {
                min-width: 150px;
                padding: 7px;
                border-radius: 18px !important;
            }

            .auth-language-menu-item {
                min-height: 40px;
                padding: 0.54rem 0.7rem;
                border-radius: 13px;
            }

            .auth-language-name {
                font-size: 0.88rem;
            }

            .auth-close-link {
                height: 40px;
                width: 40px;
                padding: 0;
            }

                .auth-close-link span {
                    display: none;
                }
        }

        @@media (max-width: 576px) {
            .login-form-container {
                padding: 1.5rem 1rem;
            }

            .login-card {
                padding-top: 4rem;
            }
        }
    </style>
</head>

<body>

    <div class="login-wrapper">

        <div class="login-sidebar animate__animated animate__fadeIn">
            <div class="sidebar-content">
                <div class="mb-4">
                    <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-3">
                        <i class="fas fa-rocket me-2"></i>@Localizer["ScientificProcesses"]
                    </span>

                    <h1 class="display-4 fw-bold mb-3">
                        @Localizer["HeroTitleLine1"] <br> @Localizer["HeroTitleLine2"]
                    </h1>

                    <p class="lead opacity-75">
                        @Localizer["HeroDescription"]
                    </p>
                </div>

                <div class="d-flex gap-2 opacity-50 small">
                    <span>&copy; @DateTime.Now.Year AntAbstract</span>
                    <span>&bull;</span>
                    <a href="/privacy" class="text-white text-decoration-none">
                        @Localizer["PrivacyPolicy"]
                    </a>
                </div>
            </div>
        </div>

        <div class="login-form-container">

            <div class="auth-top-actions">
                <div class="dropdown auth-language-dropdown">
                    <button class="auth-language-current-btn dropdown-toggle"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="fas fa-globe"></i>
                        <span>@currentShortCulture</span>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end auth-language-menu">
                        <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="culture" value="tr-TR" />
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                            <button type="submit"
                                    class="auth-language-menu-item @(isTurkishCulture ? "active" : "")">
                                <span class="auth-language-code">TR</span>
                                <span class="auth-language-name">Türkçe</span>
                            </button>
                        </form>

                        <form asp-area="" asp-controller="Language" asp-action="ChangeLanguage" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="culture" value="en-US" />
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                            <button type="submit"
                                    class="auth-language-menu-item @(isEnglishCulture ? "active" : "")">
                                <span class="auth-language-code">GB</span>
                                <span class="auth-language-name">English</span>
                            </button>
                        </form>
                    </div>
                </div>

                <a href="/" class="auth-close-link">
                    <i class="fas fa-times"></i>
                    <span>@Localizer["Close"]</span>
                </a>
            </div>

            <div class="login-card animate__animated animate__fadeInRight">

                <a href="/" class="brand-logo">
                    ANT<span style="color: var(--primary-color);">ABSTRACT</span>
                </a>

                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-2">@Localizer["WelcomeBack"]</h2>
                    <p class="text-muted">@Localizer["LoginIntro"]</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger border-0 rounded-3 small mb-4"
                         role="alert">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label text-muted small fw-bold text-uppercase">
                            @Localizer["EmailAddress"]
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted border border-secondary border-opacity-10 rounded-start-2">
                                <i class="fas fa-envelope"></i>
                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="@Localizer["EmailPlaceholder"]"
                                   autocomplete="username" />
                        </div>

                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Input.Password"
                                   class="form-label text-muted small fw-bold text-uppercase mb-0">
                                @Localizer["Password"]
                            </label>

                            <a id="forgot-password"
                               asp-page="./ForgotPassword"
                               class="text-primary text-decoration-none small fw-bold">
                                @Localizer["ForgotPasswordShort"]
                            </a>
                        </div>

                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted border border-secondary border-opacity-10 rounded-start-2">
                                <i class="fas fa-lock"></i>
                            </span>

                            <input asp-for="Input.Password"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="••••••••"
                                   autocomplete="current-password" />
                        </div>

                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />

                        <label class="form-check-label text-muted small" asp-for="Input.RememberMe">
                            @Localizer["RememberMe"]
                        </label>
                    </div>

                    <div class="d-grid mb-3">
                        <button id="login-submit" type="submit" class="btn btn-primary btn-lg shadow-sm">
                            @Localizer["LoginButton"]
                        </button>
                    </div>

                    <div class="text-center mb-4">
                        <p class="text-muted small mb-1">
                            @Localizer["NoAccount"]

                            <a asp-page="./Register"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="text-primary fw-bold text-decoration-none">
                                @Localizer["RegisterNow"]
                            </a>
                        </p>

                        <a asp-page="./ResendEmailConfirmation"
                           class="text-muted text-decoration-none"
                           style="font-size: 0.75rem;">
                            @Localizer["ResendConfirmationEmail"]
                        </a>
                    </div>
                </form>

                @if (Model.ExternalLogins.Any(x => x.Name == "ORCID"))
                {
                    <div class="divider">
                        @Localizer["OrContinueWith"]
                    </div>

                    <form asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post"
                          class="w-100">

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-orcid fw-bold py-2 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                                    name="provider"
                                    value="ORCID"
                                    title="ORCID">

                                <span class="orcid-icon-circle">
                                    iD
                                </span>

                                <span>
                                    @Localizer["LoginWithOrcid"]
                                </span>
                            </button>
                        </div>
                    </form>
                }

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>

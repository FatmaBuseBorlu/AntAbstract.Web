@using AntAbstract.Application.DTOs.Submission
@using System
@using System.Globalization
@using System.Linq
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment WebHostEnvironment
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model SubmissionDto

@{
    Layout = null;

    var currentCulture = CultureInfo.CurrentUICulture;
    var currentLang = currentCulture.Name;

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var firstAuthor = Model.Authors?
        .OrderBy(a => a.Order)
        .FirstOrDefault();

    var authorFullName = firstAuthor != null
        ? $"{firstAuthor.FirstName} {firstAuthor.LastName}".Trim()
        : Model.CorrespondingAuthorName;

    if (string.IsNullOrWhiteSpace(authorFullName))
    {
        authorFullName = L("DefaultAuthorName", "Değerli Yazar");
    }

    var documentNumber = Model.Id.ToString().Length >= 8
        ? Model.Id.ToString().Substring(0, 8).ToUpper()
        : Model.Id.ToString().ToUpper();

    var acceptanceDate = Model.DecisionDate ?? DateTime.Now;

    var conferenceTitle = string.IsNullOrWhiteSpace(Model.ConferenceTitle)
        ? L("DefaultConferenceTitle", "Bilimsel Kongre")
        : Model.ConferenceTitle;

    var submissionTitle = string.IsNullOrWhiteSpace(Model.Title)
        ? L("DefaultSubmissionTitle", "Başlıksız Bildiri")
        : Model.Title;

    var dnaImage = GetImage("dna.png");
    var wreathImage = GetImage("wreath.png");
    var signatureImage = GetImage("signature.png");
}

@functions {
    public string GetImage(string imageName)
    {
        if (string.IsNullOrWhiteSpace(imageName))
        {
            return "";
        }

        var webRoot = WebHostEnvironment.WebRootPath;

        if (string.IsNullOrWhiteSpace(webRoot))
        {
            return "";
        }

        var path = System.IO.Path.Combine(webRoot, "images", imageName);

        if (!System.IO.File.Exists(path))
        {
            return "";
        }

        var imageArray = System.IO.File.ReadAllBytes(path);
        var base64 = Convert.ToBase64String(imageArray);
        var extension = System.IO.Path.GetExtension(path).Replace(".", "").ToLowerInvariant();

        var contentType = extension switch
        {
            "jpg" => "jpeg",
            "jpeg" => "jpeg",
            "png" => "png",
            "gif" => "gif",
            "webp" => "webp",
            "svg" => "svg+xml",
            _ => "png"
        };

        return $"data:image/{contentType};base64,{base64}";
    }
}

<!DOCTYPE html>
<html lang="@currentLang">
<head>
    <meta charset="utf-8" />
    <title>@L("DocumentTitle", "Kabul Sertifikası")</title>

    <style>
        @@page {
            size: A4 landscape;
            margin: 0;
        }

        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 297mm;
            height: 210mm;
        }

        body {
            font-family: "Times New Roman", Times, serif;
            background: #ffffff;
            color: #000000;
            overflow: hidden;
        }

        .page-container {
            width: 297mm;
            height: 210mm;
            padding: 22mm 26mm;
            position: relative;
            background:
                radial-gradient(circle at top right, rgba(106, 27, 67, 0.08), transparent 30%),
                radial-gradient(circle at bottom left, rgba(0, 85, 165, 0.07), transparent 28%),
                #ffffff;
        }

        .page-border {
            position: absolute;
            inset: 10mm;
            border: 1.5px solid #111111;
            pointer-events: none;
        }

        .page-border-inner {
            position: absolute;
            inset: 13mm;
            border: 1px solid rgba(106, 27, 67, 0.40);
            pointer-events: none;
        }

        .header-row {
            width: 100%;
            border-collapse: collapse;
            border: none;
            margin-bottom: 18mm;
            position: relative;
            z-index: 2;
        }

        .header-row td {
            vertical-align: top;
            border: none;
        }

        .brand-wrapper {
            display: flex;
            align-items: center;
        }

        .dna-logo {
            width: 42px;
            height: 42px;
            object-fit: contain;
            margin-right: 12px;
        }

        .dna-fallback {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 12px;
            background: #6a1b43;
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            font-weight: 900;
            margin-right: 12px;
        }

        .journal-title {
            font-family: Arial, sans-serif;
            font-size: 23px;
            font-weight: bold;
            font-style: italic;
            color: #6a1b43;
            line-height: 1;
            letter-spacing: -0.4px;
        }

        .journal-subtitle {
            font-family: Arial, sans-serif;
            font-size: 22px;
            font-weight: normal;
            color: #6a1b43;
            line-height: 1.1;
        }

        .open-access {
            font-family: Arial, sans-serif;
            font-size: 9px;
            color: #333333;
            margin-top: 6px;
            letter-spacing: 0.3px;
        }

        .badge-container {
            text-align: right;
        }

        .badge-table {
            width: auto;
            margin-left: auto;
            border-collapse: collapse;
        }

        .badge-table td {
            padding-left: 5px;
        }

        .badge {
            display: inline-block;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            text-align: center;
            color: #ffffff;
            font-family: Arial, sans-serif;
            font-size: 7px;
            font-weight: bold;
            padding-top: 14px;
            box-sizing: border-box;
            line-height: 1.1;
        }

        .badge span {
            font-size: 11px;
            display: block;
            margin-top: 1px;
        }

        .bg-yellow {
            background-color: #ffcc00 !important;
            color: #000000 !important;
        }

        .bg-blue {
            background-color: #0055a5 !important;
        }

        .bg-dark {
            background-color: #002c5f !important;
        }

        .content-wrapper {
            text-align: center;
            position: relative;
            z-index: 2;
            padding: 0 18mm;
        }

        .wreath {
            width: 108px;
            display: block;
            margin: 0 auto 12px auto;
        }

        .wreath-fallback {
            width: 108px;
            height: 56px;
            margin: 0 auto 12px auto;
            color: #6a1b43;
            font-family: Arial, sans-serif;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            border-top: 1px solid rgba(106, 27, 67, 0.35);
            border-bottom: 1px solid rgba(106, 27, 67, 0.35);
        }

        h1 {
            font-size: 34px;
            text-transform: uppercase;
            margin: 5px 0 24px 0;
            letter-spacing: 2.5px;
            color: #000000;
            font-weight: 900;
        }

        .text-intro {
            font-size: 16px;
            margin-bottom: 13px;
            line-height: 1.55;
        }

        .paper-title {
            font-size: 20px;
            font-weight: bold;
            margin: 18px auto;
            padding: 10px 0;
            display: block;
            max-width: 100%;
            line-height: 1.45;
            color: #111111;
        }

        .document-id {
            font-size: 15px;
            margin-top: 6px;
        }

        .date-info {
            font-size: 16px;
            margin-top: 14px;
            line-height: 1.65;
        }

        .footer-row {
            width: calc(100% - 52mm);
            position: absolute;
            left: 26mm;
            right: 26mm;
            bottom: 20mm;
            border-collapse: collapse;
            z-index: 2;
        }

        .footer-row td {
            vertical-align: bottom;
            border: none;
        }

        .mdpi-box {
            border: 2px solid #000000;
            padding: 5px 12px;
            display: inline-block;
            font-family: Arial, sans-serif;
            font-weight: bold;
            font-size: 18px;
            letter-spacing: 2px;
        }

        .city-date {
            font-family: Arial, sans-serif;
            font-size: 9px;
            margin-top: 5px;
            color: #333333;
        }

        .signature-img {
            height: 45px;
            display: block;
            margin-left: auto;
            margin-bottom: 5px;
            object-fit: contain;
        }

        .signature-spacer {
            height: 45px;
            margin-bottom: 5px;
        }

        .signature-line {
            border-top: 1px solid #000000;
            width: 230px;
            margin-left: auto;
            text-align: left;
            padding-top: 6px;
            font-family: Arial, sans-serif;
            font-size: 11px;
            line-height: 1.45;
        }

        .watermark {
            position: absolute;
            left: 50%;
            top: 54%;
            transform: translate(-50%, -50%) rotate(-22deg);
            font-family: Arial, sans-serif;
            font-size: 72px;
            font-weight: 900;
            color: rgba(106, 27, 67, 0.035);
            white-space: nowrap;
            z-index: 1;
            pointer-events: none;
        }

        @@media print {
            html,
            body {
                width: 297mm;
                height: 210mm;
                background: #ffffff;
            }

            .page-container {
                box-shadow: none;
                page-break-after: always;
            }
        }
    </style>
</head>

<body>
    <div class="page-container">
        <div class="page-border"></div>
        <div class="page-border-inner"></div>
        <div class="watermark">ANTABSTRACT</div>

        <table class="header-row">
            <tr>
                <td style="width: 60%;">
                    <div class="brand-wrapper">
                        @if (!string.IsNullOrWhiteSpace(dnaImage))
                        {
                            <img src="@dnaImage" class="dna-logo" alt="Logo" />
                        }
                        else
                        {
                            <div class="dna-fallback">
                                ANT
                            </div>
                        }

                        <div>
                            <div class="journal-title">
                                @L("JournalTitleLine1", "AntAbstract")
                            </div>

                            <div class="journal-subtitle">
                                @L("JournalTitleLine2", "Academic Conference System")
                            </div>
                        </div>
                    </div>

                    <div class="open-access">
                        @L("OpenAccessText", "Open Access Academic Conference Management")
                    </div>
                </td>

                <td class="badge-container">
                    <table class="badge-table">
                        <tr>
                            <td>
                                <div class="badge bg-yellow">
                                    @L("ImpactFactorLabel", "Impact")
                                    <span>4.9</span>
                                </div>
                            </td>

                            <td>
                                <div class="badge bg-blue">
                                    @L("IndexedInLabel", "Indexed")
                                    <br />
                                    <strong>PubMed</strong>
                                </div>
                            </td>

                            <td>
                                <div class="badge bg-dark">
                                    @L("CiteScoreLabel", "Score")
                                    <span>9.0</span>
                                </div>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <div class="content-wrapper">
            @if (!string.IsNullOrWhiteSpace(wreathImage))
            {
                <img src="@wreathImage" class="wreath" alt="Wreath" />
            }
            else
            {
                <div class="wreath-fallback">
                    Certificate
                </div>
            }

            <h1>
                @L("CertificateTitle", "Certificate")
            </h1>

            <div class="text-intro">
                @L("IntroLine1_Part1", "This is to certify that")
                <strong>@authorFullName</strong>
                @L("IntroLine1_Part2", "has successfully contributed with the accepted paper")
            </div>

            <div class="paper-title">
                “@submissionTitle”
            </div>

            <div class="document-id">
                (@L("DocumentIdLabel", "Document ID")
                <strong>@documentNumber</strong>)
            </div>

            <div class="date-info">
                @L("ConferenceLine_Part1", "Presented / accepted within")
                <strong>@conferenceTitle</strong>
                <br />
                @L("ConferenceLine_Part2", "Decision date:")
                <strong>@acceptanceDate.ToString("dd MMMM yyyy", currentCulture)</strong>.
            </div>
        </div>

        <table class="footer-row">
            <tr>
                <td style="width: 30%;">
                    <div class="mdpi-box">
                        ANT
                    </div>

                    <div class="city-date">
                        @L("CityLabel", "Antalya"),
                        @DateTime.Now.ToString("MMMM yyyy", currentCulture)
                    </div>
                </td>

                <td style="text-align: right;">
                    @if (!string.IsNullOrWhiteSpace(signatureImage))
                    {
                        <img src="@signatureImage" class="signature-img" alt="Signature" />
                    }
                    else
                    {
                        <div class="signature-spacer"></div>
                    }

                    <div class="signature-line">
                        <strong>@L("SignatureName", "Kongre Başkanı")</strong><br />
                        @L("SignatureTitle", "Düzenleme Kurulu")
                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
@using AntAbstract.Application.DTOs.Submission
@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model List<SubmissionDto>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";


    string BuildConferenceUrl(string cleanPath, string fallbackPath)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return fallbackPath;
        }

        return $"/{slug}{cleanPath}";
    }

    var hasSubmissions = Model != null && Model.Any();

    var indexUrl = BuildConferenceUrl(
        "/my-submissions",
        "/Submission/Index"
    );

    var createUrl = BuildConferenceUrl(
        "/submit-abstract",
        "/Submission/Create"
    );

    var paymentUrl = BuildConferenceUrl(
        "/registration",
        "/Home/Congresses"
    );

    var canDownloadAuthorCertificate = ViewBag.CanDownloadAuthorCertificate as bool? ?? false;
}

<style>
    .submissions-page {
        padding: 2rem 1.5rem 4rem;
    }

    .submissions-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .submissions-title {
        color: #0f172a;
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: -0.5px;
        margin-bottom: 0.35rem;
    }

    .submissions-lead {
        color: #64748b;
        font-size: 1rem;
        margin-bottom: 0;
    }

    .btn-new-submission {
        min-height: 50px;
        border: none;
        border-radius: 999px;
        padding: 0 1.45rem;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        text-decoration: none;
        box-shadow: 0 14px 30px rgba(13, 110, 253, 0.22);
        transition: all 0.22s ease;
        white-space: nowrap;
    }

        .btn-new-submission:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 18px 38px rgba(13, 110, 253, 0.32);
            text-decoration: none;
        }

    .submission-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        transition: all 0.28s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(15, 23, 42, 0.04);
    }

        .submission-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 48px rgba(15, 23, 42, 0.08);
            border-color: rgba(0, 174, 239, 0.35);
        }

    .status-badge {
        font-size: 0.72rem;
        font-weight: 900;
        padding: 7px 13px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        white-space: nowrap;
    }

    .status-new {
        background-color: #e3f2fd;
        color: #1565c0;
    }

    .status-pending {
        background-color: #fff8e1;
        color: #f57f17;
    }

    .status-review {
        background-color: #fff3e0;
        color: #ef6c00;
    }

    .status-accepted {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .status-rejected {
        background-color: #ffebee;
        color: #c62828;
    }

    .status-revision {
        background-color: #f3e5f5;
        color: #7b1fa2;
    }

    .card-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(0, 174, 239, 0.12), rgba(13, 110, 253, 0.08));
        color: #00aeef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .submission-card-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 900;
        line-height: 1.35;
        max-width: 260px;
    }

    .meta-text {
        font-size: 0.85rem;
        color: #64748b;
    }

    .submission-tag {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 800;
        padding: 0.35rem 0.55rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .card-actions {
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px dashed #e2e8f0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-card-action {
        flex: 1 1 31%;
        font-size: 0.84rem;
        font-weight: 900;
        border-radius: 12px;
        padding: 9px 10px;
        min-width: 92px;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        transition: all 0.2s ease;
    }

        .btn-card-action:hover {
            transform: translateY(-1px);
        }

    .btn-payment-action {
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        border: none;
        color: #ffffff;
        box-shadow: 0 8px 18px rgba(13, 110, 253, 0.18);
    }

        .btn-payment-action:hover {
            color: #ffffff;
            box-shadow: 0 12px 24px rgba(13, 110, 253, 0.25);
        }

    .btn-certificate-disabled {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #94a3b8;
        cursor: not-allowed;
        box-shadow: none;
    }

        .btn-certificate-disabled:hover {
            color: #94a3b8;
            transform: none;
        }

    .empty-submission-state {
        min-height: 480px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .empty-icon-circle {
        width: 132px;
        height: 132px;
        border-radius: 999px;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.05);
        margin-bottom: 1.35rem;
    }

        .empty-icon-circle i {
            color: #cbd5e1;
            font-size: 4.2rem;
        }

    .empty-title {
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 900;
        margin-bottom: 0.6rem;
    }

    .empty-message {
        color: #64748b;
        font-size: 1rem;
        max-width: 620px;
        margin: 0 auto 1.6rem;
    }

    .btn-first-submission {
        min-height: 56px;
        border-radius: 999px;
        padding: 0 2rem;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        color: #ffffff;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        text-decoration: none;
        box-shadow: 0 16px 34px rgba(13, 110, 253, 0.22);
        transition: all 0.22s ease;
    }

        .btn-first-submission:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 20px 42px rgba(13, 110, 253, 0.32);
            text-decoration: none;
        }

    @@media (max-width: 992px) {
        .submissions-header {
            flex-direction: column;
            align-items: stretch;
        }

        .submissions-header-actions {
            display: flex;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .submissions-page {
            padding: 1.5rem 1rem 3rem;
        }

        .submissions-title {
            font-size: 1.55rem;
        }


        .btn-new-submission {
            width: 100%;
        }

        .empty-submission-state {
            min-height: 420px;
        }
    }
</style>

<div class="container-fluid submissions-page">

    <div class="submissions-header">
        <div>
            <h3 class="submissions-title">
                @Localizer["PageTitle"]
            </h3>

            <p class="submissions-lead">
                @Localizer["PageLead"]
            </p>
        </div>


        @if (hasSubmissions)
        {
            <div class="submissions-header-actions">
                <a href="@createUrl"
                   class="btn-new-submission">
                    <i class="fas fa-plus-circle"></i>
                    @Localizer["NewSubmissionButton"]
                </a>
            </div>
        }
    </div>

    @if (hasSubmissions)
    {
        <div class="row g-4">
            @foreach (var item in Model!)
            {
                SubmissionStatus statusEnum = SubmissionStatus.New;
                Enum.TryParse<SubmissionStatus>(item.Status, out statusEnum);

                string statusClass = statusEnum switch
                {
                    SubmissionStatus.New => "status-new",
                    SubmissionStatus.Pending => "status-pending",
                    SubmissionStatus.UnderReview => "status-review",
                    SubmissionStatus.Accepted => "status-accepted",
                    SubmissionStatus.Rejected => "status-rejected",
                    SubmissionStatus.RevisionRequired => "status-revision",
                    SubmissionStatus.Presented => "bg-primary text-white",
                    _ => "bg-light text-dark border"
                };

                string statusText = statusEnum switch
                {
                    SubmissionStatus.New => Localizer["Status_NewDraft"].Value,
                    SubmissionStatus.Pending => Localizer["Status_Pending"].Value,
                    SubmissionStatus.UnderReview => Localizer["Status_UnderReview"].Value,
                    SubmissionStatus.Accepted => Localizer["Status_Accepted"].Value,
                    SubmissionStatus.Rejected => Localizer["Status_Rejected"].Value,
                    SubmissionStatus.RevisionRequired => Localizer["Status_RevisionRequired"].Value,
                    SubmissionStatus.Presented => Localizer["Status_Presented"].Value,
                    _ => item.Status
                };

                var detailsUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}",
                $"/Submission/Details/{item.Id}"
                );

                var editUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}/edit",
                $"/Submission/Edit/{item.Id}"
                );

                var deleteUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}/delete",
                $"/Submission/Delete/{item.Id}"
                );

                var acceptanceLetterUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}/acceptance-letter",
                $"/Submission/DownloadAcceptanceLetter/{item.Id}"
                );

                <div class="col-md-6 col-xl-4">
                    <div class="submission-card p-4">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center text-muted small fw-bold">
                                <i class="far fa-calendar-alt me-2 text-primary opacity-50"></i>
                                @item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                            </div>

                            <span class="status-badge @statusClass">
                                @statusText
                            </span>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <div class="card-icon-box me-3">
                                <i class="fas fa-file-alt"></i>
                            </div>

                            <div class="min-w-0">
                                <h6 class="submission-card-title text-truncate"
                                    title="@item.Title">
                                    @item.Title
                                </h6>

                                <p class="mb-0 small text-muted text-truncate"
                                   style="max-width: 260px;">
                                    <i class="fas fa-globe me-1 text-secondary opacity-50"></i>
                                    @(item.ConferenceTitle ?? Localizer["ConferenceNotSpecified"].Value)
                                </p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex flex-wrap gap-2">
                                <span class="submission-tag">
                                    <i class="fas fa-users"></i>
                                    @(item.Authors?.Count ?? 0) @Localizer["AuthorsLabel"]
                                </span>

                                @if (!string.IsNullOrWhiteSpace(item.Topic))
                                {
                                    <span class="submission-tag">
                                        <i class="fas fa-layer-group"></i>
                                        @item.Topic
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.Keywords))
                                {
                                    var firstKey = item.Keywords.Split(',')[0];

                                    <span class="submission-tag">
                                        <i class="fas fa-tag"></i>
                                        @firstKey
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-actions">
                            <a href="@detailsUrl"
                               class="btn btn-light border btn-card-action text-dark">
                                <i class="fas fa-eye text-primary"></i>
                                @Localizer["DetailButton"]
                            </a>

                            @if (statusEnum == SubmissionStatus.New || statusEnum == SubmissionStatus.RevisionRequired)
                            {
                                <a href="@editUrl"
                                   class="btn btn-light border btn-card-action text-dark">
                                    <i class="fas fa-edit text-warning"></i>
                                    @Localizer["EditButton"]
                                </a>

                                <a href="@deleteUrl"
                                   class="btn btn-light border btn-card-action text-dark">
                                    <i class="fas fa-trash-alt text-danger"></i>
                                    @Localizer["DeleteButton"]
                                </a>
                            }
                            else if (statusEnum == SubmissionStatus.Accepted || statusEnum == SubmissionStatus.Presented)
                            {
                                @if (statusEnum == SubmissionStatus.Accepted)
                                {
                                    <a href="@paymentUrl"
                                       class="btn btn-payment-action btn-card-action">
                                        <i class="fas fa-credit-card"></i>
                                        Ödeme Yap
                                    </a>
                                }

                                @if (canDownloadAuthorCertificate)
                                {
                                    <a href="@acceptanceLetterUrl"
                                       class="btn btn-success btn-card-action text-white"
                                       target="_blank">
                                        <i class="fas fa-certificate"></i>
                                        @Localizer["DocumentButton"]
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-certificate-disabled btn-card-action"
                                            disabled
                                            title="Katılım belgesi, kongre katılımınız tamamlandıktan sonra oluşturulur.">
                                        <i class="fas fa-lock"></i>
                                        Belge Hazır Değil
                                    </button>
                                }
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-submission-state">
            <div>
                <div class="empty-icon-circle">
                    <i class="fas fa-folder-open"></i>
                </div>

                <h4 class="empty-title">
                    @Localizer["EmptyTitle"]
                </h4>

                <p class="empty-message">
                    @Localizer["EmptyMessage"]
                </p>

                <a href="@createUrl"
                   class="btn-first-submission">
                    <i class="fas fa-paper-plane"></i>
                    @Localizer["FirstSubmissionButton"]
                </a>
            </div>
        </div>
    }
</div>

<script>
    document.querySelectorAll('.btn-new-submission, .btn-first-submission, .btn-card-action').forEach(el => {
        el.addEventListener('mouseenter', () => el.style.transform = 'translateY(-2px)');
        el.addEventListener('mouseleave', () => el.style.transform = 'translateY(0)');
        el.style.transition = 'all 0.2s ease';
    });
</script>
@using AntAbstract.Application.DTOs.Submission
@using AntAbstract.Domain.Entities
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model List<SubmissionDto>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    string BuildConferenceUrl(string cleanPath, string fallbackPath)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return fallbackPath;
        }

        return $"/{slug}{cleanPath}";
    }

    var hasSubmissions = Model != null && Model.Any();

    var createUrl = BuildConferenceUrl(
        "/submit-abstract",
        "/Submission/Create"
    );

    var paymentUrl = BuildConferenceUrl(
        "/registration",
        "/Home/Congresses"
    );

    var canDownloadAuthorCertificate = ViewBag.CanDownloadAuthorCertificate as bool? ?? false;
}

<style>
    .author-submissions-page {
        padding: 1.25rem 1.25rem 3rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .author-submissions-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.35rem;
    }

    .author-submissions-title {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 900;
        letter-spacing: -0.04em;
        margin: 0 0 0.25rem;
        line-height: 1.15;
    }

    .author-submissions-lead {
        color: #64748b;
        font-size: 0.92rem;
        font-weight: 600;
        margin: 0;
    }

    .author-new-submission-btn {
        min-height: 42px !important;
        border: none !important;
        border-radius: 999px !important;
        padding: 0 1.15rem !important;
        background: linear-gradient(135deg, #0d6efd, #00aeef) !important;
        color: #ffffff !important;
        font-size: 0.88rem !important;
        font-weight: 900 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0.5rem !important;
        text-decoration: none !important;
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.18) !important;
        transition: all 0.2s ease !important;
        white-space: nowrap !important;
    }

        .author-new-submission-btn:hover {
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 14px 30px rgba(13, 110, 253, 0.26) !important;
        }

    .author-submission-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(285px, 340px));
        gap: 1rem;
        align-items: stretch;
    }

    .author-submission-card {
        width: 100%;
        max-width: 340px;
        background: #ffffff;
        border: 1px solid #e5edf6;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
        transition: all 0.22s ease;
        overflow: hidden;
    }

        .author-submission-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 34px rgba(15, 23, 42, 0.075);
            border-color: rgba(0, 174, 239, 0.28);
        }

    .author-submission-card-inner {
        padding: 0.95rem;
        display: flex;
        flex-direction: column;
        min-height: 250px;
    }

    .author-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.85rem;
    }

    .author-card-date {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .author-card-date i {
            color: #60a5fa;
            font-size: 0.78rem;
        }

    .author-status-badge {
        font-size: 0.64rem;
        font-weight: 900;
        padding: 0.34rem 0.62rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
    }

    .author-status-new {
        background-color: #e3f2fd;
        color: #1565c0;
    }

    .author-status-pending {
        background-color: #fff8e1;
        color: #f57f17;
    }

    .author-status-review {
        background-color: #fff3e0;
        color: #ef6c00;
    }

    .author-status-accepted {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .author-status-rejected {
        background-color: #ffebee;
        color: #c62828;
    }

    .author-status-revision {
        background-color: #f3e5f5;
        color: #7b1fa2;
    }

    .author-status-presented {
        background-color: #dbeafe;
        color: #1d4ed8;
    }

    .author-card-main {
        display: flex;
        align-items: flex-start;
        gap: 0.7rem;
        margin-bottom: 0.8rem;
    }

    .author-card-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 13px;
        background: linear-gradient(135deg, rgba(0, 174, 239, 0.12), rgba(13, 110, 253, 0.08));
        color: #00aeef;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
    }

    .author-card-title {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 900;
        line-height: 1.3;
        margin: 0 0 0.2rem;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .author-card-conference {
        color: #64748b;
        font-size: 0.77rem;
        font-weight: 600;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 0;
    }

    .author-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.8rem;
    }

    .author-card-tag {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        border-radius: 9px;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.26rem 0.45rem;
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        max-width: 100%;
    }

        .author-card-tag span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .author-card-actions {
        margin-top: auto;
        padding-top: 0.75rem;
        border-top: 1px dashed #e2e8f0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.45rem;
    }

    .author-action-btn,
    .author-action-disabled {
        min-height: 34px !important;
        height: 34px !important;
        border-radius: 10px !important;
        padding: 0 0.45rem !important;
        font-size: 0.72rem !important;
        font-weight: 900 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0.25rem !important;
        line-height: 1.1 !important;
        text-align: center !important;
        text-decoration: none !important;
        transition: all 0.2s ease !important;
        border: 1px solid #dbe3ef !important;
        white-space: normal !important;
    }

        .author-action-btn i,
        .author-action-disabled i {
            font-size: 0.72rem !important;
            margin: 0 !important;
        }

    .author-action-light {
        background: #ffffff !important;
        color: #0f172a !important;
    }

        .author-action-light:hover {
            background: #f8fbff !important;
            color: #0d6efd !important;
            border-color: rgba(13, 110, 253, 0.28) !important;
            transform: translateY(-1px);
        }

    .author-action-payment {
        background: linear-gradient(135deg, #0d6efd, #00aeef) !important;
        color: #ffffff !important;
        border: none !important;
        box-shadow: 0 7px 15px rgba(13, 110, 253, 0.15) !important;
    }

        .author-action-payment:hover {
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(13, 110, 253, 0.22) !important;
        }

    .author-action-success {
        background: #16a34a !important;
        color: #ffffff !important;
        border: none !important;
    }

    .author-action-disabled {
        background: #f1f5f9 !important;
        color: #94a3b8 !important;
        cursor: not-allowed !important;
        box-shadow: none !important;
    }

        .author-action-disabled:hover {
            color: #94a3b8 !important;
            transform: none !important;
        }

    .author-empty-state {
        min-height: 390px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .author-empty-icon {
        width: 105px;
        height: 105px;
        border-radius: 999px;
        background: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.05);
        margin-bottom: 1.1rem;
    }

        .author-empty-icon i {
            color: #cbd5e1;
            font-size: 3.3rem;
        }

    .author-empty-title {
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
        margin-bottom: 0.45rem;
    }

    .author-empty-message {
        color: #64748b;
        font-size: 0.92rem;
        max-width: 560px;
        margin: 0 auto 1.3rem;
    }

    .author-first-submission-btn {
        min-height: 48px !important;
        border-radius: 999px !important;
        padding: 0 1.6rem !important;
        background: linear-gradient(135deg, #0d6efd, #00aeef) !important;
        color: #ffffff !important;
        font-size: 0.9rem !important;
        font-weight: 900 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0.55rem !important;
        text-decoration: none !important;
        box-shadow: 0 14px 28px rgba(13, 110, 253, 0.20) !important;
        transition: all 0.2s ease !important;
    }

        .author-first-submission-btn:hover {
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 18px 36px rgba(13, 110, 253, 0.28) !important;
        }

    @@media (max-width: 768px) {
        .author-submissions-page {
            padding: 1rem 1rem 3rem;
        }

        .author-submissions-header {
            flex-direction: column;
            align-items: stretch;
        }

        .author-new-submission-btn {
            width: 100%;
        }

        .author-submission-grid {
            grid-template-columns: 1fr;
        }

        .author-submission-card {
            max-width: 100%;
        }

        .author-card-actions {
            grid-template-columns: 1fr;
        }

        .author-action-btn,
        .author-action-disabled {
            height: 36px !important;
            min-height: 36px !important;
        }
    }
</style>

<div class="container-fluid author-submissions-page">

    <div class="author-submissions-header">
        <div>
            <h3 class="author-submissions-title">
                @Localizer["PageTitle"]
            </h3>

            <p class="author-submissions-lead">
                @Localizer["PageLead"]
            </p>
        </div>

        @if (hasSubmissions)
        {
            <div>
                <a href="@createUrl"
                   class="author-new-submission-btn">
                    <i class="fas fa-plus-circle"></i>
                    @Localizer["NewSubmissionButton"]
                </a>
            </div>
        }
    </div>

    @if (hasSubmissions)
    {
        <div class="author-submission-grid">
            @foreach (var item in Model!)
            {
                SubmissionStatus statusEnum = SubmissionStatus.New;
                Enum.TryParse<SubmissionStatus>(item.Status, out statusEnum);

                string statusClass = statusEnum switch
                {
                    SubmissionStatus.New => "author-status-new",
                    SubmissionStatus.Pending => "author-status-pending",
                    SubmissionStatus.UnderReview => "author-status-review",
                    SubmissionStatus.Accepted => "author-status-accepted",
                    SubmissionStatus.Rejected => "author-status-rejected",
                    SubmissionStatus.RevisionRequired => "author-status-revision",
                    SubmissionStatus.Presented => "author-status-presented",
                    _ => "author-status-new"
                };

                string statusText = statusEnum switch
                {
                    SubmissionStatus.New => Localizer["Status_NewDraft"].Value,
                    SubmissionStatus.Pending => Localizer["Status_Pending"].Value,
                    SubmissionStatus.UnderReview => Localizer["Status_UnderReview"].Value,
                    SubmissionStatus.Accepted => Localizer["Status_Accepted"].Value,
                    SubmissionStatus.Rejected => Localizer["Status_Rejected"].Value,
                    SubmissionStatus.RevisionRequired => Localizer["Status_RevisionRequired"].Value,
                    SubmissionStatus.Presented => Localizer["Status_Presented"].Value,
                    _ => item.Status
                };

                var detailsUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}",
                $"/Submission/Details/{item.Id}"
                );

                var editUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}/edit",
                $"/Submission/Edit/{item.Id}"
                );

                var deleteUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}/delete",
                $"/Submission/Delete/{item.Id}"
                );

                var acceptanceLetterUrl = BuildConferenceUrl(
                $"/my-submissions/{item.Id}/acceptance-letter",
                $"/Submission/DownloadAcceptanceLetter/{item.Id}"
                );

                <article class="author-submission-card">
                    <div class="author-submission-card-inner">

                        <div class="author-card-top">
                            <div class="author-card-date">
                                <i class="far fa-calendar-alt"></i>
                                @item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                            </div>

                            <span class="author-status-badge @statusClass">
                                @statusText
                            </span>
                        </div>

                        <div class="author-card-main">
                            <div class="author-card-icon">
                                <i class="fas fa-file-alt"></i>
                            </div>

                            <div class="min-w-0">
                                <h6 class="author-card-title"
                                    title="@item.Title">
                                    @item.Title
                                </h6>

                                <p class="author-card-conference">
                                    <i class="fas fa-globe me-1 text-secondary opacity-50"></i>
                                    @(item.ConferenceTitle ?? Localizer["ConferenceNotSpecified"].Value)
                                </p>
                            </div>
                        </div>

                        <div class="author-card-tags">
                            <span class="author-card-tag">
                                <i class="fas fa-users"></i>
                                <span>@(item.Authors?.Count ?? 0) @Localizer["AuthorsLabel"]</span>
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.Topic))
                            {
                                <span class="author-card-tag">
                                    <i class="fas fa-layer-group"></i>
                                    <span>@item.Topic</span>
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.Keywords))
                            {
                                var firstKey = item.Keywords.Split(',')[0];

                                <span class="author-card-tag">
                                    <i class="fas fa-tag"></i>
                                    <span>@firstKey</span>
                                </span>
                            }
                        </div>

                        <div class="author-card-actions">
                            <a href="@detailsUrl"
                               class="author-action-btn author-action-light">
                                <i class="fas fa-eye text-primary"></i>
                                Detay
                            </a>

                            @if (statusEnum == SubmissionStatus.New || statusEnum == SubmissionStatus.RevisionRequired)
                            {
                                <a href="@editUrl"
                                   class="author-action-btn author-action-light">
                                    <i class="fas fa-edit text-warning"></i>
                                    @Localizer["EditButton"]
                                </a>

                                <a href="@deleteUrl"
                                   class="author-action-btn author-action-light">
                                    <i class="fas fa-trash-alt text-danger"></i>
                                    @Localizer["DeleteButton"]
                                </a>
                            }
                            else if (statusEnum == SubmissionStatus.Accepted || statusEnum == SubmissionStatus.Presented)
                            {
                                @if (statusEnum == SubmissionStatus.Accepted)
                                {
                                    <a href="@paymentUrl"
                                       class="author-action-btn author-action-payment">
                                        <i class="fas fa-credit-card"></i>
                                        Ödeme
                                    </a>
                                }

                                @if (canDownloadAuthorCertificate)
                                {
                                    <a href="@acceptanceLetterUrl"
                                       class="author-action-btn author-action-success"
                                       target="_blank">
                                        <i class="fas fa-certificate"></i>
                                        Belge
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="author-action-disabled"
                                            disabled
                                            title="Katılım belgesi, kongre katılımınız tamamlandıktan sonra oluşturulur.">
                                        <i class="fas fa-lock"></i>
                                        Belge Yok
                                    </button>
                                }
                            }
                        </div>

                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="author-empty-state">
            <div>
                <div class="author-empty-icon">
                    <i class="fas fa-folder-open"></i>
                </div>

                <h4 class="author-empty-title">
                    @Localizer["EmptyTitle"]
                </h4>

                <p class="author-empty-message">
                    @Localizer["EmptyMessage"]
                </p>

                <a href="@createUrl"
                   class="author-first-submission-btn">
                    <i class="fas fa-paper-plane"></i>
                    @Localizer["FirstSubmissionButton"]
                </a>
            </div>
        </div>
    }
</div>
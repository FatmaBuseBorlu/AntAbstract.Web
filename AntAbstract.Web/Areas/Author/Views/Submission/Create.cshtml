@using AntAbstract.Web.Models.ViewModels.Admin.Submissions
@using Microsoft.AspNetCore.Http
@using System
@using System.Globalization
@using System.Linq
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model SubmissionCreateViewModel

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var conferenceTitle = Context.Session.GetString("SelectedConferenceTitle") ?? "";

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string L(string key, string tr, string en)
    {
        var value = Localizer[key].Value;

        if (string.Equals(value, key, StringComparison.OrdinalIgnoreCase))
        {
            return isEnglish ? en : tr;
        }

        return value;
    }

    var submitUrl = string.IsNullOrWhiteSpace(slug)
        ? Url.Action("Create", "Submission", new { area = "Author" }) ?? "/Submission/Create"
        : $"/{slug}/submit-abstract";

    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Dashboard/MyConferences"
        : $"/{slug}/my-submissions";

    var hasValidationErrors =
        !ViewData.ModelState.IsValid &&
        ViewData.ModelState.Values.Any(v =>
            v.Errors.Any(e =>
                !string.IsNullOrWhiteSpace(e.ErrorMessage) ||
                e.Exception != null
            )
        );

    var existingAuthors = Model.Authors ?? new List<SubmissionAuthorViewModel>();
}

<style>
    .submission-page {
        padding: 2rem 1.5rem 4rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .program-hero {
        background: radial-gradient(circle at top right, rgba(0, 174, 239, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .program-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }

    .program-hero-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        border-radius: 22px;
        background: linear-gradient(135deg, #00aeef, #0d6efd);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        box-shadow: 0 16px 34px rgba(0, 174, 239, 0.24);
    }

    .program-title {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: -0.6px;
        margin-bottom: 0.25rem;
        line-height: 1.2;
    }

    .program-lead {
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .program-conference-pill {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #dbe4ef;
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 900;
        padding: 0 0.95rem;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.045);
        max-width: 380px;
    }

    .program-conference-pill span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .program-conference-pill i {
        color: #00aeef;
    }

    .submission-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.045);
        overflow: hidden;
        margin-bottom: 1.4rem;
    }

    .submission-card-header {
        padding: 1.1rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .submission-step-title {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .submission-step-number {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 14px;
        background: linear-gradient(135deg, #00aeef, #2563eb);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
    }

    .submission-step-title h5 {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        margin-bottom: 0.12rem;
    }

    .submission-step-title span {
        color: #64748b;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .step-dots {
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .step-dot {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        border: 1px solid #cbd5e1;
        color: #94a3b8;
        font-size: 0.78rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
    }

    .step-dot.active {
        border-color: #2563eb;
        color: #ffffff;
        background: linear-gradient(135deg, #00aeef, #2563eb);
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.2);
    }

    .submission-card-body {
        padding: 2.2rem;
    }

    .form-label {
        color: #475569;
        font-size: 0.86rem;
        font-weight: 900;
        margin-bottom: 0.55rem;
    }

    .form-control-modern,
    .form-select-modern {
        width: 100%;
        min-height: 54px;
        border-radius: 15px;
        border: 1px solid #dbe4ef;
        background: #ffffff;
        color: #0f172a;
        font-size: 0.94rem;
        font-weight: 700;
        padding: 0.85rem 1rem;
        transition: all 0.2s ease;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.025);
    }

    .form-control-modern::placeholder {
        color: #94a3b8;
        font-weight: 600;
    }

    .form-control-modern:focus,
    .form-select-modern:focus {
        outline: none;
        border-color: #00aeef;
        box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.12);
    }

    textarea.form-control-modern {
        min-height: 170px;
        resize: vertical;
    }

    .modern-notice {
        min-height: 54px;
        border-radius: 15px;
        border: 1px solid rgba(245, 158, 11, 0.35);
        background: linear-gradient(135deg, rgba(255, 251, 235, 0.95), rgba(255, 247, 237, 0.95));
        color: #92400e;
        font-size: 0.86rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.85rem 1rem;
    }

    .modern-notice i {
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 10px;
        background: rgba(245, 158, 11, 0.16);
        color: #f59e0b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .field-hint {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
        margin-top: 0.45rem;
    }

    .counter-badge {
        min-width: 76px;
        height: 30px;
        padding: 0 0.7rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .author-info-card {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(0, 174, 239, 0.08));
        border: 1px solid rgba(37, 99, 235, 0.12);
        border-radius: 18px;
        padding: 1rem;
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        color: #1e40af;
        margin-bottom: 1.4rem;
    }

    .author-info-card i {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 14px;
        background: #ffffff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.08);
    }

    .author-card {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
    }

    .author-card:hover {
        border-color: #cbd5e1;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.07);
    }

    .btn-add-author {
        min-height: 54px;
        border: 1px dashed #60a5fa;
        background: rgba(239, 248, 255, 0.8);
        color: #2563eb;
        border-radius: 16px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        transition: all 0.2s ease;
    }

    .btn-add-author:hover {
        background: #eff6ff;
        color: #1d4ed8;
        transform: translateY(-1px);
    }

    .upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 24px;
        background: linear-gradient(135deg, #f8fafc, #ffffff);
        transition: all 0.25s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .upload-zone:hover {
        border-color: #00aeef;
        background: linear-gradient(135deg, #f0f9ff, #ffffff);
        transform: translateY(-2px);
    }

    .upload-icon {
        width: 82px;
        height: 82px;
        border-radius: 28px;
        background: #ffffff;
        color: #2563eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 16px 38px rgba(37, 99, 235, 0.12);
    }

    .submission-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 3rem;
    }

    .btn-back {
        min-height: 52px;
        border-radius: 16px;
        padding: 0 1.1rem;
        color: #64748b;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        transition: all 0.2s ease;
    }

    .btn-back:hover {
        color: #0f172a;
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        text-decoration: none;
    }

    .btn-submit-modern {
        min-height: 56px;
        border: none;
        border-radius: 18px;
        padding: 0 1.65rem;
        color: #ffffff;
        background: linear-gradient(135deg, #0d6efd, #00aeef);
        box-shadow: 0 16px 34px rgba(13, 110, 253, 0.24);
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.2s ease;
    }

    .btn-submit-modern:hover {
        transform: translateY(-2px);
        color: #ffffff;
        box-shadow: 0 20px 44px rgba(13, 110, 253, 0.32);
    }

    .validation-summary-errors {
        border: none;
        border-radius: 18px;
        background: rgba(239, 68, 68, 0.08);
        color: #b91c1c;
        font-weight: 800;
    }

    @@media (max-width: 992px) {
        .program-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .program-conference-pill {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .submission-page {
            padding: 1.5rem 1rem 3rem;
        }

        .program-hero-left {
            align-items: flex-start;
            flex-direction: column;
        }

        .program-title {
            font-size: 1.45rem;
        }

        .submission-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .step-dots {
            display: none;
        }

        .submission-card-body {
            padding: 1.2rem;
        }

        .submission-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-back,
        .btn-submit-modern {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<div class="submission-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info rounded-4 fw-bold mb-4">
            <i class="fas fa-info-circle me-2"></i>
            @TempData["InfoMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-paper-plane"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("PageHeading", "Yeni Bildiri Gönder", "Submit New Abstract")
                </h3>

                <p class="program-lead">
                    @L("PageLead", "Bildirinizi seçili kongre için oluşturun ve değerlendirme sürecine gönderin.", "Create your abstract for the selected congress and submit it for review.")
                </p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(conferenceTitle))
        {
            <div class="program-conference-pill">
                <i class="fas fa-calendar-check"></i>
                <span>@conferenceTitle</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(slug))
        {
            <div class="program-conference-pill">
                <i class="fas fa-link"></i>
                <span>/@slug</span>
            </div>
        }
    </div>

    <form action="@submitUrl"
          enctype="multipart/form-data"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ConferenceId" />

        @if (hasValidationErrors)
        {
            <div asp-validation-summary="All" class="alert validation-summary-errors mb-4 shadow-sm"></div>
        }

        <div class="submission-card">
            <div class="submission-card-header">
                <div class="submission-step-title">
                    <div class="submission-step-number">1</div>

                    <div>
                        <h5>
                            @L("Section1Title", "Çalışma Detayları", "Work Details")
                        </h5>

                        <span>
                            @L("Section1Subtitle", "Bildiri ile ilgili temel bilgileri girin.", "Enter the basic information about your abstract.")
                        </span>
                    </div>
                </div>

                <div class="step-dots">
                    <span class="step-dot active">1</span>
                    <span class="step-dot">2</span>
                    <span class="step-dot">3</span>
                </div>
            </div>

            <div class="submission-card-body">
                <div class="mb-4">
                    <label asp-for="Title" class="form-label">
                        @L("TitleLabel", "Bildiri Başlığı", "Abstract Title") <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Title"
                           maxlength="200"
                           class="form-control-modern"
                           placeholder="@L("TitlePlaceholder", "Örn: Kırsal Turizmde Yapay Zeka Kullanımı", "Example: The Use of Artificial Intelligence in Rural Tourism")" />

                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <span asp-validation-for="Title" class="text-danger small fw-bold"></span>
                        <span id="titleCounter" class="counter-badge">0 / 200</span>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="PresentationType" class="form-label">
                            @L("PresentationTypeLabel", "Sunum Türü", "Presentation Type") <span class="text-danger">*</span>
                        </label>

                        <select asp-for="PresentationType" class="form-select-modern">
                            <option value="">
                                @L("SelectPresentationTypeOption", "Sunum türü seçiniz", "Select presentation type")
                            </option>

                            <option value="Oral">
                                @L("PresentationTypeOral", "Sözlü Sunum", "Oral Presentation")
                            </option>

                            <option value="Poster">
                                @L("PresentationTypePoster", "Poster Sunum", "Poster Presentation")
                            </option>

                            <option value="Online">
                                @L("PresentationTypeOnline", "Çevrimiçi Sunum", "Online Presentation")
                            </option>
                        </select>

                        <span asp-validation-for="PresentationType" class="text-danger small fw-bold mt-2 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConferenceTopicId" class="form-label">
                            @L("TopicLabel", "Bildiri Konusu / Tema", "Abstract Topic / Theme") <span class="text-danger">*</span>
                        </label>

                        @if (Model.AvailableTopics == null || !Model.AvailableTopics.Any())
                        {
                            <div class="modern-notice">
                                <i class="fas fa-info"></i>
                                <span>
                                    @L("NoTopicsDefinedMessage", "Bu kongre için henüz bildiri konusu tanımlanmamış.", "No abstract topics have been defined for this congress yet.")
                                </span>
                            </div>
                        }
                        else
                        {
                            <select asp-for="ConferenceTopicId"
                                    asp-items="Model.AvailableTopics"
                                    class="form-select-modern">

                                <option value="">
                                    @L("SelectTopicOption", "Bildiri konusu seçiniz", "Select abstract topic")
                                </option>
                            </select>
                        }

                        <span asp-validation-for="ConferenceTopicId" class="text-danger small fw-bold mt-2 d-block"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <label asp-for="AbstractText" class="form-label">
                        @L("AbstractLabel", "Özet Metni", "Abstract Text") <span class="text-danger">*</span>
                    </label>

                    <textarea asp-for="AbstractText"
                              id="AbstractText"
                              maxlength="5000"
                              class="form-control-modern"
                              rows="8"
                              placeholder="@L("AbstractPlaceholder", "Özetinizi buraya yazın veya yapıştırın...", "Write or paste your abstract here...")"></textarea>

                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <span asp-validation-for="AbstractText" class="text-danger small fw-bold"></span>
                        <span id="abstractCounter" class="counter-badge">0 / 5000</span>
                    </div>
                </div>

                <div class="mt-4">
                    <label asp-for="Keywords" class="form-label">
                        @L("KeywordsLabel", "Anahtar Kelimeler", "Keywords") <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Keywords"
                           id="Keywords"
                           class="form-control-modern"
                           placeholder="@L("KeywordsPlaceholder", "Örn: yapay zeka, kırsal turizm, sürdürülebilirlik", "Example: AI, rural tourism, sustainability")" />

                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <span class="field-hint">
                            @L("KeywordsHint", "Anahtar kelimeleri virgül ile ayırarak yazınız.", "Separate keywords with commas.")
                        </span>

                        <span id="keywordCounter" class="counter-badge">0</span>
                    </div>

                    <span asp-validation-for="Keywords" class="text-danger small fw-bold mt-2 d-block"></span>
                </div>
            </div>
        </div>

        <div class="submission-card">
            <div class="submission-card-header">
                <div class="submission-step-title">
                    <div class="submission-step-number">2</div>

                    <div>
                        <h5>
                            @L("Section2Title", "Yazar Bilgileri", "Author Information")
                        </h5>

                        <span>
                            @L("Section2Subtitle", "Ek yazarları bu bölümden ekleyebilirsiniz.", "You can add co-authors in this section.")
                        </span>
                    </div>
                </div>

                <div class="step-dots">
                    <span class="step-dot">1</span>
                    <span class="step-dot active">2</span>
                    <span class="step-dot">3</span>
                </div>
            </div>

            <div class="submission-card-body">
                <div class="author-info-card">
                    <i class="fas fa-info-circle"></i>

                    <div>
                        <div class="fw-bold mb-1">
                            @L("AutoAssignTitle", "Sorumlu yazar otomatik atanır.", "The corresponding author is assigned automatically.")
                        </div>

                        <div class="small fw-bold opacity-75">
                            @L("AutoAssignText", "Giriş yapan kullanıcı ilk yazar olarak eklenecektir. Ek yazarları aşağıdan ekleyebilirsiniz.", "The logged-in user will be added as the first author. You can add co-authors below.")
                        </div>
                    </div>
                </div>

                <div id="author-list">
                    @for (var i = 0; i < existingAuthors.Count; i++)
                    {
                        <div class="author-card p-4 mb-3 position-relative author-row">
                            <button type="button"
                                    class="btn-close position-absolute top-0 end-0 m-3 remove-author-btn"
                                    aria-label="@L("RemoveLabel", "Kaldır", "Remove")"></button>

                            <h6 class="fw-bold text-primary mb-3">
                                @L("CoAuthorPrefix", "Ek Yazar", "Co-Author") #@(i + 1)
                            </h6>

                            <input type="hidden" name="Authors.Index" value="@i" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorFirstNameLabel", "Ad", "First Name")
                                    </label>

                                    <input name="Authors[@i].FirstName"
                                           value="@existingAuthors[i].FirstName"
                                           class="form-control-modern"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorLastNameLabel", "Soyad", "Last Name")
                                    </label>

                                    <input name="Authors[@i].LastName"
                                           value="@existingAuthors[i].LastName"
                                           class="form-control-modern"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorEmailLabel", "E-posta", "Email")
                                    </label>

                                    <input name="Authors[@i].Email"
                                           value="@existingAuthors[i].Email"
                                           class="form-control-modern"
                                           type="email"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorInstitutionLabel", "Kurum", "Institution")
                                    </label>

                                    <input name="Authors[@i].Institution"
                                           value="@existingAuthors[i].Institution"
                                           class="form-control-modern"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorOrcidLabel", "ORCID", "ORCID")
                                    </label>

                                    <input name="Authors[@i].ORCID"
                                           value="@existingAuthors[i].ORCID"
                                           class="form-control-modern"
                                           placeholder="@L("AuthorOrcidPlaceholder", "0000-0000-0000-0000", "0000-0000-0000-0000")" />
                                </div>

                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="Authors[@i].IsCorrespondingAuthor"
                                               value="true"
                                               @(existingAuthors[i].IsCorrespondingAuthor ? "checked" : "") />

                                        <label class="form-check-label small text-muted fw-bold">
                                            @L("CorrespondingAuthorLabel", "Sorumlu yazar", "Corresponding author")
                                        </label>
                                    </div>

                                    <input type="hidden" name="Authors[@i].Order" value="@(i + 2)" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button type="button"
                        class="btn-add-author w-100"
                        id="add-author-btn">

                    <i class="fas fa-plus-circle"></i>
                    @L("AddCoAuthorButton", "Ek Yazar Ekle", "Add Co-Author")
                </button>
            </div>
        </div>

        <div class="submission-card">
            <div class="submission-card-header">
                <div class="submission-step-title">
                    <div class="submission-step-number">3</div>

                    <div>
                        <h5>
                            @L("Section3Title", "Dosya Yükleme", "File Upload")
                        </h5>

                        <span>
                            @L("Section3Subtitle", "Bildiri dosyanızı PDF, DOC veya DOCX formatında yükleyin.", "Upload your abstract file in PDF, DOC, or DOCX format.")
                        </span>
                    </div>
                </div>

                <div class="step-dots">
                    <span class="step-dot">1</span>
                    <span class="step-dot">2</span>
                    <span class="step-dot active">3</span>
                </div>
            </div>

            <div class="submission-card-body">
                <label class="form-label d-block mb-3">
                    @L("FileLabel", "Bildiri Dosyası", "Abstract File") <span class="text-danger">*</span>
                </label>

                <div class="upload-zone p-5 text-center">
                    <div id="upload-placeholder">
                        <div class="upload-icon mb-3">
                            <i class="fas fa-cloud-upload-alt fa-2x"></i>
                        </div>

                        <h6 class="fw-bold text-dark mb-1">
                            @L("UploadDragTitle", "Dosyanızı buraya yükleyin", "Upload your file here")
                        </h6>

                        <p class="text-muted small mb-0">
                            @L("UploadDragText", "PDF, DOC veya DOCX dosyası yükleyebilirsiniz. Maksimum dosya boyutu 10 MB olmalıdır.", "You can upload a PDF, DOC, or DOCX file. Maximum file size should be 10 MB.")
                        </p>
                    </div>

                    <div id="file-preview" class="d-none align-items-center justify-content-center flex-column">
                        <i class="fas fa-file-alt fa-3x text-success mb-3"></i>

                        <h6 class="fw-bold text-dark mb-1" id="fileNameText">
                            file.pdf
                        </h6>

                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">
                            @L("ReadyToUploadLabel", "Yüklemeye hazır", "Ready to upload")
                        </span>
                    </div>

                    <input asp-for="SubmissionFile"
                           type="file"
                           class="position-absolute top-0 start-0 w-100 h-100 opacity-0"
                           accept=".pdf, .docx, .doc"
                           onchange="fileSelected(this)"
                           style="cursor: pointer;" />
                </div>

                <span asp-validation-for="SubmissionFile" class="text-danger small fw-bold mt-2 d-block"></span>
            </div>
        </div>

        <div class="submission-actions">
            <a href="@backUrl" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                @L("CancelButton", "Vazgeç", "Cancel")
            </a>

            <button type="submit" class="btn-submit-modern">
                <span>
                    @L("SubmitButton", "Bildiriyi Gönder", "Submit Abstract")
                </span>

                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const wordLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("WordLabel", "Kelime", "Words")));
        const removeLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("RemoveLabel", "Kaldır", "Remove")));
        const coAuthorPrefix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("CoAuthorPrefix", "Ek Yazar", "Co-Author")));
        const firstNameLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorFirstNameLabel", "Ad", "First Name")));
        const lastNameLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorLastNameLabel", "Soyad", "Last Name")));
        const emailLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorEmailLabel", "E-posta", "Email")));
        const institutionLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorInstitutionLabel", "Kurum", "Institution")));
        const orcidLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorOrcidLabel", "ORCID", "ORCID")));
        const orcidPlaceholder = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorOrcidPlaceholder", "0000-0000-0000-0000", "0000-0000-0000-0000")));
        const correspondingAuthorLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("CorrespondingAuthorLabel", "Sorumlu yazar", "Corresponding author")));

        function updateTextCounter(selector, counterSelector, max) {
            const input = document.querySelector(selector);
            const counter = document.querySelector(counterSelector);

            if (!input || !counter) {
                return;
            }

            const update = function () {
                counter.innerText = input.value.length + " / " + max;
            };

            input.addEventListener("input", update);
            update();
        }

        function updateKeywordCounter() {
            const input = document.getElementById("Keywords");
            const counter = document.getElementById("keywordCounter");

            if (!input || !counter) {
                return;
            }

            const keywords = input.value
                .split(",")
                .map(x => x.trim())
                .filter(x => x.length > 0);

            counter.innerText = keywords.length + " / 8";
        }

        function updateWordCount() {
            const abstractInput = document.getElementById('AbstractText');

            if (!abstractInput) {
                return;
            }

            const text = abstractInput.value.trim();
            const wordCount = text ? text.split(/\s+/).filter(str => str !== "").length : 0;
            abstractInput.dataset.wordCount = wordCount;
        }

        updateTextCounter("[name='Title']", "#titleCounter", 200);
        updateTextCounter("#AbstractText", "#abstractCounter", 5000);

        const keywordsInput = document.getElementById("Keywords");

        if (keywordsInput) {
            keywordsInput.addEventListener("input", updateKeywordCounter);
            updateKeywordCounter();
        }

        const abstractInput = document.getElementById("AbstractText");

        if (abstractInput) {
            abstractInput.addEventListener("input", updateWordCount);
            updateWordCount();
        }

        function fileSelected(input) {
            if (input.files && input.files[0]) {
                document.getElementById('fileNameText').innerText = input.files[0].name;
                document.getElementById('upload-placeholder').classList.add('d-none');
                document.getElementById('file-preview').classList.remove('d-none');
                document.getElementById('file-preview').classList.add('d-flex');
            }
        }

        $(document).ready(function () {
            let authorIndex = @existingAuthors.Count;

            function getAuthorRowTemplate(index) {
                return `
                    <div class="author-card p-4 mb-3 position-relative author-row">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3 remove-author-btn" aria-label="${removeLabel}"></button>

                        <h6 class="fw-bold text-primary mb-3">${coAuthorPrefix} #${index + 1}</h6>
                        <input type="hidden" name="Authors.Index" value="${index}" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">${firstNameLabel}</label>
                                <input name="Authors[${index}].FirstName" class="form-control-modern" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${lastNameLabel}</label>
                                <input name="Authors[${index}].LastName" class="form-control-modern" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${emailLabel}</label>
                                <input name="Authors[${index}].Email" class="form-control-modern" type="email" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${institutionLabel}</label>
                                <input name="Authors[${index}].Institution" class="form-control-modern" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${orcidLabel}</label>
                                <input name="Authors[${index}].ORCID" class="form-control-modern" placeholder="${orcidPlaceholder}" />
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="Authors[${index}].IsCorrespondingAuthor" value="true">
                                    <label class="form-check-label small text-muted fw-bold">${correspondingAuthorLabel}</label>
                                </div>

                                <input type="hidden" name="Authors[${index}].Order" value="${index + 2}" />
                            </div>
                        </div>
                    </div>
                `;
            }

            $('#add-author-btn').click(function () {
                $('#author-list').append(getAuthorRowTemplate(authorIndex));
                authorIndex++;
            });

            $(document).on('click', '.remove-author-btn', function () {
                $(this).closest('.author-row').remove();
            });
        });
    </script>
}
@using AntAbstract.Domain.Entities
@model AntAbstract.Domain.Entities.Submission

@{
    ViewData["Title"] = "";
    Layout = "_LayoutDashboard";

    var slug = ViewBag.Slug as string ?? "";
    var backUrl = string.IsNullOrWhiteSpace(slug)
        ? "/Submission/Index"
        : $"/{slug}/my-submissions";
}

<div class="container py-5" style="max-width:600px;">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <div class="mb-3">
                    <span class="fs-1">🔙</span>
                </div>
                <h4 class="fw-bold text-dark"></h4>
                <p class="text-muted">Bu bildiriyi geri çekmek istediğinizden emin misiniz?</p>
            </div>

            <div class="alert alert-warning border-0 rounded-3 mb-4">
                <div class="fw-semibold mb-1">
                    <i class="fas fa-exclamation-triangle me-2"></i>@Model.Title
                </div>
                <small class="text-muted">
                    
                    <strong></strong> olarak güncellenecektir. .
                </small>
            </div>

            <form asp-action="WithdrawConfirmed" asp-route-id="@Model.Id" asp-route-slug="@slug" method="post">
                @Html.AntiForgeryToken()

                <div class="d-flex gap-2">
                    <a href="@backUrl" class="btn btn-outline-secondary flex-fill">
                        <i class="fas fa-arrow-left me-1"></i> Vazgeç
                    </a>
                    <button type="submit" class="btn btn-warning flex-fill text-dark fw-semibold">
                        <i class="fas fa-undo-alt me-1"></i> Geri Çek
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

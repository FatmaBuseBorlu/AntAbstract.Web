@using AntAbstract.Domain.Entities
@using AntAbstract.Application.DTOs.Submission
@using Microsoft.AspNetCore.Http
@using System
@using System.Globalization
@using System.Linq
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model SubmissionDto

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    var conferenceTitle = Context.Session.GetString("SelectedConferenceTitle") ?? "";

    string BuildConferenceUrl(string cleanPath, string fallbackPath)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return fallbackPath;
        }

        return $"/{slug}{cleanPath}";
    }

    var listUrl = BuildConferenceUrl(
        "/my-submissions",
        "/Submission/Index"
    );

    var editUrl = BuildConferenceUrl(
        $"/my-submissions/{Model.Id}/edit",
        $"/Submission/Edit/{Model.Id}"
    );

    var deleteUrl = BuildConferenceUrl(
        $"/my-submissions/{Model.Id}/delete",
        $"/Submission/Delete/{Model.Id}"
    );

    var uploadRevisionUrl = BuildConferenceUrl(
        $"/my-submissions/{Model.Id}/revision",
        $"/Submission/UploadRevision/{Model.Id}"
    );

    var acceptanceLetterUrl = BuildConferenceUrl(
        $"/my-submissions/{Model.Id}/acceptance-letter",
        $"/Submission/DownloadAcceptanceLetter/{Model.Id}"
    );

    var rejectionLetterUrl = BuildConferenceUrl(
        $"/my-submissions/{Model.Id}/rejection-letter",
        $"/Submission/DownloadRejectionLetter/{Model.Id}"
    );

    var badgeUrl = BuildConferenceUrl(
        $"/my-submissions/{Model.Id}/badge",
        $"/Submission/DownloadBadge/{Model.Id}"
    );

    var certificatesUrl = BuildConferenceUrl(
        "/Certificates",
        "/Certificates"
    );

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string L(string key, string tr, string en)
    {
        var value = Localizer[key].Value;

        if (string.Equals(value, key, StringComparison.OrdinalIgnoreCase))
        {
            return isEnglish ? en : tr;
        }

        return value;
    }

    SubmissionStatus currentStatus = SubmissionStatus.New;

    if (Enum.TryParse<SubmissionStatus>(Model.Status, out var parsedStatus))
    {
        currentStatus = parsedStatus;
    }

    string statusBadgeClass = currentStatus switch
    {
        SubmissionStatus.New => "detail-status-new",
        SubmissionStatus.Pending => "detail-status-pending",
        SubmissionStatus.UnderReview => "detail-status-review",
        SubmissionStatus.RevisionRequired => "detail-status-revision",
        SubmissionStatus.Accepted => "detail-status-accepted",
        SubmissionStatus.Rejected => "detail-status-rejected",
        SubmissionStatus.Presented => "detail-status-presented",
        SubmissionStatus.Withdrawn => "detail-status-withdrawn",
        _ => "detail-status-new"
    };

    string statusText = currentStatus switch
    {
        SubmissionStatus.New => L("Status_New", "Yeni Gönderim", "New Submission"),
        SubmissionStatus.Pending => L("Status_Pending", "Beklemede", "Pending"),
        SubmissionStatus.UnderReview => L("Status_UnderReview", "Değerlendirmede", "Under Review"),
        SubmissionStatus.RevisionRequired => L("Status_RevisionRequired", "Revizyon Gerekli", "Revision Required"),
        SubmissionStatus.Accepted => L("Status_Accepted", "Kabul Edildi", "Accepted"),
        SubmissionStatus.Rejected => L("Status_Rejected", "Reddedildi", "Rejected"),
        SubmissionStatus.Presented => L("Status_Presented", "Sunuldu", "Presented"),
        SubmissionStatus.Withdrawn => L("Status_Withdrawn", "Geri Çekildi", "Withdrawn"),
        _ => Model.Status
    };

    string presentationTypeText = Model.PresentationType switch
    {
        "Oral" => L("PresentationTypeOral", "Sözlü Sunum", "Oral Presentation"),
        "Poster" => L("PresentationTypePoster", "Poster Sunum", "Poster Presentation"),
        "Online" => L("PresentationTypeOnline", "Çevrimiçi Sunum", "Online Presentation"),
        "0" => L("PresentationTypeOral", "Sözlü Sunum", "Oral Presentation"),
        "1" => L("PresentationTypePoster", "Poster Sunum", "Poster Presentation"),
        _ => string.IsNullOrWhiteSpace(Model.PresentationType)
            ? L("NotSpecified", "Belirtilmedi", "Not specified")
            : Model.PresentationType
    };

    bool stepSubmitted = true;

    bool stepReview = currentStatus == SubmissionStatus.UnderReview
        || currentStatus == SubmissionStatus.RevisionRequired
        || currentStatus == SubmissionStatus.Accepted
        || currentStatus == SubmissionStatus.Rejected
        || currentStatus == SubmissionStatus.Presented;

    bool stepDecision = currentStatus == SubmissionStatus.Accepted
        || currentStatus == SubmissionStatus.Rejected
        || currentStatus == SubmissionStatus.Presented;

    bool stepCompleted = currentStatus == SubmissionStatus.Presented;
}


@using AntAbstract.Domain.Entities
@using AntAbstract.Application.DTOs.Submission
@using Microsoft.AspNetCore.Http
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model SubmissionDto

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    var slug = ViewContext.RouteData.Values["slug"]?.ToString()
        ?? Context.Session.GetString("SelectedConferenceSlug")
        ?? "";

    string BuildUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(slug))
        {
            return path;
        }

        return $"/{slug}{path}";
    }

    var listUrl = BuildUrl("/Submission/Index");
    var editUrl = BuildUrl($"/Submission/Edit/{Model.Id}");
    var deleteUrl = BuildUrl($"/Submission/Delete/{Model.Id}");
    var uploadRevisionUrl = BuildUrl($"/Submission/UploadRevision/{Model.Id}");
    var acceptanceLetterUrl = BuildUrl($"/Submission/DownloadAcceptanceLetter/{Model.Id}");
    var rejectionLetterUrl = BuildUrl($"/Submission/DownloadRejectionLetter/{Model.Id}");
    var badgeUrl = BuildUrl($"/Submission/DownloadBadge/{Model.Id}");

    var isEnglish = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    string L(string key, string tr, string en)
    {
        var value = Localizer[key].Value;

        if (string.Equals(value, key, StringComparison.OrdinalIgnoreCase))
        {
            return isEnglish ? en : tr;
        }

        return value;
    }

    SubmissionStatus currentStatus = SubmissionStatus.New;

    if (Enum.TryParse<SubmissionStatus>(Model.Status, out var parsedStatus))
    {
        currentStatus = parsedStatus;
    }

    string statusBadgeClass = currentStatus switch
    {
        SubmissionStatus.New => "bg-primary bg-opacity-10 text-primary border-primary",
        SubmissionStatus.Pending => "bg-warning bg-opacity-10 text-warning border-warning",
        SubmissionStatus.UnderReview => "bg-warning bg-opacity-10 text-warning border-warning",
        SubmissionStatus.RevisionRequired => "bg-info bg-opacity-10 text-info border-info",
        SubmissionStatus.Accepted => "bg-success bg-opacity-10 text-success border-success",
        SubmissionStatus.Rejected => "bg-danger bg-opacity-10 text-danger border-danger",
        SubmissionStatus.Presented => "bg-primary text-white border-primary",
        SubmissionStatus.Withdrawn => "bg-secondary bg-opacity-10 text-secondary border-secondary",
        _ => "bg-light text-dark border"
    };

    string statusText = currentStatus switch
    {
        SubmissionStatus.New => L("Status_New", "Yeni Gönderim", "New Submission"),
        SubmissionStatus.Pending => L("Status_Pending", "Beklemede", "Pending"),
        SubmissionStatus.UnderReview => L("Status_UnderReview", "Değerlendirmede", "Under Review"),
        SubmissionStatus.RevisionRequired => L("Status_RevisionRequired", "Revizyon Gerekli", "Revision Required"),
        SubmissionStatus.Accepted => L("Status_Accepted", "Kabul Edildi", "Accepted"),
        SubmissionStatus.Rejected => L("Status_Rejected", "Reddedildi", "Rejected"),
        SubmissionStatus.Presented => L("Status_Presented", "Sunuldu", "Presented"),
        SubmissionStatus.Withdrawn => L("Status_Withdrawn", "Geri Çekildi", "Withdrawn"),
        _ => Model.Status
    };

    string presentationTypeText = Model.PresentationType switch
    {
        "Oral" => L("PresentationTypeOral", "Sözlü Sunum", "Oral Presentation"),
        "Poster" => L("PresentationTypePoster", "Poster Sunum", "Poster Presentation"),
        "Online" => L("PresentationTypeOnline", "Çevrimiçi Sunum", "Online Presentation"),
        "0" => L("PresentationTypeOral", "Sözlü Sunum", "Oral Presentation"),
        "1" => L("PresentationTypePoster", "Poster Sunum", "Poster Presentation"),
        _ => string.IsNullOrWhiteSpace(Model.PresentationType)
            ? L("NotSpecified", "Belirtilmedi", "Not specified")
            : Model.PresentationType
    };

    bool stepSubmitted = true;
    bool stepReview = currentStatus == SubmissionStatus.UnderReview
        || currentStatus == SubmissionStatus.RevisionRequired
        || currentStatus == SubmissionStatus.Accepted
        || currentStatus == SubmissionStatus.Rejected
        || currentStatus == SubmissionStatus.Presented;

    bool stepDecision = currentStatus == SubmissionStatus.Accepted
        || currentStatus == SubmissionStatus.Rejected
        || currentStatus == SubmissionStatus.Presented;

    bool stepCompleted = currentStatus == SubmissionStatus.Presented;
}

<style>
    .timeline-steps {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

        .timeline-steps .timeline-step {
            align-items: center;
            display: flex;
            flex-direction: column;
            position: relative;
            margin: 0 1rem;
        }

        .timeline-steps .timeline-content {
            width: 110px;
            text-align: center;
        }

            .timeline-steps .timeline-content .inner-circle {
                border-radius: 1.5rem;
                height: 3rem;
                width: 3rem;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background-color: #eef2f5;
                color: #99a2a8;
                border: 2px solid #eef2f5;
                z-index: 10;
                position: relative;
                font-weight: bold;
                transition: all 0.3s;
            }

                .timeline-steps .timeline-content .inner-circle.active {
                    background-color: #00aeef;
                    color: #fff;
                    border-color: #00aeef;
                    box-shadow: 0 0 0 4px rgba(0, 174, 239, 0.2);
                }

        .timeline-steps .timeline-step:not(:last-child):after {
            content: "";
            display: block;
            border-top: 3px solid #eef2f5;
            width: 100%;
            position: absolute;
            left: 50%;
            top: 1.5rem;
            z-index: 0;
        }

        .timeline-steps .timeline-step.completed:not(:last-child):after {
            border-top-color: #00aeef;
        }

    .detail-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        background: #fff;
        height: 100%;
    }

    .info-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: 0.85rem;
        font-weight: 600;
        margin-right: 6px;
        margin-bottom: 6px;
    }

    .nav-tabs-custom .nav-link {
        border: none;
        color: #64748b;
        font-weight: 600;
        padding: 15px 20px;
        border-bottom: 2px solid transparent;
    }

        .nav-tabs-custom .nav-link.active {
            color: #00aeef;
            background: transparent;
            border-bottom-color: #00aeef;
        }

        .nav-tabs-custom .nav-link:hover {
            color: #00aeef;
        }

    .abstract-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 24px;
    }

    @@media (max-width: 768px) {
        .timeline-steps .timeline-step {
            margin: 0.5rem;
        }

            .timeline-steps .timeline-step:not(:last-child):after {
                display: none;
            }
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                @L("PageHeading", "Bildiri Detayı", "Abstract Details")
            </h4>

            <div class="d-flex align-items-center flex-wrap">
                <span class="badge bg-light text-dark border me-2">
                    #@Model.Id.ToString().Substring(0, 8).ToUpper()
                </span>

                <span class="text-muted small">
                    @Model.Title
                </span>
            </div>
        </div>

        <a href="@listUrl" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-bold">
            <i class="fas fa-arrow-left me-1"></i>
            @L("BackToListButton", "Listeye Dön", "Back to List")
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-5 p-4">
        <div class="timeline-steps">
            <div class="timeline-step @(stepReview ? "completed" : "")">
                <div class="timeline-content">
                    <div class="inner-circle @(stepSubmitted ? "active" : "")">1</div>
                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepSubmitted", "Gönderildi", "Submitted")
                    </p>
                </div>
            </div>

            <div class="timeline-step @(stepDecision ? "completed" : "")">
                <div class="timeline-content">
                    <div class="inner-circle @(stepReview ? "active" : "")">2</div>
                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepReview", "Değerlendirme", "Review")
                    </p>
                </div>
            </div>

            <div class="timeline-step @(stepCompleted ? "completed" : "")">
                <div class="timeline-content">
                    <div class="inner-circle @(stepDecision ? "active" : "")">3</div>
                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepDecision", "Karar", "Decision")
                    </p>
                </div>
            </div>

            <div class="timeline-step">
                <div class="timeline-content">
                    <div class="inner-circle @(stepCompleted ? "active" : "")">
                        <i class="fas fa-check"></i>
                    </div>
                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepCompleted", "Tamamlandı", "Completed")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="detail-card p-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">
                    @L("CurrentStatusHeader", "Mevcut Durum", "Current Status")
                </h6>

                <div class="d-flex align-items-center mb-3">
                    <div class="display-4 me-3">
                        @if (currentStatus == SubmissionStatus.Accepted)
                        {
                            <i class="fas fa-check-circle text-success"></i>
                        }
                        else if (currentStatus == SubmissionStatus.Rejected)
                        {
                            <i class="fas fa-times-circle text-danger"></i>
                        }
                        else if (currentStatus == SubmissionStatus.RevisionRequired)
                        {
                            <i class="fas fa-exclamation-circle text-info"></i>
                        }
                        else if (currentStatus == SubmissionStatus.Withdrawn)
                        {
                            <i class="fas fa-ban text-secondary"></i>
                        }
                        else
                        {
                            <i class="fas fa-hourglass-half text-warning"></i>
                        }
                    </div>

                    <div>
                        <span class="badge @statusBadgeClass fs-6 px-3 py-2 rounded-3">
                            @statusText
                        </span>

                        <small class="text-muted d-block mt-1">
                            @L("LastUpdatedLabel", "Son güncelleme:", "Last updated:")
                            @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>

                @if (currentStatus == SubmissionStatus.Withdrawn)
                {
                    <div class="alert alert-secondary small mb-0">
                        <i class="fas fa-ban me-1"></i>
                        @L("WithdrawnInfo", "Bu bildiri geri çekilmiştir.", "This abstract has been withdrawn.")
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="detail-card p-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">
                    @L("QuickActionsHeader", "Hızlı İşlemler", "Quick Actions")
                </h6>

                <div class="d-grid gap-2">
                    @if (currentStatus == SubmissionStatus.New || currentStatus == SubmissionStatus.Pending)
                    {
                        <a href="@editUrl" class="btn btn-outline-primary fw-bold text-start">
                            <i class="fas fa-edit me-2"></i>
                            @L("EditSubmissionButton", "Bildiriyi Düzenle", "Edit Abstract")
                        </a>

                        <a href="@deleteUrl" class="btn btn-outline-danger fw-bold text-start">
                            <i class="fas fa-trash-alt me-2"></i>
                            @L("DeleteSubmissionButton", "Bildiriyi Sil", "Delete Abstract")
                        </a>

                        <small class="text-muted text-center d-block mt-2">
                            @L("EditDeleteHelpText", "Değerlendirme başlamadan önce bildirinizi düzenleyebilir veya silebilirsiniz.", "You can edit or delete your abstract before the review process starts.")
                        </small>
                    }
                    else if (currentStatus == SubmissionStatus.RevisionRequired)
                    {
                        <div class="alert alert-warning small mb-2 p-2 border-warning text-dark">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            @L("RevisionRequestedInfo", "Bu bildiri için revizyon istenmiştir.", "A revision has been requested for this abstract.")
                        </div>

                        <a href="@uploadRevisionUrl" class="btn btn-warning fw-bold">
                            <i class="fas fa-upload me-2"></i>
                            @L("UploadRevisionButton", "Revizyon Yükle", "Upload Revision")
                        </a>
                    }
                    else if (currentStatus == SubmissionStatus.Rejected)
                    {
                        <a href="@rejectionLetterUrl" target="_blank" class="btn btn-outline-danger fw-bold">
                            <i class="fas fa-file-pdf me-2"></i>
                            @L("DownloadRejectionLetterButton", "Red Mektubunu İndir", "Download Rejection Letter")
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-light border text-muted small text-center mb-0">
                            <i class="fas fa-lock me-1"></i>
                            @L("NoActionAvailable", "Bu aşamada yapılabilecek işlem bulunmuyor.", "No action is available at this stage.")
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="detail-card p-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">
                    @L("DocumentsHeader", "Belgeler", "Documents")
                </h6>

                <div class="d-grid gap-2">
                    @if (currentStatus == SubmissionStatus.Accepted || currentStatus == SubmissionStatus.Presented)
                    {
                        <a href="@acceptanceLetterUrl" target="_blank" class="btn btn-outline-success fw-bold text-start">
                            <i class="fas fa-file-contract me-2"></i>
                            @L("AcceptanceLetterButton", "Kabul Mektubu", "Acceptance Letter")
                        </a>

                        <a href="@badgeUrl" target="_blank" class="btn btn-outline-dark fw-bold text-start">
                            <i class="fas fa-id-badge me-2"></i>
                            @L("GenerateBadgeButton", "Yaka Kartı Oluştur", "Generate Badge")
                        </a>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-file-invoice fa-2x mb-2 opacity-25"></i>

                            <p class="small mb-0">
                                @L("DocumentsAvailableAfterAcceptance", "Belgeler kabul sonrası kullanılabilir.", "Documents will be available after acceptance.")
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs nav-tabs-custom px-4" id="detailTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active"
                            id="info-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#info"
                            type="button">
                        @L("TabSummary", "Bildiri Özeti", "Summary")
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link"
                            id="authors-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#authors"
                            type="button">
                        @L("TabAuthors", "Yazarlar", "Authors")
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link"
                            id="files-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#files"
                            type="button">
                        @L("TabFiles", "Dosya Geçmişi", "File History")
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="tab-content" id="detailTabsContent">

                <div class="tab-pane fade show active" id="info" role="tabpanel">
                    <h4 class="fw-bold text-dark mb-4">
                        @Model.Title
                    </h4>

                    <div class="mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.Topic))
                        {
                            <span class="info-chip">
                                <i class="fas fa-layer-group text-primary"></i>
                                @L("TopicLabel", "Bildiri Konusu / Tema", "Abstract Topic / Theme"):
                                @Model.Topic
                            </span>
                        }

                        <span class="info-chip">
                            <i class="fas fa-chalkboard-teacher text-primary"></i>
                            @L("PresentationTypeLabel", "Sunum Türü", "Presentation Type"):
                            @presentationTypeText
                        </span>

                        <span class="info-chip">
                            <i class="fas fa-calendar-alt text-primary"></i>
                            @L("SubmissionDateLabel", "Gönderim Tarihi", "Submission Date"):
                            @Model.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy")
                        </span>
                    </div>

                    <div class="abstract-box">
                        <p class="mb-0 text-secondary"
                           style="white-space: pre-wrap; line-height: 1.8; font-size: 1.05rem;">
                            @Model.Abstract
                        </p>
                    </div>

                    <div class="mt-4">
                        <span class="text-muted small text-uppercase fw-bold me-2">
                            @L("KeywordsLabel", "Anahtar Kelimeler", "Keywords")
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.Keywords))
                        {
                            foreach (var key in Model.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border me-1">
                                    @key.Trim()
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">
                                @L("NoKeywordsMessage", "Anahtar kelime girilmemiş.", "No keywords provided.")
                            </span>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="authors" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th>@L("AuthorsTableOrder", "Sıra", "Order")</th>
                                    <th>@L("AuthorsTableFullName", "Ad Soyad", "Full Name")</th>
                                    <th>@L("AuthorsTableInstitution", "Kurum", "Institution")</th>
                                    <th>@L("AuthorsTableEmail", "E-posta", "Email")</th>
                                    <th>@L("AuthorsTableStatus", "Durum", "Status")</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Authors != null && Model.Authors.Any())
                                {
                                    foreach (var author in Model.Authors.OrderBy(a => a.Order))
                                    {
                                        var firstInitial = !string.IsNullOrWhiteSpace(author.FirstName)
                                        ? author.FirstName.Substring(0, 1).ToUpper()
                                        : "";

                                        var lastInitial = !string.IsNullOrWhiteSpace(author.LastName)
                                        ? author.LastName.Substring(0, 1).ToUpper()
                                        : "";

                                        <tr>
                                            <td class="fw-bold text-muted">
                                                @author.Order
                                            </td>

                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                                         style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                        @firstInitial@lastInitial
                                                    </div>

                                                    <span class="fw-bold">
                                                        @author.FirstName @author.LastName
                                                    </span>
                                                </div>
                                            </td>

                                            <td class="text-muted">
                                                @author.Institution
                                            </td>

                                            <td class="text-muted">
                                                @author.Email
                                            </td>

                                            <td>
                                                @if (author.IsCorrespondingAuthor)
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        @L("CorrespondingAuthorBadge", "Sorumlu Yazar", "Corresponding Author")
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            @L("NoAuthorsMessage", "Yazar bilgisi bulunamadı.", "No author information found.")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="files" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th>@L("FilesTableVersion", "Versiyon", "Version")</th>
                                    <th>@L("FilesTableFileName", "Dosya Adı", "File Name")</th>
                                    <th>@L("FilesTableType", "Tür", "Type")</th>
                                    <th>@L("FilesTableUploadDate", "Yükleme Tarihi", "Upload Date")</th>
                                    <th>@L("FilesTableAction", "İşlem", "Action")</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Files != null && Model.Files.Any())
                                {
                                    foreach (var file in Model.Files.OrderByDescending(f => f.UploadedAt))
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary rounded-pill">
                                                    @L("VersionPrefix", "v", "v")@file.Version
                                                </span>
                                            </td>

                                            <td class="fw-bold text-dark">
                                                @file.FileName
                                            </td>

                                            <td>
                                                @file.Type
                                            </td>

                                            <td class="text-muted">
                                                @file.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </td>

                                            <td>
                                                <a href="@file.FilePath"
                                                   target="_blank"
                                                   class="btn btn-sm btn-primary fw-bold px-3">
                                                    <i class="fas fa-download me-1"></i>
                                                    @L("DownloadButton", "İndir", "Download")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            @L("NoFilesMessage", "Dosya bulunamadı.", "No files found.")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
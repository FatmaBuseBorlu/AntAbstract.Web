<div class="submission-detail-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-success mb-4">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-info mb-4">
            <i class="fas fa-circle-info"></i>
            <span>@TempData["InfoMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert operation-alert operation-alert-error mb-4">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-file-lines"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("PageHeading", "Bildiri Detayı", "Abstract Details")
                </h3>

                <p class="program-lead">
                    @Model.Title
                </p>

                <div class="detail-ref-row">
                    <span class="detail-ref-badge">
                        <i class="fas fa-hashtag"></i>
                        @Model.Id.ToString().Substring(0, 8).ToUpper()
                    </span>
                </div>
            </div>
        </div>

        <div class="program-hero-actions">
            @if (!string.IsNullOrWhiteSpace(conferenceTitle))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-calendar-check"></i>
                    <span>@conferenceTitle</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(slug))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-link"></i>
                    <span>/@slug</span>
                </div>
            }

            <a href="@listUrl" class="program-hero-btn program-hero-btn-light">
                <i class="fas fa-arrow-left"></i>
                @L("BackToListButton", "Listeye Dön", "Back to List")
            </a>

            @if (currentStatus == SubmissionStatus.New || currentStatus == SubmissionStatus.Pending || currentStatus == SubmissionStatus.RevisionRequired)
            {
                <a href="@editUrl" class="program-hero-btn program-hero-btn-primary">
                    <i class="fas fa-edit"></i>
                    @L("EditSubmissionButton", "Düzenle", "Edit")
                </a>
            }
        </div>
    </div>

    <div class="timeline-card">
        <div class="timeline-steps">
            <div class="timeline-step @(stepReview ? "completed" : "")">
                <div class="timeline-content">
                    <div class="inner-circle @(stepSubmitted ? "active" : "")">1</div>

                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepSubmitted", "Gönderildi", "Submitted")
                    </p>
                </div>
            </div>

            <div class="timeline-step @(stepDecision ? "completed" : "")">
                <div class="timeline-content">
                    <div class="inner-circle @(stepReview ? "active" : "")">2</div>

                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepReview", "Değerlendirme", "Review")
                    </p>
                </div>
            </div>

            <div class="timeline-step @(stepCompleted ? "completed" : "")">
                <div class="timeline-content">
                    <div class="inner-circle @(stepDecision ? "active" : "")">3</div>

                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepDecision", "Karar", "Decision")
                    </p>
                </div>
            </div>

            <div class="timeline-step">
                <div class="timeline-content">
                    <div class="inner-circle @(stepCompleted ? "active" : "")">
                        <i class="fas fa-check"></i>
                    </div>

                    <p class="mt-2 mb-0 small fw-bold text-muted">
                        @L("StepCompleted", "Tamamlandı", "Completed")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="detail-card">
                <h6 class="detail-card-title">
                    @L("CurrentStatusHeader", "Mevcut Durum", "Current Status")
                </h6>

                <div class="d-flex align-items-center mb-3">
                    <div class="display-4 me-3">
                        @if (currentStatus == SubmissionStatus.Accepted)
                        {
                            <i class="fas fa-check-circle text-success"></i>
                        }
                        else if (currentStatus == SubmissionStatus.Rejected)
                        {
                            <i class="fas fa-times-circle text-danger"></i>
                        }
                        else if (currentStatus == SubmissionStatus.RevisionRequired)
                        {
                            <i class="fas fa-exclamation-circle text-info"></i>
                        }
                        else if (currentStatus == SubmissionStatus.Withdrawn)
                        {
                            <i class="fas fa-ban text-secondary"></i>
                        }
                        else
                        {
                            <i class="fas fa-hourglass-half text-warning"></i>
                        }
                    </div>

                    <div>
                        <span class="detail-status-badge @statusBadgeClass">
                            @statusText
                        </span>

                        <small class="text-muted d-block mt-2 fw-bold">
                            @L("LastUpdatedLabel", "Son güncelleme:", "Last updated:")
                            @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>

                @if (currentStatus == SubmissionStatus.Withdrawn)
                {
                    <div class="alert alert-secondary small mb-0">
                        <i class="fas fa-ban me-1"></i>
                        @L("WithdrawnInfo", "Bu bildiri geri çekilmiştir.", "This abstract has been withdrawn.")
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="detail-card">
                <h6 class="detail-card-title">
                    @L("QuickActionsHeader", "Hızlı İşlemler", "Quick Actions")
                </h6>

                <div class="d-grid gap-2">
                    @if (currentStatus == SubmissionStatus.New)
                    {
                        <a href="@editUrl" class="btn btn-outline-primary quick-action-btn">
                            <i class="fas fa-edit"></i>
                            @L("EditSubmissionButton", "Bildiriyi Düzenle", "Edit Abstract")
                        </a>

                        <a href="@deleteUrl" class="btn btn-outline-danger quick-action-btn">
                            <i class="fas fa-trash-alt"></i>
                            @L("DeleteSubmissionButton", "Bildiriyi Sil", "Delete Abstract")
                        </a>

                        <small class="text-muted text-center d-block mt-2">
                            @L("EditDeleteHelpText", "Değerlendirme başlamadan önce bildirinizi düzenleyebilir veya silebilirsiniz.", "You can edit or delete your abstract before the review process starts.")
                        </small>
                    }
                    else if (currentStatus == SubmissionStatus.Pending)
                    {
                        <a href="@editUrl" class="btn btn-outline-primary quick-action-btn">
                            <i class="fas fa-edit"></i>
                            @L("EditSubmissionButton", "Bildiriyi Düzenle", "Edit Abstract")
                        </a>

                        <div class="alert alert-light border text-muted small mb-0">
                            <i class="fas fa-lock me-1"></i>
                            @L("PendingDeleteNotAllowed", "Bu aşamada bildiri silinemez.", "The abstract cannot be deleted at this stage.")
                        </div>
                    }
                    else if (currentStatus == SubmissionStatus.RevisionRequired)
                    {
                        <div class="alert alert-warning small mb-2 p-2 border-warning text-dark">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            @L("RevisionRequestedInfo", "Bu bildiri için revizyon istenmiştir.", "A revision has been requested for this abstract.")
                        </div>

                        <a href="@uploadRevisionUrl" class="btn btn-warning quick-action-btn">
                            <i class="fas fa-upload"></i>
                            @L("UploadRevisionButton", "Revizyon Yükle", "Upload Revision")
                        </a>

                        <a href="@editUrl" class="btn btn-outline-primary quick-action-btn">
                            <i class="fas fa-edit"></i>
                            @L("EditSubmissionButton", "Bildiriyi Düzenle", "Edit Abstract")
                        </a>
                    }
                    else if (currentStatus == SubmissionStatus.Rejected)
                    {
                        <a href="@rejectionLetterUrl" target="_blank" class="btn btn-outline-danger quick-action-btn">
                            <i class="fas fa-file-pdf"></i>
                            @L("DownloadRejectionLetterButton", "Red Mektubunu İndir", "Download Rejection Letter")
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-light border text-muted small text-center mb-0">
                            <i class="fas fa-lock me-1"></i>
                            @L("NoActionAvailable", "Bu aşamada yapılabilecek işlem bulunmuyor.", "No action is available at this stage.")
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="detail-card">
                <h6 class="detail-card-title">
                    @L("DocumentsHeader", "Belgeler", "Documents")
                </h6>

                <div class="d-grid gap-2">
                    @if (currentStatus == SubmissionStatus.Accepted || currentStatus == SubmissionStatus.Presented)
                    {
                        <a href="@acceptanceLetterUrl" target="_blank" class="btn btn-outline-success quick-action-btn">
                            <i class="fas fa-file-contract"></i>
                            @L("AcceptanceLetterButton", "Kabul Mektubu", "Acceptance Letter")
                        </a>

                        <a href="@badgeUrl" target="_blank" class="btn btn-outline-dark quick-action-btn">
                            <i class="fas fa-id-badge"></i>
                            @L("GenerateBadgeButton", "Yaka Kartı Oluştur", "Generate Badge")
                        </a>

                        <a href="@certificatesUrl" class="btn btn-outline-primary quick-action-btn">
                            <i class="fas fa-certificate"></i>
                            @L("CertificateButton", "Sertifikalarım", "My Certificates")
                        </a>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-file-invoice fa-2x mb-2 opacity-25"></i>

                            <p class="small mb-0">
                                @L("DocumentsAvailableAfterAcceptance", "Belgeler kabul sonrası kullanılabilir.", "Documents will be available after acceptance.")
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="detail-tabs-card">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs nav-tabs-custom px-4" id="detailTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active"
                            id="info-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#info"
                            type="button">
                        @L("TabSummary", "Bildiri Özeti", "Summary")
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link"
                            id="authors-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#authors"
                            type="button">
                        @L("TabAuthors", "Yazarlar", "Authors")
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link"
                            id="files-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#files"
                            type="button">
                        @L("TabFiles", "Dosya Geçmişi", "File History")
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="tab-content" id="detailTabsContent">

                <div class="tab-pane fade show active" id="info" role="tabpanel">
                    <h4 class="fw-bold text-dark mb-4">
                        @Model.Title
                    </h4>

                    <div class="mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.Topic))
                        {
                            <span class="info-chip">
                                <i class="fas fa-layer-group text-primary"></i>
                                @L("TopicLabel", "Bildiri Konusu / Tema", "Abstract Topic / Theme"):
                                @Model.Topic
                            </span>
                        }

                        <span class="info-chip">
                            <i class="fas fa-chalkboard-teacher text-primary"></i>
                            @L("PresentationTypeLabel", "Sunum Türü", "Presentation Type"):
                            @presentationTypeText
                        </span>

                        <span class="info-chip">
                            <i class="fas fa-calendar-alt text-primary"></i>
                            @L("SubmissionDateLabel", "Gönderim Tarihi", "Submission Date"):
                            @Model.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy")
                        </span>
                    </div>

                    <div class="abstract-box">
                        <p class="mb-0 text-secondary"
                           style="white-space: pre-wrap; line-height: 1.8; font-size: 1.05rem;">
                            @Model.Abstract
                        </p>
                    </div>

                    <div class="mt-4">
                        <span class="text-muted small text-uppercase fw-bold me-2">
                            @L("KeywordsLabel", "Anahtar Kelimeler", "Keywords")
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.Keywords))
                        {
                            foreach (var key in Model.Keywords.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border me-1">
                                    @key.Trim()
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">
                                @L("NoKeywordsMessage", "Anahtar kelime girilmemiş.", "No keywords provided.")
                            </span>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="authors" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th>@L("AuthorsTableOrder", "Sıra", "Order")</th>
                                    <th>@L("AuthorsTableFullName", "Ad Soyad", "Full Name")</th>
                                    <th>@L("AuthorsTableInstitution", "Kurum", "Institution")</th>
                                    <th>@L("AuthorsTableEmail", "E-posta", "Email")</th>
                                    <th>@L("AuthorsTableStatus", "Durum", "Status")</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Authors != null && Model.Authors.Any())
                                {
                                    foreach (var author in Model.Authors.OrderBy(a => a.Order))
                                    {
                                        var firstInitial = !string.IsNullOrWhiteSpace(author.FirstName)
                                            ? author.FirstName.Substring(0, 1).ToUpper()
                                            : "";

                                        var lastInitial = !string.IsNullOrWhiteSpace(author.LastName)
                                            ? author.LastName.Substring(0, 1).ToUpper()
                                            : "";

                                        <tr>
                                            <td class="fw-bold text-muted">
                                                @author.Order
                                            </td>

                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                                         style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                        @firstInitial@lastInitial
                                                    </div>

                                                    <span class="fw-bold">
                                                        @author.FirstName @author.LastName
                                                    </span>
                                                </div>
                                            </td>

                                            <td class="text-muted">
                                                @author.Institution
                                            </td>

                                            <td class="text-muted">
                                                @author.Email
                                            </td>

                                            <td>
                                                @if (author.IsCorrespondingAuthor)
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        @L("CorrespondingAuthorBadge", "Sorumlu Yazar", "Corresponding Author")
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            @L("NoAuthorsMessage", "Yazar bilgisi bulunamadı.", "No author information found.")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="files" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th>@L("FilesTableVersion", "Versiyon", "Version")</th>
                                    <th>@L("FilesTableFileName", "Dosya Adı", "File Name")</th>
                                    <th>@L("FilesTableType", "Tür", "Type")</th>
                                    <th>@L("FilesTableUploadDate", "Yükleme Tarihi", "Upload Date")</th>
                                    <th>@L("FilesTableAction", "İşlem", "Action")</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Files != null && Model.Files.Any())
                                {
                                    foreach (var file in Model.Files.OrderByDescending(f => f.UploadedAt))
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary rounded-pill">
                                                    @L("VersionPrefix", "v", "v")@file.Version
                                                </span>
                                            </td>

                                            <td class="fw-bold text-dark">
                                                @file.FileName
                                            </td>

                                            <td>
                                                @file.Type
                                            </td>

                                            <td class="text-muted">
                                                @file.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </td>

                                            <td>
                                                <a href="@file.FilePath"
                                                   target="_blank"
                                                   class="btn btn-sm btn-primary fw-bold px-3">
                                                    <i class="fas fa-download me-1"></i>
                                                    @L("DownloadButton", "İndir", "Download")
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            @L("NoFilesMessage", "Dosya bulunamadı.", "No files found.")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<div class="edit-submission-page">




    <div class="program-hero">
        <div class="program-hero-left">
            <div class="program-hero-icon">
                <i class="fas fa-pen-to-square"></i>
            </div>

            <div>
                <h3 class="program-title">
                    @L("PageHeading", "Bildiriyi Düzenle", "Edit Abstract")
                </h3>

                <p class="program-lead">
                    @L("PageLead", "Bildiri bilgilerinizi güncelleyebilir, yazarları düzenleyebilir ve yeni dosya versiyonu yükleyebilirsiniz.", "You can update your abstract information, edit authors, and upload a new file version.")
                </p>
            </div>
        </div>

        <div class="program-hero-actions">
            @if (!string.IsNullOrWhiteSpace(conferenceTitle))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-calendar-check"></i>
                    <span>@conferenceTitle</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(slug))
            {
                <div class="program-conference-pill">
                    <i class="fas fa-link"></i>
                    <span>/@slug</span>
                </div>
            }

            <a href="@backUrl" class="program-hero-btn program-hero-btn-light">
                <i class="fas fa-arrow-left"></i>
                @L("BackButton", "Listeye Dön", "Back to List")
            </a>

            <a href="@detailsUrl" class="program-hero-btn program-hero-btn-primary">
                <i class="fas fa-eye"></i>
                @L("DetailsButton", "Detayı Gör", "View Details")
            </a>
        </div>
    </div>

    <form action="@postUrl"
          enctype="multipart/form-data"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="ConferenceId" value="@Model.ConferenceId" />

        @if (hasValidationErrors)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert validation-summary-errors mb-4 shadow-sm", role = "alert" })
        }

        <div class="edit-card">
            <div class="edit-card-header">
                <div class="edit-step-title">
                    <div class="edit-step-number">1</div>

                    <div>
                        <h5>
                            @L("StudyInfoHeader", "Çalışma Bilgileri", "Study Information")
                        </h5>

                        <span>
                            @L("StudyInfoSubtitle", "Bildiri başlığı, türü, konusu ve özet bilgilerini düzenleyin.", "Edit the title, type, topic and abstract information.")
                        </span>
                    </div>
                </div>
            </div>

            <div class="edit-card-body">
                <div class="mb-4">
                    <label for="Title" class="form-label">
                        @L("TitleLabel", "Bildiri Başlığı", "Abstract Title")
                        <span class="text-danger">*</span>
                    </label>

                    <input id="Title"
                           name="Title"
                           value="@Model.Title"
                           maxlength="200"
                           class="form-control-modern"
                           placeholder="@L("TitlePlaceholder", "Bildiri başlığını giriniz", "Enter abstract title")" />

                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small fw-bold mt-2 d-block" })
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="PresentationType" class="form-label">
                            @L("PresentationTypeLabel", "Sunum Türü", "Presentation Type")
                            <span class="text-danger">*</span>
                        </label>

                        <select id="PresentationType"
                                name="PresentationType"
                                class="form-select-modern">
                            <option value="">
                                @L("SelectPresentationTypeOption", "Sunum türü seçiniz", "Select presentation type")
                            </option>

                            <option value="Oral" selected="@(string.Equals(presentationTypeValue, "Oral", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @L("PresentationTypeOral", "Sözlü Sunum", "Oral Presentation")
                            </option>

                            <option value="Poster" selected="@(string.Equals(presentationTypeValue, "Poster", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @L("PresentationTypePoster", "Poster Sunum", "Poster Presentation")
                            </option>

                            <option value="Online" selected="@(string.Equals(presentationTypeValue, "Online", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @L("PresentationTypeOnline", "Çevrimiçi Sunum", "Online Presentation")
                            </option>
                        </select>

                        @Html.ValidationMessageFor(m => m.PresentationType, "", new { @class = "text-danger small fw-bold mt-2 d-block" })
                    </div>

                    <div class="col-md-6">
                        <label for="ConferenceTopicId" class="form-label">
                            @L("TopicLabel", "Bildiri Konusu / Tema", "Abstract Topic / Theme")
                            <span class="text-danger">*</span>
                        </label>

                        @if (Model.AvailableTopics == null || !Model.AvailableTopics.Any())
                        {
                            <div class="modern-notice">
                                <i class="fas fa-info"></i>
                                <span>
                                    @L("NoTopicsDefinedMessage", "Bu kongre için henüz bildiri konusu tanımlanmamış.", "No abstract topics have been defined for this congress yet.")
                                </span>
                            </div>
                        }
                        else
                        {
                            <select id="ConferenceTopicId"
                                    name="ConferenceTopicId"
                                    class="form-select-modern">
                                <option value="">
                                    @L("SelectTopicOption", "Bildiri konusu seçiniz", "Select abstract topic")
                                </option>

                                @foreach (var topic in Model.AvailableTopics)
                                {
                                    var selectedTopicAttribute = string.Equals(topic.Value, selectedTopicValue, StringComparison.OrdinalIgnoreCase)
                                        ? "selected"
                                        : null;

                                    <option value="@topic.Value" selected="@selectedTopicAttribute">
                                        @topic.Text
                                    </option>
                                }
                            </select>
                        }

                        @Html.ValidationMessageFor(m => m.ConferenceTopicId, "", new { @class = "text-danger small fw-bold mt-2 d-block" })
                    </div>

                    <div class="col-md-12">
                        <label for="Keywords" class="form-label">
                            @L("KeywordsLabel", "Anahtar Kelimeler", "Keywords")
                            <span class="text-danger">*</span>
                        </label>

                        <input id="Keywords"
                               name="Keywords"
                               value="@Model.Keywords"
                               class="form-control-modern"
                               placeholder="@L("KeywordsPlaceholder", "Örn: yapay zeka, kırsal turizm, sürdürülebilirlik", "Example: AI, rural tourism, sustainability")" />

                        @Html.ValidationMessageFor(m => m.Keywords, "", new { @class = "text-danger small fw-bold mt-2 d-block" })
                    </div>
                </div>

                <div class="mt-4">
                    <label for="AbstractText" class="form-label">
                        @L("AbstractLabel", "Özet Metni", "Abstract Text")
                        <span class="text-danger">*</span>
                    </label>

                    <textarea id="AbstractText"
                              name="AbstractText"
                              maxlength="5000"
                              class="form-control-modern"
                              rows="8"
                              placeholder="@L("AbstractPlaceholder", "Özetinizi buraya yazın veya yapıştırın...", "Write or paste your abstract here...")">@Model.AbstractText</textarea>

                    @Html.ValidationMessageFor(m => m.AbstractText, "", new { @class = "text-danger small fw-bold mt-2 d-block" })
                </div>
            </div>
        </div>

        <div class="edit-card">
            <div class="edit-card-header">
                <div class="edit-step-title">
                    <div class="edit-step-number">2</div>

                    <div>
                        <h5>
                            @L("CoAuthorsHeader", "Yazar Bilgileri", "Author Information")
                        </h5>

                        <span>
                            @L("CoAuthorsSubtitle", "Bildiriye bağlı yazarları güncelleyebilirsiniz.", "You can update the authors linked to the abstract.")
                        </span>
                    </div>
                </div>
            </div>

            <div class="edit-card-body">
                <div class="author-info-card">
                    <i class="fas fa-info-circle"></i>

                    <div>
                        <div class="fw-bold mb-1">
                            @L("AuthorInfoTitle", "Yazar bilgilerini kontrol edin.", "Check author information.")
                        </div>

                        <div class="small fw-bold opacity-75">
                            @L("AuthorInfoText", "Bu listedeki yazarlar bildiri detaylarında ve PDF çıktılarında kullanılabilir.", "Authors in this list may be used in abstract details and PDF outputs.")
                        </div>
                    </div>
                </div>

                <div id="author-list">
                    @for (int i = 0; i < authors.Count; i++)
                    {
                        <div class="author-card p-4 mb-3 position-relative author-row">
                            <button type="button"
                                    class="btn-close position-absolute top-0 end-0 m-3 remove-author-btn"
                                    aria-label="@L("DeleteButton", "Sil", "Delete")"></button>

                            <h6 class="fw-bold text-primary mb-3">
                                @L("AuthorLabel", "Yazar", "Author") #@(i + 1)
                            </h6>

                            <input type="hidden" name="Authors.Index" value="@i" />
                            <input type="hidden" name="Authors[@i].Order" value="@(i + 1)" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorFirstNameLabel", "Ad", "First Name")
                                    </label>

                                    <input name="Authors[@i].FirstName"
                                           value="@authors[i].FirstName"
                                           class="form-control-modern"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorLastNameLabel", "Soyad", "Last Name")
                                    </label>

                                    <input name="Authors[@i].LastName"
                                           value="@authors[i].LastName"
                                           class="form-control-modern"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorEmailLabel", "E-posta", "Email")
                                    </label>

                                    <input name="Authors[@i].Email"
                                           value="@authors[i].Email"
                                           class="form-control-modern"
                                           type="email" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorInstitutionLabel", "Kurum", "Institution")
                                    </label>

                                    <input name="Authors[@i].Institution"
                                           value="@authors[i].Institution"
                                           class="form-control-modern"
                                           required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small">
                                        @L("AuthorOrcidLabel", "ORCID", "ORCID")
                                    </label>

                                    <input name="Authors[@i].ORCID"
                                           value="@authors[i].ORCID"
                                           class="form-control-modern"
                                           placeholder="0000-0000-0000-0000" />
                                </div>

                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="Authors[@i].IsCorrespondingAuthor"
                                               value="true"
                                               @(authors[i].IsCorrespondingAuthor ? "checked" : "") />

                                        <label class="form-check-label small text-muted fw-bold">
                                            @L("CorrespondingAuthorLabel", "Sorumlu yazar", "Corresponding author")
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button type="button"
                        class="btn-add-author w-100"
                        id="add-author-btn">
                    <i class="fas fa-plus-circle"></i>
                    @L("AddAuthorButton", "Yazar Ekle", "Add Author")
                </button>
            </div>
        </div>

        <div class="edit-card">
            <div class="edit-card-header">
                <div class="edit-step-title">
                    <div class="edit-step-number">3</div>

                    <div>
                        <h5>
                            @L("FileUpdateHeader", "Dosya Güncelleme", "File Update")
                        </h5>

                        <span>
                            @L("FileUpdateSubtitle", "Yeni dosya yüklerseniz mevcut dosyanın yeni versiyonu kaydedilir.", "If you upload a new file, it will be saved as a new version.")
                        </span>
                    </div>
                </div>
            </div>

            <div class="edit-card-body">
                @if (hasExistingFile)
                {
                    <div class="file-info-box">
                        <div class="file-info-left">
                            <div class="file-info-icon">
                                <i class="fas fa-file-pdf"></i>
                            </div>

                            <div>
                                <div class="file-info-title">
                                    @L("ExistingFileTitle", "Mevcut dosya var", "Existing file available")
                                </div>

                                <div class="file-info-text">
                                    @L("ExistingFileHelpText", "Yeni dosya yüklerseniz mevcut dosyanın yeni versiyonu olarak kaydedilir.", "If you upload a new file, it will be saved as a new version of the existing file.")
                                </div>
                            </div>
                        </div>

                        <a href="@(Model.ExistingFileId > 0 ? $"/download/submission/{Model.ExistingFileId}" : "#")"
                           target="_blank"
                           class="file-view-btn">
                            <i class="fas fa-eye"></i>
                            @L("ViewFileButton", "Dosyayı Gör", "View File")
                        </a>
                    </div>
                }

                <div class="mb-0">
                    <label for="SubmissionFile" class="form-label">
                        @L("NewFileLabel", "Yeni Dosya Yükle", "Upload New File")
                    </label>

                    <input id="SubmissionFile"
                           name="SubmissionFile"
                           type="file"
                           class="form-control-modern"
                           accept=".pdf,.docx,.doc" />

                    <div class="small text-muted fw-bold mt-2">
                        @L("FileHelpText", "PDF, DOC veya DOCX dosyası yükleyebilirsiniz. Maksimum dosya boyutu 10 MB olmalıdır.", "You can upload a PDF, DOC or DOCX file. Maximum file size should be 10 MB.")
                    </div>

                    @Html.ValidationMessageFor(m => m.SubmissionFile, "", new { @class = "text-danger small fw-bold mt-2 d-block" })
                </div>
            </div>
        </div>

        <div class="edit-actions">
            <a href="@backUrl" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                @L("CancelButton", "Vazgeç", "Cancel")
            </a>

            <button type="submit" class="btn-submit-modern">
                <i class="fas fa-save"></i>
                <span>
                    @L("SaveChangesButton", "Değişiklikleri Kaydet", "Save Changes")
                </span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const deleteLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("DeleteButton", "Sil", "Delete")));
        const authorLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorLabel", "Yazar", "Author")));
        const firstNameLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorFirstNameLabel", "Ad", "First Name")));
        const lastNameLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorLastNameLabel", "Soyad", "Last Name")));
        const institutionLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorInstitutionLabel", "Kurum", "Institution")));
        const emailLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorEmailLabel", "E-posta", "Email")));
        const orcidLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("AuthorOrcidLabel", "ORCID", "ORCID")));
        const correspondingAuthorLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L("CorrespondingAuthorLabel", "Sorumlu yazar", "Corresponding author")));

        $(document).ready(function () {
            let authorIndex = @(authors.Count);

            function getAuthorRowTemplate(index) {
                return `
                    <div class="author-card p-4 mb-3 position-relative author-row">
                        <button type="button"
                                class="btn-close position-absolute top-0 end-0 m-3 remove-author-btn"
                                aria-label="${deleteLabel}">
                        </button>

                        <h6 class="fw-bold text-primary mb-3">${authorLabel} #${index + 1}</h6>

                        <input type="hidden" name="Authors.Index" value="${index}" />
                        <input type="hidden" name="Authors[${index}].Order" value="${index + 1}" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small">${firstNameLabel}</label>
                                <input name="Authors[${index}].FirstName" class="form-control-modern" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${lastNameLabel}</label>
                                <input name="Authors[${index}].LastName" class="form-control-modern" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${emailLabel}</label>
                                <input name="Authors[${index}].Email" class="form-control-modern" type="email" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${institutionLabel}</label>
                                <input name="Authors[${index}].Institution" class="form-control-modern" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small">${orcidLabel}</label>
                                <input name="Authors[${index}].ORCID" class="form-control-modern" placeholder="0000-0000-0000-0000" />
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="Authors[${index}].IsCorrespondingAuthor"
                                           value="true" />

                                    <label class="form-check-label small text-muted fw-bold">
                                        ${correspondingAuthorLabel}
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>`;
            }

            $('#add-author-btn').click(function () {
                $('#author-list').append(getAuthorRowTemplate(authorIndex));
                authorIndex++;
            });

            $(document).on('click', '.remove-author-btn', function () {
                $(this).closest('.author-row').remove();
            });
        });
    </script>
}
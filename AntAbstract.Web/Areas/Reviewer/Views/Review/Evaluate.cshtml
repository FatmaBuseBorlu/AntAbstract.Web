@model AntAbstract.Application.DTOs.Review.ReviewAssignmentDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<style>
    .submission-info-card {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: none;
        overflow: hidden;
    }

    .abstract-box {
        background-color: #f8fafc;
        border-left: 4px solid #00aeef;
        padding: 20px;
        border-radius: 8px;
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.7;
    }

    .evaluation-card {
        background-color: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f1f5f9;
        position: sticky;
        top: 100px;
    }

    .decision-option {
        display: none;
    }

    .decision-label {
        display: block;
        padding: 15px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
        font-weight: 600;
        color: #64748b;
    }

        .decision-label:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
            transform: translateY(-2px);
        }

    .decision-option:checked + .decision-label {
        background-color: #e0f2fe;
        border-color: #00aeef;
        color: #00aeef;
        box-shadow: 0 4px 10px rgba(0, 174, 239, 0.2);
        transform: translateY(0);
    }

    .decision-option[value="Reject"]:checked + .decision-label {
        background-color: #fee2e2;
        border-color: #ef4444;
        color: #ef4444;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
    }

    .range-wrap {
        position: relative;
        margin: 0 auto 1rem;
    }

    .range {
        width: 100%;
        cursor: pointer;
        height: 8px;
        border-radius: 5px;
        accent-color: #00aeef;
    }

    .score-display {
        font-size: 3rem;
        font-weight: 900;
        color: #00aeef;
        text-align: center;
        display: block;
        margin-bottom: 5px;
        transition: color 0.3s ease;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">@Localizer["PanelTitle"]</h4>
            <p class="text-muted small mb-0">@Localizer["PanelDescription"]</p>
        </div>
        <a href="@Url.Action("Index", "Review", new { area = "" })" class="btn btn-outline-secondary rounded-pill px-4 btn-sm fw-bold">
            <i class="fas fa-arrow-left me-2"></i> @Localizer["BackToListButton"]
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="submission-info-card p-4 p-md-5 mb-4">

                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 mb-3 px-3 py-2 rounded-pill">
                    <i class="fas fa-hashtag me-1"></i> REF-@Model.Id.ToString("D8")
                </span>

                <h4 class="fw-bold text-dark mb-4 lh-base">@Model.SubmissionTitle</h4>

                <h6 class="text-uppercase text-muted small fw-bold mb-2 ls-1">
                    <i class="fas fa-align-left me-2"></i>@Localizer["AbstractHeading"]
                </h6>
                <div class="abstract-box mb-5">
                    @Model.SubmissionAbstract
                </div>

                <h6 class="text-uppercase text-muted small fw-bold mb-3 ls-1">
                    <i class="fas fa-paperclip me-2"></i>@Localizer["AttachedFilesHeading"]
                </h6>

                @if (Model.Files != null && Model.Files.Any())
                {
                    <div class="row g-3">
                        @foreach (var file in Model.Files)
                        {
                            <div class="col-md-6">
                                <a href="@file.FilePath" target="_blank" class="text-decoration-none">
                                    <div class="p-3 border rounded-3 bg-light d-flex align-items-center hover-shadow transition">
                                        <div class="bg-white p-2 rounded shadow-sm me-3 text-danger">
                                            <i class="fas fa-file-pdf fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate">@file.FileName</div>
                                            <small class="text-muted">@Localizer["ClickToViewText"]</small>
                                        </div>
                                        <i class="fas fa-external-link-alt text-primary ms-2"></i>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning border-0 small bg-warning bg-opacity-10 text-warning rounded-3">
                        <i class="fas fa-exclamation-triangle me-2"></i> @Localizer["NoDownloadableFilesWarning"]
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="evaluation-card">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="fw-bold m-0">
                        <i class="fas fa-gavel text-primary me-2"></i> @Localizer["ReviewerDecisionHeader"]
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger rounded-3 border-0 shadow-sm mb-4">
                            <i class="fas fa-times-circle me-2"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-area="" asp-controller="Review" asp-action="Evaluate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ReviewAssignmentId" value="@Model.Id" />

                        <div class="mb-5 text-center bg-light p-4 rounded-4 border">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-2">@Localizer["GeneralScoreLabel"]</label>
                            <span id="scoreValue" class="score-display">85</span>
                            <input type="range" class="form-range range mt-2" name="Score" id="scoreRange" min="0" max="100" value="85" oninput="updateScore(this.value)">
                            <div class="d-flex justify-content-between text-muted small px-1 mt-2 fw-bold">
                                <span class="text-danger">@Localizer["WeakScoreLabel"]</span>
                                <span class="text-success">@Localizer["ExcellentScoreLabel"]</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase mb-3">@Localizer["FinalDecisionLabel"]</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_accept" value="Accept" required>
                                    <label class="decision-label" for="rec_accept">
                                        <i class="fas fa-check-circle d-block fs-4 mb-2"></i> @Localizer["DecisionAccept"]
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_reject" value="Reject">
                                    <label class="decision-label" for="rec_reject">
                                        <i class="fas fa-times-circle d-block fs-4 mb-2"></i> @Localizer["DecisionReject"]
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_minor" value="MinorRevision">
                                    <label class="decision-label" for="rec_minor">
                                        <i class="fas fa-edit d-block fs-4 mb-2"></i> @Localizer["DecisionMinorRevision"]
                                    </label>
                                </div>
                                <div class="col-6">
                                    <input type="radio" class="decision-option" name="Recommendation" id="rec_major" value="MajorRevision">
                                    <label class="decision-label" for="rec_major">
                                        <i class="fas fa-sync-alt d-block fs-4 mb-2"></i> @Localizer["DecisionMajorRevision"]
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">
                                <i class="fas fa-user-edit me-2"></i>@Localizer["CommentsToAuthorLabel"]
                            </label>
                            <textarea name="CommentsToAuthor"
                                      class="form-control bg-light"
                                      rows="4"
                                      placeholder="@Localizer["CommentsToAuthorPlaceholder"]"
                                      style="border-radius: 12px; border: 1px solid #e2e8f0; resize: none;"
                                      required></textarea>
                            <div class="form-text small">@Localizer["CommentsToAuthorHelpText"]</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-danger small text-uppercase">
                                <i class="fas fa-user-secret me-2"></i>@Localizer["CommentsToEditorLabel"]
                            </label>
                            <textarea name="CommentsToEditor"
                                      class="form-control"
                                      rows="3"
                                      placeholder="@Localizer["CommentsToEditorPlaceholder"]"
                                      style="border-radius: 12px; border: 1px dashed #ef4444; background-color: #fff5f5; resize: none;"></textarea>
                            <div class="form-text small text-danger">@Localizer["CommentsToEditorHelpText"]</div>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary py-3 fw-bold rounded-pill shadow-sm" onclick="return confirm(reviewConfirmMessage);">
                                <i class="fas fa-paper-plane me-2"></i> @Localizer["SubmitReviewButton"]
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    const reviewConfirmMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["SubmitConfirmMessage"].Value));

    function updateScore(val) {
        document.getElementById('scoreValue').innerText = val;

        var scoreDisplay = document.getElementById('scoreValue');
        var scoreRange = document.getElementById('scoreRange');

        if (val < 50) {
            scoreDisplay.style.color = '#ef4444';
            scoreRange.style.accentColor = '#ef4444';
        }
        else if (val < 75) {
            scoreDisplay.style.color = '#f59e0b';
            scoreRange.style.accentColor = '#f59e0b';
        }
        else {
            scoreDisplay.style.color = '#10b981';
            scoreRange.style.accentColor = '#10b981';
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        updateScore(document.getElementById('scoreRange').value);
    });
</script>
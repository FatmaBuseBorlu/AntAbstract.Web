@using AntAbstract.Application.DTOs.Review
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model List<ReviewAssignmentDto>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";

    string L(string key, string fallback)
    {
        var value = Localizer[key].Value;

        return string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? fallback
            : value;
    }

    var assignments = Model ?? new List<ReviewAssignmentDto>();

    var pendingList = assignments
        .Where(x => !x.IsReviewed)
        .OrderBy(x => x.AssignedDate)
        .ToList();

    var completedList = assignments
        .Where(x => x.IsReviewed)
        .OrderByDescending(x => x.EvaluationDate)
        .ToList();

    var totalCount = assignments.Count;
    var pendingCount = pendingList.Count;
    var completedCount = completedList.Count;
}

<style>
    .review-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 1.25rem 1.5rem 4rem;
    }

    .review-hero {
        background: radial-gradient(circle at top right, rgba(245, 158, 11, 0.20), transparent 34%), linear-gradient(135deg, #ffffff 0%, #fffaf2 100%);
        border: 1px solid #f1e4cf;
        border-radius: 26px;
        padding: 1.45rem 1.55rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 16px 38px rgba(15, 23, 42, 0.055);
        margin-bottom: 1.5rem;
    }

    .review-hero-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 280px;
        flex: 1;
    }

    .review-hero-icon {
        width: 66px;
        height: 66px;
        min-width: 66px;
        border-radius: 24px;
        background: linear-gradient(135deg, #f59e0b, #f97316);
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 16px 32px rgba(249, 115, 22, 0.22);
    }

    .review-kicker {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .review-title {
        margin: 0 0 0.35rem;
        color: #0f172a;
        font-size: 1.8rem;
        font-weight: 950;
        letter-spacing: -0.045em;
        line-height: 1.15;
    }

    .review-description {
        margin: 0;
        color: #64748b;
        font-size: 0.95rem;
        font-weight: 650;
        line-height: 1.6;
    }

    .review-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .review-summary-card {
        background: #ffffff;
        border: 1px solid #e8eef6;
        border-radius: 22px;
        padding: 1.1rem;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.05);
        display: flex;
        align-items: center;
        gap: 0.95rem;
    }

    .summary-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .summary-icon.total {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .summary-icon.pending {
        background: rgba(245, 158, 11, 0.13);
        color: #f59e0b;
    }

    .summary-icon.completed {
        background: rgba(22, 163, 74, 0.11);
        color: #16a34a;
    }

    .summary-value {
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 950;
        line-height: 1;
        margin-bottom: 0.2rem;
    }

    .summary-label {
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 900;
    }

    .review-tabs {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 0.45rem;
        display: inline-flex;
        gap: 0.35rem;
        margin-bottom: 1.4rem;
        box-shadow: 0 10px 26px rgba(15, 23, 42, 0.045);
    }

    .review-tabs .nav-link {
        color: #64748b;
        font-weight: 900;
        padding: 0.7rem 1.15rem;
        border-radius: 999px;
        transition: all 0.2s ease;
        border: none;
    }

    .review-tabs .nav-link.active {
        background: linear-gradient(135deg, #00aeef, #2563eb);
        color: #ffffff;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.22);
    }

    .task-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        padding: 1.45rem;
        transition: all 0.24s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        border-left: 5px solid #f59e0b;
        position: relative;
        box-shadow: 0 16px 42px rgba(15, 23, 42, 0.055);
    }

    .task-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 62px rgba(15, 23, 42, 0.105);
        border-color: rgba(0, 174, 239, 0.32);
    }

    .task-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .task-ref-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
        font-size: 0.74rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .task-date {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .task-title {
        color: #0f172a;
        font-size: 1rem;
        font-weight: 950;
        line-height: 1.45;
        min-height: 48px;
        margin-bottom: 0.9rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .conference-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        width: fit-content;
        max-width: 100%;
        padding: 0.5rem 0.75rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.08);
        color: #0d6efd;
        border: 1px solid rgba(13, 110, 253, 0.14);
        font-size: 0.76rem;
        font-weight: 900;
        margin-bottom: 1.1rem;
    }

    .conference-badge span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .task-footer {
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid #eef2f7;
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .evaluate-btn {
        min-height: 42px;
        border-radius: 999px;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        flex: 1;
        box-shadow: 0 10px 24px rgba(13, 110, 253, 0.20);
    }

    .decline-btn {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .completed-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 26px;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .completed-card-header {
        padding: 1.2rem 1.4rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .completed-card-title {
        color: #0f172a;
        font-weight: 950;
        margin-bottom: 0.25rem;
    }

    .completed-card-subtitle {
        color: #64748b;
        font-size: 0.84rem;
        font-weight: 650;
        margin-bottom: 0;
    }

    .completed-table {
        margin-bottom: 0;
    }

    .completed-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.15rem;
        white-space: nowrap;
    }

    .completed-table tbody td {
        color: #475569;
        font-size: 0.9rem;
        font-weight: 700;
        padding: 1.05rem 1.15rem;
        vertical-align: middle;
        border-color: #edf2f7;
    }

    .submission-title-cell {
        color: #0f172a;
        font-weight: 950;
        max-width: 390px;
    }

    .completed-conference-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        max-width: 300px;
        margin-top: 0.4rem;
        padding: 0.35rem 0.6rem;
        border-radius: 999px;
        background: rgba(13, 110, 253, 0.07);
        color: #0d6efd;
        border: 1px solid rgba(13, 110, 253, 0.12);
        font-size: 0.72rem;
        font-weight: 850;
    }

    .completed-conference-badge span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .score-badge,
    .decision-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.45rem 0.75rem;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .empty-state {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        padding: 3.25rem 2rem;
        text-align: center;
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
        margin: 0;
    }

    .empty-state-content {
        max-width: 620px;
        margin: 0 auto;
    }

    .empty-icon {
        width: 82px;
        height: 82px;
        border-radius: 28px;
        background: rgba(0, 174, 239, 0.10);
        color: #0284c7;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin-bottom: 1.2rem;
    }

    .empty-title {
        color: #0f172a;
        font-weight: 950;
        letter-spacing: -0.035em;
        margin-bottom: 0.55rem;
    }

    .empty-description {
        color: #64748b;
        font-weight: 650;
        line-height: 1.7;
        margin-bottom: 0;
    }

    @@media (max-width: 991.98px) {
        .review-summary-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .review-page {
            padding: 1rem 1rem 3rem;
        }

        .review-hero-left {
            flex-direction: column;
            align-items: flex-start;
            min-width: 100%;
        }

        .review-tabs {
            width: 100%;
            border-radius: 22px;
            flex-direction: column;
        }

        .review-tabs .nav-link {
            width: 100%;
        }

        .task-topline {
            align-items: flex-start;
            flex-direction: column;
        }

        .completed-table thead {
            display: none;
        }

        .completed-table tbody tr {
            display: block;
            padding: 0.9rem 1rem;
            border-bottom: 1px solid #e2e8f0;
        }

        .completed-table tbody td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            border: none;
            padding: 0.45rem 0;
            text-align: right !important;
        }

        .completed-table tbody td::before {
            content: attr(data-label);
            color: #64748b;
            font-size: 0.74rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            text-align: left;
        }
    }
</style>

<div class="review-page">

    <div class="review-hero">
        <div class="review-hero-left">
            <div class="review-hero-icon">
                <i class="fas fa-gavel"></i>
            </div>

            <div>
                <div class="review-kicker">
                    @L("HeaderKicker", "Hakem Paneli")
                </div>

                <h1 class="review-title">
                    @L("PageHeading", "Görevlerim")
                </h1>

                <p class="review-description">
                    @L("PageDescription", "Size atanmış tüm bildiri değerlendirme görevlerini bu ekrandan takip edebilir, bekleyenleri değerlendirebilir ve tamamlananları inceleyebilirsiniz.")
                </p>
            </div>
        </div>
    </div>

    <div class="review-summary-grid">
        <div class="review-summary-card">
            <div class="summary-icon total">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <div class="summary-value">@totalCount</div>
                <div class="summary-label">@L("TotalAssignmentCountLabel", "Toplam Görev")</div>
            </div>
        </div>

        <div class="review-summary-card">
            <div class="summary-icon pending">
                <i class="fas fa-hourglass-half"></i>
            </div>

            <div>
                <div class="summary-value">@pendingCount</div>
                <div class="summary-label">@L("PendingCountLabel", "Bekleyen")</div>
            </div>
        </div>

        <div class="review-summary-card">
            <div class="summary-icon completed">
                <i class="fas fa-check-circle"></i>
            </div>

            <div>
                <div class="summary-value">@completedCount</div>
                <div class="summary-label">@L("CompletedCountLabel", "Tamamlanan")</div>
            </div>
        </div>
    </div>

    <ul class="nav review-tabs" id="reviewTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active"
                    id="pending-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#pending"
                    type="button">
                <i class="fas fa-clock me-2"></i>
                @L("PendingTabTitle", "Bekleyenler")
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link"
                    id="completed-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#completed"
                    type="button">
                <i class="fas fa-history me-2"></i>
                @L("CompletedTabTitle", "Tamamlananlar")
            </button>
        </li>
    </ul>

    <div class="tab-content" id="reviewTabsContent">

        <div class="tab-pane fade show active" id="pending">
            @if (pendingList.Any())
            {
                <div class="row g-4">
                    @foreach (var item in pendingList)
                    {
                        var submissionRef = item.SubmissionId.ToString().Substring(0, 6).ToUpper();

                        <div class="col-lg-6 col-xl-4">
                            <article class="task-card">
                                <div class="task-topline">
                                    <span class="task-ref-badge">
                                        <i class="fas fa-hashtag"></i>
                                        REF-@submissionRef
                                    </span>

                                    <small class="task-date">
                                        <i class="far fa-calendar-alt me-1"></i>
                                        @item.AssignedDate.ToLocalTime().ToString("dd MMM yyyy")
                                    </small>
                                </div>

                                <h6 class="task-title" title="@item.SubmissionTitle">
                                    @item.SubmissionTitle
                                </h6>

                                <div class="conference-badge" title="@item.ConferenceName">
                                    <i class="fas fa-calendar-check"></i>
                                    <span>
                                        @L("ConferenceLabel", "Kongre"): @item.ConferenceName
                                    </span>
                                </div>

                                <div class="task-footer">
                                    <a asp-area=""
                                       asp-controller="Review"
                                       asp-action="Evaluate"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm evaluate-btn">
                                        <i class="fas fa-play"></i>
                                        @L("EvaluateButton", "Değerlendir")
                                    </a>

                                    <button type="button"
                                            onclick="openDeclineModal('@item.Id')"
                                            class="btn btn-outline-danger btn-sm decline-btn"
                                            title="@L("DeclineTaskTitle", "Görevi Reddet")"
                                            data-bs-toggle="tooltip">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-content">
                        <div class="empty-icon">
                            <i class="fas fa-clipboard-check"></i>
                        </div>

                        <h5 class="empty-title">
                            @L("NoPendingTitle", "Bekleyen değerlendirme bulunmuyor.")
                        </h5>

                        <p class="empty-description">
                            @L("NoPendingDescription", "Size yeni bir bildiri değerlendirme görevi atandığında burada görüntülenecektir.")
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="completed">
            <div class="completed-card">
                <div class="completed-card-header">
                    <h6 class="completed-card-title">
                        <i class="fas fa-history text-primary me-2"></i>
                        @L("CompletedHistoryHeader", "Tamamlanan Değerlendirme Geçmişi")
                    </h6>

                    <p class="completed-card-subtitle">
                        @L("CompletedHistoryDescription", "Tamamladığınız değerlendirmeleri ve karar özetlerini buradan inceleyebilirsiniz.")
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle completed-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">@L("TableSubmissionInfo", "Bildiri")</th>
                                <th>@L("TableDate", "Değerlendirme Tarihi")</th>
                                <th class="text-center">@L("TableScore", "Puan")</th>
                                <th class="text-center">@L("TableDecision", "Karar")</th>
                                <th class="text-end">@L("TableActions", "İşlem")</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (completedList.Any())
                            {
                                @foreach (var item in completedList)
                                {
                                    <tr>
                                        <td data-label="@L("TableSubmissionInfo", "Bildiri")">
                                            <div>
                                                <div class="submission-title-cell" title="@item.SubmissionTitle">
                                                    @item.SubmissionTitle
                                                </div>

                                                <div class="completed-conference-badge" title="@item.ConferenceName">
                                                    <i class="fas fa-calendar-check"></i>
                                                    <span>
                                                        @item.ConferenceName
                                                    </span>
                                                </div>

                                                <div class="mt-2">
                                                    <span class="badge bg-light text-secondary border fw-normal">
                                                        #REF-@item.Id.ToString("D8")
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <td data-label="@L("TableDate", "Değerlendirme Tarihi")">
                                            <div class="d-flex align-items-center text-muted small fw-bold">
                                                <i class="far fa-calendar-check me-2 text-success"></i>
                                                @(item.EvaluationDate.HasValue
                                                    ? item.EvaluationDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                    : "-")
                                            </div>
                                        </td>

                                        <td data-label="@L("TableScore", "Puan")" class="text-center">
                                            @if (item.Score >= 80)
                                            {
                                                <span class="score-badge bg-success bg-opacity-10 text-success">
                                                    @item.Score
                                                </span>
                                            }
                                            else if (item.Score >= 50)
                                            {
                                                <span class="score-badge bg-warning bg-opacity-10 text-warning">
                                                    @item.Score
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="score-badge bg-danger bg-opacity-10 text-danger">
                                                    @item.Score
                                                </span>
                                            }
                                        </td>

                                        <td data-label="@L("TableDecision", "Karar")" class="text-center">
                                            @if (item.Recommendation == "Accept")
                                            {
                                                <span class="decision-badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                    <i class="fas fa-check-circle"></i>
                                                    @L("DecisionAccept", "Kabul")
                                                </span>
                                            }
                                            else if (item.Recommendation == "Reject")
                                            {
                                                <span class="decision-badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                                    <i class="fas fa-times-circle"></i>
                                                    @L("DecisionReject", "Ret")
                                                </span>
                                            }
                                            else if (!string.IsNullOrEmpty(item.Recommendation) &&
                                                     item.Recommendation.Contains("Revision"))
                                            {
                                                <span class="decision-badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                                                    <i class="fas fa-tools"></i>
                                                    @L("DecisionRevision", "Revizyon")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="decision-badge bg-secondary bg-opacity-10 text-secondary">
                                                    @(item.Recommendation ?? "-")
                                                </span>
                                            }
                                        </td>

                                        <td data-label="@L("TableActions", "İşlem")" class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a href="@Url.Action("DownloadCertificate", "Review", new { area = "", id = item.Id })"
                                                   target="_blank"
                                                   class="btn btn-outline-dark btn-sm rounded-pill fw-bold px-3 shadow-sm">
                                                    <i class="fas fa-certificate text-warning me-1"></i>
                                                    @L("CertificateButton", "Sertifika")
                                                </a>

                                                <a href="@Url.Action("Evaluate", "Review", new { area = "", id = item.Id })"
                                                   class="btn btn-light text-muted btn-sm rounded-circle border shadow-sm"
                                                   title="@L("ViewDetailsTitle", "Detayları Gör")"
                                                   data-bs-toggle="tooltip">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-state">
                                            <div class="empty-state-content">
                                                <div class="empty-icon">
                                                    <i class="fas fa-inbox"></i>
                                                </div>

                                                <h5 class="empty-title">
                                                    @L("NoCompletedReviewsTitle", "Henüz tamamlanmış değerlendirme bulunmuyor.")
                                                </h5>

                                                <p class="empty-description">
                                                    @L("NoCompletedReviewsMessage", "Değerlendirme yaptığınız bildiriler burada listelenecektir.")
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="declineModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @L("DeclineModalTitle", "Görevi Reddet")
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="@L("CloseAriaLabel", "Kapat")">
                </button>
            </div>

            <form asp-area=""
                  asp-controller="Review"
                  asp-action="DeclineAssignment"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body pt-3">
                    <input type="hidden" name="id" id="declineAssignmentId" />

                    <p class="text-muted small mb-4">
                        @L("DeclineModalDescription", "Bu değerlendirme görevini reddetme nedeninizi seçiniz. Bu bilgi organizasyon ekibi tarafından görüntülenecektir.")
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">
                            @L("DeclineReasonLabel", "Red Nedeni")
                        </label>

                        <div class="d-grid gap-2">
                            <input type="radio"
                                   class="btn-check"
                                   name="Reason"
                                   id="reason1"
                                   value="ConflictOfInterest"
                                   required>

                            <label class="btn btn-outline-light text-dark text-start border shadow-sm p-3 d-flex align-items-center rounded-3" for="reason1">
                                <i class="fas fa-handshake-slash text-danger me-3 fs-5"></i>

                                <div>
                                    <span class="d-block fw-bold" style="font-size: 0.9rem;">
                                        @L("ReasonConflictTitle", "Çıkar Çatışması")
                                    </span>

                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @L("ReasonConflictText", "Yazar, kurum veya çalışma konusu nedeniyle tarafsız değerlendirme yapamam.")
                                    </small>
                                </div>
                            </label>

                            <input type="radio"
                                   class="btn-check"
                                   name="Reason"
                                   id="reason2"
                                   value="NotMyField">

                            <label class="btn btn-outline-light text-dark text-start border shadow-sm p-3 d-flex align-items-center rounded-3" for="reason2">
                                <i class="fas fa-flask text-warning me-3 fs-5"></i>

                                <div>
                                    <span class="d-block fw-bold" style="font-size: 0.9rem;">
                                        @L("ReasonFieldTitle", "Uzmanlık Alanım Değil")
                                    </span>

                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @L("ReasonFieldText", "Bu çalışma benim uzmanlık alanıma yeterince yakın değil.")
                                    </small>
                                </div>
                            </label>

                            <input type="radio"
                                   class="btn-check"
                                   name="Reason"
                                   id="reason3"
                                   value="TimeConstraints">

                            <label class="btn btn-outline-light text-dark text-start border shadow-sm p-3 d-flex align-items-center rounded-3" for="reason3">
                                <i class="fas fa-hourglass-end text-primary me-3 fs-5"></i>

                                <div>
                                    <span class="d-block fw-bold" style="font-size: 0.9rem;">
                                        @L("ReasonTimeTitle", "Zaman Kısıtı")
                                    </span>

                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @L("ReasonTimeText", "Belirlenen süre içinde sağlıklı değerlendirme yapamayacağım.")
                                    </small>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-muted">
                            @L("AdditionalNoteLabel", "Ek Not")
                        </label>

                        <textarea name="Note"
                                  class="form-control bg-light"
                                  rows="2"
                                  placeholder="@L("AdditionalNotePlaceholder", "İsterseniz kısa bir açıklama ekleyebilirsiniz.")"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="button"
                            class="btn btn-light rounded-pill fw-bold"
                            data-bs-dismiss="modal">
                        @L("CancelButton", "Vazgeç")
                    </button>

                    <button type="submit"
                            class="btn btn-danger rounded-pill fw-bold px-4 shadow-sm">
                        <i class="fas fa-ban me-2"></i>
                        @L("DeclineTaskButton", "Görevi Reddet")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openDeclineModal(id) {
        document.getElementById('declineAssignmentId').value = id;
        var myModal = new bootstrap.Modal(document.getElementById('declineModal'));
        myModal.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));

        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>
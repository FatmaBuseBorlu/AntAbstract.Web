@{
    ViewData["Title"] = "Çıkar Çatışmaları";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-handshake-slash text-secondary me-2"></i> Çıkar Çatışması Bildirimi</h5>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark d-flex align-items-center mb-5 rounded-3 p-3">
                <i class="fas fa-exclamation-triangle fs-3 me-3 text-warning"></i>
                <div>
                    <h6 class="fw-bold mb-1">Etik Sorumluluk Hatırlatması</h6>
                    <small>Akademik etik kuralları gereği, halihazırda çalıştığınız kurumdan veya son 3 yıl içinde ortak çalışma yaptığınız kişilerden gelen bildirileri değerlendiremezsiniz. Lütfen bu kısıtlamaları aşağıya ekleyiniz.</small>
                </div>
            </div>

            <div class="row g-5">
                <div class="col-md-6 border-end-md">
                    <h6 class="fw-bold mb-3 text-primary"><i class="fas fa-university me-2"></i> Kurum Kısıtlaması</h6>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Üniversite veya Kurum Adı">
                        <button class="btn btn-outline-primary" type="button">Ekle</button>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border">
                            <span class="fw-bold text-secondary">Akdeniz Üniversitesi</span>
                            <button class="btn btn-sm text-danger"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-bold mb-3 text-success"><i class="fas fa-user-friends me-2"></i> Kişi Kısıtlaması</h6>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Yazar Adı Soyadı">
                        <button class="btn btn-outline-success" type="button">Ekle</button>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border">
                            <div>
                                <span class="fw-bold text-secondary d-block">Prof. Dr. Ahmet Yılmaz</span>
                                <small class="text-muted" style="font-size: 0.7rem;">Tez Danışmanım</small>
                            </div>
                            <button class="btn btn-sm text-danger"><i class="fas fa-trash"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
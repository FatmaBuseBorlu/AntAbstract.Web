@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_LayoutDashboard";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="fas fa-handshake-slash text-secondary me-2"></i> @Localizer["HeaderTitle"]
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark d-flex align-items-center mb-5 rounded-3 p-3">
                <i class="fas fa-exclamation-triangle fs-3 me-3 text-warning"></i>
                <div>
                    <h6 class="fw-bold mb-1">@Localizer["EthicsReminderTitle"]</h6>
                    <small>@Localizer["EthicsReminderText"]</small>
                </div>
            </div>

            <div class="row g-5">
                <div class="col-md-6 border-end-md">
                    <h6 class="fw-bold mb-3 text-primary">
                        <i class="fas fa-university me-2"></i> @Localizer["InstitutionRestrictionTitle"]
                    </h6>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="@Localizer["InstitutionPlaceholder"]">
                        <button class="btn btn-outline-primary" type="button">@Localizer["AddButton"]</button>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border">
                            <span class="fw-bold text-secondary">@Localizer["SampleInstitution"]</span>
                            <button class="btn btn-sm text-danger" title="@Localizer["DeleteTitle"]">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-bold mb-3 text-success">
                        <i class="fas fa-user-friends me-2"></i> @Localizer["PersonRestrictionTitle"]
                    </h6>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="@Localizer["PersonPlaceholder"]">
                        <button class="btn btn-outline-success" type="button">@Localizer["AddButton"]</button>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 border">
                            <div>
                                <span class="fw-bold text-secondary d-block">@Localizer["SamplePerson"]</span>
                                <small class="text-muted" style="font-size: 0.7rem;">@Localizer["SamplePersonReason"]</small>
                            </div>
                            <button class="btn btn-sm text-danger" title="@Localizer["DeleteTitle"]">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
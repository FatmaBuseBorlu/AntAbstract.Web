<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <security>
        <requestFiltering>
          <!-- 30 MB: profil fotoğrafı (10MB) + belge yüklemeleri (10MB) için yeterli -->
          <!-- Kestrel 52 MB'a izin veriyor; IIS daha düşük kalırsa büyük
               yüklemeler uygulamaya hiç ulaşmadan reddedilir. -->
          <requestLimits maxAllowedContentLength="54525952" />
        </requestFiltering>
      </security>
      <aspNetCore processPath=".\AntAbstract.Web.exe" arguments="" stdoutLogEnabled="true" stdoutLogFile=".\stdout" hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
